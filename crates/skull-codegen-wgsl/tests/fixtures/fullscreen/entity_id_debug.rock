struct EntityIdTex { id_buffer: ISampler2D }

@shader(fragment)
fn entity_id_debug_frag(@textures t: EntityIdTex, tc: Vec2) -> Vec4 {
    let id = texture_id(t.id_buffer, tc)
    if id <= 0 { discard() }
    let value = int_to_float(id)
    let color = v(fract(value * 0.613 + 0.1), fract(value * 0.337 + 0.5), fract(value * 0.879 + 0.3))
    return v(v(0.3, 0.3, 0.3) + color * 0.7, 0.85)
}
