value ProbeVertex {
    aPos: Vec2,
}

@shader(fragment)
fn shader_probe_frag(tc: Vec2) -> Vec4 {
    let p = shader_probe_fullscreen::helpers::shader_helper(tc, 0.5)
    let d = shader_probe_fullscreen::helpers::dot(p, tc)
    return Vec4 { x: p.x, y: p.y, z: d, w: 1.0 }
}

global PROBE_SHADER: string = rock_shader(shader_probe_frag)

fn main() {}
