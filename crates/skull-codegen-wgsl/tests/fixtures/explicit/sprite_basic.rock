value SpriteBasicVert {
    aPos: Vec2f,
    aTexCoord: Vec2f,
    aColor: Vec4f,
}

value SpriteBasicVary {
    position: Vec4,
    TexCoord: Vec2,
    VertexColor: Vec4,
}

struct MainTex { uTexture: Sampler2D }

@shader(vertex)
fn sprite_basic_vert(@attr a: SpriteBasicVert, @engine e: EngineU) -> SpriteBasicVary {
    return SpriteBasicVary {
        position: e.uProjection * e.uView * v(a.aPos.to_f64(), 0.0, 1.0),
        TexCoord: a.aTexCoord.to_f64(),
        VertexColor: a.aColor.to_f64(),
    }
}

@shader(fragment)
fn sprite_basic_frag(vary: SpriteBasicVary, @textures t: MainTex) -> Vec4 {
    let tex_color = texture(t.uTexture, vary.TexCoord)
    if tex_color.w < 0.1 { discard() }
    return tex_color * vary.VertexColor
}
