enum Shape {
    Circle(float),
    Rect(float, float),
    Empty,
}

struct Drawing {
    name: string,
    shapes: [Shape],
}

fn area(s: Shape) -> float {
    match s {
        Shape::Circle(r) => 3.0 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Empty => 0.0,
    }
}

fn total<T>(xs: [T], f: fn(T) -> float) -> float {
    let sum = 0.0
    for x in xs { sum += f(x) }
    return sum
}

fn main() {
    let drawing = Drawing { name: "demo", shapes: [Shape::Circle(1.0), Shape::Rect(2.0, 3.0), Shape::Empty] }
    let scale = 2.0
    let scaled = total(drawing.shapes, s => area(s) * scale)
    let big = 0
    for s in drawing.shapes {
        if area(s) > 4.0 { big += 1 }
    }
    print("{drawing.name}: {scaled} total, {big} big")
}
