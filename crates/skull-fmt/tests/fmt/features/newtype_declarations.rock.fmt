//! Test: Newtype declarations formatting

//- newtype_basic
newtype UserId(int)

//- newtype_spacing_before_annotation
@external
newtype NetworkId(int)

@serializable
newtype EntityId(string)

newtype PlayerId(int)

//- multiple_newtypes
newtype ClientId(int)
newtype ServerId(string)
newtype Timestamp(float)

//- newtype_with_generic
newtype Wrapper<T>(T)
newtype Tagged<Tag, Value>(Value)
