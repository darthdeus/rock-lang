//! Test: nested function declarations

//- nested_fn_inferred_and_annotated
fn outer(xs: [int]) -> int {
    fn inc(x: int) -> int { x + 1 }
    fn total() {
        return
    }
    return xs.map(inc).len()
}

//- nested_fn_normalizes_spacing
fn g() {
    fn  h(x:int)->int{ x*2 }
}
//=== EXPECTED ===
fn g() {
    fn h(x: int) -> int { x * 2 }
}
