//! Test: macro bodies keep their item declarations
//! Tags: macros, declarations

// Item declarations in a macro body live outside the block's statement list.
// Printing the block alone DELETED them, silently emptying the macro.

//=== TEST CASE: macro_item_body_survives ===
macro emit() {
    fn forty_two() -> int { 42 }
}

//=== NO CHANGE ===


//=== TEST CASE: macro_mixed_items_and_statements_survive ===
macro mixed() {
    struct Pair {
        a: int,
        b: int,
    }
    fn make() -> Pair { Pair { a: 1, b: 2 } }
    let p = make()
    print(p.a + p.b)
}

//=== NO CHANGE ===


//=== TEST CASE: expression_macro_body_still_formats ===
macro twice(x: expr) {
    x + x
}

//=== NO CHANGE ===
