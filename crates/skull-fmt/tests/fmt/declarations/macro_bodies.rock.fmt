//! Test: macro bodies keep their item declarations

// Item declarations in a macro body live outside the block's statement list.
// Printing the block alone DELETED them, silently emptying the macro.

//- macro_item_body_survives
macro emit() {
    fn forty_two() -> int { 42 }
}

//- macro_mixed_items_and_statements_survive
macro mixed() {
    struct Pair {
        a: int,
        b: int,
    }
    fn make() -> Pair { Pair { a: 1, b: 2 } }
    let p = make()
    print(p.a + p.b)
}

//- expression_macro_body_still_formats
macro twice(x: expr) {
    x + x
}
