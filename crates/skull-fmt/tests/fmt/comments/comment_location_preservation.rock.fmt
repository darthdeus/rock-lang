//! Test: Comment location preservation
//! Tags: comments, location, standalone

//=== TEST CASE:preserve_comment_location_in_function ===

// Right fold processes from right to left
fn vec_fold_right<T, U>(vec: [T], initial: U, f: (T, U) -> U) -> U {
    let result = initial
    // Process array in reverse order
    let i = vec_len(vec) - 1
    while i >= 0 {
        result = f(vec[i], result)
        i = i - 1
    }
    return result
}

//=== NO CHANGE ===

