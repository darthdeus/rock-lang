//! Test: Long parameter list inline functions
//! Tags: inline, functions, parameters

//=== TEST CASE:long_param_inline_functions ===

// Inline functions with many parameters should stay multi-line when too long
@nomangle
inline(lua) fn __register_decorated_function(
    function_name: string,
    module_path: string,
    decorators: [any],
    original_name: string,
    decorated_name: string
) = """
    -- Initialize the annotation registry
    _G.__ROCK_ANNOTATION_REGISTRY = {}
"""

//=== EXPECTED ===
// Inline functions with many parameters should stay multi-line when too long
@nomangle inline(lua) fn __register_decorated_function(
    function_name: string,
    module_path: string,
    decorators: [any],
    original_name: string,
    decorated_name: string
) = """
    -- Initialize the annotation registry
    _G.__ROCK_ANNOTATION_REGISTRY = {}
"""
//=== TEST CASE: short_inline_functions_stay_inline ===
// Short inline functions should stay on one line
@nomangle inline(lua) fn simple_func(x: int) = "return x * 2"

//=== NO CHANGE ===
