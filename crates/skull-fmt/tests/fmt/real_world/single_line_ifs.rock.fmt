//! Test: Single-line if preservation
//! Tags: control-flow, if-statements

//=== TEST CASE: single_line_if_preservation ===
fn draw_debug_lines(neighbors: Neighbors, pos: Vec2) {
    let l = 0.5
    let c1 = color(1, 1, 0, 0.5)
    let c2 = color(0, 1, 1, 0.5)

    // These should stay as single-line ifs
    if neighbors.north { draw_line(pos, pos + v(0, -l), c1) }
    if neighbors.east { draw_line(pos, pos + v(l, 0), c1) }
    if neighbors.south { draw_line(pos, pos + v(0, l), c1) }
    if neighbors.west { draw_line(pos, pos + v(-l, 0), c1) }

    if neighbors.north_east { draw_line(pos, pos + v(l, -l), c2) }
    if neighbors.south_east { draw_line(pos, pos + v(l, l), c2) }
    if neighbors.south_west { draw_line(pos, pos + v(-l, l), c2) }
    if neighbors.north_west { draw_line(pos, pos + v(-l, -l), c2) }
}

// Multi-line if should stay multi-line
fn process_data(x: int) {
    if x > 100 {
        print("Large value")
        do_something_complex()
        return
    }

    // Simple if with else should preserve formatting
    if x > 50 { print("Medium") } else { print("Small") }
}

//=== NO CHANGE ===
