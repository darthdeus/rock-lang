//! Test: Tuple and pattern destructuring formatting

//- tuple_let_destructure
fn test() {
    let pair = (1, 2)
    let (a, b) = pair
    print(a + b)
}

//- tuple_destructure_in_for
fn sum_pairs(pairs: [(int, int)]) -> int {
    let total = 0
    for (a, b) in pairs {
        total = total + a + b
    }
    return total
}

//- arena_for_destructure
fn print_all(mobs: Arena<Mob>) {
    for (entity, mob) in mobs {
        print(mob.name)
    }
}

//- nested_tuple_destructure
fn test_nested() {
    let nested = ((1, 2), 3)
    let (pair, c) = nested
    let (a, b) = pair
    print(a + b + c)
}
