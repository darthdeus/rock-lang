//! Test: Lambda expression formatting
//! Tags: lambdas, arrow-syntax, closures

//=== TEST CASE:lambda_arrow_syntax ===

fn test() {
    let simple = (x) => x + 1
    let binary = (a, b) => a + b
    let no_params = () => 42
}

//=== EXPECTED ===
fn test() {
    let simple = x => x + 1
    let binary = (a, b) => a + b
    let no_params = () => 42
}

//=== TEST CASE:lambda_arrow_syntax_with_complex_body ===

fn test() {
    let complex = (data) => {
        let processed = transform(data)
        validate(processed)
        return processed
    }

    let conditional = (x) => {
        if x > 0 {
            return x * 2
        } else {
            return 0
        }
    }
}

//=== EXPECTED ===
fn test() {
    let complex = data => {
        let processed = transform(data)
        validate(processed)
        return processed
    }

    let conditional = x => {
        if x > 0 {
            return x * 2
        } else {
            return 0
        }
    }
}

//=== TEST CASE:lambda_arrow_syntax_with_field_access ===

fn test() {
    let get_name = (person) => person.name
    let get_age = (user) => user.profile.age
    let calculate = (obj) => obj.width * obj.height
}

//=== EXPECTED ===
fn test() {
    let get_name = person => person.name
    let get_age = user => user.profile.age
    let calculate = obj => obj.width * obj.height
}

//=== TEST CASE:lambda_in_function_calls ===

fn test() {
    let numbers = [1, 2, 3, 4, 5]

    let doubled = map(numbers, (x) => x * 2)
    let filtered = filter(numbers, (n) => n > 3)
    let sum = reduce(numbers, (acc, x) => acc + x, 0)
}

//=== EXPECTED ===
fn test() {
    let numbers = [1, 2, 3, 4, 5]

    let doubled = map(numbers, x => x * 2)
    let filtered = filter(numbers, n => n > 3)
    let sum = reduce(numbers, (acc, x) => acc + x, 0)
}

//=== TEST CASE:nested_lambda_expressions ===

fn test() {
    let outer = (x) => {
        let inner = (y) => x + y
        return inner
    }

    let curried = (a) => (b) => (c) => a + b + c
}

//=== EXPECTED ===
fn test() {
    let outer = x => {
        let inner = y => x + y
        return inner
    }

    let curried = a => b => c => a + b + c
}
