//! Test: Struct spread (call-site `..arg`) and functional-update (`{ ..base }`)

//- call_spread_inline
fn test() {
    draw(img, ..props)
    draw(img, ..props, color: c)
    draw(..a, ..b)
}

//- functional_update_inline
fn test() {
    let a = UiRect { ..r, z: 2 }
    let b = P { ..base, c: 1, d: 2 }
    let c = P { ..x, ..y, z: 3 }
}
