//! Test: Lambda expression formatting

//- simple_lambda_expressions
fn test() {
    let add = (x: int, y: int) => x + y
    let square = (x: int) => x * x
}

//- empty_block_lambda_in_call_is_idempotent
fn test() {
    queue(pool, () => {})
}

//- long_lambda_parameter_expansion
fn test() {
    let calculate_damage = (base_damage: float, armor_value: float, damage_multiplier: float) => base_damage * damage_multiplier - armor_value
}

//- lambda_with_block_body
fn test() {
    let complex_lambda = (x: int) => {
        let intermediate = x * 2
        let result = intermediate + 10
        result
    }
}

//- lambda_arrow_syntax
fn main() {
    vec_sort(numbers, x => x)
}
