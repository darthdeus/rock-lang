global WINDOW_HEIGHT: int = 1080

global DEBUG_MODE: bool = false  // Enable debug features
global LOG_LEVEL: int = 2        // Logging verbosity

// Game constants
global GRAVITY: float = 9.81
global JUMP_FORCE: float = 12.0  // Player jump strength

//=== NO CHANGE ===

//=== TEST CASE:single_global_with_inline_comment ===

global x: int = 42  // This is a comment

//=== EXPECTED ===
global x: int = 42  // This is a comment
//=== TEST CASE:global_declarations_with_inline_comments ===

global time_of_day: float = 12.0  // 0.0 to 24.0 hours
