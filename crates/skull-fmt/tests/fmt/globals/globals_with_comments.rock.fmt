//=== TEST CASE:globals_with_comments ===


global SAFE_ZONE_CENTER: Vec2 = vec2(0, 0)  // Player spawn point
global SAFE_ZONE_RADIUS: float = 10.0        // Radius of the safe zone
global MAX_WANDER_DISTANCE: float = 15.0     // Max distance from spawn point

//=== NO CHANGE ===

//=== TEST CASE:mixed_global_declarations ===

