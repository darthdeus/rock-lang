//! Test: Function type syntax
//! Tags: types, functions, syntax

//=== TEST CASE: function_type_syntax ===
struct Test {
    callback: (int) -> string? = null,
    update: (float, bool) -> ()? = null,
}

//=== NO CHANGE ===

//=== TEST CASE:function_type_parameter_syntax ===

fn with_callback(f: fn() -> ()) {
    f()
}

fn with_params(handler: fn(int, string) -> bool) {
    return handler(42, "test")
}

//=== EXPECTED ===
fn with_callback(f: fn() -> ()) {
    f()
}

fn with_params(handler: fn(int, string) -> bool) {
    return handler(42, "test")
}
