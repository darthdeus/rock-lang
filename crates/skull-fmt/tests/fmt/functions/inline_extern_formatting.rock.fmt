//! Test: Inline and extern function formatting
//! Tags: inline, extern, backend-specific

//=== TEST CASE: inline_lua_format ===
inline(lua) fn lua_specific_code() -> string = """return "lua_result" """

//=== NO CHANGE ===

//=== TEST CASE: extern_lua_format ===
extern(lua) fn lua_external_function(param: string) -> string

fn use_backend_specific() {
    let lua_result = lua_external_function("test")
}

//=== NO CHANGE ===

//=== TEST CASE: extern_function_formatting ===
extern fn malloc(size: int) -> any
extern fn free(ptr: any)
extern fn strlen(str: string) -> int

//=== NO CHANGE ===

//=== TEST CASE: consecutive_single_line_extern_functions ===
extern fn open(path: string, mode: int) -> int
extern fn close(fd: int) -> int
extern fn read(fd: int, buf: any, count: int) -> int
extern fn write(fd: int, buf: any, count: int) -> int

//=== NO CHANGE ===

//=== TEST CASE:extern_function_multiline_lua ===
// Layout preserver: a signature the author wrote across multiple lines keeps
// that layout (author line breaks are authoritative).
extern(lua) fn complex_lua_function(
    param1: string,
    param2: int,
    param3: bool
) -> any

//=== NO CHANGE ===
//=== TEST CASE: extern_function_preservation ===
extern fn system_call(command: string) -> int
extern fn get_environment_variable(name: string) -> string?

fn use_extern_functions() {
    let result = system_call("ls -la")
    let home = get_environment_variable("HOME")
}

//=== NO CHANGE ===
