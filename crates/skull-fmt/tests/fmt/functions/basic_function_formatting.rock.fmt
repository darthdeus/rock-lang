//! Test: Basic function formatting

//- simple_function_collapse
fn hello() {
    return;
}
//=== EXPECTED ===
fn hello() {
    return
}

//- preserve_single_blank_line
fn first() {
    return;
}

fn second() {
    return;
}
//=== EXPECTED ===
fn first() {
    return
}

fn second() {
    return
}

//- preserve_multiple_blank_lines
fn first() {
    return;
}


fn second() {
    return;
}
//=== EXPECTED ===
fn first() {
    return
}


fn second() {
    return
}
