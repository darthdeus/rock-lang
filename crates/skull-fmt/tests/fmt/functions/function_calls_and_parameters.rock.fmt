//=== TEST CASE: long_parameter_lists_break_properly ===
fn make_neighbors(n: bool = false, e: bool = false, s: bool = false, w: bool = false,
                 ne: bool = false, se: bool = false, sw: bool = false, nw: bool = false) -> AutotileNeighbors {
    return AutotileNeighbors {
        north: n,
        east: e,
        south: s,
        west: w,
        north_east: ne,
        south_east: se,
        south_west: sw,
        north_west: nw,
    }
}

