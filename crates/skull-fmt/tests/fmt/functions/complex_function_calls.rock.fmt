//! Test: Complex function call formatting

//- fn_calls_nowrap
fn test() {
    let steps = max(1, float_to_int(ceil(movement.length() / (radius * 0.5))))
}

//- complex_multiline_fn_call_remains_multiline
fn snap_to_grid(pos: Vec2, grid_size: float) -> Vec2 {
    let closest = vec2(
        clamp(circle_pos.x, rect_min.x, rect_max.x),
        clamp(circle_pos.y, rect_min.y, rect_max.y)
    )

    return vec2(
        floor(pos.x / grid_size + 0.5) * grid_size,
        floor(pos.y / grid_size + 0.5) * grid_size
    )
}

//- function_call_arguments_dont_collapse_inappropriately
fn test() {
    let collision = circle_rect_collision(
        pos, radius,
        shape.pos, shape.w
    )
}

//- nested_function_calls_formatting
fn complex_calculation() {
    let result = transform_coordinate(
        calculate_position(
            get_base_offset(player.position, world_offset),
            apply_zoom(camera.zoom, viewport_size)
        ),
        matrix_multiply(
            world_transform,
            screen_transform
        )
    )
}
