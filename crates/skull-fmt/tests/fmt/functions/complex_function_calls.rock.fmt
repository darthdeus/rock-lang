//=== TEST CASE: complex_multiline_fn_call_remains_multiline ===
fn snap_to_grid(pos: Vec2, grid_size: float) -> Vec2 {
    let closest = vec2(
        clamp(circle_pos.x, rect_min.x, rect_max.x),
        clamp(circle_pos.y, rect_min.y, rect_max.y)
    )

    return vec2(
        floor(pos.x / grid_size + 0.5) * grid_size,
        floor(pos.y / grid_size + 0.5) * grid_size
    )
}

