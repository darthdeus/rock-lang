//! Test: @ operator syntax formatting
//! Tags: operators, at-operator, blocks, lambda

//=== TEST CASE:basic_at_operator_usage ===

fn main() {
    profile("computation") @ expensive_calculation()

    timed_scope("database") @ {
        query_database()
        process_results()
    }

    with_debug_group("render") @ draw_scene()
}

//=== EXPECTED ===
fn main() {
    profile("computation") @ expensive_calculation()

    timed_scope("database") @ {
        query_database()
        process_results()
    }

    with_debug_group("render") @ draw_scene()
}
//=== TEST CASE:at_operator_with_complex_blocks ===

fn render_scene() {
    with_debug_group("map_render")@{
        for (_, tile) in tile_grid {
            draw_tile(tile)
        }
        update_tile_animations()
    }

    profile("particle_system") @ particle_update()
}

//=== EXPECTED ===
fn render_scene() {
    with_debug_group("map_render") @ {
        for (_, tile) in tile_grid {
            draw_tile(tile)
        }
        update_tile_animations()
    }

    profile("particle_system") @ particle_update()
}
//=== TEST CASE:chained_at_operators ===

fn complex_operation() {
    with_lock("resource")@profile("critical_section")@{
        access_shared_resource()
        perform_calculation()
    }
}

//=== EXPECTED ===
fn complex_operation() {
    with_lock("resource") @ profile("critical_section") @ {
        access_shared_resource()
        perform_calculation()
    }
}
//=== TEST CASE:at_operator_in_expressions ===

fn test_expressions() {
    let result = timed("compute") @ calculate_value()

    let data = profile("data_load") @ {
        load_from_disk()
        validate_data()
        return processed_data
    }
}

//=== EXPECTED ===
fn test_expressions() {
    let result = timed("compute") @ calculate_value()

    let data = profile("data_load") @ {
        load_from_disk()
        validate_data()
        return processed_data
    }
}
//=== TEST CASE:at_operator_with_function_calls ===

fn nested_calls() {
    log_scope("outer") @ {
        inner_function(profile("arg") @ get_value())
        another_call(
            with_context("param") @ compute_param()
        )
    }
}

