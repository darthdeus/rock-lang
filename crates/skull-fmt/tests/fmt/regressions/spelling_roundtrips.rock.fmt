//=== TEST CASE: shared_line_group_does_not_duplicate_the_next_statement_1 ===
fn f() {
    () let
    y 13
}
//=== EXPECTED ===
fn f() {
    ()
    let y
    13
}

//=== TEST CASE: shared_line_group_does_not_duplicate_the_next_statement_2 ===
fn f() {
    a(); b(() => {
        c()
    }); d()
}
//=== EXPECTED ===
fn f() {
    a()
    b(() => {
        c()
    })
    d()
}

//=== TEST CASE: single_line_container_with_multiline_children_1 ===
fn f() {
    print({ let x = 5; x * 2 })
}
//=== EXPECTED ===
fn f() {
    print({
        let x = 5
        x * 2
    })
}

//=== TEST CASE: single_line_container_with_multiline_children_2 ===
fn f() {
    print({ let x = 5; x * 2 } + { let y = 3; y + 1 })
}
//=== EXPECTED ===
fn f() {
    print(
        {
            let x = 5
            x * 2
        } + {
            let y = 3
            y + 1
        }
    )
}

//=== TEST CASE: single_line_container_with_multiline_children_3 ===
fn f() {
    print(if { let r = true; r } { 1 } else { 2 })
}
//=== EXPECTED ===
fn f() {
    print(
        if {
            let r = true
            r
        } { 1 } else { 2 }
    )
}

//=== TEST CASE: single_line_container_with_multiline_children_4 ===
fn f() {
    print({})
}
//=== EXPECTED ===
fn f() {
    print({
    })
}

//=== TEST CASE: single_line_container_with_multiline_children_5 ===
fn f() -> C {
    return C { bump: () => { n = n + 1; return n }, tag: 1 }
}
//=== EXPECTED ===
fn f() -> C {
    return C {
        bump: () => {
            n = n + 1
            return n
        },
        tag: 1
    }
}

//=== TEST CASE: single_line_container_with_multiline_children_6 ===
fn f() -> P {
    return P { get: () => n, bump: () => { n = n + 1; return n } }
}
//=== EXPECTED ===
fn f() -> P {
    return P {
        get: () => n,
        bump: () => {
            n = n + 1
            return n
        }
    }
}

//=== TEST CASE: single_line_container_with_multiline_children_7 ===
fn f() {
    let q = F { a + b: { c = c + 1; 10 }, d: 2 }
}
//=== EXPECTED ===
fn f() {
    let q = F {
        a + b: {
            c = c + 1
            10
        },
        d: 2
    }
}

//=== TEST CASE: single_line_container_with_multiline_children_8 ===
fn f() {
    for x in v.iter().map(x => { t.push(x); x }).filter(x => { u(); true }) {
        print(x)
    }
}
//=== EXPECTED ===
fn f() {
    for x in v.iter()
        .map(x => {
            t.push(x)
            x
        })
        .filter(x => {
            u()
            true
        }) {
        print(x)
    }
}

//=== TEST CASE: single_line_container_with_multiline_children_9 ===
fn f() -> P {
    return P { get: () => n, bump: () => {
        n = n + 1
        return n
    } }
}
//=== EXPECTED ===
fn f() -> P {
    return P {
        get: () => n, bump: () => {
            n = n + 1
            return n
        }
    }
}

//=== TEST CASE: single_line_container_with_multiline_children_10 ===
fn f() {
    x = [{ y: {} }]
}
//=== EXPECTED ===
fn f() {
    x = [
        {
            y : {
            }
        }
    ]
}

//=== TEST CASE: single_line_container_with_multiline_children_11 ===
fn f() {
    let a = [1, { let x = 5; x * 2 }]
}
//=== EXPECTED ===
fn f() {
    let a = [
        1,
        {
            let x = 5
            x * 2
        }
    ]
}

//=== TEST CASE: single_line_container_with_multiline_children_12 ===
fn f() {
    let t = ({ let x = 5; x * 2 }, 1)
}
//=== EXPECTED ===
fn f() {
    let t = (
        {
            let x = 5
            x * 2
        },
        1
    )
}

