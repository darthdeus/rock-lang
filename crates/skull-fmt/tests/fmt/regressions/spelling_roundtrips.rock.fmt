//=== TEST CASE: contextual_ascription_normalizes_spacing ===
fn ratio(value: int) {
    let wide = (value  :  float)
    let tight = (value:float)
    let sum = ((value + 1) : float)
}
//=== EXPECTED ===
fn ratio(value: int) {
    let wide = (value : float)
    let tight = (value : float)
    let sum = ((value + 1) : float)
}

//=== TEST CASE: path_qualified_return_literal ===
fn profile(mob: Mob) {
    if mob.active { return app_world::world_tick::WorldActorTurnProfile { move_speed: mob.move_speed() } }
}
//=== NO CHANGE ===
