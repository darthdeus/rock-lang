//! Test: forms whose spelling the printer once changed or broke

//- call_type_arguments_and_single_tuples_are_kept
fn f() {
    let nb = native_buffer_alloc<WideLeaf>(1)
    let k = key<T>()
    let m = Map<string, int>()
    let r = a.b<int>(1).c(2).d()
    let r = a.b(1).c<int>(2).d()
    let single = (5,)
}

//- unary_minus_over_a_negative_operand_keeps_its_space
fn f() {
    return - -1
}

fn g() {
    let x = sin(- -1.3) - - --y
}

//- spaced_unary_minus_over_a_number_keeps_its_shape
fn f() {
    x += - 1
    x = - 1
    x = - 1.5
    x = - .5
    f(- 2)
    x -= -1
    x = -y
}

//- comment_after_a_dollar_call_stays_on_the_statement
fn f() {
    assert $ g(x) // why
}

fn g() {
    let y = assert $ 1 // why
}
//=== EXPECTED ===
fn f() {
    assert(g(x))  // why
}

fn g() {
    let y = assert(1)  // why
}

//- comment_after_a_multi_line_dollar_argument_appears_once
fn f() {
    assert $ g(
        x
    ) // why
}
//=== EXPECTED ===
fn f() {
    assert(
        g(
            x
        )
    ) // why
}

//- comment_on_the_last_argument_of_an_at_head_appears_once
fn f() {
    g(
        a // why
    ) @ print(1)
}

//- comment_after_the_last_argument_of_an_at_head_survives
fn f() {
    g(
        a,
        // why
    ) @ print(1)
}

//- comment_after_an_at_survives
fn f() {
    g(
        a,
    ) @ // why
    print(1)
}

//- at_form_keeps_explicit_generic_arguments
fn f() {
    g<int>(1) @ print(1)
    g<int>() @ print(1)
}

//- nullable_function_returning_nullable_value_keeps_its_outer_parens
struct Hooks {
    callback: (() -> Vec2?)? = null,
}

//- nullable_parenthesized_function_type
struct Hooks {
    on_close: (fn())? = null,
}
//=== EXPECTED ===
struct Hooks {
    on_close: (fn() -> ())? = null,
}

//- item_annotations_preserve_trailing_comments
@sim_env("SIM_DRAW", "every_frame") // draw policy
@sim
co fn probe() {
}

@sim // final annotation
co fn probe() {
}

@first @second // shared line
fn probe() {
}

//- call_splat_in_a_variadic_macro
macro sum_of(x: expr, rest: ...expr) -> int {
    x + sum_of(...rest)
}
//=== EXPECTED ===
macro sum_of(x: expr, rest: expr...) -> int {
    x + sum_of(...rest)
}

//- call_splat_in_a_macro_call
macro fwd(rest: ...expr) -> int { sum_of(...rest) }
//=== EXPECTED ===
macro fwd(rest: expr...) -> int { sum_of(...rest) }

//- call_splat_after_an_argument
fn f(xs: ...int) {
    g(1, ...xs)
}
//=== EXPECTED ===
fn f(xs: int...) {
    g(1, ...xs)
}

//- range_and_safe_navigation_keep_their_spaces_1
fn f() {
    print(src .. .w.f0)
}

//- range_and_safe_navigation_keep_their_spaces_2
fn f() {
    let r = a..b
}

//- range_and_safe_navigation_keep_their_spaces_3
fn f() {
    sum2(.. .p)
}

//- range_and_safe_navigation_keep_their_spaces_4
fn f() {
    (s? ?.x)
}

//- range_and_safe_navigation_keep_their_spaces_5
fn f() {
    s? .x
}

//- range_and_safe_navigation_keep_their_spaces_6
fn f() {
    s? .a().b()
}

//- split_statement_keeps_its_boundary_1
fn f(){({y 7;&  y})}fn g(){}
//=== EXPECTED ===
fn f() {
    ({
        y 7;
        &  y
    })
}

fn g() {
}

//- split_statement_keeps_its_boundary_2
fn f() {
    a(); -b
}
//=== EXPECTED ===
fn f() {
    a();
    -b
}

//- split_statement_keeps_its_boundary_3
fn f() {
    x = 7; .y = 1
}
//=== EXPECTED ===
fn f() {
    x = 7;
    .y = 1
}

//- split_statement_keeps_its_boundary_4
fn f() {
    x = 7; -q // note
}
//=== EXPECTED ===
fn f() {
    x = 7;
    -q        // note
}

//- shared_line_group_does_not_duplicate_the_next_statement_1
fn f() {
    () let
    y 13
}
//=== EXPECTED ===
fn f() {
    ()
    let y
    13
}

//- shared_line_group_does_not_duplicate_the_next_statement_2
fn f() {
    a(); b(() => {
        c()
    }); d()
}
//=== EXPECTED ===
fn f() {
    a()
    b(() => {
        c()
    })
    d()
}

//- single_line_container_with_multiline_children_1
fn f() {
    print({ let x = 5; x * 2 })
}
//=== EXPECTED ===
fn f() {
    print({
        let x = 5
        x * 2
    })
}

//- single_line_container_with_multiline_children_2
fn f() {
    print({ let x = 5; x * 2 } + { let y = 3; y + 1 })
}
//=== EXPECTED ===
fn f() {
    print(
        {
            let x = 5
            x * 2
        } + {
            let y = 3
            y + 1
        }
    )
}

//- single_line_container_with_multiline_children_3
fn f() {
    print(if { let r = true; r } { 1 } else { 2 })
}
//=== EXPECTED ===
fn f() {
    print(
        if {
            let r = true
            r
        } { 1 } else { 2 }
    )
}

//- single_line_container_with_multiline_children_4
fn f() {
    print({})
}
//=== EXPECTED ===
fn f() {
    print({
    })
}

//- single_line_container_with_multiline_children_5
fn f() -> C {
    return C { bump: () => { n = n + 1; return n }, tag: 1 }
}
//=== EXPECTED ===
fn f() -> C {
    return C {
        bump: () => {
            n = n + 1
            return n
        },
        tag: 1
    }
}

//- single_line_container_with_multiline_children_6
fn f() -> P {
    return P { get: () => n, bump: () => { n = n + 1; return n } }
}
//=== EXPECTED ===
fn f() -> P {
    return P {
        get: () => n,
        bump: () => {
            n = n + 1
            return n
        }
    }
}

//- single_line_container_with_multiline_children_7
fn f() {
    let q = F { a + b: { c = c + 1; 10 }, d: 2 }
}
//=== EXPECTED ===
fn f() {
    let q = F {
        a + b: {
            c = c + 1
            10
        },
        d: 2
    }
}

//- single_line_container_with_multiline_children_8
fn f() {
    for x in v.iter().map(x => { t.push(x); x }).filter(x => { u(); true }) {
        print(x)
    }
}
//=== EXPECTED ===
fn f() {
    for x in v.iter()
        .map(x => {
            t.push(x)
            x
        })
        .filter(x => {
            u()
            true
        }) {
        print(x)
    }
}

//- single_line_container_with_multiline_children_9
fn f() -> P {
    return P { get: () => n, bump: () => {
        n = n + 1
        return n
    } }
}
//=== EXPECTED ===
fn f() -> P {
    return P {
        get: () => n, bump: () => {
            n = n + 1
            return n
        }
    }
}

//- single_line_container_with_multiline_children_10
fn f() {
    x = [{ y: {} }]
}
//=== EXPECTED ===
fn f() {
    x = [
        {
            y : {
            }
        }
    ]
}

//- single_line_container_with_multiline_children_11
fn f() {
    let a = [1, { let x = 5; x * 2 }]
}
//=== EXPECTED ===
fn f() {
    let a = [
        1,
        {
            let x = 5
            x * 2
        }
    ]
}

//- single_line_container_with_multiline_children_12
fn f() {
    let t = ({ let x = 5; x * 2 }, 1)
}
//=== EXPECTED ===
fn f() {
    let t = (
        {
            let x = 5
            x * 2
        },
        1
    )
}

//- qualified_call_keeps_path_separators_tight
fn probe() {
    app_world::world_tick::update(actor)
}

//- contextual_ascription_normalizes_spacing
fn ratio(value: int) {
    let wide = (value  :  float)
    let tight = (value:float)
    let sum = ((value + 1) : float)
}
//=== EXPECTED ===
fn ratio(value: int) {
    let wide = (value : float)
    let tight = (value : float)
    let sum = ((value + 1) : float)
}

//- path_qualified_return_literal
fn profile(mob: Mob) {
    if mob.active { return app_world::world_tick::WorldActorTurnProfile { move_speed: mob.move_speed() } }
}
