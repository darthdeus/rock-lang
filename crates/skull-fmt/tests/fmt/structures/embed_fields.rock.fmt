//! Test: `embed` field modifier survives formatting

//- embed_field_preserved
struct Holder {
    embed p: Pt
    tag: int
}

//- embed_field_normalizes_spacing
struct Holder {
    embed    p:Pt
    tag:int
}
//=== EXPECTED ===
struct Holder {
    embed p: Pt
    tag: int
}

//- embed_as_field_name_is_not_a_modifier
struct Legacy {
    embed: int
    other: int
}
