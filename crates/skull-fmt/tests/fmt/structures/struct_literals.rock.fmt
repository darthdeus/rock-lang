//=== TEST CASE: multifield_struct_trailing_comma ===
fn test() {
    let settings = AppSettings {
        theme: Theme::Dark,
        auto_save: true,
        backup_enabled: false,
        max_connections: 100,
    }
}

//=== NO CHANGE ===



//=== TEST CASE:struct_trailing_comma_consistency ===

fn test() {
    // Single field - no trailing comma
    let simple = Simple { value: 1 }

    // Multiple fields - trailing comma
    let complex = Complex {
        field1: "value1",
        field2: "value2",
    }
}

//=== NO CHANGE ===
