    let simple = SimpleStruct { a: 1, b: 2 }
    let point = Point { x: 0.0, y: 0.0 }
}

//=== NO CHANGE ===



//=== TEST CASE:struct_literal_multiline ===

fn test() {
    let complex = ComplexStruct {
        field_one: calculate_value(),
        field_two: another_function(param1, param2),
        field_three: nested_struct {
            inner_field: "value",
        },
        field_four: long_expression + another_long_expression,
    }
}

//=== NO CHANGE ===

