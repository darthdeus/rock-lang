//! Test: Struct literal formatting
//! Tags: structs, literals, single-line, multiline

//=== TEST CASE: simple_struct_literals_oneline ===
fn test() {
    let point = Point { x: 10, y: 20 }
    let color = Color { r: 255, g: 0, b: 0 }
    let small = Small { value: 42 }
}

//=== NO CHANGE ===



//=== TEST CASE: struct_literal_single_line ===
