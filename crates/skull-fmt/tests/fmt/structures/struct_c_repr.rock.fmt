//! Test: value struct formatting round-trip

//- basic_value
value FixVec2 {
    x: float,
    y: float,
}

//- empty_value
value Empty {}

//- value_many_fields
value GraphicsStats {
    draw_calls: int,
    text_draw_calls: int,
    canvas_switches: int,
    shader_switches: int,
    images: int,
    canvases: int,
    texture_memory: int,
}

//- mixed_struct_and_value
struct Regular {
    name: string,
}

value CRepr {
    x: float,
}

//- value_multi_field_not_collapsed
value FixVec2 { x: float, y: float }

//- value_with_defaults
value WithDefaults {
    x: float = 1.0,
    y: float = 2.0,
}
