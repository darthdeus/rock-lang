//=== TEST CASE:if_statements_with_aligned_comments_preservation ===

fn test() {
    if state == State::Loading {    // Still initializing
        show_spinner()
    } else if state == State::Ready {  // Ready for user input
        enable_controls()
    } else {                        // Error state
        show_error_message()
    }
}

//=== EXPECTED ===
fn test() {
    if state == State::Loading {
        // Still initializing
        show_spinner()
    } else if state == State::Ready {
        // Ready for user input
        enable_controls()
    } else {
        // Error state
        show_error_message()
    }
}
