//=== TEST CASE: deeply_nested_indentation_stress_test ===
fn complex_nested_logic() {
    for i in [1, 2, 3] {
        if true {
            for j in [4, 5, 6] {
                if true {
                    let result = {
                        nested_field = if true {
                            {
                                deeply_nested = true;
                                level = 4;
                                data = [
                                    1,
                                    2,
                                    3
                                ]
                            }
                        } else {
                            null
                        };
                        other_field = "value"
                    }

                    if true {
                        while false {
                            let batch = [7, 8, 9]
                            for item in batch {
                                if true {
                                    log("Processing")
                                }
                            }
                        }
                    } else {
                        log("Processing failed")
                    }
                }
            }
        }
    }
}

//=== EXPECTED ===
