//=== TEST CASE:nested_if_expressions ===

fn test() {
    let result = if game_state == GameState::Playing {
        if player.position.distance_to(objective) < trigger_radius {
            if player.has_required_items && !enemies_nearby { complete_objective() } else { show_hint() }
        } else {
            update_waypoint()
        }
    } else {
        pause_menu()
    }
}

