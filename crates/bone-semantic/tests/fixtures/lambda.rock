//- lambda_identity
fn f() -> int {
    let g = (x: int) => x
      //^ fn(int) -> int
    5
}

//- lambda_to_bool
fn f() -> int {
    let g = (x: int) => x < 5
      //^ fn(int) -> bool
    5
}

//- lambda_two_params
fn f() -> int {
    let g = (x: int, y: int) => x
      //^ fn(int, int) -> int
    5
}

//- lambda_zero_params
fn f() -> int {
    let g = () => 5
      //^ fn() -> int
    5
}

//- lambda_captures_outer
fn f() -> int {
    let n = 10
    let g = (x: int) => x < n
      //^ fn(int) -> bool
    5
}

//- lambda_struct_param
struct Point { x: int, y: int }
fn f() -> int {
    let g = (p: Point) => p.x
      //^ fn(Point) -> int
    5
}

//- lambda_returns_lambda
fn f() -> int {
    let g = (x: int) => (y: int) => x
      //^ fn(int) -> fn(int) -> int
    5
}
