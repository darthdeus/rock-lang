struct Box<T> { value: T }
//- generic_struct_field_int
fn f(b: Box<int>) -> int {
    let v = b.value
      //^ int
    5
}

//- generic_struct_field_string
fn f(b: Box<string>) -> string {
    let v = b.value
      //^ string
    "hi"
}

//- generic_struct_type_renders
fn f(b: Box<int>) -> int {
   //^ Box<int>
    5
}

//- generic_struct_literal_int
fn f() -> int {
    let b = Box { value: 5 }
      //^ Box<int>
    5
}

//- generic_struct_literal_string
fn f() -> int {
    let b = Box { value: "hi" }
      //^ Box<string>
    5
}
