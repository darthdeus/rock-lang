//! Unqualified enum patterns in match: `match c { A => .. }` (no `Choice::`).
//! lowering keeps enum_name=None; check_pattern resolves the bare variant against
//! the scrutinee's enum (its nominal name).

//- unqualified_variant
enum Choice { A, B }
fn f(c: Choice) -> int {
    let r = match c {
        A => 1
        B => 2
    }
    let y = r
      //^ int
    y
}

// SENTINEL -- PINNED BUG. A variant name that doesn't exist on the scrutinee
// enum SHOULD be rejected; today it is silently accepted (the arm reads as an
// irrefutable binding), so a typo'd variant becomes a catch-all and the arms
// after it are dead. This section is INVERTED: it passes today BECAUSE the bug
// exists. When bone learns to reject it, this goes red -- restore the `@fail`
// marker, drop the type annotation, and delete this comment.
//- unqualified_unknown_variant_sentinel
enum Choice { A, B }
fn f(c: Choice) -> int {
    let r = match c {
        A => 1
        Nope => 2
    }
    let y = r
      //^ int
    y
}
