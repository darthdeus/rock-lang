//- unqualified_variant
enum Choice { A, B }
fn f(c: Choice) -> int {
    let r = match c {
        A => 1
        B => 2
    }
    let y = r
      //^ int
    y
}

//- lowercase_arm_binds
enum Choice { A, B }
fn f(c: Choice) -> int {
    let r = match c {
        A => 1
        other => match other {
          //^ Choice
            B => 2
            _ => 3
        }
    }
    r
}

//- wildcard_arm_ok
enum Choice { A, B }
fn f(c: Choice) -> int {
    let r = match c {
        A => 1
        _ => 2
    }
    let y = r
      //^ int
    y
}

//- nested_uppercase_binds
enum Wrap { One(int), Two }
fn f(w: Wrap) -> int {
    let r = match w {
        One(N) => N
             //^ int
        Two => 0
    }
    r
}

//- arm_binding_shadows_outer
enum Choice { A, B }
fn f(c: Choice) -> int {
    let other = 7
    let r = match c {
        A => other
        other => match other {
          //^ Choice
            B => 2
            _ => 3
        }
    }
    r
}

//- uppercase_arm_over_non_enum_binds
fn f(n: int) -> int {
    let r = match n {
        0 => 1
        N => N
           //^ int
    }
    r
}

//- uppercase_arm_over_tuple_binds
fn f(t: (int, int)) -> int {
    let r = match t {
        (0, 0) => 0
        P => P.0
           //^ (int, int)
    }
    r
}
