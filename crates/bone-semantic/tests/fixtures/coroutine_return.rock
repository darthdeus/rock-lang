//! co fn `return e` checks e against R (the Coroutine's 2nd param), not the
//! whole Coroutine type. `Coroutine<int, string>` synthesizes N=(); R=string.

//- coroutine_return_r
co fn g() -> Coroutine<int, string> {
    yield 1
    return "done"
}
fn carrier() -> int {
    let x = 5
      //^ int
    x
}
