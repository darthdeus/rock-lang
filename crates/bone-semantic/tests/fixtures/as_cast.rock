//! @no_check
//! Cast expressions: `e as T`. `as` is a checked explicit conversion -- the
//! operand's inferred type must reach `T` through the closed conversion
//! relation (`int`/`float` either way, or ordinary assignment compatibility).
//! The result type is `T`.

//- as_int_to_float
fn f() -> int {
    let x = 5 as float
      //^ float
    5
}

//- as_float_to_int
fn f() -> int {
    let x = 2.5 as int
      //^ int
    5
}

// `as` cannot reinterpret `any` as a nominal type: that asserts a type without
// static proof, a runtime nominal check, or backend representation validation.
// `cast<T>` is the explicit escape hatch for erased storage and FFI recovery.
//- as_to_nominal @fail
struct Point { x: int, y: int }
fn f(a: any) -> int {
    let p = a as Point
      //^ Point
    5
}
