//! @no_check
//! Cast expressions: `e as T`. The result type is the target annotation `T`
//! (the operand is still type-checked). Needs `Expr::As` HIR + lowering
//! (`ExprKind::As`, lowering the TypeExpr) + inference (infer operand, return T).

//- as_int_to_float
fn f() -> int {
    let x = 5 as float
      //^ float
    5
}

//- as_float_to_int
fn f() -> int {
    let x = 2.5 as int
      //^ int
    5
}

// the target may be a nominal type
//- as_to_nominal
struct Point { x: int, y: int }
fn f(a: any) -> int {
    let p = a as Point
      //^ Point
    5
}
