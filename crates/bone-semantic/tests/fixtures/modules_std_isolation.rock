//! Module lookup keeps package definitions separate from the stdlib.

//-- <file> @pkg=<self_name>,<id> [@v1]`;
//! a file without `@v1` is package.

//- a_package_overload_of_a_std_function_is_not_in_the_std_tier @fail=No overload for `lerp` with argument types (string, string, float)
//-- game.rock @pkg=game,3
fn lerp(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
fn g() -> string {
    lerp("a", "b", 0.5)
}

//- the_std_tier_keeps_the_std_members_beside_a_package_overload
//-- game.rock @pkg=game,3
fn lerp(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
fn g() -> float {
    let x = lerp(1.0, 2.0, 0.5)
            //^ float
    let y = std::lerp(1.0, 2.0, 0.5)
            //^ float
    x + y
}

//- a_std_path_names_only_std_members @fail=No overload for `lerp` with argument types (string, string, float)
//-- game.rock @pkg=game,3
fn lerp(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
fn g() -> string {
    std::lerp("a", "b", 0.5)
}

//- a_package_operator_overload_is_not_in_the_std_operator_family @fail=No overload for `__op_mod` with argument types (Vec2, Vec2)
//-- game.rock @pkg=game,3
operator %(a: Vec2, b: Vec2) -> Vec2 {
    a
}

//-- app.rock @pkg=app,2 @v1
fn g(a: Vec2, b: Vec2) -> Vec2 {
    a % b
}

//- package_callers_keep_the_whole_bare_family
//-- game.rock @pkg=game,3
fn lerp(a: string, b: string, t: float) -> string {
    a
}

operator %(a: Vec2, b: Vec2) -> Vec2 {
    a
}

//-- other.rock @pkg=game,3
fn use_them(a: Vec2, b: Vec2) -> string {
    let s = lerp("a", "b", 0.5)
            //^ string
    let f = lerp(1.0, 2.0, 0.5)
            //^ float
    let m = a % b
            //^ Vec2
    s
}

//-- app.rock @pkg=app,2 @v1
fn g() -> float {
    lerp(1.0, 2.0, 0.5)
}

//- a_std_function_value_is_not_overloaded_by_a_package_file
//-- game.rock @pkg=game,3
fn smoothstep(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
fn g() -> float {
    let f = smoothstep
    let x = f(1.0, 2.0, 0.5)
            //^ float
    x
}

//- a_std_function_value_passed_as_an_argument_is_the_std_definition
//-- game.rock @pkg=game,3
fn smoothstep(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
fn apply(f: fn(float, float, float) -> float) -> float {
    f(0.0, 1.0, 0.5)
}

fn g() -> float {
    let x = apply(smoothstep)
            //^ float
    let y = apply((smoothstep))
            //^ float
    let s = "{apply(smoothstep)}"
    x + y
}
