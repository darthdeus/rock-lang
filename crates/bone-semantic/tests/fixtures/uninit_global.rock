//! A typed global with no initializer is allowed (rock: `global image: Image`).
//! Its type comes from the annotation; there is no value expression to check.
//! Verified vs rock (tests/types/type_system.rock).

//- uninit_typed_global
struct Image { w: int, h: int }
global current: Image
fn f() -> int {
    let n = current.w
      //^ int
    n
}

// An initialized global still type-checks against its annotation.
//- init_global_still_works
struct Image { w: int, h: int }
global origin: Image = Image { w: 0, h: 0 }
fn f() -> int {
    let n = origin.h
      //^ int
    n
}
