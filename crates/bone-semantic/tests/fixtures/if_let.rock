//- if_let_unwrap_binding
fn f(o: int?) -> int {
    if let x = o {
        let y = x
          //^ int
    }
    5
}

//- if_let_else_value
fn f(o: int?) -> int {
    let r = if let x = o { x } else { 0 }
      //^ int
    r
}

//- if_let_chain
fn f(a: int?, b: int?) -> int {
    if let x = a && let y = b {
        let s = x
          //^ int
        let t = y
          //^ int
    }
    5
}
