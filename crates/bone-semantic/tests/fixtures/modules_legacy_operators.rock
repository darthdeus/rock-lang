//! Legacy operator declarations: `-` and `!` have a prefix form, and a
//! unary operator a file does not declare is not reached.
//!
//! Sections hold embedded files: `//-- <file> @pkg=<self_name>,<id> [@v1]`;
//! a file without `@v1` is legacy.

//- a_legacy_unary_operator_declarations
//-- legacy.rock
struct P {
    x: int,
}

operator -(a: P) -> P {
    P { x: 0 - a.x }
}

operator !(a: P) -> bool {
    a.x == 7
}

fn use_it(p: P) -> bool {
    let neg = -p
            //^ P
    let flag = !p
             //^ bool
    flag
}

//- a_legacy_one_parameter_binary_only_operator_is_rejected @fail=operator `+` takes two parameters; only `-` and `!` have a prefix (unary) form
//-- legacy.rock
struct P {
    x: int,
}

operator +(a: P) -> P {
    a
}

//- a_legacy_unimported_unary_operator_is_not_reached @fail=operator `-` is not defined for `P`
//-- legacy.rock
struct P {
    x: int,
}

fn neg() -> P {
    -P { x: 1 }
}
