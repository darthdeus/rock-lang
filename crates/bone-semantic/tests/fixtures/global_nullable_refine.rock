value Player { name: string }
global P: Player? = null

value Inner { v: int }
struct Outer { inner: Inner? }
global G: Outer = Outer { inner: null }

fn impure() -> int { 0 }

fn global_refine_basic() -> Player? {
    if P != null {
        P
      //^ Player
    } else {
        null
    }
}

fn global_refine_field_access() -> string {
    if P != null {
        let nm = P.name
          //^ string
        nm
    } else {
        "none"
    }
}

fn global_refine_field_path() -> int {
    if G.inner != null {
        let n = G.inner.v
          //^ int
        n
    }
    0
}

fn global_refine_guard_early_return() -> string {
    if P == null {
        return "none"
    }
    let nm = P.name
      //^ string
    nm
}

@pure fn noop() -> int { 0 }
fn global_refine_survives_pure_call() -> int {
    if P != null {
        let a = noop()
        P
      //^ Player
    }
    0
}

@pure fn ok() -> bool { return true }
fn global_refine_survives_pure_in_cond() -> int {
    if P != null && ok() {
        P
      //^ Player
    }
    0
}

fn global_refine_use_before_impure_call() -> int {
    if P != null {
        let n = P.name
          //^ string
        impure()
    }
    0
}

fn global_refine_dropped_after_impure_call() -> int {
    if P != null {
        impure()
        P
      //^ Player?
    }
    0
}

fn global_refine_field_path_dropped_after_impure_call() -> int {
    if G.inner != null {
        impure()
        let n = G.inner
          //^ Inner?
        n
    }
    0
}

fn global_refine_dropped_after_write() -> int {
    if P != null {
        P = null
        P
      //^ Player?
    }
    0
}

fn global_not_refined_inside_lambda_body() -> int {
    if P != null {
        let g = () => {
            let q = P
              //^ Player?
            0
        }
        return g()
    }
    return 0
}

co fn global_refine_dropped_after_yield() -> Coroutine<int> {
    if P != null {
        yield 1
        P
      //^ Player?
    }
}

fn impure_condition() -> bool { return true }
fn global_refine_dropped_after_impure_in_cond() -> int {
    if P != null && impure_condition() {
        P
      //^ Player?
    }
    0
}

fn global_refine_restored_after_branch() -> int {
    if P != null {
        let a = P
          //^ Player
    }
    let b = P
      //^ Player?
    0
}
