//! Marker `//^` sits on the expression whose type is under test. The "refine"

//- global_refine_basic
value Player { name: string }
global P: Player? = null
fn f() -> Player? {
    if P != null {
        P
      //^ Player
    } else {
        null
    }
}

//- global_refine_field_access
value Player { name: string }
global P: Player? = null
fn f() -> string {
    if P != null {
        let nm = P.name
          //^ string
        nm
    } else {
        "none"
    }
}

//- global_refine_field_path
value Inner { v: int }
struct Outer { inner: Inner? }
global G: Outer = Outer { inner: null }
fn f() -> int {
    if G.inner != null {
        let n = G.inner.v
          //^ int
        n
    }
    0
}

//- global_refine_guard_early_return
value Player { name: string }
global P: Player? = null
fn f() -> string {
    if P == null {
        return "none"
    }
    let nm = P.name
      //^ string
    nm
}

//- global_refine_survives_pure_call
value Player { name: string }
global P: Player? = null
@pure fn noop() -> int { 0 }
fn f() -> int {
    if P != null {
        let a = noop()
        P
      //^ Player
    }
    0
}

//- global_refine_survives_pure_in_cond
value Player { name: string }
global P: Player? = null
@pure fn ok() -> bool { return true }
fn f() -> int {
    if P != null && ok() {
        P
      //^ Player
    }
    0
}

//- global_refine_use_before_impure_call
value Player { name: string }
global P: Player? = null
fn impure() -> int { 0 }
fn f() -> int {
    if P != null {
        let n = P.name
          //^ string
        impure()
    }
    0
}

//- global_refine_dropped_after_impure_call
value Player { name: string }
global P: Player? = null
fn impure() -> int { 0 }
fn f() -> int {
    if P != null {
        impure()
        P
      //^ Player?
    }
    0
}

//- global_refine_field_path_dropped_after_impure_call
value Inner { v: int }
struct Outer { inner: Inner? }
global G: Outer = Outer { inner: null }
fn impure() -> int { 0 }
fn f() -> int {
    if G.inner != null {
        impure()
        let n = G.inner
          //^ Inner?
        n
    }
    0
}

//- global_refine_dropped_after_write
value Player { name: string }
global P: Player? = null
fn f() -> int {
    if P != null {
        P = null
        P
      //^ Player?
    }
    0
}

//- global_not_refined_inside_lambda_body
value Player { name: string }
global P: Player? = null
fn f() -> int {
    if P != null {
        let g = () => {
            let q = P
              //^ Player?
            0
        }
        return g()
    }
    return 0
}

//- global_refine_dropped_after_yield
value Player { name: string }
global P: Player? = null
co fn f() -> Coroutine<int> {
    if P != null {
        yield 1
        P
      //^ Player?
    }
}

//- global_refine_dropped_after_impure_in_cond
value Player { name: string }
global P: Player? = null
fn impure() -> bool { return true }
fn f() -> int {
    if P != null && impure() {
        P
      //^ Player?
    }
    0
}

//- global_refine_restored_after_branch
value Player { name: string }
global P: Player? = null
fn f() -> int {
    if P != null {
        let a = P
          //^ Player
    }
    let b = P
      //^ Player?
    0
}
