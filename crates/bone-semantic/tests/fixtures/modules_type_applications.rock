pub mod types;
pub struct Pair<T, U = int> { pub a: T, pub b: U }
pub enum Choice<T, U = int> { First(T), Second(U) }
pub newtype Wrapped<T, U = int>((T, U))

//-- main.rock @pkg=sample,1 @v1
fn second(p: types::Pair<string>, c: types::Choice<string>, w: types::Wrapped<string>) -> int {
    let local: types::Pair<string> = p
    let pair = local
             //^ sample::types::Pair<string, int>
    let choice = c
               //^ sample::types::Choice<string, int>
    let wrapped = w
                //^ sample::types::Wrapped<string, int>
    local.b
}

