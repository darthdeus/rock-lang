//- nullable_multiply @fail=operator `*` expects operands (int, int), got (int?, int)
value Vector { x: int }
operator(lua) *(a: int, b: int) -> int = "return a * b"
operator(lua) *(a: float, b: float) -> float = "return a * b"
operator *(a: Vector, b: Vector) -> Vector { a }
fn multiply(x: int?, y: int) -> int { x * y }

//- nullable_right @fail=operator `*` expects operands (int, int), got (int, int?)
operator(lua) *(a: int, b: int) -> int = "return a * b"
operator(lua) *(a: float, b: float) -> float = "return a * b"
fn multiply(x: int, y: int?) -> int { x * y }

//- both_nullable @fail=operator `*` expects operands (int, int), got (int?, int?)
operator(lua) *(a: int, b: int) -> int = "return a * b"
operator(lua) *(a: float, b: float) -> float = "return a * b"
fn multiply(x: int?, y: int?) -> int { x * y }

//- competing_nonnullable @fail=Ambiguous overload
operator(lua) *(a: int, b: float) -> float = "return a * b"
operator(lua) *(a: float, b: int) -> float = "return a * b"
fn multiply(x: int, y: int) -> float { x * y }

//- competing_nullable @fail=available overloads:
operator(lua) *(a: int, b: float) -> float = "return a * b"
operator(lua) *(a: float, b: int) -> float = "return a * b"
fn multiply(x: int?, y: int?) -> float { x * y }

//- unrelated_mismatch @fail=available overloads:
operator(lua) *(a: int, b: int) -> int = "return a * b"
operator(lua) *(a: float, b: float) -> float = "return a * b"
fn multiply(x: int?, y: string) -> int { x * y }

//- nullable_aware_overload
operator(lua) *(a: int?, b: int) -> int = "return (a or 0) * b"
operator(lua) *(a: int, b: int) -> int = "return a * b"
fn multiply(x: int?, y: int) -> int {
    let result = x * y
      //^ int
    result
}

//- refined_operand
operator(lua) *(a: int, b: int) -> int = "return a * b"
operator(lua) *(a: float, b: float) -> float = "return a * b"
fn multiply(x: int?, y: int) -> int {
    if x == null { return 0 }
    let result = x * y
      //^ int
    result
}
