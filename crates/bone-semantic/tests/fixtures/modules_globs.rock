//! Glob imports open only the members accessible from the importing
//! fragment (spec 8.1, 8.3 tier 4, 9). An inaccessible member never enters
//! tier selection: it neither shadows a lower tier nor makes a glob
//! ambiguous. A glob also opens its target's export bindings, explicit and
//! glob, followed to a fixed point; a binding admits only the audience its
//! own visibility and the original definition's both admit (spec 8.6).
//!
//! Sections hold embedded files: `//-- <file> @pkg=<self_name>,<id> [@v1]`.

//- a_private_glob_member_does_not_shadow_std
//-- lib_b.rock @pkg=chess,1 @v1
mod b;

fn is_nan(x: int) -> int {
    x
}

//-- lib_c.rock @pkg=chess,1 @v1
mod c;

use super::b::*;

fn check(v: float) -> bool {
    let r = is_nan(v)
            //^ bool
    r
}

//- a_private_glob_member_does_not_make_another_glob_ambiguous
//-- lib_a.rock @pkg=chess,1 @v1
mod a;

pub fn width() -> string {
    "wide"
}

//-- lib_b.rock @pkg=chess,1 @v1
mod b;

fn width() -> int {
    1
}

//-- lib_c.rock @pkg=chess,1 @v1
mod c;

use super::a::*;
use super::b::*;

fn pick() -> string {
    let w = width()
            //^ string
    w
}

//- a_child_glob_of_its_parent_sees_the_parent_private_members
