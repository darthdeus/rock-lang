//- enum_as_type
enum Color { Red, Green, Blue }
fn f(c: Color) -> int {
   //^ Color
    5
}

//- enum_payload_def
enum Shape { Circle(float), Rect(float, float) }
fn f(s: Shape) -> int {
   //^ Shape
    5
}

//- generic_enum_type
enum Option<T> { Some(T), None }
fn f(o: Option<int>) -> int {
   //^ Option<int>
    5
}

//- enum_unit_construct
enum Color { Red, Green, Blue }
fn f() -> Color {
    Color::Red
  //^ Color
}

//- enum_payload_construct
enum Shape { Circle(float), Rect(float, float) }
fn f() -> Shape {
    Shape::Circle(1.5)
  //^ Shape
}

//- generic_enum_construct
enum Option<T> { Some(T), None }
fn f() -> Option<int> {
    Option::Some(5)
  //^ Option<int>
}

//- enum_record_construct
enum Shape { Dot, Rect { w: float, h: float } }
fn f() -> Shape {
    Shape::Rect { w: 1.0, h: 2.0 }
  //^ Shape
}
