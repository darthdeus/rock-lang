//- deco_body_checks
//-- deco_body_checks.rock
deco init reg {
    let n: string = target.name
    let fp = target.func
}
fn f(x: int) -> int {
    x
  //^ int
}

//- deco_param_typed
//-- deco_param_typed.rock
deco init staged(stage: int = 100) {
    let s: int = stage
}
fn h(y: int) -> int {
    y
  //^ int
}

//- decorated_fn_checks
//-- decorated_fn_checks.rock
deco init reg {
    let n: string = target.name
}
@reg
fn g(n: int) -> int {
    let x = n
      //^ int
    x
}
