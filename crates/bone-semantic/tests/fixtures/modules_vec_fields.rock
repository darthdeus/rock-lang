//- vec_len_field
//-- vec_len_field.rock
fn f(v: [int]) -> int {
    let n = v.len
      //^ int
    n
}

//- vec_data_field
//-- vec_data_field.rock
fn f(v: [int]) -> any {
    let d = v._data
      //^ any
    d
}

//- vec_literal_is_array
//-- vec_literal_is_array.rock
fn make<T>() -> [T] {
    return Vec { _data: 0, len: 0 }
}
fn f() -> int {
    let xs: [int] = make()
    let n = xs.len
      //^ int
    n
}
