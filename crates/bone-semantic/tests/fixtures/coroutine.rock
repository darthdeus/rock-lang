//- co_fn_yield_ok
co fn echo() -> Coroutine<string> {
    yield "hello"
    yield "world"
}
fn carrier() -> int {
    let x = 5
      //^ int
    x
}

//- yield_star
co fn inner() -> Coroutine<int> {
    yield 1
    yield 2
}
co fn outer() -> Coroutine<int> {
    yield 0
    await inner()
}
fn carrier() -> int {
    let x = 5
      //^ int
    x
}
