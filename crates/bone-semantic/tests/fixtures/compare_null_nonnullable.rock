//- compare_nullable_to_null_ok
fn f(x: int?) -> bool {
    let r = x != null
      //^ bool
    r
}

//- compare_any_to_null_ok
fn f(x: any) -> bool {
    let r = x != null
      //^ bool
    r
}

//- compare_after_null_assignment_ok
struct S { v: int }
fn f(x: S?) -> bool {
    x = null
    let r = x != null
      //^ bool
    r
}
