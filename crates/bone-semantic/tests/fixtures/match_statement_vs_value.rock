//- stmt_match_mismatched_arms
fn gives_bool() -> bool { true }
fn f() -> int {
    let x = 1
    match x {
        1 => { gives_bool() }
        _ => { x = 2 }
    }
    let y = x
      //^ int
    y
}

//- value_match_uniform
fn f() -> int {
    let x = 1
    let u = match x {
        1 => 10,
        _ => 20,
    }
      //^ int
    u
}
