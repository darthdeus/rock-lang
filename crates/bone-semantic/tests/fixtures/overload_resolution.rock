fn pick(x: int) -> int { x }
//- select_by_arg_type
fn pick(x: bool) -> bool { x }
fn f() -> bool {
    let r = pick(true)
      //^ bool
    r
}

//- exact_preferred_over_any
fn pick(x: any) -> any { x }
fn f() -> int {
    let r = pick(5)
      //^ int
    r
}

//- any_fallback
fn pick(x: any) -> any { x }
fn f() -> any {
    let r = pick("hi")
      //^ any
    r
}
