//- tuple_two_elem
fn tup(p: (int, int)) -> int {
    match p { (0, 0) => 100, (1, y) => y, (x, _) => x }
}
fn f(p: (int, int)) -> int {
    let r = tup(p)
      //^ int
    r
}

//- tuple_mixed_types
fn g(p: (int, string)) -> string {
    match p { (0, s) => s, (_, t) => t }
}
fn f(p: (int, string)) -> string {
    let r = g(p)
      //^ string
    r
}

//- tuple_three_elem
fn h(p: (int, int, int)) -> int {
    match p { (a, _, _) => a }
}
fn f(p: (int, int, int)) -> int {
    let r = h(p)
      //^ int
    r
}
