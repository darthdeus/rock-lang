//! Tuple patterns `(a, b)` in match arms. The scrutinee must be a tuple type;
//! each element pattern is checked against the corresponding element type.
//! Unlike or-patterns, tuple patterns DO bind variables. Verified vs rock
//! (tests/patterns/literal_range_tuple.rock).

// Literal + binding + wildcard element patterns; result is the arm-body type.
//- tuple_two_elem
fn tup(p: (int, int)) -> int {
    match p { (0, 0) => 100, (1, y) => y, (x, _) => x }
}
fn f(p: (int, int)) -> int {
    let r = tup(p)
      //^ int
    r
}

// Element types propagate: the second element binds as `string`.
//- tuple_mixed_types
fn g(p: (int, string)) -> string {
    match p { (0, s) => s, (_, t) => t }
}
fn f(p: (int, string)) -> string {
    let r = g(p)
      //^ string
    r
}

// Three elements, all bound.
//- tuple_three_elem
fn h(p: (int, int, int)) -> int {
    match p { (a, _, _) => a }
}
fn f(p: (int, int, int)) -> int {
    let r = h(p)
      //^ int
    r
}

// A tuple pattern against a non-tuple scrutinee is rejected.
//- tuple_on_non_tuple_rejected @fail
fn f(n: int) -> int {
    match n { (a, b) => a, _ => 0 }
}

// Element-count mismatch is rejected.
//- tuple_arity_mismatch_rejected @fail
fn f(p: (int, int)) -> int {
    match p { (a, b, c) => a, _ => 0 }
}
