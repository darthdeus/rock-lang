fn id<T>(x: T) -> T { x }
//- generic_identity_body
       //^ T
//                ^ T
//                    ^ T

//- generic_identity_return
//                ^ T

//- generic_call_int
fn f() -> int { id(5) }
              //^ int

//- generic_call_bool
fn f() -> bool { id(true) }
               //^ bool

//- generic_call_var_arg
fn f() -> int {
    let n = 5
    id(n)
  //^ int
}
