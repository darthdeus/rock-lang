//- index_array_int
fn f() -> int {
    let xs = [1, 2, 3]
    let x = xs[0]
      //^ int
    5
}

//- index_array_bool
fn f() -> int {
    let xs = [true, false]
    let x = xs[1]
      //^ bool
    5
}

//- index_array_nested
fn f() -> int {
    let xs = [[1, 2], [3]]
    let row = xs[0]
      //^ [int]
    5
}

//- index_map
fn f(m: Map<string, int>) -> int {
    let v = m["k"]
      //^ int
    5
}
