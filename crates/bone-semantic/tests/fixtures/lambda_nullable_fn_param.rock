//- lambda_nullable_arg_unit_ret_tail_if
fn gives_bool() -> bool { true }
fn run(cb: (() -> ())?) -> int {
    if let c = cb { c() }
    1
}
fn f() -> int {
    let r = run(() => {
        let x = 1
        if x == 1 {
            gives_bool()
        }
    })
    let y = r
      //^ int
    y
}

//- lambda_nullable_arg_unit_ret_tail_iflet
fn gives_bool() -> bool { true }
fn run(cb: (() -> ())?) -> int {
    if let c = cb { c() }
    1
}
fn f() -> int {
    let opt: int? = 5
    let r = run(() => {
        if let m = opt {
            gives_bool()
        }
    })
    let y = r
      //^ int
    y
}

//- lambda_nullable_default_arg_unit_ret_tail_iflet
fn gives_bool() -> bool { true }
fn run(cb: (() -> ())? = null) -> int {
    if let c = cb { c() }
    1
}
fn f() -> int {
    let opt: int? = 5
    let r = run(() => {
        if let m = opt {
            gives_bool()
        }
    })
    let y = r
      //^ int
    y
}
