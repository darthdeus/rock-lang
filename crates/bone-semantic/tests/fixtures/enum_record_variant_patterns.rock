//- enum_record_qualified
enum Shape { Circle { r: int }, Square { side: int } }
fn f(s: Shape) -> int {
    let v = match s {
        Shape::Circle { r } => r,
        Shape::Square { side } => side,
    }
      //^ int
    v
}

//- enum_record_unqualified
enum Shape { Circle { r: int }, Square { side: int } }
fn f(s: Shape) -> int {
    let v = match s {
        Circle { r } => r,
        Square { side } => side,
    }
      //^ int
    v
}
