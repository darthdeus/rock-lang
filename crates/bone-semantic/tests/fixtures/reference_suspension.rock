//! A frame ref may be used in the segment where it was acquired. A path
//! that suspends must refresh the ref before using it again.

//- direct_place_and_explicit_ref_coroutine_arguments
value Cell { hp: int }
struct Player { hp: int }
co fn read(cell: ref Cell) -> Coroutine<int> { yield cell.hp }
co fn read(player: ref Player) -> Coroutine<int> { yield player.hp }
fn construct() {
    let cell = Cell { hp: 1 }
    let borrowed_cell: ref Cell = cell
    let explicit_cell = read(borrowed_cell)
    let direct_cell = read(cell)
    let player = Player { hp: 1 }
    let borrowed_player: ref Player = player
    let explicit_player = read(borrowed_player)
    let direct_player = read(player)
}

fn marker() -> int {
    5
  //^ int
}

//- parameter_finished_before_yield
struct Player { hp: int }
co fn tick(player: ref Player) -> Coroutine<int> {
    player.hp = 2
    yield 1
}

fn marker() -> int {
    5
  //^ int
}

//- local_ref_finished_before_yield
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    let borrowed: ref Cell = cell
    borrowed.hp = 2
    yield 1
}

fn marker() -> int {
    5
  //^ int
}

//- ref_acquired_after_yield
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    yield 1
    let borrowed: ref Cell = cell
    borrowed.hp = 2
    yield 2
}

fn marker() -> int {
    5
  //^ int
}

//- ref_reassigned_after_yield
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    let borrowed: ref Cell = cell
    borrowed.hp = 2
    yield 1
    borrowed = cell
    borrowed.hp = 3
    yield 2
}

fn marker() -> int {
    5
  //^ int
}

//- yield_path_returns_before_ref_use
value Cell { hp: int }
co fn tick(pause: bool) -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    let borrowed: ref Cell = cell
    if pause {
        yield 1
        return
    }
    borrowed.hp = 2
    yield 2
}

fn marker() -> int {
    5
  //^ int
}

//- loop_ref_is_fresh_each_iteration
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    while true {
        let borrowed: ref Cell = cell
        borrowed.hp = 2
        yield 1
    }
}

fn marker() -> int {
    5
  //^ int
}
