//! @no_check
//! A frame ref may be used in the segment where it was acquired. A path
//! that suspends must refresh the ref before using it again.

//- parameter_used_after_yield @fail=frame borrow is used after a coroutine suspension
struct Player { hp: int }
co fn tick(player: ref Player) -> Coroutine<int> {
    yield 1
    player.hp = 2
}

fn marker() -> int {
    5
  //^ int
}

//- local_ref_used_after_yield @fail=frame borrow is used after a coroutine suspension
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    let borrowed: ref Cell = cell
    yield 1
    borrowed.hp = 2
}

fn marker() -> int {
    5
  //^ int
}

//- alias_used_after_yield @fail=frame borrow is used after a coroutine suspension
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    let borrowed: ref Cell = cell
    let alias = borrowed
    yield 1
    alias.hp = 2
}

fn marker() -> int {
    5
  //^ int
}

//- conditional_yield_reaches_ref_use @fail=frame borrow is used after a coroutine suspension
value Cell { hp: int }
co fn tick(pause: bool) -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    let borrowed: ref Cell = cell
    if pause { yield 1 }
    borrowed.hp = 2
}

fn marker() -> int {
    5
  //^ int
}

//- loop_backedge_reaches_ref_use @fail=frame borrow is used after a coroutine suspension
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    let borrowed: ref Cell = cell
    while true {
        borrowed.hp = 2
        yield 1
    }
}

fn marker() -> int {
    5
  //^ int
}

//- defer_uses_ref_after_yield @fail=frame borrow is used after a coroutine suspension
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    let borrowed: ref Cell = cell
    defer { borrowed.hp = 2 }
    yield 1
}

fn marker() -> int {
    5
  //^ int
}

//- parameter_finished_before_yield
struct Player { hp: int }
co fn tick(player: ref Player) -> Coroutine<int> {
    player.hp = 2
    yield 1
}

fn marker() -> int {
    5
  //^ int
}

//- local_ref_finished_before_yield
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    let borrowed: ref Cell = cell
    borrowed.hp = 2
    yield 1
}

fn marker() -> int {
    5
  //^ int
}

//- ref_acquired_after_yield
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    yield 1
    let borrowed: ref Cell = cell
    borrowed.hp = 2
    yield 2
}

fn marker() -> int {
    5
  //^ int
}

//- ref_reassigned_after_yield
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    let borrowed: ref Cell = cell
    borrowed.hp = 2
    yield 1
    borrowed = cell
    borrowed.hp = 3
    yield 2
}

fn marker() -> int {
    5
  //^ int
}

//- yield_path_returns_before_ref_use
value Cell { hp: int }
co fn tick(pause: bool) -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    let borrowed: ref Cell = cell
    if pause {
        yield 1
        return
    }
    borrowed.hp = 2
    yield 2
}

fn marker() -> int {
    5
  //^ int
}

//- loop_ref_is_fresh_each_iteration
value Cell { hp: int }
co fn tick() -> Coroutine<int> {
    let cell = Cell { hp: 1 }
    while true {
        let borrowed: ref Cell = cell
        borrowed.hp = 2
        yield 1
    }
}

fn marker() -> int {
    5
  //^ int
}
