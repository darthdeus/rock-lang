//- for_nested_tuple
struct FIter<T> { last: T }
fn iter<T>(v: [T]) -> FIter<T> { return FIter { last: v[0] } }
fn next<T>(it: FIter<T>) -> (bool, T) { return (false, it.last) }
fn f() -> int {
    let xs: [(int, (int, string))] = [(1, (2, "a"))]
    let last = 0
    for (i, (n, s)) in xs {
        let m = n
          //^ int
        last = m
    }
    last
}

//- for_flat_tuple_still_works
struct FIter<T> { last: T }
fn iter<T>(v: [T]) -> FIter<T> { return FIter { last: v[0] } }
fn next<T>(it: FIter<T>) -> (bool, T) { return (false, it.last) }
fn f() -> int {
    let xs: [(int, string)] = [(1, "a"), (2, "b")]
    let result = 0
    for (n, s) in xs {
        let m = n
          //^ int
        result = m
    }
    result
}

//- let_nested_tuple
fn f() -> int {
    let pair: (int, (int, string)) = (1, (2, "a"))
    let (i, (n, s)) = pair
    let chk = n
      //^ int
    chk
}
