    1
}

pub fn depth() -> string {
    "deep"
}

//-- lib_c.rock @pkg=chess,1 @v1
mod c;

use super::inner::{self, ply};

fn f() -> string {
    let n = ply()
            //^ int
    let d = inner::depth()
            //^ string
    d
}

