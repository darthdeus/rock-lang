//! A fragment's explicit import that lands on a module is a path anchor for
//! that fragment (`use p::m as m;`, `use p::m::{self, x};`), and a
//! module's named export binding that lands on a module is a module member.
//! A path through either is checked as it is written: the
//! import's own path from the fragment, then each later segment and the
//! final member from the fragment, never the canonical parent path a second
//! time. An imported module name that clashes with a child module, a
//! dependency alias or the package's own name is a diagnostic, never a
//! silent pick; `self`, `super` and `std` are reserved.
//!
//! Sections hold embedded files: `//-- <file> @pkg=<self_name>,<id> [@v1]`.

//- an_alias_of_a_child_module_anchors_a_path
//-- lib.rock @pkg=chess,1 @v1
use inner as renamed;

fn f() -> int {
    let n = renamed::ply()
            //^ int
    n
}

//-- lib_inner.rock @pkg=chess,1 @v1
pub mod inner;

pub fn ply() -> int {
    1
}

//- an_alias_of_a_dependency_module_anchors_types_variants_literals_and_patterns
//-- lib.rock @pkg=geo,1 @v1
pub mod shapes;

//-- lib_shapes.rock @pkg=geo,1 @v1
mod shapes;

pub struct Pt {
    pub x: int,
}

pub enum Kind {
    Round,
    Sharp(int),
}

pub fn origin() -> Pt {
    Pt { x: 0 }
}

//-- app.rock @pkg=app,2 @v1
use geo::shapes as s;

fn describe(p: s::Pt, k: s::Kind) -> int {
    let q = s::Pt { x: p.x }
    let o = s::origin()
    let kind = s::Kind::Sharp(2)
    let echoed = kind
       //^ geo::shapes::Kind
    let n = match k {
        s::Kind::Sharp(d) => d,
                          //^ int
        s::Kind::Round => q.x + o.x,
    }
    n
}

