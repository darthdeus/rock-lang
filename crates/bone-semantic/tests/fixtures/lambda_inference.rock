//! Lambda-param bidirectional inference: when a lambda is passed where a
//! `fn(A) -> B` is expected, push A into its unannotated params (Check mode).
//! Covers both explicit `x => x.value` and the desugared placeholder `_.value`.

//- lambda_param_inferred
struct Box { value: int }
fn apply(f: fn(Box) -> int, b: Box) -> int { f(b) }
fn g() -> int {
    let r = apply(x => x.value, Box { value: 5 })
      //^ int
    5
}

//- placeholder_lambda_inferred
struct Box { value: int }
fn apply(f: fn(Box) -> int, b: Box) -> int { f(b) }
fn g() -> int {
    let r = apply(_.value, Box { value: 5 })
      //^ int
    5
}
