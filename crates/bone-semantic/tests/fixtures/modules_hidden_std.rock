//! A v1 scope tier that binds a callable hides the same-named std prelude
//! family. If the winning callable has no matching overload, the diagnostic
//! names the hidden std family so the caller can qualify or import it.
//!
//! Sections hold embedded files: `//-- <file> @pkg=<self_name>,<id> [@v1]`.

//- a_glob_hides_std_lerp_in_a_no_overload @fail=shadowed candidate `std::lerp`
//-- lib.rock @pkg=x_lib,1 @v1
pub fn lerp(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
use x_lib::*;

fn f() -> float {
    lerp(1.0, 2.0, 0.5)
}

//- an_explicit_import_hides_std_lerp_in_a_no_overload @fail=shadowed candidate `std::lerp`
//-- lib.rock @pkg=x_lib,1 @v1
pub fn lerp(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
use x_lib::lerp;

fn f() -> float {
    lerp(1.0, 2.0, 0.5)
}

//- an_own_definition_hides_std_lerp_in_a_no_overload @fail=shadowed candidate `std::lerp`
//-- app.rock @pkg=app,1 @v1
fn lerp(a: string, b: string, t: float) -> string {
    a
}

fn f() -> float {
    lerp(1.0, 2.0, 0.5)
}

//- a_winning_scope_call_has_no_hidden_std_note @fail=expected `float`, found `string` @not=shadowed candidate `std::lerp`
//-- lib.rock @pkg=x_lib,1 @v1
pub fn lerp(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
use x_lib::*;

fn f() -> float {
    lerp("a", "b", 0.5)
}
