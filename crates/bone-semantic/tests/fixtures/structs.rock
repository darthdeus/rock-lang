//- struct_param_type
struct Point { x: int, y: int }
fn f(p: Point) -> int {
   //^ Point
    5
}

//- struct_field_of_struct
value Inner { a: int }
struct Outer { inner: Inner }
fn f(o: Outer) -> int {
   //^ Outer
    5
}

//- struct_forward_ref
struct Outer { inner: Inner }
value Inner { a: int }
fn f(o: Outer) -> int {
   //^ Outer
    5
}

//- struct_literal_let
struct Point { x: int, y: int }
fn f() -> int {
    let p = Point { x: 1, y: 2 }
      //^ Point
    5
}

//- struct_literal_return
struct Point { x: int, y: int }
fn f() -> Point {
    let p = Point { x: 1, y: 2 }
      //^ Point
    p
}

//- struct_literal_reordered
struct Point { x: int, y: int }
fn f() -> int {
    let p = Point { y: 2, x: 1 }
      //^ Point
    5
}

//- struct_field_access
struct Point { x: int, y: int }
fn f() -> int {
    let p = Point { x: 1, y: 2 }
    let a = p.x
      //^ int
    5
}

//- struct_field_is_struct
value Inner { a: int }
struct Outer { inner: Inner }
fn f(o: Outer) -> int {
    let i = o.inner
      //^ Inner
    5
}

//- struct_field_chain
value Inner { a: int }
struct Outer { inner: Inner }
fn f(o: Outer) -> int {
    let a = o.inner.a
      //^ int
    5
}
