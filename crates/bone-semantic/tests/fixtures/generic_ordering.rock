//- generic_ordering_max
fn max<T>(a: T, b: T) -> T {
    if a > b { a } else { b }
}
fn f() -> int {
    let r = max(5, 3)
      //^ int
    r
}

//- generic_lt_yields_bool
fn lt<T>(a: T, b: T) -> bool {
    a < b
}
fn f() -> bool {
    let r = lt(1, 2)
      //^ bool
    r
}

//- int_ordering
fn f(a: int, b: int) -> bool {
    let r = a < b
      //^ bool
    r
}
