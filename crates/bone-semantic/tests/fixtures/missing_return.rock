//- return_satisfies
fn f() -> int {
    let x = 5
    return x
      //^ int
}

//- tail_satisfies
fn f() -> int {
    let x = 5
    x
  //^ int
}

//- no_return_type_ok
fn f() {
    let x = 5
      //^ int
}

//- bare_return_in_unit_fn_keeps_working
fn g(o: int?) {
    let x = o ?? return
      //^ int
}
