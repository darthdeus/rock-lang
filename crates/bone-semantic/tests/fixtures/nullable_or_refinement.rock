//- refine_or_rhs_field
struct S { v: int }
fn f(x: S?) -> bool {
    let ok = x == null || x.v > 0
      //^ bool
    return ok
}

//- refine_or_rhs_method
struct Corpse { hp: int }
fn Corpse.in_reach(c) -> bool {
    return c.hp > 0
}
fn f(c: Corpse?) -> bool {
    let ok = c == null || !c.in_reach()
      //^ bool
    return ok
}

//- refine_or_rhs_chain
value Inner { v: int }
struct Mid { inner: Inner? }
fn f(m: Mid?) -> bool {
    let ok = m == null || m.inner == null || m.inner.v > 0
      //^ bool
    return ok
}
