//! Intra-`||` refinement: the RHS of `||` runs only when the LHS is false, so it
//! `if c == null || !c.in_reach()` type-check -- the guard-combine of two
//! DIVERGENCE from rock: rock does not narrow across `||` operands at all. bone implements the intended dual-of-`&&`

//- refine_or_rhs_field
struct S { v: int }
fn f(x: S?) -> bool {
    let ok = x == null || x.v > 0
      //^ bool
    return ok
}

//- refine_or_rhs_method
struct Corpse { hp: int }
fn Corpse.in_reach(c) -> bool {
    return c.hp > 0
}
fn f(c: Corpse?) -> bool {
    let ok = c == null || !c.in_reach()
      //^ bool
    return ok
}

//- refine_or_rhs_chain
value Inner { v: int }
struct Mid { inner: Inner? }
fn f(m: Mid?) -> bool {
    let ok = m == null || m.inner == null || m.inner.v > 0
      //^ bool
    return ok
}
