//! Array-literal expressions: `[1, 2, 3]` infers to `[int]` (App Array). The
//! element types unify together and the result wraps them in the Array ctor.
//!
//! Marker sits on the `let` binding name (its inferred type).

//- array_literal_int
fn f() -> int {
    let xs = [1, 2, 3]
      //^ [int]
    5
}

//- array_literal_bool
fn f() -> int {
    let xs = [true, false]
      //^ [bool]
    5
}

// element types are themselves arrays -> recursion through inference
//- array_literal_nested
fn f() -> int {
    let xs = [[1, 2], [3]]
      //^ [[int]]
    5
}
