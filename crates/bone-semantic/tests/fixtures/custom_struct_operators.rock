//- struct_unary_minus
struct FixVec2 { x: int, y: int }
fn __unm(v: FixVec2) -> FixVec2 {
    FixVec2 { x: v.x, y: v.y }
}
fn f() -> FixVec2 {
    let v = FixVec2 { x: 3, y: 4 }
    let n = -v
      //^ FixVec2
    n
}

//- struct_not
struct BoolWrapper { v: bool }
fn __not(b: BoolWrapper) -> BoolWrapper {
    BoolWrapper { v: !b.v }
}
fn f() -> BoolWrapper {
    let b = BoolWrapper { v: true }
    let n = !b
      //^ BoolWrapper
    n
}

//- newtype_unary_minus
newtype Temperature(int)
fn f() -> Temperature {
    let t = Temperature(25)
    let n = -t
      //^ Temperature
    n
}

//- newtype_ordering
newtype Score(int)
fn f() -> bool {
    let a = Score(100)
    let b = Score(200)
    let r = a < b
      //^ bool
    r
}
