//- tuple_literal_pair
fn f() -> int {
    let t = (1, true)
      //^ (int, bool)
    5
}

//- tuple_literal_three
fn f() -> int {
    let t = (1, true, "hi")
      //^ (int, bool, string)
    5
}

//- tuple_literal_nested
fn f() -> int {
    let t = ((1, 2), true)
      //^ ((int, int), bool)
    5
}
