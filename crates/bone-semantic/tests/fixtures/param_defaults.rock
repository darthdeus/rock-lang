//! Function param defaults are inferred at DEFINITION, in the fn's own gamma:
//! (a) a default that doesn't fit the declared param type is rejected (rock
//! rejects `x: int = "oops"`); (b) a default calling an overloaded fn records
//! its overload resolution in the fn's BodyInference (skull's callee-side
//! default fill lowers the default expr with that inference — without the
//! entry the call can't be mangled and the fn gaps).
//!
//! The @fail section carries a caret annotation of the type it WOULD have if
//! the bad default were accepted, so a wrong-acceptance surfaces as "@fail
//! but passed" (RED) instead of a "no annotations" harness error.

//- param_default_type_mismatch @fail
fn f(x: int = "oops") -> int {
    return x
}
fn use_f() -> int {
    let r = f()
      //^ int
    return r
}

//- param_default_overloaded_call
struct V2 { x: float, y: float }
fn mk() -> V2 {
    return V2 { x: 0.0, y: 0.0 }
}
fn mk(x: float, y: float) -> V2 {
    return V2 { x: x, y: y }
}
fn draw(pos: V2, offset: V2 = mk()) -> float {
    return offset.x
}
fn use_it() -> float {
    let r = draw(V2 { x: 1.0, y: 2.0 })
      //^ float
    return r
}

//- param_default_widens_int_to_float
fn scale(factor: float = 2) -> float {
    return factor
}
fn use_scale() -> float {
    let s = scale()
      //^ float
    return s
}

// Params are NOT in scope inside defaults (rock: "defaults are injected at
// the call site and other params are not in scope"), so a default referencing
// a sibling param is rejected...
//- param_default_refs_param @fail
fn f2(a: int = 1, b: int = a) -> int {
    let r = b
      //^ int
    return r
}

// ...and a param named after a global fn does NOT shadow it in its own
// default — `color` here is the global fn, unambiguously (the host-library pattern
// `color: Color = color(0, 0, 0, 0)`).
//- param_default_shadowing_name_resolves_to_fn
struct Color2 { r: int }
fn color2(r: int) -> Color2 {
    return Color2 { r: r }
}
fn paint(color2: Color2 = color2(7)) -> int {
    let r = color2.r
      //^ int
    return r
}

// An explicit `null` overrides a nullable parameter's non-null default
// (EXPLICIT_NULL_DEFAULT, option A): `seed: int? = 42` is accepted and both
// `seeded()` and `seeded(null)` typecheck.
//- param_default_nullable_non_null_accepted
fn seeded(seed: int? = 42) -> int? {
    return seed
}
fn use_seeded() -> int {
    let a = seeded()
      //^ int?
    let b = seeded(null)
      //^ int?
    let s: int? = null
    let c = seeded(s)
      //^ int?
    return a ?? b ?? c ?? 0
}

//- param_default_nullable_struct_accepted
struct Hint { v: int }
fn hinted(hint: Hint? = Hint { v: 1 }) -> int {
    return (hint ?? Hint { v: 0 }).v
}
fn use_hinted() -> int {
    let r = hinted()
      //^ int
    let n = hinted(null)
      //^ int
    return n
}

//- param_default_nullable_method_accepted
struct Counter { c: int }
fn Counter.bump(self, n: int? = 1) -> int {
    return n ?? self.c
}
fn use_counter() -> int {
    let r = Counter { c: 0 }.bump()
      //^ int
    let n = Counter { c: 0 }.bump(null)
      //^ int
    return n
}

//- param_default_nullable_null_accepted
fn seeded2(seed: int? = null) -> int {
    let s = seed ?? 42
      //^ int
    return s
}
fn use_seeded2() -> int {
    let a = seeded2(null)
      //^ int
    let b = seeded2()
      //^ int
    return seeded2(7)
}

// A foreign function's default must be a literal: its Lua wrapper and Rock
// call sites can only supply a literal, so `h: H = H { v: 3 }` would arrive
// as nil when omitted.
//- param_default_inline_lua_non_literal_rejected @fail=default of `h` on a foreign function must be a literal
struct H { v: int }
inline(lua) fn lua_h(h: H = H { v: 3 }) -> int = "return h.v"
fn use_lua_h() -> int {
    let r = lua_h()
      //^ int
    return r
}

//- param_default_extern_ffi_non_literal_rejected @fail=default of `n` on a foreign function must be a literal
fn base() -> int {
    return 4
}
extern(ffi, "c") fn ffi_n(n: int = base()) -> int
fn use_ffi_n() -> int {
    let r = ffi_n()
      //^ int
    return r
}

//- param_default_foreign_literal_accepted
inline(lua) fn lua_lits(a: int = -1, b: float = 0.5, c: bool = true, d: string = "x", e: int? = null) -> int = "return a"
fn use_lua_lits() -> int {
    let r = lua_lits()
      //^ int
    return r
}
