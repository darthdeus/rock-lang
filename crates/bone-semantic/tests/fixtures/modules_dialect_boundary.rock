//! Legacy and v1 sources in one compilation unit do not name each other's
//! definitions: a v1 package reaches other v1 packages and std, a legacy file
//! reaches legacy definitions and std. (The host graph rejects a dependency
//! edge between the two.)
//!
//! Sections hold embedded files: `//-- <file> @pkg=<self_name>,<id> [@v1]`;
//! a file without `@v1` is legacy.

//- a_v1_path_does_not_reach_a_legacy_package @fail=no module `f` in path
//-- xlib.rock @pkg=x_lib,1
fn f(n: int) -> int {
    n
}

//-- app.rock @pkg=app,2 @v1
fn g() -> int {
    x_lib::f(1)
}

//- a_v1_glob_does_not_open_a_legacy_package @fail=invalid `use` target
//-- xlib.rock @pkg=x_lib,1
fn f(n: int) -> int {
    n
}

//-- app.rock @pkg=app,2 @v1
use x_lib::*;

fn g() -> int {
    f(1)
}

//- a_legacy_file_does_not_see_v1_exports @fail=Function `answer` doesn't exist
//-- lib.rock @pkg=v1_lib,1 @v1
pub fn answer() -> int {
    42
}

//-- game.rock @pkg=game,2
fn g() -> int {
    answer()
}

//- a_legacy_item_level_use_is_rejected @fail=item-level `use` requires modules v1
//-- lib.rock @pkg=v1_lib,1 @v1
pub fn answer() -> int {
    42
}

//-- game.rock @pkg=game,2
use v1_lib::answer;

fn g() -> int {
    answer()
}

//- both_dialects_reach_std
//-- lib.rock @pkg=v1_lib,1 @v1
pub fn half(x: float) -> float {
    let y = lerp(0.0, x, 0.5)
            //^ float
    y
}

//-- game.rock @pkg=game,2
fn quarter(x: float) -> float {
    let y = lerp(0.0, x, 0.25)
            //^ float
    y
}
