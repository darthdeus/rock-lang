//- an_own_heal_and_an_imported_heal_form_one_family
//-- actors.rock @pkg=actors,1 @v1
pub struct Actor {
    pub hp: int,
}

pub fn heal(a: Actor) -> Actor {
    a
}

//-- app.rock @pkg=app,2 @v1
use actors::{Actor, heal};

fn heal(n: int) -> int {
    n + 1
}

fn f(actor: Actor) -> int {
    let a = heal(actor)
      //^ actors::Actor
    let n = heal(3)
      //^ int
    a.hp + n + actor.heal().hp
}

//- a_lower_tier_global_does_not_block_std
//-- core.rock @pkg=core,1 @v1
pub global clamp: int = 3

//-- app.rock @pkg=app,2 @v1
use core::*;

pub struct Pt {
    pub x: float,
}

fn clamp(p: Pt) -> Pt {
    p
}

fn f() -> float {
    let x = clamp(1.0, 0.0, 2.0)
      //^ float
    x
}

//- an_own_global_shadows_a_std_function @fail=binds to
