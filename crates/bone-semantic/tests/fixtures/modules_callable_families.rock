fn f() -> float {
    lerp(1.0, 2.0, 0.5)
}

//- a_local_closure_named_like_a_std_function_still_shadows
//-- app.rock @pkg=app,1 @v1
fn f() -> int {
    let lerp = (x: int) => x + 1
    let n = lerp(3)
      //^ int
    n
}

//- a_local_closure_named_like_a_std_function_hides_it_in_a_mismatch @fail
//-- app.rock @pkg=app,1 @v1
fn f() -> float {
    let lerp = (x: int) => x + 1
    lerp(1.0, 2.0, 0.5)
