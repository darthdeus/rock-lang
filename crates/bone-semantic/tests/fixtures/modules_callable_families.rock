//- an_own_operator_and_a_glob_operator_form_one_family
//-- geo.rock @pkg=geo,1 @v1
pub struct Qt {
    pub x: int,
}

pub operator +(a: Qt, b: Qt) -> Qt {
    Qt { x: a.x + b.x }
}

//-- app.rock @pkg=app,2 @v1
use geo::*;

pub struct Pt {
    pub x: int,
}

operator +(a: Pt, b: Pt) -> Pt {
    Pt { x: a.x + b.x }
}

fn f() -> int {
    let p = Pt { x: 1 } + Pt { x: 2 }
      //^ app::Pt
    let q = Qt { x: 1 } + Qt { x: 2 }
      //^ geo::Qt
    let n = 1 + 2
      //^ int
    p.x + q.x + n
}

