//- ident_name_into_struct
macro decl_pair(Name: ident) {
    struct Name { x: int }
}
decl_pair(Holder)
fn use_it() -> int {
    let h = Holder { x: 7 }
    let v = h.x
      //^ int
    v
}

//- ty_into_field_type
macro decl_holder(Name: ident, Elem: ty) {
    struct Name { v: Elem }
}
decl_holder(StrHolder, string)
fn use_it() -> string {
    let h = StrHolder { v: "hi" }
    let s = h.v
      //^ string
    s
}

