//- operator_import_selects_user_plus
//-- geo.rock @pkg=geo,1 @v1
pub struct Vec2 { pub x: int, pub y: int }
pub operator +(a: Vec2, b: Vec2) -> Vec2 {
    Vec2 { x: a.x, y: a.y }
}

//-- app.rock @pkg=app,2 @v1
use geo::{Vec2, operator(+)};
fn f() -> Vec2 {
    let a = Vec2 { x: 1, y: 2 }
    let b = Vec2 { x: 3, y: 4 }
    a + b
}

//- qualified_user_fieldref_keeps_normal_nominal_identity
//-- other.rock @pkg=app,1 @v1
mod other;
pub struct FieldRef<T, V> {
    pub value: V,
}

//-- app.rock @pkg=app,1 @v1
use app::other::FieldRef as FieldRef;

fn read(r: FieldRef<int, int>) -> int {
    r.value
}

//- qualified_user_fieldref_rejects_sibling_ref @fail=field reference `.health` is only valid against an expected
