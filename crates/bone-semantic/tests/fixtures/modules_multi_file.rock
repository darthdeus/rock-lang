operator +(a: Money, b: Money) -> Money {
    Money { cents: a.cents + b.cents }
}

//-- main.rock @pkg=game,2
fn use_it() -> int {
    let p = Pt { x: 1, y: 2 } + Pt { x: 3, y: 4 }
            //^ geo::Pt
    let m = Money { cents: 1 } + Money { cents: 2 }
            //^ Money
    m += Money { cents: 3 }
    p += Pt { x: 5, y: 6 }
    let n = 1 + 2
            //^ int
    p.x + m.cents + n
}

