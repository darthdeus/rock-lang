//- a_legacy_operator_reaches_a_projected_v1_overload
//-- geo.rock @pkg=geo,1 @v1
pub struct Pt {
    pub x: int,
    pub y: int,
}

pub operator +(a: Pt, b: Pt) -> Pt {
    Pt { x: a.x, y: b.y }
}

//-- main.rock @pkg=game,2
fn use_it() -> int {
    let a = Pt { x: 1, y: 2 }
    let c = a + a
            //^ geo::Pt
    let n = 1 + 2
            //^ int
    let f = 1.5 + 2.0
            //^ float
    c.x + n
}

//- a_legacy_compound_assignment_reaches_a_projected_v1_overload
//-- geo.rock @pkg=geo,1 @v1
pub struct Pt {
    pub x: int,
    pub y: int,
}

pub operator +(a: Pt, b: Pt) -> Pt {
    Pt { x: a.x, y: b.y }
}

//-- main.rock @pkg=game,2
fn use_it() -> int {
    let c = Pt { x: 1, y: 2 }
    c += Pt { x: 3, y: 4 }
    let n = 1
    n += 2
    let f = 1.5
    f += 2.0
    c.x + n
}

