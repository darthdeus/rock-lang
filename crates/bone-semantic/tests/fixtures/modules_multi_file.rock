//! Modules-v1 namespace resolution (plan M2): multi-file logical modules,
//! visibility, scope tiers, UFCS, operators, paths.
//!
//! Sections hold embedded files: `//-- <file> @pkg=<self_name>,<id> [@v1]`.
//! `//^ ty` markers are checked in every embedded file.

//- module_ownership_two_files_share_one_module
//-- lib.rock @pkg=chess,1 @v1
mod pieces;

//-- lib_pieces_a.rock @pkg=chess,1 @v1
mod pieces;

pub fn pawn_value() -> int {
    shared_base()
}

fn shared_base() -> int {
    1
}

//-- lib_pieces_b.rock @pkg=chess,1 @v1
mod pieces;

use chess::pieces::pawn_value;

fn doubled() -> int {
    let n = pawn_value()
            //^ int
    n
}

//- cross_package_qualified_paths
//-- lib.rock @pkg=chess,1 @v1
pub struct Board {
    pub size: int,
}

//-- app.rock @pkg=app,2 @v1
fn describe() -> int {
    let b = chess::Board { size: 8 }
    let n = b.size
            //^ int
    n
}

//- import_tiers_own_module_shadows_glob
//-- lib.rock @pkg=chess,1 @v1
pub mod util;

//-- lib_other.rock @pkg=chess,1 @v1
mod other;

pub fn width() -> string {
    "wide"
}

//-- lib_util.rock @pkg=chess,1 @v1
mod util;

use chess::other::*;

pub fn width() -> int {
    10
}

// Tier 2 (this logical module's own definition) wins over the tier 4 glob:
// the glob `width` returns string, so the marker below is the oracle.
pub fn outer_width() -> int {
    let n = width()
            //^ int
    n
}

//- root_alias_collision_rejects @fail
//-- bad.rock @pkg=chess,1 @v1
struct chess { x: int }

fn main() {}

//- struct_and_fn_same_name_reject @fail
//-- lib.rock @pkg=chess,1 @v1
struct Foo { x: int }
fn Foo() {}

//- child_module_and_fn_same_name_reject @fail
//-- lib.rock @pkg=chess,1 @v1
pub mod util {
}
fn util() {}

//- broken_import_does_not_fall_through_to_glob @fail
//-- lib.rock @pkg=chess,1 @v1
pub fn foo() -> int { 1 }

//-- app.rock @pkg=app,2 @v1
use chess::*;
use chess::missing as foo;

fn f() -> int {
    foo()
}

//- private_fn_inaccessible_from_sibling @fail
//-- a.rock @pkg=chess,1 @v1
mod a;
fn hidden() -> int { 1 }

//-- b.rock @pkg=chess,1 @v1
mod b;
fn f() -> int {
    super::a::hidden()
}

//- pub_fn_accessible_from_sibling
//-- a.rock @pkg=chess,1 @v1
mod a;
pub fn shown() -> int { 1 }

//-- b.rock @pkg=chess,1 @v1
mod b;
fn f() -> int {
    super::a::shown()
}

//- operator_import_selects_user_plus
//-- geo.rock @pkg=geo,1 @v1
pub struct Vec2 { pub x: int, pub y: int }
pub operator +(a: Vec2, b: Vec2) -> Vec2 {
    Vec2 { x: a.x, y: a.y }
}

//-- app.rock @pkg=app,2 @v1
use geo::{Vec2, operator(+)};
fn f() -> Vec2 {
    let a = Vec2 { x: 1, y: 2 }
    let b = Vec2 { x: 3, y: 4 }
    a + b
}

//- qualified_user_fieldref_keeps_normal_nominal_identity
//-- other.rock @pkg=app,1 @v1
mod other;
pub struct FieldRef<T, V> {
    pub value: V,
}

//-- app.rock @pkg=app,1 @v1
use app::other::FieldRef as FieldRef;

fn read(r: FieldRef<int, int>) -> int {
    r.value
}

//- user_std_package_name_is_reserved @fail=user packages cannot use the compiler-owned package name `std`
//-- app.rock @pkg=std,3 @v1
fn main() {}

//- package_root_std_module_is_reserved @fail=package-root module name `std` is reserved
//-- app.rock @pkg=app,3 @v1
mod std;

fn main() {}

//- operator_not_globally_discovered @fail
//-- geo.rock @pkg=geo,1 @v1
pub struct Vec2 { pub x: int, pub y: int }
pub operator +(a: Vec2, b: Vec2) -> Vec2 {
    Vec2 { x: a.x, y: a.y }
}

//-- app.rock @pkg=app,2 @v1
use geo::Vec2;
fn f() -> Vec2 {
    let a = Vec2 { x: 1, y: 2 }
    let b = Vec2 { x: 3, y: 4 }
    a + b
}

//- pub_package_glob_is_glob_priority
//-- util.rock @pkg=chess,1 @v1
mod util;
pub fn width() -> int { 1 }

//-- root.rock @pkg=chess,1 @v1
pub(package) use self::util::*;
fn width() -> int { 2 }
fn pick() -> int {
    width()
}

//- shadowed_glob_candidate_is_named_in_the_call_error @fail=shadowed candidate `chess::util::width`
//-- lib.rock @pkg=chess,1 @v1
pub mod util;

//-- lib_util.rock @pkg=chess,1 @v1
mod util;

pub fn width() -> int { 1 }

//-- app.rock @pkg=app,2 @v1
use chess::util::*;

global width: int = 3

fn f() -> int {
    width()
}

//- v1_infix_ascription_is_a_path_not_an_ascription @fail=`x::int` did not resolve to any definition; `::` is a path separator in modules-v1, so a type ascription is written `(x : int)`
//-- app.rock @pkg=app,1 @v1
fn f() -> int {
    let x = 5
    let y = x :: int
    y
}

//- v1_infix_ascription_to_a_type_in_scope_names_the_replacement @fail=a type ascription is written `(p : Point)`
//-- app.rock @pkg=app,1 @v1
struct Point { x: int }

fn f() -> Point {
    let p = Point { x: 1 }
    p :: Point
}

//- an_unresolved_qualified_path_keeps_its_message @fail=`a::missing` did not resolve to any definition @not=ascription
//-- app.rock @pkg=app,1 @v1
fn f() -> int {
    a::missing
}

//- the_contextual_ascription_resolves
//-- app.rock @pkg=app,1 @v1
fn f() -> int {
    let x = 5
    let y = (x : int)
    y
}

//- inline_mod_block_members_resolve
//-- app.rock @pkg=app,1 @v1
pub mod util {
    pub fn heal() -> int { 7 }
}

fn f() -> int {
    let n = self::util::heal()
    let m = n
          //^ int
    m
}

//- qualified_variant_construction_carries_its_payload
//-- lib.rock @pkg=chess,1 @v1
pub enum Move {
    Pass,
    Step(int),
    Jump { from: int, to: int },
}

//-- app.rock @pkg=app,2 @v1
fn played() -> int {
    let stepped = chess::Move::Step(2)
    let echoed = stepped
       //^ chess::Move
    let jumped = chess::Move::Jump { from: 1, to: 3 }
    let passed = chess::Move::Pass
    let n = match echoed {
        chess::Move::Step(d) => d,
                             //^ int
        chess::Move::Jump { from, to } => to,
        chess::Move::Pass => 0,
    }
    n
}

//- qualified_newtype_construction_resolves_by_name
//-- lib.rock @pkg=chess,1 @v1
pub newtype Rank(int)

//-- app.rock @pkg=app,2 @v1
fn made() -> chess::Rank {
    let r = chess::Rank(3)
    let echoed = r
       //^ chess::Rank
    echoed
}

//- legacy_projection_resolves_public_root_export
//-- lib.rock @pkg=lib,1 @v1
pub struct Shared {
    pub value: int,
}

//-- main.rock @pkg=app,2
fn read(x: Shared) -> int {
    let n = x.value
            //^ int
    n
}

//- legacy_projection_rejects_private_root_export @fail=Unknown type name Hidden
//-- lib.rock @pkg=lib,1 @v1
struct Hidden {
    pub value: int,
}

//-- main.rock @pkg=app,2
fn read(x: Hidden) -> int {
    x.value
}

//- legacy_projection_reports_distinct_ambiguity @fail=ambiguous legacy reference to `Shared`: candidates lib_a::Shared, lib_b::Shared
//-- a.rock @pkg=lib_a,1 @v1
pub struct Shared {
    pub value: int,
}

//-- b.rock @pkg=lib_b,2 @v1
pub struct Shared {
    pub value: int,
}

//-- main.rock @pkg=app,3
fn read(x: Shared) -> int {
    x.value
}

//- legacy_projection_deduplicates_reexport
//-- provider.rock @pkg=provider,1 @v1
pub struct Item {
    pub value: int,
}

//-- facade.rock @pkg=facade,2 @v1
pub use provider::Item;

//-- main.rock @pkg=app,3
fn read(x: Item) -> int {
    let n = x.value
            //^ int
    n
}

//- legacy_item_use_is_additive
//-- provider.rock @pkg=provider,1 @v1
pub struct Imported {
    pub value: int,
}

//-- main.rock @pkg=app,2
use provider::Imported;

fn read(x: Imported) -> int {
    let y = 1 :: int
    let n = x.value
            //^ int
    n
}

//- v1_does_not_see_legacy_consumer_names @fail=`ConsumerOnly` did not resolve to any definition
//-- consumer.rock @pkg=consumer,1
struct ConsumerOnly {
    value: int,
}

//-- app.rock @pkg=app,2 @v1
fn read(x: ConsumerOnly) -> int {
    x.value
}

//- legacy_projection_retains_v1_callable_family
//-- provider.rock @pkg=provider,1 @v1
pub fn choose(x: int) -> int {
    x
}

pub fn choose(x: string) -> string {
    x
}

//-- main.rock @pkg=app,2
fn read() -> int {
    let n = choose(1)
            //^ int
    n
}

//- legacy_owned_fn_and_projected_fn_are_ambiguous @fail=ambiguous legacy reference to `bump`: legacy definition in defs.rock and v1 definition provider::bump
//-- provider.rock @pkg=provider,1 @v1
pub fn bump(n: int) -> int {
    n
}

//-- defs.rock @pkg=game,2
fn bump(n: int) -> int {
    n
}

//-- main.rock @pkg=game,2
fn use_it() -> int {
    bump(1)
}

