    x.value
}

//- legacy_projection_resolves_a_generic_root_export
//-- provider.rock @pkg=provider,1 @v1
pub struct Holder<T> {
    pub value: T,
}

//-- main.rock @pkg=game,2
fn read(x: Holder<int>) -> int {
    let n = x.value
            //^ int
    n
}

//- legacy_owned_and_projected_names_resolve_when_they_do_not_collide
//-- provider.rock @pkg=provider,1 @v1
pub fn projected_only() -> string {
    "v1"
}

fn bump(n: string) -> string {
    n
}

//-- defs.rock @pkg=game,2
fn bump(n: int) -> int {
    n
}

//-- main.rock @pkg=game,2
fn use_it() -> int {
    let s = projected_only()
            //^ string
    let n = bump(1)
            //^ int
    n
}

//- an_unused_legacy_and_projected_collision_is_not_diagnosed
//-- provider.rock @pkg=provider,1 @v1
pub fn bump(n: int) -> int {
    n
}

//-- defs.rock @pkg=game,2
fn bump(n: int) -> int {
    n
}

//-- main.rock @pkg=game,2
fn unrelated() -> int {
    1
}

//- a_pub_child_module_is_reachable_from_a_consumer
//-- lib.rock @pkg=chess,1 @v1
pub mod openings;

//-- lib_openings.rock @pkg=chess,1 @v1
mod openings;

pub fn ply() -> int {
    1
}

//-- app.rock @pkg=app,2 @v1
fn f() -> int {
    let n = chess::openings::ply()
            //^ int
    n
}

//- a_private_child_module_is_unreachable_from_a_consumer @fail=module `secret` is not accessible from this module
//-- lib.rock @pkg=chess,1 @v1
pub fn sauce() -> int {
    secret::recipe()
}

//-- lib_secret.rock @pkg=chess,1 @v1
private mod secret;

pub fn recipe() -> int {
    7
}

//-- app.rock @pkg=app,2 @v1
fn f() -> int {
    chess::secret::recipe()
}

