//- a_fn_typed_field_wins_over_a_same_named_function
//-- app.rock @pkg=app,1 @v1
struct Api {
    stop: fn() -> int,
}

fn stop(a: Api) -> string {
    "free"
}

// Legacy calls the field here; so must v1. The free fn returns
// string, so the marker catches a rebinding.
fn run(a: Api) -> int {
    let n = a.stop()
    let m = n
            //^ int
    m
}
