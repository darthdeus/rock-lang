//- a_method_call_reaches_a_fn_typed_field
//-- app.rock @pkg=app,1 @v1
struct Api {
    stop: fn() -> int,
}

// The field call keeps its precedence: no tier binds `stop`, and the
// call is the field's function, exactly as in legacy.
fn run(a: Api) -> int {
    let n = a.stop()
    let m = n
            //^ int
    m
}

