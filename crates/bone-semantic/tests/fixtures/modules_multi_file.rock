struct Foo { x: int }
fn Foo() {}

//- child_module_and_fn_same_name_reject @fail
//-- lib.rock @pkg=chess,1 @v1
pub mod util {
}
fn util() {}

//- broken_import_does_not_fall_through_to_glob @fail
//-- lib.rock @pkg=chess,1 @v1
pub fn foo() -> int { 1 }

//-- app.rock @pkg=app,2 @v1
use chess::*;
use chess::missing as foo;

fn f() -> int {
    foo()
}

