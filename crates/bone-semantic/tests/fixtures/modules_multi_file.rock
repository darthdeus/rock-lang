pub(in a) fn f() -> int {
    1
}

//-- lib_a_c.rock @pkg=app,1 @v1
mod a::c;

fn g() -> int {
    let n = super::b::f()
            //^ int
    n
}

//- pub_in_rejects_outside_the_named_ancestor @fail=`f` is not accessible from this module
//-- lib.rock @pkg=app,1 @v1
fn h() -> int {
    a::b::f()
}

//-- lib_a_b.rock @pkg=app,1 @v1
pub mod a::b;

pub(in a) fn f() -> int {
    1
}

//- a_method_call_reaches_a_fn_typed_field
//-- app.rock @pkg=app,1 @v1
struct Api {
    stop: fn() -> int,
}

fn run(a: Api) -> int {
    let n = a.stop()
    let m = n
            //^ int
    m
}

//- a_method_call_with_no_field_and_no_function_still_rejects @fail=stop
//-- app.rock @pkg=app,1 @v1
struct Api {
    go: fn() -> int,
}

fn run(a: Api) -> int {
    a.stop()
}

//- a_safe_nav_method_call_reaches_a_fn_typed_field
//-- app.rock @pkg=app,1 @v1
struct Api {
    stop: fn() -> int,
}

fn run(a: Api?) -> int {
    let n = a?.stop()
    let m = n ?? 0
            //^ int
    m
}

//- a_fn_typed_field_wins_over_a_same_named_function
//-- app.rock @pkg=app,1 @v1
struct Api {
    stop: fn() -> int,
}

fn stop(a: Api) -> string {
    "free"
}

fn run(a: Api) -> int {
    let n = a.stop()
    let m = n
            //^ int
    m
}

//- a_no_fit_call_names_the_fitting_function_in_the_receiver_types_module @fail=help: `store::len` takes `app::store::Store` but is not imported here; add `use store::len;` or call `store::len(s)`
//-- app.rock @pkg=app,1 @v1
use store::Store;

fn run(s: Store) -> int {
    s.len()
}

//-- app_store.rock @pkg=app,1 @v1
pub mod store;

pub struct Store {
    pub items: Vec<int>,
}

pub fn len(self: Store) -> int {
    self.items.len()
}
