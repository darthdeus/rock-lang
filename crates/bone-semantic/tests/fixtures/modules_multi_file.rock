//- a_projected_overload_extends_a_stdlib_family
//-- provider.rock @pkg=provider,1 @v1
pub struct Color {
    pub r: float,
}

pub fn lerp(a: Color, b: Color, t: float) -> Color {
    Color { r: a.r }
}

//-- main.rock @pkg=game,2
fn mix() -> float {
    let c = lerp(Color { r: 0.0 }, Color { r: 1.0 }, 0.5)
            //^ provider::Color
    let f = lerp(0.0, 1.0, 0.5)
            //^ float
    f
}

