    v: int,
}

fn min(a: Foo, b: Foo) -> Foo {
    a
}

fn f() -> int {
    let n = std::min(1, 2)
            //^ int
    n
}

//- pub_in_admits_the_named_ancestor_subtree
//-- lib.rock @pkg=app,1 @v1
pub fn root_fn() -> int {
    0
}

//-- lib_a_b.rock @pkg=app,1 @v1
