//- hole_in_let
fn f() -> int {
    let x: _ = 5
      //^ int
    x
}

//- q_hole_in_let
fn f(value: int) -> int {
    let x: ? = value
      //^ int
    x
}

//- named_q_hole
fn f(value: int) -> int {
    let x: ?elem = value
      //^ int
    x
}

//- hole_in_return_type @fail=a type hole is only allowed in a local annotation
fn mk() -> fn(int) -> _ { return x => x }
fn main() { let y = mk()(4) }

//- hole_in_param_type @fail=a type hole is only allowed in a local annotation
fn apply(f: fn(?) -> int) -> int { return f(1) }

//- hole_in_field_type @fail=a type hole is only allowed in a local annotation
struct S { f: fn(int) -> _ }

//- hole_in_global_type @fail=a type hole is only allowed in a local annotation
global G: fn(int) -> ? = x => x
