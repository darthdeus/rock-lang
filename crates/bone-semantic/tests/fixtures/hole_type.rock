//! A hole in type position infers from context (here, the value).
//! Two surface syntaxes: `_` (lexes as `Ident("_")`) and `?`/`?name`
//! (parses as `TypeExprKind::Hole`). Both must behave like no annotation.

//- hole_in_let
fn f() -> int {
    let x: _ = 5
      //^ int
    x
}

// `?` in type position is a placeholder hole -> infer from the value.
//- q_hole_in_let
fn f(value: int) -> int {
    let x: ? = value
      //^ int
    x
}

// A named `?name` hole behaves the same; the name is just a hint.
//- named_q_hole
fn f(value: int) -> int {
    let x: ?elem = value
      //^ int
    x
}

// Holes are local-annotation only: a declaration's type is part of the
// module interface and cannot wait for a body to fill it.
//- hole_in_return_type @fail=a type hole is only allowed in a local annotation
fn mk() -> fn(int) -> _ { return x => x }
fn main() { let y = mk()(4) }

//- hole_in_param_type @fail=a type hole is only allowed in a local annotation
fn apply(f: fn(?) -> int) -> int { return f(1) }

//- hole_in_field_type @fail=a type hole is only allowed in a local annotation
struct S { f: fn(int) -> _ }

//- hole_in_global_type @fail=a type hole is only allowed in a local annotation
global G: fn(int) -> ? = x => x
