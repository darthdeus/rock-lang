//! Newtype let-destructuring: `let UserId(x) = u` unwraps a newtype binding.
//! bone rejects `VariableBindingKind::Newtype` in let lowering. The value must
//! be the named newtype; each inner binding takes the corresponding wrapped
//! type (with generic subst from the value's type args). Verified vs rock
//! (newtypes/basics.rock).

//- newtype_let_destructure
newtype UserId(int)
fn f(u: UserId) -> int {
    let UserId(x) = u
    x
  //^ int
}

// the wrapped type is recovered, not the newtype.
//- newtype_let_wrapped_type
newtype Tag(string)
fn f(t: Tag) -> int {
    let Tag(s) = t
    let r = s
      //^ string
    5
}
