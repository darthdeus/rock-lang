//! The typing rules for field references / key paths. Run
//! `cargo test -p bone-semantic -- field_ref`.
//!
//! Design being pinned:
//!   - `FieldRef<T, V>` is a compiler-known type former (like Entity<T> /
//!     Coroutine<T>), NOT a user struct. Its inhabitants are field-name
//!     literals validated against T's declaration.
//!   - The literal `.field` reuses the existing `SiblingFieldRef` AST node
//!     (parser.rs:2046) -- no new expression syntax. It is EXPECTED-TYPE
//!     DRIVEN: given expected `FieldRef<T, V>`, look up `field` on T, unify
//!     its declared type with V, yield `FieldRef<T, V>`.
//!   - WRITABLE / INVARIANT: the poller both reads the slot and writes null
//!     to cancel, so the field's declared type must match V EXACTLY (Swift's
//!     `WritableKeyPath`, not its covariant read-only `KeyPath`).

// ---------------------------------------------------------------------------
// A. concrete V: `.field` checked against FieldRef<T, V> with V fixed
// ---------------------------------------------------------------------------

//- concrete_v_exact_ok
struct Mob { health: int, attack_co: int? }
fn poll(f: FieldRef<Mob, int?>) {}
fn main() {
    let f: FieldRef<Mob, int?> = .attack_co
      //^ FieldRef<Mob, int?>
    poll(f)
}

// field that doesn't exist on the struct -> rejected
//- concrete_v_missing_field_fail @fail
struct Mob { health: int, attack_co: int? }
fn poll(f: FieldRef<Mob, int?>) {}
fn main() {
    poll(.nope)
}

// INVARIANCE: a non-null `int` field cannot satisfy `FieldRef<Mob, int?>`
// (you couldn't write null through it). Exact match required.
//- concrete_v_widen_write_fail @fail
struct Mob { health: int, attack_co: int? }
fn poll(f: FieldRef<Mob, int?>) {}
fn main() {
    poll(.health)
}

// INVARIANCE other direction: a nullable field cannot satisfy
// `FieldRef<Mob, int>` (a read yields int?, not int).
//- concrete_v_narrow_read_fail @fail
struct Mob { health: int, attack_co: int? }
fn take(f: FieldRef<Mob, int>) {}
fn main() {
    take(.attack_co)
}

// ---------------------------------------------------------------------------
// B. free V: V is inferred FROM the field -- the field_get/field_set intrinsic
//    shape. This is the key inference premise for the stdlib intrinsics.
// ---------------------------------------------------------------------------

//- free_v_inferred_from_field
struct Mob { health: int, attack_co: int? }
inline(lua) fn get_field<T, V>(o: T, f: FieldRef<T, V>) -> V = "return o[f]"
fn main() {
    let h = get_field(Mob { health: 3, attack_co: null }, .health)
      //^ int
    h
}

//- free_v_inferred_nullable
struct Mob { health: int, attack_co: int? }
inline(lua) fn get_field<T, V>(o: T, f: FieldRef<T, V>) -> V = "return o[f]"
fn main() {
    let c = get_field(Mob { health: 3, attack_co: null }, .attack_co)
      //^ int?
    c
}

// ---------------------------------------------------------------------------
// C. inference ordering: T comes from a sibling arg and must be solved BEFORE
//    the `.field` literal resolves. This is the poll_co_slot shape.
// ---------------------------------------------------------------------------

//- t_from_sibling_arg_ok
struct Mob { health: int, attack_co: int? }
struct Entity<T> { _index: int }
fn poll_slot<T>(e: Entity<T>, f: FieldRef<T, int?>) {}
fn main() {
    let e: Entity<Mob> = Entity { _index: 0 }
      //^ Entity<Mob>
    poll_slot(e, .attack_co)
}

// ---------------------------------------------------------------------------
// D. a bare `.field` with no expected FieldRef type is an error (same as a
//    SiblingFieldRef outside a struct default).
// ---------------------------------------------------------------------------

//- bare_field_no_context_fail @fail
struct Mob { health: int, attack_co: int? }
fn main() {
    let x = .attack_co
    x
}

// ---------------------------------------------------------------------------
// E. generic struct: the field type comes through the struct's own generic
//    param, so struct_field_ty's substitution must flow into V.
// ---------------------------------------------------------------------------

//- generic_struct_concrete_v_ok
struct Box<T> { value: T }
fn take(f: FieldRef<Box<int>, int>) {}
fn main() {
    let f: FieldRef<Box<int>, int> = .value
      //^ FieldRef<Box<int>, int>
    take(f)
}

// free V AND a generic struct at once: T = Box<int> from arg 0, then `.value`
// resolves value: T_box = int, binding V := int.
//- generic_struct_free_v_ok
struct Box<T> { value: T }
inline(lua) fn get_field<T, V>(o: T, f: FieldRef<T, V>) -> V = "return o[f]"
fn main() {
    let v = get_field(Box { value: 7 }, .value)
      //^ int
    v
}

// ---------------------------------------------------------------------------
// F. field_set writing null through a nullable-typed field -- the actual
//    coroutine cancel op. V is inferred int? from the field; null coerces to V.
// ---------------------------------------------------------------------------

//- field_set_write_null_ok
struct Mob { health: int, attack_co: int? }
inline(lua) fn field_set<T, V>(o: T, f: FieldRef<T, V>, v: V) = "o[f] = v"
fn main() {
    let m = Mob { health: 1, attack_co: null }
    field_set(m, .attack_co, null)
    let ok = 1
      //^ int
    ok
}

// ---------------------------------------------------------------------------
// G. wrong field on the container's T -- T is solved from the Entity<T> arg,
//    and the named field doesn't exist on that struct.
// ---------------------------------------------------------------------------

//- generic_container_wrong_field_fail @fail
struct Mob { health: int, attack_co: int? }
struct Rock { mass: int }
struct Entity<T> { _index: int }
fn poll_slot<T>(e: Entity<T>, f: FieldRef<T, int?>) {}
fn main() {
    let e: Entity<Rock> = Entity { _index: 0 }
    poll_slot(e, .attack_co)
}

// ---------------------------------------------------------------------------
// H. A writable ref into a value struct would write to a temporary copy.
//    The WRITABLE former refuses. The read-only ReadFieldRef
//    former accepts, which is what field_get takes.
// ---------------------------------------------------------------------------

//- value_struct_writable_field_fail @fail
value FixVec2 { x: float, y: float }
fn take(f: FieldRef<FixVec2, float>) {}
fn main() {
    let f: FieldRef<FixVec2, float> = .x
    take(f)
}

//- value_struct_readfieldref_ok
value FixVec2 { x: float, y: float }
fn take(f: ReadFieldRef<FixVec2, float>) {}
fn main() {
    let f: ReadFieldRef<FixVec2, float> = .x
      //^ ReadFieldRef<FixVec2, float>
    take(f)
}

// ---------------------------------------------------------------------------
// I. `WriteFieldRef<T, V>` -- the write-only former, terminal in the lattice.
//    It grants no whole-value read, which is exactly the capability an
//    EMBEDDED field cannot offer.
//    Lattice: `FieldRef` is the TOP and coerces DOWN to both single-capability
//    formers; `ReadFieldRef` and `WriteFieldRef` are INCOMPARABLE, so no
//    coercion runs between them, and neither coerces back up.
// ---------------------------------------------------------------------------

//- write_field_ref_concrete_ok
struct Mob { health: int, attack_co: int? }
fn take(f: WriteFieldRef<Mob, int?>) {}
fn main() {
    let f: WriteFieldRef<Mob, int?> = .attack_co
      //^ WriteFieldRef<Mob, int?>
    take(f)
}

//- write_field_ref_free_v_inferred
struct Mob { health: int, attack_co: int? }
inline(lua) fn set_field<T, V>(o: T, f: WriteFieldRef<T, V>, v: V) = "o[f] = v"
fn main() {
    let m = Mob { health: 3, attack_co: null }
    set_field(m, .health, 7)
    let ok = 1
      //^ int
    ok
}

// T solved from a sibling arg, then `.field` resolves against it -- the slot-verb
// shape, spelled identically to the `FieldRef` one.
//- write_field_ref_t_from_sibling_ok
struct Mob { health: int, attack_co: int? }
struct Entity<T> { _index: int }
fn stop<T>(e: Entity<T>, f: WriteFieldRef<T, int?>) {}
fn main() {
    let e: Entity<Mob> = Entity { _index: 0 }
      //^ Entity<Mob>
    stop(e, .attack_co)
}

//- write_field_ref_missing_field_fail @fail
struct Mob { health: int, attack_co: int? }
fn take(f: WriteFieldRef<Mob, int?>) {}
fn main() {
    take(.nope)
}

// INVARIANT in V, like `FieldRef`. Write-only contravariance would be sound but
// has no consumer; invariance is the conservative choice and relaxing it later
// is source-compatible.
//- write_field_ref_widen_fail @fail
struct Mob { health: int, attack_co: int? }
fn take(f: WriteFieldRef<Mob, int?>) {}
fn main() {
    take(.health)
}

// The write capability refuses a `value` struct T, same rule as `FieldRef`:
// the object travels by copy, so the write would land on a temporary.
//- write_field_ref_value_struct_fail @fail
value FixVec2 { x: float, y: float }
fn take(f: WriteFieldRef<FixVec2, float>) {}
fn main() {
    take(.x)
}

// Arity guard: the former takes exactly <Struct, FieldType>.
//- write_field_ref_arity_fail @fail
struct Mob { health: int, attack_co: int? }
fn take(f: WriteFieldRef<Mob>) {}
fn main() {
    take(.attack_co)
}

// TOP coerces down: a `FieldRef` satisfies a `WriteFieldRef` slot.
//- field_ref_coerces_to_write_ok
struct Mob { health: int, attack_co: int? }
fn take(f: WriteFieldRef<Mob, int?>) {}
fn main() {
    let f: FieldRef<Mob, int?> = .attack_co
      //^ FieldRef<Mob, int?>
    take(f)
}

// ... and NOT back up: a write-only selector is not a full field ref.
//- write_field_ref_no_coerce_to_field_ref_fail @fail
struct Mob { health: int, attack_co: int? }
fn take(f: FieldRef<Mob, int?>) {}
fn main() {
    let f: WriteFieldRef<Mob, int?> = .attack_co
    take(f)
}

// THE EXTRACTION HOLE this former exists to close: a write-only selector must
// not reach a readable one, or an embedded field's whole value could be read out.
//- write_field_ref_no_coerce_to_read_fail @fail
struct Mob { health: int, attack_co: int? }
fn take(f: ReadFieldRef<Mob, int?>) {}
fn main() {
    let f: WriteFieldRef<Mob, int?> = .attack_co
    take(f)
}

// The other diagonal of the diamond: read-only does not grant write.
//- read_field_ref_no_coerce_to_write_fail @fail
struct Mob { health: int, attack_co: int? }
fn take(f: WriteFieldRef<Mob, int?>) {}
fn main() {
    let f: ReadFieldRef<Mob, int?> = .attack_co
    take(f)
}
