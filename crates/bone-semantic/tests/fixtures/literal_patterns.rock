//- match_int_literal
fn f(n: int) -> int {
    let r = match n {
        0 => 10,
        1 => 20,
        _ => 0,
    }
      //^ int
    r
}

//- match_string_literal
fn f(s: string) -> int {
    let r = match s {
        "a" => 1,
        "b" => 2,
        _ => 0,
    }
      //^ int
    r
}

//- match_literal_with_binding
fn f(n: int) -> int {
    let r = match n {
        0 => 100,
        other => other,
    }
      //^ int
    r
}
