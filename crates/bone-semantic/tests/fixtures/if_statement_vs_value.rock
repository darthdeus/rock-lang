fn gives_bool() -> bool { true }

fn stmt_open_chain_uniform_tails() -> int {
    let x = 1
    if x == 1 {
        gives_bool()
    } else if x == 2 {
        gives_bool()
    } else if x == 3 {
        gives_bool()
    }
    let y = x
      //^ int
    y
}

fn stmt_open_chain_mismatched_tails() -> int {
    let x = 1
    if x == 1 {
        gives_bool()
    } else if x == 2 {
        x = 3
    }
    let y = x
      //^ int
    y
}

fn stmt_closed_mismatched_tails() -> int {
    let x = 1
    if x == 1 {
        gives_bool()
    } else {
        x = 2
    }
    let y = x
      //^ int
    y
}

fn stmt_nested_open_if_bool_tail() -> int {
    let x = 1
    if x == 1 {
        if x < 5 {
            gives_bool()
        }
    } else if x == 2 {
        x = 3
    }
    let y = x
      //^ int
    y
}

fn stmt_while_body_tail_mismatched_if() -> int {
    let x = 1
    while x < 3 {
        x = 5
        if x == 1 {
            gives_bool()
        } else {
            x = 2
        }
    }
    let y = x
      //^ int
    y
}

fn stmt_for_body_tail_mismatched_if() -> int {
    let x = 1
    for i in 0..3 {
        if i == 1 {
            gives_bool()
        } else {
            x = 2
        }
    }
    let y = x
      //^ int
    y
}

fn stmt_fn_tail_no_ret_mismatched_if() {
    let x = 1
      //^ int
    if x == 1 {
        gives_bool()
    } else {
        x = 2
    }
}

fn value_let_closed_uniform() -> int {
    let x = 1
    let u = if x == 1 { 10 } else { 20 }
      //^ int
    u
}

fn value_fn_tail_closed(x: int) -> int {
    let y = x
      //^ int
    if y == 1 {
        10
    } else {
        20
    }
}

fn stmt_iflet_nonunit_tail() -> int {
    let m: int? = 42
    if let n = m {
        gives_bool()
    }
    let y = 1
      //^ int
    y
}

fn value_iflet_closed() -> int {
    let m: int? = 42
    let u = if let n = m { n } else { 0 }
      //^ int
    u
}

fn run(cb: fn()) -> int {
    cb()
    1
}
fn lambda_arg_unit_ret_tail_if() -> int {
    let r = run(() => {
        let x = 1
        if x == 1 {
            gives_bool()
        }
    })
    let y = r
      //^ int
    y
}

fn lambda_annotated_unit_ret_tail_if() -> int {
    let g: fn() = () => {
        let x = 1
        if x == 1 {
            gives_bool()
        }
    }
    let y = 1
      //^ int
    y
}

struct Hooks { cb: fn() }
fn lambda_field_unit_ret_tail_if() -> int {
    let h = Hooks { cb: () => {
        let x = 1
        if x == 1 {
            gives_bool()
        }
    } }
    let y = 1
      //^ int
    y
}
