//! A defaulted type parameter pads a short application the same way whichever
//! module lowers first: the declaring one or the using one.

//- decl_module_first
//-- decl.rock
struct Pair<T, U = int> { a: T, b: U }
struct Holder<T = uint> { value: T }
enum Choice<T = f64> { Value(T), Empty }
newtype Wrapped<T = uint>(T)

//-- use.rock
fn second(p: Pair<string>) -> int {
    let b = p.b
      //^ int
    b
}
fn read_holder(h: Holder) -> uint {
    let v = h.value
      //^ uint
    v
}
fn read_choice(c: Choice) -> float {
    match c { Choice::Value(v) => v, Choice::Empty => 0.0 }
}
fn read_wrapped(w: Wrapped) -> uint { w.0 }

//- use_module_first
//-- use.rock
fn second(p: Pair<string>) -> int {
    let b = p.b
      //^ int
    b
}
fn read_holder(h: Holder) -> uint {
    let v = h.value
      //^ uint
    v
}
fn read_choice(c: Choice) -> float {
    match c { Choice::Value(v) => v, Choice::Empty => 0.0 }
}
fn read_wrapped(w: Wrapped) -> uint { w.0 }

//-- decl.rock
struct Pair<T, U = int> { a: T, b: U }
struct Holder<T = uint> { value: T }
enum Choice<T = f64> { Value(T), Empty }
newtype Wrapped<T = uint>(T)
