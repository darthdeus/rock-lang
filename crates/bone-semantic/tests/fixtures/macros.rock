//- macro_single_arg
macro pos(x: expr) {
    x > 0
}
fn f(n: int) -> bool {
    let r = pos(n)
      //^ bool
    r
}

//- macro_two_args
macro lt(a: expr, b: expr) {
    a < b
}
fn f(n: int, m: int) -> bool {
    let r = lt(n, m)
      //^ bool
    r
}

//- macro_repeated_param
macro eq_self(x: expr) {
    x == x
}
fn f(n: int) -> bool {
    let r = eq_self(n)
      //^ bool
    r
}

//- macro_block_stmt
macro stash(v: expr) {
    let kept = v
}
fn f() -> int {
    stash(5)
    7
  //^ int
}

//- macro_default_param
macro ge(x: expr, lo: expr = 0) {
    x > lo
}
fn f(n: int) -> bool {
    let a = ge(n)
      //^ bool
    let b = ge(n, 3)
      //^ bool
    a
}

//- macro_arity_overload
macro pick(a: expr) {
    a > 0
}
macro pick(a: expr, b: expr) {
    a > b
}
fn f(n: int, m: int) -> bool {
    let one = pick(n)
      //^ bool
    let two = pick(n, m)
      //^ bool
    one
}

//- macro_def_dropped
macro unused(x: expr) {
    x > 0
}
fn f() -> int {
    5
  //^ int
}

//- macro_nested
macro inner(x: expr) {
    x == x
}
macro outer(x: expr) {
    inner(x)
}
fn f(n: int) -> bool {
    let r = outer(n)
      //^ bool
    r
}
