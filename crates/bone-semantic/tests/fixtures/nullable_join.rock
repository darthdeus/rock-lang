//! Joining a nullable with its base type is the LUB `T?` (verified vs rock):
//! `int? == int` type-checks, `[a, 1]` infers `[int?]`, but ordering a
//! nullable (`int? < int`) is still rejected ("Cannot compare nullable").
//! The bug: `join` fell through to `unify`, which can't unify `int?` with
//! `int`. Fix lives in `join` (peel either/both nullable, join inners,
//! re-wrap once), so equality accepts and ordering's orderable-check rejects.

// Equality across nullable boundary type-checks (result is bool).
//- nullable_eq_nonnull
fn f(a: int?) -> bool {
    let r = a == 1
      //^ bool
    r
}

// Array element join of int? and int is int?.
//- nullable_array_lub
fn f(a: int?) -> int {
    let xs = [a, 1]
      //^ [int?]
    5
}

// Ordering a nullable is still rejected.
//- nullable_ordering_rejected @fail
fn f(a: int?) -> bool {
    a < 1
}

//- if_nullable_else_lub
fn f(cond: bool) {
    let x = if cond { 7 } else { null }
      //^ int?
}

//- nested_iflet_nullable_else_lub
nobox value Place { x: int, y: int }
fn f(grid: int?, cond: bool) {
    let place = if let x = grid {
        Place { x, y: 9 }
    } else {
        if cond { Place { x: 4, y: 8 } } else { null }
    }
    let result = place
      //^ Place?
}
