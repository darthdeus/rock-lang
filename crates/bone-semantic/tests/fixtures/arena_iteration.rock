//! Iterating an `Arena<T>` yields `(Entity<T>, T)` via the iter/next protocol
//! (stdlib `ArenaPairIter`; `next -> (bool, (Entity<T>, T))`, elem = the tuple).
//! `for (e, item) in arena` destructures the pair; `for pair in arena` binds
//! the whole tuple. These fixtures compile stdlib-free, so each section
//! carries a local protocol; the `next` bodies are type-only stubs
//! (self-recursive -- fixtures never execute).

//- arena_iter_destructure
struct Entity<T> { idx: int }
struct Arena<T> { count: int }
struct AIter<T> { a: Arena<T> }
fn iter<T>(a: Arena<T>) -> AIter<T> { return AIter { a: a } }
fn next<T>(it: AIter<T>) -> (bool, Entity<T>, T) { return next(it) }
fn f<T>(arena: Arena<T>) -> int {
    for (e, item) in arena {
        let x = item
          //^ T
        let y = e
          //^ Entity<T>
    }
    0
}

//- arena_iter_single
struct Entity<T> { idx: int }
struct Arena<T> { count: int }
struct AIter<T> { a: Arena<T> }
fn iter<T>(a: Arena<T>) -> AIter<T> { return AIter { a: a } }
fn next<T>(it: AIter<T>) -> (bool, Entity<T>, T) { return next(it) }
fn f<T>(arena: Arena<T>) -> int {
    for pair in arena {
        let p = pair
          //^ (Entity<T>, T)
    }
    0
}
