//! Modules-v1 overload families that span more than one definition:
//! a declared or imported operator joins the built-in operator family,
//! explicit imports of different callables compose at their tier, glob-tier
//! callables of different modules compose at theirs, a nearer tier's
//! callables join the lower tiers' (see `modules_callable_families.rock`), and
//! compound assignment reads the family its binary operator reads. Unary
//! `-x` / `!x` (`__unm` / `__not`) read a family lowering decides the same way.
//!
//! Sections hold embedded files: `//-- <file> @pkg=<self_name>,<id> [@v1]`.

//- a_modules_own_operator_keeps_builtin_arithmetic
//-- geo.rock @pkg=geo,1 @v1
pub struct Pt {
    pub x: int,
    pub y: int,
}

pub operator +(a: Pt, b: Pt) -> Pt {
    Pt { x: a.x + b.x, y: a.y + b.y }
}

fn sums() -> int {
    let p = Pt { x: 1, y: 2 } + Pt { x: 3, y: 4 }
            //^ geo::Pt
    let n = 1 + 2
            //^ int
    let f = 1.5 + 2.0
            //^ float
    let v = Vec2 { x: 1.0, y: 2.0 } + Vec2 { x: 3.0, y: 4.0 }
            //^ Vec2
    let s = "a" + "b"
            //^ string
    p.x + n
}

//- a_modules_own_operator_does_not_admit_an_undeclared_operand @fail=No overload for `__op_add` with argument types (geo::Pt, int)
//-- geo.rock @pkg=geo,1 @v1
pub struct Pt {
    pub x: int,
    pub y: int,
}

pub operator +(a: Pt, b: Pt) -> Pt {
    Pt { x: a.x + b.x, y: a.y + b.y }
}

fn bad() -> Pt {
    Pt { x: 1, y: 2 } + 3
}

//- a_named_operator_import_keeps_builtin_arithmetic
//-- geo.rock @pkg=geo,1 @v1
pub struct Pt {
    pub x: int,
    pub y: int,
}

pub operator +(a: Pt, b: Pt) -> Pt {
