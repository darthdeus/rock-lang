//- globbed_operators_of_two_modules_compose_with_builtin_arithmetic
//-- geo.rock @pkg=geo,1 @v1
pub struct Pt {
    pub x: int,
    pub y: int,
}

pub operator +(a: Pt, b: Pt) -> Pt {
    Pt { x: a.x + b.x, y: a.y + b.y }
}

//-- clr.rock @pkg=clr,2 @v1
pub struct Rgb {
    pub r: int,
}

pub operator +(a: Rgb, b: Rgb) -> Rgb {
    Rgb { r: a.r + b.r }
}

//-- app.rock @pkg=app,3 @v1
use geo::*;
use clr::*;

fn sums() -> int {
    let p = Pt { x: 1, y: 2 } + Pt { x: 3, y: 4 }
            //^ geo::Pt
    let c = Rgb { r: 1 } + Rgb { r: 2 }
            //^ clr::Rgb
    let n = 1 + 2
            //^ int
    let f = 1.5 + 2.0
            //^ float
    let s = "a" + "b"
            //^ string
    let q = Pt { x: 0, y: 0 }
    q += Pt { x: 1, y: 1 }
    p.x + c.r + n
}

