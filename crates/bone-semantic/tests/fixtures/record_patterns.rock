//- struct_record_shorthand
value Point { x: int, y: int }
fn f(p: Point) -> int {
    let r = match p {
        Point { x, y } => x,
    }
      //^ int
    r
}

//- struct_record_explicit
value Point { x: int, y: int }
fn f(p: Point) -> int {
    let r = match p {
        Point { x: a, y: b } => a,
    }
      //^ int
    r
}

//- struct_record_rest
value Point { x: int, y: int }
fn f(p: Point) -> int {
    let r = match p {
        Point { x, .. } => x,
    }
      //^ int
    r
}

//- struct_record_nested
value Point { x: int, y: int }
struct Wrapper { inner: Point, tag: int }
fn f(w: Wrapper) -> int {
    let r = match w {
        Wrapper { inner: Point { x, y }, tag } => x,
    }
      //^ int
    r
}
