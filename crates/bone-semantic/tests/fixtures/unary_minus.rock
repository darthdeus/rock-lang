//- neg_int_var
fn f(n: int) -> int {
    let x = -n
      //^ int
    x
}

//- neg_float_var
fn f(n: float) -> float {
    let x = -n
      //^ float
    x
}

//- neg_double
fn f(n: int) -> int {
    let x = -(-n)
      //^ int
    x
}

//- neg_paren_expr
fn f(a: int, b: int) -> int {
    let x = -(a)
      //^ int
    x
}

//- neg_literal
fn f() -> int {
    let x = -5
    x
  //^ int
}
