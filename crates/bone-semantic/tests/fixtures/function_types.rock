//- fn_type_param
fn f(g: (int) -> int) -> int {
   //^ fn(int) -> int
    5
}

//- fn_type_two_params
fn f(g: (int, bool) -> int) -> int {
   //^ fn(int, bool) -> int
    5
}

//- fn_type_zero_params
fn f(g: () -> int) -> int {
   //^ fn() -> int
    5
}

//- fn_type_nested_ret
fn f(g: (int) -> (int) -> bool) -> int {
   //^ fn(int) -> fn(int) -> bool
    5
}

//- fn_type_nominal
struct Point { x: int, y: int }
fn f(g: (Point) -> int) -> int {
   //^ fn(Point) -> int
    5
}

//- fn_type_higher_order
fn f(g: ((int) -> int) -> int) -> int {
   //^ fn(fn(int) -> int) -> int
    5
}
