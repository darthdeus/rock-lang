//- field_call_with_nonmatching_free_fn
struct Other { x: int }
fn sprite(o: Other) -> int { o.x }
struct TileDef { sprite: fn() -> int }
fn f() -> int {
    let t = TileDef { sprite: () => 42 }
    let r = t.sprite()
      //^ int
    let o = Other { x: 7 }
    let q = o.sprite()
      //^ int
    let last = q
    r
}

//- field_beats_matching_free_fn
struct S { f: fn() -> string }
fn f(s: S) -> int { 100 }
fn g() -> string {
    let s = S { f: () => "field" }
    let r = s.f()
      //^ string
    r
}

//- safenav_field_call
struct S { f: fn() -> int }
fn g() -> int {
    let s: S? = S { f: () => 42 }
    let r = s?.f()
      //^ int?
    1
}

//- safenav_field_beats_matching_free_fn
struct S { f: fn() -> string }
fn f(s: S) -> int { 100 }
fn g() -> int {
    let s: S? = S { f: () => "field" }
    let r = s?.f()
      //^ string?
    1
}

//- safenav_ufcs_without_field
struct T { x: int }
fn h(t: T) -> int { t.x }
fn g() -> int {
    let t: T? = T { x: 7 }
    let r = t?.h()
      //^ int?
    1
}
