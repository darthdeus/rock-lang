//- a_std_function_value_is_not_overloaded_by_a_legacy_file
//-- game.rock @pkg=game,3
fn smoothstep(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
fn g() -> float {
    let f = smoothstep
    let x = f(1.0, 2.0, 0.5)
            //^ float
    x
}

//- a_providers_function_value_names_its_own_definition
//-- xlib.rock @pkg=x_lib,1
fn mix(a: int) -> int {
    a
}

//-- game.rock @pkg=game,3
fn mix(a: string) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
fn g() -> int {
    let f = x_lib::mix
    let n = f(1)
            //^ int
    n
}

//- a_std_function_value_passed_as_an_argument_is_the_std_definition
//-- game.rock @pkg=game,3
fn smoothstep(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
fn apply(f: fn(float, float, float) -> float) -> float {
    f(0.0, 1.0, 0.5)
}

fn g() -> float {
    let x = apply(smoothstep)
            //^ float
    let y = apply((smoothstep))
            //^ float
    let s = "{apply(smoothstep)}"
    x + y
}
