    x: float,
}

fn lerp(a: P, b: P, t: float) -> P {
    P { x: a.x + (b.x - a.x) * t }
}

//-- game.rock @pkg=game,3
fn lerp(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
use x_lib::lerp;
use std::lerp;

fn g() -> string {
    lerp("a", "b", 0.5)
