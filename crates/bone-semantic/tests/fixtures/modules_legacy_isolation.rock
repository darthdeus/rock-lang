//- a_providers_own_overloads_stay_one_family
//-- xlib_a.rock @pkg=x_lib,1
fn mix(a: int) -> int {
    a
}

//-- xlib_b.rock @pkg=x_lib,1
fn mix(a: string) -> string {
    a
}

//-- game.rock @pkg=game,3
fn mix(a: bool) -> bool {
    a
}

//-- app.rock @pkg=app,2 @v1
use x_lib::mix as blend;

fn g() -> string {
    let n = x_lib::mix(1)
            //^ int
    let m = blend(2)
            //^ int
    blend("s")
}

//- a_providers_family_hides_the_std_family @fail=expected `P`, found `float`
//-- xlib.rock @pkg=x_lib,1
struct P {
    x: float,
}

fn lerp(a: P, b: P, t: float) -> P {
    P { x: a.x + (b.x - a.x) * t }
}

//-- app.rock @pkg=app,2 @v1
use x_lib::*;

fn g() -> float {
    lerp(1.0, 2.0, 0.5)
}

//- imports_of_a_providers_family_and_the_std_family_compose
//-- xlib.rock @pkg=x_lib,1
struct P {
    x: float,
}

fn lerp(a: P, b: P, t: float) -> P {
    P { x: a.x + (b.x - a.x) * t }
}

//-- game.rock @pkg=game,3
fn lerp(a: string, b: string, t: float) -> string {
    a
}

//-- app.rock @pkg=app,2 @v1
use x_lib::{P, lerp};
use std::lerp;

fn g(p: P, q: P) -> float {
    let r = lerp(p, q, 0.5)
            //^ P
    let x = lerp(1.0, 2.0, 0.5)
            //^ float
    r.x + x
}

//- a_composed_std_and_provider_family_still_excludes_other_legacy_files @fail=No overload for `lerp` with argument types (string, string, float)
