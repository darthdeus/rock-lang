//- nullable_annotation
fn f() -> int {
    let x: int? = 5
      //^ int?
    5
}

//- nullable_widen_value
fn f() -> int {
    let x: int? = 5
    let y: int? = x
      //^ int?
    5
}

//- nullable_null_value
fn f() -> int {
    let x: int? = null
      //^ int?
    5
}

//- null_coalesce
fn f() -> int {
    let x: int? = null
    let y = x ?? 0
      //^ int
    5
}

//- nullable_narrowing
fn f(x: int?) -> int {
    if x != null {
        x
      //^ int
    } else {
        0
    }
}

//- nullable_narrowing_eq_else
fn f(x: int?) -> int {
    if x == null {
        0
    } else {
        x
      //^ int
    }
}

//- nullable_narrowing_restored
fn f(x: int?) -> int {
    if x != null {
        let a = x
          //^ int
    }
    let b = x
      //^ int?
    0
}
