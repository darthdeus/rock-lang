//! A `match` over an enum must handle every variant, or carry an unguarded
//! catch-all (`_`) / binding arm. bone rejects a non-exhaustive match at
//! compile time -- a real full-compiler check, not just an LSP hint. A GUARDED
//! arm covers nothing (its guard may fail), so it doesn't make the match
//! exhaustive.
//!
//! Each `@fail` section is otherwise well-formed (valid `//^` annotation) so the
//! ONLY defect is exhaustiveness -- it must fail for that reason, not a stray
//! second error.

// Misses B and C -> rejected.
//- non_exhaustive_partial @fail
enum E { A, B, C }
fn f(e: E) -> int {
    match e {
        E::A => {}
    }
    let r = 0
      //^ int
    r
}

// Empty match over a non-empty enum -> rejected.
//- non_exhaustive_empty @fail
enum E { A, B }
fn f(e: E) -> int {
    match e {
    }
    let r = 0
      //^ int
    r
}

// A guarded arm doesn't cover its variant -> A still missing -> rejected.
//- non_exhaustive_guarded @fail
enum E { A, B }
fn f(e: E, hot: bool) -> int {
    match e {
        E::A if hot => {}
        E::B => {}
    }
    let r = 0
      //^ int
    r
}

// Every variant handled -> accepted.
//- exhaustive_all_variants
enum E { A, B, C }
fn f(e: E) -> int {
    match e {
        E::A => {}
        E::B => {}
        E::C => {}
    }
    let r = 0
      //^ int
    r
}

// Unguarded `_` catch-all -> accepted.
//- exhaustive_wildcard
enum E { A, B, C }
fn f(e: E) -> int {
    match e {
        E::A => {}
        _ => {}
    }
    let r = 0
      //^ int
    r
}

// Unguarded binding catch-all -> accepted.
//- exhaustive_binding
enum E { A, B, C }
fn f(e: E) -> int {
    match e {
        E::A => {}
        other => {}
    }
    let r = 0
      //^ int
    r
}
