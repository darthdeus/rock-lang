enum E { A, B, C }
//- exhaustive_all_variants
fn f(e: E) -> int {
    match e {
        E::A => {}
        E::B => {}
        E::C => {}
    }
    let r = 0
      //^ int
    r
}

//- exhaustive_wildcard
fn f(e: E) -> int {
    match e {
        E::A => {}
        _ => {}
    }
    let r = 0
      //^ int
    r
}

//- exhaustive_binding
fn f(e: E) -> int {
    match e {
        E::A => {}
        other => {}
    }
    let r = 0
      //^ int
    r
}
