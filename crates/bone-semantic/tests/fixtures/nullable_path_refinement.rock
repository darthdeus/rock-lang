value Inner { v: int }
struct Mid { inner: Inner? }
//- refine_field_path
fn f(m: Mid) -> int {
    if m.inner != null {
        let r = m.inner.v
          //^ int
        r
    } else {
        0
    }
}

//- refine_and_chain
fn f(m: Mid?) -> int {
    if m != null && m.inner != null {
        let r = m.inner.v
          //^ int
        r
    } else {
        0
    }
}
