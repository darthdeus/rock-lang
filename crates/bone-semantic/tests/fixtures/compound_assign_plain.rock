//- compound_struct_add
struct V2 { x: int, y: int }
fn __op_add(a: V2, b: V2) -> V2 { return a }
fn f() -> int {
    let v = V2 { x: 1, y: 2 }
    v += V2 { x: 3, y: 4 }
    let r = v.x
      //^ int
    r
}

//- compound_struct_sub
struct V2 { x: int, y: int }
fn __op_sub(a: V2, b: V2) -> V2 { return a }
fn f() -> int {
    let v = V2 { x: 5, y: 5 }
    v -= V2 { x: 1, y: 1 }
    let r = v.y
      //^ int
    r
}

//- compound_mixed_rhs_op
struct V2 { x: int, y: int }
fn __op_mul(a: V2, s: int) -> V2 { return a }
fn f() -> int {
    let v = V2 { x: 1, y: 1 }
    v *= 3
    let r = v.x
      //^ int
    r
}
