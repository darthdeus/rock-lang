//! A v1 package reaches a legacy dependency through a namespace view of the
//! declarations the provider's own files define, with their legacy
//! (public) accessibility (spec 3.2, V1 -> Legacy). A legacy definition's key
//! is its bare name, so a v1 path, import or glob of it resolves to exactly
//! what a legacy caller reaches: overloads stay one family and a declared
//! operator reaches `a + b`. Names the provider only borrows -- another
//! package's, the stdlib's -- are not its declarations and are not in the
//! view. (The `allow_legacy` edge is the host graph's check.)
//!
//! Sections hold embedded files: `//-- <file> @pkg=<self_name>,<id> [@v1]`;
//! a file without `@v1` is legacy.

//- a_legacy_providers_definitions_resolve_by_path
//-- xlib.rock @pkg=x_lib,1
fn f(n: int) -> int {
    n
}

struct Color {
    r: int,
}

enum Dir {
    Up,
    Down(int),
}

global LIMIT: int = 3

//-- app.rock @pkg=app,2 @v1
fn g(c: x_lib::Color) -> int {
    let n = x_lib::f(1)
            //^ int
    let d = x_lib::Dir::Down(2)
    let k = match d {
        x_lib::Dir::Down(v) => v,
                            //^ int
        x_lib::Dir::Up => x_lib::LIMIT,
    }
    let c2 = x_lib::Color { r: 1 }
    let echoed = c2
       //^ Color
    n + c.r + c2.r + k
}

//- a_legacy_providers_definitions_resolve_through_imports_and_globs
//-- xlib_a.rock @pkg=x_lib,1
fn f(n: int) -> int {
    n
}

//-- xlib_b.rock @pkg=x_lib,1
struct Color {
    r: int,
}

fn tint(c: Color) -> string {
    "red"
}

//-- app.rock @pkg=app,2 @v1
use x_lib::f;
use x_lib::tint as shade;

fn g() -> int {
    f(1)
}

fn k(c: x_lib::Color) -> string {
    let s = shade(c)
            //^ string
    s
}

//-- app_glob.rock @pkg=app,2 @v1
mod globbed;

use x_lib::*;

fn h(c: Color) -> string {
    let s = tint(c)
            //^ string
    s
}

//- a_legacy_overload_family_stays_one_family
//-- xlib.rock @pkg=x_lib,1
struct P {
    x: float,
}

fn mix(a: int) -> int {
    a
}

fn mix(a: string) -> string {
    a
}

fn lerp(a: P, b: P, t: float) -> P {
    P { x: a.x + (b.x - a.x) * t }
}

//-- app.rock @pkg=app,2 @v1
use x_lib::*;

fn g(p: P, q: P) -> float {
    let s = x_lib::mix("s")
            //^ string
    let n = mix(1)
            //^ int
    let r = lerp(p, q, 0.5)
            //^ P
    // The glob binds `lerp` to x_lib's family, which hides the std one
    // (modules_legacy_isolation.rock).
    let x = std::lerp(1.0, 2.0, 0.5)
            //^ float
    r.x + x
}

//- a_legacy_operator_reaches_v1_infix_syntax
//-- xlib.rock @pkg=x_lib,1
struct P {
    x: int,
}

operator +(a: P, b: P) -> P {
    P { x: a.x + b.x }
}

//-- app.rock @pkg=app,2 @v1
use x_lib::*;

fn g(p: P, q: P) -> int {
    let r = p + q
            //^ P
    let n = 1 + 2
            //^ int
    r.x + n
}

//- a_name_the_legacy_provider_borrows_from_its_consumer_is_not_exported @fail=`x_lib::from_game` did not resolve to any definition
//-- game.rock @pkg=game,3
fn from_game() -> int {
    4
}

//-- xlib.rock @pkg=x_lib,1
fn f() -> int {
    from_game()
}

//-- app.rock @pkg=app,2 @v1
fn g() -> int {
    x_lib::from_game()
}

//- a_stdlib_name_is_not_a_legacy_providers_export @fail=`x_lib::print` did not resolve to any definition
//-- xlib.rock @pkg=x_lib,1
fn f() -> int {
    1
}

//-- app.rock @pkg=app,2 @v1
fn g() {
    x_lib::print("x")
}

//- a_glob_of_a_legacy_provider_does_not_open_a_borrowed_name @fail=`from_game` did not resolve to any definition
//-- game.rock @pkg=game,3
fn from_game() -> int {
    4
}

//-- xlib.rock @pkg=x_lib,1
fn f() -> int {
    from_game()
}

//-- app.rock @pkg=app,2 @v1
use x_lib::*;

fn g() -> int {
    from_game()
}

//- a_legacy_provider_has_no_module_below_its_root @fail=`x_lib::sub::f` did not resolve to any definition
//-- xlib.rock @pkg=x_lib,1
fn f() -> int {
    1
}

//-- app.rock @pkg=app,2 @v1
fn g() -> int {
    x_lib::sub::f()
}
