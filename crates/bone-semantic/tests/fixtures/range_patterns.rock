//- match_inclusive_range
fn f(n: int) -> int {
    let r = match n {
        0..=3 => 1,
        4..=7 => 2,
        _ => 0,
    }
      //^ int
    r
}

//- match_exclusive_range
fn f(n: int) -> int {
    let r = match n {
        0..10 => 1,
        _ => 0,
    }
      //^ int
    r
}

//- match_unbounded_range
fn f(n: int) -> int {
    let r = match n {
        ..0 => 1,
        100.. => 2,
        _ => 0,
    }
      //^ int
    r
}
