//! Tuple indexing: `t.0`, `t.1`. The base must be a `Tuple`; the result is the
//! index-th element type. An out-of-bounds index or a non-tuple base is an
//! error.
//!
//! Marker on the `let` binding holding the projection.

//- tuple_index_first
fn f() -> int {
    let t = (1, true)
    let x = t.0
      //^ int
    5
}

//- tuple_index_second
fn f() -> int {
    let t = (1, true)
    let x = t.1
      //^ bool
    5
}

// project through a nested tuple: t.0 is (int, int), t.0.1 is int
//- tuple_index_nested
fn f() -> int {
    let t = ((1, 2), true)
    let x = t.0.1
      //^ int
    5
}
