//- tuple_index_first
fn f() -> int {
    let t = (1, true)
    let x = t.0
      //^ int
    5
}

//- tuple_index_second
fn f() -> int {
    let t = (1, true)
    let x = t.1
      //^ bool
    5
}

//- tuple_index_nested
fn f() -> int {
    let t = ((1, 2), true)
    let x = t.0.1
      //^ int
    5
}
