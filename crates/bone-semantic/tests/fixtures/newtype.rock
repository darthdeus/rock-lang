//- newtype_construct
newtype UserId(int)
fn f() -> int {
    let id = UserId(42)
      //^ UserId
    5
}

//- newtype_as_param_type
newtype Tag(string)
fn f(t: Tag) -> int {
    let x = t
      //^ Tag
    5
}

//- generic_newtype_construct
newtype Box<T>(T)
fn f() -> int {
    let b = Box(42)
      //^ Box<int>
    5
}

//- generic_newtype_multi
newtype Pair<T, U>((T, U))
fn f() -> int {
    let p = Pair((1, "hi"))
      //^ Pair<int, string>
    5
}
