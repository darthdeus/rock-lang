//- match_unit
enum Color { Red, Green, Blue }
fn f(c: Color) -> int {
    let r = match c {
        Color::Red => 1,
        Color::Green => 2,
        _ => 3,
    }
      //^ int
    r
}

//- match_payload_binding
enum Shape { Circle(int), Dot }
fn f(s: Shape) -> int {
    let r = match s {
        Shape::Circle(radius) => radius,
        Shape::Dot => 0,
    }
      //^ int
    r
}

//- match_generic
enum Opt<T> { Some(T), None }
fn f(o: Opt<int>) -> int {
    let r = match o {
        Opt::Some(x) => x,
        Opt::None => 0,
    }
      //^ int
    r
}
