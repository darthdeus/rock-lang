//- coalesce_return_bare
fn f() {
    let x: int? = 42
    let g = x ?? return
      //^ int
}

//- coalesce_return_value
fn f() -> int {
    let x: int? = 42
    let g = x ?? return 0
      //^ int
    g
}

//- coalesce_break
fn f() -> int {
    let result = 0
    for i in 0..10 {
        let v: int? = i
        let g = v ?? break
          //^ int
        result = g
    }
    result
}

//- coalesce_continue
fn f() -> int {
    let result = 0
    for i in 0..5 {
        let v: int? = i
        let g = v ?? continue
          //^ int
        result = g
    }
    result
}
