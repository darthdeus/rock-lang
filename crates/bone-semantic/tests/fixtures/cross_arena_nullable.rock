//! A nullable wrapper (or any compound) built around a Static compound type must
//! be DEEP-copied into gamma.out -- copying only the top node leaves the child
//! IdxRange pointing at the original (Static) module arena, so a later resolve
//! reads gamma.out with a Static index (panic / wrong type). Triggered by a
//! nested generic like `[Foo<T>]` flowing through a `-> U?` return.

//- nested_generic_nullable
value Foo<T> { v: T }
inline(lua) fn first<U>(xs: [U]) -> U? = "return nil"
fn f<T>(xs: [Foo<T>]) -> int {
    let e = first(xs)
      //^ Foo<T>?
    return 0
}
