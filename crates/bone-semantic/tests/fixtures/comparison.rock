//- comparison_and_logic_are_bool
fn f() -> bool {
    let a = 1 < 2
      //^ bool
    let b = 2.5 > 1.5
      //^ bool
    let c = 1 <= 1
      //^ bool
    let d = 1 < 2.5
      //^ bool
    let e = true && false
      //^ bool
    let g = true || false
      //^ bool
    let h = 1 == 2
      //^ bool
    let i = 1 == 2.5
      //^ bool
    i
}
