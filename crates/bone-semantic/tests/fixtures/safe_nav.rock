//- safe_nav_field
struct Point { x: int, y: int }
fn f(p: Point?) -> int {
    let v = p?.x
      //^ int?
    5
}

//- safe_nav_bool_field
struct Flags { on: bool }
fn f(p: Flags?) -> int {
    let v = p?.on
      //^ bool?
    5
}

//- safe_nav_chain
value Inner { n: int }
struct Outer { inner: Inner }
fn f(o: Outer?) -> int {
    let v = o?.inner?.n
      //^ int?
    5
}
