//- aliasing_mutation_through_ref_in_private_set_allowed
//-- state.rock @pkg=game,1 @v1
mod state;
pub struct Inventory {
    pub gold: int,
}
pub struct State {
    pub private(set) inventory: Inventory,
}

//-- other.rock @pkg=game,1 @v1
mod other;

fn test(s: game::state::State) -> int {
    s.inventory.gold = 50
    let g = s.inventory.gold
                       //^ int
    g
}

