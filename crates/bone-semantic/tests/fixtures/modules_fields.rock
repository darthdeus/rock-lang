//- enum_variants_inherit_visibility_allowed
//-- status.rock @pkg=game,1 @v1
mod status;
pub enum Status { Active, Inactive }

//-- other.rock @pkg=game,1 @v1
mod other;
use game::status::Status;

fn test() -> Status {
    let s = Status::Active
    let s2 = s
           //^ game::status::Status
    s2
}

