//! Modules-v1 field access pairs and privacy (plan M3; spec 10).

//- setter_on_private_field_rejects @fail=write audience must be within read audience
//-- lib.rock @pkg=chess,1 @v1
pub struct State {
    private private(set) count: int,
}

//- direct_read_private_field_rejects @fail=field `secret` on struct `Actor` is not accessible from this module
//-- actor.rock @pkg=game,1 @v1
mod actor;
pub struct Actor {
    pub name: string,
    private secret: int,
}

//-- other.rock @pkg=game,1 @v1
mod other;

fn test(a: game::actor::Actor) -> int {
    a.secret
}

