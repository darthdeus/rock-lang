    pub name: string,
    private(set) health: int = 100,
}

//-- other.rock @pkg=game,1 @v1
mod other;

fn test() {
    let r: ReadFieldRef<game::actor::Actor, int> = .health
    let r2 = r
             //^ ReadFieldRef<game::actor::Actor, int>
}

