//- newtype_public_payload_allowed
//-- id.rock @pkg=game,1 @v1
mod id;
pub newtype UserId(int)

//-- other.rock @pkg=game,1 @v1
mod other;
use game::id::UserId;

fn test() -> int {
    let u = UserId(42)
    let n = u.0
            //^ int
    let UserId(inner) = u
    let n2 = inner
             //^ int
    n2
}

