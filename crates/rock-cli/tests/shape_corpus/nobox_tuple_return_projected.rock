// M3, marked tier: a `nobox` value projected straight off a fn's TUPLE RETURN.
//
// `e43b6d2cf` made a plain `-> (NV, float)` return emit, and binding the tuple
// first still does. Projecting AT the call expression does not: `mk_pair(n).1`
// rejects. The discriminant is where the projection happens, not the tuple and
// not the consumer -- both a `let` bind and a direct-call argument reject, and
// the control differs only by binding the tuple to a name first
// (`nobox_tuple_return_projected_control.rock` -- its own file, because a compile
// rejection aborts this one and a control in here would never run).
//
// Distinct from the three tuple classes already in
// `docs/nobox-nested-ctor-plan.md`: no phi (`tuple out of a phi`), no collection
// (`tuple element in a collection`) and no nullability (`nullable tuple return`).

nobox value NV { a: int, b: int }

fn seed(n: int) -> int { return n }
fn mk_pair(n: int) -> (int, NV) { return (n, NV { a: n, b: 11 }) }
fn take(v: NV) -> int { return v.a }

// The shape: project at the call expression. Rejects.
@test(output = "7 11")
fn probe_tuple_return_projected_at_call() {
    let v = mk_pair(seed(7)).1
    print("{v.a} {v.b}")
}

// The same projection into a direct-call argument. Also rejects, so the
// consumer is not the discriminant.
@test(output = "7")
fn probe_tuple_return_projected_into_arg() {
    print("{take(mk_pair(seed(7)).1)}")
}
