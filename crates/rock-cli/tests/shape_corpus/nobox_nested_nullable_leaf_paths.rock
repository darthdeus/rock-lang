// CONSUMER GUARD -- `leaf_paths_rec` (:170). Vec column storage names one array
// per LEAF PATH. `leaf_paths_rec`'s `Nested(sub)` arm recurses into `sub.fields`
// and never consults `sub.nullable`, so a nested presence tag would get no path
// and the column set would be one short of `leaf_count`.
//
// Rejects TODAY for an UPSTREAM reason (Outer has no shape at all). It is here
// as the guard between steps: the moment the struct-field `Nullable` arm lands,
// this shape reaches `leaf_paths_rec` and the drift guard forces a verdict.

nobox value P { x: int, y: int }
nobox value Outer { a: P?, b: int }

fn seed(n: int) -> int { return n }

@test(output = "1 3 | -1 9")
fn probe_leaf_paths_of_nested_nullable_column_element() {
    let xs: [Outer] = [Outer { a: P { x: seed(1), y: 2 }, b: 3 }, Outer { a: null, b: 9 }]
    print("{xs[0].a?.x ?? -1} {xs[0].b} | {xs[1].a?.x ?? -1} {xs[1].b}")
}
