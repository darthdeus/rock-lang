// CONTROL for `index_place_refinement.rock`: the same refinement through a FIELD
// place, which DOES refine. Its own file because a compile rejection aborts the
// whole file, so a control sharing the probe's file never executes.

struct P { a: int }
struct Holder { p: P? }

@test(output = "7")
fn refinement_reaches_a_field_place() {
    let h = Holder { p: P { a: 7 } }
    if h.p != null {
        print("{h.p.a}")
    }
}
