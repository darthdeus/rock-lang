// The control for `fn_value_off_field.rock`: the same storage, fn value, and
// `nobox` argument, bound to a local before the call.
//
// Corpus case: `fn_value_off_field_bound`. Expected bucket: CORRECT.

nobox value NV { x: float, y: float }

struct Handler { cb: (NV) -> float }

@test(output = "3")
fn a_fn_value_bound_off_a_field_then_called() {
    let h = Handler { cb: (a) => a.x }
    let f = h.cb
    print("{f(NV { x: 3.0, y: 0.0 })}")
}

// The return half, in the ONE position that emits: a lambda literal in a fn's
// return position. The same lambda in a `let` or a struct-field initializer
// rejects -- the sibling case `lambda_returning_nobox_at_let.rock`.
fn arc(r: float) -> (float) -> NV {
    t => NV { x: t * r, y: t + r }
}

@test(output = "6 5")
fn a_fn_value_returning_a_nobox_value() {
    let f = arc(2.0)
    let p = f(3.0)
    print("{p.x} {p.y}")
}
