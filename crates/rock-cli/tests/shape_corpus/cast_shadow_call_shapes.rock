// SHAPE: `cast` x user shadowing, deepened past the int-argument hijack in
// `cast_name_hijack.rock`. There the argument was an `int` and the fast path
// threaded it through as the result; here the argument is itself a value struct
// and the return a DIFFERENT one, so an identity fast path that fired would
// hand back the wrong type rather than the wrong repr of the right one.
//
// Three call shapes, all of which must resolve to the USER fn: direct, UFCS on a
// value receiver, and through a lambda. The fn-value-reference shape is the one
// that does not resolve; it has its own case
// (`cast_shadow_fn_value_reference.rock`).
//
// Corpus case: `cast_shadow_call_shapes`. Expected bucket: CORRECT.

nobox value NV { x: int, y: int }
value BV { u: int, v: int }

fn cast(p: BV) -> NV {
    return NV { x: p.u + 1, y: p.v + 1 }
}

@test(output = "8 12")
fn user_cast_value_in_value_out() {
    let v = cast(BV { u: 7, v: 11 })
    print("{v.x} {v.y}")
}

@test(output = "8 12")
fn user_cast_ufcs_on_a_value_receiver() {
    let v = BV { u: 7, v: 11 }.cast()
    print("{v.x} {v.y}")
}

@test(output = "8 12")
fn user_cast_inside_a_lambda() {
    let g = (p: BV) => cast(p)
    let v = g(BV { u: 7, v: 11 })
    print("{v.x} {v.y}")
}
