// CONTROLS for `nobox_coalesce_at_ctor_field.rock`, in their own file because a
// compile rejection aborts the whole file and beside the probe they never ran.
//
// Three of them, each cutting one candidate discriminant: a phi at the SAME ctor
// field emits, so it is not "a phi at a ctor field"; the same `??` bound first
// emits and the same `??` at a call argument emits, so it is not "`??` anywhere".

nobox value NV { a: int, b: int }

fn seed(n: int) -> int { return n }
fn mk(n: int) -> NV { return NV { a: n, b: 11 } }
fn maybe(n: int) -> NV? { if n > 0 { return NV { a: n, b: 11 } } return null }
fn take(v: NV) -> int { return v.a }

struct Holder { p: NV }

@test(output = "7")
fn control_phi_if_at_ctor_field() {
    let h = Holder { p: if seed(1) > 0 { mk(7) } else { mk(0) } }
    print("{h.p.a}")
}

@test(output = "7")
fn control_coalesce_bound_then_ctor_field() {
    let v: NV = maybe(seed(7)) ?? NV { a: 0, b: 0 }
    let h = Holder { p: v }
    print("{h.p.a}")
}

@test(output = "7")
fn control_coalesce_at_call_arg() {
    print("{take(maybe(seed(7)) ?? NV { a: 0, b: 0 })}")
}
