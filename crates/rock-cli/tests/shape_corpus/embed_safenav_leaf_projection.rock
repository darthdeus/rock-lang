// LIVE BUG, shipped language -- no `nobox` anywhere. Safe-nav leaf projection
// through an `embed` field reads the wrong storage.
//
// `embed_field_of` gates on `is_embed || is_nobox`, so `@embed` and a marked
// value take the same path. `Expr::SafeNav` (`skull-mir/src/lower.rs:3995`)
// emits `Inst::Field { base, field }` BEFORE consulting `embed_field_of`, so
// the read lands on a bare `p` key that does not exist -- the field is stored
// as dotted `p.x` / `p.y`. Every other field path gates first (place-base read
// :4095 via `physical_field`, repr-path :6537, store :4164 via `store_embed`).
//
// Binding the field WHOLE (`let v = h?.p`) is caught by a separate, earlier
// rule ("no independently storable value"), which is why this stayed hidden.
// LEAF PROJECTION -- the form that rule's own diagnostic recommends as the
// workaround -- is not caught, and is what this file pins.
//
// The discriminant is safe-nav, not embed: the same read through a plain
// (non-nullable) receiver is correct, pinned in
// `embed_safenav_leaf_projection_control.rock` -- its own file, because a
// crash aborts this one and a control in here would never run.

struct Pt { x: int, y: int }
struct Holder { embed p: Pt, tag: int }

// Threaded through a param so the branch cannot be constant-folded away before
// the defect is reached (the corpus's standing trap).
fn mk(present: bool) -> Holder? {
    if present { return Holder { p: Pt { x: 1, y: 2 }, tag: 7 } }
    return null
}

// `tag` proves the holder IS present, so a null `p.x` cannot be blamed on the
// receiver. Today this prints `nil 7`.
@test(output = "1 7")
fn probe_safenav_leaf_through_embed() {
    let h = mk(true)
    print("{h?.p?.x} {h?.tag}")
}

// The wrong answer propagates one hop with no further signal: `??` sees the
// spurious null and takes the default. Today this prints `-1`.
@test(output = "1")
fn probe_safenav_leaf_coalesce() {
    let h = mk(true)
    print("{h?.p?.x ?? -1}")
}
