// SHAPE: shader-local consumption x nobox representation x GLSL backend. A `let`
// of a `Vec2` inside a `@shader` body, both GLSL profiles.
//
// The marked and unmarked runs must emit BYTE-IDENTICAL GLSL: `values_first_class`
// says the target has no boxed representation, so `is_nobox_struct` answers false
// and nothing scalarizes. A regression re-scalarizes the local into `shift__0` /
// `shift__1` -- a double underscore is a RESERVED identifier (GLSL spec 3.7), so
// the emission is illegal source with no diagnostic, and each leaf re-evaluates
// the whole initializer.
//
// The harness runs this file twice: against the vanilla stdlib and against a
// `Vec2`-marked copy via `ROCK_STDLIB_DIR`. The marked run is the only rung in
// this corpus that needs the second stdlib.
//
// Corpus cases: `glsl_local_unmarked`, `glsl_local_vec2_marked`. The same
// property with no stdlib copy:
// `skull-codegen-glsl/tests/golden.rs::a_nobox_value_local_stays_a_single_glsl_vec`.

@shader(fragment)
fn shape_probe_frag(tc: Vec2) -> Vec4 {
    let shift = v(tc.x * 0.5, tc.y * 0.5)
    return Vec4 { x: shift.x, y: shift.y, z: 0.0, w: 1.0 }
}
