// SHAPE: shader-local consumption x nobox representation x GLSL backend. A `let`
// of a `Vec2` inside a `@shader` body, both GLSL profiles.
//
// LIVE BUG, and it is why `shader-validate` falls 53/53 -> 41/53 with `Vec2`
// marked. GLSL has no boxed representation, so `values_first_class` turns the
// scalar ABI OFF for it -- but the `Let` arm threads `nobox_binding_shape`
// without that check while five sibling consumers gate on it. The local
// scalarizes into `shift__0` / `shift__1`, and an identifier containing a double
// underscore is RESERVED in GLSL (spec 3.7) -- so this emits illegal GLSL with no
// diagnostic. It also duplicates the initializer per leaf.
//
// The harness runs this file twice: against the vanilla stdlib (`Vec2` unmarked,
// CORRECT) and against a marked copy via `ROCK_STDLIB_DIR` (MISCOMPILE). The
// marked run is the only rung in this corpus that needs the second stdlib.
//
// Corpus cases: `glsl_local_unmarked` (CORRECT), `glsl_local_vec2_marked`
// (MISCOMPILE). Fix at the choke point INSIDE `nobox_binding_shape`, so the
// other consumers inherit the gate.

@shader(fragment)
fn shape_probe_frag(tc: Vec2) -> Vec4 {
    let shift = v(tc.x * 0.5, tc.y * 0.5)
    return Vec4 { x: shift.x, y: shift.y, z: 0.0, w: 1.0 }
}
