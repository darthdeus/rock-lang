// CONTROL for `index_place_refinement.rock`: binding the element to a local first
// refines, which is the workaround and the proof that no analysis beyond
// name-keyed refinement is needed once the place HAS a name.

struct P { a: int }

@test(output = "7")
fn a_bound_element_refines() {
    let xs: [P?] = [P { a: 7 }]
    let e = xs[0]
    if e != null {
        print("{e.a}")
    }
}
