// SHAPE: whole-element read out of a `[T]` column of a `nobox` value, widened
// to `T?` -- storage=Vec element, production=index/call-result, consumption=
// nullable return + refined read, repr=nobox.
//
// Every entry point here used to reject: `__vec_data_get` lowers to a Group of
// column reads and the stdlib's `cast(..)` packed it for its boxed `any` param,
// while `@nomangle` kept `vec_get`'s `T?` return off the scalar ABI. Both are
// fixed (`cad7fa39d`), so this file is a REGRESSION test asserting the correct
// answers, not a bug repro.
//
// Corpus case: `column_read_widen`. Expected bucket: CORRECT.

nobox value NV2 { x: float, y: float }

fn mk(n: float) -> NV2 { return NV2 { x: n, y: n + 1.0 } }

// get=(1,2); pop drains (7,8); remove_at(1) then takes (3,4) from [(1,2),(3,4),
// (5,6)]; swap_remove(1) takes (5,6) from what is left.
@test(output = "1 2|3 4|5 6|7 8")
fn drain_ops_read_the_column_without_materializing() {
    let xs: [NV2] = [mk(1.0), mk(3.0), mk(5.0), mk(7.0)]
    let got = xs.get(0)
    let popped = xs.pop()
    let removed = xs.remove_at(1)
    let swapped = xs.swap_remove(1)
    if got != null && popped != null && removed != null && swapped != null {
        print("{got.x} {got.y}|{removed.x} {removed.y}|{swapped.x} {swapped.y}|{popped.x} {popped.y}")
    }
}

@test(output = "3 4")
fn a_direct_column_read_widens() {
    let xs: [NV2] = [mk(3.0)]
    let e = xs.get(0)
    if e != null { print("{e.x} {e.y}") }
}

@test(output = "9 10")
fn a_column_read_through_a_user_fn_widens() {
    let xs: [NV2] = [mk(9.0)]
    let e = first(xs)
    if e != null { print("{e.x} {e.y}") }
}

fn first(xs: [NV2]) -> NV2? { return xs.get(0) }
