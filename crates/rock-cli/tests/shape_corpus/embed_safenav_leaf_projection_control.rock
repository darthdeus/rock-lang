// CONTROLS for `embed_safenav_leaf_projection.rock`, in their own file because
// that one's probes fail and a control beside them still runs but reads as part
// of the same verdict. These scope the defect to SAFE-NAV specifically, so a
// future fix cannot be credited to "embed fields work now" generally.

struct Pt { x: int, y: int }
struct Holder { embed p: Pt, tag: int }

fn mk(present: bool) -> Holder? {
    if present { return Holder { p: Pt { x: 1, y: 2 }, tag: 7 } }
    return null
}

// A plain (non-safe-nav) leaf read gates on `physical_field` and is correct.
@test(output = "1 2")
fn control_plain_leaf_read() {
    let h = Holder { p: Pt { x: 1, y: 2 }, tag: 7 }
    print("{h.p.x} {h.p.y}")
}

// `?.let` binds the receiver to a plain local first, so the body never enters
// the `Expr::SafeNav` field arm. Correct today.
@test(output = "3")
fn control_safenav_let_block() {
    let h = mk(true)
    print("{h?.let { h.p.x + h.p.y } ?? -1}")
}

// The ABSENT case is correct even through the broken arm -- the receiver is nil
// and short-circuits before any field read. Keeps the sentinel honest: a probe
// stuck at null would satisfy the bug's assertion but not this.
@test(output = "-1")
fn control_safenav_absent_receiver() {
    let h = mk(false)
    print("{h?.p?.x ?? -1}")
}
