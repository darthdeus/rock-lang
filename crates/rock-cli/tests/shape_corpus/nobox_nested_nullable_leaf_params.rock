// The scalar-ABI leaf COUNT across a call boundary for a nested-nullable shape:
// `consume` must take one param per leaf INCLUDING the nested presence tag.
// Verified by reading the emitted signature -- `consume_Outer_ret_int(c0,c1,c2,c3)`,
// four leaves for `{ a: P?, b: int }`.
//
// It does NOT cover `leaf_param_names`, despite the original intent: that names
// `inline(lua)` params, and a `nobox` value cannot cross an opaque-body boundary,
// so a nested-nullable shape cannot reach it. Ordinary scalar-ABI params are
// positional cells. Recorded rather than left as a false claim of coverage.

nobox value P { x: int, y: int }
nobox value Outer { a: P?, b: int }

fn seed(n: int) -> int { return n }

fn consume(o: Outer) -> int { return (o.a?.x ?? -1) + o.b }

@test(output = "4 8")
fn probe_leaf_params_across_a_call_boundary() {
    let present = Outer { a: P { x: seed(1), y: 2 }, b: 3 }
    let absent = Outer { a: null, b: 9 }
    print("{consume(present)} {consume(absent)}")
}
