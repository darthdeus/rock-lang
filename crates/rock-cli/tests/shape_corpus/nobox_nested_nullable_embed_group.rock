// CONSUMER GUARD -- `embed_group` (:10484). NOT in the matrix's original
// six-consumer audit; found by re-verifying the construction sites. It walks
// `shape.fields` and recurses on `Nested(sub)` with no `sub.nullable` check,
// while its own doc claims the parts "line up with `repr_to_leaves`' order by
// construction". That alignment BREAKS for a nested nullable: `repr_to_leaves`
// emits a presence leaf and `embed_group` emits no part for it.
//
// The holder is a GLOBAL on purpose. A local one is fully scalarized away
// (SROA emits `c0..c5` and no table at all), so the embed machinery is never
// reached and the probe reads green while testing nothing -- verified by
// reading the emitted Lua, not assumed.
//
// This is the machinery H1/H2 route through (`embed_field_of`), so it is the
// likeliest place for the A build to disturb the embed suite.

nobox value P { x: int, y: int }
nobox value Outer { a: P?, b: int }
struct Holder { embed o: Outer, tag: int }

global H: Holder = Holder { o: Outer { a: null, b: 0 }, tag: 0 }

fn seed(n: int) -> int { return n }
fn fill_present(n: int) { H = Holder { o: Outer { a: P { x: n, y: 2 }, b: 3 }, tag: 7 } }
fn fill_absent() { H = Holder { o: Outer { a: null, b: 9 }, tag: 8 } }

@test(output = "1 3 7 | -1 9 8")
fn probe_embed_group_over_nested_nullable() {
    fill_present(seed(1))
    let a = "{H.o.a?.x ?? -1} {H.o.b} {H.tag}"
    fill_absent()
    print("{a} | {H.o.a?.x ?? -1} {H.o.b} {H.tag}")
}
