// CONTROLS for `nobox_lambda_literal_position.rock`, in their own file because a
// compile rejection aborts the whole file and beside the probe they never ran.
//
// Both separate CAPTURE from the literal's position: a nobox value captured and
// used whole emits, as does capturing and reading a leaf, provided the lambda's
// own return type is a scalar. So capture of a nobox value works and the
// discriminant is where the LITERAL sits.

nobox value NV { a: int, b: int }

fn seed(n: int) -> int { return n }
fn call_int(f: () -> int) -> int { return f() }
fn take(v: NV) -> int { return v.a }

@test(output = "7")
fn control_capture_used_whole_scalar_return() {
    let captured: NV = NV { a: seed(7), b: 11 }
    let n = call_int(() => take(captured))
    print("{n}")
}

@test(output = "7")
fn control_capture_leaf_only() {
    let captured: NV = NV { a: seed(7), b: 11 }
    let n = call_int(() => captured.a)
    print("{n}")
}
