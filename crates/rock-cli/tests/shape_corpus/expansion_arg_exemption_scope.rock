// `materialize` evaluates its argument, so this is a real top-level fn value.
// Its definition and indirect call both use the type-derived nobox ABI.

nobox value NV { a: int, b: int }

fn takes_nobox(v: NV) -> int { return v.a }
fn call_it(f: (NV) -> int) -> int { return f(NV { a: 7, b: 11 }) }

@test(output = "7")
fn materialize_of_a_nobox_carrying_fn_uses_shared_abi() {
    let f = materialize(takes_nobox)
    print("{call_it(f)}")
}
