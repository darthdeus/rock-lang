// Mechanism A at the COLLECTION ELEMENT context. `vec_column_elem` resolves the
// element through `value_shape_rec`, so `[P?]` inherits the struct-field gap:
// no `Nullable` arm, no shape, no column storage, fall back to a boxed Vec, and
// the verifier refuses the box.
//
// This context has no constructor of its own -- it should come along for free
// with the `value_shape_rec` fix, and this probe is what proves that claim
// rather than assuming it.

nobox value P { x: int, y: int }

fn seed(n: int) -> int { return n }

@test(output = "1 -1")
fn probe_nullable_nobox_vec_element() {
    let xs: [P?] = [P { x: seed(1), y: 2 }, null]
    print("{xs[0]?.x ?? -1} {xs[1]?.x ?? -1}")
}
