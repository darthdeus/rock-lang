// M3, marked tier: a `??` recovering a nullable `nobox` value, used DIRECTLY as
// a plain struct's ctor-field initializer.
//
// The discriminant is the `??` at that position, and the three controls pin each
// half of it: binding the same `??` to a local first emits, the same `??` at a
// direct-call argument emits, and a 2-arm `if` phi at the SAME ctor field emits.
// So it is neither "a phi at a ctor field" nor "`??` anywhere" -- it is the
// nullable-to-present collapse landing on a field initializer.

nobox value NV { a: int, b: int }

fn seed(n: int) -> int { return n }
fn mk(n: int) -> NV { return NV { a: n, b: 11 } }
fn maybe(n: int) -> NV? { if n > 0 { return NV { a: n, b: 11 } } return null }
fn take(v: NV) -> int { return v.a }

struct Holder { p: NV }

// CONTROL: a 2-arm `if` phi at the ctor field. Emits.
@test(output = "7")
fn control_phi_if_at_ctor_field() {
    let h = Holder { p: if seed(1) > 0 { mk(7) } else { mk(0) } }
    print("{h.p.a}")
}

// CONTROL: the `??` bound to a local first, then used at the ctor field. Emits.
@test(output = "7")
fn control_coalesce_bound_then_ctor_field() {
    let v: NV = maybe(seed(7)) ?? NV { a: 0, b: 0 }
    let h = Holder { p: v }
    print("{h.p.a}")
}

// CONTROL: the same `??` at a direct-call argument. Emits.
@test(output = "7")
fn control_coalesce_at_call_arg() {
    print("{take(maybe(seed(7)) ?? NV { a: 0, b: 0 })}")
}

// The shape: `??` straight into the ctor field. Rejects, with a finding for the
// `??` and one for its fallback ctor.
@test(output = "7")
fn probe_coalesce_at_ctor_field() {
    let h = Holder { p: maybe(seed(7)) ?? NV { a: 0, b: 0 } }
    print("{h.p.a}")
}

// The fallback being a CALL rather than a literal ctor changes nothing.
@test(output = "7")
fn probe_coalesce_call_fallback_at_ctor_field() {
    let h = Holder { p: maybe(seed(7)) ?? mk(0) }
    print("{h.p.a}")
}
