// CONTROL for `nobox_nullable_enum_payload`: a NON-nullable multi-leaf payload
// in an escaping enum. `EnumFlatShape` widens that position to the payload's
// leaves, and a boxed context builds the Group and lets `pack` store them splat
// in the `{__variant}` box -- so nothing materializes. What still rejects on the
// twin is the `?` alone, which is what this control isolates.
//
// The enum must ESCAPE. With a local it is fully scalarized (`c0 = r1; c1 = 2`,
// no enum box at all), so the payload machinery is never reached and the probe
// reads green while testing nothing -- verified by reading the emitted Lua.

nobox value P { x: int, y: int }
enum E { Has(P), Nope }

global G: E = E::Nope

fn seed(n: int) -> int { return n }

fn show(e: E) -> string {
    match e {
        E::Has(p) => return "{p.x} {p.y}",
        E::Nope => return "nope",
    }
}

@test(output = "1 2")
fn probe_nonnullable_nobox_enum_payload_escaping() {
    G = E::Has(P { x: seed(1), y: 2 })
    print(show(G))
}
