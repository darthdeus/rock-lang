// CONTROL for `nobox_tuple_return_projected.rock`: binding the tuple to a name
// first, then projecting, emits and answers correctly.
//
// Its own file on purpose. It used to sit beside the rejecting probe, where a
// compile rejection aborts the whole file -- so it never executed and the claim
// "emits and runs" was a comment rather than a gate.

nobox value NV { a: int, b: int }

fn seed(n: int) -> int { return n }
fn mk_pair(n: int) -> (int, NV) { return (n, NV { a: n, b: 11 }) }

@test(output = "7 11")
fn control_tuple_return_bound_then_projected() {
    let t = mk_pair(seed(7))
    let v = t.1
    print("{v.a} {v.b}")
}
