fn main() {
    stone_run_game(GameConfig {
        title: "sim-scope",
        width: 640,
        height: 360,
        vsync: 0,
        clear_color: color(0.0, 0.0, 0.0, 1.0),
        esc_quits: true,
        cap_height_fonts: true,
    })
}

// The runner must start this worker inside rock-sim.slice, the budget every
// concurrent sim worker shares.
@sim
co fn sim_worker_runs_in_the_sim_slice() -> Coroutine<Wait> {
    start_game "sim-scope"
    await frame(1)
    let cgroup = (stone_file_read("/proc/self/cgroup") ?? "<unreadable>").trim()
    sim_eq_bool(cgroup.contains("/rock-sim.slice/"), true, "worker cgroup: " + cgroup)
    stop_sim()
}
