fn main() {
    stone_run_game(GameConfig {
        title: "reload-rejection",
        width: 640,
        height: 360,
        vsync: 0,
        clear_color: color(0.0, 0.0, 0.0, 1.0),
        esc_quits: true,
        cap_height_fonts: true,
    })
}

@sim_env("STONE_HOT_RELOAD", "1")
@sim_env("FRAME_COUNT", "100000")
@sim
co fn reload_rejection_exits() -> Coroutine<Wait> {
    start_game "reload-rejection"
    await frame(2)

    reload_edit("missing_reload_source.rock",
        "this source does not exist",
        "replacement")
    yield wait_for(60000, () => false)
}
