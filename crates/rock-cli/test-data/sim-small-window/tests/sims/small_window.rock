// Fixture for the small-window rule: the harness gives sims that never read
// pixels a small window, while sims that capture keep the game's default and
// an explicit `@sim_env("STONE_WINDOW", ...)` always wins. Compile-only: the
// test asserts the collected env, it never runs these sims.
fn small_window_capture_helper() {
    take_screenshot("tmp/sim-small-window-helper.png")
}

@sim
co fn small_window_plain_sim() -> Coroutine<Wait> {
    sim_expect(true, "a sim that reads no pixels runs")
    stop_sim()
}

@sim
co fn small_window_pixel_reader() -> Coroutine<Wait> {
    take_screenshot("tmp/sim-small-window-direct.png")
    sim_expect(true, "a sim that captures keeps its window")
    stop_sim()
}

@sim
co fn small_window_indirect_reader() -> Coroutine<Wait> {
    small_window_capture_helper()
    sim_expect(true, "a sim that captures through a helper keeps its window")
    stop_sim()
}

@sim
co fn small_window_readback_reader() -> Coroutine<Wait> {
    let slot = pixel_readback_new()
    sim_expect(pixel_readback_in_flight(slot) >= 0, "a sim that polls readback keeps its window")
    stop_sim()
}

@sim
co fn small_window_ui_reader() -> Coroutine<Wait> {
    let _center = imgui_test_item_center("editor/palette/view/roofs")
    sim_expect(true, "a sim that reads UI geometry keeps its window")
    stop_sim()
}

// Local stand-ins for MAG's hover-pick readers (mag/click.rock): the harness
// matches callee names, so a sim calling these classifies as a pick reader.
fn pick_at_cursor() -> int { return 0 }
fn pick_from_id(id: int) -> int { return id }
fn current_click_target() -> int { return 0 }
fn pick_selection_count() -> int { return 0 }
fn pick_selection_id() -> int { return 0 }

@sim
co fn small_window_pick_reader() -> Coroutine<Wait> {
    let _target = pick_at_cursor() + pick_from_id(0) + current_click_target()
        + pick_selection_count() + pick_selection_id()
    sim_expect(true, "a sim that reads hover picking keeps its window")
    stop_sim()
}

@sim_env("STONE_WINDOW", "800x600")
@sim
co fn small_window_explicit_size() -> Coroutine<Wait> {
    sim_expect(true, "an explicit size wins over the small default")
    stop_sim()
}
