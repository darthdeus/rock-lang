@init
fn perf_test_startup() {
    stone_delay(get_env_int("PERF_TEST_STARTUP_MS", 0))
    if get_env_int("PERF_TEST_LOG_SEVERITIES", 0) == 2 {
        log_error("PERF_TEST", "production failure severity probe\nfailure continuation")
        log_warn("PERF_TEST", "production caution severity probe\ncaution continuation")
    } else if get_env_int("PERF_TEST_LOG_SEVERITIES", 0) > 0 {
        log_error("PERF_TEST", "production failure severity probe")
        log_warn("PERF_TEST", "production caution severity probe")
    }
}

fn main() {
    stone_run_game(GameConfig {
        title: "perf-watchdog",
        width: 640,
        height: 360,
        vsync: 0,
        clear_color: color(0.0, 0.0, 0.0, 1.0),
        esc_quits: true,
        cap_height_fonts: true,
    })
}
