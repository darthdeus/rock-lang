// A package whose emitted chunk LuaJIT refuses to load: the sim runner must
// report the loader's error, not a missing result file.

fn main() {
    stone_run_game(GameConfig {
        title: "sim-load-failure",
        width: 640,
        height: 360,
        vsync: 0,
        clear_color: color(0.0, 0.0, 0.0, 1.0),
        esc_quits: true,
        cap_height_fonts: true,
    })
}

inline(lua) fn load_failure_marker() -> int = """
    return load_failure_marker_unbalanced )(
"""

@sim
co fn load_failure_reaches_the_report() -> Coroutine<Wait> {
    start_game "sim-load-failure"
    sim_eq_int(load_failure_marker(), 1, "never runs: the chunk does not load")
    stop_sim()
}
