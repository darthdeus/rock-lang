@sim
co fn unique_short_name() -> Coroutine<Wait> {
    start_game "sim-v1-names"
    await frame(2)
    sim_expect(true, "ran")
    stop_sim()
}

@sim
co fn shared_short_name() -> Coroutine<Wait> {
    start_game "sim-v1-names"
    await frame(2)
    sim_expect(true, "root ran")
    stop_sim()
}

@sim
co fn shared_snapshot_probe() -> Coroutine<Wait> {
    start_game "sim-v1-names"
    await frame(2)
    snapshot("root_shared_value", 11)
    stop_sim()
}

@sim_env("ROCK_SIM_TIMEOUT_SECS", "60")
@sim
co fn declared_long_fast() -> Coroutine<Wait> {
    start_game "sim-v1-names"
    await frame(2)
    sim_expect(true, "ran")
    stop_sim()
}

@sim_env("FRAME_COUNT", "4000000")
@sim_env("ROCK_SIM_TIMEOUT_SECS", "2")
@sim
co fn declared_timeout_slow() -> Coroutine<Wait> {
    // Same kill window as kill_window_slow, but the 2s wall budget is the
    // sim's own declaration: a run under a long process-wide budget must
    // still be killed at 2s and name that declared budget.
    start_game "sim-v1-names"
    await frame(3000000)
    sim_expect(true, "survived the declared budget")
    stop_sim()
}

@sim_env("FRAME_COUNT", "4000000")
@sim
co fn kill_window_slow() -> Coroutine<Wait> {
    // A kill window, not a workload: runner kills and wall budgets always
    // end this sim early, so it must merely outlast them. Three million
    // frames run 21s even at the observed 7us floor (7-40s typical), past
    // the 8s budget probe and the 10s orphan watch with margin.
    start_game "sim-v1-names"
    await frame(3000000)
    sim_expect(true, "survived the kill window")
    stop_sim()
}
