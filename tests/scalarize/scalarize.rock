// Locals of flat value structs are scalarized into one local per field; reads,
// repeated locals, inlined producers, once-only initializers and yield*
// arguments must behave like the unscalarized program.

struct FixVec2 {
    x: float,
    y: float,
}

struct IVec2 {
    x: int,
    y: int,
}

struct IRect {
    x: int,
    y: int,
    w: int,
    h: int,
}

struct Color {
    r: float,
    g: float,
    b: float,
    a: float,
}

@test(output = "3 4 7\n7\n1 0 0 1")
fn test_flat_reads() {
    let p = FixVec2 { x: 3.0, y: 4.0 }
    print("{p.x as int} {p.y as int} {(p.x + p.y) as int}")
    let q = IVec2 { x: 3, y: 4 }
    print(q.x + q.y)
    let c = Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 }
    print("{c.r as int} {c.g as int} {c.b as int} {c.a as int}")
}

@test(output = "5")
fn test_multiple_scalarizable_locals() {
    let p = FixVec2 { x: 1.0, y: 2.0 }
    let q = FixVec2 { x: 3.0, y: 4.0 }
    print(((p.x + q.x) + (p.y - q.y)) as int + 3)
    // (1+3) + (2-4) + 3 = 5
}

@test(output = "1 2 3 4 4 6 6 8")
fn test_many_field_reads_same_local() {
    let r = IRect { x: 1, y: 2, w: 3, h: 4 }
    // Same local read many times. Values: 1, 2, 3, 4, x+w=4, y+h=6,
    // x+w+y=6, x+y+w+h-2=8.
    print("{r.x} {r.y} {r.w} {r.h} {r.x + r.w} {r.y + r.h} {r.x + r.w + r.y} {r.x + r.y + r.w + r.h - 2}")
}

@inline
fn make_v(x: float, y: float) -> FixVec2 {
    return FixVec2 { x: x, y: y }
}

@inline
fn ivec(x: int, y: int) -> IVec2 {
    return IVec2 { x: x, y: y }
}

@inline
fn tile_center(gx: int, gy: int) -> FixVec2 {
    return FixVec2 {
        x: (gx as float + 0.5) - (gy as float + 0.5),
        y: -((gx as float + 0.5) + (gy as float + 0.5)),
    }
}

@test(output = "3 4")
fn test_inline_returned_vec_locally_scalarizable() {
    let p = make_v(3.0, 4.0)
    print("{p.x as int} {p.y as int}")
}

@test(output = "1 2")
fn test_inline_nested_struct_returns() {
    // tile_center(1, 0) = v((1.5-0.5), -(1.5+0.5)) = v(1.0, -2.0)
    let q = tile_center(1, 0)
    let qx = q.x as int
    let qy_abs = if q.y < 0.0 { -q.y as int } else { q.y as int }
    print("{qx} {qy_abs}")
}

@test(output = "8 11")
fn test_composed_inline_with_local_math() {
    let a = make_v(3.0, 4.0)
    let b = make_v(5.0, 7.0)
    let s = FixVec2 { x: a.x + b.x, y: a.y + b.y }
    print("{s.x as int} {s.y as int}")
}

@test(output = "20 30")
fn test_inline_in_hot_loop_shape() {
    let xs = 0
    let ys = 0
    for i in 0..5 {
        let grid = ivec(i * 2, i * 3)
        let p = FixVec2 { x: grid.x as float, y: grid.y as float }
        xs = xs + p.x as int
        ys = ys + p.y as int
    }
    // xs = 0+2+4+6+8 = 20; ys = 0+3+6+9+12 = 30
    print("{xs} {ys}")
}

global counter: int = 0

global fire_count_x: int = 0

global fire_count_y: int = 0

global fire_count_w: int = 0

global fire_count_h: int = 0

fn tick_x() -> int {
    fire_count_x = fire_count_x + 1
    counter = counter + 1
    return counter
}

fn tick_y() -> int {
    fire_count_y = fire_count_y + 1
    counter = counter + 1
    return counter
}

fn tick_w() -> int {
    fire_count_w = fire_count_w + 1
    counter = counter + 1
    return counter
}

fn tick_h() -> int {
    fire_count_h = fire_count_h + 1
    counter = counter + 1
    return counter
}

@test(output = "all-once sum=10")
fn test_each_initializer_fires_exactly_once() {
    counter = 0
    fire_count_x = 0
    fire_count_y = 0
    fire_count_w = 0
    fire_count_h = 0

    let r = IRect {
        x: tick_x(),
        y: tick_y(),
        w: tick_w(),
        h: tick_h(),
    }

    // Each tick fires exactly once.
    let all_once = fire_count_x == 1 && fire_count_y == 1 && fire_count_w == 1 && fire_count_h == 1

    // Final field values: each tick returns counter's value at fire
    // time. Whichever order they fire in, the sum of the four field
    // values must equal 1+2+3+4 = 10 (no duplication, no skips).
    let sum = r.x + r.y + r.w + r.h

    if all_once {
        print("all-once sum={sum}")
    } else {
        print("BUG: x={fire_count_x} y={fire_count_y} w={fire_count_w} h={fire_count_h}")
    }
}

value V2 {
    x: int,
    y: int,
}

co fn inner_leg() -> Coroutine<int> {
    yield 7
}

co fn middle(a: int, b: int) -> Coroutine<int> {
    await inner_leg()
    yield a + b
}

// Control: bind the value-local's fields to plain locals first.
co fn outer_locals() -> Coroutine<int> {
    let p = V2 { x: 2, y: 3 }
    let a = p.x
    let b = p.y
    await middle(a, b)
    yield 99
}

// Repro: pass the value-local's fields straight into the delegated call.
co fn outer_fields() -> Coroutine<int> {
    let p = V2 { x: 2, y: 3 }
    await middle(p.x, p.y)
    yield 99
}

@test(output = "7\n5\n99\n-1")
fn scalarize_yield_star_local_arg() {
    let c = outer_locals()
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}

@test(output = "7\n5\n99\n-1")
fn scalarize_yield_star_field_arg() {
    let c = outer_fields()
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}
