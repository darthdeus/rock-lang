// Locals of flat structs are scalarized into one local per field. Locals that
// are conditionally bound, escape, mutate, compare or nest must not be; either
// way the program behaves like the unscalarized one.

struct FixVec2 { x: float, y: float }
struct IVec2 { x: int, y: int }
struct IRect { x: int, y: int, w: int, h: int }
struct Color { r: float, g: float, b: float, a: float }

@test(output = "3 4 7\n7\n1 0 0 1\n5\n1 2 3 4 4 6 6 8")
fn test_flat_reads() {
    let p = FixVec2 { x: 3.0, y: 4.0 }
    print("{p.x as int} {p.y as int} {(p.x + p.y) as int}")
    let q = IVec2 { x: 3, y: 4 }
    print(q.x + q.y)
    let c = Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 }
    print("{c.r as int} {c.g as int} {c.b as int} {c.a as int}")
    let s = FixVec2 { x: 1.0, y: 2.0 }
    let t = FixVec2 { x: 3.0, y: 4.0 }
    print(((s.x + t.x) + (s.y - t.y)) as int + 3)
    let r = IRect { x: 1, y: 2, w: 3, h: 4 }
    print("{r.x} {r.y} {r.w} {r.h} {r.x + r.w} {r.y + r.h} {r.x + r.w + r.y} {r.x + r.y + r.w + r.h - 2}")
}

@inline
fn make_v(x: float, y: float) -> FixVec2 {
    return FixVec2 { x: x, y: y }
}

@inline
fn ivec(x: int, y: int) -> IVec2 {
    return IVec2 { x: x, y: y }
}

@inline
fn tile_center(gx: int, gy: int) -> FixVec2 {
    return FixVec2 {
        x: (gx as float + 0.5) - (gy as float + 0.5),
        y: -((gx as float + 0.5) + (gy as float + 0.5)),
    }
}

@test(output = "3 4\n8 11")
fn test_inline_returned_struct_locals() {
    let p = make_v(3.0, 4.0)
    print("{p.x as int} {p.y as int}")
    let a = make_v(3.0, 4.0)
    let b = make_v(5.0, 7.0)
    let s = FixVec2 { x: a.x + b.x, y: a.y + b.y }
    print("{s.x as int} {s.y as int}")
}

@test(output = "1 2")
fn test_inline_nested_struct_returns() {
    let q = tile_center(1, 0)
    let qx = q.x as int
    let qy_abs = if q.y < 0.0 { -q.y as int } else { q.y as int }
    print("{qx} {qy_abs}")
}

@test(output = "20 30")
fn test_inline_in_hot_loop_shape() {
    let xs = 0
    let ys = 0
    for i in 0..5 {
        let grid = ivec(i * 2, i * 3)
        let p = FixVec2 { x: grid.x as float, y: grid.y as float }
        xs = xs + p.x as int
        ys = ys + p.y as int
    }
    print("{xs} {ys}")
}

global counter: int = 0

fn tick() -> int {
    counter = counter + 1
    return counter
}

@test(output = "1 2 3 4 4")
fn test_each_initializer_fires_exactly_once() {
    counter = 0
    let r = IRect { x: tick(), y: tick(), w: tick(), h: tick() }
    print("{r.x} {r.y} {r.w} {r.h} {counter}")
}

value V2 { x: int, y: int }

co fn inner_leg() -> Coroutine<int> {
    yield 7
}

co fn middle(a: int, b: int) -> Coroutine<int> {
    await inner_leg()
    yield a + b
}

co fn outer_locals() -> Coroutine<int> {
    let p = V2 { x: 2, y: 3 }
    let a = p.x
    let b = p.y
    await middle(a, b)
    yield 99
}

co fn outer_fields() -> Coroutine<int> {
    let p = V2 { x: 2, y: 3 }
    await middle(p.x, p.y)
    yield 99
}

// The value-local's fields passed straight into a delegated `await`.
@test(output = "7 5 99 -1\n7 5 99 -1")
fn scalarize_yield_star_args() {
    let c = outer_locals()
    print("{c.resume() ?? -1} {c.resume() ?? -1} {c.resume() ?? -1} {c.resume() ?? -1}")
    let d = outer_fields()
    print("{d.resume() ?? -1} {d.resume() ?? -1} {d.resume() ?? -1} {d.resume() ?? -1}")
}

fn returns_ivec2() -> IVec2 {
    return IVec2 { x: 13, y: 17 }
}

@test(output = "5 10\n7 8\n13 17\n4 5")
fn test_non_literal_bindings() {
    let cond = true
    let a = if cond { IVec2 { x: 5, y: 10 } } else { IVec2 { x: -1, y: -1 } }
    print("{a.x} {a.y}")
    let opt: IVec2? = IVec2 { x: 7, y: 8 }
    let b = opt ?? IVec2 { x: 0, y: 0 }
    print("{b.x} {b.y}")
    let c = returns_ivec2()
    print("{c.x} {c.y}")
    let kind = 1
    let d = match kind {
        0 => { IVec2 { x: 0, y: 0 } },
        1 => { IVec2 { x: 4, y: 5 } },
        _ => { IVec2 { x: -1, y: -1 } },
    }
    print("{d.x} {d.y}")
}

fn make_vec(x: float, y: float) -> FixVec2 {
    let v = FixVec2 { x: x, y: y }
    return v
}

fn consume(p: FixVec2) -> float {
    return p.x + p.y
}

@test(output = "7 8\n10\n9\n4")
fn test_escapes() {
    let r = make_vec(7.0, 8.0)
    print("{r.x as int} {r.y as int}")
    let p = FixVec2 { x: 4.0, y: 6.0 }
    print(consume(p) as int)
    let q = IVec2 { x: 4, y: 5 }
    let get_sum = () => q.x + q.y
    print(get_sum())
    let xs: [FixVec2] = []
    let s = FixVec2 { x: 1.0, y: 3.0 }
    xs.push(s)
    print((xs[0].x + xs[0].y) as int)
}

@test(output = "99 2\nequal")
fn test_mutated_and_compared() {
    let p = IVec2 { x: 1, y: 2 }
    p.x = 99
    print("{p.x} {p.y}")
    let a = IVec2 { x: 1, y: 2 }
    let b = IVec2 { x: 1, y: 2 }
    print(if a == b { "equal" } else { "differ" })
}

struct Transform { pos: FixVec2, rot: float }
struct Boxed { inner: IVec2, count: int }

@test(output = "3 4 90\n2 3 5")
fn test_nested_struct_does_not_scalarize_outer() {
    let t = Transform { pos: FixVec2 { x: 3.0, y: 4.0 }, rot: 90.0 }
    print("{t.pos.x as int} {t.pos.y as int} {t.rot as int}")
    let b = Boxed { inner: IVec2 { x: 2, y: 3 }, count: 5 }
    print("{b.inner.x} {b.inner.y} {b.count}")
}
