// Regression: a value-typed local in a co fn whose fields are passed straight
// into an `await`-delegated co fn call was not rewritten by scalarization, so
// the step fn referenced a missing local and the coroutine died silently.
// Value params take a separate path; the locals form is the control.

value V2 {
    x: int,
    y: int,
}

co fn inner_leg() -> Coroutine<int> {
    yield 7
}

co fn middle(a: int, b: int) -> Coroutine<int> {
    await inner_leg()
    yield a + b
}

// Control: bind the value-local's fields to plain locals first.
co fn outer_locals() -> Coroutine<int> {
    let p = V2 { x: 2, y: 3 }
    let a = p.x
    let b = p.y
    await middle(a, b)
    yield 99
}

// Repro: pass the value-local's fields straight into the delegated call.
co fn outer_fields() -> Coroutine<int> {
    let p = V2 { x: 2, y: 3 }
    await middle(p.x, p.y)
    yield 99
}

@test(output = "7\n5\n99\n-1")
fn scalarize_yield_star_local_arg() {
    let c = outer_locals()
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}

@test(output = "7\n5\n99\n-1")
fn scalarize_yield_star_field_arg() {
    let c = outer_fields()
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}
