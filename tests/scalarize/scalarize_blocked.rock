// Locals that must not be scalarized: conditional bindings, escapes, mutation,
// comparison and nested structs.

struct IVec2 {
    x: int,
    y: int,
}

@test(output = "5 10")
fn test_if_expression_binding() {
    let cond = true
    let p = if cond { IVec2 { x: 5, y: 10 } } else { IVec2 { x: -1, y: -1 } }
    print("{p.x} {p.y}")
}

@test(output = "7 8")
fn test_nullable_coalesce_binding() {
    let opt: IVec2? = IVec2 { x: 7, y: 8 }
    let p = opt ?? IVec2 { x: 0, y: 0 }
    print("{p.x} {p.y}")
}

fn returns_ivec2() -> IVec2 {
    return IVec2 { x: 13, y: 17 }
}

@test(output = "13 17")
fn test_function_return_binding_not_literal() {
    let p = returns_ivec2()
    print("{p.x} {p.y}")
}

@test(output = "4 5")
fn test_match_arm_binding() {
    let kind = 1
    // Rock match arms need struct literals wrapped in a block/parens
    // when they'd otherwise parse ambiguously with pattern braces.
    let p = match kind {
        0 => { IVec2 { x: 0, y: 0 } },
        1 => { IVec2 { x: 4, y: 5 } },
        _ => { IVec2 { x: -1, y: -1 } },
    }
    print("{p.x} {p.y}")
}

struct FixVec2 {
    x: float,
    y: float,
}

// --- (1) Escape via return ---

fn make_vec(x: float, y: float) -> FixVec2 {
    let v = FixVec2 { x: x, y: y }
    return v
}

@test(output = "7 8")
fn test_escape_return() {
    let r = make_vec(7.0, 8.0)
    print("{r.x as int} {r.y as int}")
}

// --- (2) Escape via pass-as-arg to non-@inline fn ---

fn consume(p: FixVec2) -> float {
    return p.x + p.y
}

@test(output = "10")
fn test_escape_pass_arg() {
    let p = FixVec2 { x: 4.0, y: 6.0 }
    print(consume(p) as int)
}

// --- (3) Escape via closure capture ---

@test(output = "9")
fn test_escape_closure_capture() {
    let p = IVec2 { x: 4, y: 5 }
    let get_sum = () => p.x + p.y
    print(get_sum())
}

// --- (4) Escape via storage in a collection ---

@test(output = "4")
fn test_escape_store_in_vec() {
    let xs: [FixVec2] = []
    let p = FixVec2 { x: 1.0, y: 3.0 }
    xs.push(p)
    print((xs[0].x + xs[0].y) as int)
}

// --- (5) Not-eligible: mutation ---

@test(output = "99 2")
fn test_blocked_mutation() {
    let p = IVec2 { x: 1, y: 2 }
    p.x = 99
    print("{p.x} {p.y}")
}

// --- (6) Not-eligible: compared with == ---

@test(output = "equal")
fn test_blocked_compared() {
    let a = IVec2 { x: 1, y: 2 }
    let b = IVec2 { x: 1, y: 2 }
    if a == b {
        print("equal")
    } else {
        print("differ")
    }
}

struct Transform {
    pos: FixVec2,
    rot: float,
}

struct Boxed {
    inner: IVec2,
    count: int,
}

@test(output = "3 4 90")
fn test_nested_struct_does_not_scalarize_outer() {
    let t = Transform {
        pos: FixVec2 { x: 3.0, y: 4.0 },
        rot: 90.0,
    }
    // Outer Transform has a FixVec2 field -- not flat. Must not scalarize t.
    // Reading through the nested field still works.
    print("{t.pos.x as int} {t.pos.y as int} {t.rot as int}")
}

@test(output = "2 3 5")
fn test_nested_ivec_does_not_scalarize_outer() {
    let b = Boxed {
        inner: IVec2 { x: 2, y: 3 },
        count: 5,
    }
    print("{b.inner.x} {b.inner.y} {b.count}")
}
