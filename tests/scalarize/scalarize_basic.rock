// Adversarial tests: struct scalarization — basic correctness
//
// A local bound to a struct literal, only field-read, never escapes,
// all-primitive fields, should be scalarized. Behavior must be
// byte-identical to the non-scalarized version.

struct FixVec2 {
    x: float,
    y: float,
}

struct IVec2 {
    x: int,
    y: int,
}

struct IRect {
    x: int,
    y: int,
    w: int,
    h: int,
}

struct Color {
    r: float,
    g: float,
    b: float,
    a: float,
}

@test(output = "3 4 7")
fn test_basic_flat_read() {
    let p = FixVec2 { x: 3.0, y: 4.0 }
    print("{p.x as int} {p.y as int} {(p.x + p.y) as int}")
}

@test(output = "7")
fn test_flat_in_expression() {
    let p = IVec2 { x: 3, y: 4 }
    print(p.x + p.y)
}

@test(output = "2 3 4 5")
fn test_rect_fields() {
    let r = IRect { x: 2, y: 3, w: 4, h: 5 }
    print("{r.x} {r.y} {r.w} {r.h}")
}

@test(output = "1 0 0 1")
fn test_color_fields() {
    let c = Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 }
    print("{c.r as int} {c.g as int} {c.b as int} {c.a as int}")
}

@test(output = "5")
fn test_multiple_scalarizable_locals() {
    let p = FixVec2 { x: 1.0, y: 2.0 }
    let q = FixVec2 { x: 3.0, y: 4.0 }
    print(((p.x + q.x) + (p.y - q.y)) as int + 3)
    // (1+3) + (2-4) + 3 = 5
}

@test(output = "1 2 3 4 4 6 6 8")
fn test_many_field_reads_same_local() {
    let r = IRect { x: 1, y: 2, w: 3, h: 4 }
    // Same local read many times. Values: 1, 2, 3, 4, x+w=4, y+h=6,
    // x+w+y=6, x+y+w+h-2=8.
    print("{r.x} {r.y} {r.w} {r.h} {r.x + r.w} {r.y + r.h} {r.x + r.w + r.y} {r.x + r.y + r.w + r.h - 2}")
}
