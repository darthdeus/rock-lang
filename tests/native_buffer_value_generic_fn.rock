// Adversarial: generic fn writing a value-struct literal into a
// NativeBuffer<T>. The dispatch site (in `generate_assign_code`)
// looks up `native_buffer_value_struct_element` from the operand's
// inferred type — verify that monomorphization-time the T resolves
// correctly and the leaf-store path is taken.

@intrinsic @inline inline(lua) fn put(s: string) = "io.write(s)"

value V2 {
    x: float,
    y: float,
}

@nomangle inline(lua) fn __nb_alloc_V2(n: int) -> Ptr<V2> = 'return ffi.new("V2[?]", n)'

fn nb_v2(n: int) -> NativeBuffer<V2> {
    return NativeBuffer { ptr: __nb_alloc_V2(n), len: n }
}

fn write_first<T>(buf: NativeBuffer<T>, v: T) {
    buf[0] = v
}

@test(output = "x=7\ny=11")
fn test_generic_buffer_write() {
    let buf = nb_v2(1)
    write_first(buf, V2 { x: 7.0, y: 11.0 })
    let r = buf[0]
    put("x=")
    put("{r.x}")
    put("\n")
    put("y=")
    put("{r.y}")
    put("\n")
}
