@test
fn test_rock_range_with_step() {
    // Test default step (1)
    let range1 = __rock_range(0, 5)
    assert_eq(vec_len(range1), 5)
    assert_eq(vec_get(range1, 0).unwrap(), 0)
    assert_eq(vec_get(range1, 1).unwrap(), 1)
    assert_eq(vec_get(range1, 2).unwrap(), 2)
    assert_eq(vec_get(range1, 3).unwrap(), 3)
    assert_eq(vec_get(range1, 4).unwrap(), 4)

    // Test step of 2
    let range2 = __rock_range(0, 10, 2)
    assert_eq(vec_len(range2), 5)
    assert_eq(vec_get(range2, 0).unwrap(), 0)
    assert_eq(vec_get(range2, 1).unwrap(), 2)
    assert_eq(vec_get(range2, 2).unwrap(), 4)
    assert_eq(vec_get(range2, 3).unwrap(), 6)
    assert_eq(vec_get(range2, 4).unwrap(), 8)

    // Test step of 10
    let range3 = __rock_range(0, 360, 10)
    assert_eq(vec_len(range3), 36)
    assert_eq(vec_get(range3, 0).unwrap(), 0)
    assert_eq(vec_get(range3, 1).unwrap(), 10)
    assert_eq(vec_get(range3, 2).unwrap(), 20)
    assert_eq(vec_get(range3, 35).unwrap(), 350)

    // Test negative step
    let range4 = __rock_range(10, 0, -2)
    assert_eq(vec_len(range4), 5)
    assert_eq(vec_get(range4, 0).unwrap(), 10)
    assert_eq(vec_get(range4, 1).unwrap(), 8)
    assert_eq(vec_get(range4, 2).unwrap(), 6)
    assert_eq(vec_get(range4, 3).unwrap(), 4)
    assert_eq(vec_get(range4, 4).unwrap(), 2)
}

// Sanity check that range constructors return real Vec values with the
// metatable attached (not bare hand-built tables). UFCS dispatch on the
// result exercises the metatable: if `__rock_create_struct("Vec", ...)`
// were skipped, `__ty` and the metatable would be missing.
@test
fn test_range_results_are_real_vecs() {
    // __rock_range with explicit range — UFCS .len() and .push() on the result.
    let zr = __rock_range(0, 4)
    assert_eq(zr.len(), 4)
    zr.push(99)
    assert_eq(zr.len(), 5)
    assert_eq(vec_get(zr, 4).unwrap(), 99)

    // __rock_range — same.
    let mr = __rock_range(0, 4)
    assert_eq(mr.len(), 4)
    mr.push(42)
    assert_eq(vec_get(mr, 4).unwrap(), 42)

    // linspace — float Vec.
    let sb = linspace(0.0, 1.0, 5)
    assert_eq(sb.len(), 5)
    sb.push(2.0)
    assert_eq(sb.len(), 6)
}