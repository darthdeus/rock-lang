@test
fn test_range_expressions() {
    let nums = vec_new()
    for i in (2 + 1)..(5 * 2) {
        vec_push(nums, i)
    }

    // Check each element directly
    assert_eq(vec_len(nums), 7)
    assert_eq(unwrap(vec_get(nums, 0)), 3)
    assert_eq(unwrap(vec_get(nums, 1)), 4)
    assert_eq(unwrap(vec_get(nums, 2)), 5)
    assert_eq(unwrap(vec_get(nums, 3)), 6)
    assert_eq(unwrap(vec_get(nums, 4)), 7)
    assert_eq(unwrap(vec_get(nums, 5)), 8)
    assert_eq(unwrap(vec_get(nums, 6)), 9)
}

@test
fn test_range_single() {
    let nums = vec_new()
    for i in 5..5 {
        vec_push(nums, i)
    }

    // Check empty (5..5 produces no iterations with exclusive upper bound)
    assert_eq(vec_len(nums), 0)
}

@test
fn test_range_empty() {
    let nums = vec_new()
    for i in 5..4 {
        vec_push(nums, i)
    }

    // Check empty vec
    assert_eq(vec_len(nums), 0)
}

@test
fn test_range_negative() {
    let nums = vec_new()
    for i in -2..2 {
        vec_push(nums, i)
    }

    // Check each element directly
    assert_eq(vec_len(nums), 4)
    assert_eq(unwrap(vec_get(nums, 0)), -2)
    assert_eq(unwrap(vec_get(nums, 1)), -1)
    assert_eq(unwrap(vec_get(nums, 2)), 0)
    assert_eq(unwrap(vec_get(nums, 3)), 1)
}


@test
fn test_nested_ranges() {
    let pairs = vec_new()
    for i in 1..3 {
        for j in 4..6 {
            vec_push(pairs, (i, j))
        }
    }

    // Check each tuple directly
    assert_eq(vec_len(pairs), 4)
    let p0 = unwrap(vec_get(pairs, 0))
    assert_eq(tuple_first(p0), 1)
    assert_eq(tuple_second(p0), 4)
    let p1 = unwrap(vec_get(pairs, 1))
    assert_eq(tuple_first(p1), 1)
    assert_eq(tuple_second(p1), 5)
    let p2 = unwrap(vec_get(pairs, 2))
    assert_eq(tuple_first(p2), 2)
    assert_eq(tuple_second(p2), 4)
    let p3 = unwrap(vec_get(pairs, 3))
    assert_eq(tuple_first(p3), 2)
    assert_eq(tuple_second(p3), 5)
}
