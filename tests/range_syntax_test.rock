@test
fn test_range_basic() {
    let nums = vec_new()
    for i in 0..5 {
        vec_push(nums, i)
    }

    // Check each element directly
    assert_eq(vec_len(nums), 5)
    assert_eq(unwrap(vec_get(nums, 0)), 0)
    assert_eq(unwrap(vec_get(nums, 1)), 1)
    assert_eq(unwrap(vec_get(nums, 2)), 2)
    assert_eq(unwrap(vec_get(nums, 3)), 3)
    assert_eq(unwrap(vec_get(nums, 4)), 4)
}

