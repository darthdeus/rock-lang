// GUARD TEST — pins correct chaining of a user `operator +` overload.
//
// For `add3(V2{1,2}, V2{3,4}, V2{5,6})` with operator +(V2,V2)->V2 the
// expected result is (1+3+5, 2+4+6) = (9, 12). The legacy AST operator
// inliner used to miscompile `a + b + c` by dropping the middle operand
// and reusing `c` twice, yielding (11, 14) — that bug shipped pinned by
// an inverted assertion until the AST `InlinePass` was deleted in
// favor of ANF `InlineAnf`. The ANF inliner binds each call argument to
// a fresh local before the body splice (each operand evaluated once
// into a named local, no atom duplication across a chained overload
// call), preserving each operand.

value V2 { x: int, y: int }

operator +(a: V2, b: V2) -> V2 {
    return V2 { x: a.x + b.x, y: a.y + b.y }
}

fn add3(a: V2, b: V2, c: V2) -> V2 {
    return a + b + c
}

@test(output = "9\n12")
fn test_operator_triple_chain() {
    let r = add3(V2 { x: 1, y: 2 }, V2 { x: 3, y: 4 }, V2 { x: 5, y: 6 })
    print("{r.x}")
    print("{r.y}")
}
