// Comprehensive range tests ported from rock/tests/range_tests.rs
// Tests range literals, variables, expressions, and edge cases

// Helper function for range testing
fn print_range(start: int, end: int) {
    for i in start..end {
        print(i)
    }
}

@test(output = "1\n2")
fn basic_range_literal() {
    for i in 1..3 {
        print(i)
    }
}

@test(output = "5\n6")
fn range_with_variables() {
    let start = 5
    let end = 7
    for i in start..end {
        print(i)
    }
}

@test(output = "0\n1")
fn range_zero_to_positive() {
    for i in 0..2 {
        print(i)
    }
}

@test(output = "-2\n-1")
fn range_negative_numbers() {
    for i in -2..0 {
        print(i)
    }
}

@test(output = "2\n3")
fn range_expressions() {
    let x = 3
    for i in (x - 1)..(x + 1) {
        print(i)
    }
}

@test(output = "")
fn range_single_value() {
    for i in 5..5 {
        print(i)
    }
}

@test(output = "0")
fn empty_range() {
    let count = 0
    for i in 5..3 {
        count += 1
    }
    print(count)
}

@test(output = "2\n4")
fn range_with_arithmetic() {
    for i in 1..3 {
        print(i * 2)
    }
}

@test(output = "11")
fn nested_ranges() {
    for i in 1..2 {
        for j in 1..2 {
            print(i * 10 + j)
        }
    }
}

@test(output = "8\n9")
fn range_in_function() {
    print_range(8, 10)
}