// String interpolation holes: nested interpolated strings, `::` paths inside
// a hole, and null values.

// --- Nested interpolation ---
//
// An interpolated string nested inside another interpolation's hole. The
// outer string's parts must be exactly its own: a nested literal's parts are
// lowered while the outer ones are being collected, and must not land inside
// the outer part range (that printed "a: 11.1911.19" for the first case, and
// rejected a leaked `{y}` part as undefined when its `let` sat in the branch).

enum Mode {
    Fmt,
    Plain,
    Off,
}

fn wrap(s: string) -> string {
    return "[{s}]"
}

@test
fn test_if_branch_formatted() {
    let x = 11.19
    let ok = true
    assert_eq("a: {if ok { "{x:.2f}" } else { "no" }}", "a: 11.19")
}

@test
fn test_if_branch_plain() {
    let x = 11.19
    let ok = true
    assert_eq("b: {if ok { "{x}" } else { "no" }}", "b: 11.19")
}

@test
fn test_if_else_branch_taken() {
    let x = 11.19
    let ok = false
    assert_eq("a: {if ok { "no" } else { "{x:.1f}" }}", "a: 11.2")
}

@test
fn test_else_if_chain() {
    let n = 7
    let r = "{n}: {if n < 0 { "neg {n}" } else if n < 10 { "small {n}" } else { "big {n}" }}"
    assert_eq(r, "7: small 7")
}

@test
fn test_match_arms() {
    let x = 2.5
    let m = Mode::Fmt
    assert_eq("m: {match m { Mode::Fmt => "{x:.2f}", Mode::Plain => "{x}", Mode::Off => "off" }}", "m: 2.50")
    let p = Mode::Plain
    assert_eq("m: {match p { Mode::Fmt => "{x:.2f}", Mode::Plain => "{x}", Mode::Off => "off" }}", "m: 2.5")
}

@test
fn test_let_in_branch_block_same_line() {
    let x = 3
    let ok = true
    let r = "v: {if ok { let y = x * 2; "{x}/{y}" } else { "none" }} end"
    assert_eq(r, "v: 3/6 end")
}

@test
fn test_let_in_branch_block_multiline() {
    let x = 3
    let ok = true
    let r = "v: {if ok { let y = x * 2
        "{y}" } else { "none" }}"
    assert_eq(r, "v: 6")
}

@test
fn test_lambda_param_in_hole() {
    let xs = [1, 2]
    let r = "l: {join(xs.iter().map(v => "<{v}>").collect(), ",")}"
    assert_eq(r, "l: <1>,<2>")
}

@test
fn test_inner_string_is_part_of_branch_value() {
    let x = 4
    let ok = true
    assert_eq("<{if ok { "{x}" + "!" } else { "no" }}>", "<4!>")
    assert_eq("<{if ok { wrap("{x}") } else { "no" }}>", "<[4]>")
}

@test
fn test_call_argument() {
    let x = 5
    assert_eq("c: {wrap("{x}")}", "c: [5]")
    assert_eq("c: {wrap("x={x:03}")} tail", "c: [x=005] tail")
}

@test
fn test_outer_parts_around_the_nested_hole() {
    let x = 1.5
    let n = 9
    let ok = true
    let r = "{n} pre {if ok { "{x:.1f} in {n}" } else { "no" }} mid {n:>3} post"
    assert_eq(r, "9 pre 1.5 in 9 mid   9 post")
}

@test
fn test_two_nested_holes() {
    let a = 1
    let b = 2
    let ok = true
    let r = "x{if ok { "{a}" } else { "-" }}y{if ok { "{b}" } else { "-" }}z"
    assert_eq(r, "x1y2z")
}

@test
fn test_doubly_nested() {
    let x = 6
    let ok = true
    let r = "o: {if ok { "m: {if ok { "i: {x}" } else { "-" }}" } else { "-" }}"
    assert_eq(r, "o: m: i: 6")
}

@test
fn test_bound_to_a_local_first() {
    let x = 11.19
    let ok = true
    let bound = if ok { "{x:.2f}" } else { "no" }
    assert_eq("c: {bound}", "c: 11.19")
}

// --- `::` in a hole ---
//
// A `::` inside an interpolation hole is a PATH separator, not the start of a
// format spec. The hole splitter must only split on a single `:` at depth 0.

enum Col { Red, Green }
enum Shape { Circle(int), Rect(int, int) }

@test
fn test_enum_variant_in_hole() {
    assert_eq("{Col::Green}", "Col::Green")
    assert_eq("{Col::Red}", "Col::Red")
}

@test
fn test_enum_payload_variant_in_hole() {
    assert_eq("{Shape::Circle(2)}", "Shape::Circle(2)")
    assert_eq("{Shape::Rect(1, 2)}", "Shape::Rect(1, 2)")
}

// Controls: a single `:` still starts the spec, and a `:` nested inside a
// call/index does not split at all.

@test
fn test_plain_spec_still_splits() {
    let x = 3.14159
    assert_eq("{x:.2f}", "3.14")
    let n = 7
    assert_eq("{n:03}", "007")
}

@test
fn test_path_inside_call_arg() {
    assert_eq("{shade(Col::Green)}", "green")
    assert_eq("{shade(Col::Green):>8}", "   green")
}

// The legacy `expr :: T` ascription is a `::` too: spaced or not, it stays
// in the expression and only the following single `:` starts the spec.
@test
fn test_ascription_in_hole() {
    let n = 5
    assert_eq("{n :: int}", "5")
    assert_eq("{n::int}", "5")
    assert_eq("{n :: int:>4}", "   5")
    assert_eq("{n::int:03}", "005")
    assert_eq("{1.5 :: float:.2f}", "1.50")
    assert_eq("{Col::Green :: Col}", "Col::Green")
}

// A struct literal's braces nest inside the hole, so its field `:` is not a
// spec either -- bare, under a field read, and as a call argument.
struct HolePt { x: int, y: int }

fn hole_sum(p: HolePt) -> int { return p.x + p.y }

@test
fn test_struct_literal_in_hole() {
    assert_eq("{HolePt { x: 1, y: 2 }}", "HolePt {{ x = 1, y = 2 }}")
    assert_eq("{HolePt { x: 1, y: 2 }.y:>3}", "  2")
    assert_eq("{hole_sum(HolePt { x: 3, y: 4 }):03}", "007")
}

fn shade(c: Col) -> string {
    match c {
        Col::Red => "red",
        Col::Green => "green",
    }
}

// --- Null values ---
//
// An interpolation hole holding a NULL renders "nil", whatever its static type.
//
// `expr_ty` PEELS `Nullable` (docs: `resolve_ty`), so `stringify` picks its arm
// from the non-null shape and the value can still arrive nil. Three arms did not
// survive that: a float ran `__rock_format_float(nil)` ("bad argument to 'abs'"),
// a payload-free enum indexed `__rock_enum_<E>_names[nil]` and then concatenated
// the nil, and a newtype rendered `Id(nil)` instead of `nil`.

newtype Id(int)
value Pt { x: int, y: int }
value GcH { xs: [int], n: int }
struct Plain { k: int }

struct Box {
    f: float?, i: int?, s: string?, b: bool?,
    n: Id?, c: Col?, sh: Shape?,
    p: Pt?, g: GcH?, pl: Plain?,
    xs: [int]?, t: (int, int)?,
}

// Built through a call so no constant-folding path renders the hole statically.
fn empty_box() -> Box {
    return Box {
        f: null, i: null, s: null, b: null,
        n: null, c: null, sh: null,
        p: null, g: null, pl: null,
        xs: null, t: null,
    }
}

@test(output = "nil nil nil nil")
fn test_null_scalars_render_nil() {
    let z = empty_box()
    print("{z.f} {z.i} {z.s} {z.b}")
}

@test(output = "nil nil nil")
fn test_null_nominals_render_nil() {
    let z = empty_box()
    print("{z.n} {z.c} {z.sh}")
}

// `GcH` holds a container, which the structural formatter rejects even when
// the value is null (tests/errors/enum_format_unsupported_payload.rock.err).
@test(output = "nil nil")
fn test_null_structs_render_nil() {
    let z = empty_box()
    print("{z.p} {z.pl}")
}

@test(output = "nil nil")
fn test_null_collections_render_nil() {
    let z = empty_box()
    print("{z.xs} {z.t}")
}

// A format SPEC on a null hole must not fault either.
@test(output = "nil nil")
fn test_null_with_format_spec() {
    let z = empty_box()
    print("{z.f:.2f} {z.i:3}")
}

// CONTROL: the same holes render normally when present -- the nil guard must not
// change non-null rendering.
fn full_box() -> Box {
    return Box {
        f: 1.5, i: 7, s: "hi", b: true,
        n: Id(3), c: Col::Green, sh: Shape::Circle(2),
        p: Pt { x: 1, y: 2 }, g: GcH { xs: [1], n: 4 }, pl: Plain { k: 5 },
        xs: [1, 2], t: (3, 4),
    }
}

@test(output = "1.50 7 hi true")
fn test_present_scalars_still_render() {
    let z = full_box()
    print("{z.f:.2f} {z.i} {z.s} {z.b}")
}

@test(output = "Id(3) Col::Green")
fn test_present_nominals_still_render() {
    let z = full_box()
    print("{z.n} {z.c}")
}
