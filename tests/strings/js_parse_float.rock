// `string.parse_float` is LuaJIT `tonumber(s)` on both backends: a strict
// whole-string numeric parse returning `float?` (null on failure). JS
// `__parse_float` reproduces it rather than deferring to `Number`, which reads
// "" as 0 and disagrees on hex, inf/nan spellings and prefixes. Pins
// crates/skull-codegen-js/tests/parse_float.rs.

fn show(s: string) -> string {
    let r = s.parse_float()
    if r == null { "nil" } else { tostring(r) }
}

@test(output = "12")
fn test_int_literal() { print(show("12")) }

@test(output = "1.5")
fn test_decimal() { print(show("1.5")) }

@test(output = "1000")
fn test_exponent() { print(show("1e3")) }

@test(output = "26")
fn test_hex() { print(show("0x1A")) }

@test(output = "3")
fn test_surrounding_ws() { print(show("  3  ")) }

@test(output = "nil")
fn test_non_numeric() { print(show("12abc")) }

@test(output = "nil")
fn test_empty() { print(show("")) }

@test(output = "nil")
fn test_whitespace_only() { print(show("   ")) }

// A parsed value flows through arithmetic (it is a real float).
@test(output = "7")
fn test_arith() {
    let a = "3.5".parse_float() ?? 0.0
    let b = "3.5".parse_float() ?? 0.0
    print(tostring(a + b))
}

// LuaJIT's tonumber also reads inf/infinity/nan in any case with an optional
// sign, signed and fractional hex with a binary exponent, and `0b` binary. It
// rejects the `0o` octal prefix that JS `Number` accepts.
@test
fn test_non_finite_spellings() {
    assert_eq(show("inf"), "inf")
    assert_eq(show("-INF"), "-inf")
    assert_eq(show("+Infinity"), "inf")
    assert_eq(show("  -infinity  "), "-inf")
    assert_eq(show("nan"), "nan")
    assert_eq(show("-NaN"), "nan")
    assert_eq(show("infinit"), "nil")
    assert_eq(show("infx"), "nil")
    assert_eq(show("nan(1)"), "nil")
}

@test
fn test_hex_forms() {
    assert_eq(show("-0x10"), "-16")
    assert_eq(show("+0x10"), "16")
    assert_eq(show("0X1F"), "31")
    assert_eq(show("0x1.8"), "1.5")
    assert_eq(show("0x.8"), "0.5")
    assert_eq(show("0x1p4"), "16")
    assert_eq(show("0x1P-2"), "0.25")
    assert_eq(show("0x1.8p1"), "3")
    assert_eq(show("0x1e3"), "483")
    assert_eq(show("0x"), "nil")
    assert_eq(show("0x."), "nil")
    assert_eq(show("0x1p"), "nil")
    assert_eq(show("0x-1"), "nil")
    assert_eq(show("0xG"), "nil")
}

@test
fn test_prefixes_and_signs() {
    assert_eq(show("0b101"), "5")
    assert_eq(show("-0B11"), "-3")
    assert_eq(show("0b102"), "nil")
    assert_eq(show("0b1.1"), "nil")
    assert_eq(show("0o17"), "nil")
    assert_eq(show("-0"), "-0")
    assert_eq(show("+.5"), "0.5")
    assert_eq(show("1."), "1")
    assert_eq(show("."), "nil")
    assert_eq(show("1e"), "nil")
    assert_eq(show("+-1"), "nil")
    assert_eq(show("- 5"), "nil")
    assert_eq(show("1_0"), "nil")
    assert_eq(show("1e400"), "inf")
}
