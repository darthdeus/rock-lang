// Adversarial tests: Strings

struct Info { val: int }

struct Named {
    name: string,
    tag: string,
}

@test(output = "hello world\npi = 3.14\nflag = true\nsum = 7\nresult = 6\nnested: 42\nAlice:admin\nempty: true\n42 and 3.14\nstart42middle42end\nDec: 255, Hex: ff, Oct: 377\nThis is just a string")
fn test_interpolation_basics() {
    let name = "world"
    print("hello {name}")
    let pi = 3.14
    print("pi = {pi}")
    let flag = true
    print("flag = {flag}")
    let a = 3
    let b = 4
    print("sum = {a + b}")
    let x = 2
    print("result = {x * 3}")
    let info = Info { val: 42 }
    print("nested: {info.val}")
    let n = Named { name: "Alice", tag: "admin" }
    print("{n.name}:{n.tag}")
    let s = ""
    print("empty: {s == ""}")
    let v = 42
    print("{v} and {pi}")
    print("start{v}middle{v}end")
    let w = 255
    print("Dec: {w}, Hex: {w:x}, Oct: {w:o}")
    print("This is just a string")
}

@test(output = "true\nfalse\nhello\na b c\nline1\nline2\ntab\there")
fn test_string_values() {
    let a = "hello"
    let b = "hello"
    let c = "world"
    print(a == b)
    print(a == c)
    let opt: string? = "hello"
    print(opt ?? "default")
    let v = ["a", "b", "c"]
    let out = ""
    let first = true
    for s in v {
        if !first { out = out + " " }
        first = false
        out = out + s
    }
    print(out)
    print("line1\nline2")
    print("tab\there")
}

// --- Colon inside an interpolation hole (named args, struct literals) ---
// A `:` nested inside brackets belongs to the expression, not the `:spec`
// split. Regression: these used to silently emit literal `{...}` text.

fn add2(a: int, b: int = 1) -> int { return a + b }

@test(output = "7")
fn test_named_arg_in_hole() {
    print("{add2(2, b: 5)}")
}

@test(output = "before 7 after")
fn test_named_arg_in_hole_with_surrounding_text() {
    print("before {add2(2, b: 5)} after")
}

struct Pt { x: int, y: int }

@test(output = "9")
fn test_struct_literal_in_hole() {
    print("{Pt { x: 4, y: 5 }.x + Pt { x: 4, y: 5 }.y}")
}

@test(output = "10")
fn test_nested_call_named_arg_in_hole() {
    print("{add2(add2(3, b: 4), b: 3)}")
}
