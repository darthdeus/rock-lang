// String length, substring, split, char/byte, the StringBuilder primitives and
// repeat; the edge cases of the other string fns are in characterization.rock.

@test(output = "5\n11\n0")
fn test_string_length() {
    print("hello".len())
    print("hello world".len())
    print("".len())
}

// substring(start, end) is a 0-based, end-exclusive slice.
@test(output = "hello\nworld\nlo wo\n[]")
fn test_string_substring() {
    let s = "hello world"
    print(s.substring(0, 5))
    print(s.substring(6, 11))
    print(s.substring(3, 8))
    print("[{s.substring(2, 2)}]")
}

@test(output = "3\napple\nbanana\ncherry\n1")
fn test_string_split() {
    let parts = "apple,banana,cherry".split(",")
    print(vec_len(parts))
    for part in parts {
        print(part)
    }
    let four = "a,b,c,d".split(",")
    print(tostring(four.len - 3))
}

@test(output = "A\n65")
fn test_string_char_byte() {
    print(string_char(65))  // 'A'
    print("ABC".unit_at(0))  // 65
}

// sb_new / sb_push / sb_build: fragments build in push order, an empty
// builder builds the empty string.
@test(output = "foobarbaz\n[]\n0123")
fn test_string_builder() {
    let sb = sb_new()
    sb_push(sb, "foo")
    sb_push(sb, "bar")
    sb_push(sb, "baz")
    print(sb_build(sb))
    let empty = sb_new()
    print("[{sb_build(empty)}]")
    let looped = sb_new()
    for i in 0..4 {
        sb_push(looped, tostring(i))
    }
    print(sb_build(looped))
}

// A negative count produces an empty string, as Lua's string.rep does.
@test
fn repeat_negative_count_is_empty() {
    let count = -1
    assert_eq("ab".repeat(count), "")
}
