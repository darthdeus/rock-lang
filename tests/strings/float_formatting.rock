// Float text both ways: rendering by print and by interpolation without a
// format spec (trailing zeros dropped, scientific notation for very small and
// large magnitudes, at most 14 significant digits) and parse_float, which
// follows LuaJIT's tonumber.

@test(output = "1\n2\n1.5\n3.14159\n0.1\n0.3\n1000000\n1e-06\n2\n4\n0.5\n1.5\n2.5\n3\n3.5\n4\n4.5\ntrue\ntrue\nfalse\ntrue")
fn float_print_values() {
    print(1.0)
    print(2.0)
    print(1.5)
    print(3.14159)
    print(0.1)
    print(0.1 + 0.2)
    print(1000000.0)
    print(0.000001)
    print(1.0 + 1.0)
    print(2.0 * 2.0)
    print(1.0 / 2.0)
    print(3.0 / 2.0)
    print(5.0 / 2.0)
    print(1 + 2.0)
    print(1.5 + 2)
    print(2 * 2.0)
    print(1.5 * 3)
    print(1.0 == 1.0)
    print(2.0 > 1.0)
    print(1.0 > 2.0)
    print(1.5 < 2.0)
}

@test
fn test_float_interpolation_smart_formatting() {
    let pi = 3.14159265358979
    let whole = 5.0
    let small = 0.0001
    let large = 123456.789
    let tiny = 0.000000001
    let negative = -42.5
    let half = 0.5

    assert_eq("{pi}", "3.1416")
    assert_eq("{whole}", "5")
    assert_eq("{small}", "0.0001")
    assert_eq("{tiny}", "1e-09")
    assert_eq("{negative}", "-42.5")
    assert_eq("{half}", "0.5")
    assert_eq("{same_float(100.0)}", "100")
    assert_eq("{same_float(999999.0)}", "999999")
    assert_eq("{same_float(-0.0)}", "-0")
    assert_eq("{same_float(2.00001)}", "2")
    assert_eq("{same_float(-12.30001)}", "-12.3")
    assert_eq("{same_float(0.1 + 0.2)}", "0.3")

    // Explicit format specifiers work as expected
    assert_eq("{pi:.2f}", "3.14")
    assert_eq("{whole:.1f}", "5.0")
    assert_eq("{large:.0f}", "123457")
}

@test
fn test_float_interpolation_in_strings() {
    let temp = 98.6
    let ratio = 3.0 / 4.0

    assert_eq("Temperature: {temp}°F", "Temperature: 98.6°F")
    assert_eq("Ratio: {ratio}", "Ratio: 0.75")
}

// Non-finite floats. luajit reaches C `%.2g`, which spells these inf/-inf/nan;
// the JS port reconstructs a value from its mantissa bits and must guard them.
@test
fn test_non_finite_float_interpolation() {
    let inf = "1e400".parse_float().unwrap()
    let neg = "-1e400".parse_float().unwrap()
    let nan = (inf + neg) * 0.0

    assert_eq("{inf}", "inf")
    assert_eq("{neg}", "-inf")
    assert_eq("{nan}", "nan")
}

fn same_float(x: float) -> float { return x }
fn same_int(x: int) -> int { return x }

// `tostring` and `print` use LuaJIT's `%.14g`. The JS port has to round exact
// ties half-to-even and spell the exponent and non-finite values the same way.
@test
fn test_tostring_matches_luajit_g14() {
    assert_eq(tostring(same_float(-0.0)), "-0")
    assert_eq(tostring(same_float(1.0) / same_float(0.0)), "inf")
    assert_eq(tostring(same_float(-1.0) / same_float(0.0)), "-inf")
    assert_eq(tostring(same_float(0.0) / same_float(0.0)), "nan")
    assert_eq(tostring(same_float(1e300) * same_float(1e300)), "inf")
    assert_eq(tostring(same_float(0.1) + same_float(0.2)), "0.3")
    assert_eq(tostring(same_float(1.0) / same_float(3.0)), "0.33333333333333")
    assert_eq(tostring(same_float(1e15)), "1e+15")
    assert_eq(tostring(same_float(1e21)), "1e+21")
    assert_eq(tostring(same_float(1e100)), "1e+100")
    assert_eq(tostring(same_float(1.5e-7)), "1.5e-07")
    assert_eq(tostring(same_float(1e-5)), "1e-05")
    assert_eq(tostring(same_float(0.0001)), "0.0001")
    assert_eq(tostring(same_float(5e-324)), "4.9406564584125e-324")
    assert_eq(tostring(same_float(1.7976931348623157e308)), "1.7976931348623e+308")
    assert_eq(tostring(same_float(123456789.125)), "123456789.125")
    assert_eq(tostring(same_float(1234567890123456.0)), "1.2345678901235e+15")
    assert_eq(tostring(same_float(123456789012345.0)), "1.2345678901234e+14")
    assert_eq(tostring(same_float(1e20)), "1e+20")
    assert_eq(tostring(same_float(1e-300)), "1e-300")
    assert_eq(tostring(same_float(1234567.0)), "1234567")
}

@test
fn test_tostring_of_large_ints() {
    assert_eq(tostring(same_int(99999999999999)), "99999999999999")
    assert_eq(tostring(same_int(100000000000000)), "1e+14")
    assert_eq(tostring(same_int(123456789012345)), "1.2345678901234e+14")
    assert_eq(tostring(same_int(9007199254740992)), "9.007199254741e+15")
    assert_eq(tostring(same_int(-9007199254740992)), "-9.007199254741e+15")
    assert_eq(tostring(same_int(-2147483648)), "-2147483648")
    assert_eq(tostring(same_int(4294967296)), "4294967296")
    assert_eq("{same_int(123456789012345)}", "1.2345678901234e+14")
}

// `to_string(float)` marks an integral value with ".0", but only when the
// `%.14g` text is plain digits with an optional minus. Exponent forms and
// non-finite values already read as floats and must pass through unchanged.
@test
fn test_to_string_float_appends_point_zero_only_to_plain_digits() {
    assert_eq(to_string(same_float(3.0)), "3.0")
    assert_eq(to_string(same_float(-3.0)), "-3.0")
    assert_eq(to_string(same_float(0.0)), "0.0")
    assert_eq(to_string(same_float(-0.0)), "-0.0")
    assert_eq(to_string(same_float(1000000.0)), "1000000.0")
    assert_eq(to_string(same_float(2.5)), "2.5")
    assert_eq(to_string(same_float(-0.125)), "-0.125")
    assert_eq(to_string(same_float(0.1) + same_float(0.2)), "0.3")
    assert_eq(to_string(same_float(1e16)), "1e+16")
    assert_eq(to_string(same_float(1e-7)), "1e-07")
    assert_eq(to_string(same_float(-1.5e300)), "-1.5e+300")
    assert_eq(to_string(same_float(1.0) / same_float(0.0)), "inf")
    assert_eq(to_string(same_float(-1.0) / same_float(0.0)), "-inf")
    assert_eq(to_string(same_float(0.0) / same_float(0.0)), "nan")
    assert_eq(same_float(1e16).to_string(), "1e+16")
    assert_eq(same_float(4.0).to_string(), "4.0")
}

// `{x}` goes through `%.4f`, which keeps the sign of a negative zero.
@test
fn interpolated_negative_zero_keeps_its_sign() {
    let zero = 0.0
    assert_eq("{-zero}", "-0")
}

// 1.03125 is an exact tie at the fourth decimal; `%.4f` rounds it to even.
@test
fn interpolation_rounds_exact_ties_to_even() {
    let tie = 1.03125
    assert_eq("{tie}", "1.0312")
    assert_eq("{-tie}", "-1.0312")
}

// log10 of the double nearest 1e31 rounds up to exactly 31, one above its
// true decimal exponent.
@test
fn seventeen_digits_just_below_a_power_of_ten() {
    let value = 1e15 * [1e16][0]
    assert_eq("{value:.17g}", "9.9999999999999996e+30")
}

// parse_float, rendered back through tostring; "nil" when it rejects.
fn show(s: string) -> string {
    let r = s.parse_float()
    if r == null { "nil" } else { tostring(r) }
}

@test
fn test_basic_forms() {
    for (literal, expected) in [
        ("12", "12"), ("1.5", "1.5"), ("1e3", "1000"), ("0x1A", "26"),
        ("  3  ", "3"), ("12abc", "nil"), ("", "nil"), ("   ", "nil"),
    ] {
        assert_eq(show(literal), expected, literal)
    }
}

// A parsed value flows through arithmetic (it is a real float).
@test(output = "7")
fn test_arith() {
    let a = "3.5".parse_float() ?? 0.0
    let b = "3.5".parse_float() ?? 0.0
    print(tostring(a + b))
}

// LuaJIT's tonumber also reads inf/infinity/nan in any case with an optional
// sign, signed and fractional hex with a binary exponent, and `0b` binary. It
// rejects the `0o` octal prefix that JS `Number` accepts.
@test
fn test_non_finite_spellings() {
    for (literal, expected) in [
        ("inf", "inf"), ("-INF", "-inf"), ("+Infinity", "inf"),
        ("  -infinity  ", "-inf"), ("nan", "nan"), ("-NaN", "nan"),
        ("infinit", "nil"), ("infx", "nil"), ("nan(1)", "nil"),
    ] {
        assert_eq(show(literal), expected, literal)
    }
}

@test
fn test_hex_forms() {
    for (literal, expected) in [
        ("-0x10", "-16"), ("+0x10", "16"), ("0X1F", "31"), ("0x1.8", "1.5"),
        ("0x.8", "0.5"), ("0x1p4", "16"), ("0x1P-2", "0.25"), ("0x1.8p1", "3"),
        ("0x1e3", "483"), ("0x", "nil"), ("0x.", "nil"), ("0x1p", "nil"),
        ("0x-1", "nil"), ("0xG", "nil"),
    ] {
        assert_eq(show(literal), expected, literal)
    }
}

@test
fn test_prefixes_and_signs() {
    for (literal, expected) in [
        ("0b101", "5"), ("-0B11", "-3"), ("0b102", "nil"), ("0b1.1", "nil"),
        ("0o17", "nil"), ("-0", "-0"), ("+.5", "0.5"), ("1.", "1"),
        (".", "nil"), ("1e", "nil"), ("+-1", "nil"), ("- 5", "nil"),
        ("1_0", "nil"), ("1e400", "inf"),
    ] {
        assert_eq(show(literal), expected, literal)
    }
}
