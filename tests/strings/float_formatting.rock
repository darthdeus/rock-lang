// Float rendering by print and by interpolation without a format spec:
// trailing zeros dropped, scientific notation for very small and large
// magnitudes, at most 14 significant digits.

@test(output = "Basic float values:\n1\n2\n3\n1.5\n2.5\n3.14159")
fn float_formatting_basic() {
    print("Basic float values:")
    print(1.0)
    print(2.0)
    print(3.0)
    print(1.5)
    print(2.5)
    print(3.14159)
}

@test(output = "Float arithmetic:\n2\n4\n6\n0.5\n1.5\n2.5")
fn float_arithmetic() {
    print("Float arithmetic:")
    print(1.0 + 1.0)
    print(2.0 * 2.0)
    print(3.0 + 3.0)
    print(1.0 / 2.0)
    print(3.0 / 2.0)
    print(5.0 / 2.0)
}

@test(output = "Float comparison:\ntrue\ntrue\nfalse\ntrue")
fn float_comparison() {
    print("Float comparison:")
    print(1.0 == 1.0)
    print(2.0 > 1.0)
    print(1.0 > 2.0)
    print(1.5 < 2.0)
}

@test(output = "Mixed int/float:\n3\n3.5\n4\n4.5")
fn mixed_int_float() {
    print("Mixed int/float:")
    print(1 + 2.0)
    print(1.5 + 2)
    print(2 * 2.0)
    print(1.5 * 3)
}

@test(output = "Float precision:\n0.1\n0.2\n0.3\n0.3")
fn float_precision_issue() {
    print("Float precision:")
    print(0.1)
    print(0.2)
    print(0.1 + 0.2)
    // Rock seems to handle float formatting differently
    // It shows 0.3 instead of 0.30000000000000004
    print(0.1 + 0.2)  // Rock shows 0.3
}

@test(output = "Large floats:\n1000000\n1000000\n1e-06\n1e-06")
fn large_and_small_floats() {
    print("Large floats:")
    print(1000000.0)
    print(1000000.0)  // Rock doesn't support 1e6 notation in source
    print(0.000001)   // But it outputs in scientific notation!
    print(0.000001)
}

@test(output = "Float to string:\n1.0 becomes 1\n2.0 becomes 2\n1.5 becomes 1.5\n3.14 becomes 3.14")
fn float_to_string_behavior() {
    print("Float to string:")
    print("1.0 becomes {1.0}")
    print("2.0 becomes {2.0}")
    print("1.5 becomes {1.5}")
    print("3.14 becomes {3.14}")
}

// --- Interpolation without a format specifier ---
//
// When a float is interpolated without a format specifier,
// Rock uses smart formatting that:
// - Removes trailing zeros (5.0 becomes "5")
// - Uses scientific notation for very small/large numbers
// - Limits precision to 14 significant digits

@test
fn test_float_interpolation_smart_formatting() {
    // Various float values
    let pi = 3.14159265358979
    let whole = 5.0
    let small = 0.0001
    let large = 123456.789
    let tiny = 0.000000001
    let negative = -42.5
    let half = 0.5

    // Smart formatting without format specifier
    assert_eq("{pi}", "3.1416")
    assert_eq("{whole}", "5")             // Trailing zeros removed
    assert_eq("{small}", "0.0001")
    // TODO: this should pass
    // assert_eq("{large}", "123456.789")
    assert_eq("{tiny}", "1e-09")          // Scientific notation
    assert_eq("{negative}", "-42.5")
    assert_eq("{half}", "0.5")

    // Explicit format specifiers work as expected
    assert_eq("{pi:.2f}", "3.14")
    assert_eq("{whole:.1f}", "5.0")
    assert_eq("{large:.0f}", "123457")    // Rounds up
}

@test
fn test_float_interpolation_in_strings() {
    let temp = 98.6
    let ratio = 3.0 / 4.0

    assert_eq("Temperature: {temp}°F", "Temperature: 98.6°F")
    assert_eq("Ratio: {ratio}", "Ratio: 0.75")
}

@test
fn test_non_float_interpolation_unchanged() {
    // Ensure other types still use regular tostring
    let x = 42
    let s = "hello"
    let b = true

    assert_eq("{x}", "42")
    assert_eq("{s}", "hello")
    assert_eq("{b}", "true")
}

// Non-finite floats. luajit reaches C `%.2g`, which spells these inf/-inf/nan;
// the JS port reconstructs a value from its mantissa bits, so before it grew
// the same guard it threw "Infinity cannot be converted to a BigInt" instead of
// formatting. Both backends run this file, which is what makes it a parity gate.
@test
fn test_non_finite_float_interpolation() {
    let inf = "1e400".parse_float().unwrap()
    let neg = "-1e400".parse_float().unwrap()
    let nan = (inf + neg) * 0.0

    assert_eq("{inf}", "inf")
    assert_eq("{neg}", "-inf")
    assert_eq("{nan}", "nan")
}

fn same_float(x: float) -> float { return x }
fn same_int(x: int) -> int { return x }

// `tostring` and `print` use LuaJIT's `%.14g`. The JS port has to round exact
// ties half-to-even and spell the exponent and non-finite values the same way.
@test
fn test_tostring_matches_luajit_g14() {
    assert_eq(tostring(same_float(-0.0)), "-0")
    assert_eq(tostring(same_float(1.0) / same_float(0.0)), "inf")
    assert_eq(tostring(same_float(-1.0) / same_float(0.0)), "-inf")
    assert_eq(tostring(same_float(0.0) / same_float(0.0)), "nan")
    assert_eq(tostring(same_float(1e300) * same_float(1e300)), "inf")
    assert_eq(tostring(same_float(0.1) + same_float(0.2)), "0.3")
    assert_eq(tostring(same_float(1.0) / same_float(3.0)), "0.33333333333333")
    assert_eq(tostring(same_float(1e15)), "1e+15")
    assert_eq(tostring(same_float(1e21)), "1e+21")
    assert_eq(tostring(same_float(1e100)), "1e+100")
    assert_eq(tostring(same_float(1.5e-7)), "1.5e-07")
    assert_eq(tostring(same_float(1e-5)), "1e-05")
    assert_eq(tostring(same_float(0.0001)), "0.0001")
    assert_eq(tostring(same_float(5e-324)), "4.9406564584125e-324")
    assert_eq(tostring(same_float(1.7976931348623157e308)), "1.7976931348623e+308")
    assert_eq(tostring(same_float(123456789.125)), "123456789.125")
    assert_eq(tostring(same_float(1234567890123456.0)), "1.2345678901235e+15")
}

@test
fn test_tostring_of_large_ints() {
    assert_eq(tostring(same_int(99999999999999)), "99999999999999")
    assert_eq(tostring(same_int(100000000000000)), "1e+14")
    assert_eq(tostring(same_int(123456789012345)), "1.2345678901234e+14")
    assert_eq(tostring(same_int(9007199254740992)), "9.007199254741e+15")
    assert_eq(tostring(same_int(-9007199254740992)), "-9.007199254741e+15")
    assert_eq(tostring(same_int(-2147483648)), "-2147483648")
    assert_eq(tostring(same_int(4294967296)), "4294967296")
    assert_eq("{same_int(123456789012345)}", "1.2345678901234e+14")
}

// `to_string(float)` marks an integral value with ".0", but only when the
// `%.14g` text is plain digits with an optional minus. Exponent forms and
// non-finite values already read as floats and must pass through unchanged.
@test
fn test_to_string_float_appends_point_zero_only_to_plain_digits() {
    assert_eq(to_string(same_float(3.0)), "3.0")
    assert_eq(to_string(same_float(-3.0)), "-3.0")
    assert_eq(to_string(same_float(0.0)), "0.0")
    assert_eq(to_string(same_float(-0.0)), "-0.0")
    assert_eq(to_string(same_float(1000000.0)), "1000000.0")
    assert_eq(to_string(same_float(2.5)), "2.5")
    assert_eq(to_string(same_float(-0.125)), "-0.125")
    assert_eq(to_string(same_float(0.1) + same_float(0.2)), "0.3")
    assert_eq(to_string(same_float(1e16)), "1e+16")
    assert_eq(to_string(same_float(1e-7)), "1e-07")
    assert_eq(to_string(same_float(-1.5e300)), "-1.5e+300")
    assert_eq(to_string(same_float(1.0) / same_float(0.0)), "inf")
    assert_eq(to_string(same_float(-1.0) / same_float(0.0)), "-inf")
    assert_eq(to_string(same_float(0.0) / same_float(0.0)), "nan")
    assert_eq(same_float(1e16).to_string(), "1e+16")
    assert_eq(same_float(4.0).to_string(), "4.0")
}
