// inspect() and interpolation of composite values: scalars, structs, enums,
// collections, null fields and function values.

struct Person {
    name: string,
    age: int,
}

@test(output = "\"hello\"\n42\ntrue")
fn test_inspect_simple_types() {
    print(inspect("hello"))
    print(inspect(42))
    print(inspect(true))
}

@test(output = "Vec {{ 1, 2, 3 }}")
fn test_inspect_vec() {
    let vec = vec_new()
    vec_push(vec, 1)
    vec_push(vec, 2)
    vec_push(vec, 3)
    print(inspect(vec))
}

@test(output = "{{ city = \"NYC\", name = \"test\" }}")
fn test_inspect_map() {
    let map = map_new()
    insert(map, "name", "test")
    insert(map, "city", "NYC")
    print(inspect(map))
}

@test(output = "Person {{ age = 30, name = \"Alice\" }}")
fn test_inspect_struct() {
    let person = Person { name: "Alice", age: 30 }
    print(inspect(person))
}

@test(output = "Vec len: 2\nString: \"test\"\nNumber: 42")
fn test_inspect_mixed_data() {
    let vec = vec_new()
    vec_push(vec, "hello")
    vec_push(vec, "world")

    print("Vec len: {inspect(vec_len(vec))}")
    print("String: {inspect('test')}")
    print("Number: {inspect(42)}")
}

// Compact formatting tests - structs with 1-2 fields should be single-line

struct Point {
    x: int,
    y: int,
}

struct Single {
    value: string,
}

struct Triple {
    a: int,
    b: int,
    c: int,
}

enum Color {
    Red,
    Green,
    Blue,
    Custom { r: int, g: int },
}

@test(output = "Point {{ x = 10, y = 20 }}")
fn test_inspect_compact_two_fields() {
    let point = Point { x: 10, y: 20 }
    print(inspect(point))
}

@test(output = "Single {{ value = \"hello\" }}")
fn test_inspect_compact_one_field() {
    let single = Single { value: "hello" }
    print(inspect(single))
}

@test(output = "Triple {{\n  a = 1,\n  b = 2,\n  c = 3\n}}")
fn test_inspect_multiline_three_fields() {
    let triple = Triple { a: 1, b: 2, c: 3 }
    print(inspect(triple))
}

@test(output = "Color::Red")
fn test_inspect_enum_unit_variant() {
    let color = Color::Red
    print(inspect(color))
}

@test(output = "Color::Custom {{ g = 128, r = 255 }}")
fn test_inspect_enum_record_variant_compact() {
    let color = Color::Custom { r: 255, g: 128 }
    print(inspect(color))
}

// `Color` is stored as a scalar tag box, which carries no variant name, so the
// name has to come from the enum itself wherever the box reaches `inspect`:
// through a parameter and out of a Vec as well as straight from a literal.
fn inspect_color(color: Color) -> string { return inspect(color) }

enum Shade { Plain, Tint(int, int) }

@test(output = "Color::Blue Color::Custom {{ g = 2, r = 1 }} Color::Green")
fn test_inspect_scalar_enum_box_away_from_its_literal() {
    let colors: [Color] = [Color::Green]
    print("{inspect_color(Color::Blue)} {inspect_color(Color::Custom { r: 1, g: 2 })} {inspect(colors[0])}")
}

@test(output = "Shade::Plain Shade::Tint {{ [1] = 3, [2] = 4 }}")
fn test_inspect_scalar_enum_box_tuple_variant() {
    let shades: [Shade] = [Shade::Plain, Shade::Tint(3, 4)]
    print("{inspect(shades[0])} {inspect(shades[1])}")
}

@test(output = "{{ 1, 2, 3 }}")
fn test_inspect_tuple_compact() {
    let tuple = (1, 2, 3)
    print(inspect(tuple))
}

struct NestedCompact {
    point: Point,
    name: string,
}

@test(output = "NestedCompact {{ name = \"test\", point = Point {{ x = 5, y = 10 }} }}")
fn test_inspect_nested_compact() {
    let nested = NestedCompact { point: Point { x: 5, y: 10 }, name: "test" }
    print(inspect(nested))
}
// A `nobox` field nested in a value struct: the ctor FLATTENS to the dotted
// leaf form (`flatten_nobox_nested_ctors`), so an inspect renderer that looks
// fields up by DECLARED name no longer finds `pos`. Both backends must still
// render the declared shape -- otherwise marking a math type `nobox` silently
// converts every print of a struct containing it into a JS skip, which deletes
// coverage rather than reporting a gap.
nobox value InspNV { x: float, y: float }
value InspE5 { pos: InspNV, a: float, b: float, c: float }

@test(output = "InspE5 {{ pos: InspNV {{ x: 1, y: 2 }}, a: 3, b: 4, c: 5 }}")
fn test_inspect_flattened_nobox_value_struct() {
    let xs: [InspE5] = []
    xs.push(InspE5 { pos: InspNV { x: 1.0, y: 2.0 }, a: 3.0, b: 4.0, c: 5.0 })
    print(inspect(xs[0]))
}

// A flat enum threads a `nobox` record payload as widened positional leaves,
// so the box carries no field names of its own. `inspect` must still name the
// variant and the payload's DECLARED fields, read from the enum's variant
// descriptor and the payload's type-table entry -- never the `[1]`/`[2]` slots.
nobox value InspP2 { x: float, y: float }

enum InspU { V2(InspP2), F(float) }

@test(output = "InspU::V2 {{ x = 1, y = 2 }}")
fn test_inspect_flat_enum_nobox_record_payload() {
    let u = InspU::V2(InspP2 { x: 1.0, y: 2.0 })
    print(inspect(u))
}

// Control: a scalar tuple payload has no declared field names, so it keeps
// the established positional rendering.
@test(output = "InspU::F {{ [1] = 7 }}")
fn test_inspect_flat_enum_scalar_payload_stays_positional() {
    print(inspect(InspU::F(7.0)))
}

// --- Null fields ---
//
// A nil field is an ABSENT KEY in the emitted Lua table, so a key-driven
// inspect cannot see it. Field rendering is driven off `__ROCK_TYPE_TABLE`
// so declared-but-null fields still render.
//
// Expected strings are composed through `{ob}`/`{cb}` holes because a Rock
// string literal cannot contain a literal brace (no `{{`, no `\{`).

struct AllNull { a: int?, b: string? }
struct SomeNull { a: int, b: string?, c: int? }
struct NoNull { a: int, b: string }

fn __brace_open() -> string {
    return from_codepoint(123)
}

fn __brace_close() -> string {
    return from_codepoint(125)
}

@test
fn test_all_fields_null() {
    let ob = __brace_open()
    let cb = __brace_close()
    let x = AllNull { a: null, b: null }
    assert_eq(inspect(x), "AllNull {ob} a = nil, b = nil {cb}")
}

@test
fn test_some_fields_null() {
    let ob = __brace_open()
    let cb = __brace_close()
    let x = SomeNull { a: 1, b: null, c: null }
    assert_eq(inspect(x), "SomeNull {ob}\n  a = 1,\n  b = nil,\n  c = nil\n{cb}")
}

@test
fn test_null_field_in_interpolation() {
    let ob = __brace_open()
    let cb = __brace_close()
    let x = AllNull { a: null, b: null }
    assert_eq("{x}", "AllNull {ob} a = nil, b = nil {cb}")
}

// Controls: a fully-populated struct is unchanged, and a populated field
// alongside a null one still renders its value.

@test
fn test_no_null_fields_unchanged() {
    let ob = __brace_open()
    let cb = __brace_close()
    let x = NoNull { a: 1, b: "hi" }
    assert_eq(inspect(x), "NoNull {ob} a = 1, b = \"hi\" {cb}")
}

@test
fn test_populated_field_survives() {
    let ob = __brace_open()
    let cb = __brace_close()
    let x = SomeNull { a: 42, b: "set", c: null }
    assert_eq(inspect(x), "SomeNull {ob}\n  a = 42,\n  b = \"set\",\n  c = nil\n{cb}")
}

// --- Function values ---
//
// A capturing lambda compiles to an env record `setmetatable({ __slot = .., c<N>
// = .. }, __rock_fn_mt)` -- a plain Lua table. Every generic table-walker
// (inspect, and interpolation of a composite, which routes through inspect) must
// render it as a FUNCTION value, matching a capture-free lambda (a raw Lua
// function), not leak its `{ __slot = .., c<N> = .. }` capture internals.

struct Holder { cb: fn() -> int, tag: int }

fn make_capfree() -> fn() -> int { return () => 42 }
fn make_capturing(x: int) -> fn() -> int { return () => x + 1 }

// Both a capture-free (raw function) and a capturing (record) lambda inspect to
// the `function: ...` form -- the record is rendered via its CodeRef, not walked.
@test(output = "true\ntrue")
fn test_inspect_record_renders_as_function() {
    print(inspect(make_capfree()).starts_with("function: "))
    print(inspect(make_capturing(10)).starts_with("function: "))
}

// No capture internals leak from a record's inspect output.
@test(output = "false")
fn test_inspect_record_no_leak() {
    print(inspect(make_capturing(10)).contains("__slot"))
}

// A struct holding a capturing lambda renders the field as a function, same as
// one holding a capture-free lambda -- the record does not leak through the walk.
@test(output = "true\ntrue\nfalse")
fn test_inspect_composite_with_record() {
    let hf = Holder { cb: make_capfree(), tag: 1 }
    let hc = Holder { cb: make_capturing(10), tag: 2 }
    print(inspect(hf).contains("cb = function: "))
    print(inspect(hc).contains("cb = function: "))
    print(inspect(hc).contains("__slot"))
}

// Interpolation of a composite holding a capturing lambda routes through inspect
// -- same no-leak guarantee.
@test(output = "false")
fn test_interp_composite_with_record() {
    let hc = Holder { cb: make_capturing(10), tag: 2 }
    let s = "{hc}"
    print(s.contains("__slot"))
}

// --- Interpolation routes composite values through inspect() ---

enum Status {
    Ok,
    Error(string)
}

@test fn test_composite_types_use_inspect() {
    // Test structs - should NOT show memory addresses
    let p = Point { x: 10, y: 20 }
    let result = "{p}"
    assert(!result.contains("0x"), "Struct should not show memory address")
    // Type name display for user-defined structs is now implemented
    assert(result.contains("Point"), "Struct should show type name")
    assert(result.contains("x") && result.contains("10"), "Struct should show fields")
    
    // Test arrays - should NOT show memory addresses
    let arr = [1, 2, 3]
    let arr_str = "{arr}"
    assert(!arr_str.contains("0x"), "Array should not show memory address")
    assert(arr_str.contains("Vec"), "Array should show Vec type")
    assert(arr_str.contains("1") && arr_str.contains("2") && arr_str.contains("3"), "Array should show contents")
    
    // Test tuples - should show contents
    let tup = (42, "hello")
    let tup_str = "{tup}"
    assert(tup_str.contains("42"), "Tuple should show first element")
    assert(tup_str.contains("hello"), "Tuple should show second element")
    
    // Test enums - should show variant information
    let status1 = Status::Ok
    let status1_str = "{status1}"
    assert(!status1_str.contains("0x"), "Enum should not show memory address")
    assert(status1_str.contains("Status"), "Enum should show type name")
    assert(status1_str.contains("Ok"), "Enum should show variant")
    
    let status2 = Status::Error("oops")
    let status2_str = "{status2}"
    assert(status2_str.contains("Status"), "Enum should show type name")
    assert(status2_str.contains("Error"), "Enum should show variant")
    assert(status2_str.contains("oops"), "Enum should show variant data")
}

@test fn test_primitive_types_use_tostring() {
    // Test that primitive types still use tostring (no change)
    assert("{42}" == "42", "Integer interpolation")
    assert("{true}" == "true", "Boolean interpolation")
    assert("{\"hello\"}" == "hello", "String interpolation")
    assert("{3.14159}" == "3.1416", "Float interpolation with default precision")
}
