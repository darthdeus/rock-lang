// String interpolation format specifiers: float, integer, string and
// composite formatting, grouping, doubled braces, and precision applied to
// struct and array fields.

struct FixVec2 { x: float, y: float }
struct Pair { a: int, b: int }
enum Hue { Red, Green }

@test
fn float_formatting_cases() {
    let pi = 3.14159265
    assert_eq("{pi:.2f}", "3.14")
    assert_eq("{pi:.0f}", "3")
    assert_eq("{pi:.6f}", "3.141593")
    assert_eq("{pi:.3}", "3.142")
    let v = 1.5
    assert_eq("{v:8.2f}", "    1.50")
    assert_eq("{v:4.1f}", " 1.5")
    assert_eq("{v:2.3f}", "1.500")
    let t = 3.14
    assert_eq("{t:08.2f}", "00003.14")
    let neg = -1.5
    // Sign stays leftmost while zero padding fills between sign and digits.
    assert_eq("{neg:08.2f}", "-0001.50")
    let nt = -3.14
    assert_eq("{t:+.2f}", "+3.14")
    assert_eq("{nt:+.2f}", "-3.14")

    v = 3.14
    assert_eq("{v:+010.2f}", "+000003.14")
    neg = -3.14
    assert_eq("{neg:+010.2f}", "-000003.14")
    v = 1.5
    assert_eq("[{v:*^10.2f}]", "[***1.50***]")

    v = 3.75
    assert_eq("{v:d}", "3")
    neg = -3.75
    assert_eq("{neg:d}", "-4")
    let n = 42
    assert_eq("{n:.2f}", "42.00")
    assert_eq("{n:8.2f}", "   42.00")

    v = 0.25
    // Percent formatting emits the scaled value and one literal percent.
    assert_eq("{v:.1%}", "25.0%")
    let v2 = 0.5
    assert_eq("{v2:.0%}", "50%")
    let v3 = 0.0
    assert_eq("{v3:.2%}", "0.00%")

    let half = 0.5
    assert_eq("{half:#g}", "0.500000")
    assert_eq("{half:#.0f}", "0.")
    assert_eq("{half:#.0e}", "5.e-01")
    let big = 1234567.0
    assert_eq("{big:#g}", "1.23457e+06")
    assert_eq("{half * 0.0:#g}", "0.00000")

    let inf = 1.0 / 0.0
    assert_eq("{inf:g}", "inf")
    assert_eq("{-inf:.3g}", "-inf")
    assert_eq("{inf:G}", "INF")
    let nan = inf - inf
    assert_eq("{nan:g}".lower().replace("-", ""), "nan")
    assert_eq("[{inf:08.2f}]", "[     inf]")
    assert_eq("[{-inf:08.2f}]", "[    -inf]")
    assert_eq("[{nan:08.2f}]", "[     nan]")
    assert_eq("[{nan:+.2f}]", "[nan]")
}

@test
fn integer_formatting_cases() {
    let n = 42
    assert_eq("{n:5d}", "   42")
    assert_eq("{n:1d}", "42")
    assert_eq("{n:05d}", "00042")
    let neg = -42
    assert_eq("{neg:05d}", "-0042")

    n = 255
    assert_eq("{n:x}", "ff")
    assert_eq("{n:X}", "FF")
    assert_eq("{n:#x}", "0xff")
    assert_eq("{n:#X}", "0XFF")
    assert_eq("{n:o}", "377")
    assert_eq("{n:#o}", "0377")
    assert_eq("{n:#010x}", "0x000000ff")
    assert_eq("{n:#010X}", "0X000000FF")
    let m = 15
    assert_eq("{m:04x}", "000f")
    assert_eq("{m:#06x}", "0x000f")

    n = 10
    assert_eq("{n:b}", "1010")
    assert_eq("{0:b}", "0")
    neg = -5
    assert_eq("{neg:b}", "-101")
    let five = 5
    assert_eq("[{five:8b}]", "[     101]")
    assert_eq("[{five:<8b}]", "[101     ]")
    let code = 65
    assert_eq("{code:c}", "A")
    let lower = 97
    assert_eq("{lower:c}", "a")
    assert_eq("[{code:^5c}]", "[  A  ]")
    assert_eq("[{code:<5c}]", "[A    ]")
    let v = 1234567.89
    assert_eq("{v:.2e}", "1.23e+06")
    assert_eq("{v:.2E}", "1.23E+06")

    n = 42
    v = 1.5
    assert_eq("[{n:<5}]", "[42   ]")
    assert_eq("[{n:<5d}]", "[42   ]")
    assert_eq("[{n:^6}]", "[  42  ]")
    assert_eq("[{v:<8.2f}]", "[1.50    ]")
    assert_eq("[{v:^8.2f}]", "[  1.50  ]")
    assert_eq("[{v:0<8.2f}]", "[1.500000]")
    assert_eq("[{v:-^8.2f}]", "[--1.50--]")

    let b = true
    let f = false
    assert_eq("[{b:<8}]", "[true    ]")
    assert_eq("[{f:>8}]", "[   false]")
    assert_eq("[{b:^7}]", "[ true  ]")

    let pos = 42
    neg = -42
    assert_eq("[{pos: d}]", "[ 42]")
    assert_eq("[{neg: d}]", "[-42]")
    v = 3.14
    assert_eq("[{v: .2f}]", "[ 3.14]")
    let nv = -3.14
    assert_eq("[{nv: .2f}]", "[-3.14]")

    let s = ""
    assert_eq("[{s:5s}]", "[     ]")
    assert_eq("[{s:<5s}]", "[     ]")
    assert_eq("[{s:^5}]", "[     ]")
    n = 0
    assert_eq("{n:5d}", "    0")
    assert_eq("{n:05d}", "00000")
    assert_eq("{n:b}", "0")
    v = 0.0
    assert_eq("{v:.2f}", "0.00")
    let big = 123456
    assert_eq("{big:3d}", "123456")
    let h = "hello"
    assert_eq("{h:2s}", "hello")
    assert_eq("{h:<2}", "hello")

    n = -1
    assert_eq("{n:x}", "ffffffffffffffff")
    assert_eq("{n:X}", "FFFFFFFFFFFFFFFF")
    assert_eq("{n:o}", "1777777777777777777777")
}

@test
fn string_formatting_cases() {
    let s = "hi"
    assert_eq("[{s:10s}]", "[        hi]")
    assert_eq("[{s:>10s}]", "[        hi]")
    // Untyped width and left alignment on a string.
    assert_eq("[{s:>10}]", "[        hi]")
    assert_eq("[{s:<10}]", "[hi        ]")
    assert_eq("[{s:<10s}]", "[hi        ]")
    assert_eq("[{s:^10}]", "[    hi    ]")
    assert_eq("[{s:^11}]", "[    hi     ]")
    assert_eq("[{s:^2}]", "[hi]")
    assert_eq("[{s:^1}]", "[hi]")

    s = "hello world"
    assert_eq("{s:.5s}", "hello")
    assert_eq("{s:10.5s}", "     hello")
    assert_eq("{s:<10.5s}", "hello     ")

    s = "x"
    assert_eq("[{s:*<5}]", "[x****]")
    assert_eq("[{s:*>5}]", "[****x]")
    assert_eq("[{s:*^5}]", "[**x**]")

    s = "ab"
    assert_eq("[{s:^5}]", "[ ab  ]")
    let s2 = "abc"
    assert_eq("[{s2:^6}]", "[ abc  ]")

    s = "hello"
    assert_eq("[{s:.0s}]", "[]")
    assert_eq("[{s:5.0s}]", "[     ]")

    s = "x"
    // Fill characters that need escaping must not break the generated literal.
    assert_eq("[{s:\"^5}]", "[\"\"x\"\"]")
    assert_eq("[{s:\\<5}]", "[x\\\\\\\\]")

    let a = "foo"
    let b = 42
    let c = 3.14
    assert_eq(
        "[{a:<5}][{b:>5d}][{c:06.2f}]",
        "[foo  ][   42][003.14]"
    )

    let names = ["frame_draw", "world_draw", "draw_game"]
    let vals = [4.29, 3.52, 2.20]
    let out = "{names[0]:<12}{vals[0]:7.2f}\n{names[1]:<12}{vals[1]:7.2f}\n{names[2]:<12}{vals[2]:7.2f}"
    let expected = "frame_draw     4.29\nworld_draw     3.52\ndraw_game      2.20"
    assert_eq(out, expected)
}

@test
fn composite_formatting_cases() {
    // Composite formatting must still take the structural rendering path.
    let v = FixVec2 { x: 3.14159, y: 2.71828 }
    assert_eq("{v.x:.2f}", "3.14")
    assert_eq("{v.y:.3f}", "2.718")

    let p = Pair { a: 1, b: 2 }
    // Compare structural padding with the value rendering instead of duplicating inspect spacing.
    let rendered = "{p}"
    assert_eq("[{p:>40}]", "[{rendered.pad_left(40)}]")
    assert_eq("[{p:<40}]", "[{rendered.pad_right(40)}]")
    assert_eq("[{p:>2}]", "[{rendered}]")

    let width = len(rendered) + 4
    assert_eq(len("{p:^{width}}"), width)
    assert_eq(len("{p:*>{width}}"), width)
    assert(("{p:*>{width}}").starts_with("**"))

    let h = Hue::Green
    assert_eq("[{h:>14}]", "[    Hue::Green]")
    assert_eq("[{h:<14}]", "[Hue::Green    ]")
    assert_eq("[{h:>4}]", "[Hue::Green]")
    let xs = [1, 2]
    assert_eq(len("[{xs:>20}]"), 22)

    // Precision is applied before width padding.
    v = FixVec2 { x: 1.2345, y: 6.7890 }
    rendered = "{v:.2}"
    assert_eq("[{v:>40.2}]", "[{rendered.pad_left(40)}]")
    assert(("{v:>40.2}").contains("1.23"))
}

fn lbrace() -> string { return string_char(123) }
fn rbrace() -> string { return string_char(125) }

@test
fn doubled_brace_cases() {
    let x = 42
    let l = lbrace()
    let r = rbrace()
    // Build expected braces independently so escaping is tested on the input side.
    assert_eq("{{literal}}", "{l}literal{r}")
    assert_eq("{{{x}}}", "{l}42{r}")
    assert_eq("{{x}} and {x}", "{l}x{r} and 42")
    assert_eq("}}close{{", "{r}close{l}")
    assert_eq(len("{{literal}}"), 9)

    let name = "alice"
    let age = 30
    let s = "{{\"name\":\"{name}\",\"age\":{age}}}"
    let expected = "{lbrace()}\"name\":\"alice\",\"age\":30{rbrace()}"
    assert_eq(s, expected)

    x = 1
    s = """
{{literal}} {x}
"""
    assert_eq(s, "\n{lbrace()}literal{rbrace()} 1\n")
}

// Keep the multi-slot stdout checks and the direct format_float entry point.
@test(output = "[  42]|[42  ]|[ 42 ]\n1,234,567\n101|-101\n12.34%\n3.14\n2|4\n[   42]|00042|ff\n-1.50\n[  3.14]")
fn formatting_entry_points() {
    let x = 42
    print("[{x:>4}]|[{x:<4}]|[{x:^4}]")
    x = 1234567
    print("{x:,}")
    let a = 5
    let b = -5
    print("{a:b}|{b:b}")
    let percent = 0.1234
    print("{percent:.2%}")
    let pi = 3.14159
    print("{pi:.2f}")
    let even = 2.5
    let odd = 3.5
    print("{even:.0f}|{odd:.0f}")
    x = 42
    let h = 255
    print("[{x:5d}]|{x:05d}|{h:x}")
    let neg = -1.5
    print("{neg:.2f}")
    print("[{format_float(3.14159, 6, 2)}]")
}

@test
fn padding_with_odd_slack_and_embedded_nul() {
    let text = "a\u{0}b"
    let width = 6
    assert_eq(text.pad_left(width), "   a\u{0}b")
    assert_eq(text.pad_right(width), "a\u{0}b   ")
    assert_eq(text.pad_left(-1), text)
    assert_eq(text.pad_right(3), text)
    assert_eq("{text:*^{width}}", "*a\u{0}b**")
}

@test
fn test_grouping_comma() {
    let n = 1000000
    assert_eq("{n:,}", "1,000,000")
    assert_eq("{n:,d}", "1,000,000")
    let x = 1234.5
    assert_eq("{x:,.2f}", "1,234.50")
    let neg = -1000000
    assert_eq("{neg:,d}", "-1,000,000")
    // Values under 1000 get no separator.
    let small = 42
    assert_eq("{small:,d}", "42")
    let edge = 999
    assert_eq("{edge:,d}", "999")
    let thousand = 1000
    assert_eq("{thousand:,d}", "1,000")
    // Grouping is applied before padding; the resulting "1,000" has
    // length 5, padded to 10 with leading spaces.
    assert_eq("[{thousand:10,d}]", "[     1,000]")
}

@test
fn test_grouping_underscore() {
    let h = 0xdeadbeef
    assert_eq("{h:_x}", "dead_beef")
    let n = 1000000
    assert_eq("{n:_d}", "1_000_000")
}

struct P { x: int }

value ScalarBag { x: int, n: int }

@test
fn composite_without_numeric_flags() {
    let p = P { x: 1 }
    // These keep the widths from the rejected sign and zero-pad cases.
    assert_eq("{p:12}", " P {{ x = 1 }}")
    assert_eq("{p:}", "P {{ x = 1 }}")
    let xs = [1, 2]
    assert_eq("{xs:8}", "Vec {{ 1, 2 }}")
}

@test
fn top_level_value_record_with_scalar_fields() {
    let b = ScalarBag { x: 1, n: 5 }
    assert_eq("{b}", "ScalarBag {{ x: 1, n: 5 }}")
    assert_eq(tostring(b), "ScalarBag {{ x: 1, n: 5 }}")
}

struct Mixed {
    name: string,
    value: float,
    count: int
}

@test
fn test_struct_float_formatting() {
    let pos = FixVec2 { x: 5.123123, y: 43240.432432 }

    // Without format spec - full precision
    let full = "{pos}"
    assert(full.contains("5.123123"))
    assert(full.contains("43240.432432"))

    // With .1 precision - rounds to 1 decimal place
    let one_decimal = "{pos:.1}"
    assert(one_decimal.contains("5.1"))
    assert(one_decimal.contains("43240.4"))
    assert(!one_decimal.contains("5.123"))

    // With .3 precision - rounds to 3 decimal places
    let three_decimal = "{pos:.3}"
    assert(three_decimal.contains("5.123"))
    assert(three_decimal.contains("43240.432"))

    // With .0 precision - rounds to whole numbers
    let whole = "{pos:.0}"
    assert(whole.contains("x = 5"))
    assert(whole.contains("y = 43240"))
}

@test
fn test_mixed_struct_formatting() {
    let data = Mixed { name: "test", value: 3.14159, count: 42 }

    // With precision - only affects float fields
    let formatted = "{data:.2}"
    assert(formatted.contains("name = \"test\""))
    assert(formatted.contains("value = 3.14"))
    assert(formatted.contains("count = 42"))
}

struct Container {
    position: FixVec2,
    label: string
}

@test
fn test_nested_struct_formatting() {
    let obj = Container {
        position: FixVec2 { x: 1.23456, y: 9.87654 },
        label: "object"
    }

    // Precision applies to nested structs too
    let formatted = "{obj:.1}"
    assert(formatted.contains("x = 1.2"))
    assert(formatted.contains("y = 9.9"))
    assert(formatted.contains("label = \"object\""))
}

@test
fn test_array_of_floats_formatting() {
    let values = [1.111, 2.222, 3.333]

    // Precision applies to array elements within the Vec structure
    let formatted = "{values:.1}"
    assert(formatted.contains("1.1, 2.2, 3.3"))
    assert(!formatted.contains("1.111"))
    assert(!formatted.contains("2.222"))
    assert(!formatted.contains("3.333"))
}

@test
fn test_individual_field_formatting_still_works() {
    let pos = FixVec2 { x: 5.123123, y: 43240.432432 }

    // Individual field formatting should continue to work
    assert("{pos.x:.1}" == "5.1")
    assert("{pos.y:.2}" == "43240.43")
}

fn square(x: int) -> int {
    return x * x
}

struct Point {
    x: int,
    y: int
}

// Width, zero-pad and sign without a type letter on an int.
@test(output = "042\n7\n07\n00007\n+42\n-17\n100\n0100")
fn integer_width_sign_and_octal() {
    let x = 42
    print("{x:03}")
    let y = 7
    print("{y:01}")
    print("{y:02}")
    print("{y:05}")
    let neg = -17
    print("{x:+}")
    print("{neg:+}")
    let o = 64
    print("{o:o}")
    print("{o:#o}")
}

// A single-hole interpolation's leading pad must survive to stdout (no
// surrounding literal to protect it).
@test(output = "   42")
fn integer_width_single_hole() {
    let x = 42
    print("{x:5}")
}

@test(output = "Result: 16.000\nSquare of 7 is 0049\nDistance: 25.00")
fn format_spec_on_expressions() {
    let x = 5
    let y = 3
    print("Result: {x * y + 1:.3f}")
    let n = 7
    print("Square of {n} is {square(n):04d}")
    let p = Point { x: 3, y: 4 }
    print("Distance: {(p.x * p.x + p.y * p.y):.2f}")
}

