// Payload-free enums (all unit variants) carry an `int` ordinal repr under skull
// (construction -> ordinal, match -> int compare, `==` -> int compare), yet a
// `{x}` interpolation hole still renders `<Enum>::<Variant>` from the static type
// -- byte-identical to rock's table-based inspect. This is the skull-diff oracle
// for that format match; rock is the reference.

enum BlendMode {
    Normal,
    Additive,
    Multiply,
}

@test(output = "BlendMode::Normal\nBlendMode::Additive\nBlendMode::Multiply")
fn test_interp_each_variant() {
    // A bare `{Enum::Variant}` parses `::Variant` as a format spec, so bind first.
    let n = BlendMode::Normal
    let a = BlendMode::Additive
    let m = BlendMode::Multiply
    print("{n}")
    print("{a}")
    print("{m}")
}

@test(output = "mode=BlendMode::Additive")
fn test_interp_through_local() {
    let m = BlendMode::Additive
    print("mode={m}")
}

@test(output = "add")
fn test_match_int_compare() {
    let m = BlendMode::Additive
    let s = match m {
        BlendMode::Normal => "norm",
        BlendMode::Additive => "add",
        BlendMode::Multiply => "mul",
    }
    print(s)
}

@test(output = "eq ne")
fn test_eq_is_int_compare() {
    let a = BlendMode::Multiply
    let b = BlendMode::Multiply
    let c = BlendMode::Normal
    let eq = if a == b { "eq" } else { "ne" }
    let ne = if a == c { "eq" } else { "ne" }
    print("{eq} {ne}")
}
