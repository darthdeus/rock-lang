// String operations: formatting, slicing, search and conversion.

fn square(x: int) -> int {
    return x * x
}

struct Point {
    x: int,
    y: int
}

// `.N` without a type letter formats a float at that precision.
@test(output = "3.14\n123\n123.5\n123.457\n123.456789")
fn float_precision_without_type() {
    let pi = 3.14159265
    print("{pi:.2}")
    let val = 123.456789
    print("{val:.0}")
    print("{val:.1}")
    print("{val:.3}")
    print("{val:.6}")
}

// Width, zero-pad and sign without a type letter on an int.
@test(output = "042\n7\n07\n00007\n+42\n-17\n100\n0100")
fn integer_width_sign_and_octal() {
    let x = 42
    print("{x:03}")
    let y = 7
    print("{y:01}")
    print("{y:02}")
    print("{y:05}")
    let neg = -17
    print("{x:+}")
    print("{neg:+}")
    let o = 64
    print("{o:o}")
    print("{o:#o}")
}

// A single-hole interpolation's leading pad must survive to stdout (no
// surrounding literal to protect it) -- guards the harness leading-strip fix.
@test(output = "   42")
fn integer_width_single_hole() {
    let x = 42
    print("{x:5}")
}

@test(output = "Result: 16.000\nSquare of 7 is 0049\nDistance: 25.00")
fn format_spec_on_expressions() {
    let x = 5
    let y = 3
    print("Result: {x * y + 1:.3f}")
    let n = 7
    print("Square of {n} is {square(n):04d}")
    let p = Point { x: 3, y: 4 }
    print("Distance: {(p.x * p.x + p.y * p.y):.2f}")
}

fn print_message(msg: string) {
    print(msg)
}

fn get_greeting(name: string) -> string {
    return "Hello, " + name + "!"
}

fn get_prefix() -> string { return "pre" }

fn get_suffix() -> string { return "fix" }

@test(output = "Hello World\nfoobar\nabcde\nmiddle\nLanguage: Rock v1.0\nHello World!\nStart middle end\nLanguage: Rock (v1)")
fn test_string_concatenation_values() {
    print("Hello" + " " + "World")
    let a = "foo"
    let b = "bar"
    print(a + b)
    print("a" + "b" + "c" + "d" + "e")
    let empty = ""
    print(empty + "middle" + empty)
    let name = "Rock"
    let version = "1.0"
    print("Language: " + name + " v" + version)
    print(("Hello" + " ") + ("World" + "!"))
    let message = "Start"
    let message2 = message + " middle"
    let message3 = message2 + " end"
    print(message3)
    let major = 1
    print("Language: " + name + " (v{major})")
}

@test(output = "Hello World\nHello, Rock!\npre-fix\nMatch!\nhello world")
fn test_string_concatenation_positions() {
    print_message("Hello" + " " + "World")
    print(get_greeting("Rock"))
    print(get_prefix() + "-" + get_suffix())
    let prefix = "test"
    let suffix = "ing"
    if prefix + suffix == "testing" {
        print("Match!")
    }
    let maybe_string: string? = "hello"
    if !is_null(maybe_string) {
        print(maybe_string + " world")
    }
}

struct Info { val: int }

struct Named {
    name: string,
    tag: string,
}

@test(output = "hello world\npi = 3.14\nflag = true\nsum = 7\nresult = 6\nnested: 42\nAlice:admin\nempty: true\n42 and 3.14\nstart42middle42end\nDec: 255, Hex: ff, Oct: 377\nThis is just a string")
fn test_interpolation_basics() {
    let name = "world"
    print("hello {name}")
    let pi = 3.14
    print("pi = {pi}")
    let flag = true
    print("flag = {flag}")
    let a = 3
    let b = 4
    print("sum = {a + b}")
    let x = 2
    print("result = {x * 3}")
    let info = Info { val: 42 }
    print("nested: {info.val}")
    let n = Named { name: "Alice", tag: "admin" }
    print("{n.name}:{n.tag}")
    let s = ""
    print("empty: {s == ""}")
    let v = 42
    print("{v} and {pi}")
    print("start{v}middle{v}end")
    let w = 255
    print("Dec: {w}, Hex: {w:x}, Oct: {w:o}")
    print("This is just a string")
}

@test(output = "true\nfalse\nhello\na b c\nline1\nline2\ntab\there")
fn test_string_values() {
    let a = "hello"
    let b = "hello"
    let c = "world"
    print(a == b)
    print(a == c)
    let opt: string? = "hello"
    print(opt ?? "default")
    let v = ["a", "b", "c"]
    let out = ""
    let first = true
    for s in v {
        if !first { out = out + " " }
        first = false
        out = out + s
    }
    print(out)
    print("line1\nline2")
    print("tab\there")
}

// --- Colon inside an interpolation hole (named args, struct literals) ---
// A `:` nested inside brackets belongs to the expression, not the `:spec`
// split. Regression: these used to silently emit literal `{...}` text.

fn add2(a: int, b: int = 1) -> int { return a + b }

@test(output = "7")
fn test_named_arg_in_hole() {
    print("{add2(2, b: 5)}")
}

@test(output = "before 7 after")
fn test_named_arg_in_hole_with_surrounding_text() {
    print("before {add2(2, b: 5)} after")
}

struct Pt { x: int, y: int }

@test(output = "9")
fn test_struct_literal_in_hole() {
    print("{Pt { x: 4, y: 5 }.x + Pt { x: 4, y: 5 }.y}")
}

@test(output = "10")
fn test_nested_call_named_arg_in_hole() {
    print("{add2(add2(3, b: 4), b: 3)}")
}

@test(output = "5\n11\n0")
fn test_string_length() {
    print("hello".len())
    print("hello world".len())
    print("".len())
}

// substring(start, end) is a 0-based, end-exclusive slice.
@test(output = "hello\nworld\nlo wo\n[]")
fn test_string_substring() {
    let s = "hello world"
    print(s.substring(0, 5))
    print(s.substring(6, 11))
    print(s.substring(3, 8))
    print("[{s.substring(2, 2)}]")
}

@test(output = "3\napple\nbanana\ncherry\n1")
fn test_string_split() {
    let parts = "apple,banana,cherry".split(",")
    print(vec_len(parts))
    for part in parts {
        print(part)
    }
    let four = "a,b,c,d".split(",")
    print(tostring(four.len - 3))
}

@test(output = "A\n65")
fn test_string_char_byte() {
    print(string_char(65))
    print("ABC".unit_at(0))
}

// sb_new / sb_push / sb_build: fragments build in push order, an empty
// builder builds the empty string.
@test(output = "foobarbaz\n[]\n0123")
fn test_string_builder() {
    let sb = sb_new()
    sb_push(sb, "foo")
    sb_push(sb, "bar")
    sb_push(sb, "baz")
    print(sb_build(sb))
    let empty = sb_new()
    print("[{sb_build(empty)}]")
    let looped = sb_new()
    for i in 0..4 {
        sb_push(looped, tostring(i))
    }
    print(sb_build(looped))
}

// A negative count produces an empty string, as Lua's string.rep does.
@test
fn repeat_negative_count_is_empty() {
    let count = -1
    assert_eq("ab".repeat(count), "")
}
