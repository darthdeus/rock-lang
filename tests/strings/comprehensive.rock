// Format specifiers on interpolated expressions, and string concatenation in
// every expression position.

fn square(x: int) -> int {
    return x * x
}

struct Point {
    x: int,
    y: int
}

// `.N` without a type letter formats a float at that precision.
@test(output = "3.14\n123\n123.5\n123.457\n123.456789")
fn float_precision_without_type() {
    let pi = 3.14159265
    print("{pi:.2}")
    let val = 123.456789
    print("{val:.0}")
    print("{val:.1}")
    print("{val:.3}")
    print("{val:.6}")
}

// Width, zero-pad and sign without a type letter on an int.
@test(output = "042\n7\n07\n00007\n+42\n-17\n100\n0100")
fn integer_width_sign_and_octal() {
    let x = 42
    print("{x:03}")
    let y = 7
    print("{y:01}")
    print("{y:02}")
    print("{y:05}")
    let neg = -17
    print("{x:+}")
    print("{neg:+}")
    let o = 64
    print("{o:o}")
    print("{o:#o}")
}

// A single-hole interpolation's leading pad must survive to stdout (no
// surrounding literal to protect it) -- guards the harness leading-strip fix.
@test(output = "   42")
fn integer_width_single_hole() {
    let x = 42
    print("{x:5}")
}

@test(output = "Result: 16.000\nSquare of 7 is 0049\nDistance: 25.00")
fn format_spec_on_expressions() {
    let x = 5
    let y = 3
    print("Result: {x * y + 1:.3f}")
    let n = 7
    print("Square of {n} is {square(n):04d}")
    let p = Point { x: 3, y: 4 }
    print("Distance: {(p.x * p.x + p.y * p.y):.2f}")
}

fn print_message(msg: string) {
    print(msg)
}

fn get_greeting(name: string) -> string {
    return "Hello, " + name + "!"
}

fn get_prefix() -> string { return "pre" }
fn get_suffix() -> string { return "fix" }

@test(output = "Hello World\nfoobar\nabcde\nmiddle\nLanguage: Rock v1.0\nHello World!\nStart middle end\nLanguage: Rock (v1)")
fn test_string_concatenation_values() {
    print("Hello" + " " + "World")
    let a = "foo"
    let b = "bar"
    print(a + b)
    print("a" + "b" + "c" + "d" + "e")
    let empty = ""
    print(empty + "middle" + empty)
    let name = "Rock"
    let version = "1.0"
    print("Language: " + name + " v" + version)
    print(("Hello" + " ") + ("World" + "!"))
    let message = "Start"
    let message2 = message + " middle"
    let message3 = message2 + " end"
    print(message3)
    let major = 1
    print("Language: " + name + " (v{major})")
}

@test(output = "Hello World\nHello, Rock!\npre-fix\nMatch!\nhello world")
fn test_string_concatenation_positions() {
    print_message("Hello" + " " + "World")
    print(get_greeting("Rock"))
    print(get_prefix() + "-" + get_suffix())
    let prefix = "test"
    let suffix = "ing"
    if prefix + suffix == "testing" {
        print("Match!")
    }
    let maybe_string: string? = "hello"
    if !is_null(maybe_string) {
        print(maybe_string + " world")
    }
}
