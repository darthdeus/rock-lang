// String literals: raw strings, concatenation across blocks and function-key names.

@test
fn test_raw_skips_interpolation_and_escapes() {
    assert_eq(r"{x}", "{{x}}")
    assert_eq(r"{x:02d}", "{{x:02d}}")
    assert_eq(r"\n", "\\n")
    assert_eq(r"C:\path\to\file", "C:\\path\\to\\file")
    assert_eq(r"", "")
}

@test
fn test_raw_with_regular_interpolated_nearby() {
    let name = "Alice"
    let pattern = r"\d+"
    assert_eq("hi {name}, regex: {pattern}", "hi Alice, regex: \\d+")
}

@test
fn test_raw_triple_quoted() {
    let shader = r"""
vec4 frag(vec2 uv) {
    return vec4(uv, 0.0, 1.0);
}
"""
    assert_eq(
        shader,
        "\nvec4 frag(vec2 uv) {{\n    return vec4(uv, 0.0, 1.0);\n}}\n"
    )
}

enum Inner { X, Y(bool) }

value Pair { a: int, b: int }

enum Outer {
    Rec { x: int?, y: string? },
    Nested(Inner),
    Opt(Pair?),
}

fn show(e: Outer) -> string {
    return match e {
        Outer::Rec { x, y } => "D{x ?? -1}{y ?? "n"}",
        Outer::Nested(Inner::X) => "X",
        Outer::Nested(Inner::Y(b)) => "Y{b}",
        Outer::Opt(p) => "O{p?.a ?? -1}",
    }
}

@test
fn concat_operands_stay_in_scope_across_cases() {
    assert_eq(show(Outer::Rec { x: null, y: null }), "D-1n")
    assert_eq(show(Outer::Rec { x: 7, y: "s" }), "D7s")
    assert_eq(show(Outer::Nested(Inner::Y(true))), "Ytrue")
    assert_eq(show(Outer::Opt(Pair { a: 3, b: 4 })), "O3")
}

global SDLK_F1: int = 0x4000003A

global SDLK_F12: int = 0x40000045

fn sdl_keycode_to_string(keycode: int) -> string {
    if keycode >= SDLK_F1 && keycode <= SDLK_F12 {
        let f_num = keycode - SDLK_F1 + 1
        return "f{f_num}"
    }
    return "{keycode}"
}

@test
fn fkey_string_mapping() {
    assert_eq(sdl_keycode_to_string(SDLK_F1), "f1")
    assert_eq(sdl_keycode_to_string(SDLK_F1 + 6), "f7")
    assert_eq(sdl_keycode_to_string(SDLK_F12), "f12")
}

// Simulate reading an FFI enum field. Without tonumber() the value is cdata
// int64 and tostring() appends an "LL" suffix.
inline(lua) fn cdata_int_tostring() -> string = """
    local event = ffi.new("struct { int64_t key; }")
    event.key = 42
    return tostring(event.key)
"""

inline(lua) fn coerced_int_tostring() -> string = """
    local event = ffi.new("struct { int64_t key; }")
    event.key = 42
    return tostring(tonumber(event.key))
"""

@test(backends = "lua")
fn cdata_leaks_LL_suffix_without_tonumber() {
    assert_eq(cdata_int_tostring(), "42LL")
    assert_eq(coerced_int_tostring(), "42")
}
