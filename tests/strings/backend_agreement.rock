// Edge cases where the Lua and JS backends must print the same text.
fn same_str(s: string) -> string { return s }
fn same_float(x: float) -> float { return x }
fn same_int(x: int) -> int { return x }

// `substring(a, b)` is Lua `string.sub(a + 1, b)` on both backends, so a
// negative bound counts from the end.
@test
fn test_substring_negative_bounds() {
    assert_eq(same_str(".5").substring(-1, 3), ".5")
    assert_eq(same_str("x-y-z").substring(-1, 6), "x-y-z")
    assert_eq(same_str("abc").substring(0, -1), "abc")
    assert_eq(same_str("abcd").substring(0, -2), "abc")
    assert_eq(same_str("abcd").substring(-3, 4), "cd")
    assert_eq(same_str("abcd").substring(3, 1), "")
}

// Case mapping covers ASCII letters only.
@test
fn test_case_mapping_is_ascii_only() {
    assert_eq(same_str("aBc\u{e9}\u{fc}").upper(), "ABC\u{e9}\u{fc}")
    assert_eq(same_str("AbC\u{c9}\u{dc}").lower(), "abc\u{c9}\u{dc}")
}

// `{x}` keeps 14 significant digits outside [1e-4, 1e6), like `print`.
@test
fn test_float_interpolation_large_and_small() {
    assert_eq("{same_float(-7.25e16)}", "-7.25e+16")
    assert_eq("{same_float(1234567.0)}", "1234567")
    assert_eq("{same_float(1234567.5)}", "1234567.5")
    assert_eq("{same_float(1.2345678e-5)}", "1.2345678e-05")
    assert_eq("{same_float(1e-9)}", "1e-09")
    assert_eq("{same_float(1e20)}", "1e+20")
}

struct SignedZeroBox { n: int }
value SignedZeroValue { n: int, s: string }
enum SignedZeroEnum { Held(int), Empty }

// Lua and JS numbers are doubles, so int arithmetic can produce -0; every
// int-to-text route prints it as `0`.
@test
fn test_int_zero_has_no_sign() {
    let product = same_int(0) * same_int(-3)
    let negated = -same_int(0)
    let maybe: int? = negated
    for z in [product, negated] {
        assert_eq("{z}", "0")
        assert_eq(tostring(z), "0")
        assert_eq(z.to_string(), "0")
        assert_eq("x" + z.to_string(), "x0")
        assert_eq(inspect(z), "0")
        assert_eq(inspect([z]), "Vec {{ 0 }}")
        assert_eq("{SignedZeroBox { n: z }}", "SignedZeroBox {{ n = 0 }}")
        assert_eq("{SignedZeroValue { n: z, s: "s" }}", "SignedZeroValue {{ n: 0, s: \"s\" }}")
        assert_eq("{SignedZeroEnum::Held(z)}", "SignedZeroEnum::Held(0)")
        assert_eq("{(z, z)}", "{{ 0, 0 }}")
        assert_eq(json_encode(json_int(z)), "0")
        assert_eq(json_record_write(JsonRecordCodec {}, SignedZeroBox { n: z }), "{{\"n\":0}}")
        assert_eq(json_encode(json_record_encode(JsonRecordCodec {}, SignedZeroBox { n: z })), "{{\"n\":0}}")
    }
    assert_eq("{maybe}", "0")
}
