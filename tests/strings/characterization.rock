// Characterization tests for the stdlib string fns (stdlib/unified.rock).
// These pin the CURRENT behavior of split/replace/contains/starts_with/
// ends_with/trim/join/find/upper/lower/repeat BEFORE they are ported from
// inline(lua) to pure Rock. Every expected value below was produced by
// running the current implementation, not assumed. The port must keep these
// green (byte-identical behavior) or consciously update a pin.
//
// Special attention: split/replace feed the delimiter/needle into Lua
// gmatch/gsub, so they must escape Lua pattern magic chars (% . - * + ? [ ]
// ( ) ^ $). Those escape gymnastics are exactly what these tests pin.

@intrinsic @nomangle inline(lua) fn try_call(f: fn()) -> bool = """
    local ok, err = pcall(f)
    return not ok
"""

// Splitting by "(" or "[" leaves the unmatched closer in the tail element.
@test(output = "[a|b|c]\n[abc]\n[a|b|]\n[|a|b]\n[a|b|c]\n[a|b|c]\n[a|b|c]\n[a|b|c]\n[a|b]\n[a|b)c]\n[a|b]c]")
fn test_split() {
    print("[{join("a,b,c".split(","), "|")}]")
    print("[{join("abc".split(","), "|")}]")
    print("[{join("a,b,".split(","), "|")}]")
    print("[{join(",a,b".split(","), "|")}]")
    print("[{join("aXYbXYc".split("XY"), "|")}]")
    print("[{join("a.b.c".split("."), "|")}]")
    print("[{join("a%b%c".split("%"), "|")}]")
    print("[{join("a-b-c".split("-"), "|")}]")
    print("[{join("a*b".split("*"), "|")}]")
    print("[{join("a(b)c".split("("), "|")}]")
    print("[{join("a[b]c".split("["), "|")}]")
}

// An empty delimiter or needle is a programmer error -- there is nothing to
// split on or find. The pure-Rock port rejects both with error(...) (the
// earlier Lua gmatch/gsub impls leaked empty strings or inserted the
// replacement at every boundary; sentinels flipped when the port decided the
// intended shape).
@test
fn test_split_and_replace_reject_empty_pattern() {
    assert(try_call(() => { let _x = "hello".split("") }))
    assert(try_call(() => { let _x = "abc".replace("", "X") }))
}

// A lone "%" in the replacement survives as a literal "%" (the escaped_new
// "%%" -> "%%%%" dance), not a gsub capture; a replacement containing the
// needle does not re-match.
@test(output = "[a;b;c]\n[hello bar hello]\n[a_b]\n[a_b]\n[a%b]\n[aXXb]\n[abc]\n[a_b]]\n[a_b]")
fn test_replace() {
    print("[{"a,b,c".replace(",", ";")}]")
    print("[{"foo bar foo".replace("foo", "hello")}]")
    print("[{"a.b".replace(".", "_")}]")
    print("[{"a%b".replace("%", "_")}]")
    print("[{"aXb".replace("X", "%")}]")
    print("[{"aXb".replace("X", "XX")}]")
    print("[{"abc".replace("z", "Y")}]")
    print("[{"a[b]".replace("[", "_")}]")
    print("[{"a-b".replace("-", "_")}]")
}

// Plain-text search, so "." matches a literal dot, not any char.
@test(output = "true\nfalse\ntrue\ntrue\nfalse\nfalse")
fn test_contains() {
    print("hello".contains("ell"))
    print("hello".contains("xyz"))
    print("hello".contains(""))
    print("a.b".contains("."))
    print("ab".contains("abc"))
    print("".contains("hello"))
}

@test(output = "true\nfalse\ntrue\nfalse\ntrue\ntrue\nfalse\ntrue\nfalse\ntrue")
fn test_starts_with_ends_with() {
    print("hello".starts_with("he"))
    print("hello".starts_with("lo"))
    print("hello".starts_with(""))
    print("ab".starts_with("abc"))
    print("".starts_with(""))
    print("hello".ends_with("lo"))
    print("hello".ends_with("he"))
    print("hello".ends_with(""))
    print("ab".ends_with("abc"))
    print("".ends_with(""))
}

@test(output = "[hi]\n[]\n[hi]\n[hi]")
fn test_trim() {
    print("[{"  hi  ".trim()}]")
    print("[{"".trim()}]")
    print("[{"\t\nhi\n\t".trim()}]")
    print("[{"hi".trim()}]")
}

@test(output = "[a,b,c]\n[]\n[x]\n[a-b-c]")
fn test_join() {
    let empty: [string] = []
    print("[{join(["a", "b", "c"], ",")}]")
    print("[{join(empty, ",")}]")
    print("[{join(["x"], ",")}]")
    print("[{join(["a", "b", "c"], "-")}]")
}

// find: 0-based unit index, -1 on miss; plain text, so "." finds the literal
// dot at index 1, not index 0. The optional start skips earlier matches.
@test(output = "2\n0\n3\n-1\n0\n1\n-1\n3")
fn test_find() {
    print("hello".find("ll"))
    print("hello".find("he"))
    print("hello".find("lo"))
    print("hello".find("z"))
    print("hello".find(""))
    print("a.b".find("."))
    print("ab".find("abc"))
    print("abcabc".find("a", 1))
}

@test(output = "HELLO\nhello\n[ababab]\n[]")
fn test_upper_lower_repeat() {
    print("heLLo".upper())
    print("heLLo".lower())
    print("[{"ab".repeat(3)}]")
    print("[{"ab".repeat(0)}]")
}
