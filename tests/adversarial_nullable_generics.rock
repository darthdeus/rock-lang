// Adversarial tests: Generics + Nullable interactions

struct Box<T> {
    val: T,
}

struct NullableBox<T> {
    val: T?,
}

// --- Generic functions with nullable ---

fn identity<T>(x: T?) -> T? {
    return x
}

@test(output = "42")
fn test_generic_nullable_identity_present() {
    let x: int? = 42
    let result = identity(x)
    if result != null {
        print(result)
    }
}

@test(output = "null")
fn test_generic_nullable_identity_null() {
    let x: int? = null
    let result = identity(x)
    if result == null {
        print("null")
    }
}

// --- Generic struct with nullable field ---

@test(output = "42")
fn test_nullable_box_present() {
    let b: NullableBox<int> = NullableBox { val: 42 }
    if b.val != null {
        print(b.val)
    }
}

@test(output = "null")
fn test_nullable_box_null() {
    let b: NullableBox<int> = NullableBox { val: null }
    if b.val == null {
        print("null")
    }
}

// --- What happens when T is already nullable? ---

@test(output = "42")
fn test_nullable_box_of_nullable_present() {
    // T = int?, so val: T? = int??  -- does this flatten?
    let b: NullableBox<int?> = NullableBox { val: 42 }
    let v = b.val
    if v != null {
        print(v)
    }
}

@test(output = "null")
fn test_nullable_box_of_nullable_null() {
    let b: NullableBox<int?> = NullableBox { val: null }
    if b.val == null {
        print("null")
    }
}

// --- Vec of nullable elements ---

// --- Nullable Vec vs Vec of nullable ---

@test(output = "0")
fn test_nullable_vec_coalesce() {
    let v: [int]? = null
    let len = v?.len() ?? 0
    print(len)
}

@test(output = "3")
fn test_non_null_vec_len() {
    let v: [int]? = [1, 2, 3]
    let len = v?.len() ?? 0
    print(len)
}

// --- Generic function returning non-nullable from nullable ---

fn my_unwrap_or<T>(x: T?, fallback: T) -> T {
    if x != null {
        return x
    }
    return fallback
}

@test(output = "42")
fn test_generic_my_unwrap_or_present() {
    let x: int? = 42
    print(my_unwrap_or(x, 0))
}

@test(output = "0")
fn test_generic_my_unwrap_or_null() {
    let x: int? = null
    print(my_unwrap_or(x, 0))
}

// --- Generic nullable with struct fields ---

struct Pair<A, B> {
    first: A?,
    second: B?,
}

@test(output = "hello 42")
fn test_generic_pair_both_present() {
    let p: Pair<string, int> = Pair { first: "hello", second: 42 }
    let a = p.first ?? "none"
    let b = p.second ?? 0
    print("{a} {b}")
}

@test(output = "none 0")
fn test_generic_pair_both_null() {
    let p: Pair<string, int> = Pair { first: null, second: null }
    let a = p.first ?? "none"
    let b = p.second ?? 0
    print("{a} {b}")
}

// --- Nested generic + nullable ---

struct Wrapper<T> {
    inner: Box<T>?,
}

@test(output = "42")
fn test_nested_generic_nullable() {
    let w: Wrapper<int> = Wrapper { inner: Box { val: 42 } }
    let result = w.inner?.val ?? 0
    print(result)
}

@test(output = "0")
fn test_nested_generic_null_inner() {
    let w: Wrapper<int> = Wrapper { inner: null }
    let result = w.inner?.val ?? 0
    print(result)
}
