// Regression test for the ANF index-write evaluation-order fix.
// `arr[idx] = expr` where `expr` has a side effect that mutates `idx`
// must capture the LHS index VALUE before evaluating the RHS. Live
// emits this correctly; ANF was reading the post-mutation `idx` at
// emit time because lower_place returned a bare `Var("idx")` atom
// without binding to a fresh local.
//
// Fix: lower_place::Index now copies non-literal indices to a fresh
// local so the captured value survives the RHS side effects.
// (Inc 8h pre-req — surfaces via the unresolved-named-callee
// absorber; the lambda call goes through ANF only when the absorber
// is on.)

@test
fn test_eval_order_basic() {
    let arr = [0, 0, 0, 0, 0]
    let idx = 0
    let tricky = (val: int) => {
        arr[idx] = val + { idx += 1; idx }
    }
    tricky(100)
    // LHS captured idx=0, RHS mutates idx to 1, sum 100+1 = 101.
    assert_eq(arr[0], 101)
    assert_eq(idx, 1)
}

@test
fn test_eval_order_nested_writes() {
    let arr = [10, 20, 30]
    let i = 0
    let bump = (v: int) => {
        arr[i] = v + { i += 1; i }
    }
    bump(5)
    // arr[0] = 5 + 1 = 6
    assert_eq(arr[0], 6)
    bump(50)
    // arr[1] = 50 + 2 = 52
    assert_eq(arr[1], 52)
}
