// `clear()` while an Arena value or pair iterator is live. The decided
// contract: clear reseats
// the storage, so an existing traversal keeps seeing the pre-clear rows and
// yields all three, while the arena itself is empty afterwards. Lua and C
// both run this file.

struct Unit { hp: int }

fn three_units() -> Arena<Unit> {
    let units: Arena<Unit> = arena_new()
    units.insert(Unit { hp: 1 })
    units.insert(Unit { hp: 2 })
    units.insert(Unit { hp: 3 })
    return units
}

@test(output = "3 6 0")
fn clear_during_values() {
    let units = three_units()
    let seen = 0
    let sum = 0
    for unit in values(units) {
        if seen == 0 { units.clear() }
        seen += 1
        sum += unit.hp
    }
    print("{seen} {sum} {units.len()}")
}

@test(output = "3 9 0")
fn clear_during_pairs() {
    let units = three_units()
    let seen = 0
    let sum = 0
    for (entity, unit) in pairs(units) {
        if seen == 0 { units.clear() }
        seen += 1
        sum += unit.hp + entity._slot
    }
    print("{seen} {sum} {units.len()}")
}
