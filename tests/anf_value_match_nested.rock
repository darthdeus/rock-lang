// Bucket B coverage: value-position `match` over a non-flat value
// struct result. See `tests/anf_value_if_nested.rock` for context.

value V2 {
    x: float,
    y: float,
}

value Seg {
    a: V2,
    b: V2,
}

enum Tag {
    A,
    B,
    C,
}

@test(output = "5\n6\n7\n8")
fn test_value_match_nested() {
    let k = Tag::B
    let s: Seg = match k {
        Tag::A => { Seg { a: V2 { x: 0, y: 0 }, b: V2 { x: 0, y: 0 } } }
        Tag::B => { Seg { a: V2 { x: 5, y: 6 }, b: V2 { x: 7, y: 8 } } }
        Tag::C => { Seg { a: V2 { x: 0, y: 0 }, b: V2 { x: 0, y: 0 } } }
    }
    print("{s.a.x.floor()}")
    print("{s.a.y.floor()}")
    print("{s.b.x.floor()}")
    print("{s.b.y.floor()}")
}
