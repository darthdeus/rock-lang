// `table_copy` preserves the metatable (mirrors `deepcopy`): copying a
// metatabled table yields the same entries under the same metatable.

inline(lua) fn __test_make_metatabled() -> any = """
    return setmetatable({ a = 1, b = 2 }, { __rock_test_marker = true })
"""

inline(lua) fn __test_copy_keeps_mt(orig: any, copy: any) -> bool = """
    return copy ~= orig
        and copy.a == 1 and copy.b == 2
        and getmetatable(copy) ~= nil
        and getmetatable(copy) == getmetatable(orig)
"""

inline(lua) fn __test_copy_plain_ok(orig: any, copy: any) -> bool = """
    return copy ~= orig
        and copy.a == 1 and copy.b == 2
        and getmetatable(copy) == nil
"""

@test(output = "true")
fn table_copy_keeps_metatable() {
    let t = __test_make_metatabled()
    let c = table_copy(t)
    print(__test_copy_keeps_mt(t, c))
}

@test(output = "true")
fn table_copy_plain_table_has_no_metatable() {
    let t: any = __test_make_plain()
    let c = table_copy(t)
    print(__test_copy_plain_ok(t, c))
}

inline(lua) fn __test_make_plain() -> any = """
    return { a = 1, b = 2 }
"""
