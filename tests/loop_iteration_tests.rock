// Loop iteration tests - migrated from rock/tests/loop_tests.rs
// Tests for-in loop iteration, type assertions, and edge cases not covered in loops_comprehensive.rock

// NOTE: Rock's loop expression doesn't support assignment from loop
// This behavior differs from Rust where loops can return values
// Keeping this as a documentation of the difference

@test(output = "1\nadd\n2\nadd\n3\nskip 3\n4\nadd\n5\nskip 5\n6\nskip 3\n7\nadd\n8\nadd\n9\nskip 3\n10\n22")
fn debug_continue_multiple() {
    let sum = 0
    let i = 0

    loop {
        i = i + 1
        print(i)

        if i >= 10 {
            break
        }

        if i % 3 == 0 {
            print("skip 3")
            continue
        }

        if i % 5 == 0 {
            print("skip 5")
            continue
        }

        print("add")
        sum = sum + i
    }

    print(sum)
}

@test(output = "18")
fn continue_preserves_loop_variables() {
    let sum = 0
    let arr = [1, 2, 3, 4, 5, 6]

    // Manual indexing with a counter (1-based to match expected output)
    let index = 1
    for value in arr {
        if value % 2 == 0 {
            index = index + 1
            continue
        }
        sum = sum + index + value
        index = index + 1
    }

    print(sum)
}

// Type assertion tests for iteration
// Note: Basic vec, map, and array iteration type checks are in loops_comprehensive.rock

@test(output = "6\n3")
fn test_vec_tuple_iteration_with_indices() {
    let vec = vec_new()
    vec_push(vec, 1)
    vec_push(vec, 2)
    vec_push(vec, 3)

    let sum = 0
    let index_sum = 0

    // Tuple iteration over [T] with enumerate yields (int, T) with 0-based indices
    for (i, x) in enumerate(vec) {
        sum += x
        index_sum += i
    }

    print(sum)
    print(index_sum)
}

// Arena iteration type checking - addresses TODO in loops_comprehensive.rock
@test(output = "60", type_holes = [[0, "int"]])
fn test_arena_tuple_iteration_type_check() {
    let arena = arena_new()
    insert(arena, 10)
    insert(arena, 20)
    insert(arena, 30)

    let sum = 0

    for (entity, value) in arena {
        let value_typed: ? = value    // [0] - Should be int
        sum += value
    }

    print(sum)
}

