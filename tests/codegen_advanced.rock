// ============================================
// Array/Vec Assignment (Mutation)
// ============================================

@test(output = "1\n99\n3")
fn array_assignment_via_index() {
    let arr = [1, 2, 3]
    arr[1] = 99
    print(arr[0])
    print(arr[1])
    print(arr[2])
}

@test(output = "0\n1\n2\n10\n11\n12")
fn zero_based_indexing_comprehensive() {
    let arr = [0, 1, 2]

    // Basic indexing
    print(arr[0])
    print(arr[1])
    print(arr[2])

    // Modify via indexing
    arr[0] = 10
    arr[1] = 11
    arr[2] = 12

    print(arr[0])
    print(arr[1])
    print(arr[2])
}

@test(output = "4")
fn vec_indexing_read_write() {
    let v = [1, 2, 3]
    vec_push(v, 4)
    let last_index = vec_len(v) - 1
    print(v[last_index])
}

@test(output = "30")
fn vec_indexing_with_expressions() {
    let v = [10, 20, 30]
    let index = 1 + 1  // 2
    print(v[index])
}

// ============================================
// Array Operations
// ============================================

@test(output = "4\n40\n30")
fn array_literal_desugaring() {
    let v = [10, 20, 30]
    vec_push(v, 40)
    print(vec_len(v))
    print(vec_get(v, 3))
    print(vec_get(v, 2))
}

@test(output = "3\n20")
fn arrays_in_functions() {
    let arr = [10, 20, 30]
    print(get_array_length(arr))
    print(get_second_element(arr))
}

fn get_array_length(arr: [int]) -> int {
    return vec_len(arr)
}

fn get_second_element(arr: [int]) -> int {
    return arr[1]
}

@test(output = "3\n1\n2\n3")
fn arrays_in_functions_complex() {
    let result = create_and_process_array()
    print(vec_len(result))
    print(result[0])
    print(result[1])
    print(result[2])
}

fn create_and_process_array() -> [int] {
    let arr = [1, 2]
    vec_push(arr, 3)
    return arr
}

// ============================================
// Block Return Semantics
// ============================================

@test(output = "early")
fn nested_if_with_return_branches() {
    let result = test_nested_returns(true)
    print(result)
}

fn test_nested_returns(flag: bool) -> string {
    if flag {
        if true {
            return "early"
        }
        return "middle"
    }
    return "late"
}

@test(output = "then")
fn nested_if_with_return_in_both_branches() {
    let result = test_both_branches(true)
    print(result)
}

fn test_both_branches(condition: bool) -> string {
    if condition {
        return "then"
    } else {
        return "else"
    }
}

@test(output = "42\n5")
fn bare_expression_last() {
    let result = get_value_implicit()
    print(result)

    let computed = compute_something()
    print(computed)
}

fn get_value_implicit() -> int {
    let x = 40
    x + 2  // Implicit return
}

fn compute_something() -> int {
    let base = 3
    base + 2  // This should be implicitly returned
}

