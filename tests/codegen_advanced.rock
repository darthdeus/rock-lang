// Advanced codegen tests - migrated from rock/tests/codegen_tests.rs
// Tests critical missing functionality: compound assignments, operator overloading, array mutation

// ============================================
// Helper structures for operator overloading
// ============================================

struct FixVec2 {
    x: float,
    y: float,
}

operator +(a: FixVec2, b: FixVec2) -> FixVec2 {
    return FixVec2 { x: a.x + b.x, y: a.y + b.y }
}

operator -(a: FixVec2, b: FixVec2) -> FixVec2 {
    return FixVec2 { x: a.x - b.x, y: a.y - b.y }
}

operator *(v: FixVec2, s: float) -> FixVec2 {
    return FixVec2 { x: v.x * s, y: v.y * s }
}

operator /(v: FixVec2, s: float) -> FixVec2 {
    return FixVec2 { x: v.x / s, y: v.y / s }
}

struct Point {
    x: int,
    y: int,
}

struct Player {
    position: Point,
    health: int,
}

global global_counter: int = 100

// ============================================
// Compound Assignment Tests - Basic
// ============================================

@test(output = "15\n10\n30\n3")
fn compound_assign_basic() {
    let a = 5
    let b = 20
    let c = 6
    let d = 12

    a += 10
    print(a)

    b -= 10
    print(b)

    c *= 5
    print(c)

    d = d ./ 4
    print(d)
}

@test(output = "17")
fn compound_assign_precedence() {
    let x = 5
    x += 3 * 4  // Should be 5 + (3 * 4) = 17
    print(x)
}

// ============================================
// Compound Assignment with Struct Fields
// ============================================

@test(output = "15\n25")
fn compound_assign_with_fields() {
    let p = Point { x: 10, y: 20 }
    p.x += 5
    p.y += 5
    print(p.x)
    print(p.y)
}

@test(output = "15\n90")
fn compound_assign_with_nested_fields() {
    let player = Player {
        position: Point { x: 10, y: 20 },
        health: 100
    }

    player.position.x += 5
    player.health -= 10

    print(player.position.x)
    print(player.health)
}

@test(output = "42")
fn compound_operator_precedence() {
    let x = 10
    let y = get_value()
    x += y * 2  // Should be 10 + (16 * 2) = 42
    print(x)
}

fn get_value() -> int {
    return 16
}

// ============================================
// Compound Assignment in Control Flow
// ============================================

@test(output = "15")
fn compound_assign_in_if() {
    let x = 10
    if x > 5 {
        x += 5
    }
    print(x)
}

@test(output = "16")
fn compound_assign_in_while() {
    let x = 1
    while x < 10 {
        x *= 2
    }
    print(x)
}

@test(output = "10")
fn compound_assign_in_for() {
    let sum = 0
    for i in [1, 2, 3, 4] {
        sum += i
    }
    print(sum)
}

// ============================================
// Compound Assignment with Globals
// ============================================

@test(output = "150")
fn compound_assign_with_globals() {
    global_counter += 50
    print(global_counter)
    global_counter = 100  // Reset for other tests
}

// ============================================
// Basic Operator Overloading
// ============================================

@test(output = "FixVec2(8, 10)")
fn operator_overloading() {
    let v1 = FixVec2 { x: 3.0, y: 4.0 }
    let v2 = FixVec2 { x: 5.0, y: 6.0 }
    let result = v1 + v2
    print("FixVec2({result.x}, {result.y})")
}

@test(output = "FixVec2(8, 10)\nFixVec2(-2, -2)\nFixVec2(6, 8)\nFixVec2(1.5, 2)")
fn complex_operator_overloading() {
    let v1 = FixVec2 { x: 3.0, y: 4.0 }
    let v2 = FixVec2 { x: 5.0, y: 6.0 }

    let sum = v1 + v2
    print("FixVec2({sum.x}, {sum.y})")

    let diff = v1 - v2
    print("FixVec2({diff.x}, {diff.y})")

    let scaled = v1 * 2.0
    print("FixVec2({scaled.x}, {scaled.y})")

    let divided = v1 / 2.0
    print("FixVec2({divided.x}, {divided.y})")
}

