// Sentinel: Map[K] indexed read as let-RHS / print-arg.
// Routes through `try_emit_anf_value_into` (let-init site at
// statements.rs:1224). The ANF `lower_into` Index arm at
// rock-codegen/src/anf/lower.rs:1510 dispatches to
// `index_get_helper` (returns `__map_get_checked` for Map<K,V>),
// emitting `AnfComp::Call { Mangled("__map_get_checked"), [m, k] }`.

@test(output = "42")
fn test_map_indexed_read_let_rhs() {
    let m: Map<string, int> = map_new()
    m["k"] = 42
    let v = m["k"]
    print(v)
}

@test(output = "7")
fn test_map_indexed_read_print_arg() {
    let m: Map<string, int> = map_new()
    m["k"] = 7
    print(m["k"])
}

@test(output = "100")
fn test_map_int_key_indexed_read() {
    let m: Map<int, int> = map_new()
    m[1] = 100
    let x = m[1]
    print(x)
}
