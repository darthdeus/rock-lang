// Math tests

@test
fn test_basic_math() {
    assert_eq(1 + 1, 2)
    assert_eq(5 - 3, 2)
    assert_eq(4 * 3, 12)
    assert_eq(10 ./ 2, 5)
}

@test
fn test_order_of_operations() {
    assert_eq(2 + 3 * 4, 14)
    assert_eq((2 + 3) * 4, 20)
    assert_eq(10 - 2 * 3, 4)
}

@test
fn test_negative_numbers() {
    assert_eq(-5 + 3, -2)
    assert_eq(-5 * -5, 25)
    assert_eq(10 + -5, 5)
}

@test
fn test_modulo() {
    assert_eq(10 % 3, 1)
    assert_eq(20 % 4, 0)
    assert_eq(17 % 5, 2)
}

@test
fn test_large_numbers() {
    assert_eq(1000 * 1000, 1000000)
    assert_eq(999999 + 1, 1000000)
}