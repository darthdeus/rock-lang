// Adversarial tests: Nullable refinement soundness
// Focus: closures, control flow edges, complex patterns

// --- Refinement + closures ---

@test(output = "42")
fn test_refinement_captured_in_closure() {
    let x: int? = 42
    if x != null {
        let f = () => {
            print(x)
        }
        f()
    }
}

@test(output = "42 42 42")
fn test_refinement_in_loop_closure() {
    let x: int? = 42
    if x != null {
        let v = [1, 2, 3]
        let out = ""
        let first = true
        for item in v {
            if !first { out = out + " " }
            first = false
            out = out + "{x}"
        }
        print(out)
    }
}

// --- Refinement after divergent else ---

fn early_return_helper(x: int?) -> string {
    if x == null {
        return "was null"
    }
    // x should be refined to int here
    return "value: {x}"
}

@test(output = "value: 42")
fn test_refinement_after_divergent_else() {
    print(early_return_helper(42))
}

@test(output = "was null")
fn test_refinement_after_divergent_else_null() {
    print(early_return_helper(null))
}

// --- Refinement with early return in if ---

fn guard_return(x: int?, y: int?) -> string {
    if x == null {
        return "x null"
    }
    if y == null {
        return "y null"
    }
    // Both x and y should be refined here
    return "{x} {y}"
}

@test(output = "10 20")
fn test_double_guard_return() {
    print(guard_return(10, 20))
}

@test(output = "x null")
fn test_double_guard_x_null() {
    print(guard_return(null, 20))
}

@test(output = "y null")
fn test_double_guard_y_null() {
    print(guard_return(10, null))
}

// --- Refinement invalidation by assignment ---

@test(output = "safe")
fn test_refinement_invalidated_by_reassignment() {
    let x: int? = 42
    if x != null {
        // x is refined here
        let val = x + 1  // Should work, x is refined to int
        print("safe")
    }
}

// --- Nested if refinement ---

struct Node {
    value: int,
    next: Node?,
}

@test(output = "1 2 3")
fn test_nested_nullable_refinement() {
    let list = Node {
        value: 1,
        next: Node {
            value: 2,
            next: Node {
                value: 3,
                next: null,
            },
        },
    }
    let out = "{list.value}"
    if list.next != null {
        out = out + " {list.next.value}"
        if list.next.next != null {
            out = out + " {list.next.next.value}"
        }
    }
    print(out)
}

// --- Refinement in while loop ---

@test(output = "3 2 1")
fn test_while_refinement() {
    let vals = [3, 2, 1]
    let i = 0
    let out = ""
    let first = true
    while i < vals.len {
        if !first { out = out + " " }
        first = false
        out = out + "{vals[i]}"
        i = i + 1
    }
    print(out)
}

// --- Compound condition refinement ---

@test(output = "both present: 1 2")
fn test_compound_and_refinement() {
    let x: int? = 1
    let y: int? = 2
    if x != null && y != null {
        print("both present: {x} {y}")
    }
}

@test(output = "skipped")
fn test_compound_and_one_null() {
    let x: int? = 1
    let y: int? = null
    if x != null && y != null {
        print("both present")
    } else {
        print("skipped")
    }
}

// --- Refinement with short-circuit safety ---

@test(output = "safe: 42")
fn test_short_circuit_safe_access() {
    let x: int? = 42
    if x != null && x > 0 {
        print("safe: {x}")
    }
}

@test(output = "skipped")
fn test_short_circuit_null_skips_rhs() {
    let x: int? = null
    if x != null && x > 0 {
        print("not reached")
    } else {
        print("skipped")
    }
}

// --- Path refinement with struct fields ---

struct Container {
    item: Item?,
}

struct Item {
    name: string,
    count: int,
}

@test(output = "widget 5")
fn test_path_refinement_field() {
    let c = Container { item: Item { name: "widget", count: 5 } }
    if c.item != null {
        print("{c.item.name} {c.item.count}")
    }
}

@test(output = "empty")
fn test_path_refinement_null_field() {
    let c = Container { item: null }
    if c.item != null {
        print("not reached")
    } else {
        print("empty")
    }
}

// --- Refinement + safe navigation combination ---

@test(output = "10")
fn test_refinement_with_safenav_fallback() {
    let c: Container? = Container { item: Item { name: "x", count: 10 } }
    if c != null {
        let count = c.item?.count ?? 0
        print(count)
    }
}

// --- Refinement doesn't leak out of scope ---

fn scoped_refinement(x: int?) -> string {
    if x != null {
        let doubled = x * 2
        return "doubled: {doubled}"
    }
    // x should NOT be refined here
    return "was null"
}

@test(output = "doubled: 84")
fn test_refinement_scoped_present() {
    print(scoped_refinement(42))
}

@test(output = "was null")
fn test_refinement_scoped_null() {
    print(scoped_refinement(null))
}

// --- Triple guard pattern ---

fn triple_guard(a: int?, b: int?, c: int?) -> string {
    if a == null { return "a null" }
    if b == null { return "b null" }
    if c == null { return "c null" }
    return "{a} {b} {c}"
}

@test(output = "1 2 3")
fn test_triple_guard_all_present() {
    print(triple_guard(1, 2, 3))
}

@test(output = "b null")
fn test_triple_guard_b_null() {
    print(triple_guard(1, null, 3))
}

// --- Refinement preserved across let bindings ---

@test(output = "43")
fn test_refinement_across_let() {
    let x: int? = 42
    if x != null {
        let y = x + 1
        print(y)
    }
}

// --- Refinement with negated condition ---

@test(output = "present: 5")
fn test_negated_null_check() {
    let x: int? = 5
    if !(x == null) {
        print("present: {x}")
    }
}
