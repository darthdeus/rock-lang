// `?.0` on a nullable newtype or tuple yields the element when present and
// null when absent.

newtype UserId(int)

fn maybe_user(have: bool) -> UserId? {
    if have { UserId(42) } else { null }
}

@test(output = "42\n-1")
fn test_nullable_newtype_dot0() {
    let u = maybe_user(true)
    let v = u?.0
    print(v ?? -1)
    let none = maybe_user(false)
    let w = none?.0
    print(w ?? -1)
}

fn maybe_pair(have: bool) -> (int, string)? {
    if have { (7, "hi") } else { null }
}

@test(output = "7\n-1")
fn test_nullable_tuple_dot0() {
    let p = maybe_pair(true)
    let v = p?.0
    print(v ?? -1)
    let none = maybe_pair(false)
    let w = none?.0
    print(w ?? -1)
}
