// A null-check narrow survives exactly the effects that cannot undo it. The
// rejected shapes are in tests/errors/nullable.rock.err; these pin
// what still narrows, so the rule stays practical.

struct G { f: int? }
global g: G = G { f: 1 }

@pure fn twice(n: int) -> int { return n * 2 }
fn count() -> int { return 3 }
// A write through a call, so the test body starts with no narrow in force.
fn reset(v: int?) { g.f = v }

@test(output = "2")
fn a_pure_call_in_the_condition_keeps_a_path_narrow() {
    reset(1)
    if g.f != null && twice(1) == 2 { print(g.f + 1) }
}

@test(output = "2")
fn a_pure_call_between_check_and_use_keeps_a_path_narrow() {
    reset(1)
    if g.f != null {
        let _k = twice(2)
        print(g.f + 1)
    }
}

@test(output = "re-checked")
fn an_impure_call_forces_a_re_check() {
    reset(1)
    if g.f != null {
        let _k = count()
        if g.f != null { print("re-checked") }
    }
}

@test(output = "2 kept")
fn a_closure_assigned_local_narrows_without_a_call() {
    let x: int? = 1
    let kill = () => { x = null }
    if x != null { print("{x + 1} kept") }
    kill()
}

@test(output = "4")
fn a_closure_assigned_local_keeps_its_narrow_across_a_pure_call() {
    let x: int? = 1
    let kill = () => { x = null }
    if x != null {
        let k = twice(x)
        print(k + x + 1)
    }
    kill()
}

@test(output = "gone")
fn a_closure_assigned_local_is_re_checked_after_the_call() {
    let x: int? = 1
    let kill = () => { x = null }
    if x != null {
        kill()
        if x == null { print("gone") } else { print("still {x}") }
    }
}

@test(output = "3")
fn a_lambda_local_assigned_in_the_same_lambda_still_narrows() {
    let f = () => {
        let y: int? = 1
        y = 2
        if y != null {
            let _k = count()
            return y + 1
        }
        return 0
    }
    print(f())
}

@test(output = "5")
fn a_local_assigned_only_outside_lambdas_is_immune_to_calls() {
    let x: int? = 4
    if x != null {
        let _k = count()
        print(x + 1)
    }
    x = null
}

fn main() {}
