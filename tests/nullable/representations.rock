// Nullable value representations: ascribed values, embeds, array stores,
// enum field defaults, optional receivers, nullable value structs at `??`,
// argument and return boundaries, boxed tuple slots, and generics bound to
// `V?` that must not let SROA rematerialize an absent row.

value AscribedPair { x: int, y: int }

fn ascribed_field(x: int) -> int {
    return (AscribedPair { x: x, y: 2 } : AscribedPair?)?.x ?? -1
}

fn AscribedPair.total(self, extra: int = 3) -> int {
    return self.x + self.y + extra
}

fn ascribed_method(x: int) -> int {
    return (AscribedPair { x: x, y: 2 } : AscribedPair?)?.total() ?? -1
}

@test
fn nullable_value_ascription_preserves_constructor_type() {
    assert_eq(ascribed_field(7), 7)
    assert_eq(ascribed_method(7), 12)
}

struct Payload { n: int }

struct State { embed payload: Payload? }

fn absent() -> Payload? { return null }

fn clear_payload(s: State) { s.payload = null }

fn take(p: Payload?) -> int { if p == null { return -1 }; return p.n }

@test(output = "-1")
fn nullable_embed_clear_normalizes_dynamic_absence_before_boxed_read() {
    let s = State { payload: Payload { n: 7 } }
    s.payload = absent()
    clear_payload(s)
    print("{take(s.payload)}")
}

value OptionalArrayPoint { x: int, y: int }

struct OptionalArrayHolder { points: [OptionalArrayPoint?] }

fn optional_array_first(points: [OptionalArrayPoint?]) -> int {
    return points[0].unwrap().x
}

@test
fn c_optional_array_literal_local_store() {
    let source = [OptionalArrayPoint { x: 1, y: 2 }]
    let points: [OptionalArrayPoint?] = [source[0]]
    source[0].x = 9
    assert_eq(points.len(), 1)
    assert_eq(points[0].unwrap().x, 1)
    assert_eq(points[0].unwrap().y, 2)
}

@test
fn c_optional_array_literal_keeps_null_entries() {
    let points: [OptionalArrayPoint?] = [null, OptionalArrayPoint { x: 3, y: 4 }, null]
    assert_eq(points.len(), 3)
    assert_eq(points[0], null)
    assert_eq(points[1].unwrap().x, 3)
    assert_eq(points[2], null)
}

@test
fn c_optional_array_literal_field_store() {
    let holder = OptionalArrayHolder { points: [OptionalArrayPoint { x: 5, y: 6 }] }
    assert_eq(holder.points[0].unwrap().x, 5)
}

@test
fn c_optional_array_literal_argument_store() {
    assert_eq(optional_array_first([OptionalArrayPoint { x: 7, y: 8 }]), 7)
}

struct Canvas {
    handle: int,
    width: float,
    height: float,
}

enum Source {
    Image(int),
    Canvas(Canvas),
}

struct Draw {
    id: int,
    source: Source? = null,
}

fn source_name(source: Source?) -> string {
    if source == null { return "null" }
    return match source {
        Source::Image(_) => "image"
        Source::Canvas(_) => "canvas"
    }
}

@test(output = "1 null")
fn nullable_payload_enum_null_default_is_constructed() {
    let draw = Draw { id: 1 }
    print("{draw.id} {source_name(draw.source)}")
}

@test(output = "2 image")
fn nullable_payload_enum_value_control() {
    let draw = Draw { id: 2, source: Source::Image(7) }
    print("{draw.id} {source_name(draw.source)}")
}

@test(output = "3 null")
fn nullable_payload_enum_explicit_null_control() {
    let draw = Draw { id: 3, source: null }
    print("{draw.id} {source_name(draw.source)}")
}

value Pair { x: int, y: int }

nobox value Flat { x: int, y: int }

struct RefRow { n: int }

struct Owner { row: Row? = null, pair: Pair? = null, flat: Flat? = null }

value Row { text: string, n: int }

fn scalar_pair(present: bool) -> Pair? {
    if present { return Pair { x: 13, y: 17 } }
    return null
}

fn tuple_pair(present: bool) -> (int, int)? {
    if present { return (19, 23) }
    return null
}

fn reference_row(present: bool) -> RefRow? {
    if present { return RefRow { n: 29 } }
    return null
}

@test(output = "-1 -1 -1\n-1 -1 -1\n13 19 29\n31 41 43")
fn optional_receiver_representations_preserve_absence_and_selected_values() {
    for present in [false, true] {
        let h = Owner {}
        if present {
            h.row = Row { text: "row", n: 31 }
            h.pair = Pair { x: 37, y: 41 }
            h.flat = Flat { x: 43, y: 47 }
        }
        print("{scalar_pair(present)?.x ?? -1} {tuple_pair(present)?.0 ?? -1} {reference_row(present)?.n ?? -1}")
        print("{h.row?.n ?? -1} {h.pair?.y ?? -1} {h.flat?.x ?? -1}")
    }
}

value V2 { x: int, y: int }

fn make_v2(x: int, y: int) -> V2 {
    return V2 { x: x, y: y }
}

fn sum2(v: V2) -> int {
    return v.x + v.y
}

fn maybe_v2(on: bool) -> V2? {
    if on { return make_v2(3, 7) }
    return null
}

@test(output = "10\n300")
fn test_coalesce_lhs() {
    let v = maybe_v2(true) ?? make_v2(100, 200)
    print(sum2(v))
    let w = maybe_v2(false) ?? make_v2(100, 200)
    print(sum2(w))
}

@test(output = "3")
fn test_scalar_arg() {
    let v: V2? = make_v2(1, 2)
    if v != null {
        print(sum2(v))
    }
}

@test(output = "10")
fn test_nullable_value_return() {
    let v = maybe_v2(true)
    if v != null {
        print(sum2(v))
    } else {
        print(-1)
    }
}

// A BOXED tuple slot can be observed for nil-ness, so an absent nullable value
// element has to land there as `nil` rather than as the ctor `pack` builds
// regardless of presence. The reference-struct twin is the control.
value TupV2 { x: float, y: float }
struct TupS2 { x: float, y: float }

fn tup_value_absent(m: Map<int, TupV2>, k: int) -> bool {
    let t = (m.get(k), 1)
    return t.0 == null
}

fn tup_struct_absent(m: Map<int, TupS2>, k: int) -> bool {
    let t = (m.get(k), 1)
    return t.0 == null
}

@test
fn an_absent_value_in_a_boxed_tuple_reads_as_absent() {
    let mv: Map<int, TupV2> = map_new()
    mv[1] = TupV2 { x: 1.0, y: 2.0 }
    assert(!tup_value_absent(mv, 1))
    assert(tup_value_absent(mv, 9))

    let ms: Map<int, TupS2> = map_new()
    ms[1] = TupS2 { x: 1.0, y: 2.0 }
    assert(!tup_struct_absent(ms, 1))
    assert(tup_struct_absent(ms, 9))
}

@test(output = "7 1 3 5")
fn a_present_value_in_a_boxed_tuple_round_trips() {
    let m: Map<int, TupV2> = map_new()
    m[1] = TupV2 { x: 7.0, y: 2.0 }
    let t = (m.get(1), 1)
    let plain = (TupV2 { x: 3.0, y: 4.0 }, 5)
    print("{t.0.unwrap().x} {t.1} {plain.0.x} {plain.1}")
}

value BV2 { x: float, y: float }

fn first<T>(a: [T], i: int) -> T { let v = a[i]  return v }

@test(output = "true 1")
fn a_generic_bound_to_a_nullable_value_keeps_its_absent_row() {
    let a: [BV2?] = [BV2 { x: 1.0, y: 1.0 }, null, BV2 { x: 2.0, y: 2.0 }]
    print("{first(a, 1) == null} {first(a, 0)?.x ?? -1.0}")
}

@test(output = "3")
fn iterating_an_absent_row_works() {
    let a: [BV2?] = [BV2 { x: 1.0, y: 1.0 }, null, BV2 { x: 2.0, y: 2.0 }]
    let t = 0.0
    for v in a { if v != null { t = t + v.x } }
    print("{t as int}")
}

@test(output = "true true true 3")
fn indexed_reads_are_correct() {
    let a: [BV2?] = [BV2 { x: 1.0, y: 1.0 }, null, BV2 { x: 2.0, y: 2.0 }]
    print("{a[1] == null} {a.get(1) == null} {a[2] != null} {a.count()}")
}

fn pick(a: [BV2?], i: int) -> (bool, BV2?) { let v = a[i]  return (true, v) }

@test(output = "true true")
fn the_non_generic_twin_is_correct() {
    let a: [BV2?] = [BV2 { x: 1.0, y: 1.0 }, null]
    let (ok, v) = pick(a, 1)
    print("{ok} {v == null}")
}

value Inner { x: float }
value Outer { inner: Inner?, a: float }
enum Part { One(Outer) }
global FLAG: bool = true

fn sink(p: Part) -> string {
    match p { Part::One(o) => return "{o.inner?.x ?? -1.0} {o.a}" }
}

@test(output = "-1 8")
fn an_sroa_field_cell_that_can_be_absent_is_not_licensed_to_rematerialize() {
    let o = Outer { inner: Inner { x: 3.0 }, a: 4.0 }
    if FLAG { o = Outer { inner: null, a: 5.0 } }
    print("{sink(Part::One(Outer { ..o, a: 8.0 }))}")
}
