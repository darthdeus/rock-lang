// Coalescing nullable values: map values and value struct literal fields.

@test(output = "5\n0\n0\n42\nhello\n\n3.14\nfalse\ntrue\ntrue")
fn coalesce_keeps_present_values_including_falsy_ones() {
    let present: int? = 5
    let absent: int? = null
    let zero: int? = 0
    print(present ?? 0)
    print(absent ?? 0)
    print(zero ?? 42)
    print(absent ?? 42)
    let no_string: string? = null
    let empty: string? = ""
    print(no_string ?? "hello")
    print(empty ?? "default")
    let no_float: float? = null
    print(no_float ?? 3.14)
    let falsy: bool? = false
    let no_bool: bool? = null
    let truthy: bool? = true
    print(falsy ?? true)
    print(no_bool ?? true)
    print(truthy ?? false)
}

@test(output = "10")
fn coalesce_nullable_nullable() {
    let a: int? = null
    let b: int? = 10
    let result: int? = a ?? b
    print(result ?? -1)
}

@test(output = "false\ntrue\n0\n99\n3")
fn coalesce_chains() {
    let a: bool? = null
    let b: bool? = false
    let c: bool? = null
    print(a ?? b ?? true)
    print(a ?? c ?? true)
    let n1: int? = null
    let n2: int? = 0
    let n3: int? = null
    let n4: int? = null
    let n5: int? = null
    let n6: int? = null
    let three: int? = 3
    print(n1 ?? n2 ?? 99)
    print(n1 ?? n3 ?? n4 ?? n5 ?? n6 ?? 99)
    print(n1 ?? n3 ?? three ?? n4 ?? n5 ?? 99)
}

global side_effect_count: int = 0

fn side_effect_int() -> int {
    side_effect_count = side_effect_count + 1
    return 999
}

@test(output = "42 0\n999 1")
fn coalesce_evaluates_rhs_only_when_null() {
    side_effect_count = 0
    let x: int? = 42
    let kept = x ?? side_effect_int()
    print("{kept} {side_effect_count}")
    let y: int? = null
    let fallback = y ?? side_effect_int()
    print("{fallback} {side_effect_count}")
}

@test(output = "3\nhello world\n5")
fn coalesce_in_expression_positions() {
    let x: int? = null
    print((x ?? 1) + 2)
    let name: string? = null
    print("{name ?? "hello"} world")
    let arr: [int] = []
    arr.push(x ?? 5)
    print(arr[0])
}

// Controls for the nullable coalesce join: scalar and boxed value payloads
value BoxedPair { x: int, y: int }

fn maybe_int(present: bool) -> int? {
    if present { return 11 }
    return null
}

fn maybe_boxed_pair(present: bool) -> BoxedPair? {
    if present { return BoxedPair { x: 2, y: 4 } }
    return null
}

@test(output = "11")
fn scalar_payload_control() {
    let value = maybe_int(false) ?? if let inner = maybe_int(true) { inner } else { null }
    if value != null { print(value) } else { print("null") }
}

@test(output = "2 4")
fn boxed_value_payload_control() {
    let value = maybe_boxed_pair(false) ?? if let inner = maybe_boxed_pair(true) { inner } else { null }
    if value != null {
        print("{value.x} {value.y}")
    } else {
        print("null")
    }
}

// Precedence: `??` must bind TIGHTER than assignment.
//
// It did not: `rock-tokenizer`'s infix_bp put DoubleQuestionMark at 3 and
// Assign at 5, so `x = a ?? b` parsed as `(x = a) ?? b` -- the assignment
// became the left operand of the coalesce. Every assignment form was hit
// (global, local, field, index, compound), and `??` was the only operator
// affected: `x = a + b` and `x = a || b` were always fine.
//
// The guards at the bottom pin the other side, so raising the level cannot
// silently drag `??` above the operators it must stay below.

global CO_G: int = 0

fn co_some() -> int? { return 5 }

fn co_none() -> int? { return null }

struct CoS { v: int }

@test
fn coalesce_binds_tighter_than_every_assignment_form() {
    CO_G = co_some() ?? 0
    assert_eq(CO_G, 5)
    CO_G = co_none() ?? 7
    assert_eq(CO_G, 7)

    let x = 0
    x = co_some() ?? 0
    assert_eq(x, 5)
    x = co_none() ?? 7
    assert_eq(x, 7)

    let s = CoS { v: 0 }
    s.v = co_some() ?? 0
    assert_eq(s.v, 5)

    let a = [1, 2]
    a[0] = co_some() ?? 0
    assert_eq(a[0], 5)

    CO_G = 1
    CO_G += co_some() ?? 0
    assert_eq(CO_G, 6)
}

@test
fn coalesce_chain_over_assign() {
    CO_G = co_none() ?? co_some() ?? 0
    assert_eq(CO_G, 5)

    CO_G = co_none() ?? co_none() ?? 9
    assert_eq(CO_G, 9)
}

// --- Guards: the level must not go too far the other way. ---

@test
fn coalesce_stays_below_arithmetic() {
    // `a ?? 1 + 2` is `a ?? (1 + 2)`, not `(a ?? 1) + 2`. Both would read 3
    // when a is null, so the discriminating case is a NON-null left: if the
    // grouping were wrong this would be 7.
    CO_G = co_some() ?? 1 + 2
    assert_eq(CO_G, 5)
}

fn co_none_b() -> bool? { return null }

@test
fn coalesce_stays_below_comparison() {
    // `a ?? 1 == 2` groups as `a ?? (1 == 2)` -- C# semantics, `??` sits
    // below `==`. This only typechecks under that grouping: the tighter
    // reading would be `(bool? ?? 1) == 2`, a bool-vs-int mismatch, so the
    // test cannot pass for the wrong reason.
    let miss = co_none_b() ?? 1 == 2
    assert_eq(miss, false)

    let hit = co_none_b() ?? 2 == 2
    assert_eq(hit, true)
}

value CoalescePoint { a: int, b: int }

value CoalesceLabel { a: int, label: string }

@test(output = "15\n23\ntrue\n31")
fn nullable_map_coalesce_preserves_values_and_absence() {
    let points: Map<string, CoalescePoint?> = map_new()
    points["present"] = CoalescePoint { a: 7, b: 8 }
    points["absent"] = null
    let present = points.get("present") ?? CoalescePoint { a: 0, b: 0 }
    let absent = points.get("absent") ?? CoalescePoint { a: 11, b: 12 }
    print(present.a + present.b)
    print(absent.a + absent.b)
    print(points.get("absent") == null)
    let missing = points.get("missing") ?? CoalescePoint { a: 15, b: 16 }
    print(missing.a + missing.b)
}

@test(output = "7:x\n11:fallback\ntrue")
fn nullable_gc_map_coalesce_preserves_values_and_absence() {
    let labels: Map<string, CoalesceLabel?> = map_new()
    labels["present"] = CoalesceLabel { a: 7, label: "x" }
    labels["absent"] = null
    let present = labels.get("present") ?? CoalesceLabel { a: 0, label: "wrong" }
    let absent = labels.get("absent") ?? CoalesceLabel { a: 11, label: "fallback" }
    print("{present.a}:{present.label}")
    print("{absent.a}:{absent.label}")
    print(labels.get("absent") == null)
}

struct InlineThing { at: Vec2 = v(0, 0) }

@test(output = "7 8")
fn coalesce_into_value_struct_literal_field_is_correct() {
    let fallback: Vec2? = null
    let t = InlineThing { at: fallback ?? v(7, 8) }
    print("{t.at.x as int} {t.at.y as int}")
}

fn make_thing(fallback: Vec2?) -> InlineThing? {
    return InlineThing { at: fallback ?? return null }
}

@test(output = "13 17\ntrue")
fn a_diverging_coalesce_arm_does_not_build_the_parent_from_nil_leaves() {
    let t = make_thing(v(13, 17)).unwrap()
    print("{t.at.x as int} {t.at.y as int}")
    print("{make_thing(null) == null}")
}

@test(output = "7 8")
fn hoisting_the_coalesce_into_a_let_is_correct() {
    let fallback: Vec2? = null
    let launch = fallback ?? v(7, 8)
    let t = InlineThing { at: launch }
    print("{t.at.x as int} {t.at.y as int}")
}

struct Boxed { a: int, b: int }

struct BoxedThing { at: Boxed = Boxed { a: 0, b: 0 } }

@test(output = "7 8")
fn a_boxed_struct_through_the_same_coalesce_is_correct() {
    let fallback: Boxed? = null
    let t = BoxedThing { at: fallback ?? Boxed { a: 7, b: 8 } }
    print("{t.at.a} {t.at.b}")
}

struct ScalarThing { n: int = 0 }

@test(output = "7")
fn a_scalar_through_the_same_coalesce_is_correct() {
    let fallback: int? = null
    let t = ScalarThing { n: fallback ?? 7 }
    print("{t.n}")
}
