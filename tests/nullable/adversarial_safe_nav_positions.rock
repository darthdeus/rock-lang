// Adversarial tests: Safe navigation in unexpected expression positions

struct FixVec2 {
    x: float,
    y: float,
}

struct Player {
    name: string,
    pos: FixVec2,
    health: int,
}

struct World {
    player: Player?,
    boss: Player?,
}

fn make_world() -> World {
    return World {
        player: Player { name: "Hero", pos: FixVec2 { x: 1.0, y: 2.0 }, health: 100 },
        boss: Player { name: "Dragon", pos: FixVec2 { x: 5.0, y: 6.0 }, health: 500 },
    }
}

fn make_empty_world() -> World {
    return World { player: null, boss: null }
}

// Each test runs the same expression against a full world `w` and an empty
// world `e`.

fn show_int(x: int) {
    print(x)
}

fn count_present(names: [string?]) -> int {
    let count = 0
    for n in names {
        if n != null {
            count = count + 1
        }
    }
    return count
}

@test(output = "100\n0")
fn test_safenav_as_arg() {
    let w = make_world()
    show_int(w.player?.health ?? 0)
    let e = make_empty_world()
    show_int(e.player?.health ?? 0)
}

@test(output = "2\n0")
fn test_safenav_in_array() {
    let w = make_world()
    let names: [string?] = [w.player?.name, w.boss?.name]
    print(count_present(names))
    let e = make_empty_world()
    let empty_names: [string?] = [e.player?.name, e.boss?.name]
    print(count_present(empty_names))
}

@test(output = "3\n0")
fn test_safenav_in_addition() {
    let w = make_world()
    print((w.player?.pos?.x ?? 0.0) + (w.player?.pos?.y ?? 0.0))
    let e = make_empty_world()
    print((e.player?.pos?.x ?? 0.0) + (e.player?.pos?.y ?? 0.0))
}

fn maybe_player() -> Player? {
    return Player { name: "Test", pos: FixVec2 { x: 0.0, y: 0.0 }, health: 50 }
}

fn no_player() -> Player? {
    return null
}

@test(output = "Test\nnone")
fn test_safenav_on_fn_result() {
    print(maybe_player()?.name ?? "none")
    print(no_player()?.name ?? "none")
}

@test(output = "Hero\nnone")
fn test_let_safenav_via_var() {
    let p = make_world().player
    print(p?.let { p.name } ?? "none")
    let q = make_empty_world().player
    print(q?.let { "something" } ?? "none")
}

// --- ?. with method calls (UFCS) ---

fn health_status(p: Player) -> string {
    if p.health > 50 {
        return "healthy"
    }
    return "wounded"
}

// Path refinement strips nullable for function args after null check
@test(output = "healthy")
fn test_safenav_ufcs() {
    let w = make_world()
    if w.player != null {
        print(health_status(w.player))
    }
}

// Also works with local variable (original workaround)
@test(output = "healthy")
fn test_safenav_ufcs_via_var() {
    let w = make_world()
    let p = w.player
    if p != null {
        print(health_status(p))
    }
}

// --- ?. chained deep (4 levels) ---

struct A {
    b: B?,
}
struct B {
    c: C?,
}
struct C {
    d: D?,
}
struct D {
    value: int,
}

@test(output = "42\n0\n0\n0")
fn test_4_level_safenav() {
    let full = A { b: B { c: C { d: D { value: 42 } } } }
    print(full.b?.c?.d?.value ?? 0)
    let null_b = A { b: null }
    print(null_b.b?.c?.d?.value ?? 0)
    let null_c = A { b: B { c: null } }
    print(null_c.b?.c?.d?.value ?? 0)
    let null_d = A { b: B { c: C { d: null } } }
    print(null_d.b?.c?.d?.value ?? 0)
}

@test(output = "true\nfalse")
fn test_safenav_in_comparison() {
    let w = make_world()
    let alive = (w.player?.health ?? 0) > 0
    print(alive)
    let e = make_empty_world()
    let empty_alive = (e.player?.health ?? 0) > 0
    print(empty_alive)
}

@test(output = "Hero has 100 hp\nunknown has 0 hp")
fn test_safenav_interpolation_via_var() {
    let w = make_world()
    let name = w.player?.name ?? "unknown"
    let hp = w.player?.health ?? 0
    print("{name} has {hp} hp")
    let e = make_empty_world()
    let empty_name = e.player?.name ?? "unknown"
    let empty_hp = e.player?.health ?? 0
    print("{empty_name} has {empty_hp} hp")
}
