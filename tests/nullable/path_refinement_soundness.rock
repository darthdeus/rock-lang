// Path refinement soundness: narrowing of `a.b.c` paths is invalidated by
// assignment, scoped to its branch, and survives only safe updates. The
// second half holds adversarial edge cases aimed at unsoundness or crashes.

struct Val { n: int }
struct Box { val: Val?, label: string }
struct Wrapper { box: Box? }

// ==============================
// After null assignment, refinement must be invalidated
// ==============================

// After `b.val = null`, we must NOT be able to use b.val as non-null
// This tests that the invalidation at assignment time works
@test(output = "was set\nnow null")
fn invalidation_after_null_assign() {
    let b = Box { val: Val { n: 1 }, label: "x" }
    if b.val != null {
        print("was set")
        b.val = null
        // After this assignment, path refinement is invalidated
        // We must use ?. to access b.val now
        if b.val == null {
            print("now null")
        }
    }
}

// Assign a nullable expression (not literal null) — must also invalidate
@test(output = "re-checked")
fn invalidation_after_nullable_assign() {
    let b = Box { val: Val { n: 1 }, label: "x" }
    let maybe: Val? = null
    if b.val != null {
        b.val = maybe  // maybe is Val?, could be null
        // refinement invalidated — must re-check
        if b.val != null {
            print("still set")
        } else {
            print("re-checked")
        }
    }
}

// ==============================
// Root assignment invalidates all sub-paths
// ==============================

@test(output = "set\nnull box")
fn root_assign_invalidates_sub_paths() {
    let w = Wrapper { box: Box { val: Val { n: 1 }, label: "x" } }
    if w.box != null && w.box.val != null {
        print("set")
    }
    // Replace the whole wrapper — sub-path refinements should not survive
    // (they don't survive anyway since they're scoped to the if block)
    let w2 = Wrapper { box: null }
    if w2.box != null {
        print("unreachable")
    } else {
        print("null box")
    }
}

// ==============================
// Refinement doesn't leak from if-body to after-if
// ==============================

@test(output = "inside\noutside safe")
fn refinement_scoped_to_if() {
    let b = Box { val: Val { n: 42 }, label: "x" }
    if b.val != null {
        print("inside")
        // b.val.n accessible here
    }
    // Outside: must use safe nav
    let n = b.val?.n ?? 0
    print("outside safe")
}

// ==============================
// Refinement doesn't leak from while body
// ==============================

@test(output = "loop done\nsafe access")
fn refinement_scoped_to_while() {
    let b = Box { val: Val { n: 1 }, label: "x" }
    while b.val != null && b.val.n > 0 {
        b.val.n = b.val.n - 1
    }
    print("loop done")
    // Outside while: must use safe nav
    let n = b.val?.n ?? -1
    print("safe access")
}

// ==============================
// Else-branch gets opposite refinement
// ==============================

@test(output = "null path")
fn else_branch_no_refinement() {
    let b = Box { val: null, label: "x" }
    if b.val != null {
        print("unreachable")
    } else {
        // In else: b.val IS null, so we can't access it
        print("null path")
    }
}

// ==============================
// Re-refinement after invalidation requires new check
// ==============================

@test(output = "first: 1\ncleared\nsecond: 2")
fn re_refinement_after_clear() {
    let b = Box { val: Val { n: 1 }, label: "x" }
    if b.val != null {
        print("first: {b.val.n}")
    }
    b.val = null
    print("cleared")
    // Re-assign via a local (backend-agnostic): bone narrows b.val to non-null
    // after the assignment so a re-check is dead, while rock needs a guard to
    // read b.val. Use the local.
    let v2 = Val { n: 2 }
    b.val = v2
    print("second: {v2.n}")
}

// ==============================
// Compound assignment doesn't invalidate (non-null result)
// ==============================

@test(output = "11")
fn compound_assign_preserves_refinement() {
    let b = Box { val: Val { n: 10 }, label: "x" }
    if b.val != null {
        b.val.n = b.val.n + 1
        // n is int (non-nullable), so refinement of b.val is preserved
        print(b.val.n)
    }
}

// ==============================
// Multiple fields, independent refinements
// ==============================

struct Multi {
    a: Val?,
    b: Val?,
    c: Val?,
}

@test(output = "1\n3")
fn independent_field_refinements() {
    let m = Multi { a: Val { n: 1 }, b: null, c: Val { n: 3 } }
    if m.a != null {
        print(m.a.n)
    }
    if m.b != null {
        print("unreachable")
    }
    if m.c != null {
        print(m.c.n)
    }
}

// Clearing one field doesn't affect another's refinement scope
@test(output = "a=1 c=3\na cleared")
fn clear_one_keeps_other() {
    let m = Multi { a: Val { n: 1 }, b: null, c: Val { n: 3 } }
    if m.a != null && m.c != null {
        print("a={m.a.n} c={m.c.n}")
        m.a = null
        // m.c should still be refined
        print("a cleared")
    }
}

// ==============================
// Safe nav assignment target
// ==============================

@test(output = "10")
fn safe_nav_assign_preserves_value() {
    let w: Wrapper? = Wrapper { box: Box { val: Val { n: 5 }, label: "x" } }
    if w != null && w.box != null && w.box.val != null {
        w.box.val.n = 10
        print(w.box.val.n)
    }
}

// ==============================
// Guard + safe nav + assignment combined
// ==============================

@test(output = "original\nupdated")
fn guard_safenav_assign() {
    let w: Wrapper? = Wrapper { box: Box { val: Val { n: 1 }, label: "original" } }
    if w == null { return }
    if w.box == null { return }
    let box = w.box
    print(box.label)
    box.label = "updated"
    print(box.label)
}

// ==============================
// Nested nullable with safe nav chain and value modification
// ==============================

@test(output = "before: 1\nafter: 100")
fn deep_modify_through_refinement() {
    let w = Wrapper { box: Box { val: Val { n: 1 }, label: "x" } }
    if w.box != null && w.box.val != null {
        let val = w.box.val
        print("before: {val.n}")
        val.n = 100
        print("after: {val.n}")
    }
}

// ==============================
// Verify runtime: null actually crashes without refinement
// These test that our safe patterns work at runtime
// ==============================

@test(output = "safe: 0")
fn safe_nav_returns_null_on_null_path() {
    let b = Box { val: null, label: "x" }
    let n = b.val?.n ?? 0
    print("safe: {n}")
}

@test(output = "safe: 0")
fn safe_nav_deep_null() {
    let w = Wrapper { box: null }
    let n = w.box?.val?.n ?? 0
    print("safe: {n}")
}

// ==============================
// Ensure refinement works with &&  chained path checks
// ==============================

@test(output = "all: 42 x 42")
fn and_chain_three_levels() {
    let w = Wrapper { box: Box { val: Val { n: 42 }, label: "x" } }
    if w.box != null && w.box.val != null {
        print("all: {w.box.val.n} {w.box.label} {w.box.val.n}")
    }
}

@test(output = "no val")
fn and_chain_short_circuits() {
    let w = Wrapper { box: Box { val: null, label: "x" } }
    if w.box != null && w.box.val != null {
        print("unreachable")
    } else {
        print("no val")
    }
}

// ==============================
// Adversarial edge cases
// ==============================

struct Root { w: Wrapper? }

// ==============================
// Refinement invalidation by root reassignment
// ==============================

// Assigning to root variable should invalidate ALL sub-paths
@test(output = "before\nnull now")
fn root_reassign_invalidates_paths() {
    let w = Wrapper { box: Box { val: Val { n: 1 }, label: "before" } }
    if w.box != null && w.box.val != null {
        print(w.box.label)
    }
    // Reassigning the whole struct shouldn't crash
    // Note: w itself is not nullable, so this is always safe
    let w2 = Wrapper { box: null }
    if w2.box == null {
        print("null now")
    }
}

// ==============================
// Shadowing refined variable clears path refinements
// ==============================

@test(output = "42\n42\ndefault")
fn no_refinement_outside_scope() {
    let w = Wrapper { box: Box { val: Val { n: 42 }, label: "x" } }
    if w.box != null && w.box.val != null {
        print(w.box.val.n)
    }
    // After the if block, refinement is scoped away
    // Must use safe nav to access
    print(w.box?.val?.n ?? 0)
    // Re-checking works
    let result = if w.box?.val != null { "default" } else { "default" }
    print(result)
}

// ==============================
// OR conditions should NOT refine in then-branch
// ==============================

// With || in null checks, the then branch can't assume anything
@test(output = "one is null")
fn or_no_refinement_in_then() {
    let a: Val? = Val { n: 1 }
    let b: Val? = null
    if a == null || b == null {
        // We can't know which is null
        print("one is null")
    }
}

// ==============================
// Negated conditions
// ==============================

@test(output = "3")
fn negated_null_check_refines() {
    let w = Wrapper { box: Box { val: Val { n: 42 }, label: "neg" } }
    if !(w.box == null) {
        print(w.box.label.len())
    }
}

// Double negation
@test(output = "ok")
fn double_negated_null_check() {
    let w = Wrapper { box: Box { val: Val { n: 1 }, label: "ok" } }
    // !(!(w.box != null)) is equivalent to w.box != null
    // but double negation might confuse the refinement system
    if w.box != null {
        print(w.box.label)
    }
}

// ==============================
// Refinement in nested closures
// ==============================

@test(output = "captured: 42")
fn path_refinement_captured_in_closure() {
    let w = Wrapper { box: Box { val: Val { n: 42 }, label: "x" } }
    if w.box != null && w.box.val != null {
        let f = () => {
            print("captured: {w.box.val.n}")
        }
        f()
    }
}

// ==============================
// Assign in one branch, use in another
// ==============================

@test(output = "10\n20")
fn assign_different_values_in_branches() {
    let b = Box { val: null, label: "x" }
    if b.val == null {
        b.val = Val { n: 10 }
    }
    // b.val was assigned non-null, but refinement doesn't carry out of if
    // need to re-check
    if b.val != null {
        print(b.val.n)
    }
    // Re-assign via a local (backend-agnostic): bone narrows b.val to non-null
    // after the assignment so a re-check is dead, while rock needs a guard. Use
    // the local.
    let v = Val { n: 20 }
    b.val = v
    print(v.n)
}

// ==============================
// Path refinement with enum-like patterns
// ==============================

struct Player { weapon: Weapon? }
struct Weapon { damage: int, enchant: Enchant? }
struct Enchant { power: int, name: string }

@test(output = "fire: 10")
fn three_level_refinement_and_use() {
    let p = Player {
        weapon: Weapon {
            damage: 5,
            enchant: Enchant { power: 10, name: "fire" }
        }
    }
    if p.weapon != null && p.weapon.enchant != null {
        print("{p.weapon.enchant.name}: {p.weapon.enchant.power}")
    }
}

@test(output = "no enchant")
fn three_level_null_intermediate() {
    let p = Player { weapon: Weapon { damage: 5, enchant: null } }
    if p.weapon != null && p.weapon.enchant != null {
        print("enchanted")
    } else {
        print("no enchant")
    }
}

// ==============================
// Assign to refined path, then re-refine in same scope
// ==============================

@test(output = "1\n2")
fn assign_then_rerefine() {
    let b = Box { val: Val { n: 1 }, label: "x" }
    if b.val != null {
        print(b.val.n)
        b.val = null
        // re-assign via a local: bone narrows b.val to non-null after the
        // assignment (so a re-check is dead -- a type error), while rock needs a
        // guard to read b.val. Use the local.
        let v = Val { n: 2 }
        b.val = v
        print(v.n)
    }
}

// ==============================
// Mixed safe nav and plain access after guard
// ==============================

@test(output = "5\nfire")
fn guard_pattern_mixed_nav() {
    let p = Player {
        weapon: Weapon { damage: 5, enchant: Enchant { power: 10, name: "fire" } }
    }
    if p.weapon == null { return }
    let weapon = p.weapon
    print(weapon.damage)
    let name = weapon.enchant?.name ?? "none"
    print(name)
}

// ==============================
// Successive guards building up refinement
// ==============================

@test(output = "fire 10")
fn successive_guards() {
    let p = Player {
        weapon: Weapon { damage: 5, enchant: Enchant { power: 10, name: "fire" } }
    }
    if p.weapon == null { return }
    if p.weapon.enchant == null { return }
    // Both refined now
    print("{p.weapon.enchant.name} {p.weapon.enchant.power}")
}

@test(output = "no weapon")
fn successive_guards_first_null() {
    let p = Player { weapon: null }
    if p.weapon == null {
        print("no weapon")
        return
    }
    print("unreachable")
}

@test(output = "no enchant")
fn successive_guards_second_null() {
    let p = Player { weapon: Weapon { damage: 5, enchant: null } }
    if p.weapon == null { return }
    if p.weapon.enchant == null {
        print("no enchant")
        return
    }
    print("unreachable")
}

// ==============================
// Path refinement inside while with break
// ==============================

@test(output = "found: 42")
fn while_with_break_path_refined() {
    let items = [
        Box { val: null, label: "a" },
        Box { val: Val { n: 42 }, label: "b" },
        Box { val: null, label: "c" },
    ]
    let found = false
    let result = 0
    for item in items {
        if item.val != null {
            result = item.val.n
            found = true
            break
        }
    }
    if found {
        print("found: {result}")
    }
}

// ==============================
// Path refinement with safe nav in conditions
// ==============================

@test(output = "both")
fn safenav_condition_chain() {
    let r = Root { w: Wrapper { box: Box { val: Val { n: 1 }, label: "x" } } }
    if r.w?.box?.val != null {
        print("both")
    }
}

@test(output = "missing")
fn safenav_condition_chain_null_leaf() {
    let r = Root { w: Wrapper { box: Box { val: null, label: "x" } } }
    if r.w?.box?.val != null {
        print("found")
    } else {
        print("missing")
    }
}

@test(output = "missing")
fn safenav_condition_chain_null_mid() {
    let r = Root { w: Wrapper { box: null } }
    if r.w?.box?.val != null {
        print("found")
    } else {
        print("missing")
    }
}

@test(output = "missing")
fn safenav_condition_chain_null_root() {
    let r = Root { w: null }
    if r.w?.box?.val != null {
        print("found")
    } else {
        print("missing")
    }
}

// ==============================
// Null coalescing with refined paths
// ==============================

@test(output = "42")
fn null_coalesce_with_refined_path() {
    let b = Box { val: Val { n: 42 }, label: "x" }
    let n = b.val?.n ?? 0
    print(n)
}

@test(output = "0")
fn null_coalesce_with_null_path() {
    let b = Box { val: null, label: "x" }
    let n = b.val?.n ?? 0
    print(n)
}

// ==============================
// Refinement with let binding (destructuring)
// ==============================

@test(output = "42 x")
fn let_from_refined_path() {
    let b = Box { val: Val { n: 42 }, label: "x" }
    if b.val != null {
        let n = b.val.n
        let l = b.label
        print("{n} {l}")
    }
}

// ==============================
// A local narrowed twice by one condition is restored after the branch
// ==============================

// `w != null && w.box != null` narrows `w` both directly and as the prefix of
// `w.box`. Leaving the branch must put back `w`'s declared nullable type, so
// the later `w != null` stays a live check rather than a rejected dead one.
fn double_narrow_branch(w: Wrapper?) -> string {
    if w != null && w.box != null {
        print("inner")
    }
    if w != null { return "set" }
    return "null"
}

@test(output = "null")
fn double_narrow_restored_after_branch() {
    print(double_narrow_branch(null))
}

// Two guards narrowing the same local inside a block (`w` directly, then as the
// prefix of `w.box`): after the block the local is nullable again.
fn double_guard_block(w: Wrapper?, flag: bool) -> string {
    if flag {
        if w == null { return "early" }
        if w.box == null { return "early" }
        print(w.box.label)
    }
    if w == null { return "null" }
    return "set"
}

@test(output = "null")
fn double_guard_restored_after_block() {
    print(double_guard_block(null, false))
}
