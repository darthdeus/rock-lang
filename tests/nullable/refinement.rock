// Nullable refinement of local bindings: `if x != null` smart-casts `x` in
// the branch. The second half holds adversarial cases around closures,
// reassignment and control-flow edges.

// ============================================
// Helper structures and functions
// ============================================

struct Item {
    file: string,
    last_modified: int,
}

fn file_modtime(_p: string) -> int? {
    return 5
}

// ============================================
// Basic Nullable Refinement Tests
// ============================================

@test(output = "4")
fn basic_if_nullable() {
    let x: int? = 3
    
    if x != null {
        let y = x + 1   // x is refined to int here
        print(y)
    }
    
    x = null  // outer x is still int?
}

@test(output = "4")
fn if_else_nullable_then() {
    let x: int? = 3
    if x != null {
        let y = x + 1   // x is int in then branch
        print(y)
    } else {
        let y = x       // x is int? in else branch (never executed)
        print("null")
    }
    
    x = null  // outer x is still int?
}

@test(output = "4")
fn if_else_nullable_else() {
    let x: int? = 3
    if x == null {
        let y = x       // x is int? in then branch (never executed)
        print("null")
    } else {
        let y = x + 1   // x is int in else branch
        print(y)
    }
    
    x = null  // outer x is still int?
}

// ============================================
// Nested Refinement Tests
// ============================================

@test(output = "updated 5", type_holes = [[0, "int"]])
fn nullable_refine_nested_else() {
    let item = Item{ file: "foo", last_modified: 0 }
    let last_modified = file_modtime(item.file)
    
    if last_modified == null {
        print("not found")
    } else {
        // Verify that `last_modified` is refined from `int?` to `int`
        let refined_last_modified: ? = last_modified
        
        if last_modified > item.last_modified {
            item.last_modified = last_modified   // assign requires int
            print("updated {last_modified}")
        }
    }
}

@test(output = "11", type_holes = [[0, "int"], [1, "int"], [2, "int"]])
fn double_refinement_chain() {
    let x: int? = 10
    
    if x != null {          // x : int in this branch
        let x_refined_once: ? = x  // [0]
        if x > 5 {          // still int
            let x_refined_twice: ? = x  // [1]
            print(x + 1)
        }
    }
    
    let x_reverted: ? = x  // [2] - should revert to int? after scope
    x = null  // outer x is still int?
}

// ============================================
// Complex Refinement Scenarios
// ============================================

@test(output = "5\n10", type_holes = [[0, "int"], [1, "int"]])
fn refinement_with_multiple_variables() {
    let a: int? = 5
    let b: int? = 10
    
    if a != null && b != null {
        // Both a and b are refined to int here
        let a_refined: ? = a  // [0]
        let b_refined: ? = b  // [1]
        print(a)
        print(b)
    }
}

@test(output = "15", type_holes = [[0, "int"]])
fn refinement_in_nested_scopes() {
    let x: int? = 10
    
    if x != null {
        let x_refined: ? = x  // [0]
        let y = x + 5  // x is refined to int
        print(y)
    }
}

@test(output = "safe: 42")
fn refinement_with_string_interpolation() {
    let value: int? = 42
    
    if value != null {
        print("safe: {value}")  // value is refined to int
    } else {
        print("null value")
    }
}

// ============================================
// Refinement with Different Operators
// ============================================

@test(output = "not null")
fn refinement_with_is_null() {
    let x: int? = 5
    
    if !is_null(x) {
        print("not null")  // x is refined to int
    } else {
        print("is null")
    }
}

@test(output = "value is 7")
fn refinement_with_negated_equality() {
    let x: int? = 7
    
    if !(x == null) {
        print("value is {x}")  // x is refined to int
    }
}

// ============================================
// Safe Navigation with Refinement
// ============================================

struct Point {
    x: int,
    y: int,
}

@test(output = "10")
fn refinement_with_safe_navigation() {
    let p_val = Point { x: 10, y: 20 }
    let p: Point? = p_val
    
    if p != null {
        print(p.x)  // p is refined to Point here
    }
}

@test(output = "30")
fn refinement_complex_field_access() {
    let p_val = Point { x: 10, y: 20 }
    let p: Point? = p_val
    
    if p != null {
        let sum = p.x + p.y  // p is refined to Point
        print(sum)
    }
}

// ============================================
// Refinement in Loops
// ============================================

@test(output = "1\n2\n3")
fn refinement_in_while_loop() {
    let counter: int? = 1

    // Note: intra-&& refinement is not yet supported, so we use
    // a nested null check pattern instead of `counter != null && counter <= 3`
    while counter != null {
        if counter > 3 { break }
        print(counter)  // counter is refined to int
        counter = counter + 1
        if counter > 3 {
            counter = null
        }
    }
}

// ============================================
// Refinement with Function Calls
// ============================================

fn process_value(x: int) -> int {
    return x * 2
}

@test(output = "20")
fn refinement_with_function_call() {
    let value: int? = 10
    
    if value != null {
        let result = process_value(value)  // value is refined to int
        print(result)
    }
}

// ============================================
// Advanced Refinement Patterns
// ============================================

@test(output = "both non-null")
fn refinement_compound_conditions() {
    let a: int? = 5
    let b: int? = 10
    
    if a != null && b != null {
        print("both non-null")
    } else {
        print("at least one null")
    }
}

@test(output = "either null")
fn refinement_or_conditions() {
    let a: int? = 5
    let b: int? = null
    
    if a == null || b == null {
        print("either null")
    } else {
        print("both non-null")
    }
}

@test(output = "modified: 15")
fn refinement_with_mutation() {
    let x: int? = 10

    if x != null {
        x = x + 5    // x is refined to int, can be used in arithmetic
        print("modified: {x}")
    }
}

// Moved from nullable_shadowing_tests.rock: shadowing inside refinement blocks

struct ShadowFoo { value: int }

@test(output = "10")
fn shadow_int_replaces_refined_var() {
    let x: ShadowFoo? = ShadowFoo { value: 1 }
    if x != null {
        let x = 10
        print(x)
    }
}

@test(output = "true")
fn shadow_with_null_value() {
    let x: ShadowFoo? = ShadowFoo { value: 1 }
    if x != null {
        let x: ShadowFoo? = null
        print(x == null)
    }
}

@test(output = "99\n5")
fn shadow_does_not_affect_outer_binding() {
    let x: ShadowFoo? = ShadowFoo { value: 5 }
    if x != null {
        let x = 99
        print(x)
    }
    print(x?.value ?? -1)
}

@test(output = "1\n42")
fn refined_access_then_shadow() {
    let x: ShadowFoo? = ShadowFoo { value: 1 }
    if x != null {
        print(x.value)
        let x = 42
        print(x)
    }
}

@test(output = "hello\n7")
fn shadow_string_then_int() {
    let x: ShadowFoo? = ShadowFoo { value: 7 }
    if x != null {
        let x = "hello"
        print(x)
    }
    print(x?.value ?? -1)
}

// ============================================
// Adversarial: closures, control flow edges, complex patterns
// ============================================

// --- Refinement + closures ---

@test(output = "42")
fn test_refinement_captured_in_closure() {
    let x: int? = 42
    if x != null {
        let f = () => {
            print(x)
        }
        f()
    }
}

@test(output = "42 42 42")
fn test_refinement_in_loop_closure() {
    let x: int? = 42
    if x != null {
        let v = [1, 2, 3]
        let out = ""
        let first = true
        for item in v {
            if !first { out = out + " " }
            first = false
            out = out + "{x}"
        }
        print(out)
    }
}

// --- Refinement after divergent else ---

fn early_return_helper(x: int?) -> string {
    if x == null {
        return "was null"
    }
    // x should be refined to int here
    return "value: {x}"
}

@test(output = "value: 42")
fn test_refinement_after_divergent_else() {
    print(early_return_helper(42))
}

@test(output = "was null")
fn test_refinement_after_divergent_else_null() {
    print(early_return_helper(null))
}

// --- Refinement with early return in if ---

fn guard_return(x: int?, y: int?) -> string {
    if x == null {
        return "x null"
    }
    if y == null {
        return "y null"
    }
    // Both x and y should be refined here
    return "{x} {y}"
}

@test(output = "10 20")
fn test_double_guard_return() {
    print(guard_return(10, 20))
}

@test(output = "x null")
fn test_double_guard_x_null() {
    print(guard_return(null, 20))
}

@test(output = "y null")
fn test_double_guard_y_null() {
    print(guard_return(10, null))
}

// --- Refinement invalidation by assignment ---

@test(output = "safe")
fn test_refinement_invalidated_by_reassignment() {
    let x: int? = 42
    if x != null {
        // x is refined here
        let val = x + 1  // Should work, x is refined to int
        print("safe")
    }
}

// --- Nested if refinement ---

struct Node {
    value: int,
    next: Node?,
}

@test(output = "1 2 3")
fn test_nested_nullable_refinement() {
    let list = Node {
        value: 1,
        next: Node {
            value: 2,
            next: Node {
                value: 3,
                next: null,
            },
        },
    }
    let out = "{list.value}"
    if list.next != null {
        out = out + " {list.next.value}"
        if list.next.next != null {
            out = out + " {list.next.next.value}"
        }
    }
    print(out)
}

// --- Refinement in while loop ---

@test(output = "3 2 1")
fn test_while_refinement() {
    let vals = [3, 2, 1]
    let i = 0
    let out = ""
    let first = true
    while i < vals.len {
        if !first { out = out + " " }
        first = false
        out = out + "{vals[i]}"
        i = i + 1
    }
    print(out)
}

// --- Compound condition refinement ---

@test(output = "both present: 1 2")
fn test_compound_and_refinement() {
    let x: int? = 1
    let y: int? = 2
    if x != null && y != null {
        print("both present: {x} {y}")
    }
}

@test(output = "skipped")
fn test_compound_and_one_null() {
    let x: int? = 1
    let y: int? = null
    if x != null && y != null {
        print("both present")
    } else {
        print("skipped")
    }
}

// --- Refinement with short-circuit safety ---

@test(output = "safe: 42")
fn test_short_circuit_safe_access() {
    let x: int? = 42
    if x != null && x > 0 {
        print("safe: {x}")
    }
}

@test(output = "skipped")
fn test_short_circuit_null_skips_rhs() {
    let x: int? = null
    if x != null && x > 0 {
        print("not reached")
    } else {
        print("skipped")
    }
}

// --- Path refinement with struct fields ---

struct Container {
    item: CountedItem?,
}

struct CountedItem {
    name: string,
    count: int,
}

@test(output = "widget 5")
fn test_path_refinement_field() {
    let c = Container { item: CountedItem { name: "widget", count: 5 } }
    if c.item != null {
        print("{c.item.name} {c.item.count}")
    }
}

@test(output = "empty")
fn test_path_refinement_null_field() {
    let c = Container { item: null }
    if c.item != null {
        print("not reached")
    } else {
        print("empty")
    }
}

// --- Refinement + safe navigation combination ---

@test(output = "10")
fn test_refinement_with_safenav_fallback() {
    let c: Container? = Container { item: CountedItem { name: "x", count: 10 } }
    if c != null {
        let count = c.item?.count ?? 0
        print(count)
    }
}

// --- Refinement doesn't leak out of scope ---

fn scoped_refinement(x: int?) -> string {
    if x != null {
        let doubled = x * 2
        return "doubled: {doubled}"
    }
    // x should NOT be refined here
    return "was null"
}

@test(output = "doubled: 84")
fn test_refinement_scoped_present() {
    print(scoped_refinement(42))
}

@test(output = "was null")
fn test_refinement_scoped_null() {
    print(scoped_refinement(null))
}

// --- Triple guard pattern ---

fn triple_guard(a: int?, b: int?, c: int?) -> string {
    if a == null { return "a null" }
    if b == null { return "b null" }
    if c == null { return "c null" }
    return "{a} {b} {c}"
}

@test(output = "1 2 3")
fn test_triple_guard_all_present() {
    print(triple_guard(1, 2, 3))
}

@test(output = "b null")
fn test_triple_guard_b_null() {
    print(triple_guard(1, null, 3))
}

// --- Refinement preserved across let bindings ---

@test(output = "43")
fn test_refinement_across_let() {
    let x: int? = 42
    if x != null {
        let y = x + 1
        print(y)
    }
}

// --- Refinement with negated condition ---

@test(output = "present: 5")
fn test_negated_null_check() {
    let x: int? = 5
    if !(x == null) {
        print("present: {x}")
    }
}
