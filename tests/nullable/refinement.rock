// Refinement of nullable locals: `if x != null`, guards, `!is_null(x)` and
// compound conditions narrow a binding; the narrow survives only effects that
// cannot undo it (pure calls, writes from outside a closure). Rejected shapes
// are in tests/errors/nullable.rock.err.

struct Item {
    file: string,
    last_modified: int,
}

fn file_modtime(_p: string) -> int? {
    return 5
}

@test(output = "4")
fn if_else_nullable_else() {
    let x: int? = 3
    if x == null {
        let y = x
        print("null")
    } else {
        let y = x + 1
        print(y)
    }

    x = null
}

@test(output = "updated 5", type_holes = [[0, "int"]])
fn nullable_refine_nested_else() {
    let item = Item{ file: "foo", last_modified: 0 }
    let last_modified = file_modtime(item.file)

    if last_modified == null {
        print("not found")
    } else {
        let refined_last_modified: ? = last_modified

        if last_modified > item.last_modified {
            item.last_modified = last_modified
            print("updated {last_modified}")
        }
    }
}

@test(output = "11", type_holes = [[1, "int"], [2, "int"], [3, "int?"]])
fn double_refinement_chain() {
    let x: int? = 10

    if x != null {
        let x_refined_once: ? = x
        if x > 5 {
            let x_refined_twice: ? = x
            print(x + 1)
        }
    }

    let x_reverted: ? = x
    x = null
}

@test(output = "5\n10", type_holes = [[4, "int"], [5, "int"]])
fn refinement_with_multiple_variables() {
    let a: int? = 5
    let b: int? = 10

    if a != null && b != null {
        let a_refined: ? = a
        let b_refined: ? = b
        print(a)
        print(b)
    }
}

@test(output = "value is 7")
fn refinement_with_negated_equality() {
    let x: int? = 7

    if !(x == null) {
        print("value is {x}")
    }
}

@test(output = "1\n2\n3")
fn refinement_in_while_loop() {
    let counter: int? = 1

    while counter != null {
        if counter > 3 { break }
        print(counter)
        counter = counter + 1
        if counter > 3 {
            counter = null
        }
    }
}

@test(output = "either null")
fn refinement_or_conditions() {
    let a: int? = 5
    let b: int? = null

    if a == null || b == null {
        print("either null")
    } else {
        print("both non-null")
    }
}

@test(output = "modified: 15")
fn refinement_with_mutation() {
    let x: int? = 10

    if x != null {
        x = x + 5
        print("modified: {x}")
    }
}

struct ShadowFoo { value: int }

@test(output = "true")
fn shadow_with_null_value() {
    let x: ShadowFoo? = ShadowFoo { value: 1 }
    if x != null {
        let x: ShadowFoo? = null
        print(x == null)
    }
}

@test(output = "99\n5")
fn shadow_does_not_affect_outer_binding() {
    let x: ShadowFoo? = ShadowFoo { value: 5 }
    if x != null {
        let x = 99
        print(x)
    }
    print(x?.value ?? -1)
}

@test(output = "1\n42")
fn refined_access_then_shadow() {
    let x: ShadowFoo? = ShadowFoo { value: 1 }
    if x != null {
        print(x.value)
        let x = 42
        print(x)
    }
}

@test(output = "42")
fn test_refinement_captured_in_closure() {
    let x: int? = 42
    if x != null {
        let f = () => {
            print(x)
        }
        f()
    }
}

fn guard_return(x: int?, y: int?) -> string {
    if x == null {
        return "x null"
    }
    if y == null {
        return "y null"
    }
    return "{x} {y}"
}

@test(output = "10 20\nx null\ny null")
fn test_double_guard_return() {
    print(guard_return(10, 20))
    print(guard_return(null, 20))
    print(guard_return(10, null))
}

struct Node {
    value: int,
    next: Node?,
}

@test(output = "1 2 3")
fn test_nested_nullable_refinement() {
    let list = Node {
        value: 1,
        next: Node {
            value: 2,
            next: Node {
                value: 3,
                next: null,
            },
        },
    }
    let out = "{list.value}"
    if list.next != null {
        out = out + " {list.next.value}"
        if list.next.next != null {
            out = out + " {list.next.next.value}"
        }
    }
    print(out)
}

@test(output = "skipped")
fn test_compound_and_one_null() {
    let x: int? = 1
    let y: int? = null
    if x != null && y != null {
        print("both present")
    } else {
        print("skipped")
    }
}

@test(output = "safe: 42\nskipped")
fn test_short_circuit_refinement() {
    let x: int? = 42
    if x != null && x > 0 {
        print("safe: {x}")
    }
    let y: int? = null
    if y != null && y > 0 {
        print("not reached")
    } else {
        print("skipped")
    }
}

struct Container {
    item: CountedItem?,
}

struct CountedItem {
    name: string,
    count: int,
}

@test(output = "10")
fn test_refinement_with_safenav_fallback() {
    let c: Container? = Container { item: CountedItem { name: "x", count: 10 } }
    if c != null {
        let count = c.item?.count ?? 0
        print(count)
    }
}

struct G { f: int? }
global g: G = G { f: 1 }

@pure fn twice(n: int) -> int { return n * 2 }
fn count() -> int { return 3 }
// A write through a call, so the test body starts with no narrow in force.
fn reset(v: int?) { g.f = v }

@test(output = "2")
fn a_pure_call_in_the_condition_keeps_a_path_narrow() {
    reset(1)
    if g.f != null && twice(1) == 2 { print(g.f + 1) }
}

@test(output = "2")
fn a_pure_call_between_check_and_use_keeps_a_path_narrow() {
    reset(1)
    if g.f != null {
        let _k = twice(2)
        print(g.f + 1)
    }
}

@test(output = "re-checked")
fn an_impure_call_forces_a_re_check() {
    reset(1)
    if g.f != null {
        let _k = count()
        if g.f != null { print("re-checked") }
    }
}

@test(output = "4")
fn a_closure_assigned_local_keeps_its_narrow_across_a_pure_call() {
    let x: int? = 1
    let kill = () => { x = null }
    if x != null {
        let k = twice(x)
        print(k + x + 1)
    }
    kill()
}

@test(output = "gone")
fn a_closure_assigned_local_is_re_checked_after_the_call() {
    let x: int? = 1
    let kill = () => { x = null }
    if x != null {
        kill()
        if x == null { print("gone") } else { print("still {x}") }
    }
}

@test(output = "3")
fn a_lambda_local_assigned_in_the_same_lambda_still_narrows() {
    let f = () => {
        let y: int? = 1
        y = 2
        if y != null {
            let _k = count()
            return y + 1
        }
        return 0
    }
    print(f())
}

@test(output = "5")
fn a_local_assigned_only_outside_lambdas_is_immune_to_calls() {
    let x: int? = 4
    if x != null {
        let _k = count()
        print(x + 1)
    }
    x = null
}

struct Payload { n: int }
struct Holder { value: Payload? }

struct Other {}
fn is_null(_value: Other?) -> bool { false }

fn guarded_payload(p: Payload?) -> int {
    if is_null(p) { return -1 }
    return p.n
}

@test(output = "7\nempty")
fn stdlib_bare_call_narrows_both_paths() {
    let p: Payload? = Payload { n: 7 }
    if !is_null(p) { print(p.n) }
    p = null
    if is_null(p) { print("empty") } else { print(p.n) }
}

@test(output = "8\n-1")
fn stdlib_guard_narrows_after_return() {
    print(guarded_payload(Payload { n: 8 }))
    print(guarded_payload(null))
}

@test(output = "9")
fn stdlib_ufcs_call_narrows() {
    let p: Payload? = Payload { n: 9 }
    if !p.is_null() { print(p.n) }
}

@test(output = "10\n11")
fn stdlib_predicate_narrows_paths_and_short_circuits() {
    let h = Holder { value: Payload { n: 10 } }
    if !is_null(h.value) { print(h.value.n) }
    let p: Payload? = Payload { n: 11 }
    if !is_null(p) && p.n == 11 { print(p.n) }
}

@test(output = "false\nfalse")
fn selected_user_overload_keeps_its_own_behavior() {
    let x: Other? = null
    print(is_null(x))
    let is_null = (_value: Other?) => false
    print(is_null(x))
}

