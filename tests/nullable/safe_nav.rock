// Safe navigation `?.`: fields, methods, `?.let`, tuple and newtype
// projections, value and struct receivers, enum fields through generic
// holders, and `?.` in argument, array, arithmetic and interpolation
// positions, and assignment through a nullable chain.

struct Inner { value: int }

struct Outer { inner: Inner?, name: string }

struct Mob { name: string, health: int }

fn boss_mobs() -> Arena<Mob> {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })
    return mobs
}

@test(output = "10\ntrue")
fn safenav_let() {
    let x: int? = 5
    let doubled = x?.let { x * 2 }
    print(doubled)

    let y: int? = null
    print(y?.let { y * 2 } == null)
}

@test
fn safenav_arena_tuple_projections_and_chains() {
    let mobs = boss_mobs()
    let mob = mobs.pairs().find(_.1.name == "Boss")?.1
    assert_eq(mob.unwrap().name, "Boss")
    let missing = mobs.pairs().find(_.1.name == "Nobody")?.1
    assert(missing == null)
    let entity = mobs.pairs().find(_.1.name == "Boss")?.0
    assert(entity != null)
    let missing_entity = mobs.pairs().find(_.1.name == "Nobody")?.0
    assert(missing_entity == null)
    let name = mobs.pairs().find(_.1.name == "Boss")?.1?.name ?? "default"
    assert_eq(name, "Boss")
    let name2 = mobs.pairs().find(_.1.name == "Nobody")?.1?.name ?? "default"
    assert_eq(name2, "default")
    let hp = mobs.pairs().find(_.1.name == "Boss")?.1?.health ?? 0
    assert_eq(hp, 500)
    let hp2 = mobs.pairs().find(_.1.name == "Nobody")?.1?.health ?? 0
    assert_eq(hp2, 0)
    assert(mobs.pairs().find(_.1.health > 0) != null)
    assert(!(mobs.pairs().find(_.1.health > 1000) != null))
}

fn damage(mob: Mob, amount: int) -> int {
    return mob.health - amount
}

fn get_name(mob: Mob) -> string {
    return mob.name
}

fn double(x: int) -> int { return x * 2 }

@test
fn safenav_struct_methods_and_coalesce() {
    let mob: Mob? = Mob { name: "Goblin", health: 100 }
    let mob2: Mob? = null
    assert_eq(mob?.damage(10), 90)
    assert(mob2?.damage(10) == null)
    assert_eq(mob?.get_name(), "Goblin")
    assert(mob2?.get_name() == null)
    assert_eq(mob?.damage(10) ?? 0, 90)
    assert_eq(mob2?.damage(10) ?? 0, 0)
}

@test(output = "10\ntrue")
fn safenav_method_primitive() {
    let x: int? = 5
    print(x?.double())

    let y: int? = null
    print(y?.double() == null)
}

struct Chain { value: int = 0, next: Chain? = null }

@test(output = "42\ntrue\ntrue")
fn safenav_chain_deep() {
    let o: Outer? = Outer { inner: Inner { value: 42 }, name: "x" }
    print(o?.inner?.value)

    let o2: Outer? = Outer { inner: null, name: "x" }
    print(o2?.inner?.value == null)

    let o3: Outer? = null
    print(o3?.inner?.value == null)
}

@test(output = "50")
fn safenav_let_with_coalesce() {
    let x: int? = null
    let result = x?.let { x * 10 } ?? 50
    print(result)
}

@test(output = "42\n0")
fn safenav_linked_list() {
    let c = Chain { value: 1, next: Chain { value: 42 } }
    print(c.next?.value ?? 0)

    let c2 = Chain { value: 1 }
    print(c2.next?.value ?? 0)
}

@test(output = "Boss hp: 500\nNo boss")
fn safenav_arena_find_pattern() {
    let mobs = boss_mobs()

    let boss_hp = mobs.pairs().find(_.1.name == "Boss")?.1?.health
    if boss_hp != null {
        print("Boss hp: {boss_hp}")
    }

    mobs.pairs().find(_.1.name == "Boss")?.0.unwrap().remove()

    let boss_hp2 = mobs.pairs().find(_.1.name == "Boss")?.1?.health
    if boss_hp2 == null {
        print("No boss")
    }
}

struct SmallInner { v: int }

struct SmallOuter { inner: SmallInner? }

fn deep(o: SmallOuter?) -> int {
    return o?.inner?.v ?? -1
}

@test(output = "42\n-1\n-1")
fn test_chained_safenav() {
    let a = SmallOuter { inner: SmallInner { v: 42 } }
    print("{deep(a)}")
    let b = SmallOuter { inner: null }
    print("{deep(b)}")
    let c: SmallOuter? = null
    print("{deep(c)}")
}

newtype UserId(int)

fn maybe_user(have: bool) -> UserId? {
    if have { UserId(42) } else { null }
}

@test(output = "42\n-1")
fn test_nullable_newtype_dot0() {
    let u = maybe_user(true)
    let v = u?.0
    print(v ?? -1)
    let none = maybe_user(false)
    let w = none?.0
    print(w ?? -1)
}

fn maybe_pair(have: bool) -> (int, string)? {
    if have { (7, "hi") } else { null }
}

@test(output = "7\n-1")
fn test_nullable_tuple_dot0() {
    let p = maybe_pair(true)
    let v = p?.0
    print(v ?? -1)
    let none = maybe_pair(false)
    let w = none?.0
    print(w ?? -1)
}

value NV2 { x: float, y: float }

struct SV2 { x: float, y: float }

fn vec_len(v: NV2) -> float { return v.x + v.y }

fn smag(v: SV2) -> float { return v.x + v.y }

fn by_field(m: Map<int, NV2>, k: int) -> float { return m.get(k)?.x ?? -1.0 }

fn by_method(m: Map<int, NV2>, k: int) -> float { return m.get(k)?.vec_len() ?? -1.0 }

fn by_let(m: Map<int, NV2>, k: int) -> float { return m.get(k)?.let { 5.0 } ?? -1.0 }

fn s_by_method(m: Map<int, SV2>, k: int) -> float { return m.get(k)?.smag() ?? -1.0 }

fn seeded() -> Map<int, NV2> {
    let m: Map<int, NV2> = map_new()
    m[1] = NV2 { x: 1.0, y: 2.0 }
    return m
}

@test
fn safe_nav_field_hits_and_misses() {
    assert_eq(by_field(seeded(), 1), 1.0)
    assert_eq(by_field(seeded(), 9), -1.0)
}

@test
fn safe_nav_method_hits_and_misses() {
    assert_eq(by_method(seeded(), 1), 3.0)
    assert_eq(by_method(seeded(), 9), -1.0)
}

@test
fn safe_nav_let_hits_and_misses() {
    assert_eq(by_let(seeded(), 1), 5.0)
    assert_eq(by_let(seeded(), 9), -1.0)
}

// Control: a reference struct receiver is a real box.
@test
fn a_struct_receiver_hits_and_misses() {
    let m: Map<int, SV2> = map_new()
    m[1] = SV2 { x: 1.0, y: 2.0 }
    assert_eq(s_by_method(m, 1), 3.0)
    assert_eq(s_by_method(m, 9), -1.0)
}

// A nullable value local as the receiver of a UFCS `?.method()` whose self
// parameter takes the value directly (scalar ABI): the null check tests the
// nullable local and the hit branch passes the value's fields.

value V2 { x: int, y: int }

fn sum(self: V2) -> int {
    self.x + self.y
}

@test
fn test_safenav_ufcs_value_receiver() {
    let v: V2? = V2 { x: 7, y: 9 }
    let s = v?.sum() ?? -1
    assert_eq(s, 16)
    let none: V2? = null
    let t = none?.sum() ?? -1
    assert_eq(t, -1)
}

enum Kind { None, Named(string), Pair(int, float) }

enum Mode { Off, Level(int) }

enum UnitOnly { A, B }

value VH<T> { field: T }

struct SH<T> { field: T, other: int }

struct Holder<T> { field: T }

global G: SH<Kind>? = null

fn value_holder() -> VH<Kind>? { return VH { field: Kind::None } }

fn global_holder() -> SH<Kind>? { return G }

fn holder_of(m: Mode) -> Holder<Mode>? { return Holder { field: m } }

fn no_holder() -> Holder<Mode>? { return null }

fn field_is_off(h: Holder<Mode>?) -> bool { return h?.field == Mode::Off }

fn field_or_level(h: Holder<Mode>?) -> Mode { return h?.field ?? Mode::Level(3) }

@test
fn test_value_holder_unit_field() {
    let v = value_holder()
    assert(v?.field == Kind::None)
    let a = v?.field ?? Kind::Named("x")
    assert(a == Kind::None)
}

@test
fn test_struct_holder_through_global() {
    G = SH { field: Kind::None, other: 1 }
    let g = global_holder()
    assert(g?.field == Kind::None)
    let b = g?.field ?? Kind::Pair(1, 2.0)
    assert(b == Kind::None)
    G = null
}

@test
fn test_payload_field_is_not_the_unit_variant() {
    let s: SH<Kind>? = SH { field: Kind::Named("q"), other: 2 }
    assert(!(s?.field == Kind::None))
    assert(s?.field == Kind::Named("q"))
    assert(!(s?.field == Kind::Named("r")))
    let p = s?.field ?? Kind::None
    assert(p == Kind::Named("q"))
    match p {
        Kind::Named(name) => assert(name == "q"),
        _ => assert(false),
    }
}

@test
fn test_local_holder_unit_field() {
    let h: Holder<Mode>? = Holder { field: Mode::Off }
    assert(h?.field == Mode::Off)
    let m = h?.field ?? Mode::Level(3)
    assert(m == Mode::Off)
}

@test
fn test_holder_through_parameter_and_call() {
    assert(field_is_off(holder_of(Mode::Off)))
    assert(!field_is_off(holder_of(Mode::Level(1))))
    assert(field_or_level(holder_of(Mode::Off)) == Mode::Off)
    assert(field_or_level(holder_of(Mode::Level(7))) == Mode::Level(7))
}

@test
fn test_null_holder() {
    let n: Holder<Mode>? = null
    assert(!(n?.field == Mode::Off))
    assert(n?.field == null)
    let k = n?.field ?? Mode::Off
    assert(k == Mode::Off)
    assert(!field_is_off(no_holder()))
    assert(field_or_level(no_holder()) == Mode::Level(3))
}

@test
fn test_controls() {
    // Plain unwrap and field access.
    let h: Holder<Mode>? = Holder { field: Mode::Off }
    assert(h.unwrap().field == Mode::Off)
    // A directly assigned optional enum, coalesced.
    let direct: Mode? = Mode::Off
    let d = direct ?? Mode::Level(9)
    assert(d == Mode::Off)
    // A unit-only enum through the same holder shape.
    let u: Holder<UnitOnly>? = Holder { field: UnitOnly::B }
    assert(u?.field == UnitOnly::B)
    let w = u?.field ?? UnitOnly::A
    assert(w == UnitOnly::B)
}

struct FixVec2 {
    x: float,
    y: float,
}

struct Player {
    name: string,
    pos: FixVec2,
    health: int,
}

struct World {
    player: Player?,
    boss: Player?,
}

fn make_world() -> World {
    return World {
        player: Player { name: "Hero", pos: FixVec2 { x: 1.0, y: 2.0 }, health: 100 },
        boss: Player { name: "Dragon", pos: FixVec2 { x: 5.0, y: 6.0 }, health: 500 },
    }
}

fn make_empty_world() -> World {
    return World { player: null, boss: null }
}

// Each test runs the same expression against a full world `w` and an empty
// world `e`.

fn show_int(x: int) {
    print(x)
}

fn count_present(names: [string?]) -> int {
    let count = 0
    for n in names {
        if n != null {
            count = count + 1
        }
    }
    return count
}

@test(output = "100\n0")
fn test_safenav_as_arg() {
    let w = make_world()
    show_int(w.player?.health ?? 0)
    let e = make_empty_world()
    show_int(e.player?.health ?? 0)
}

@test(output = "2\n0")
fn test_safenav_in_array() {
    let w = make_world()
    let names: [string?] = [w.player?.name, w.boss?.name]
    print(count_present(names))
    let e = make_empty_world()
    let empty_names: [string?] = [e.player?.name, e.boss?.name]
    print(count_present(empty_names))
}

@test(output = "3\n0")
fn test_safenav_in_addition() {
    let w = make_world()
    print((w.player?.pos?.x ?? 0.0) + (w.player?.pos?.y ?? 0.0))
    let e = make_empty_world()
    print((e.player?.pos?.x ?? 0.0) + (e.player?.pos?.y ?? 0.0))
}

fn maybe_player() -> Player? {
    return Player { name: "Test", pos: FixVec2 { x: 0.0, y: 0.0 }, health: 50 }
}

fn no_player() -> Player? {
    return null
}

@test(output = "Test\nnone")
fn test_safenav_on_fn_result() {
    print(maybe_player()?.name ?? "none")
    print(no_player()?.name ?? "none")
}

@test(output = "Hero\nnone")
fn test_let_safenav_via_var() {
    let p = make_world().player
    print(p?.let { p.name } ?? "none")
    let q = make_empty_world().player
    print(q?.let { "something" } ?? "none")
}

fn health_status(p: Player) -> string {
    if p.health > 50 {
        return "healthy"
    }
    return "wounded"
}

@test(output = "healthy")
fn test_safenav_ufcs() {
    let w = make_world()
    if w.player != null {
        print(health_status(w.player))
    }
}

struct A {
    b: B?,
}
struct B {
    c: C?,
}
struct C {
    d: D?,
}
struct D {
    value: int,
}

@test(output = "42\n0\n0\n0")
fn test_4_level_safenav() {
    let full = A { b: B { c: C { d: D { value: 42 } } } }
    print(full.b?.c?.d?.value ?? 0)
    let null_b = A { b: null }
    print(null_b.b?.c?.d?.value ?? 0)
    let null_c = A { b: B { c: null } }
    print(null_c.b?.c?.d?.value ?? 0)
    let null_d = A { b: B { c: C { d: null } } }
    print(null_d.b?.c?.d?.value ?? 0)
}

@test(output = "Hero has 100 hp\nunknown has 0 hp")
fn test_safenav_interpolation_via_var() {
    let w = make_world()
    let name = w.player?.name ?? "unknown"
    let hp = w.player?.health ?? 0
    print("{name} has {hp} hp")
    let e = make_empty_world()
    let empty_name = e.player?.name ?? "unknown"
    let empty_hp = e.player?.health ?? 0
    print("{empty_name} has {empty_hp} hp")
}

struct Point { x: int, y: int }
struct Counter { value: int }
struct Tween { value: float, completed: bool }

fn get_value(c: Counter) -> int {
    return c.value
}

fn fixzero() -> Point {
    return Point { x: 0, y: 0 }
}

fn update(t: Tween, dt: float) -> Tween {
    return Tween { value: t.value + dt, completed: false }
}

fn complete(t: Tween) -> Tween {
    return Tween { value: 1.0, completed: true }
}

@test(output = "42\n-1")
fn test_nullable_safe_navigation_method() {
    let c_val = Counter { value: 42 }
    let c: Counter? = c_val
    let null_c: Counter? = null

    let c_value: int? = if c != null { get_value(c) } else { null }
    let null_c_value: int? = if null_c != null { get_value(null_c) } else { null }
    print(c_value ?? -1)
    print(null_c_value ?? -1)
}

@test(output = "0\n0\n-1\n-1")
fn test_nullable_let_assignment_pattern() {
    let p = Point { x: 10, y: 20 }
    let p_nullable: Point? = p
    let null_p: Point? = null

    let result1 = p_nullable?.let {
        let z = fixzero()
        z
    } ?? Point { x: -1, y: -1 }

    let result2 = null_p?.let {
        let z = fixzero()
        z
    } ?? Point { x: -1, y: -1 }

    print(result1.x)
    print(result1.y)
    print(result2.x)
    print(result2.y)
}

@test(output = "1\ntrue\n0\nfalse")
fn test_nullable_method_chaining() {
    let tween = Tween { value: 0.5, completed: false }
    let tween_opt: Tween? = tween
    let null_tween: Tween? = null

    let result1: Tween? = if tween_opt != null {
        let updated = update(tween_opt, 1.0)
        if updated.value >= 1.0 { complete(updated) } else { updated }
    } else { null }

    let result2: Tween? = if null_tween != null {
        let updated = update(null_tween, 1.0)
        if updated.value >= 1.0 { complete(updated) } else { updated }
    } else { null }

    if result1 != null {
        print(result1.value)
        print(result1.completed)
    }

    let default_tween = result2 ?? Tween { value: 0.0, completed: false }
    print(default_tween.value)
    print(default_tween.completed)
}

struct AssignLeaf { number: int, text: string }
struct AssignMiddle { leaf: AssignLeaf? }
struct AssignOuter { middle: AssignMiddle? }
struct AssignRoot { outer: AssignOuter? }

global safe_assign_calls: int = 0

fn safe_assign_rhs() -> int {
    safe_assign_calls += 1
    return 9
}

@test
fn safe_navigation_stores_skip_the_rhs_at_every_null_link() {
    let missing: [AssignRoot?] = [null, AssignRoot { outer: null },
        AssignRoot { outer: AssignOuter { middle: null } },
        AssignRoot { outer: AssignOuter { middle: AssignMiddle { leaf: null } } }]
    safe_assign_calls = 0
    for root in missing {
        root?.outer?.middle?.leaf?.number = safe_assign_rhs()
        root?.outer?.middle?.leaf?.number += safe_assign_rhs()
        root?.outer?.middle?.leaf?.text = "unused"
        assert(root?.outer?.middle?.leaf?.number == null)
        assert(root?.outer?.middle?.leaf?.text == null)
    }
    assert_eq(safe_assign_calls, 0)

    let root: AssignRoot? = AssignRoot { outer: AssignOuter { middle: AssignMiddle { leaf: null } } }
    root?.outer?.middle?.leaf = AssignLeaf { number: 1, text: "old" }
    assert_eq(root?.outer?.middle?.leaf?.number ?? -1, 1)
    root?.outer?.middle?.leaf?.number = safe_assign_rhs()
    assert_eq(safe_assign_calls, 1)
    assert_eq(root?.outer?.middle?.leaf?.number ?? -1, 9)
    root?.outer?.middle?.leaf?.number += 5
    assert_eq(root?.outer?.middle?.leaf?.number ?? -1, 14)
    root?.outer?.middle?.leaf?.number -= 2
    assert_eq(root?.outer?.middle?.leaf?.number ?? -1, 12)
    root?.outer?.middle?.leaf?.text = "updated"
    assert_eq(root?.outer?.middle?.leaf?.text ?? "missing", "updated")
    let absent: AssignRoot? = null
    root?.outer?.middle?.leaf?.number = absent?.outer?.middle?.leaf?.number ?? 0
    assert_eq(root?.outer?.middle?.leaf?.number ?? -1, 0)
}
