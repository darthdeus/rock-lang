// Safe navigation `?.`: field chains, `?? default`, `?.let`, `?.0`/`?.1` on
// nullable tuples, UFCS `?.method()`, and nullable struct fields.

struct Inner { value: int }
struct Outer { inner: Inner?, name: string }
struct Mob { name: string, health: int }

// -- Basic safe navigation --

@test(output = "hello\ntrue")
fn safenav_field_access() {
    let f: Outer? = Outer { inner: null, name: "hello" }
    print(f?.name)

    let f2: Outer? = null
    print(f2?.name == null)
}

@test(output = "true")
fn safenav_inner_null() {
    let o: Outer? = Outer { inner: null, name: "test" }
    print(o?.inner?.value == null)
}

// -- Safe navigation with null coalescing --

@test(output = "default")
fn safenav_coalesce() {
    let o: Outer? = null
    print(o?.name ?? "default")
}

@test(output = "hello")
fn safenav_coalesce_nonnull() {
    let o: Outer? = Outer { inner: null, name: "hello" }
    print(o?.name ?? "default")
}

@test(output = "0")
fn safenav_coalesce_nested() {
    let o: Outer? = Outer { inner: null, name: "test" }
    print(o?.inner?.value ?? 0)
}

// -- ?.let syntax --

@test(output = "10\ntrue")
fn safenav_let() {
    let x: int? = 5
    let doubled = x?.let { x * 2 }
    print(doubled)

    let y: int? = null
    print(y?.let { y * 2 } == null)
}

// -- ?.0 / ?.1 on nullable tuples --

@test(output = "Boss\ntrue")
fn safenav_tuple_dot1() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    let mob = mobs.pairs().find(_.1.name == "Boss")?.1
    print(mob.unwrap().name)

    let missing = mobs.pairs().find(_.1.name == "Nobody")?.1
    print(missing == null)
}

@test(output = "true\ntrue")
fn safenav_tuple_dot0() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    let entity = mobs.pairs().find(_.1.name == "Boss")?.0
    print(entity != null)

    let missing = mobs.pairs().find(_.1.name == "Nobody")?.0
    print(missing == null)
}

// -- Full chain: find -> ?.1 -> ?.field -> ?? default --

@test(output = "Boss\ndefault")
fn safenav_full_chain() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    let name = mobs.pairs().find(_.1.name == "Boss")?.1?.name ?? "default"
    print(name)

    let name2 = mobs.pairs().find(_.1.name == "Nobody")?.1?.name ?? "default"
    print(name2)
}

@test(output = "500\n0")
fn safenav_full_chain_int() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    let hp = mobs.pairs().find(_.1.name == "Boss")?.1?.health ?? 0
    print(hp)

    let hp2 = mobs.pairs().find(_.1.name == "Nobody")?.1?.health ?? 0
    print(hp2)
}

// -- Practical game patterns --

@test(output = "removed Boss\n0")
fn safenav_find_and_remove() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    let boss_entity = mobs.pairs().find(_.1.name == "Boss")?.0
    if boss_entity != null {
        let mob = boss_entity.unwrap().get().unwrap()
        print("removed {mob.name}")
        boss_entity.unwrap().remove()
    }
    print(mobs.len())
}

@test(output = "true\nfalse")
fn safenav_any_alive() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    print(mobs.pairs().find(_.1.health > 0) != null)
    print(mobs.pairs().find(_.1.health > 1000) != null)
}

// -- ?.method() UFCS safe navigation --

fn damage(mob: Mob, amount: int) -> int {
    return mob.health - amount
}

fn get_name(mob: Mob) -> string {
    return mob.name
}

fn double(x: int) -> int { return x * 2 }

@test(output = "90\ntrue")
fn safenav_method_struct() {
    let mob: Mob? = Mob { name: "Goblin", health: 100 }
    print(mob?.damage(10))

    let mob2: Mob? = null
    print(mob2?.damage(10) == null)
}

@test(output = "Goblin\ntrue")
fn safenav_method_return_type() {
    let mob: Mob? = Mob { name: "Goblin", health: 100 }
    print(mob?.get_name())

    let mob2: Mob? = null
    print(mob2?.get_name() == null)
}

@test(output = "10\ntrue")
fn safenav_method_primitive() {
    let x: int? = 5
    print(x?.double())

    let y: int? = null
    print(y?.double() == null)
}

@test(output = "90\n0")
fn safenav_method_with_coalesce() {
    let mob: Mob? = Mob { name: "Goblin", health: 100 }
    print(mob?.damage(10) ?? 0)

    let mob2: Mob? = null
    print(mob2?.damage(10) ?? 0)
}

struct Chain { value: int = 0, next: Chain? = null }

// -- Safe navigation basics --

@test(output = "42\ntrue\ntrue")
fn safenav_chain_deep() {
    let o: Outer? = Outer { inner: Inner { value: 42 }, name: "x" }
    print(o?.inner?.value)

    let o2: Outer? = Outer { inner: null, name: "x" }
    print(o2?.inner?.value == null)

    let o3: Outer? = null
    print(o3?.inner?.value == null)
}

// -- Null coalescing --

@test(output = "5\n0")
fn coalesce_basic() {
    let x: int? = 5
    print(x ?? 0)

    let y: int? = null
    print(y ?? 0)
}

// -- Arithmetic with safe nav --

@test(output = "15\n5")
fn safenav_arithmetic() {
    let o: Outer? = Outer { inner: Inner { value: 10 }, name: "x" }
    print((o?.inner?.value ?? 0) + 5)

    let o2: Outer? = null
    print((o2?.inner?.value ?? 0) + 5)
}

// -- ?.let --

@test(output = "50")
fn safenav_let_with_coalesce() {
    let x: int? = null
    let result = x?.let { x * 10 } ?? 50
    print(result)
}

// -- ?.0 / ?.1 on nullable tuples --

@test(output = "true\ntrue")
fn safenav_tuple_0() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    print(mobs.pairs().find(_.1.name == "Boss")?.0 != null)
    print(mobs.pairs().find(_.1.name == "Nobody")?.0 == null)
}

// -- Full chain: find -> ?.1 -> ?.field -> ?? --

@test(output = "Boss\ndefault")
fn safenav_full_chain_string() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    print(mobs.pairs().find(_.1.name == "Boss")?.1?.name ?? "default")
    print(mobs.pairs().find(_.1.name == "Nobody")?.1?.name ?? "default")
}

@test(output = "500\n0")
fn safenav_full_chain_int() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    print(mobs.pairs().find(_.1.name == "Boss")?.1?.health ?? 0)
    print(mobs.pairs().find(_.1.name == "Nobody")?.1?.health ?? 0)
}

// -- Linked list with safe nav --

@test(output = "42\n0")
fn safenav_linked_list() {
    let c = Chain { value: 1, next: Chain { value: 42 } }
    print(c.next?.value ?? 0)

    let c2 = Chain { value: 1 }
    print(c2.next?.value ?? 0)
}

@test(output = "99\n0")
fn safenav_linked_list_deep() {
    let c = Chain {
        value: 1,
        next: Chain {
            value: 2,
            next: Chain { value: 99 }
        }
    }
    print(c.next?.next?.value ?? 0)

    let c2 = Chain { value: 1, next: Chain { value: 2 } }
    print(c2.next?.next?.value ?? 0)
}

// -- Nullable struct fields --

@test(output = "42\nnone")
fn nullable_struct_field() {
    let o1 = Outer { inner: Inner { value: 42 }, name: "has" }
    print(o1.inner?.value ?? -1)

    let o2 = Outer { inner: null, name: "empty" }
    let val = o2.inner?.value
    if val == null {
        print("none")
    }
}

// -- if-let with safe nav --

@test(output = "found: 42\nnot found")
fn safenav_if_let() {
    let o: Outer? = Outer { inner: Inner { value: 42 }, name: "x" }
    let val = o?.inner?.value
    if val != null {
        print("found: {val.unwrap()}")
    }

    let o2: Outer? = null
    let val2 = o2?.inner?.value
    if val2 == null {
        print("not found")
    }
}

// -- Arena game patterns --

@test(output = "2\n0")
fn safenav_arena_filter_remove() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Goblin", health: 30 })
    mobs.insert(Mob { name: "Orc", health: 100 })
    mobs.insert(Mob { name: "Dragon", health: 200 })

    // Find and remove weak mobs
    let weak = mobs.pairs().find(_.1.health < 50)?.0
    if weak != null {
        weak.unwrap().remove()
    }
    print(mobs.len())

    // Clear all
    mobs.clear()
    print(mobs.len())
}

@test(output = "Boss hp: 500\nNo boss")
fn safenav_arena_find_pattern() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    let boss_hp = mobs.pairs().find(_.1.name == "Boss")?.1?.health
    if boss_hp != null {
        print("Boss hp: {boss_hp.unwrap()}")
    }

    mobs.pairs().find(_.1.name == "Boss")?.0.unwrap().remove()

    let boss_hp2 = mobs.pairs().find(_.1.name == "Boss")?.1?.health
    if boss_hp2 == null {
        print("No boss")
    }
}

// -- Safe navigation through function parameters --

struct SmallInner { v: int }
struct SmallOuter { inner: SmallInner? }

fn deep(o: SmallOuter?) -> int {
    return o?.inner?.v ?? -1
}

fn shallow(i: SmallInner?) -> int {
    return i?.v ?? 0
}

@test(output = "42\n-1\n-1")
fn test_chained_safenav() {
    let a = SmallOuter { inner: SmallInner { v: 42 } }
    print("{deep(a)}")
    let b = SmallOuter { inner: null }
    print("{deep(b)}")
    let c: SmallOuter? = null
    print("{deep(c)}")
}

@test(output = "9\n0")
fn test_single_safenav() {
    let i = SmallInner { v: 9 }
    print("{shallow(i)}")
    let n: SmallInner? = null
    print("{shallow(n)}")
}

fn pick(i: SmallInner?) -> int {
    return i?.v ?? 99
}

@test(output = "5\n99")
fn test_safenav_present_via_param() {
    let p = SmallInner { v: 5 }
    let r = pick(p)
    print("{r}")
    let n: SmallInner? = null
    print("{pick(n)}")
}
