// Tests for ?? (null coalesce) type checking.
// T? ?? T  -> T   (right must match inner type of left)
// T? ?? T? -> T?  (both nullable, inner types must match)
// Mismatched types must be a compile error.

// ============================================
// Valid uses
// ============================================

@test(output = "5")
fn coalesce_int_with_int_default() {
    let x: int? = 5
    print(x ?? 0)
}

@test(output = "0")
fn coalesce_null_with_int_default() {
    let x: int? = null
    print(x ?? 0)
}

@test(output = "hello")
fn coalesce_string_with_string_default() {
    let s: string? = null
    print(s ?? "hello")
}

@test(output = "3")
fn coalesce_chain_all_matching() {
    let a: int? = null
    let b: int? = null
    let c: int? = 3
    print(a ?? b ?? c ?? 99)
}

@test(output = "10")
fn coalesce_nullable_nullable() {
    let a: int? = null
    let b: int? = 10
    let result: int? = a ?? b
    print(result ?? -1)
}

@test(output = "3.14")
fn coalesce_float_float() {
    // float? ?? float works fine
    let x: float? = null
    let result = x ?? 3.14
    print(result)
}
