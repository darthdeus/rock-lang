// Adversarial tests for ?? (null coalescing) operator
// Focus: falsy values, chaining, side effects, edge cases

// --- 1.1: ?? with falsy non-nil values ---

@test(output = "false")
fn test_bool_coalesce_false_value() {
    let x: bool? = false
    let result = x ?? true
    print(result)
}

@test(output = "true")
fn test_bool_coalesce_null_value() {
    let x: bool? = null
    let result = x ?? true
    print(result)
}

@test(output = "true")
fn test_bool_coalesce_true_value() {
    let x: bool? = true
    let result = x ?? false
    print(result)
}

@test(output = "0")
fn test_int_coalesce_zero() {
    let x: int? = 0
    let result = x ?? 42
    print(result)
}

@test(output = "42")
fn test_int_coalesce_null() {
    let x: int? = null
    let result = x ?? 42
    print(result)
}

@test(output = "")
fn test_string_coalesce_empty() {
    let x: string? = ""
    let result = x ?? "default"
    print(result)
}

// --- Chained coalescing with falsy values ---

@test(output = "false")
fn test_chained_bool_coalesce() {
    let a: bool? = null
    let b: bool? = false
    let result = a ?? b ?? true
    print(result)
}

@test(output = "true")
fn test_chained_bool_coalesce_all_null() {
    let a: bool? = null
    let b: bool? = null
    let result = a ?? b ?? true
    print(result)
}

@test(output = "0")
fn test_chained_int_coalesce_zero() {
    let a: int? = null
    let b: int? = 0
    let result = a ?? b ?? 99
    print(result)
}

// --- Side effects ---

global side_effect_count: int = 0

fn side_effect_int() -> int {
    side_effect_count = side_effect_count + 1
    return 999
}

@test(output = "false 0")
fn test_bool_coalesce_no_side_effect_when_present() {
    side_effect_count = 0
    let x: bool? = false
    let result = x ?? true
    print("{result} {side_effect_count}")
}

@test(output = "42 0")
fn test_int_coalesce_no_rhs_eval_when_present() {
    side_effect_count = 0
    let x: int? = 42
    let result = x ?? side_effect_int()
    print("{result} {side_effect_count}")
}

@test(output = "999 1")
fn test_int_coalesce_rhs_eval_when_null() {
    side_effect_count = 0
    let x: int? = null
    let result = x ?? side_effect_int()
    print("{result} {side_effect_count}")
}

// --- ?? in various expression positions ---

@test(output = "3")
fn test_coalesce_in_arithmetic() {
    let x: int? = null
    let result = (x ?? 1) + 2
    print(result)
}

@test(output = "hello world")
fn test_coalesce_in_interpolation() {
    let name: string? = null
    print("{name ?? "hello"} world")
}

@test(output = "5")
fn test_coalesce_as_function_arg() {
    let x: int? = null
    let arr: [int] = []
    arr.push(x ?? 5)
    print(arr[0])
}

// --- Deep chaining (5+ levels) ---

@test(output = "99")
fn test_deep_chain_coalesce() {
    let a: int? = null
    let b: int? = null
    let c: int? = null
    let d: int? = null
    let e: int? = null
    let result = a ?? b ?? c ?? d ?? e ?? 99
    print(result)
}

@test(output = "3")
fn test_deep_chain_coalesce_middle_value() {
    let a: int? = null
    let b: int? = null
    let c: int? = 3
    let d: int? = null
    let e: int? = null
    let result = a ?? b ?? c ?? d ?? e ?? 99
    print(result)
}

// --- ?? combined with ?.  ---

struct Inner {
    value: int,
}

struct Outer {
    inner: Inner?,
}

@test(output = "42")
fn test_safenav_then_coalesce() {
    let o: Outer? = Outer { inner: Inner { value: 42 } }
    let result = o?.inner?.value ?? 0
    print(result)
}

@test(output = "0")
fn test_safenav_null_then_coalesce() {
    let o: Outer? = null
    let result = o?.inner?.value ?? 0
    print(result)
}

@test(output = "0")
fn test_safenav_inner_null_then_coalesce() {
    let o: Outer? = Outer { inner: null }
    let result = o?.inner?.value ?? 0
    print(result)
}
