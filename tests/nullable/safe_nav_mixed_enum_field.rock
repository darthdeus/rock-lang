// Regression for #38: `holder?.field` of an enum with both unit and payload
// variants, read through a nullable generic holder, must compare equal to the
// same unit variant, directly and after `??`. Covers struct and value holders,
// holders that arrive through a global, a call and a parameter, a null holder,
// payload identity, and the unwrap / direct-optional / unit-only controls.

enum Kind { None, Named(string), Pair(int, float) }
enum Mode { Off, Level(int) }
enum UnitOnly { A, B }

value VH<T> { field: T }
struct SH<T> { field: T, other: int }
struct Holder<T> { field: T }

global G: SH<Kind>? = null

fn value_holder() -> VH<Kind>? { return VH { field: Kind::None } }
fn global_holder() -> SH<Kind>? { return G }
fn holder_of(m: Mode) -> Holder<Mode>? { return Holder { field: m } }
fn no_holder() -> Holder<Mode>? { return null }

fn field_is_off(h: Holder<Mode>?) -> bool { return h?.field == Mode::Off }
fn field_or_level(h: Holder<Mode>?) -> Mode { return h?.field ?? Mode::Level(3) }

@test
fn test_value_holder_unit_field() {
    let v = value_holder()
    assert(v?.field == Kind::None)
    let a = v?.field ?? Kind::Named("x")
    assert(a == Kind::None)
}

@test
fn test_struct_holder_through_global() {
    G = SH { field: Kind::None, other: 1 }
    let g = global_holder()
    assert(g?.field == Kind::None)
    let b = g?.field ?? Kind::Pair(1, 2.0)
    assert(b == Kind::None)
    G = null
}

@test
fn test_payload_field_is_not_the_unit_variant() {
    let s: SH<Kind>? = SH { field: Kind::Named("q"), other: 2 }
    assert(!(s?.field == Kind::None))
    assert(s?.field == Kind::Named("q"))
    assert(!(s?.field == Kind::Named("r")))
    let p = s?.field ?? Kind::None
    assert(p == Kind::Named("q"))
    match p {
        Kind::Named(name) => assert(name == "q"),
        _ => assert(false),
    }
}

@test
fn test_local_holder_unit_field() {
    let h: Holder<Mode>? = Holder { field: Mode::Off }
    assert(h?.field == Mode::Off)
    let m = h?.field ?? Mode::Level(3)
    assert(m == Mode::Off)
}

@test
fn test_holder_through_parameter_and_call() {
    assert(field_is_off(holder_of(Mode::Off)))
    assert(!field_is_off(holder_of(Mode::Level(1))))
    assert(field_or_level(holder_of(Mode::Off)) == Mode::Off)
    assert(field_or_level(holder_of(Mode::Level(7))) == Mode::Level(7))
}

@test
fn test_null_holder() {
    let n: Holder<Mode>? = null
    assert(!(n?.field == Mode::Off))
    assert(n?.field == null)
    let k = n?.field ?? Mode::Off
    assert(k == Mode::Off)
    assert(!field_is_off(no_holder()))
    assert(field_or_level(no_holder()) == Mode::Level(3))
}

@test
fn test_controls() {
    // Plain unwrap and field access.
    let h: Holder<Mode>? = Holder { field: Mode::Off }
    assert(h.unwrap().field == Mode::Off)
    // A directly assigned optional enum, coalesced.
    let direct: Mode? = Mode::Off
    let d = direct ?? Mode::Level(9)
    assert(d == Mode::Off)
    // A unit-only enum through the same holder shape.
    let u: Holder<UnitOnly>? = Holder { field: UnitOnly::B }
    assert(u?.field == UnitOnly::B)
    let w = u?.field ?? UnitOnly::A
    assert(w == UnitOnly::B)
}
