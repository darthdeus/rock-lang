// https://github.com/darthdeus/rock-lang/issues/401
value AscribedPair { x: int, y: int }

fn ascribed_field(x: int) -> int {
    return (AscribedPair { x: x, y: 2 } : AscribedPair?)?.x ?? -1
}

fn AscribedPair.total(self, extra: int = 3) -> int {
    return self.x + self.y + extra
}

fn ascribed_method(x: int) -> int {
    return (AscribedPair { x: x, y: 2 } : AscribedPair?)?.total() ?? -1
}

@test
fn nullable_value_ascription_preserves_constructor_type() {
    assert_eq(ascribed_field(7), 7)
    assert_eq(ascribed_method(7), 12)
}
