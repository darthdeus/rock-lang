struct Inner { value: int }
struct Outer { inner: Inner?, name: string }
struct Mob { name: string, health: int }
struct Chain { value: int = 0, next: Chain? = null }

// -- Safe navigation basics --

@test(output = "42\ntrue\ntrue")
fn safenav_chain_deep() {
    let o: Outer? = Outer { inner: Inner { value: 42 }, name: "x" }
    print(o?.inner?.value)

    let o2: Outer? = Outer { inner: null, name: "x" }
    print(o2?.inner?.value == null)

    let o3: Outer? = null
    print(o3?.inner?.value == null)
}

// -- Null coalescing --

@test(output = "5\n0")
fn coalesce_basic() {
    let x: int? = 5
    print(x ?? 0)

    let y: int? = null
    print(y ?? 0)
}

// -- Arithmetic with safe nav --

@test(output = "15\n5")
fn safenav_arithmetic() {
    let o: Outer? = Outer { inner: Inner { value: 10 }, name: "x" }
    print((o?.inner?.value ?? 0) + 5)

    let o2: Outer? = null
    print((o2?.inner?.value ?? 0) + 5)
}

// -- ?.let --

@test(output = "50")
fn safenav_let_with_coalesce() {
    let x: int? = null
    let result = x?.let { x * 10 } ?? 50
    print(result)
}

// -- ?.0 / ?.1 on nullable tuples --

@test(output = "true\ntrue")
fn safenav_tuple_0() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    print(mobs.pairs().find(_.1.name == "Boss")?.0 != null)
    print(mobs.pairs().find(_.1.name == "Nobody")?.0 == null)
}

// -- Full chain: find -> ?.1 -> ?.field -> ?? --

@test(output = "Boss\ndefault")
fn safenav_full_chain_string() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    print(mobs.pairs().find(_.1.name == "Boss")?.1?.name ?? "default")
    print(mobs.pairs().find(_.1.name == "Nobody")?.1?.name ?? "default")
}

@test(output = "500\n0")
fn safenav_full_chain_int() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    print(mobs.pairs().find(_.1.name == "Boss")?.1?.health ?? 0)
    print(mobs.pairs().find(_.1.name == "Nobody")?.1?.health ?? 0)
}

// -- Linked list with safe nav --

@test(output = "42\n0")
fn safenav_linked_list() {
    let c = Chain { value: 1, next: Chain { value: 42 } }
    print(c.next?.value ?? 0)

    let c2 = Chain { value: 1 }
    print(c2.next?.value ?? 0)
}

@test(output = "99\n0")
fn safenav_linked_list_deep() {
    let c = Chain {
        value: 1,
        next: Chain {
            value: 2,
            next: Chain { value: 99 }
        }
    }
    print(c.next?.next?.value ?? 0)

    let c2 = Chain { value: 1, next: Chain { value: 2 } }
    print(c2.next?.next?.value ?? 0)
}

// -- Nullable struct fields --

@test(output = "42\nnone")
fn nullable_struct_field() {
    let o1 = Outer { inner: Inner { value: 42 }, name: "has" }
    print(o1.inner?.value ?? -1)

    let o2 = Outer { inner: null, name: "empty" }
    let val = o2.inner?.value
    if val == null {
        print("none")
    }
}

// -- if-let with safe nav --

@test(output = "found: 42\nnot found")
fn safenav_if_let() {
    let o: Outer? = Outer { inner: Inner { value: 42 }, name: "x" }
    let val = o?.inner?.value
    if val != null {
        print("found: {val.unwrap()}")
    }

    let o2: Outer? = null
    let val2 = o2?.inner?.value
    if val2 == null {
        print("not found")
    }
}

// -- Arena game patterns --

@test(output = "2\n0")
fn safenav_arena_filter_remove() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Goblin", health: 30 })
    mobs.insert(Mob { name: "Orc", health: 100 })
    mobs.insert(Mob { name: "Dragon", health: 200 })

    // Find and remove weak mobs
    let weak = mobs.pairs().find(_.1.health < 50)?.0
    if weak != null {
        weak.unwrap().remove()
    }
    print(mobs.len())

    // Clear all
    mobs.clear()
    print(mobs.len())
}

@test(output = "Boss hp: 500\nNo boss")
fn safenav_arena_find_pattern() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Boss", health: 500 })

    let boss_hp = mobs.pairs().find(_.1.name == "Boss")?.1?.health
    if boss_hp != null {
        print("Boss hp: {boss_hp.unwrap()}")
    }

    mobs.pairs().find(_.1.name == "Boss")?.0.unwrap().remove()

    let boss_hp2 = mobs.pairs().find(_.1.name == "Boss")?.1?.health
    if boss_hp2 == null {
        print("No boss")
    }
}
