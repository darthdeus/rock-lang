value CoalescePoint { a: int, b: int }
value CoalesceLabel { a: int, label: string }

@test(output = "15\n23\ntrue\n31")
fn nullable_map_coalesce_preserves_values_and_absence() {
    let points: Map<string, CoalescePoint?> = map_new()
    points["present"] = CoalescePoint { a: 7, b: 8 }
    points["absent"] = null
    let present = points.get("present") ?? CoalescePoint { a: 0, b: 0 }
    let absent = points.get("absent") ?? CoalescePoint { a: 11, b: 12 }
    print(present.a + present.b)
    print(absent.a + absent.b)
    print(points.get("absent") == null)
    let missing = points.get("missing") ?? CoalescePoint { a: 15, b: 16 }
    print(missing.a + missing.b)
}

@test(output = "7:x\n11:fallback\ntrue")
fn nullable_gc_map_coalesce_preserves_values_and_absence() {
    let labels: Map<string, CoalesceLabel?> = map_new()
    labels["present"] = CoalesceLabel { a: 7, label: "x" }
    labels["absent"] = null
    let present = labels.get("present") ?? CoalesceLabel { a: 0, label: "wrong" }
    let absent = labels.get("absent") ?? CoalesceLabel { a: 11, label: "fallback" }
    print("{present.a}:{present.label}")
    print("{absent.a}:{absent.label}")
    print(labels.get("absent") == null)
}
