// The stdlib predicate still narrows when a distinct user overload is visible.
struct Payload { n: int }
struct Holder { value: Payload? }

struct Other {}
fn is_null(_value: Other?) -> bool { false }

fn guarded_payload(p: Payload?) -> int {
    if is_null(p) { return -1 }
    return p.n
}

@test(output = "7\nempty")
fn stdlib_bare_call_narrows_both_paths() {
    let p: Payload? = Payload { n: 7 }
    if !is_null(p) { print(p.n) }
    p = null
    if is_null(p) { print("empty") } else { print(p.n) }
}

@test(output = "8\n-1")
fn stdlib_guard_narrows_after_return() {
    print(guarded_payload(Payload { n: 8 }))
    print(guarded_payload(null))
}

@test(output = "9")
fn stdlib_ufcs_call_narrows() {
    let p: Payload? = Payload { n: 9 }
    if !p.is_null() { print(p.n) }
}

@test(output = "10\n11")
fn stdlib_predicate_narrows_paths_and_short_circuits() {
    let h = Holder { value: Payload { n: 10 } }
    if !is_null(h.value) { print(h.value.n) }
    let p: Payload? = Payload { n: 11 }
    if !is_null(p) && p.n == 11 { print(p.n) }
}

@test(output = "false\nfalse")
fn selected_user_overload_keeps_its_own_behavior() {
    let x: Other? = null
    print(is_null(x))
    let is_null = (_value: Other?) => false
    print(is_null(x))
}

fn main() {}
