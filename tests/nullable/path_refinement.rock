// Path refinement: `if a.b != null && a.b.c != null`, `a?.b?.c != null`,
// guards and early returns narrow field paths; assignment invalidates the
// narrow, it stays scoped to its branch, and runtime null at every level of a
// chain takes the miss path.

struct C { value: int }
struct B { c: C?, name: string }
struct A { b: B? }
struct Outer { inner: A? }

@test(output = "hello\ndefault\nno inner")
fn and_variable_refinement() {
    let o: A? = A { b: B { c: C { value: 42 }, name: "hello" } }
    if o != null && o.b != null {
        print(o.b.name)
    }
    let null_root: A? = null
    if null_root != null && null_root.b != null {
        print(null_root.b.name)
    } else {
        print("default")
    }
    let null_field: A? = A { b: null }
    if null_field != null && null_field.b != null {
        print(null_field.b.name)
    } else {
        print("no inner")
    }
}

@test
fn safe_nav_four_level() {
    let o: Outer? = Outer { inner: A { b: B { c: C { value: 99 }, name: "deep" } } }
    if o?.inner?.b?.c != null {
        assert_eq(o.inner.b.c.value, 99)
    }
}

@test
fn and_chain_incremental() {
    let a: A? = A { b: B { c: C { value: 7 }, name: "inc" } }
    if a != null && a.b != null && a.b.c != null {
        assert_eq(a.b.c.value, 7)
    }
}

@test
fn and_safe_nav_lhs_plain_rhs() {
    let a: A? = A { b: B { c: C { value: 9 }, name: "ok" } }
    if a?.b != null && a.b.c != null {
        assert_eq(a.b.c.value, 9)
    }
}

@test
fn and_condition_on_refined_path() {
    let a: A? = A { b: B { c: C { value: 5 }, name: "test" } }
    if a?.b?.c != null && a.b.c.value > 0 {
        assert_eq(a.b.c.value, 5)
    }
}

@test
fn dot_then_safenav() {
    let a: A = A { b: B { c: C { value: 7 }, name: "hi" } }
    if a.b?.c != null {
        assert_eq(a.b.c.value, 7)
    }
}

@test
fn post_divergence_then_deeper() {
    let a: A? = A { b: B { c: C { value: 3 }, name: "g" } }
    if a == null { return }
    if a.b?.c != null {
        assert_eq(a.b.c.value, 3)
    }
}

@test(output = "missing root\nmissing intermediate\nmissing leaf")
fn safe_nav_chain_null_at_each_level() {
    let root: A? = null
    if root?.b?.c != null { print("found") } else { print("missing root") }
    let mid: A? = A { b: null }
    if mid?.b?.c != null { print("found") } else { print("missing intermediate") }
    let leaf: A? = A { b: B { c: null, name: "leaf" } }
    if leaf?.b?.c != null { print("found") } else { print("missing leaf") }
}

@test
fn guard_deep_chain() {
    let a: A? = A { b: B { c: C { value: 7 }, name: "deep" } }
    if a?.b?.c == null { return }
    assert_eq(a.b.c.value, 7)
}

@test(output = "guarded")
fn guard_fires_null_root() {
    let a: A? = null
    if a?.b == null {
        print("guarded")
        return
    }
    assert(false)
}

@test
fn else_diverges_path_refined() {
    let a: A? = A { b: B { c: C { value: 3 }, name: "else" } }
    if a?.b != null {
    } else {
        return
    }
    assert_eq(a.b.name, "else")
}

@test(output = "3\n2\n1")
fn while_safe_nav_path_refined() {
    let a: A? = A { b: B { c: C { value: 3 }, name: "w" } }
    while a?.b != null && a.b.c != null && a.b.c.value > 0 {
        let c = a.b.c
        print(c.value)
        c.value = c.value - 1
    }
}

@test(output = "done")
fn while_safe_nav_null_skip() {
    let a: A? = null
    while a?.b != null {
        print(a.b.name)
    }
    print("done")
}

@test(output = "inside\n7")
fn refinement_scoped_to_block() {
    let a: A? = A { b: B { c: C { value: 7 }, name: "s" } }
    if a?.b?.c != null {
        print("inside")
    }
    print(a?.b?.c?.value ?? 0)
}

struct Inner { value: int }
struct Mid { inner: Inner?, name: string }
struct Top { mid: Mid? }
struct Deep { top: Top? }

@test(output = "42\ncleared")
fn assign_null_deep_path() {
    let t = Top { mid: Mid { inner: Inner { value: 42 }, name: "deep" } }
    if t.mid != null && t.mid.inner != null {
        let mid = t.mid
        let value = t.mid.inner.value
        print(value)
        mid.inner = null
        print("cleared")
    }
}

@test(output = "deep\ncleared")
fn assign_null_intermediate_path() {
    let d = Deep { top: Top { mid: Mid { inner: Inner { value: 1 }, name: "deep" } } }
    if d.top != null && d.top.mid != null {
        print(d.top.mid.name)
        d.top = null
        print("cleared")
    }
}

@test(output = "x\ncleared")
fn guard_use_then_clear() {
    let t = Top { mid: Mid { inner: Inner { value: 1 }, name: "x" } }
    if t.mid == null { return }
    print(t.mid.name)
    t.mid = null
    print("cleared")
}

@test(output = "before\nafter")
fn assign_nonnull_to_refined_field() {
    let t = Top { mid: Mid { inner: Inner { value: 1 }, name: "before" } }
    if t.mid != null {
        print(t.mid.name)
        t.mid = Mid { inner: null, name: "after" }
        print(t.mid.name)
    }
}

@test(output = "3\n2\n1\ndone")
fn while_loop_mutate_refined_path() {
    let t = Top { mid: Mid { inner: Inner { value: 3 }, name: "loop" } }
    while t.mid != null && t.mid.inner != null && t.mid.inner.value > 0 {
        let inner = t.mid.inner
        print(inner.value)
        inner.value = inner.value - 1
    }
    print("done")
}

@test(output = "clearing\ndone")
fn while_loop_clear_refined_path() {
    let t = Top { mid: Mid { inner: Inner { value: 1 }, name: "x" } }
    while t.mid != null {
        print("clearing")
        t.mid = null
    }
    print("done")
}

struct TwoFields {
    a: Inner?,
    b: Inner?,
}

@test(output = "10\n20\n10")
fn invalidate_one_path_keep_other() {
    let t = TwoFields { a: Inner { value: 10 }, b: Inner { value: 20 } }
    if t.a != null && t.b != null {
        let b = t.b
        t.b = null
        // Assigning b preserves a's path fact until an opaque call.
        let a = t.a
        print(a.value)
        print(b.value)
        print(a.value)
    }
}

@test(output = "was null\nset")
fn assign_in_else_branch() {
    let t = Top { mid: null }
    if t.mid != null {
        print("unreachable")
    } else {
        print("was null")
        t.mid = Mid { inner: null, name: "new" }
        print("set")
    }
}

@test(output = "a\n42\ncleared inner")
fn nested_refinement_then_partial_clear() {
    let t = Top { mid: Mid { inner: Inner { value: 42 }, name: "a" } }
    if t.mid != null {
        let mid = t.mid
        print(mid.name)
        if mid.inner != null {
            let inner = mid.inner
            print(inner.value)
            mid.inner = null
        }
        print("cleared inner")
    }
}

@test(output = "11")
fn compound_assign_through_refined_path() {
    let t = Top { mid: Mid { inner: Inner { value: 10 }, name: "x" } }
    if t.mid != null && t.mid.inner != null {
        t.mid.inner.value = t.mid.inner.value + 1
        print(t.mid.inner.value)
    }
}

struct Val { n: int }
struct Box { val: Val?, label: string }
struct Wrapper { box: Box? }

@test(output = "was set\nnow null")
fn invalidation_after_null_assign() {
    let b = Box { val: Val { n: 1 }, label: "x" }
    if b.val != null {
        print("was set")
        b.val = null
        if b.val == null {
            print("now null")
        }
    }
}

@test(output = "re-checked")
fn invalidation_after_nullable_assign() {
    let b = Box { val: Val { n: 1 }, label: "x" }
    let maybe: Val? = null
    if b.val != null {
        b.val = maybe
        if b.val != null {
            print("still set")
        } else {
            print("re-checked")
        }
    }
}

@test(output = "loop done\nsafe access")
fn refinement_scoped_to_while() {
    let b = Box { val: Val { n: 1 }, label: "x" }
    while b.val != null && b.val.n > 0 {
        b.val.n = b.val.n - 1
    }
    print("loop done")
    let n = b.val?.n ?? -1
    print("safe access")
}

struct Multi {
    a: Val?,
    b: Val?,
    c: Val?,
}

@test(output = "1\n3")
fn independent_field_refinements() {
    let m = Multi { a: Val { n: 1 }, b: null, c: Val { n: 3 } }
    if m.a != null {
        print(m.a.n)
    }
    if m.b != null {
        print("unreachable")
    }
    if m.c != null {
        print(m.c.n)
    }
}

@test(output = "original\nupdated")
fn guard_safenav_assign() {
    let w: Wrapper? = Wrapper { box: Box { val: Val { n: 1 }, label: "original" } }
    if w == null { return }
    if w.box == null { return }
    let box = w.box
    print(box.label)
    box.label = "updated"
    print(box.label)
}

@test(output = "no val")
fn and_chain_short_circuits() {
    let w = Wrapper { box: Box { val: null, label: "x" } }
    if w.box != null && w.box.val != null {
        print("unreachable")
    } else {
        print("no val")
    }
}

struct Root { w: Wrapper? }

@test(output = "3")
fn negated_null_check_refines() {
    let w = Wrapper { box: Box { val: Val { n: 42 }, label: "neg" } }
    if !(w.box == null) {
        print(w.box.label.len())
    }
}

@test(output = "captured: 42")
fn path_refinement_captured_in_closure() {
    let w = Wrapper { box: Box { val: Val { n: 42 }, label: "x" } }
    if w.box != null && w.box.val != null {
        let f = () => {
            print("captured: {w.box.val.n}")
        }
        f()
    }
}

@test(output = "10\n20")
fn assign_different_values_in_branches() {
    let b = Box { val: null, label: "x" }
    if b.val == null {
        b.val = Val { n: 10 }
    }
    if b.val != null {
        print(b.val.n)
    }
    // Re-assign via a local (backend-agnostic): bone narrows b.val to non-null
    // after the assignment so a re-check is dead, while rock needs a guard. Use
    // the local.
    let v = Val { n: 20 }
    b.val = v
    print(v.n)
}

struct Player { weapon: Weapon? }
struct Weapon { damage: int, enchant: Enchant? }
struct Enchant { power: int, name: string }

@test(output = "1\n2")
fn assign_then_rerefine() {
    let b = Box { val: Val { n: 1 }, label: "x" }
    if b.val != null {
        print(b.val.n)
        b.val = null
        let v = Val { n: 2 }
        b.val = v
        print(v.n)
    }
}

@test(output = "5\nfire")
fn guard_pattern_mixed_nav() {
    let p = Player {
        weapon: Weapon { damage: 5, enchant: Enchant { power: 10, name: "fire" } }
    }
    if p.weapon == null { return }
    let weapon = p.weapon
    print(weapon.damage)
    let name = weapon.enchant?.name ?? "none"
    print(name)
}

@test(output = "fire 10")
fn successive_guards() {
    let p = Player {
        weapon: Weapon { damage: 5, enchant: Enchant { power: 10, name: "fire" } }
    }
    if p.weapon == null { return }
    if p.weapon.enchant == null { return }
    print("{p.weapon.enchant.name} {p.weapon.enchant.power}")
}

@test(output = "no enchant")
fn successive_guards_second_null() {
    let p = Player { weapon: Weapon { damage: 5, enchant: null } }
    if p.weapon == null { return }
    if p.weapon.enchant == null {
        print("no enchant")
        return
    }
    print("unreachable")
}

@test(output = "found: 42")
fn while_with_break_path_refined() {
    let items = [
        Box { val: null, label: "a" },
        Box { val: Val { n: 42 }, label: "b" },
        Box { val: null, label: "c" },
    ]
    let found = false
    let result = 0
    for item in items {
        if item.val != null {
            result = item.val.n
            found = true
            break
        }
    }
    if found {
        print("found: {result}")
    }
}

@test(output = "missing leaf\nmissing mid\nmissing root")
fn safenav_condition_chain_null_at_each_level() {
    let leaf = Root { w: Wrapper { box: Box { val: null, label: "x" } } }
    if leaf.w?.box?.val != null { print("found") } else { print("missing leaf") }
    let mid = Root { w: Wrapper { box: null } }
    if mid.w?.box?.val != null { print("found") } else { print("missing mid") }
    let root = Root { w: null }
    if root.w?.box?.val != null { print("found") } else { print("missing root") }
}

// A local narrowed twice by one condition is restored after the branch
// `w != null && w.box != null` narrows `w` both directly and as the prefix of
// `w.box`. Leaving the branch must put back `w`'s declared nullable type, so
// the later `w != null` stays a live check rather than a rejected dead one.
fn double_narrow_branch(w: Wrapper?) -> string {
    if w != null && w.box != null {
        print("inner")
    }
    if w != null { return "set" }
    return "null"
}

@test(output = "null")
fn double_narrow_restored_after_branch() {
    print(double_narrow_branch(null))
}

// Two guards narrowing the same local inside a block (`w` directly, then as the
// prefix of `w.box`): after the block the local is nullable again.
fn double_guard_block(w: Wrapper?, flag: bool) -> string {
    if flag {
        if w == null { return "early" }
        if w.box == null { return "early" }
        print(w.box.label)
    }
    if w == null { return "null" }
    return "set"
}

@test(output = "null")
fn double_guard_restored_after_block() {
    print(double_guard_block(null, false))
}
