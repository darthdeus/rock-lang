// Path refinement: `if a.b != null && a.b.c != null` narrows field paths,
// safe-navigation chains, guards and early returns.

struct C { value: int }
struct B { c: C?, name: string }
struct A { b: B? }
struct Outer { inner: A? }

// ==============================
// && short-circuit variable refinement
// ==============================

// The failing test: o != null && o.inner != null
@test(output = "hello")
fn and_variable_refinement() {
    let o: A? = A { b: B { c: C { value: 42 }, name: "hello" } }
    if o != null && o.b != null {
        print(o.b.name)
    }
}

@test(output = "default")
fn and_variable_refinement_null_root() {
    let o: A? = null
    if o != null && o.b != null {
        print(o.b.name)
    } else {
        print("default")
    }
}

@test(output = "no inner")
fn and_variable_refinement_null_field() {
    let o: A? = A { b: null }
    if o != null && o.b != null {
        print(o.b.name)
    } else {
        print("no inner")
    }
}

// ==============================
// Safe navigation chain refinement
// ==============================

// a?.b?.c != null refines a, a.b, a.b.c in the body
@test
fn safe_nav_two_level() {
    let a: A? = A { b: B { c: C { value: 42 }, name: "x" } }
    if a?.b != null {
        assert_eq(a.b.name, "x")
    }
}

@test
fn safe_nav_three_level() {
    let a: A? = A { b: B { c: C { value: 42 }, name: "x" } }
    if a?.b?.c != null {
        assert_eq(a.b.c.value, 42)
    }
}

@test
fn safe_nav_four_level() {
    let o: Outer? = Outer { inner: A { b: B { c: C { value: 99 }, name: "deep" } } }
    if o?.inner?.b?.c != null {
        assert_eq(o.inner.b.c.value, 99)
    }
}

// ==============================
// Mixed && with path refinements
// ==============================

// Each clause uses refinements from prior clauses
@test
fn and_chain_incremental() {
    let a: A? = A { b: B { c: C { value: 7 }, name: "inc" } }
    if a != null && a.b != null && a.b.c != null {
        assert_eq(a.b.c.value, 7)
    }
}

// Safe nav LHS establishes path, plain access RHS uses it
@test
fn and_safe_nav_lhs_plain_rhs() {
    let a: A? = A { b: B { c: C { value: 9 }, name: "ok" } }
    if a?.b != null && a.b.c != null {
        assert_eq(a.b.c.value, 9)
    }
}

// && with non-null-check condition using path-refined access
@test
fn and_condition_on_refined_path() {
    let a: A? = A { b: B { c: C { value: 5 }, name: "test" } }
    if a?.b?.c != null && a.b.c.value > 0 {
        assert_eq(a.b.c.value, 5)
    }
}

// ==============================
// Mixed . and ?. in chains
// ==============================

// a.b?.c where a is non-nullable, b is nullable field
@test
fn dot_then_safenav() {
    let a: A = A { b: B { c: C { value: 7 }, name: "hi" } }
    if a.b?.c != null {
        assert_eq(a.b.c.value, 7)
    }
}

// Post-divergence then deeper check
@test
fn post_divergence_then_deeper() {
    let a: A? = A { b: B { c: C { value: 3 }, name: "g" } }
    if a == null { return }
    // a is now A (non-null via divergence refinement)
    if a.b?.c != null {
        assert_eq(a.b.c.value, 3)
    }
}

// ==============================
// Null cases (runtime correctness)
// ==============================

@test(output = "missing")
fn safe_nav_chain_null_root() {
    let a: A? = null
    if a?.b?.c != null {
        print("found")
    } else {
        print("missing")
    }
}

@test(output = "missing")
fn safe_nav_chain_null_intermediate() {
    let a: A? = A { b: null }
    if a?.b?.c != null {
        print("found")
    } else {
        print("missing")
    }
}

@test(output = "missing")
fn safe_nav_chain_null_leaf() {
    let a: A? = A { b: B { c: null, name: "leaf" } }
    if a?.b?.c != null {
        print("found")
    } else {
        print("missing")
    }
}

// ==============================
// Post-divergence path refinement (guard patterns)
// ==============================

// if a?.b == null { return } refines a.b after the guard
@test
fn guard_safe_nav_eq_null() {
    let a: A? = A { b: B { c: C { value: 42 }, name: "ok" } }
    if a?.b == null { return }
    assert_eq(a.b.name, "ok")
}

// Deeper guard: if a?.b?.c == null { return }
@test
fn guard_deep_chain() {
    let a: A? = A { b: B { c: C { value: 7 }, name: "deep" } }
    if a?.b?.c == null { return }
    assert_eq(a.b.c.value, 7)
}

// Guard fires on null root (verify runtime correctness)
@test(output = "guarded")
fn guard_fires_null_root() {
    let a: A? = null
    if a?.b == null {
        print("guarded")
        return
    }
    assert(false)
}

// Else-diverges: if a?.b != null { } else { return }; a.b.name
@test
fn else_diverges_path_refined() {
    let a: A? = A { b: B { c: C { value: 3 }, name: "else" } }
    if a?.b != null {
        // ok
    } else {
        return
    }
    assert_eq(a.b.name, "else")
}

// ==============================
// While loop path refinement
// ==============================

@test(output = "3\n2\n1")
fn while_safe_nav_path_refined() {
    let a: A? = A { b: B { c: C { value: 3 }, name: "w" } }
    while a?.b != null && a.b.c != null && a.b.c.value > 0 {
        let c = a.b.c
        print(c.value)
        c.value = c.value - 1
    }
}

@test(output = "done")
fn while_safe_nav_null_skip() {
    let a: A? = null
    while a?.b != null {
        print(a.b.name)
    }
    print("done")
}

// ==============================
// Scoping: refinement doesn't leak
// ==============================

@test(output = "inside\n7")
fn refinement_scoped_to_block() {
    let a: A? = A { b: B { c: C { value: 7 }, name: "s" } }
    if a?.b?.c != null {
        print("inside")
    }
    // Outside: a is still A?, must use ?.
    print(a?.b?.c?.value ?? 0)
}

// ==============================
// Assignment to refined paths. Regression: assigning null to a path-refined
// nullable field was rejected.
// ==============================

struct Inner { value: int }
struct Mid { inner: Inner?, name: string }
struct Top { mid: Mid? }
struct Deep { top: Top? }

// ==============================
// Basic: assign null to refined nullable field
// ==============================

// The original bug: inside `if x.field != null`, `x.field = null` was rejected
@test(output = "cleared")
fn assign_null_to_refined_field() {
    let t = Top { mid: Mid { inner: Inner { value: 1 }, name: "a" } }
    if t.mid != null {
        t.mid = null
        print("cleared")
    }
}

// Assign null then check that the field is actually null at runtime
@test(output = "set\nnull")
fn assign_null_to_refined_field_verify() {
    let t = Top { mid: Mid { inner: Inner { value: 1 }, name: "a" } }
    if t.mid != null {
        print("set")
        t.mid = null
    }
    if t.mid == null {
        print("null")
    }
}

// ==============================
// Deep chain: assign null to deeply refined path
// ==============================

@test(output = "42\ncleared")
fn assign_null_deep_path() {
    let t = Top { mid: Mid { inner: Inner { value: 42 }, name: "deep" } }
    if t.mid != null && t.mid.inner != null {
        let mid = t.mid
        let value = t.mid.inner.value
        print(value)
        mid.inner = null
        print("cleared")
    }
}

// Assign null to intermediate level of a deep chain
@test(output = "deep\ncleared")
fn assign_null_intermediate_path() {
    let d = Deep { top: Top { mid: Mid { inner: Inner { value: 1 }, name: "deep" } } }
    if d.top != null && d.top.mid != null {
        print(d.top.mid.name)
        d.top = null
        print("cleared")
    }
}

// ==============================
// Guard pattern + assignment
// ==============================

// Guard early-return, then assign null to the refined field
@test(output = "ok")
fn guard_then_assign_null() {
    let t = Top { mid: Mid { inner: Inner { value: 1 }, name: "x" } }
    if t.mid == null { return }
    // t.mid is now refined to Mid (non-null)
    t.mid = null  // should compile: declared type is Mid?
    print("ok")
}

// Guard, use the refined value, then clear it
@test(output = "x\ncleared")
fn guard_use_then_clear() {
    let t = Top { mid: Mid { inner: Inner { value: 1 }, name: "x" } }
    if t.mid == null { return }
    print(t.mid.name)
    t.mid = null
    print("cleared")
}

// ==============================
// Assign non-null: should preserve refinement ability
// ==============================

@test(output = "before\nafter")
fn assign_nonnull_to_refined_field() {
    let t = Top { mid: Mid { inner: Inner { value: 1 }, name: "before" } }
    if t.mid != null {
        print(t.mid.name)
        t.mid = Mid { inner: null, name: "after" }
        // After assigning a non-null value, the field is still accessible
        print(t.mid.name)
    }
}

// ==============================
// Safe navigation assignment paths
// ==============================

// a?.field = value where a was refined
@test(output = "10")
fn safe_nav_assign_after_refinement() {
    let t: Top? = Top { mid: Mid { inner: Inner { value: 1 }, name: "x" } }
    if t != null && t.mid != null && t.mid.inner != null {
        t.mid.inner.value = 10
        print(t.mid.inner.value)
    }
}

// ==============================
// While loop: mutate through refined path
// ==============================

@test(output = "3\n2\n1\ndone")
fn while_loop_mutate_refined_path() {
    let t = Top { mid: Mid { inner: Inner { value: 3 }, name: "loop" } }
    while t.mid != null && t.mid.inner != null && t.mid.inner.value > 0 {
        let inner = t.mid.inner
        print(inner.value)
        inner.value = inner.value - 1
    }
    print("done")
}

// While loop that clears the condition field (should exit loop)
@test(output = "clearing\ndone")
fn while_loop_clear_refined_path() {
    let t = Top { mid: Mid { inner: Inner { value: 1 }, name: "x" } }
    while t.mid != null {
        print("clearing")
        t.mid = null
    }
    print("done")
}

// ==============================
// Multiple refined paths: invalidate one, use another
// ==============================

struct TwoFields {
    a: Inner?,
    b: Inner?,
}

@test(output = "10\n20\n10")
fn invalidate_one_path_keep_other() {
    let t = TwoFields { a: Inner { value: 10 }, b: Inner { value: 20 } }
    if t.a != null && t.b != null {
        let b = t.b
        t.b = null
        // Assigning b preserves a's path fact until an opaque call.
        let a = t.a
        print(a.value)
        print(b.value)
        print(a.value)
    }
}

// ==============================
// Assign in else branch
// ==============================

@test(output = "was null\nset")
fn assign_in_else_branch() {
    let t = Top { mid: null }
    if t.mid != null {
        print("unreachable")
    } else {
        print("was null")
        t.mid = Mid { inner: null, name: "new" }
        print("set")
    }
}

// ==============================
// Nested if with progressive refinement and assignment
// ==============================

@test(output = "a\n42\ncleared inner")
fn nested_refinement_then_partial_clear() {
    let t = Top { mid: Mid { inner: Inner { value: 42 }, name: "a" } }
    if t.mid != null {
        let mid = t.mid
        print(mid.name)
        if mid.inner != null {
            let inner = mid.inner
            print(inner.value)
            mid.inner = null
        }
        print("cleared inner")
    }
}

// ==============================
// Compound assignment through refined path
// ==============================

@test(output = "11")
fn compound_assign_through_refined_path() {
    let t = Top { mid: Mid { inner: Inner { value: 10 }, name: "x" } }
    if t.mid != null && t.mid.inner != null {
        t.mid.inner.value = t.mid.inner.value + 1
        print(t.mid.inner.value)
    }
}

// ==============================
// Refinement after assignment restoring value
// ==============================

@test(output = "cleared\nrestored\nhello")
fn clear_then_restore_then_recheck() {
    let t = Top { mid: Mid { inner: null, name: "hello" } }
    if t.mid != null {
        t.mid = null
        print("cleared")
    }
    // Restore via a local: bone narrows `t.mid` to non-null after the assignment
    // (so a `!= null` re-check is dead -- a type error), while rock does not
    // narrow on assignment (so direct `t.mid.name` would error there). Using the
    // local is the backend-agnostic form; the bone-specific dead-check is covered
    // by fixtures/compare_null_nonnullable.rock.
    let restored = Mid { inner: null, name: "hello" }
    t.mid = restored
    print("restored")
    print(restored.name)
}
