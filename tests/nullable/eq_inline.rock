// Same-type == specialization with one or both operands nullable: the guard
// must not dereference a nil operand.

enum Color { Red, Green, Blue }

enum Shape {
    Empty,
    Dot(int),
    Rect(int, int),
}

struct Point { x: int, y: int }

@test
fn test_nullable_unit_enum() {
    let n1: Color? = null
    let n2: Color? = null
    assert_eq(n1 == n2, true)
    assert_eq(n1 != n2, false)

    let a: Color? = null
    let b: Color? = Color::Red
    assert_eq(a == b, false)
    assert_eq(a != b, true)
    assert_eq(b == a, false)
    assert_eq(b != a, true)

    let r1: Color? = Color::Red
    let r2: Color? = Color::Red
    let g: Color? = Color::Green
    assert_eq(r1 == r2, true)
    assert_eq(r1 == g, false)
}

@test
fn test_nullable_enum_vs_literal() {
    let a: Color? = Color::Red
    assert_eq(a == Color::Red, true)
    assert_eq(a == Color::Blue, false)
    let n: Color? = null
    assert_eq(n == Color::Red, false)
}

@test
fn test_nullable_payloaded_enum() {
    let n1: Shape? = null
    let n2: Shape? = null
    assert_eq(n1 == n2, true)
    assert_eq(n1 != n2, false)

    let a: Shape? = null
    let b: Shape? = Shape::Dot(5)
    assert_eq(a == b, false)
    assert_eq(a != b, true)

    let same: Shape? = Shape::Dot(5)
    assert_eq(b == same, true)

    let other: Shape? = Shape::Dot(6)
    assert_eq(b == other, false)
    assert_eq(b != other, true)
}

@test
fn test_nullable_vs_non_nullable_payloaded() {
    let a: Shape? = Shape::Dot(5)
    let b: Shape = Shape::Dot(5)
    assert_eq(a == b, true)
    assert_eq(b == a, true)
    let n: Shape? = null
    assert_eq(n == b, false)
    assert_eq(b == n, false)
}

@test
fn test_nullable_struct() {
    let n1: Point? = null
    let n2: Point? = null
    assert_eq(n1 == n2, true)

    let a: Point? = null
    let b: Point? = Point { x: 1, y: 2 }
    assert_eq(a == b, false)
    assert_eq(a != b, true)

    let same: Point? = Point { x: 1, y: 2 }
    assert_eq(b == same, true)

    let other: Point? = Point { x: 1, y: 3 }
    assert_eq(b == other, false)
    assert_eq(b != other, true)
}

@test
fn test_nullable_struct_vs_non_nullable() {
    let a: Point? = Point { x: 5, y: 5 }
    let b: Point = Point { x: 5, y: 5 }
    assert_eq(a == b, true)
    assert_eq(b == a, true)
}

// Side-effect safety: the guarded form must evaluate each operand exactly
// once even if it's a function call.
global __call_count: int = 0

fn side_effect_pt() -> Point? {
    __call_count = __call_count + 1
    Point { x: 1, y: 2 }
}

@test
fn test_nullable_side_effect_once() {
    __call_count = 0
    let p: Point? = Point { x: 1, y: 2 }
    let result = side_effect_pt() == p
    assert_eq(result, true)
    // IIFE guard must evaluate side_effect_pt() exactly once.
    assert_eq(__call_count, 1)
}

// A flat enum (a payload no cdata slot holds) compares leaf by leaf; an absent
// one must still differ from every present one, wherever it was cleared.

enum Label {
    Named(string),
    Counted(int),
    Blank,
}

struct LabelHolder { label: Label? }

fn labels_equal(a: Label?, b: Label?) -> bool { return a == b }

@test
fn test_nullable_flat_enum_params() {
    assert_eq(labels_equal(null, null), true)
    assert_eq(labels_equal(null, Label::Blank), false)
    assert_eq(labels_equal(Label::Blank, null), false)
    assert_eq(labels_equal(Label::Named("a"), Label::Named("a")), true)
}

@test
fn test_nullable_flat_enum_cleared_places() {
    let h = LabelHolder { label: Label::Blank }
    h.label = null
    let xs: [Label?] = [Label::Counted(1)]
    xs[0] = null
    let local: Label? = Label::Blank
    local = null
    assert_eq(h.label == Label::Blank, false)
    assert_eq(xs[0] != Label::Counted(1), true)
    assert_eq(local == Label::Blank, false)
}
