// Nullable type behavior: syntax, struct fields, params, returns,
// assignment promotion, inference, unwrap. Compile-time rejection
// cases are in tests/errors/nullable.rock.err.

struct Opt {
    val: int?
}

struct OptAny {
    val: any?
}

struct S {}

fn process(maybe_int: int?) {
    print("processed")
}

fn get_opt() -> int? {
    return 5
}

fn get_opt_null() -> int? {
    return null
}

@test(output = "5\nhello\ntrue\ntrue\n0\ntrue")
fn test_optional_type_syntax() {
    let x: int? = null
    x = 5
    print(x)
    let s: string? = null
    s = "hello"
    print(s)
    let b: bool? = true
    print(b)
    let arr: [int]? = null
    print(arr == null)
    let elems: [int?] = []
    print(elems.len())
    let st: S? = null
    print(st == null)
}

@test(output = "5\ntrue\ntrue\n5")
fn test_optional_in_struct_field() {
    let o = Opt { val: 5 }
    print(o.val)
    o.val = null
    print(o.val == null)
    let p = Opt { val: null }
    print(p.val == null)
    p.val = 5
    print(p.val)
}

@test(output = "5")
fn test_any_struct_field() {
    let o = OptAny { val: 5 }
    print(o.val)
}

@test(output = "processed\nprocessed")
fn test_optional_in_function_param() {
    process(5)
    process(null)
}

@test(output = "5\nnull returned")
fn test_optional_in_function_return() {
    let result = get_opt()
    print(result)

    let null_result = get_opt_null()
    if null_result == null {
        print("null returned")
    }
}

@test(output = "true")
fn test_assign_null_to_optional_t() {
    let opt_x: int? = 5
    opt_x = null
    print(opt_x == null)
}

@test(output = "5\ntrue")
fn test_nullable_inference() {
    let opt_val: int? = 5
    let inferred = opt_val
    print(inferred)
    let n = null
    let inferred_any = n
    print(inferred_any == null)
}

@test(output = "5\n5")
fn test_unwrap() {
    let x: int? = 5
    print(x.unwrap())
    let y = x.unwrap()
    print(y)
}

@test(output = "5\n5")
fn test_unwrap_inside_if_expression() {
    let x: int? = 5
    let plain = if true {
        x.unwrap()
    } else {
        6
    }
    print(plain)
    let shadowed = if true {
        let z = x.unwrap()
        z
    } else {
        6
    }
    print(shadowed)
}

@test(output = "42")
fn test_conditional_nullable_assignment() {
    let x: int? = null
    if true {
        x = 42
    }
    if x != null {
        print(x)
    }
}

@test(output = "42")
fn test_nested_nullable_operations() {
    let container = Opt { val: 42 }
    if container.val != null {
        let unwrapped = container.val
        print(unwrapped)
    }
}

@test(output = "true")
fn test_nullable_comparisons() {
    let x: int? = 5
    let y: int? = null
    print(x != null && y == null)
}
