@test(output = "3\n20")
fn arrays_in_functions() {
    let arr = [10, 20, 30]
    print(get_array_length(arr))
    print(get_second_element(arr))
}

fn get_array_length(arr: [int]) -> int {
    return vec_len(arr)
}

fn get_second_element(arr: [int]) -> int {
    return arr[1]
}

@test(output = "3\n1\n2\n3")
fn arrays_in_functions_complex() {
    let result = create_and_process_array()
    print(vec_len(result))
    print(result[0])
    print(result[1])
    print(result[2])
}

fn create_and_process_array() -> [int] {
    let arr = [1, 2]
    vec_push(arr, 3)
    return arr
}

// ============================================
// Block Return Semantics
// ============================================

@test(output = "early")
fn nested_if_with_return_branches() {
    let result = test_nested_returns(true)
    print(result)
}

fn test_nested_returns(flag: bool) -> string {
    if flag {
        if true {
            return "early"
        }
        return "middle"
    }
    return "late"
}

@test(output = "then")
fn nested_if_with_return_in_both_branches() {
    let result = test_both_branches(true)
    print(result)
}

fn test_both_branches(condition: bool) -> string {
    if condition {
        return "then"
    } else {
        return "else"
    }
}

@test(output = "42\n5")
fn bare_expression_last() {
    let result = get_value_implicit()
    print(result)

    let computed = compute_something()
    print(computed)
}

fn get_value_implicit() -> int {
    let x = 40
    x + 2  // Implicit return
}

fn compute_something() -> int {
    let base = 3
    base + 2  // This should be implicitly returned
}

