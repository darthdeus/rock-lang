// ============================================
// Coroutine tests
// ============================================

co fn simple() -> Coroutine<int> {
    yield 1
    yield 2
    yield 3
}

@test(output = "1\n2\n3")
fn coroutine_basic() {
    let coro = simple()
    print(coro.resume())
    print(coro.resume())
    print(coro.resume())
}

co fn evens(max: int) -> Coroutine<int> {
    let i = 0
    while i < max {
        yield i
        i += 2
    }
}

@test(output = "0\n2\n4\n6\n8")
fn coroutine_with_loop() {
    let coro = evens(10)
    print(coro.resume())
    print(coro.resume())
    print(coro.resume())
    print(coro.resume())
    print(coro.resume())
}

// ============================================
// Helper structures for operator overloading
// ============================================

struct AdvVec2 {
    x: float,
    y: float,
}

operator +(a: AdvVec2, b: AdvVec2) -> AdvVec2 {
    return AdvVec2 { x: a.x + b.x, y: a.y + b.y }
}

operator -(a: AdvVec2, b: AdvVec2) -> AdvVec2 {
    return AdvVec2 { x: a.x - b.x, y: a.y - b.y }
}

operator *(v: AdvVec2, s: float) -> AdvVec2 {
    return AdvVec2 { x: v.x * s, y: v.y * s }
}

operator /(v: AdvVec2, s: float) -> AdvVec2 {
    return AdvVec2 { x: v.x / s, y: v.y / s }
}

struct AdvPoint {
    x: int,
    y: int,
}

struct Player {
    position: AdvPoint,
    health: int,
}

global global_counter: int = 100

// ============================================
// Compound Assignment Tests - Basic
// ============================================

@test(output = "15\n10\n30\n3")
fn compound_assign_basic() {
    let a = 5
    let b = 20
    let c = 6
    let d = 12

    a += 10
    print(a)

    b -= 10
    print(b)

    c *= 5
    print(c)

    d = d ./ 4
    print(d)
}

@test(output = "17")
fn compound_assign_precedence() {
    let x = 5
    x += 3 * 4  // Should be 5 + (3 * 4) = 17
    print(x)
}

// ============================================
// Compound Assignment with Struct Fields
// ============================================

@test(output = "15\n25")
fn compound_assign_with_fields() {
    let p = AdvPoint { x: 10, y: 20 }
    p.x += 5
    p.y += 5
    print(p.x)
    print(p.y)
}

@test(output = "15\n90")
fn compound_assign_with_nested_fields() {
    let player = Player {
        position: AdvPoint { x: 10, y: 20 },
        health: 100
    }

    player.position.x += 5
    player.health -= 10

    print(player.position.x)
    print(player.health)
}

@test(output = "42")
fn compound_operator_precedence() {
    let x = 10
    let y = get_value()
    x += y * 2  // Should be 10 + (16 * 2) = 42
    print(x)
}

fn get_value() -> int {
    return 16
}

// ============================================
// Compound Assignment in Control Flow
// ============================================

@test(output = "15")
fn compound_assign_in_if() {
    let x = 10
    if x > 5 {
        x += 5
    }
    print(x)
}

@test(output = "16")
fn compound_assign_in_while() {
    let x = 1
    while x < 10 {
        x *= 2
    }
    print(x)
}

@test(output = "10")
fn compound_assign_in_for() {
    let sum = 0
    for i in [1, 2, 3, 4] {
        sum += i
    }
    print(sum)
}

// ============================================
// Compound Assignment with Globals
// ============================================

@test(output = "150")
fn compound_assign_with_globals() {
    global_counter += 50
    print(global_counter)
    global_counter = 100  // Reset for other tests
}

// ============================================
// Basic Operator Overloading
// ============================================

@test(output = "AdvVec2(8, 10)")
fn operator_overloading() {
    let v1 = AdvVec2 { x: 3.0, y: 4.0 }
    let v2 = AdvVec2 { x: 5.0, y: 6.0 }
    let result = v1 + v2
    print("AdvVec2({result.x}, {result.y})")
}

@test(output = "AdvVec2(8, 10)\nAdvVec2(-2, -2)\nAdvVec2(6, 8)\nAdvVec2(1.5, 2)")
fn complex_operator_overloading() {
    let v1 = AdvVec2 { x: 3.0, y: 4.0 }
    let v2 = AdvVec2 { x: 5.0, y: 6.0 }

    let sum = v1 + v2
    print("AdvVec2({sum.x}, {sum.y})")

    let diff = v1 - v2
    print("AdvVec2({diff.x}, {diff.y})")

    let scaled = v1 * 2.0
    print("AdvVec2({scaled.x}, {scaled.y})")

    let divided = v1 / 2.0
    print("AdvVec2({divided.x}, {divided.y})")
}

