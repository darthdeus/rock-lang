// ============================================
// Safe navigation tests
// ============================================

@test(output = "5\nnil")
fn safe_navigation_basic() {
    let f_val = Foo { value: 5 }
    let f: Foo? = f_val
    print(f?.value)
    
    let g: Foo? = null
    print(g?.value)
}

@test(output = "10\nnil")
fn safe_navigation_chain() {
    let o1 = Outer { inner: Inner { value: 10 } }
    print(o1.inner?.value)
    
    let o2 = Outer { inner: null }
    print(o2.inner?.value)
}

// ============================================
// Type casting tests
// ============================================

@test(output = "42\n42")
fn type_casting() {
    let x = 42
    let y = 42.0
    
    print(x)
    print(float_to_int(y))
}

@test
fn float_int_casting() {
    let f: float = 3.14
    let i: int = f as int
    let round_trip: float = i as float

    assert_eq(i, 3)
    assert_eq(round_trip, 3.0)
}

