// ============================================
// Enum tests
// ============================================

@test
fn enum_basic() {
    let c1 = Color::Red
    let c2 = Color::Green
    let c3 = Color::Blue

    assert_eq(c1 == Color::Red, true)
    assert_eq(c2 == Color::Green, true)
    assert_eq(c3 == Color::Blue, true)
    assert_eq(c1 == c2, false)
}

@test(output = "42")
fn enum_with_data() {
    let a = Option::Some(42)
    let _b: Option<int> = Option::None
    
    // Test pattern matching instead
    match a {
        Option::Some(val) => print(val),
        Option::None => print(0)
    }
}

