@test(output = "42")
fn let_binding_with_if_else() {
    let condition = true
    let value = if condition { 42 } else { 0 }
    print(value)
}

// ============================================
// Comprehensive Enum Pattern Matching
// ============================================

enum Shape {
    Square { width: int },
    Rect { width: int, height: int },
    Circle(int),
}

@test(output = "100\n200\n314")
fn comprehensive_enum_pattern_matching() {
    let square = Shape::Square { width: 10 }
    let rect = Shape::Rect { width: 10, height: 20 }
    let circle = Shape::Circle(10)

    print(calculate_area(square))
    print(calculate_area(rect))
    print(calculate_area(circle))
}

fn calculate_area(shape: Shape) -> int {
    let area = match shape {
        Shape::Square { width } => width * width,
        Shape::Rect { width, height } => width * height,
        Shape::Circle(radius) => 314,
    }
    return area
}
