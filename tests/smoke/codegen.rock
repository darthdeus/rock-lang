// Broad code-generation smoke tests: arithmetic, string interpolation,
// methods, let bindings, loops, tuples, enums, structs, closures, safe
// navigation, casts, arrays, maps, nullables and coroutines, then compound
// assignment, operator overloading, array and vector index writes, nested
// if/return shapes and enum pattern matching.

// ============================================
// Helper structures and functions
// ============================================

struct FixVec2 {
    x: float,
    y: float,
}

fn length(v: FixVec2) -> float {
    return (v.x * v.x + v.y * v.y).sqrt()
}

fn double_string(x: string, suffix: string) -> string {
    return "{x}{x}{suffix}"
}

struct Point { x: int, y: int }

struct Rectangle { width: int, height: int }

fn area(r: Rectangle) -> int {
    return r.width * r.height
}

struct Foo { value: int }

struct Inner { value: int }
struct Outer { inner: Inner? }

enum Color { Red, Green, Blue }

enum Option<T> { Some(T), None }

// ============================================
// Basic codegen, interpolation, methods, loops
// ============================================

@test(output = "4\n5\n7\n37")
fn simple_codegen_arithmetic_and_increment() {
    print(1 + 3)
    let x = 5
    print(x++)
    print(++x)
    x = 37
    print(x)
}

@test(output = "a1b2c7\nx=42\nx = 42\ncalc=9\ntruth: true, lie: false\nnothing: nil\nsay hi!")
fn string_interpolation_shapes() {
    print("a{1}b{2}c{3+4}")
    let x = 42
    print("x={x}")
    print("x = {x}")
    print("calc={(1+2)*3}")
    print("truth: {true}, lie: {false}")
    print("nothing: {null}")
    print("say {\"hi\"}!")
}

@test(output = "hihiho\n5\n15\n15")
fn method_and_struct_codegen() {
    print("hi".double_string("ho"))
    let v = FixVec2 { x: 3, y: 4 }
    print(v.length())
    let p = Point { x: 5, y: 10 }
    print(p.x + p.y)
    let rect = Rectangle { width: 3, height: 5 }
    print(rect.area())
}

@test(output = "0\n1\n2\n0 \n1 \n2 \n1 \n2 \n3")
fn loops() {
    let i = 0
    while i < 3 {
        print(i)
        i += 1
    }
    for j in 0..3 {
        print("{j} ")
    }
    let arr = [1, 2, 3]
    for x in arr {
        print("{x} ")
    }
}

@test(output = "4\n2\n8")
fn tuple_access_and_closure_capture() {
    let t = (4, 2)
    print(t.0)
    print(t.1)
    let x = 3
    let add = y => x + y
    print(add(5))
}

// ============================================
// Enum tests
// ============================================

@test(output = "42")
fn enum_compare_and_payload_match() {
    let c1 = Color::Red
    let c2 = Color::Green
    let c3 = Color::Blue

    assert_eq(c1 == Color::Red, true)
    assert_eq(c2 == Color::Green, true)
    assert_eq(c3 == Color::Blue, true)
    assert_eq(c1 == c2, false)

    let a = Option::Some(42)
    let _b: Option<int> = Option::None
    match a {
        Option::Some(val) => print(val),
        Option::None => print(0)
    }
}

// ============================================
// Safe navigation, casts, maps, nullables
// ============================================

@test(output = "5\nnil\n10\nnil")
fn safe_navigation() {
    let f_val = Foo { value: 5 }
    let f: Foo? = f_val
    print(f?.value)
    let g: Foo? = null
    print(g?.value)

    let o1 = Outer { inner: Inner { value: 10 } }
    print(o1.inner?.value)
    let o2 = Outer { inner: null }
    print(o2.inner?.value)
}

@test(output = "42")
fn type_casting() {
    let y = 42.0
    print(float_to_int(y))

    let f: float = 3.14
    let i: int = f as int
    let round_trip: float = i as float
    assert_eq(i, 3)
    assert_eq(round_trip, 3.0)
}

@test(output = "100\nnil\nValue: 42\nDefault: 0")
fn maps_and_nullables() {
    let m: Map<string, int> = map_new()
    insert(m, "hp", 100)
    print(get(m, "hp"))
    print(get(m, "missing"))
    let x: int? = 42
    print("Value: {unwrap(x)}")
    let n: int? = null
    print("Default: {unwrap_or(n, 0)}")
}

// ============================================
// Coroutine tests
// ============================================

co fn evens(max: int) -> Coroutine<int> {
    let i = 0
    while i < max {
        yield i
        i += 2
    }
}

@test(output = "0\n2\n4\n6\n8")
fn coroutine_with_loop() {
    let coro = evens(10)
    for _i in 0..5 {
        print(coro.resume())
    }
}

// ============================================
// Helper structures for operator overloading
// ============================================

struct AdvVec2 {
    x: float,
    y: float,
}

operator +(a: AdvVec2, b: AdvVec2) -> AdvVec2 {
    return AdvVec2 { x: a.x + b.x, y: a.y + b.y }
}

operator -(a: AdvVec2, b: AdvVec2) -> AdvVec2 {
    return AdvVec2 { x: a.x - b.x, y: a.y - b.y }
}

operator *(v: AdvVec2, s: float) -> AdvVec2 {
    return AdvVec2 { x: v.x * s, y: v.y * s }
}

operator /(v: AdvVec2, s: float) -> AdvVec2 {
    return AdvVec2 { x: v.x / s, y: v.y / s }
}

struct AdvPoint {
    x: int,
    y: int,
}

struct Player {
    position: AdvPoint,
    health: int,
}

global global_counter: int = 100

// ============================================
// Compound assignment
// ============================================

@test(output = "15\n10\n30\n3\n17\n15\n90\n16")
fn compound_assign() {
    let a = 5
    let b = 20
    let c = 6
    let d = 12

    a += 10
    print(a)

    b -= 10
    print(b)

    c *= 5
    print(c)

    d = d ./ 4
    print(d)

    let x = 5
    x += 3 * 4  // Should be 5 + (3 * 4) = 17
    print(x)

    let player = Player {
        position: AdvPoint { x: 10, y: 20 },
        health: 100
    }
    player.position.x += 5
    player.health -= 10
    print(player.position.x)
    print(player.health)

    let w = 1
    while w < 10 {
        w *= 2
    }
    print(w)
}

@test(output = "150")
fn compound_assign_with_globals() {
    global_counter += 50
    print(global_counter)
    global_counter = 100  // Reset for other tests
}

// ============================================
// Basic Operator Overloading
// ============================================

@test(output = "AdvVec2(8, 10)\nAdvVec2(-2, -2)\nAdvVec2(6, 8)\nAdvVec2(1.5, 2)")
fn complex_operator_overloading() {
    let v1 = AdvVec2 { x: 3.0, y: 4.0 }
    let v2 = AdvVec2 { x: 5.0, y: 6.0 }

    let sum = v1 + v2
    print("AdvVec2({sum.x}, {sum.y})")

    let diff = v1 - v2
    print("AdvVec2({diff.x}, {diff.y})")

    let scaled = v1 * 2.0
    print("AdvVec2({scaled.x}, {scaled.y})")

    let divided = v1 / 2.0
    print("AdvVec2({divided.x}, {divided.y})")
}

// ============================================
// Arrays and vecs
// ============================================

@test(output = "0\n1\n2\n10\n11\n12\n20\n30")
fn array_index_read_write() {
    let arr = [0, 1, 2]

    print(arr[0])
    print(arr[1])
    print(arr[2])

    arr[0] = 10
    arr[1] = 11
    arr[2] = 12

    print(arr[0])
    print(arr[1])
    print(arr[2])

    let wide = [10, 20, 30, 40]
    let i = 1
    print(wide[i])
    let j = i + 1
    print(wide[j])
}

@test(output = "4\n40\n30\n40")
fn array_literal_push() {
    let v = [10, 20, 30]
    vec_push(v, 40)
    print(vec_len(v))
    print(vec_get(v, 3))
    print(vec_get(v, 2))
    let last_index = vec_len(v) - 1
    print(v[last_index])
}

fn get_array_length(arr: [int]) -> int {
    return vec_len(arr)
}

fn get_second_element(arr: [int]) -> int {
    return arr[1]
}

fn create_and_process_array() -> [int] {
    let arr = [1, 2]
    vec_push(arr, 3)
    return arr
}

@test(output = "3\n20\n3\n1\n2\n3")
fn arrays_in_functions() {
    let arr = [10, 20, 30]
    print(get_array_length(arr))
    print(get_second_element(arr))
    let result = create_and_process_array()
    print(vec_len(result))
    print(result[0])
    print(result[1])
    print(result[2])
}

// ============================================
// Block Return Semantics
// ============================================

fn test_nested_returns(flag: bool) -> string {
    if flag {
        if true {
            return "early"
        }
        return "middle"
    }
    return "late"
}

fn test_both_branches(condition: bool) -> string {
    if condition {
        return "then"
    } else {
        return "else"
    }
}

fn get_value_implicit() -> int {
    let x = 40
    x + 2  // Implicit return
}

@test(output = "early\nthen\n42\n42")
fn block_return_semantics() {
    print(test_nested_returns(true))
    print(test_both_branches(true))
    print(get_value_implicit())
    let condition = true
    let value = if condition { 42 } else { 0 }
    print(value)
}

// ============================================
// Comprehensive Enum Pattern Matching
// ============================================

enum Shape {
    Square { width: int },
    Rect { width: int, height: int },
    Circle(int),
}

@test(output = "100\n200\n314")
fn comprehensive_enum_pattern_matching() {
    let square = Shape::Square { width: 10 }
    let rect = Shape::Rect { width: 10, height: 20 }
    let circle = Shape::Circle(10)

    print(calculate_area(square))
    print(calculate_area(rect))
    print(calculate_area(circle))
}

fn calculate_area(shape: Shape) -> int {
    let area = match shape {
        Shape::Square { width } => width * width,
        Shape::Rect { width, height } => width * height,
        Shape::Circle(radius) => 314,
    }
    return area
}
