@test(output = "1\n99\n3")
fn array_assignment_via_index() {
    let arr = [1, 2, 3]
    arr[1] = 99
    print(arr[0])
    print(arr[1])
    print(arr[2])
}

@test(output = "0\n1\n2\n10\n11\n12")
fn zero_based_indexing_comprehensive() {
    let arr = [0, 1, 2]

    // Basic indexing
    print(arr[0])
    print(arr[1])
    print(arr[2])

    // Modify via indexing
    arr[0] = 10
    arr[1] = 11
    arr[2] = 12

    print(arr[0])
    print(arr[1])
    print(arr[2])
}

@test(output = "4")
fn vec_indexing_read_write() {
    let v = [1, 2, 3]
    vec_push(v, 4)
    let last_index = vec_len(v) - 1
    print(v[last_index])
}

@test(output = "30")
fn vec_indexing_with_expressions() {
    let v = [10, 20, 30]
    let index = 1 + 1  // 2
    print(v[index])
}

// ============================================
// Array Operations
// ============================================

@test(output = "4\n40\n30")
fn array_literal_desugaring() {
    let v = [10, 20, 30]
    vec_push(v, 40)
    print(vec_len(v))
    print(vec_get(v, 3))
    print(vec_get(v, 2))
