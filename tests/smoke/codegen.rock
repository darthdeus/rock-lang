// Broad code-generation smoke tests: arithmetic, string interpolation,
// methods, let bindings, loops, tuples, enums, structs, closures, safe
// navigation, casts, arrays, maps, nullables and coroutines, then compound
// assignment, operator overloading, array and vector index writes, nested
// if/return shapes and enum pattern matching.

// ============================================
// Helper structures and functions
// ============================================

struct FixVec2 {
    x: float,
    y: float,
}

fn length(v: FixVec2) -> float {
    return (v.x * v.x + v.y * v.y).sqrt()
}

fn double_string(x: string, suffix: string) -> string {
    return "{x}{x}{suffix}"
}

fn string_double(x: string, suffix: string) -> string {
    return "{x}{x}{suffix}"
}

fn string_rev_concat(a: string, b: string) -> string {
    return "{b}{a}"
}

fn string_concat(a: string, b: string) -> string {
    return "{a}{b}"
}

struct Point { x: int, y: int }

struct Rectangle { width: int, height: int }

fn area(r: Rectangle) -> int {
    return r.width * r.height
}

struct Foo { value: int }

struct Inner { value: int }
struct Outer { inner: Inner? }

enum Color { Red, Green, Blue }

enum Option<T> { Some(T), None }

// ============================================
// Basic codegen tests
// ============================================

@test(output = "4")
fn simple_codegen_arithmetic() {
    print(1 + 3)
}

@test(output = "5\n7")
fn simple_codegen_increment() {
    let x = 5
    print(x++)
    print(++x)
}

// ============================================
// String interpolation tests
// ============================================

@test(output = "3")
fn string_interpolation_basic() {
    print("{1 + 2}")
}

@test(output = "a1b2c7")
fn string_interpolation_multiple() {
    print("a{1}b{2}c{3+4}")
}

@test(output = "x=42\nx = 42")
fn string_interpolation_variable() {
    let x = 42
    print("x={x}")
    print("x = {x}")
}

@test(output = "calc=9")
fn string_interpolation_arithmetic() {
    print("calc={(1+2)*3}")
}

@test(output = "truth: true, lie: false")
fn string_interpolation_booleans() {
    print("truth: {true}, lie: {false}")
}

@test(output = "nothing: nil")
fn string_interpolation_null() {
    print("nothing: {null}")
}

@test(output = "say hi!")
fn string_interpolation_nested_string() {
    print("say {\"hi\"}!")
}

@test(output = "hello 1 5 world")
fn string_interpolation_complex() {
    print("hello {1} {2 + 3} world")
}

