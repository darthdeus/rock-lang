struct TestStruct {
    name: string,
    value: int,
}

@test
fn test_simple_tuple_destructuring() {
    let tup: (int, string) = (42, "hello")
    let first = tuple_first(tup)
    let second = tuple_second(tup)
    
    assert_eq(first, 42, "First element should be 42")
    assert_eq(second, "hello", "Second element should be hello")
}

@test 
fn test_struct_in_tuple() {
    let s = TestStruct { name: "test", value: 123 }
    let tup: (int, TestStruct) = (1, s)
    
    let first = tuple_first(tup)
    let second = tuple_second(tup)
    
    assert_eq(first, 1, "First should be 1")
    assert_eq(second.name, "test", "Second should have name 'test'")
    assert_eq(second.value, 123, "Second should have value 123")
}

@test
fn test_arena_to_array_basic() {
    let arena = arena_new()
    let entity = insert(arena, TestStruct { name: "arena_test", value: 456 })
    
    let count = 0
    for (e, data) in arena {
        count += 1
        assert_eq(data.name, "arena_test", "Data name should match")
        assert_eq(data.value, 456, "Data value should match")
    }
    assert_eq(count, 1, "Arena should have 1 element")
}

@test
fn test_vec_iteration_with_tuples() {
    let vec = vec_new()
    vec_push(vec, (1, "first"))
    vec_push(vec, (2, "second"))
    
    // Get first element directly
    let first_tuple = unwrap(vec_get(vec, 0))
    let first_num = tuple_first(first_tuple)
    let first_str = tuple_second(first_tuple)
    
    assert_eq(first_num, 1, "First number should be 1")
    assert_eq(first_str, "first", "First string should be 'first'")
}

@test
fn test_map_to_array_with_tuples() {
    let map = map_new()
    insert(map, "key1", TestStruct { name: "map_test", value: 789 })
    
    let arr = to_array(map)
    assert_eq(vec_len(arr), 1, "Map should have 1 element")
    
    let first_item = vec_get(arr, 0).unwrap()
    let key = tuple_first(first_item)
    let value = tuple_second(first_item)
    
    assert_eq(key, "key1", "Key should be 'key1'")
    assert_eq(value.name, "map_test", "Value name should match")
    assert_eq(value.value, 789, "Value should match")
}