// Regression fixture for nested nullable nobox coalescing with a diverging tail.

nobox value SpaceId { value: int }

fn maybe_space(present: bool) -> SpaceId? {
    if present { return SpaceId { value: 7 } }
    return null
}

fn choose_space(present: bool) -> SpaceId? {
    let space = maybe_space(present) ?? maybe_space(false) ?? {
        return null
    }
    return space
}

@test(output = "7\nnull")
fn nested_coalesce_diverges_after_null() {
    let present = choose_space(true)
    if present == null { print("missing") } else { print("{present.value}") }
    let absent = choose_space(false)
    if absent == null { print("null") } else { print("{absent.value}") }
}

@test(output = "7")
fn nested_coalesce_without_diverging_tail() {
    let space = maybe_space(false) ?? maybe_space(true) ?? maybe_space(false)
    if space == null { print("null") } else { print("{space.value}") }
}
