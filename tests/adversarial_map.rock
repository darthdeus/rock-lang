// Adversarial tests: Map operations

// --- Basic map operations ---

@test(output = "42")
fn test_map_insert_get() {
    let m: Map<string, int> = map_new()
    insert(m, "key", 42)
    let val = get(m, "key")
    if val != null {
        print(val)
    }
}

@test(output = "missing")
fn test_map_get_missing() {
    let m: Map<string, int> = map_new()
    let val = get(m, "nonexistent")
    if val == null {
        print("missing")
    }
}

// --- Map size ---

@test(output = "3")
fn test_map_size() {
    let m: Map<string, int> = map_new()
    insert(m, "a", 1)
    insert(m, "b", 2)
    insert(m, "c", 3)
    print(m.len())
}

@test(output = "0")
fn test_empty_map_size() {
    let m: Map<string, int> = map_new()
    print(m.len())
}

// --- Map overwrite ---

@test(output = "20")
fn test_map_overwrite() {
    let m: Map<string, int> = map_new()
    insert(m, "key", 10)
    insert(m, "key", 20)
    let val = get(m, "key") ?? -1
    print(val)
}

// --- Map remove ---

@test(output = "missing")
fn test_map_remove() {
    let m: Map<string, int> = map_new()
    insert(m, "key", 42)
    remove(m, "key")
    let val = get(m, "key")
    if val == null {
        print("missing")
    }
}

// --- Map contains ---

@test(output = "true false")
fn test_map_contains() {
    let m: Map<string, int> = map_new()
    insert(m, "a", 1)
    print("{m.contains("a")} {m.contains("b")}")
}

// --- Map iteration ---

@test(output = "2")
fn test_map_iteration_count() {
    let m: Map<string, int> = map_new()
    insert(m, "x", 10)
    insert(m, "y", 20)
    let count = 0
    for (k, v) in m {
        count = count + 1
    }
    print(count)
}

// --- Map with int keys ---

@test(output = "hello")
fn test_map_int_keys() {
    let m: Map<int, string> = map_new()
    insert(m, 42, "hello")
    let val = get(m, 42) ?? "missing"
    print(val)
}

// --- Map with nullable values ---

@test(output = "present")
fn test_map_nullable_values() {
    let m: Map<string, int?> = map_new()
    insert(m, "a", 42)
    insert(m, "b", null)
    let a = get(m, "a")
    if a != null {
        print("present")
    }
}

// --- Map with struct values ---

struct Point {
    x: int,
    y: int,
}

@test(output = "3 4")
fn test_map_struct_values() {
    let m: Map<string, Point> = map_new()
    insert(m, "origin", Point { x: 3, y: 4 })
    let p = get(m, "origin")
    if p != null {
        print("{p.x} {p.y}")
    }
}

// --- UFCS style map operations ---

@test(output = "42")
fn test_map_ufcs_style() {
    let m: Map<string, int> = map_new()
    m.insert("key", 42)
    let val = m.get("key") ?? -1
    print(val)
}
