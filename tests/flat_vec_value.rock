// FlatVec<T> v0: growable flat storage for FFI-clean value structs. Exercises
// push (with growth past the initial capacity), indexed get/set, len/clear, and
// non-capturing sort. The emit test pins the zero-`_ct` lowering shape; this is
// the runtime oracle.

value RayTarget { angle: float, x: float, y: float }

@test(output = "0\n3\n7\n2\n42")
fn test_flat_vec_push_get_len() {
    let rays: FlatVec<RayTarget> = flat_vec_new(2)   // small cap -> push forces a grow
    print("{rays.len}")                     // 0

    rays.push(RayTarget { angle: 0.5, x: 1.0, y: 2.0 })
    rays.push(RayTarget { angle: 0.1, x: 3.0, y: 4.0 })
    rays.push(RayTarget { angle: 0.9, x: 5.0, y: 6.0 })   // triggers 2 -> 4 grow
    print("{rays.len}")                     // 3

    // The grown buffer preserved every element field-wise.
    let sum = rays.get(0).x + rays.get(1).x + rays.get(2).x   // 1 + 3 + 5 = 9
    print("{(sum - 2.0).floor()}")          // 7

    rays.set(1, RayTarget { angle: 0.1, x: 30.0, y: 40.0 })
    print("{(rays.get(1).x - 28.0).floor()}")   // 2

    rays.clear()
    rays.push(RayTarget { angle: 0.0, x: 42.0, y: 0.0 })
    print("{rays.get(0).x.floor()}")        // 42
}

@test(output = "0.1\n0.5\n0.9")
fn test_flat_vec_sort_non_capturing() {
    let rays: FlatVec<RayTarget> = flat_vec_new(4)
    rays.push(RayTarget { angle: 0.9, x: 0.0, y: 0.0 })
    rays.push(RayTarget { angle: 0.1, x: 0.0, y: 0.0 })
    rays.push(RayTarget { angle: 0.5, x: 0.0, y: 0.0 })

    rays.sort((t) => t.angle)   // capture-free key -> shared fn, no per-call closure

    for i in 0..rays.len {
        print("{rays.get(i).angle}")
    }
}

// Descending input -- the insertion-sort worst case, where every element shifts
// the whole prefix. The pivot is held across those shifts, so this is what goes
// wrong if a whole-value element read binds interior storage instead of copying:
// the shift overwrites the slot the pivot came from and the sort loses elements.
@test(output = "1\n2\n3\n4\n5\n15")
fn test_flat_vec_sort_pivot_survives_shifts() {
    let rays: FlatVec<RayTarget> = flat_vec_new(8)
    for i in 0..5 {
        let k = (5 - i) as float
        rays.push(RayTarget { angle: k, x: k, y: k })
    }

    rays.sort((t) => t.angle)

    let sum = 0.0
    for i in 0..rays.len {
        print("{rays.get(i).angle.floor()}")
        sum = sum + rays.get(i).x
    }
    print("{sum.floor()}")   // every element still present exactly once
}
