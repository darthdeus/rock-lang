// Regression: Map<Newtype, V> direct indexing must unwrap newtype keys
// on both read and write. Previously `m[k] = v` stored at the wrapped
// key (table identity), while `m.get(k)` and `map_*` wrappers unwrapped
// to the underlying primitive — writes and reads disagreed.

newtype UserId(int)
newtype Tag(string)

@test
fn test_direct_write_direct_read() {
    let m: Map<UserId, string> = map_new()
    let k = UserId(42)
    m[k] = "alice"
    let v = m[k]
    assert_eq(v, "alice", "direct write -> direct read roundtrip")
}

@test
fn test_direct_write_ufcs_get() {
    let m: Map<UserId, string> = map_new()
    let k = UserId(7)
    m[k] = "bob"
    let v = m.get(k) ?? "MISSING"
    assert_eq(v, "bob", "direct write visible via .get()")
}

@test
fn test_map_insert_then_direct_read() {
    let m: Map<UserId, string> = map_new()
    let k = UserId(3)
    insert(m, k, "eve")
    let v = m[k]
    assert_eq(v, "eve", "insert value readable via m[k]")
}

@test
fn test_map_remove_newtype() {
    let m: Map<UserId, string> = map_new()
    m[UserId(1)] = "a"
    m[UserId(2)] = "b"
    let removed = remove(m, UserId(1)) ?? ""
    assert_eq(removed, "a", "removed returns value")
    assert_true(m.get(UserId(1)) == null, "removed key is gone")
    assert_eq(m.get(UserId(2)) ?? "", "b", "other keys intact")
}

@test
fn test_map_clear_newtype() {
    let m: Map<UserId, string> = map_new()
    m[UserId(1)] = "a"
    m[UserId(2)] = "b"
    m[UserId(3)] = "c"
    clear(m)
    assert_eq(m.len(), 0, "cleared len=0")
    assert_true(m.get(UserId(1)) == null, "k1 gone")
    assert_true(m.get(UserId(2)) == null, "k2 gone")
}

@test
fn test_string_newtype_key() {
    let m: Map<Tag, int> = map_new()
    m[Tag("score")] = 100
    m[Tag("hp")] = 42
    assert_eq(m.get(Tag("score")) ?? 0, 100, "string newtype roundtrip")
    assert_eq(m[Tag("hp")], 42, "string newtype direct read")
}
