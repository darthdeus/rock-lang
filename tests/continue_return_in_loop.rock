// Tests that continue and return can coexist in the same for loop.
// Bug: using both continue and return in a for loop with an if/else
// block before the return causes a parse error.

@test(output = "found 3")
fn simple_continue_then_return() {
    print(find_first_over_2())
}

fn find_first_over_2() -> string {
    for i in 0..5 {
        if i <= 2 { continue }
        return "found {i}"
    }
    return "not found"
}

@test(output = "yes 3")
fn continue_then_ifelse_then_return() {
    print(find_with_ifelse(true))
}

fn find_with_ifelse(flag: bool) -> string {
    for i in 0..5 {
        if i <= 2 { continue }

        let result = ""
        if flag {
            result = "yes"
        } else {
            result = "no"
        }

        return "{result} {i}"
    }
    return "not found"
}

@test(output = "updated 3")
fn continue_then_ifelse_then_mutate_then_return() {
    print(find_and_mutate())
}

fn find_and_mutate() -> string {
    let state = ""
    for i in 0..5 {
        if i <= 2 { continue }

        if i > 2 {
            state = "updated"
        } else {
            state = "other"
        }

        state = "{state} {i}"
        return state
    }
    return "not found"
}

global SIDE_EFFECT: int = 0

@test(output = "42")
fn continue_then_bare_return_in_void_fn() {
    do_stuff()
    print(SIDE_EFFECT)
}

fn do_stuff() {
    for i in 0..5 {
        if i <= 2 { continue }

        if i == 3 {
            SIDE_EFFECT = 42
        } else {
            SIDE_EFFECT = 0
        }

        return
    }
}
