// Prototype: Type hole testing in Rock
// This demonstrates how we could test type inference using type holes
// Note: This requires extending @test to support type_holes parameter

// PROPOSED SYNTAX (not yet implemented):
// @test(type_holes = [[hole_id, "expected_type"], ...])

// The basic, generic-function, struct-field and nested-type examples are
// checked with type_holes assertions in type_hole_tests.rock.

fn greet(name: string) -> string {
    return "Hello, {name}!"
}

// Example 5: Function return type inference
@test
fn test_function_return_inference() {
    // Future: @test(type_holes = [[0, "string"]])
    // Note: Can't use type holes in function signatures yet
    
    assert_eq(greet("World"), "Hello, World!")
}

// Example 6: Nullable type inference
@test
fn test_nullable_type_inference() {
    // Future: @test(type_holes = [[0, "int?"], [1, "int"]])
    
    let maybe_val: int? = null          // Can't use hole with cast
    let default_val: ? = maybe_val ?? 42 // hole 1 -> should infer to int
    
    assert_eq(default_val, 42)
}

// Example 7: Combined output and type hole testing
// This shows how we could combine both features
@test(output = "Type: int\nValue: 42")
fn test_combined_output_and_types() {
    // Future: @test(output = "...", type_holes = [[0, "int"]])
    
    let x: ? = 42                       // hole 0 -> should infer to int
    print("Type: int")  // Manual for now, could be automated
    print("Value: {x}")
}

// Note: These tests currently only verify runtime behavior.
// With the proposed @test(type_holes = ...) extension,
// we could also verify compile-time type inference.