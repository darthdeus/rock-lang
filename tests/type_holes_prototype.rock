// Prototype: Type hole testing in Rock
// This demonstrates how we could test type inference using type holes
// Note: This requires extending @test to support type_holes parameter

// PROPOSED SYNTAX (not yet implemented):
// @test(type_holes = [[hole_id, "expected_type"], ...])

// Helper functions and types
fn identity<T>(x: T) -> T { 
    return x 
}

struct Point { 
    x: int, 
    y: int 
}

fn greet(name: string) -> string {
    return "Hello, {name}!"
}

// Example 1: Basic type inference
// Equivalent to assert_type_at tests
@test
fn test_basic_type_inference() {
    // In the future, we could write:
    // @test(type_holes = [[0, "int"], [1, "string"], [2, "float"]])
    
    let x: ? = 42           // hole 0 -> should infer to int
    let y: ? = "hello"      // hole 1 -> should infer to string  
    let z: ? = 3.14         // hole 2 -> should infer to float
    
    // For now, we can at least verify the values work correctly
    assert_eq(x, 42)
    assert_eq(y, "hello")
    assert_eq(z, 3.14)
}

// Example 2: Generic function type inference
@test
fn test_generic_function_inference() {
    // Future: @test(type_holes = [[0, "[int]"], [1, "int"]])
    
    let arr: ? = [1, 2, 3]              // hole 0 -> should infer to [int]
    let elem: ? = identity(arr[0])      // hole 1 -> should infer to int
    
    assert_eq(elem, 1)
}

// Example 3: Struct field type inference
@test
fn test_struct_field_inference() {
    // Future: @test(type_holes = [[0, "Point"], [1, "int"], [2, "int"]])
    
    let p: ? = Point { x: 10, y: 20 }  // hole 0 -> should infer to Point
    let x_val: ? = p.x                  // hole 1 -> should infer to int
    let y_val: ? = p.y                  // hole 2 -> should infer to int
    
    assert_eq(x_val, 10)
    assert_eq(y_val, 20)
}

// Example 4: Complex nested types
@test
fn test_nested_type_inference() {
    // Future: @test(type_holes = [[0, "[[int]]"], [1, "[int]"], [2, "int"]])
    
    let matrix: ? = [[1, 2], [3, 4]]    // hole 0 -> should infer to [[int]]
    let row: ? = matrix[0]              // hole 1 -> should infer to [int]
    let elem: ? = row[1]                // hole 2 -> should infer to int
    
    assert_eq(elem, 2)
}

// Example 5: Function return type inference
@test
fn test_function_return_inference() {
    // Future: @test(type_holes = [[0, "string"]])
    // Note: Can't use type holes in function signatures yet
    
    assert_eq(greet("World"), "Hello, World!")
}

// Example 6: Nullable type inference
@test
fn test_nullable_type_inference() {
    // Future: @test(type_holes = [[0, "int?"], [1, "int"]])
    
    let maybe_val: int? = null          // Can't use hole with cast
    let default_val: ? = maybe_val ?? 42 // hole 1 -> should infer to int
    
    assert_eq(default_val, 42)
}

// Example 7: Combined output and type hole testing
// This shows how we could combine both features
@test(output = "Type: int\nValue: 42")
fn test_combined_output_and_types() {
    // Future: @test(output = "...", type_holes = [[0, "int"]])
    
    let x: ? = 42                       // hole 0 -> should infer to int
    print("Type: int")  // Manual for now, could be automated
    print("Value: {x}")
}

// Note: These tests currently only verify runtime behavior.
// With the proposed @test(type_holes = ...) extension,
// we could also verify compile-time type inference.