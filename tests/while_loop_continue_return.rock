// Tests for continue + return/break in while loops.
// Bug: while loop codegen doesn't wrap return in `do return end`
// when continue is also present, causing invalid Lua.

@test(output = "3")
fn while_continue_then_return() {
    print(while_cr())
}

fn while_cr() -> int {
    let i = 0
    while i < 10 {
        i = i + 1
        if i < 3 { continue }
        return i
    }
    return -1
}

@test(output = "5")
fn while_continue_then_break() {
    let i = 0
    let result = -1
    while i < 10 {
        i = i + 1
        if i < 3 { continue }
        if i > 5 { break }
        result = i
    }
    print(result)
}

global W1: int = 0

@test(output = "42")
fn while_continue_ifelse_return_void() {
    while_void_test()
    print(W1)
}

fn while_void_test() {
    let i = 0
    while i < 10 {
        i = i + 1
        if i < 3 { continue }

        if i == 3 {
            W1 = 42
        } else {
            W1 = 99
        }

        return
    }
}
