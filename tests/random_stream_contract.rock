@test
fn native_rng_matches_gameplay_and_presentation_contract() {
    random_seed(0)
    assert_eq(random(), 0.31659073126502335, "first gameplay draw")
    assert_eq(random_get_state(), 1359758873, "gameplay state is signed 32-bit")
    assert_eq(random(), 0.5607803913298994, "second gameplay draw")
    assert_eq(random_get_state(), -1886404018, "gameplay state wraps signed 32-bit")

    random_seed(0)
    assert_eq(random_int(0, 4294967296), 1359746837, "single draw integer span")
    random_seed(0)
    assert_eq(random_int(-4, 9000000000), 8798616889, "two draw integer span")

    presentation_random_seed(0)
    assert_eq(presentation_random(), 0.31659073126502335, "presentation uses same algorithm")
    assert_eq(presentation_random_get_state(), 1359758873,
        "presentation state is signed 32-bit")
    presentation_random_seed(0)
    assert_eq(presentation_random_int(-4, 9000000000), 8798616889,
        "presentation two draw integer span")
}
