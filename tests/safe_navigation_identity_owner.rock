struct SafeNavOwnerInner { value: int = 0 }

struct SafeNavOwnerMiddle { inner: SafeNavOwnerInner? = null }

struct SafeNavOwnerOuter { middle: SafeNavOwnerMiddle? = null }

fn safe_nav_owner_bump(outer: SafeNavOwnerOuter) {
    outer.middle?.inner?.value += 5
}

@test
fn safe_navigation_write_through_nullable_identity_chain_reaches_the_owner() {
    let outer = SafeNavOwnerOuter {
        middle: SafeNavOwnerMiddle { inner: SafeNavOwnerInner { value: 10 } },
    }
    let held = outer.middle?.inner ?? return
    safe_nav_owner_bump(outer)
    outer.middle?.inner?.value += 1
    assert(held.value == 16, "safe-navigation writes reach the held inner row")
    held.value = 3
    assert((outer.middle?.inner?.value ?? -1) == 3, "writes through the held row reach the owner")
}

@test
fn safe_navigation_write_through_absent_nullable_identity_link_is_skipped() {
    let outer = SafeNavOwnerOuter { middle: SafeNavOwnerMiddle {} }
    safe_nav_owner_bump(outer)
    outer.middle?.inner?.value = 7
    assert(outer.middle?.inner == null, "an absent link stays absent")
}
