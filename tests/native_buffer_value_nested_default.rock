// Adversarial: a value-struct field with a default that's itself a
// nested value-struct LITERAL containing a side-effecting expression.
// Pass-2 in collect_value_struct_leaves recurses into the literal —
// verify the side effect fires once and pass-1 explicit RHS run before
// the default's side effect.

@intrinsic @inline inline(lua) fn put(s: string) = "io.write(s)"

global TICK: int = 0

fn next_tick() -> float {
    TICK = TICK + 1
    return TICK + 0.0
}

value V2 {
    x: float,
    y: float,
}

value Boxed {
    pos: V2 = V2 { x: next_tick(), y: next_tick() },
    n: int,
}

@nomangle inline(lua) fn __nb_alloc_Boxed(n: int) -> Ptr<Boxed> = 'return ffi.new("Boxed[?]", n)'

fn nb_boxed(n: int) -> NativeBuffer<Boxed> {
    return NativeBuffer { ptr: __nb_alloc_Boxed(n), len: n }
}

@test(output = "n=42\npx=1\npy=2\ntick=2")
fn test_nested_default_side_effect() {
    let buf = nb_boxed(1)
    // `n: 42` runs first (pass-1 source order). `pos` is omitted, so
    // pass-2 fills it from the default — recursing into the literal
    // and firing both `next_tick()` calls in literal-source order.
    buf[0] = Boxed { n: 42 }
    let v = buf[0]
    put("n=")
    put("{v.n}")
    put("\n")
    put("px=")
    put("{v.pos.x}")
    put("\n")
    put("py=")
    put("{v.pos.y}")
    put("\n")
    put("tick=")
    put("{TICK}")
    put("\n")
}
