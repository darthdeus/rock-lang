// Struct update, tuple value read copies and no-metatable behavior.

struct Point { x: int, y: int, z: int }

value VPoint { x: int, y: int, z: int }

@test(output = "1 20 3\n1 2 3\n10 20 30")
fn test_update_overrides() {
    let base = Point { x: 1, y: 2, z: 3 }
    let one = Point { ..base, y: 20 }
    print("{one.x} {one.y} {one.z}")
    let none = Point { ..base }
    print("{none.x} {none.y} {none.z}")
    let all = Point { ..base, x: 10, y: 20, z: 30 }
    print("{all.x} {all.y} {all.z}")
}

@test(output = "1 99 3")
fn test_value_struct_update() {
    let base = VPoint { x: 1, y: 2, z: 3 }
    let p = VPoint { ..base, y: 99 }
    print("{p.x} {p.y} {p.z}")
}

// Base is an opaque rvalue (fn return), not a path -- one temp, field reads.
fn make() -> Point {
    Point { x: 5, y: 6, z: 7 }
}

@test(output = "5 6 700")
fn test_update_rvalue_base() {
    let p = Point { ..make(), z: 700 }
    print("{p.x} {p.y} {p.z}")
}

value TupleSnapshotRecipe { label: string, count: int }

value TupleSnapshotPoint { x: float, y: float }

value NestedTupleSnapshot { recipe: TupleSnapshotRecipe, items: [int] }

@test(output = "1 9")
fn tuple_gc_value_read_copies_before_a_second_store() {
    let rows = [("recipe", TupleSnapshotRecipe { label: "mage", count: 1 })]
    let copies = [rows[0].1]
    copies[0].count = 9
    print("{rows[0].1.count} {copies[0].count}")
}

@test(output = "1 9")
fn tuple_cdata_value_read_copies_before_a_second_store() {
    let rows = [("point", TupleSnapshotPoint { x: 1.0, y: 2.0 })]
    let copies = [rows[0].1]
    copies[0].x = 9.0
    print("{rows[0].1.x} {copies[0].x}")
}

@test(output = "1 9")
fn tuple_nullable_value_read_copies_before_a_second_store() {
    let present: TupleSnapshotRecipe? = TupleSnapshotRecipe { label: "mage", count: 1 }
    let absent: TupleSnapshotRecipe? = null
    let rows: [(string, TupleSnapshotRecipe?)] = [("recipe", present), ("absent", absent)]
    let copies = [rows[0].1]
    copies[0]?.count = 9
    print("{rows[0].1.unwrap().count} {copies[0].unwrap().count}")
    assert(rows[1].1 == null)
}

@test(output = "1 9 2")
fn tuple_nested_value_read_copies_and_shares_container_leaves() {
    let rows = [("nested", NestedTupleSnapshot {
        recipe: TupleSnapshotRecipe { label: "mage", count: 1 }, items: [3],
    })]
    let copies = [rows[0].1]
    copies[0].recipe.count = 9
    copies[0].items.push(4)
    print("{rows[0].1.recipe.count} {copies[0].recipe.count} {rows[0].1.items.len()}")
}

struct PointZ { x: int, y: int }

@nomangle inline(lua) fn __test_struct_no_mt() -> bool = """
    local p = __rock_create_struct("PointZ", { x = 1, y = 2 })
    return getmetatable(p) == nil and __rock_get_type(p) == "PointZ"
"""

@test(output = "true", backends = "lua")
fn struct_has_no_metatable() {
    print(__test_struct_no_mt())
}
