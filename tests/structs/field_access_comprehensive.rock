// Struct field reads and writes, nested field chains, inferred field types,
// and self-referential structs.

struct FixVec2 {
    x: int,
    y: int
}

struct FixVec2String {
    x: string,
    y: int
}

struct Rect {
    pos: FixVec2,
    size: FixVec2
}

struct Rt {
    fa: Rt?
}

@test(output = "hello\n10", type_holes = [[0, "FixVec2String"], [1, "string"], [2, "int"], [3, "FixVec2String"]])
fn test_struct_field_access_complex() {
    let v = FixVec2String { x: "hello", y: 10 }
    let struct_type: ? = v
    let x_field: ? = v.x
    let y_field: ? = v.y
    let access_base: ? = v

    print(v.x)
    print(v.y)
}

@test(output = "1\n2\n10\n20")
fn test_struct_field_updates() {
    let v = FixVec2 { x: 1, y: 2 }
    print(v.x)
    print(v.y)
    v.x = 10
    v.y = 20
    print(v.x)
    print(v.y)
}

@test(output = "5\n10\n15\n20\n25")
fn test_nested_field_chains() {
    let rect = Rect {
        pos: FixVec2 { x: 5, y: 10 },
        size: FixVec2 { x: 15, y: 20 }
    }
    print(rect.pos.x)
    print(rect.pos.y)
    print(rect.size.x)
    print(rect.size.y)
    rect.pos.x = 25
    print(rect.pos.x)
}

@test(output = "true\ntrue")
fn test_self_referential_structs() {
    let none = null
    let literal = Rt { fa: Rt { fa: none } }
    print(literal.fa?.fa == null)
    let inner_rt = Rt { fa: null }
    let middle_rt = Rt { fa: inner_rt }
    let outer_rt = Rt { fa: middle_rt }
    print(outer_rt.fa?.fa != null)
}
