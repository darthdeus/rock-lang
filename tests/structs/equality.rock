// `==`/`!=` on structs and aggregates is structural (deep), not reference
// equality. Same-concrete-struct comparisons specialize to a per-struct
// equality instead of the generic __op_eq dispatch and must give the same
// results, including nested, nullable, empty and fn-returned structs. Vec and
// tuple operands also compare deeply on every backend.

struct Point {
    x: int,
    y: int,
}

struct Named {
    name: string,
    score: int,
}

struct Flagged { val: int, enabled: bool }
struct WithNullable { x: int, note: string? }

@test
fn test_flat_struct_equality() {
    let a = Point { x: 1, y: 2 }
    assert_eq(a == Point { x: 1, y: 2 }, true)
    assert_eq(a != Point { x: 1, y: 2 }, false)
    assert_eq(a == Point { x: 1, y: 3 }, false)
    assert_eq(a != Point { x: 1, y: 3 }, true)

    let n = Named { name: "alice", score: 42 }
    assert_eq(n == Named { name: "alice", score: 42 }, true)
    assert_eq(n == Named { name: "bob", score: 42 }, false)

    let f = Flagged { val: 7, enabled: true }
    assert_eq(f == Flagged { val: 7, enabled: true }, true)
    assert_eq(f == Flagged { val: 7, enabled: false }, false)

    let none = WithNullable { x: 1, note: null }
    assert_eq(none == WithNullable { x: 1, note: null }, true)
    assert_eq(none == WithNullable { x: 1, note: "hi" }, false)
    assert_eq(none != WithNullable { x: 1, note: "hi" }, true)
}

// The outer specialized equality recurses into the inner struct's.
struct Nested {
    p: Point,
    q: Point,
    tag: string,
}

struct Holder { inner: Point }

@test
fn test_nested_struct_equality() {
    let a = Nested { p: Point { x: 1, y: 2 }, q: Point { x: 3, y: 4 }, tag: "hi" }
    let b = Nested { p: Point { x: 1, y: 2 }, q: Point { x: 3, y: 4 }, tag: "hi" }
    let c = Nested { p: Point { x: 1, y: 9 }, q: Point { x: 3, y: 4 }, tag: "hi" }
    let d = Nested { p: Point { x: 1, y: 2 }, q: Point { x: 3, y: 5 }, tag: "hi" }
    let e = Nested { p: Point { x: 1, y: 2 }, q: Point { x: 3, y: 4 }, tag: "bye" }
    assert_eq(a == b, true)
    assert_eq(a == c, false)
    assert_eq(a == d, false)
    assert_eq(a == e, false)
    assert_eq(a != c, true)

    let h1 = Holder { inner: Point { x: 1, y: 2 } }
    let h2 = Holder { inner: Point { x: 1, y: 2 } }
    assert_eq(h1.inner == h2.inner, true)
    assert_eq(h1.inner == Point { x: 9, y: 9 }, false)
    assert_eq(h1 == h2, true)
}

fn make_point(x: int, y: int) -> Point { Point { x: x, y: y } }

@test
fn test_literal_and_fn_return_operands() {
    let a = Point { x: 5, y: 5 }
    assert_eq(Point { x: 5, y: 5 } == a, true)
    assert_eq(make_point(1, 2) == Point { x: 1, y: 2 }, true)
    assert_eq(make_point(5, 5) == make_point(5, 5), true)
    assert_eq(make_point(1, 2) != make_point(1, 3), true)
}

@test
fn test_struct_equality_in_conditions() {
    let a = Point { x: 1, y: 1 }
    let b = Point { x: 1, y: 1 }
    let c = Point { x: 2, y: 2 }
    let result = if a == b { "yes" } else { "no" }
    assert_eq(result, "yes")
    assert_eq(a == b && a != c, true)
    assert_eq(a == c || b == a, true)
    assert_eq(true && a == b, true)
    assert_eq(false || a != b, false)
}

@test
fn test_struct_mutation_and_aliasing() {
    let a = Point { x: 1, y: 2 }
    let b = Point { x: 1, y: 2 }
    let alias = a
    assert_eq(a == alias, true)
    a.x = 99
    assert_eq(a == b, false)
    b.x = 99
    assert_eq(a == b, true)
}

struct Empty {}

@test
fn test_empty_struct() {
    let a = Empty {}
    let b = Empty {}
    assert_eq(a == b, true)
    assert_eq(a != b, false)
    assert_eq(a == a, true)
}

// A value struct takes the generic equality path, not a specialized one.
value Pair {
    a: int,
    b: int,
}

@test
fn test_value_struct_equality() {
    let a = Pair { a: 1, b: 2 }
    let b = Pair { a: 1, b: 2 }
    assert_eq(a == b, true)
    assert_eq(a != b, false)
    assert_eq(a == Pair { a: 1, b: 3 }, false)
}

struct Container { items: [int] }

@test
fn test_struct_with_vec_field() {
    let a = Container { items: [1, 2, 3] }
    assert_eq(a == a, true)
    assert_eq(a == Container { items: [1, 2, 3] }, true)
    assert_eq(a == Container { items: [1, 2] }, false)
}

@test(output = "true false\ntrue false\ntrue false\nfalse true")
fn vec_and_tuple_structural_eq() {
    print("{[1, 2, 3] == [1, 2, 3]} {[1, 2, 3] == [1, 2, 4]}")
    let a = [[1, 2], [3]]
    print("{a == [[1, 2], [3]]} {a == [[1, 2], [4]]}")
    let t = (1, 2)
    print("{t == (1, 2)} {t == (1, 3)}")
    let v = [1, 2, 3]
    print("{v != [1, 2, 3]} {v != [9]}")
}
