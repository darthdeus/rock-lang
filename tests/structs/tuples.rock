// Tuples: `let` destructuring (mixed types, nested, single-element, nullable
// elements), tuples passed to and returned from functions, tuple_first and
// tuple_second extraction, and tuples holding structs inside vectors, arenas
// and map-to-array results.

// Helper function for tuple return type test
fn get_pair() -> (string, int?) { 
    return ("val", null) 
}

// Helper function for swap and add test
fn swap_and_add(pair: (int, int)) -> (int, int) {
    let (a, b) = pair
    return (b, a + b)
}

// Runtime behavior tests
@test(output = "10\n20")
fn test_tuple_destructuring_runtime() {
    let point = (10, 20)
    let (x, y) = point
    print(x)
    print(y)
}

@test(output = "true\nval")
fn test_tuple_destructuring_mixed_types() {
    let (x, y) = (true, "val")
    print(x)
    print(y)
}

@test(output = "val\nnil")
fn test_tuple_function_return_runtime() {
    let result = get_pair()
    let (s, i) = result
    print(s)
    print(i)
}

@test(output = "42\nhello\ntrue")
fn test_mixed_tuple_types() {
    let mixed = (42, "hello", true)
    let (num, str, bool) = mixed
    print(num)
    print(str)
    print(bool)
}

@test(output = "inner")
fn test_nested_tuple_destructuring() {
    let nested = (1, ("inner", false))
    let (outer, inner_tuple) = nested
    let (inner_s, inner_b) = inner_tuple
    print(inner_s)
}

@test(output = "20\n30")
fn test_tuple_in_function() {
    let result = swap_and_add((10, 20))
    let (x, y) = result
    print(x)
    print(y)
}

@test(output = "5")
fn test_single_element_tuple() {
    let single = (5,)
    let (x,) = single
    print(x)
}

@test(output = "10\n20\n30\n40")
fn test_four_tuple() {
    let quad = (10, 20, 30, 40)
    let (a, b, c, d) = quad
    print(a)
    print(b)
    print(c)
    print(d)
}

@test(output = "3")
fn test_tuple_with_computation() {
    let pair = (1, 2)
    let (a, b) = pair
    print(a + b)
}

@test(output = "hello world")
fn test_string_tuple() {
    let pair = ("hello", "world")
    let (a, b) = pair
    print(a + " " + b)
}

@test(output = "nil")
fn test_nullable_in_tuple() {
    let pair: (int, int?) = (42, null)
    let (a, b) = pair
    print(b)
}

struct TestStruct {
    name: string,
    value: int,
}

@test
fn test_simple_tuple_destructuring() {
    let tup: (int, string) = (42, "hello")
    let first = tuple_first(tup)
    let second = tuple_second(tup)
    
    assert_eq(first, 42, "First element should be 42")
    assert_eq(second, "hello", "Second element should be hello")
}

@test 
fn test_struct_in_tuple() {
    let s = TestStruct { name: "test", value: 123 }
    let tup: (int, TestStruct) = (1, s)
    
    let first = tuple_first(tup)
    let second = tuple_second(tup)
    
    assert_eq(first, 1, "First should be 1")
    assert_eq(second.name, "test", "Second should have name 'test'")
    assert_eq(second.value, 123, "Second should have value 123")
}

@test
fn test_arena_to_array_basic() {
    let arena = arena_new()
    let entity = insert(arena, TestStruct { name: "arena_test", value: 456 })
    
    let count = 0
    for (e, data) in arena {
        count += 1
        assert_eq(data.name, "arena_test", "Data name should match")
        assert_eq(data.value, 456, "Data value should match")
    }
    assert_eq(count, 1, "Arena should have 1 element")
}

@test
fn test_vec_iteration_with_tuples() {
    let vec = vec_new()
    vec_push(vec, (1, "first"))
    vec_push(vec, (2, "second"))
    
    // Get first element directly
    let first_tuple = unwrap(vec_get(vec, 0))
    let first_num = tuple_first(first_tuple)
    let first_str = tuple_second(first_tuple)
    
    assert_eq(first_num, 1, "First number should be 1")
    assert_eq(first_str, "first", "First string should be 'first'")
}

@test
fn test_map_to_array_with_tuples() {
    let map = map_new()
    insert(map, "key1", TestStruct { name: "map_test", value: 789 })
    
    let arr = to_array(map)
    assert_eq(vec_len(arr), 1, "Map should have 1 element")
    
    let first_item = vec_get(arr, 0).unwrap()
    let key = tuple_first(first_item)
    let value = tuple_second(first_item)
    
    assert_eq(key, "key1", "Key should be 'key1'")
    assert_eq(value.name, "map_test", "Value name should match")
    assert_eq(value.value, 789, "Value should match")
}
