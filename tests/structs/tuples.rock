// Tuples: `let` destructuring (mixed types, nested, single-element, nullable
// elements), tuple parameters destructured in the callee, tuple_first and
// tuple_second extraction, tuples holding structs inside vectors, arenas and
// map-to-array results, and the multi-return ABI: tuples travel as multiple
// return values and are re-packed only where a tuple is used whole.

fn swap_and_add(pair: (int, int)) -> (int, int) {
    let (a, b) = pair
    return (b, a + b)
}

@test(output = "10 20 30\ntrue val\n42 hello true\n10 20 30 40\nhello world\nnil")
fn test_tuple_destructuring() {
    let point = (10, 20)
    let (x, y) = point
    print("{x} {y} {x + y}")
    let (b, s) = (true, "val")
    print("{b} {s}")
    let (num, str, flag) = (42, "hello", true)
    print("{num} {str} {flag}")
    let (q0, q1, q2, q3) = (10, 20, 30, 40)
    print("{q0} {q1} {q2} {q3}")
    let (w0, w1) = ("hello", "world")
    print(w0 + " " + w1)
    let pair: (int, int?) = (42, null)
    let (_, absent) = pair
    print(absent)
}

@test(output = "inner\n5")
fn test_nested_and_single_element_tuples() {
    let nested = (1, ("inner", false))
    let (outer, inner_tuple) = nested
    let (inner_s, inner_b) = inner_tuple
    print(inner_s)
    let single = (5,)
    let (x,) = single
    print(x)
}

@test(output = "20\n30")
fn test_tuple_param_destructured() {
    let (x, y) = swap_and_add((10, 20))
    print(x)
    print(y)
}

struct TestStruct {
    name: string,
    value: int,
}

@test
fn test_tuple_first_and_second() {
    let tup: (int, string) = (42, "hello")
    assert_eq(tuple_first(tup), 42)
    assert_eq(tuple_second(tup), "hello")

    let s = TestStruct { name: "test", value: 123 }
    let with_struct: (int, TestStruct) = (1, s)
    let second = tuple_second(with_struct)
    assert_eq(tuple_first(with_struct), 1)
    assert_eq(second.name, "test")
    assert_eq(second.value, 123)
}

@test
fn test_tuples_from_containers() {
    let arena = arena_new()
    let entity = insert(arena, TestStruct { name: "arena_test", value: 456 })
    let count = 0
    for (e, data) in arena {
        count += 1
        assert_eq(data.name, "arena_test")
        assert_eq(data.value, 456)
    }
    assert_eq(count, 1, "Arena should have 1 element")

    let vec = vec_new()
    vec_push(vec, (1, "first"))
    vec_push(vec, (2, "second"))
    let first_tuple = unwrap(vec_get(vec, 0))
    assert_eq(tuple_first(first_tuple), 1)
    assert_eq(tuple_second(first_tuple), "first")

    let map = map_new()
    insert(map, "key1", TestStruct { name: "map_test", value: 789 })
    let arr = to_array(map)
    assert_eq(vec_len(arr), 1, "Map should have 1 element")
    let first_item = vec_get(arr, 0).unwrap()
    let value = tuple_second(first_item)
    assert_eq(tuple_first(first_item), "key1")
    assert_eq(value.name, "map_test")
    assert_eq(value.value, 789)
}

// A single parenthesized item is a grouping, not a tuple.
@test(output = "42")
fn test_parenthesized_expressions_not_tuples() {
    let x = (42)
    print(x)
}

fn pair() -> (bool, int) {
    return (true, 42)
}

fn swap(a: int, b: int) -> (int, int) {
    return (b, a)
}

// A result stored whole then indexed, and an immediate destructure.
@test
fn stored_then_indexed_and_destructured() {
    let t = pair()
    assert_eq(t.0, true)
    assert_eq(t.1, 42)
    let (ok, n) = pair()
    assert_eq(ok, true)
    assert_eq(n, 42)
    let (a, b) = swap(3, 7)
    assert_eq(a, 7)
    assert_eq(b, 3)
}

struct TupleHolder {
    p: (bool, int),
}

@test
fn stored_in_struct_field() {
    let h = TupleHolder { p: pair() }
    assert_eq(h.p.0, true)
    assert_eq(h.p.1, 42)
}

fn take_tuple(t: (bool, int)) -> int {
    return t.1
}

@test
fn passed_as_argument() {
    assert_eq(take_tuple(pair()), 42)
}

fn forward() -> (bool, int) {
    return pair()
}

// tuple returned through a second fn (tail forward)
@test
fn returned_through_second_fn() {
    let (ok, n) = forward()
    assert_eq(ok, true)
    assert_eq(n, 42)
}

fn nested() -> ((int, int), int) {
    return ((1, 2), 3)
}

@test
fn nested_tuples() {
    let (inner, c) = nested()
    assert_eq(inner.0, 1)
    assert_eq(inner.1, 2)
    assert_eq(c, 3)
}

// Indirect calls: a lambda and a stored fn value returning a tuple.
@test
fn indirect_call_returning_tuple() {
    let f = () => (true, 99)
    let (ok, n) = f()
    assert_eq(ok, true)
    assert_eq(n, 99)
    let g = pair
    let (g_ok, g_n) = g()
    assert_eq(g_ok, true)
    assert_eq(g_n, 42)
}

fn maybe() -> (bool, int?) {
    return (false, null)
}

// embedded-nil tuple through both destructure and boxed paths
@test
fn embedded_nil() {
    let (ok, v) = maybe()
    assert_eq(ok, false)
    assert_eq(v, null)
    let t = maybe()
    assert_eq(t.0, false)
    assert_eq(t.1, null)
}

struct TupleBox {
    n: int,
}

fn get_pair(b: TupleBox) -> (bool, int) {
    return (true, b.n)
}

// safe-nav UFCS call to a tuple-returning method: the method splats, the
// nil-guarded call must multi-capture then pack (result is a boxed `(..)?`).
@test
fn safe_nav_call_tuple() {
    let b: TupleBox? = TupleBox { n: 42 }
    let r = b?.get_pair()
    assert_eq(r != null, true)
    if r != null {
        assert_eq(r.0, true)
        assert_eq(r.1, 42)
    }
}

value FieldText { label: string, count: int }
value FieldFloat { x: float }
value FieldNested { text: FieldText, items: [int] }

fn field_text() -> FieldText { FieldText { label: "x", count: 1 } }

@test(type_holes = [[0, "FieldText"], [1, "string"], [2, "int"]])
fn update_evaluates_a_base_and_keeps_its_other_fields() {
    let calls = 0
    let p: ? = FieldText { ..{ calls += 1; field_text() }, count: 9 }
    let label: ? = p.label
    let count: ? = p.count
    assert_eq((calls, label, count), (1, "x", 9))
}

@test
fn copying_tuple_value_fields_preserves_the_original_value() {
    let rows = [(0, FieldNested { text: field_text(), items: [1] })]
    let copies = [rows[0].1]
    copies[0].text.count = 9
    copies[0].items.push(2)
    assert_eq((rows[0].1.text.count, copies[0].text.count, rows[0].1.items.len()), (1, 9, 2))

    let floats = [(0, FieldFloat { x: 1.0 })]
    let float_copies = [floats[0].1]
    float_copies[0].x = 9.0
    assert_eq((floats[0].1.x, float_copies[0].x), (1.0, 9.0))

    let maybe: [(int, FieldText?)] = [(0, field_text()), (1, null)]
    let maybe_copies = [maybe[0].1]
    maybe_copies[0]?.count = 9
    assert_eq((maybe[0].1.unwrap().count, maybe_copies[0].unwrap().count), (1, 9))
    assert(maybe[1].1 == null)
}
