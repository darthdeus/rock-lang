// Tuples: `let` destructuring (mixed types, nested, single-element, nullable
// elements), tuple parameters destructured in the callee, tuple_first and
// tuple_second extraction, and tuples holding structs inside vectors, arenas
// and map-to-array results.

fn swap_and_add(pair: (int, int)) -> (int, int) {
    let (a, b) = pair
    return (b, a + b)
}

@test(output = "10 20 30\ntrue val\n42 hello true\n10 20 30 40\nhello world\nnil")
fn test_tuple_destructuring() {
    let point = (10, 20)
    let (x, y) = point
    print("{x} {y} {x + y}")
    let (b, s) = (true, "val")
    print("{b} {s}")
    let (num, str, flag) = (42, "hello", true)
    print("{num} {str} {flag}")
    let (q0, q1, q2, q3) = (10, 20, 30, 40)
    print("{q0} {q1} {q2} {q3}")
    let (w0, w1) = ("hello", "world")
    print(w0 + " " + w1)
    let pair: (int, int?) = (42, null)
    let (_, absent) = pair
    print(absent)
}

@test(output = "inner\n5")
fn test_nested_and_single_element_tuples() {
    let nested = (1, ("inner", false))
    let (outer, inner_tuple) = nested
    let (inner_s, inner_b) = inner_tuple
    print(inner_s)
    let single = (5,)
    let (x,) = single
    print(x)
}

@test(output = "20\n30")
fn test_tuple_param_destructured() {
    let (x, y) = swap_and_add((10, 20))
    print(x)
    print(y)
}

struct TestStruct {
    name: string,
    value: int,
}

@test
fn test_tuple_first_and_second() {
    let tup: (int, string) = (42, "hello")
    assert_eq(tuple_first(tup), 42)
    assert_eq(tuple_second(tup), "hello")

    let s = TestStruct { name: "test", value: 123 }
    let with_struct: (int, TestStruct) = (1, s)
    let second = tuple_second(with_struct)
    assert_eq(tuple_first(with_struct), 1)
    assert_eq(second.name, "test")
    assert_eq(second.value, 123)
}

@test
fn test_tuples_from_containers() {
    let arena = arena_new()
    let entity = insert(arena, TestStruct { name: "arena_test", value: 456 })
    let count = 0
    for (e, data) in arena {
        count += 1
        assert_eq(data.name, "arena_test")
        assert_eq(data.value, 456)
    }
    assert_eq(count, 1, "Arena should have 1 element")

    let vec = vec_new()
    vec_push(vec, (1, "first"))
    vec_push(vec, (2, "second"))
    let first_tuple = unwrap(vec_get(vec, 0))
    assert_eq(tuple_first(first_tuple), 1)
    assert_eq(tuple_second(first_tuple), "first")

    let map = map_new()
    insert(map, "key1", TestStruct { name: "map_test", value: 789 })
    let arr = to_array(map)
    assert_eq(vec_len(arr), 1, "Map should have 1 element")
    let first_item = vec_get(arr, 0).unwrap()
    let value = tuple_second(first_item)
    assert_eq(tuple_first(first_item), "key1")
    assert_eq(value.name, "map_test")
    assert_eq(value.value, 789)
}
