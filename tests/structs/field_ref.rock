// Runtime coverage for FieldRef<T, V> and `.field` key paths: a resolved field
// lowers to its interned name, so `o[name]` and `o.field` behave the same.

struct Mob { health: int, attack_co: int? }
value FixVec2 { x: float, y: float }

@test(output = "10\n99")
fn test_field_get_and_set() {
    let m = Mob { health: 10, attack_co: null }
    print("{field_get(m, .health)}")
    field_set(m, .health, 99)
    print("{field_get(m, .health)}")
}

@test(output = "cleared")
fn test_field_set_clear_nullable() {
    let m = Mob { health: 1, attack_co: 5 }
    field_set(m, .attack_co, null)
    if field_get(m, .attack_co) == null {
        print("cleared")
    } else {
        print("still set")
    }
}

// value struct (C-layout cdata): string-keyed field read works on cdata.
@test(output = "3.5 7")
fn test_field_get_value_struct() {
    let v = FixVec2 { x: 3.5, y: 7.0 }
    print("{field_get(v, .x)} {field_get(v, .y)}")
}

// A `.field` arg must not break a call to an OVERLOADED name: arity alone
// resolves the FieldRef-taking candidate; the field ref is checked against the
// winner's param post-selection.
fn probe<T>(o: T, f: FieldRef<T, int?>) -> int {
    let v = field_get(o, f)
    return v ?? -1
}

fn probe(x: int) -> int {
    return x
}

@test(output = "5 5 5")
fn test_field_ref_arg_with_overload_set() {
    let m = Mob { health: 10, attack_co: 5 }
    print("{probe(m, .attack_co)} {m.probe(.attack_co)} {probe(m, f: .attack_co)}")
}

// A `FieldRef<T, V>` arg must coerce to a `ReadFieldRef<T, V>` param even when the
// callee name carries more than one overload -- the multi-candidate path scores
// through `fit_cost`, which must know the coercion, not just the single-
// candidate bypass.
fn field_get(a: int, b: int) -> int {
    return a + b
}

fn read_through<T>(o: T, f: FieldRef<T, int?>) -> int {
    return field_get(o, f) ?? -1
}

@test(output = "5")
fn test_fieldref_coerces_to_readfieldref_with_overload_set() {
    let m = Mob { health: 10, attack_co: 5 }
    print("{read_through(m, .attack_co)}")
}

// `WriteFieldRef<T, V>`: the write-only selector. A `.field` literal resolves
// against it directly, and a `FieldRef` coerces DOWN to it -- which is what
// keeps a slot-verb call site unchanged when its param relaxes.
fn write_through<T>(o: T, f: WriteFieldRef<T, int?>, v: int?) {
    field_set(o, f, v)
}

@test(output = "cleared")
fn test_write_field_ref_coerced_from_field_ref() {
    let m = Mob { health: 1, attack_co: 5 }
    let f: FieldRef<Mob, int?> = .attack_co
    write_through(m, f, null)
    if field_get(m, .attack_co) == null {
        print("cleared")
    } else {
        print("still set")
    }
}

// Same name, two decls: the write-only param must also score through
// `fit_cost` on the multi-candidate path, not only the single-candidate bypass.
fn write_through(x: int) -> int {
    return x
}

@test(output = "3")
fn test_write_field_ref_with_overload_set() {
    let m = Mob { health: 1, attack_co: null }
    write_through(m, .attack_co, 3)
    print("{field_get(m, .attack_co)}")
}

fn default_none<T>() -> T? { null }

global default_calls: int = 0

fn default_tick() -> int { default_calls += 1; 7 }

struct DefaultBox<T> {
    option: T? = default_none(),
    count: int = default_tick(),
}

struct NestedDefaults {
    item: DefaultBox<int> = DefaultBox {},
    tag: string = "{if default_tick() > 0 { "x" } else { "y" }}",
    parts: (int, [int]) = (default_tick(), [default_tick()]),
    selected: int = match default_tick() { 7 => 1, _ => 0 },
}

@test
fn default_fields_evaluate_only_when_omitted() {
    default_calls = 0
    let init = NestedDefaults {}
    let other: DefaultBox<string> = DefaultBox {}
    let set: DefaultBox<int> = DefaultBox { count: 9 }
    assert_eq(default_calls, 6)
    assert_eq((init.item.count, init.parts.0, init.parts.1[0]), (7, 7, 7))
    assert_eq((init.tag, init.selected), ("x", 1))
    assert_eq((other.count, set.count), (7, 9))
    assert(init.item.option == null && other.option == null)
    init.item.option = 3
    other.option = "ok"
    assert_eq((init.item.option, other.option), (3, "ok"))
}

struct CompareNode { n: int, tag: string?, children: [int] }
struct CompareRoot { node: CompareNode }

fn compare_root(n: int, tag: string?) -> CompareRoot {
    CompareRoot { node: CompareNode { n, tag, children: [2, 3] } }
}

@test
fn structural_equality_follows_nested_fields_and_mutation() {
    let a = compare_root(1, null)
    let b = compare_root(1, null)
    assert(a == b && a != compare_root(1, "a") && a != compare_root(2, null))
    b.node.tag = "a"
    assert(a != b)
    a.node.tag = "a"
    assert(a == b)
    a.node.children[1] = 9
    assert(a != b)
}

struct GroupedPair<T> { a: T, b: T, label: int }

enum RecordInit { Four { a: int, b: int, c: int, d: int } }

@test
fn field_groups_evaluate_once_and_share_references() {
    let calls = 0
    let label = 8
    let pair: GroupedPair<[int]> = GroupedPair { a + b: {
        calls += 1
        [1, 2]
    }, label }
    pair.a.push(3)
    assert_eq(calls, 1, "one evaluation for the vector group")
    assert_eq(pair.b[2], 3)
    assert_eq(pair.label, 8)

    let a = 1
    let value = RecordInit::Four { a, b + c: 2, d: 4 }
    match value {
        Four { a, b, c, d } => assert_eq((a, b, c, d), (1, 2, 2, 4)),
    }

    let callbacks: GroupedPair<() -> int> = GroupedPair { a + b: () => label, label }
    assert_eq((callbacks.a(), callbacks.b()), (8, 8))
}
