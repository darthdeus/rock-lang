// Struct field defaults: a literal that omits defaulted fields gets the
// declared values (including call expressions and nested struct defaults),
// provided fields override them, and a literal that provides every field
// injects nothing.

fn fixv(x: float, y: float) -> int {
    return 42
}

fn add(a: int, b: int) -> int {
    return a + b
}

struct Point1 { x: int = 10, y: int = 20 }
struct Point2 { x: int = 1, y: int = 2, z: int = 3 }
struct Inner1 { a: int = 7, b: int = 8 }
struct Outer1 { inner: Inner1 = Inner1{ a: 1 }, c: int = 9 }
struct Inner2 { a: int = 1, b: int = 2 }
struct Outer2 { inner: Inner2 = Inner2 {}, c: int = 3 }
struct TestStruct {
    field1: int = fixv(1.0, 2.0),
    field2: int = add(10, 5)
}

@test(output = "10 20\n1 5 3")
fn test_default_struct_empty_and_partial_literal() {
    let p = Point1 {}
    print("{p.x} {p.y}")
    let q = Point2 { y: 5 }
    print("{q.x} {q.y} {q.z}")
}

@test(output = "1 8 9\n1 5 3")
fn test_nested_struct_defaults() {
    let o = Outer1 {}
    print("{o.inner.a} {o.inner.b} {o.c}")
    let q = Outer2 { inner: Inner2 { b: 5 } }
    print("{q.inner.a} {q.inner.b} {q.c}")
}

@test(output = "42\n15")
fn test_function_calls_in_struct_defaults() {
    let s = TestStruct {}
    print(s.field1)
    print(s.field2)
}

struct Cfg {
    width: int,
    height: int = 100,
    label: string = "untitled",
    scale: float = 1.5,
}

@test(output = "10 100 untitled 3\n10 42 untitled")
fn test_omit_and_override_defaults() {
    let c = Cfg { width: 10 }
    print("{c.width} {c.height} {c.label} {(c.scale * 2.0).floor()}")
    let o = Cfg { width: 10, height: 42 }
    print("{o.width} {o.height} {o.label}")
}

@test(output = "2 9 hi 4")
fn test_provide_all_no_injection() {
    let c = Cfg { width: 2, height: 9, label: "hi", scale: 2.0 }
    print("{c.width} {c.height} {c.label} {(c.scale * 2.0).floor()}")
}
