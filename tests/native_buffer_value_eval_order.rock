// Adversarial: struct-literal field RHS evaluation order should match
// source order (the literal's textual order), not declaration order.
// Old codegen evaluated args in source order during emit_value_arg_cdata;
// the new slot-store path needs to preserve that.

@intrinsic @inline inline(lua) fn put(s: string) = "io.write(s)"

value V2 {
    x: float,
    y: float,
}

@nomangle inline(lua) fn __nb_alloc_V2(n: int) -> Ptr<V2> = 'return ffi.new("V2[?]", n)'

fn nb_v2(n: int) -> NativeBuffer<V2> {
    return NativeBuffer { ptr: __nb_alloc_V2(n), len: n }
}

@nomangle inline(lua) fn record_call(tag: string) -> float = """
    table.insert(_G.__rec, tag)
    return 1.0
"""

@nomangle inline(lua) fn init_record() = "_G.__rec = {}"
@nomangle inline(lua) fn dump_record() -> string = "return table.concat(_G.__rec, ',')"

@test(output = "y_first,x_second")
fn test_source_order() {
    init_record()
    let buf = nb_v2(1)
    // Source order: y first, x second. Declaration order: x, y.
    // Whichever order side effects run, that's what the user sees.
    buf[0] = V2 {
        y: record_call("y_first"),
        x: record_call("x_second"),
    }
    put(dump_record())
}
