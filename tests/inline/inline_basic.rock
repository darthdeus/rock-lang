// @inline basics: plain bodies, generics, UFCS call syntax, default
// arguments and nested @inline chains must behave exactly like the
// out-of-line call.

@inline
fn id(x: int) -> int {
    return x
}

@inline
fn add_one(x: int) -> int {
    return x + 1
}

@inline
fn trailing_expr(x: int, y: int) -> int {
    x + y
}

@test(output = "42\n6\n7\n100")
fn test_basic_bodies() {
    print(id(42))
    print(add_one(5))
    print(trailing_expr(3, 4))
    print(add_one(add_one(add_one(id(97)))))
}

// Each monomorphization is a separate concrete fn; inlining must not
// confuse them.
@inline
fn gid<T>(x: T) -> T {
    return x
}

@test(output = "42\n3\nhello\n5 5")
fn test_generic_monomorphizations() {
    print(gid(42))
    print(gid(3.14) as int)
    print(gid("hello"))
    print("{gid(5)} {gid(5)}")
}

@inline
fn doubled(x: int) -> int {
    return x * 2
}

@inline
fn added(x: int, y: int) -> int {
    return x + y
}

@test(output = "10\n12\n20")
fn test_ufcs_calls() {
    print(5.doubled())
    print(5.added(7))
    print(5.doubled().added(10))
}

// Default args are injected at call sites; the splice must see the fully
// substituted argument list.
@inline
fn with_default(x: int, k: int = 10) -> int {
    return x + k
}

@inline
fn multiple_defaults(a: int = 1, b: int = 2, c: int = 3) -> int {
    return a * 100 + b * 10 + c
}

@test(output = "15\n7\n123\n923\n957")
fn test_default_args() {
    print(with_default(5))
    print(with_default(5, 2))
    print(multiple_defaults())
    print(multiple_defaults(9))
    print(multiple_defaults(9, c: 7, b: 5))
}

@inline
fn level3(x: int) -> int {
    return x + 1
}

@inline
fn level2(x: int) -> int {
    return level3(x) * 2
}

@inline
fn level1(x: int) -> int {
    return level2(x) + level3(x)
}

@inline
fn level0(x: int) -> int {
    return level1(x) - level2(x) + level3(x)
}

@inline
fn mul(a: int, b: int) -> int { a * b }

@inline
fn add(a: int, b: int) -> int { a + b }

@test(output = "12\n18\n18\n20")
fn test_nested_chains() {
    print(level2(5))
    print(level1(5))
    // level1(8) = 27, level2(8) = 18, level3(8) = 9
    print(level0(8))
    print(add(mul(2, 3), mul(2, 7)))
}
