struct Box { n: int }
@inline inline(lua) fn bump(b: Box, by: int) = "b.n = b.n + by"
@inline inline(lua) fn twice(x: int) -> int = "return x .. x"
@inline inline(lua) fn reassign(x: int) -> int = "x = x + 1\nreturn x"
@inline inline(lua) fn scoped(x: int) -> int = "local y = x * 2\nreturn y + x"
@inline inline(lua) fn captured(x: int) -> int = "local f = function() return x end\nreturn f()"
@inline inline(lua) fn half(v: int) -> int = "return v * 2"
@inline inline(lua) fn same(v: int) -> int = "return v"
@inline inline(lua) fn quoted(x: int) -> string = "return 'x' .. tostring(x) -- x"
fn run(b: Box, k: int) -> string {
    bump(b, k)
    bump(b, 1)
    let a = reassign(k)
    let s = scoped(k)
    let c = captured(k)
    let h = half(k + 1)
    let i = same(h)
    return "{twice(b.n)} {a} {k} {s} {c} {quoted(k)} {i}"
}
@test(backends = "lua", output = "66 5 4 12 4 x4 10")
fn splice_preserves_names_and_reassignments() {
    print(run(Box { n: 1 }, 4))
}

struct CounterBox { n: int }
struct Holder { b: CounterBox, n: int }
inline(lua) fn tick(h: Holder) -> int = "h.b.n = h.b.n + 10\nh.n = h.n + 1\nreturn h.n"
@inline inline(lua) fn ignore(v: int) = ""
@inline inline(lua) fn next_of(b: CounterBox) -> int = "return b.n + 1"
@inline inline(lua) fn sum(n: int, k: int) -> int = "return n + k"
@inline inline(lua) fn show(n: int) -> string = "return tostring(n)"
fn run_order(h: Holder) -> string {
    ignore(tick(h))
    show(h.n)
    let a = next_of(h.b)
    let s = sum(h.n, tick(h))
    return "{a} {s} {h.n}"
}
@test(backends = "lua", output = "16 3 2")
fn splice_preserves_argument_order() {
    print(run_order(Holder { b: CounterBox { n: 5 }, n: 0 }))
}

struct SetBox { n: int }
struct SetHolder { b: SetBox, n: int }
@inline inline(lua) fn set_n(b: SetBox, v: int) = "b.n = v"
fn run_set(h: SetHolder, v: int) -> int {
    h.n = v
    set_n(h.b, v + 1)
    return h.b.n
}
@test(backends = "lua", output = "8")
fn splice_does_not_extend_previous_statement() {
    print(run_set(SetHolder { b: SetBox { n: 5 }, n: 0 }, 7))
}
