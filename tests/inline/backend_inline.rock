// @inline and @pure callees on both backends: spliced calls, defaulted params
// and per-backend inline(lua)/inline(js) variants.

@inline fn dbl(x: int) -> int { x * 2 }

@test(returns = 6)
fn test_inline_call() -> int { dbl(3) }

@pure fn sq(x: int) -> int { x * x }

@test(returns = 9)
fn test_pure_call() -> int { sq(3) }

fn ranged(a: int, b: int, step: int = 1) -> int { a + b + step }

// `step` omitted -> a 2-arg call to a 3-param callee. Legal (callee fills the
// default from `nil`); pre-T8a the arity guard rejected it as a value-struct
// ABI mismatch.
@test(returns = 6)
fn test_defaulted_param() -> int { ranged(2, 3) }

inline(lua) fn variant_plus_one(x: int) -> int = """return x + 1"""

inline(js) fn variant_plus_one(x: int) -> int = """return x + 1"""

inline(lua) fn variant_triple(x: int) -> int = """return x * 3"""

inline(js) fn variant_triple(x: int) -> int = """return x + x + x"""

fn apply_variant(f: fn(int) -> int, x: int) -> int { return f(x) }

@test(output = "42,12")
fn a_backend_pair_called_directly() {
    print("{variant_plus_one(41)},{variant_triple(4)}")
}

@test(output = "12,15")
fn a_backend_pair_taken_as_a_fn_value() {
    let g = variant_triple
    print("{apply_variant(g, 4)},{apply_variant(variant_triple, 5)}")
}
