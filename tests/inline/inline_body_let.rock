// Adversarial tests: @inline — `let` bindings inside @inline body (L6).
//
// Body-local renaming must:
//   - rename the body-local so it cannot collide with a caller-site
//     local of the same name
//   - not touch a param name (param substitution supersedes the rename)
//   - handle inner shadowing (inner `let x = ...` rebinds x)

@inline
fn add_then_double(x: int) -> int {
    let t = x + 1
    return t * 2
}

@test(output = "8")
fn test_basic_let() {
    let r = add_then_double(3)
    print(r)
}

// Caller has a local called `t` in scope at the splice site. The body's
// `let t = ...` must rename so it doesn't shadow / clash with caller's t.
@test(output = "100 8")
fn test_caller_name_collision() {
    let t = 100
    let r = add_then_double(3)
    print("{t} {r}")
}

// Shadow-collision: @inline body uses a body-local with the same name
// as a param. The body-local rename must not interfere with param
// substitution — the trailing `return t` reads the body-local, not the
// caller's arg.
@inline
fn shadow_param(t: int) -> int {
    let t = t + 1
    return t
}

@test(output = "11")
fn test_shadow_param() {
    let r = shadow_param(10)
    print(r)
}

// Multiple lets chained.
@inline
fn chain(x: int) -> int {
    let a = x + 1
    let b = a * 2
    return b - 1
}

@test(output = "7")
fn test_chain() {
    let r = chain(3)
    print(r)
}
