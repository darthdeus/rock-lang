// @inline bodies with their own locals and loops. Body locals are renamed so
// they never collide with caller locals of the same name, a body local may
// shadow a param or itself, and loops inside the body keep their semantics.

@inline
fn add_then_double(x: int) -> int {
    let t = x + 1
    return t * 2
}

@inline
fn chain(x: int) -> int {
    let a = x + 1
    let b = a * 2
    return b - 1
}

@inline
fn double_let(x: int) -> int {
    let t = x + 1
    let t = t * 2
    return t
}

@test(output = "8 7 12")
fn test_body_lets() {
    print("{add_then_double(3)} {chain(3)} {double_let(5)}")
}

@test(output = "100 8")
fn test_caller_name_collision() {
    let t = 100
    let r = add_then_double(3)
    print("{t} {r}")
}

@inline
fn uses_local_named_x(a: int) -> int {
    let x = a * 10
    let y = x + 1
    return y
}

@test(output = "5 51")
fn test_caller_x_passed_and_not_clobbered() {
    let x = 5
    let r = uses_local_named_x(x)
    print("{x} {r}")
}

// The body-local rename must not interfere with param substitution: the
// trailing `return t` reads the body local, not the caller's argument.
@inline
fn shadow_param(t: int) -> int {
    let t = t + 1
    return t
}

@inline
fn ignore_param_shadow(a: int) -> int {
    let a = 999
    return a
}

@test(output = "11\n42 999")
fn test_body_local_shadows_param() {
    print(shadow_param(10))
    let a = 42
    let r = ignore_param_shadow(a)
    print("{a} {r}")
}

@inline
fn sum_vec(xs: [int]) -> int {
    let total = 0
    for x in xs {
        total = total + x
    }
    return total
}

@test(output = "99 500 15")
fn test_for_body_caller_collision() {
    let x = 99
    let total = 500
    let xs = [1, 2, 3, 4, 5]
    let r = sum_vec(xs)
    print("{x} {total} {r}")
}

@inline
fn count_down_sum(n: int) -> int {
    let acc = 0
    let i = n
    while i > 0 {
        acc = acc + i
        i = i - 1
    }
    return acc
}

@test(output = "15")
fn test_while_loop() {
    let r = count_down_sum(5)
    print(r)
}
