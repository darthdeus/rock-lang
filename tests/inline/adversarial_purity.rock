// Adversarial tests probing the purity analysis for silent miscompile.

@inline
fn triple(x: int) -> int {
    return x + x + x
}

// ATTACK 1: Global read via bare Ident at call site.
// `is_dup_safe_at_call_site` treats bare Idents as dup-safe unconditionally
// (mirroring V0). If COUNTER is a mutable global, reads of it would all be
// duplicated — but a bare ident read is idempotent (no side effect). So this
// *shouldn't* miscompile for pure reads. Included as sanity.
global G_CONST: int = 10

@test(output = "30")
fn test_bare_global_ident() {
    let r = triple(G_CONST)
    print(r)
}

// ATTACK 2: Function call whose body reads a global (bare Ident).
// is_fn_pure should catch: global-ident read isn't in `bound` -> NotPure.
global G_MUT: int = 7

fn read_global() -> int {
    return G_MUT
}

// If read_global is incorrectly pure, triple(read_global()) textually
// duplicates -> 3 reads. Since G_MUT doesn't change here, output would
// still be 21. Let's make it change.
fn read_and_inc_global() -> int {
    let v = G_MUT
    G_MUT = G_MUT + 1   // assignment; not pure (Assign -> NotPure)
    return v
}

@test(output = "21")
fn test_global_read_fn() {
    // G_MUT starts at 7. If pure analysis wrongly says pure, triple would
    // dup-eval read_global() 3x = 21 still. If correctly impure, hoisted
    // to single let = 7, triple = 21. Both paths give 21 here.
    let r = triple(read_global())
    print(r)
}

// ATTACK 3: QualifiedIdent referring to module constant is fine. But what
// if QualifiedIdent resolves to something heap-identity-bearing? We test
// enum variant (value) construction.
enum Color { Red, Green, Blue }

// Bodies that use the param twice, we need a function with x used >1.
@inline
fn pair_eq(c: Color) -> bool {
    return c == c   // uses `c` twice
}

@test(output = "true")
fn test_qualified_enum() {
    let r = pair_eq(Color::Red)
    print(r)
}

// ATTACK 4: Operator overload.
// Define a value struct and an `+` overload that has side effects.
// If the + lowers to an impure call but stays BinOp in AST, purity.rs
// BinOp case recurses into operands only (not the overload fn), so a
// BinOp expression using the overload might be classified Pure even
// though the overload is impure.
value Counter { val: int }

// Not attempting operator overload — syntax may not exist in Rock as
// tested. Skip to next attack.

// ATTACK 5: Recursive fn -> NotPure by stack check.
fn fib(n: int) -> int {
    return if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

@test(output = "15")
fn test_recursive_not_pure() {
    // If fib is classified pure (it is mathematically pure), triple(fib(5))
    // dup-evals fib(5)=5 three times = 15. If impure by recursion-stack
    // pessimism, hoisted but still = 15. Either way, right output.
    let r = triple(fib(5))
    print(r)
}

// ATTACK 6: String interpolation dup. Interpolated strings pure if parts
// pure. If called in a context that dup-evals them, LuaJIT interns strings
// so == identity matches. No miscompile expected.
@inline
fn concat_twice(s: string) -> string {
    return s + s
}

fn make_greeting(name: string) -> string {
    return "hello {name}"
}

@test(output = "hello bobhello bob")
fn test_interp_dup() {
    let r = concat_twice(make_greeting("bob"))
    print(r)
}

// ATTACK 7: Value struct literal with field init that IS a pure function
// call. Test that dup-safe.
value Point { x: int, y: int }

fn mk_point(n: int) -> Point {
    return Point { x: n, y: n }
}

// Function returns Point (value struct) — should be dup-safe.
@inline
fn pt_sum(p: Point) -> int {
    return p.x + p.y + p.x   // uses p three times
}

@test(output = "15")
fn test_value_struct_dup() {
    let r = pt_sum(mk_point(5))
    print(r)
}
