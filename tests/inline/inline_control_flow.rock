// @inline inside for / while / match / if, and @inline bodies that are `if`
// expressions, must behave exactly like the out-of-line call.

@inline
fn add_ten(x: int) -> int {
    return x + 10
}

@inline
fn is_positive(x: int) -> bool {
    return x > 0
}

@test(output = "10 11 12 13 14")
fn test_inline_in_for_loop() {
    let out = ""
    for i in 0..5 {
        if out != "" { out += " " }
        out += "{add_ten(i)}"
    }
    print(out)
}

@test(output = "pos pos neg zero pos")
fn test_inline_in_match_condition() {
    let xs = [1, 2, -3, 0, 7]
    let out = ""
    for x in xs {
        if out != "" { out += " " }
        if is_positive(x) {
            out += "pos"
        } else if x == 0 {
            out += "zero"
        } else {
            out += "neg"
        }
    }
    print(out)
}

@inline
fn contrib(i: int) -> int {
    return i * i
}

@test(output = "30")
fn test_inline_accumulator() {
    let total = 0
    for i in 1..5 {
        total += contrib(i)
    }
    // 1 + 4 + 9 + 16 = 30
    print(total)
}

@inline
fn saturating_sub(a: int, b: int) -> int {
    return if a > b { a - b } else { 0 }
}

@inline
fn my_sign(x: int) -> int {
    return if x > 0 { 1 } else { if x < 0 { -1 } else { 0 } }
}

@test(output = "5 0\n1 -1 0")
fn test_if_bodies() {
    print("{saturating_sub(10, 5)} {saturating_sub(3, 7)}")
    print("{my_sign(42)} {my_sign(-5)} {my_sign(0)}")
}

struct Range { lo: int, hi: int }

@inline
fn clamp_to_range(v: int, r: Range) -> int {
    return if v < r.lo { r.lo } else { if v > r.hi { r.hi } else { v } }
}

@test(output = "5 10 0")
fn test_if_body_with_field_access() {
    let r = Range { lo: 0, hi: 10 }
    print("{clamp_to_range(5, r)} {clamp_to_range(99, r)} {clamp_to_range(-5, r)}")
}

// A struct-literal argument read only through fields is substituted per
// field, through both branches.
@test(output = "7")
fn test_struct_literal_arg_in_if_body() {
    print(clamp_to_range(7, Range { lo: 0, hi: 10 }))
}
