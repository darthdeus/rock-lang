// Adversarial tests: @inline — match bodies with binding-free arms
//
// V0 @inline allows `match` when no arm pattern binds a new name.
// Wildcard, literal, range, and unit enum-variant patterns are safe;
// Some(v) or Point { x, y } still reject (covered in errors/).
//
// Note: avoids `+= <match>` and `+= "{inline_call(x)}"` because the
// current Lua codegen emits `do ... end` for match-as-compound-RHS,
// which is an unrelated pre-existing context-stack bug. The tests use
// `let r = inline_call(x); print(r)` patterns where the match ends up
// as a `let` initializer (existing block-rvalue lowering handles it).

enum Sign { Pos, Neg, Zero }

@inline
fn classify(x: int) -> Sign {
    return match x {
        0 => Sign::Zero,
        _ => if x > 0 { Sign::Pos } else { Sign::Neg },
    }
}

@inline
fn describe(s: Sign) -> string {
    return match s {
        Sign::Pos => "pos",
        Sign::Neg => "neg",
        Sign::Zero => "zero",
    }
}

@inline
fn bucket(x: int) -> string {
    return match x {
        0 => "none",
        1 => "one",
        2 => "two",
        _ => "many",
    }
}

@test(output = "pos\nneg\nzero\npos")
fn test_classify_and_describe_chain() {
    let xs = [1, -3, 0, 7]
    for x in xs {
        let r = describe(classify(x))
        print(r)
    }
}

@test(output = "none\none\ntwo\nmany\nmany")
fn test_literal_arms() {
    for i in 0..5 {
        let r = bucket(i)
        print(r)
    }
}

// Exercise a match where the scrutinee is the inlined parameter itself
// (common pattern: pass arg straight to match). Verifies param
// substitution reaches the scrutinee.
@inline
fn double_or_zero(x: int) -> int {
    return match x {
        0 => 0,
        _ => x * 2,
    }
}

@test(output = "0\n2\n4\n0\n10")
fn test_scrutinee_is_param() {
    let xs = [0, 1, 2, 0, 5]
    for x in xs {
        let r = double_or_zero(x)
        print(r)
    }
}

// Range pattern (literal endpoints, per parser). Verifies the walker
// recurses into Range pattern sub-expressions and the scrutinee is
// substituted.
@inline
fn band(x: int) -> string {
    return match x {
        2..10 => "mid",
        _ => "out",
    }
}

@test(output = "out\nmid\nmid\nout")
fn test_range_pattern() {
    let xs = [0, 3, 7, 20]
    for x in xs {
        let r = band(x)
        print(r)
    }
}
