// @inline bodies containing match and if-let, with and without binding arms,
// must behave exactly like the out-of-line call.

enum Sign { Pos, Neg, Zero }

@inline
fn classify(x: int) -> Sign {
    return match x {
        0 => Sign::Zero,
        _ => if x > 0 { Sign::Pos } else { Sign::Neg },
    }
}

@inline
fn describe(s: Sign) -> string {
    return match s {
        Sign::Pos => "pos",
        Sign::Neg => "neg",
        Sign::Zero => "zero",
    }
}

@inline
fn bucket(x: int) -> string {
    return match x {
        0 => "none",
        1 => "one",
        2 => "two",
        _ => "many",
    }
}

@test(output = "pos\nneg\nzero\npos")
fn test_classify_and_describe_chain() {
    let xs = [1, -3, 0, 7]
    for x in xs {
        let r = describe(classify(x))
        print(r)
    }
}

@test(output = "none\none\ntwo\nmany\nmany")
fn test_literal_arms() {
    for i in 0..5 {
        let r = bucket(i)
        print(r)
    }
}

// Exercise a match where the scrutinee is the inlined parameter itself
// (common pattern: pass arg straight to match). Verifies param
// substitution reaches the scrutinee.
@inline
fn double_or_zero(x: int) -> int {
    return match x {
        0 => 0,
        _ => x * 2,
    }
}

@test(output = "0\n2\n4\n0\n10")
fn test_scrutinee_is_param() {
    let xs = [0, 1, 2, 0, 5]
    for x in xs {
        let r = double_or_zero(x)
        print(r)
    }
}

// Range pattern (literal endpoints, per parser). Verifies the walker
// recurses into Range pattern sub-expressions and the scrutinee is
// substituted.
@inline
fn band(x: int) -> string {
    return match x {
        2..10 => "mid",
        _ => "out",
    }
}

@test(output = "out\nmid\nmid\nout")
fn test_range_pattern() {
    let xs = [0, 3, 7, 20]
    for x in xs {
        let r = band(x)
        print(r)
    }
}

enum Opt { None, Some(int) }

@inline
fn unwrap_or_zero(o: Opt) -> int {
    return match o {
        Opt::None => 0,
        Opt::Some(v) => v,
    }
}

@test(output = "42\n0\n7")
fn test_unwrap_or_zero() {
    print(unwrap_or_zero(Opt::Some(42)))
    print(unwrap_or_zero(Opt::None))
    print(unwrap_or_zero(Opt::Some(7)))
}

// Caller has a `v` in scope; the body's pattern binding `v` must
// rename to avoid collision.
@test(output = "999 42")
fn test_match_bind_caller_collision() {
    let v = 999
    let r = unwrap_or_zero(Opt::Some(42))
    print("{v} {r}")
}

// Nested tuple pattern — both `a` and `b` should rename.
enum OptPair { None, Some((int, int)) }

@inline
fn sum_pair_or_zero(p: OptPair) -> int {
    return match p {
        OptPair::None => 0,
        OptPair::Some((a, b)) => a + b,
    }
}

@test(output = "11\n0")
fn test_nested_tuple_pattern() {
    print(sum_pair_or_zero(OptPair::Some((4, 7))))
    print(sum_pair_or_zero(OptPair::None))
}

// `if let` binding.
@inline
fn unwrap_double_or_zero(o: int?) -> int {
    if let x = o {
        return x * 2
    } else {
        return 0
    }
}

@test(output = "10\n0")
fn test_if_let() {
    let a: int? = 5
    let b: int? = null
    print(unwrap_double_or_zero(a))
    print(unwrap_double_or_zero(b))
}

// if let with caller-side same-name local — must not clash.
@test(output = "777 10")
fn test_if_let_caller_collision() {
    let x = 777
    let a: int? = 5
    let r = unwrap_double_or_zero(a)
    print("{x} {r}")
}
