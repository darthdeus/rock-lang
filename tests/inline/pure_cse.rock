// CSE within a block for @pure calls, including UFCS calls whose receiver
// sits in the call's `obj` slot. Identical calls with structurally equal
// args collapse to one binding; output must be unchanged.

@pure
fn my_abs(x: int) -> int {
    if x < 0 { return -x }
    return x
}

@test(output = "14\n12")
fn test_cse_same_and_different_args() {
    let x = -7
    let same = my_abs(x) + my_abs(x)
    print(same)
    let a = -5
    let b = -7
    let different = my_abs(a) + my_abs(b)
    print(different)
}

// An intervening write to the arg invalidates CSE: 3 + 10.
@test(output = "13")
fn test_mutation_blocks_cse() {
    let x = -3
    let a = my_abs(x)
    x = 10
    let b = my_abs(x)
    print(a + b)
}

value V2 { x: float, y: float }

@pure
fn length_sq(p: V2) -> float {
    return p.x * p.x + p.y * p.y
}

@test(output = "50\n194")
fn test_ufcs_cse_receivers() {
    let point = V2 { x: 3.0, y: 4.0 }
    let same = point.length_sq() + point.length_sq()
    print(same as int)
    let a = V2 { x: 3.0, y: 4.0 }
    let b = V2 { x: 5.0, y: 12.0 }
    let different = a.length_sq() + b.length_sq()
    print(different as int)
}
