// Unused @pure calls are dropped unless an argument has an effect; a @pure
// function that calls a @debug_impure one is demoted to impure but still runs.

@pure
fn square(x: int) -> int { return x * x }

@pure
fn sum(a: int, b: int) -> int { return a + b }

// A discarded pure call, bare or bound to `_`, is dropped; the following
// print still runs.
@test(output = "ok")
fn test_discarded_pure_calls_dropped() {
    square(5)
    let _ = square(7)
    print("ok")
}

// Negative: pure call with impure arg — the arg itself has effects,
// so we must NOT drop the call. Here the arg is another call to an
// impure function (`print_and_return`). If DCE fires here, the
// "side" print never happens.
fn print_and_return(x: int) -> int {
    print("side")
    return x
}

@test(output = "side\nok")
fn test_pure_call_with_impure_arg_preserved() {
    sum(print_and_return(1), 2)
    print("ok")
}

@debug_impure
inline(lua) fn trace_int(n: int) = "-- trace {n}"

@debug_impure
inline(js) fn trace_int(n: int) = "/* trace {n} */"

@pure
fn noisy_identity(n: int) -> int {
    trace_int(n)
    return n
}

@pure
fn shout(n: int) -> int {
    print("shout")
    return n * 2
}

@test(output = "7\nshout\n20")
fn test_debug_impure_demotes_but_compiles() {
    let x = noisy_identity(7)
    print(x)
    let r = shout(10)
    print(r)
}
