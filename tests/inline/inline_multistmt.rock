// @inline bodies with side-effecting prefix statements before the result (the
// fluent-builder shape), and indirect multi-return calls inside an inlined body.

global SIDE: int = 0

fn bump() -> int {
    SIDE = SIDE + 1
    return 0
}

fn bump_by(n: int) -> int {
    SIDE = SIDE + n
    return 0
}

@inline
fn tap(r: int) -> int {
    bump()
    return r
}

@test(output = "7 1\n42 4")
fn test_tap() {
    SIDE = 0
    let r = tap(7)
    print("{r} {SIDE}")
    let c = tap(tap(tap(42)))
    print("{c} {SIDE}")
}

// Multiple prefix statements and a trailing expression without `return`.
@inline
fn double_tap(r: int) -> int {
    bump()
    bump()
    r
}

@test(output = "5 2")
fn test_double_tap() {
    SIDE = 0
    let r = double_tap(5)
    print("{r} {SIDE}")
}

// Substitution must reach the parameter used in a prefix statement.
@inline
fn tap_with(r: int, add: int) -> int {
    bump_by(add)
    return r
}

@test(output = "9 10")
fn test_tap_with_param_in_prefix() {
    SIDE = 0
    let r = tap_with(9, 10)
    print("{r} {SIDE}")
}

// Regression: a multi-statement @inline spliced at statement position after
// a `let` must not trip Lua's "ambiguous syntax (function call x new
// statement)" rule. Before the let emitter appended `;`, the previous line
// `local x = <struct_ctor>(...)` ran together with a following IIFE.
struct R { x: int, y: int }

@inline
fn tap_struct(r: R) -> R {
    bump()
    return r
}

@test(output = "2")
fn test_let_struct_then_multistmt_inline() {
    SIDE = 0
    let r = R { x: 1, y: 2 }
    tap_struct(r)
    tap_struct(r)
    print(SIDE)
}

@inline
fn run_once(n: int) -> int {
    bump()
    return n
}

@test(output = "4")
fn test_let_call_then_multistmt_inline_stmts() {
    SIDE = 0
    let n = bump()
    run_once(1)
    run_once(2)
    run_once(3)
    print(SIDE)
}

fn make_pair(x: int) -> (int, int) {
    return (x + 1, x * 2)
}

@inline
fn call_pair(f: fn(int) -> (int, int), x: int) -> int {
    let (a, b) = f(x)
    return a + b
}

@test(output = "31")
fn test_inline_indirect_multi_return() {
    print(call_pair(make_pair, 10))
}

// Caller locals live in low-numbered cells -- exactly what stale callee dest
// ids would corrupt. Pin that they survive the splice.
@test(output = "7 9 31")
fn test_caller_locals_survive_splice() {
    let keep_a = 7
    let keep_b = 9
    let r = call_pair(make_pair, 10)
    print("{keep_a} {keep_b} {r}")
}
