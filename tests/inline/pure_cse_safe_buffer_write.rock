// Roadmap §2.4 Issue 1: PureCse should treat NativeBuffer slot writes
// as non-barriers, so identical pure calls before+after dedupe.
// Pre-fix: 3 separate calls; post-fix: 1 call extracted, 2 references.

value V2 {
    x: float,
    y: float,
}

fn native_buffer_v2(n: int) -> NativeBuffer<V2> {
    return native_buffer_alloc(n)
}

@pure fn make_v2(a: float) -> V2 {
    return V2 { x: a, y: a }
}

@test(output = "1\n1\n2\n2\n1\n1")
fn test_cse_survives_safe_buffer_write() {
    let buf = native_buffer_v2(3)

    // make_v2(1.0) appears at slot 0 and slot 2 with one buf-write
    // between them. Pre-fix the CSE table cleared after the slot 1
    // write and slot 2 re-allocated. Post-fix the table survives,
    // so slot 2 reuses slot 0's binding.
    buf[0] = make_v2(1.0)
    buf[1] = make_v2(2.0)
    buf[2] = make_v2(1.0)

    let a = buf[0]; print("{a.x.floor()}"); print("{a.y.floor()}")
    let b = buf[1]; print("{b.x.floor()}"); print("{b.y.floor()}")
    let c = buf[2]; print("{c.x.floor()}"); print("{c.y.floor()}")
}

// A multi-line `//` comment between sibling pure-call statements used to
// reset the PureCse table between the calls.
@test(output = "1\n1\n2\n2\n1\n1")
fn test_cse_with_comment_between() {
    let buf = native_buffer_v2(3)
    buf[0] = make_v2(1.0)
    // multi-line
    // comment
    // here
    buf[1] = make_v2(2.0)
    buf[2] = make_v2(1.0)

    let a = buf[0]; print("{a.x.floor()}"); print("{a.y.floor()}")
    let b = buf[1]; print("{b.x.floor()}"); print("{b.y.floor()}")
    let c = buf[2]; print("{c.x.floor()}"); print("{c.y.floor()}")
}
