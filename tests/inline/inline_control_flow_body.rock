// V0 @inline with supported control-flow expressions in the body.
//
// These exercise the substitute_expr_params / count_ident_uses paths
// that walk into If expressions and Block expressions — the previous
// `_ => expr.kind.clone()` fallthrough silently failed to substitute
// params inside If branches, producing broken Lua. These tests catch
// any regression of that fix.

// --- If-expression body ---

@inline
fn saturating_sub(a: int, b: int) -> int {
    return if a > b { a - b } else { 0 }
}

@test(output = "5")
fn test_if_body_true_branch() {
    print(saturating_sub(10, 5))
}

@test(output = "0")
fn test_if_body_false_branch() {
    print(saturating_sub(3, 7))
}

// --- Nested If in If ---

@inline
fn my_sign(x: int) -> int {
    return if x > 0 { 1 } else { if x < 0 { -1 } else { 0 } }
}

@test(output = "1")
fn test_nested_if_positive() {
    print(my_sign(42))
}

@test(output = "-1")
fn test_nested_if_negative() {
    print(my_sign(-5))
}

@test(output = "0")
fn test_nested_if_zero() {
    print(my_sign(0))
}

// --- Multi-param If body with field access ---

struct Range { lo: int, hi: int }

@inline
fn clamp_to_range(v: int, r: Range) -> int {
    return if v < r.lo { r.lo } else { if v > r.hi { r.hi } else { v } }
}

@test(output = "5")
fn test_if_body_with_field_access() {
    let r = Range { lo: 0, hi: 10 }
    print(clamp_to_range(5, r))
}

@test(output = "10")
fn test_if_body_clamped_high() {
    let r = Range { lo: 0, hi: 10 }
    print(clamp_to_range(99, r))
}

@test(output = "0")
fn test_if_body_clamped_low() {
    let r = Range { lo: 0, hi: 10 }
    print(clamp_to_range(-5, r))
}

// --- Combined: struct-literal arg with field-substitution + If body ---

@test(output = "7")
fn test_struct_literal_arg_in_if_body() {
    // Range { lo: 0, hi: 10 } is a struct literal; r is used via .lo / .hi
    // only. V0.7 field-substitutes per-field; V0 If walker substitutes
    // through both branches.
    print(clamp_to_range(7, Range { lo: 0, hi: 10 }))
}
