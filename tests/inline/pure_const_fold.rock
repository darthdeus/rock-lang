// Compile-time constant folding through @pure calls, including UFCS
// `obj.method(...)` calls. A @pure straight-line `return <expr>` body with
// all-literal args folds to a literal; non-constant args and impure callees
// stay as calls. These tests assert the runtime values agree either way.

@pure
fn triple(x: int) -> int {
    return x + x + x
}

@pure
fn linear(a: int, b: int, x: int) -> int {
    return a * x + b
}

@pure
fn boolish(a: bool, b: bool) -> bool {
    return a && b
}

@pure
fn square(x: int) -> int {
    return x * x
}

@test(output = "15\n23\n19\ntrue\n49")
fn test_pure_calls_fold() {
    let a = triple(5)
    print(a)
    let b = linear(4, 3, 5)
    print(b)
    // Post-order: triple(2) folds to 6 first, then linear(6, 1, 3).
    let c = linear(triple(2), 1, 3)
    print(c)
    let d = boolish(true, true)
    print(d)
    let n = 7
    let e = square(n)
    print(e)
}

@pure
fn neg_int(x: int) -> int {
    return -x
}

@pure
fn add_int(x: int, y: int) -> int {
    return x + y
}

fn impure_neg(x: int) -> int {
    return -x
}

@test(output = "3\n7\n-9\n-5")
fn test_ufcs_calls_fold() {
    let a = (-3).neg_int()
    print(a)
    let b = (3).add_int(4)
    print(b)
    let n = 9
    let c = n.neg_int()
    print(c)
    let d = (5).impure_neg()
    print(d)
}

// Regression: the folder evaluated `int / int` and `int % int` with Rust's
// truncate-toward-zero semantics, but runtime int division floors and `%`
// is floor-modulo. Fold and runtime diverged whenever exactly one operand
// was negative.
@pure fn idiv(a: int, b: int) -> int { return a ./ b }
@pure fn imod(a: int, b: int) -> int { return a % b }

@test(output = "5\n-4\n-4\n3\n1\n-1\n-1")
fn test_int_div_mod_match_runtime() {
    print("{idiv(20, 4)}")
    // idiv:    -7/2,  7/-2, -7/-2
    print("{idiv(-7, 2)}")
    print("{idiv(7, -2)}")
    print("{idiv(-7, -2)}")
    // imod:    -7%2,  7%-2, -7%-2
    print("{imod(-7, 2)}")
    print("{imod(7, -2)}")
    print("{imod(-7, -2)}")
}
