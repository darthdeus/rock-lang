// @inline argument handling: every argument evaluates exactly once, in
// source order, whether the body reads its parameter many times, reads
// several fields of it, or ignores it. A non-duplication-safe argument is
// hoisted into a fresh local (or emitted as a bare statement when unused).

global CALLS: int = 0

fn produce(n: int) -> int {
    CALLS = CALLS + 1
    return n
}

fn tick(label: string) -> int {
    CALLS = CALLS + 1
    print("{label}={CALLS}")
    return CALLS
}

@inline
fn params_reversed_usage(a: int, b: int) -> int {
    return b * 100 + a
}

@inline
fn ignore_second(a: int, b: int) -> int {
    return a
}

@test(output = "A=1\nB=2\n201")
fn test_arg_order_preserved_even_if_body_reverses() {
    CALLS = 0
    let r = params_reversed_usage(tick("A"), tick("B"))
    print(r)
}

@test(output = "A=1\nB=2\n1")
fn test_unused_arg_still_evaluates_once() {
    CALLS = 0
    let r = ignore_second(tick("A"), tick("B"))
    print(r)
}

@inline
fn constant_42(a: int, b: int) -> int {
    return 42
}

@test(output = "42 2")
fn test_both_ignored_side_effects() {
    CALLS = 0
    let r = constant_42(produce(1), produce(2))
    print("{r} {CALLS}")
}

@inline
fn square(x: int) -> int {
    return x * x
}

@inline
fn triple(x: int) -> int {
    return x + x + x
}

@inline
fn deep_use(x: int) -> int {
    return (x * 2) + (x * 3) + x
}

@test(output = "49 1\n30 2\n42 3")
fn test_multi_use_param_evaluates_once() {
    CALLS = 0
    let a = square(produce(7))
    print("{a} {CALLS}")
    let b = triple(produce(10))
    print("{b} {CALLS}")
    let c = deep_use(produce(7))
    print("{c} {CALLS}")
}

// One param needs hoisting, another is already dup-safe (literal).
@inline
fn mix(x: int, mult: int) -> int {
    return x * mult + x
}

@test(output = "33 1")
fn test_hoist_mixed_params() {
    CALLS = 0
    let r = mix(produce(3), 10)
    print("{r} {CALLS}")
}

@inline
fn double(x: int) -> int {
    return x + x
}

@test(output = "12 1")
fn test_hoist_nested_inline() {
    CALLS = 0
    let r = double(triple(produce(2)))
    print("{r} {CALLS}")
}

// Field reads on a call argument: the field-level path cannot fire, so the
// whole value is hoisted once and every `param.f` reads the bound local.
struct V2 { x: int, y: int }
struct Color { r: int, g: int, b: int, a: int }

fn produce_v2(x: int, y: int) -> V2 {
    CALLS = CALLS + 1
    return V2 { x: x, y: y }
}

fn make_color(r: int, g: int, b: int, a: int) -> Color {
    CALLS = CALLS + 1
    return Color { r: r, g: g, b: b, a: a }
}

@inline
fn sum_xy(p: V2) -> int {
    return p.x + p.y
}

@inline
fn lopsided(p: V2) -> int {
    return p.x + p.x + p.y
}

@inline
fn color_sum(c: Color) -> int {
    return c.r + c.g + c.b + c.a
}

@test(output = "7 1\n10 2\n10 3")
fn test_field_projection_hoist() {
    CALLS = 0
    let a = sum_xy(produce_v2(3, 4))
    print("{a} {CALLS}")
    let b = color_sum(make_color(1, 2, 3, 4))
    print("{b} {CALLS}")
    let c = lopsided(produce_v2(3, 4))
    print("{c} {CALLS}")
}

// A struct-literal argument whose unread field has a side-effecting
// initializer: the initializer still runs once.
@inline
fn read_x(p: V2) -> int {
    return p.x
}

@test(output = "5 1")
fn test_field_level_ignored_side_effecting_init() {
    CALLS = 0
    let r = read_x(V2 { x: 5, y: produce(99) })
    print("{r} {CALLS}")
}
