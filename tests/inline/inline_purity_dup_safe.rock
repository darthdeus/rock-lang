// Argument purity decides whether an @inline body may read a param several
// times without a hoist. A wrong "pure" verdict duplicates an effect, so each
// case must print the same as the out-of-line call. Pure scalar calls, BinOps
// over dup-safe operands and user-vouched @pure opaque bodies substitute
// directly; mis-annotating an effectful opaque body miscompiles (same trust
// level as @nomangle).

@inline
fn triple(x: int) -> int {
    return x + x + x
}

@inline
fn sum_3(a: float) -> float {
    return a + a + a
}

fn abs_like(n: int) -> int {
    return if n < 0 { 0 - n } else { n }
}

fn square(n: int) -> int {
    return n * n
}

@test(output = "15\n15\n12")
fn test_inferred_pure_args_dup_safe() {
    let r = triple(abs_like(-5))
    print(r)
    let a = 3
    let b = 2
    let s = triple(a + b)
    print(s)
    let t = triple(square(2))
    print(t)
}

@pure
inline(lua) fn lua_abs(n: int) -> int = "if n < 0 then return -n else return n end"

@pure
inline(js) fn lua_abs(n: int) -> int = "return n < 0 ? -n : n;"

// A body-defined fn calling a @pure opaque fn is verified pure itself.
fn double_it(n: int) -> int {
    return lua_abs(n) * 2
}

@test(output = "15\n30")
fn test_pure_opaque_body_dup_safe() {
    let r = triple(lua_abs(-5))
    print(r)
    let s = triple(double_it(-5))
    print(s)
}

// Stdlib `abs` and `floor` are @pure.
@test(output = "4.5\n12")
fn test_stdlib_pure_args() {
    let x = -1.5
    let r = sum_3(abs(x))
    print(r)
    let s = sum_3(floor(4.7))
    print(s)
}

@pure
fn square_plus_one(n: int) -> int {
    let s = n * n
    return s + 1
}

@pure
fn plus_two(n: int) -> int {
    return square_plus_one(n) + 2
}

@test(output = "51\n57")
fn test_rock_body_pure_accepted_and_transitive() {
    let r = sum_3(square_plus_one(4) as float)
    print(r)
    let s = sum_3(plus_two(4) as float)
    print(s)
}

global G_CONST: int = 10

global G_MUT: int = 7

// A bare global ident is idempotent to read; a fn reading a mutable global
// is not pure (the global is not bound by the fn).
fn read_global() -> int {
    return G_MUT
}

// Recursive fns may be classified impure by the recursion-stack check;
// the result is the same either way.
fn fib(n: int) -> int {
    return if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

@test(output = "30\n21\n15")
fn test_triple_of_global_and_calls() {
    let a = triple(G_CONST)
    print(a)
    let b = triple(read_global())
    print(b)
    let c = triple(fib(5))
    print(c)
}

enum Color { Red, Green, Blue }

@inline
fn pair_eq(c: Color) -> bool {
    return c == c
}

@test(output = "true")
fn test_qualified_enum() {
    let r = pair_eq(Color::Red)
    print(r)
}

// Interpolated strings are pure when their parts are.
@inline
fn concat_twice(s: string) -> string {
    return s + s
}

fn make_greeting(name: string) -> string {
    return "hello {name}"
}

@test(output = "hello bobhello bob")
fn test_interp_dup() {
    let r = concat_twice(make_greeting("bob"))
    print(r)
}

// A fn returning a value struct is dup-safe.
value Point { x: int, y: int }

fn mk_point(n: int) -> Point {
    return Point { x: n, y: n }
}

@inline
fn pt_sum(p: Point) -> int {
    return p.x + p.y + p.x
}

@test(output = "15")
fn test_value_struct_dup() {
    let r = pt_sum(mk_point(5))
    print(r)
}

global LOG_COUNT: int = 0

value V2 { x: int, y: int }

fn __op_add(a: V2, b: V2) -> V2 {
    LOG_COUNT = LOG_COUNT + 1
    return V2 { x: a.x + b.x, y: a.y + b.y }
}

// @inline fn with param used exactly twice -- drives the dup decision.
@inline
fn sum_twice(p: V2) -> int {
    return p.x + p.y + p.x + p.y
}

@test(output = "call_count=1 result=12")
fn test_binop_overload_side_effect() {
    LOG_COUNT = 0
    let a = V2 { x: 1, y: 2 }
    let b = V2 { x: 2, y: 1 }
    // Argument is `a + b` -- a BinOp. If purity says "pure" (because
    // operands are bare idents/pure), dup-safe -> duplicated 4 times.
    // Result would be 12 either way (value-equal) BUT LOG_COUNT would
    // bump 4x instead of 1x.
    let r = sum_twice(a + b)
    print("call_count={LOG_COUNT} result={r}")
}

// Case A: honestly-pure inline(lua). No side effect, referentially
// transparent. Marked @pure. LICM/CSE may fire; runtime unchanged.
@pure @nomangle
inline(lua) fn trusted_abs(x: int) -> int = "return math.abs(x)"

@pure @nomangle
inline(js) fn trusted_abs(x: int) -> int = "return Math.abs(x);"

@test(output = "10")
fn test_pure_inline_lua_honest() {
    let sum = 0
    for i in 0..5 {
        sum = sum + trusted_abs(0 - 2)
    }
    print(sum)
}

// Case B: honestly-pure inline(lua) used twice with same arg; CSE may
// collapse. Result unchanged.
@test(output = "14")
fn test_pure_inline_lua_cse() {
    let x = 0 - 7
    print(trusted_abs(x) + trusted_abs(x))
}

// Case C: bare call to honestly-pure inline(lua) is DCE'd. Runtime
// unchanged — we didn't observe it anyway.
@test(output = "after")
fn test_pure_inline_lua_dce_bare_call() {
    trusted_abs(99)
    print("after")
}
