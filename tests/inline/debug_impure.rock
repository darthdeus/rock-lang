// @debug_impure marks a function whose only side effect is debug
// observation. A `@pure` function that calls one (directly, or through
// stdlib `print`) is demoted to impure with a warning, not an error, and
// still runs correctly. Transitive demotion through longer chains is pinned
// in adversarial_pure_oracle.rock.

@debug_impure
inline(lua) fn trace_int(n: int) = "-- trace {n}"
@debug_impure
inline(js) fn trace_int(n: int) = "/* trace {n} */"

@pure
fn noisy_identity(n: int) -> int {
    trace_int(n)
    return n
}

@pure
fn shout(n: int) -> int {
    print("shout")
    return n * 2
}

@test(output = "7\nshout\n20")
fn test_debug_impure_demotes_but_compiles() {
    let x = noisy_identity(7)
    print(x)
    let r = shout(10)
    print(r)
}
