// Behavior tests for `let x = if ... { ... } else { ... }` lowering.
// The codegen for this shape no longer allocates a Lua closure wrapper
// (IIFE); observable semantics must be unchanged.

@test(output = "1\n2")
fn test_let_if_rvalue_both_branches() {
    let c = true
    let x = if c { 1 } else { 2 }
    print(x)
    let d = false
    let y = if d { 1 } else { 2 }
    print(y)
}

@test(output = "many")
fn test_let_if_rvalue_elseif_chain() {
    let n = 2
    let s = if n == 0 { "zero" } else if n == 1 { "one" } else { "many" }
    print(s)
}

@test(output = "2")
fn test_let_if_rvalue_nested() {
    let a = true
    let b = false
    let x = if a { if b { 1 } else { 2 } } else { 3 }
    print(x)
}

@test(output = "7")
fn test_let_if_rvalue_shadowing() {
    let x = 99
    let x = if x > 0 { 7 } else { 8 }
    print(x)
}

@test(output = "42\n-1")
fn test_let_if_rvalue_nullable() {
    let c = true
    let x: int? = if c { 42 } else { null }
    if x != null { print(x) } else { print(-1) }
    let d = false
    let y: int? = if d { 42 } else { null }
    if y != null { print(y) } else { print(-1) }
}

// Side effects in the branches must fire exactly once, matching the
// taken arm. This catches any accidental double-evaluation in the
// new lowering.
global SIDE_A: int = 0
global SIDE_B: int = 0

fn bump_a() -> int {
    SIDE_A = SIDE_A + 1
    10
}

fn bump_b() -> int {
    SIDE_B = SIDE_B + 1
    20
}

@test(output = "10 1 0\n20 1 1")
fn test_let_if_rvalue_side_effects() {
    SIDE_A = 0
    SIDE_B = 0
    let x = if true { bump_a() } else { bump_b() }
    print("{x} {SIDE_A} {SIDE_B}")
    let y = if false { bump_a() } else { bump_b() }
    print("{y} {SIDE_A} {SIDE_B}")
}
