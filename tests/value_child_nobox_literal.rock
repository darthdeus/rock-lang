// A GC-table value (`RoomC`, kept off cdata by its string) holding a plain
// cdata value child (`Span2`) whose own fields are `nobox` values. The child's
// constructor sits inside the GC-table constructor, and its `nobox` fields
// must still be written as the child's leaves, never as boxes of their own.

nobox value Cell { x: int, y: int }
value Span2 { lo: Cell, hi: Cell }
value RoomC { span: Span2, tag: int, name: string }
value RoomN { span: Span2, pin: Cell? = null, name: string }

struct RoomHolder {
    room: RoomC,
}

fn room_holders() -> [RoomHolder] {
    let hs: [RoomHolder] = []
    hs.push(RoomHolder { room: RoomC { span: Span2 { lo: Cell { x: 1, y: 2 }, hi: Cell { x: 3, y: 4 } }, tag: 7, name: "a" } })
    return hs
}

fn span_sum(r: ref RoomC) -> int {
    let s = r.span
    return s.lo.x + s.lo.y * 10 + r.span.hi.x * 100
}

fn span_shift(r: ref RoomC, d: int) {
    r.span = Span2 { lo: Cell { x: r.span.lo.x + d, y: r.span.lo.y }, hi: r.span.hi }
    r.span.hi.y = r.span.hi.y + d
}

@test
fn vec_stored_literal() {
    let rooms: [RoomC] = []
    rooms.push(RoomC { span: Span2 { lo: Cell { x: 1, y: 2 }, hi: Cell { x: 3, y: 4 } }, tag: 7, name: "a" })
    assert_eq(rooms[0].span.hi.x, 3, "literal stored")
    assert_eq(rooms[0].span.lo.y, 2)
    assert_eq(rooms[0].tag, 7)
    assert_eq(rooms[0].name, "a")
}

@test
fn whole_read() {
    let hs = room_holders()
    let s = hs[0].room.span
    assert_eq(s.lo.x + s.hi.y, 5)
    assert_eq(hs[0].room.span.hi, Cell { x: 3, y: 4 })
}

@test
fn whole_write() {
    let hs = room_holders()
    let h = hs[0]
    h.room.span = Span2 { lo: Cell { x: 5, y: 6 }, hi: Cell { x: 7, y: 8 } }
    assert_eq(hs[0].room.span.lo.y, 6)
    assert_eq(hs[0].room.span.hi.x, 7)
}

@test
fn leaf_write_after_whole_write() {
    let hs = room_holders()
    let h = hs[0]
    h.room.span = Span2 { lo: Cell { x: 5, y: 6 }, hi: Cell { x: 7, y: 8 } }
    h.room.span.hi.x = h.room.span.hi.x + 100
    assert_eq(hs[0].room.span.hi.x, 107)
    assert_eq(hs[0].room.span.lo.x, 5)
}

@test
fn sibling_kept() {
    let hs = room_holders()
    let h = hs[0]
    h.room.span = Span2 { lo: Cell { x: 5, y: 6 }, hi: Cell { x: 7, y: 8 } }
    assert_eq(h.room.tag, 7)
    assert_eq(h.room.name, "a")
}

@test
fn through_ref_param() {
    let hs = room_holders()
    assert_eq(span_sum(hs[0].room), 321)
    span_shift(hs[0].room, 1)
    assert_eq(hs[0].room.span.lo, Cell { x: 2, y: 2 })
    assert_eq(hs[0].room.span.hi, Cell { x: 3, y: 5 })
    assert_eq(hs[0].room.tag, 7)
}

@test
fn copy_stays_a_snapshot() {
    let hs = room_holders()
    let h = hs[0]
    let snap = h.room.span
    let room_snap = h.room
    h.room.span = Span2 { lo: Cell { x: 9, y: 9 }, hi: Cell { x: 9, y: 9 } }
    h.room.span.lo.x = 10
    assert_eq(snap.lo, Cell { x: 1, y: 2 })
    assert_eq(room_snap.span.hi, Cell { x: 3, y: 4 })
    assert_eq(h.room.span.lo, Cell { x: 10, y: 9 })
}

@test
fn nullable_nobox_sibling() {
    let rooms: [RoomN] = []
    rooms.push(RoomN { span: Span2 { lo: Cell { x: 1, y: 2 }, hi: Cell { x: 3, y: 4 } }, name: "n" })
    rooms.push(RoomN { span: Span2 { lo: Cell { x: 5, y: 6 }, hi: Cell { x: 7, y: 8 } }, pin: Cell { x: 9, y: 10 }, name: "m" })
    assert(rooms[0].pin == null, "absent pin")
    assert_eq(rooms[1].pin.unwrap().y, 10)
    assert_eq(rooms[1].span.hi.y, 8)
    rooms[0].span = Span2 { lo: Cell { x: 11, y: 12 }, hi: Cell { x: 13, y: 14 } }
    rooms[0].pin = Cell { x: 1, y: 1 }
    assert_eq(rooms[0].span.lo.y, 12)
    assert_eq(rooms[0].pin.unwrap().x, 1)
    assert_eq(rooms[0].name, "n")
}
