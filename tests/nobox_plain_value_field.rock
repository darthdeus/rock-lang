nobox value FieldSid { value: int }
value FieldPoint { x: float, y: float }
value FieldPair { point: FieldPoint }
nobox value FieldPlace { space: FieldSid, pos: FieldPoint }
nobox value DeepFieldPlace { space: FieldSid, pos: FieldPair }
struct FieldHolder { place: FieldPlace }
struct DeepFieldHolder { place: DeepFieldPlace }
struct NullableFieldHolder { place: FieldPlace? }

fn field_holder(x: float) -> FieldHolder {
    return FieldHolder { place: FieldPlace { space: FieldSid { value: 3 }, pos: FieldPoint { x: x, y: 2.0 } } }
}

fn field_x(h: FieldHolder) -> float { return h.place.pos.x }
fn field_y(h: FieldHolder) -> float { return h.place.pos.y }
fn deep_field_x(h: DeepFieldHolder) -> float { return h.place.pos.point.x }
fn deep_field_y(h: DeepFieldHolder) -> float { return h.place.pos.point.y }

@test fn nobox_plain_field_reads_stored_leaves() {
    let h = field_holder(9.5)
    assert_eq(field_x(h), 9.5)
    assert_eq(field_y(h), 2.0)
}

@test fn nobox_plain_field_reads_deep_plain_leaves() {
    let h = DeepFieldHolder { place: DeepFieldPlace { space: FieldSid { value: 4 }, pos: FieldPair { point: FieldPoint { x: 7.5, y: 3.0 } } } }
    assert_eq(deep_field_x(h), 7.5)
    assert_eq(deep_field_y(h), 3.0)
}

@test fn nobox_plain_nullable_field_reads_presence_and_leaves() {
    let present = NullableFieldHolder { place: FieldPlace { space: FieldSid { value: 3 }, pos: FieldPoint { x: 6.5, y: 4.0 } } }
    let absent = NullableFieldHolder { place: null }
    assert_eq(present.place?.pos?.x ?? -1.0, 6.5)
    assert_eq(absent.place?.pos?.x ?? -1.0, -1.0)
}

@test fn nobox_plain_field_reads_a_vec_element() {
    let hs = [field_holder(5.5), field_holder(8.5)]
    assert_eq(field_x(hs[0]), 5.5)
    assert_eq(field_x(hs[1]), 8.5)
}

@test fn nobox_plain_field_reads_after_whole_child_write() {
    let h = field_holder(1.5)
    h.place.pos = FieldPoint { x: 12.5, y: 13.0 }
    assert_eq(field_x(h), 12.5)
    assert_eq(field_y(h), 13.0)
}
