// Shadowing that reads the outer binding in its own initializer: in loop
// bodies, lambdas, nested branches, and over overloaded functions and globals.

fn f() -> int { return 1 }
fn f(x: int) -> int { print(x); return 0 }

struct Point { x: int, y: int }

global g: int = 50

@test(output = "11\n12\n13\n10")
fn test_for_loop_shadowing() {
    let x = 10
    for i in [1, 2, 3] {
        let x = x + i
        print(x)
    }
    print(x)
}


@test(output = "47\n42")
fn test_lambda_capture_shadowing() {
    let x = 42
    let f = (y: int) => {
        let x = x + y
        return x
    }
    
    print(f(5))
    print(x)
}

@test(output = "43\n1\n10")
fn test_function_overload_shadowing() {
    let run = true
    while run {
        let f = 42
        f = f + 1
        print(f)
        run = false
    }

    print(f())
    let result = f(10)
}

@test(output = "5\n6\n2\n1")
fn test_multiple_level_shadowing() {
    let x = 1
    if true {
        let x = x + 1
        if true {
            let x = x * 3
            if true {
                let x = x - 1
                print(x)
            }
            print(x)
        }
        print(x)
    }
    print(x)
}

@test(output = "16\n8\n8\n5\n3")
fn test_complex_expression_shadowing() {
    let x = 5
    let y = 3
    
    if x > y {
        let result = x + y
        if result > 7 {
            let x = result * 2
            let y = x - result
            print(x)
            print(y)
        }
        print(result)
    }
    
    print(x)
    print(y)
}

@test(output = "105\n100")
fn test_struct_field_shadowing() {
    let point = Point { x: 5, y: 10 }
    let x = 100
    
    if true {
        let x = point.x + x
        print(x)
    }
    print(x)
}

@test(output = "20\n10")
fn test_else_block_shadowing() {
    let x = 10
    if false {
        print(x)
    } else {
        let x = x * 2
        print(x)
    }
    print(x)
}

@test(output = "50\n15\n50")
fn test_global_shadowing() {
    print(g)
    if true {
        let g = 15
        print(g)
    }
    print(g)
}
