// Locals, parameters and generic parameters named like functions, globals
// and types: each resolves to the nearest binding, and a `let` may read the
// outer meaning of its own name in its initializer.

fn helper_function() -> int {
    return 99
}

global global_var: int = 999

fn nested_call() -> int {
    let helper_function = 30
    return test_inner(helper_function)
}

fn test_inner(helper: int) -> int {
    return helper
}

@test(output = "30\n7\n5\n999\n99")
fn params_and_locals_shadow_function_names() {
    print(nested_call())
    print(multi_param_test(7, 8))
    print(nested_local_shadows_helper())
    print(helper())
    print(helper_function())
}

@test(output = "42\n10\n42\n999")
fn parameter_shadows_global_variable() {
    print(use_parameter(42))
    print(process_param(5))
    print(counter)
    print(global_var)
}

@test(output = "1\n2\n1")
fn test_block_scope_shadowing() {
    let x = 1
    print(x)

    // Inner block with shadowing
    {
        let x = 2
        print(x)
    }

    print(x)
}

fn use_parameter(global_var: int) -> int {
    return global_var
}

fn multi_param_test(helper_function: int, v: int) -> int {
    // Parameters shadow functions with same names
    return helper_function
}

@test(output = "1\n2\n1")
fn test_sequential_let_shadowing() {
    let x = 1
    print(x)

    let x = 2
    print(x)

    let x = x - 1
    print(x)
}

@test(output = "5\n10\n5")
fn test_else_branch_shadowing() {
    let branch_var = 5
    print(branch_var)

    if false {
        let branch_var = 99
        print(branch_var)
    } else {
        let branch_var = 10
        print(branch_var)
    }

    print(branch_var)
}

fn helper() -> int {
    return 999
}

fn item() -> int {
    return 999
}

fn value_func() -> int {
    return 42
}

fn nested_local_shadows_helper() -> int {
    let helper = 5
    return test_inner(helper)
}

global counter: int = 42
global value: int = 100
global counter2: int = 0
global x: int = 1
global g2: int = 100

fn process_param(counter: int) -> int {
    return counter * 2
}

fn increment_global() {
    counter2 = counter2 + 1
}

fn test_shadow_local() -> int {
    let counter = 50
    increment_global()
    return counter
}

fn test_lambda_capture() -> int {
    let x = 10
    let f = () => {
        return x
    }
    let x = 20
    return f()
}

fn test_lambda_global() {
    let capture_global = () => {
        return g2
    }

    let g2 = 10

    print(capture_global())
    print(g2)
}

fn test_func(x: int = 10, default_val: int = 20) -> int {
    return x + default_val
}

fn test_types() {
    print(value_func())

    let value = "hello"
    print(value)

    let inner = () => {
        let value = 3.14
        print(value)
    }
    inner()
}

fn test_type_alias(x: int) -> int {
    // 'int' in type annotation refers to the type, not the variable
    return x * 2
}

@test(output = "0\n50\n1")
fn global_mutation_with_shadowing() {
    counter2 = 0
    print(counter2)
    print(test_shadow_local())
    print(counter2)
}

@test(output = "10")
fn lambda_captures_shadowed_variable() {
    print(test_lambda_capture())
}

@test(output = "42\n100")
fn lambda_parameter_shadows_capture() {
    let outer = 100
    let f = (outer: int) => {
        return outer
    }

    print(f(42))
    print(outer)
}

@test(output = "10\n1")
fn nested_lambda_shadowing() {
    let x = 1
    let outer = () => {
        let x = 10
        let inner = () => {
            return x
        }
        return inner
    }

    let inner_fn = outer()
    print(inner_fn())
    print(x)
}

@test(output = "100\n10")
fn lambda_captures_global_with_local_shadow() {
    test_lambda_global()
}

@test(output = "6\n100")
fn for_loop_var_shadows_outer() {
    let i = 100
    let sum = 0

    for i in [1, 2, 3] {
        sum = sum + i
    }

    print(sum)
    print(i)
}

@test(output = "6\n999")
fn for_loop_shadows_function() {
    let result = 0
    for item in [1, 2, 3] {
        result = result + item
    }

    print(result)
    print(item())
}

@test(output = "30\n25\n8")
fn default_parameter_with_shadowing() {
    let default_val = 100

    print(test_func())
    print(test_func(5))
    print(test_func(5, 3))
}

@test(output = "42\nhello\n3.14")
fn shadow_with_different_types() {
    test_types()
}

@test(output = "1\n2\n3\nfalse")
fn while_loop_condition_shadowing() {
    let flag = false
    let counter = 0

    while counter < 3 {
        let flag = true
        counter = counter + 1
        if flag {
            print(counter)
        }
    }

    print(flag)
}

@test(output = "400\n2")
fn while_loop_nested_shadowing() {
    let i = 0
    let outer_sum = 0

    while i < 2 {
        let inner_i = 10
        let j = 0
        while j < 2 {
            let i = 100
            outer_sum = outer_sum + i
            j = j + 1
        }
        i = i + 1
    }

    print(outer_sum)
    print(i)
}

@test(output = "10\n100")
fn type_alias_shadows_variable() {
    let int = 100

    print(test_type_alias(5))
    print(int)
}

fn get_value() -> int {
    return 42
}

@test
fn test_function_shadowing_with_same_name() {
    let get_value = get_value()

    assert_eq(get_value, 42)
}

fn get_function() -> fn() -> int {
    return () => 100
}

@test
fn test_function_returning_function_shadowing() {
    let get_function = get_function()
    let result = get_function()
    assert_eq(result, 100)
}

global global_func: fn() -> int = () => 200

@test
fn test_global_function_shadowing() {
    // Shadowing a global function
    let global_func = global_func()
    assert_eq(global_func, 200)
}

struct B<T> {
    val: T,
}

// stdlib's `transmute<A, B>` must resolve its own `B`, not this struct.
@test(output = "ok")
fn test_just_declaring_struct_B() {
    let b: B<int> = B { val: 5 }
    print("ok")
}

// User-defined function where param name matches a user struct name.
fn identity_param<B>(x: B) -> B {
    return x
}

@test(output = "42")
fn test_user_generic_param_shadows_struct() {
    let r = identity_param(42)
    print(r)
}

// Generic param shadows an enum.
enum E {
    Alpha,
    Beta,
}

fn identity_E<E>(x: E) -> E {
    return x
}

@test(output = "7")
fn test_user_generic_param_shadows_enum() {
    let r = identity_E(7)
    print(r)
}

// Struct generic param shadows top-level struct.
struct Node<B> {
    v: B,
}

@test(output = "3")
fn test_struct_generic_param_shadows_struct() {
    let n: Node<int> = Node { v: 3 }
    print(n.v)
}

// A struct's generic parameter shadowing a top-level *enum* name.
struct Holder<E> {
    e: E,
}

@test(output = "99")
fn test_struct_generic_param_shadows_enum() {
    let h: Holder<int> = Holder { e: 99 }
    print(h.e)
}

// Enum generic param shadows top-level struct.
enum Wrap<B> {
    Value(B),
}

@test(output = "11")
fn test_enum_generic_param_shadows_struct() {
    let w: Wrap<int> = Wrap::Value(11)
    match w {
        Wrap::Value(v) => print(v),
    }
}
