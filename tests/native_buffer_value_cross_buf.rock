// Adversarial: cross-buffer reads. buf_a[0] = V { x: buf_b[0].y, y: buf_b[0].x }
// — RHS reads from a *different* buffer slot. Pass 1 evaluates each
// leaf into a temp BEFORE taking the slot ref, so no aliasing concern.

@intrinsic @inline inline(lua) fn put(s: string) = "io.write(s)"

value V2 {
    x: float,
    y: float,
}

@nomangle inline(lua) fn __nb_alloc_V2(n: int) -> Ptr<V2> = 'return ffi.new("V2[?]", n)'

fn nb_v2(n: int) -> NativeBuffer<V2> {
    return NativeBuffer { ptr: __nb_alloc_V2(n), len: n }
}

@test(output = "x=8\ny=5")
fn test_cross_buffer() {
    let a = nb_v2(1)
    let b = nb_v2(1)
    a[0] = V2 { x: 1.0, y: 2.0 }
    b[0] = V2 { x: 5.0, y: 8.0 }
    a[0] = V2 { x: b[0].y, y: b[0].x }
    let v = a[0]
    put("x=")
    put("{v.x}")
    put("\n")
    put("y=")
    put("{v.y}")
    put("\n")
}
