global UNIT_EFFECTS: int = 0

fn unit_result() -> () {
    UNIT_EFFECTS += 1
    return ()
}

@test
fn c_unit_array_preserves_count_and_effects() {
    UNIT_EFFECTS = 0
    let items: [()] = [unit_result(), (), unit_result()]
    assert(items.len() == 3)
    assert(UNIT_EFFECTS == 2)
    items.push(())
    assert(items.len() == 4)
    assert(items.get(0) == null)
    let count = 0
    for item in items { count += 1 }
    assert(count == 4)
    items[0] = ()
    let item = items[0]
    let copied: [()] = [item, ()]
    assert(copied.len() == 2)
    let removed = items.pop()
    assert(removed == null)
    assert(items.len() == 3)
    assert(items.remove_at(0) == null)
    assert(items.len() == 2)
    assert(items.swap_remove(0) == null)
    assert(items.len() == 1)
    items.clear()
    assert(items.len() == 0)
}

co fn finish_unit() -> Coroutine<int, ()> { yield 7; return () }

fn take_unit(coroutine: Coroutine<int, ()>) -> () {
    assert(coroutine.completed())
    // Unit completion stores nil; the completed guard checks this bridge.
    // rock: allow(transmute_of_nullable)
    return cast(coroutine.result())
}

@test
fn c_unit_coroutine_completion_and_result() {
    let coroutine = finish_unit()
    assert(coroutine.resume() == 7)
    assert(!coroutine.completed())
    let _ = coroutine.resume()
    assert(coroutine.completed())
    take_unit(coroutine)
}
