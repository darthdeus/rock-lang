//=== TEST CASE: value_int_literal_high_Generic ===
//! expect: value struct `int` field must be in the range -2147483648..=2147483647
value V { x: int }
fn main() { let v = V { x: 2147483648 } }

//=== TEST CASE: value_int_literal_low_Generic ===
//! expect: value struct `int` field must be in the range -2147483648..=2147483647
value V { x: int }
fn main() { let v = V { x: -2147483649 } }

//=== TEST CASE: value_int_assignment_Generic ===
//! expect: value struct `int` field must be in the range -2147483648..=2147483647
value V { x: int }
fn main() { let v = V { x: 0 }; v.x = 4294967295 }

//=== TEST CASE: value_int_default_Generic ===
//! expect: value struct `int` field must be in the range -2147483648..=2147483647
value V { x: int = 4294967295 }
fn main() { let v = V {} }
