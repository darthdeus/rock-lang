//=== TEST CASE: composite_explicit_sign_Rejected ===
//! expect: skull-mir: lowering gap: interpolation format specifier (grouping / fill / center)
struct P { x: int }

fn main() {
    let p = P { x: 1 }
    print("{p:+12}")   // ERROR: sign is meaningless on a structural rendering
}

//=== TEST CASE: composite_zero_pad_Rejected ===
//! expect: skull-mir: lowering gap: interpolation format specifier (grouping / fill / center)
struct P { x: int }

fn main() {
    let p = P { x: 1 }
    print("{p:012}")   // ERROR: zero-pad is meaningless on a structural rendering
}

//=== TEST CASE: composite_grouping_Rejected ===
//! expect: skull-mir: lowering gap: interpolation format specifier (grouping / fill / center)
struct P { x: int }

fn main() {
    let p = P { x: 1 }
    print("{p:_}")   // ERROR: digit grouping is meaningless on a structural rendering
}

//=== TEST CASE: array_zero_pad_Rejected ===
//! expect: skull-mir: lowering gap: interpolation format specifier (grouping / fill / center)
fn main() {
    let xs = [1, 2]
    print("{xs:08}")   // ERROR: zero-pad is meaningless on a structural rendering
}

//=== TEST CASE: enum_identity_struct_payload_interp_Generic ===
//! expect: cannot format this value: `Body` is an identity struct
struct Body { hp: int }
enum Owner { Of(Body), Nobody }

fn main() {
    let o = Owner::Of(Body { hp: 1 })
    print("{o}")
}

//=== TEST CASE: enum_vec_payload_tostring_Generic ===
//! expect: cannot format this value: `[int]` is a container
enum Bag { Items([int]), Empty }

fn main() {
    print(tostring(Bag::Items([1, 2])))
}

//=== TEST CASE: enum_callback_payload_interp_Generic ===
//! expect: cannot format this value: `fn() -> int` is a callback
enum Hook { Call(fn() -> int), Idle }

fn main() {
    let h = Hook::Call(() => 1)
    print("{h}")
}

//=== TEST CASE: value_record_with_vec_field_in_enum_Generic ===
//! expect: cannot format this value: `[int]` is a container
value Wrap { xs: [int] }
enum Holder { W(Wrap) }

fn main() {
    print("{Holder::W(Wrap { xs: [1] })}")
}

//=== TEST CASE: value_record_with_vec_field_top_level_Generic ===
//! expect: cannot format this value: `[int]` is a container
value Bag { xs: [int], n: int }

fn main() {
    let b = Bag { xs: [1], n: 5 }
    print("{b}")
}

//=== TEST CASE: any_hole_requires_explicit_inspection_Generic ===
//! expect: cannot interpolate a value of type `any` into a string
//! expect: inspect(value)
fn render_any(value: any) -> string { return "{value}" }
fn main() { print(render_any(42)) }

//=== TEST CASE: nullable_any_with_format_spec_requires_explicit_inspection_Generic ===
//! expect: cannot interpolate a value of type `any?` into a string
//! expect: inspect(value)
fn render_nullable_any(value: any?) -> string { return "{value:.2f}" }
fn main() { print(render_nullable_any(null)) }

//=== TEST CASE: unterminated_call_in_hole_Generic ===
fn add2(a: int, b: int) -> int { return a + b }

fn main() {
    print("{add2(2,}")
}

//=== TEST CASE: string_char_above_ascii_Generic ===
fn main() {
    let s = string_char(233)
    print("{s}")
}

//=== TEST CASE: string_char_negative_Generic ===
fn main() {
    let s = string_char(-1)
    print("{s}")
}
