//! If-expressions: `if cond { a } else { b }`. The condition must be `bool`, and
//! the two branches unify to the result type.

//=== TEST CASE: if_branch_mismatch_Generic ===
// branches disagree (int vs string)
//! expect: type mismatch: expected `string`, found `int`
fn f() -> int {
    let x = if true { 1 } else { "hi" }
    x
}

//=== TEST CASE: if_cond_not_bool_Generic ===
// condition is int, not bool
//! expect: type mismatch: expected `bool`, found `int`
fn f() -> int {
    let x = if 5 { 1 } else { 2 }
    x
}

