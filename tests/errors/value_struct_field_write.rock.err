//! Error: a `value` struct field write that cannot reach storage must be
//!        rejected. A local or by-value parameter owns its copy and a write
//!        replaces its whole value (tests/values/value_local_field_write.rock),
//!        but a call result is a temporary, and `field_set` receives a copy
//!        of its argument, not the caller's place.
//! Tags: value, immutability, field-refs

//=== TEST CASE: value_struct_field_set_Immutable ===
//! expect: a value argument is a copy
value Pt { x: int, y: int }

fn main() {
    let p = Pt { x: 1, y: 2 }
    field_set(p, .x, 5)   // ERROR: field_set cannot write through a value
}

//=== TEST CASE: value_struct_field_set_param_Immutable ===
//! expect: a value argument is a copy
value Pt { x: int, y: int }

fn set_x(p: Pt) {
    field_set(p, .x, 5)   // ERROR: field_set cannot write through a value
}

fn main() {
    set_x(Pt { x: 1, y: 2 })
}

//=== TEST CASE: value_field_write_through_call_temporary_Immutable ===
//! expect: it is a temporary
value Pt { x: int, y: int }
struct Owner { p: Pt }

fn mk() -> Owner { return Owner { p: Pt { x: 1, y: 1 } } }

fn main() {
    mk().p.x = 5   // ERROR: the owner is a temporary, not mutable storage
}

//=== TEST CASE: value_call_result_field_write_Immutable ===
//! expect: it is a temporary
value Pt { x: int, y: int }

fn mk() -> Pt { return Pt { x: 1, y: 1 } }

fn main() {
    mk().x = 5   // ERROR: a call result is a temporary
}
