//=== TEST CASE: newtype_string_ordering_rejected_Generic ===
// Ordering on a non-numeric newtype is rejected: the inner type (`string`) is
// not orderable. (rock: "Ordering comparisons are only supported for numeric
// types".)
//! expect: ordering operators require numeric operands, got Name
newtype Name(string)
fn f() -> bool {
    let a = Name("a")
    let b = Name("b")
    a < b
}

//=== TEST CASE: eq_Generic ===
//! expect: operator `==` is not overloadable
value V { a: int }
operator ==(x: V, y: V) -> bool { return true }
fn main() {}

//=== TEST CASE: ne_Generic ===
//! expect: operator `!=` is not overloadable
value V { a: int }
operator !=(x: V, y: V) -> bool { return true }
fn main() {}

