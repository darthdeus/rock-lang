//=== TEST CASE: plain_fn_spelling_Generic ===
// The reserved name is reserved in every spelling.
//! expect: operator `==` is not overloadable
value V { a: int }
fn __op_eq(x: V, y: V) -> bool { return true }
fn main() {}

//=== TEST CASE: inline_backend_spelling_Generic ===
//! expect: operator `==` is not overloadable
value V { a: int }
@pure @inline operator(lua) ==(x: V, y: V) -> bool = "return true"
fn main() {}

//=== TEST CASE: newtype_eq_with_int_IncompatibleNewtypeOperation ===
// The overloadable symbols are covered positively in
// tests/operators/overloadable.rock.
//! expect: type mismatch: expected `int`, found `UserId`
newtype UserId(int)

fn main() {
    let user_id = UserId(42)
    if user_id == 42 {
        print("Equal")
    }
}

//=== TEST CASE: int_eq_with_newtype_IncompatibleNewtypeOperation ===
//! expect: type mismatch: expected `UserId`, found `int`
newtype UserId(int)

fn main() {
    let user_id = UserId(42)
    if 42 == user_id {
        print("Equal")
    }
}

//=== TEST CASE: different_newtypes_comparison_IncompatibleNewtypeOperation ===
//! expect: type mismatch: expected `Score`, found `UserId`
newtype UserId(int)
newtype Score(int)

fn main() {
    let id = UserId(1)
    let score = Score(1)
    if id == score {
        print("Equal")
    }
}
