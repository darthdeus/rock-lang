//! Error: aliasing BOTH operands of a generic `==` through unannotated lets
//!        does not hide the comparison. `let x = a` infers `x: T`, and the
//!        generic fn-eq summary (bone-semantic fn_identity) reads each
//!        operand's INFERRED type, not its declared one, so `x == y` still
//!        compares `T` and a call instantiating `T` with a fn type is
//!        rejected. Base cases: tests/errors/fn_identity_generic.rock.err.
//! Tags: closures, fn-values, equality, generics

//=== TEST CASE: generic_eq_fn_arg_both_unannotated_alias_Generic ===
fn same<T>(a: T, b: T) -> bool { let x = a; let y = b; return x == y }
fn mk() -> fn() -> int { return () => 1 }

fn main() {
    if same(mk(), mk()) { print("same") }   // ERROR: aliases are still T-typed
}

//=== TEST CASE: generic_eq_fn_arg_call_operands_Generic ===
fn mk_t<T>(x: T) -> T { return x }
fn same<T>(a: T, b: T) -> bool { return mk_t(a) == mk_t(b) }
fn mk() -> fn() -> int { return () => 1 }

fn main() {
    if same(mk(), mk()) { print("same") }   // ERROR: call operands infer as T
}
