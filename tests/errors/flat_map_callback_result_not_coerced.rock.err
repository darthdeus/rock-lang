//! Error: implicit iterable->iterator coercion applies to an argument at an
//!        `Iterator`-bounded parameter, not to a callback's result. A
//!        `flat_map` callback returning a Vec is rejected the same way for
//!        non-nullable, nullable and nobox elements; `.iter()` in the
//!        callback is the spelling (tests/iterators/implicit_coercion.rock).
//! Tags: iterators, coercion, flat_map

//=== TEST CASE: vec_result_int_Generic ===
fn main() {
    //! expect: does not satisfy `Iterator<U>`
    print([1, 2].flat_map(n => [n, n]).count())
}

//=== TEST CASE: vec_result_nullable_Generic ===
fn pair(n: int?) -> [int?] { return [n, n] }

fn main() {
    //! expect: does not satisfy `Iterator<U>`
    let a: [int?] = [1, null]
    print(a.flat_map(pair).count())
}

//=== TEST CASE: vec_result_nobox_Generic ===
nobox value V2 { x: float, y: float }

fn pair(v: V2) -> [V2] { return [v, v] }

fn main() {
    //! expect: does not satisfy `Iterator<U>`
    let a = [V2 { x: 1.0, y: 2.0 }]
    print(a.flat_map(pair).count())
}
