//=== TEST CASE: int_div_float_operand_unify ===
//! expect: No overload for `__op_idiv` with argument types (float, int)
fn main() {
    let x = 3.0 ./ 2
    print(x)
}

//=== TEST CASE: div_result_into_int_param_unify ===
//! expect: use `./` for integer floor division
fn foo(x: int) {}

fn main() {
    foo(3 / 4)   // ERROR: expected int, got float (use ./)
}

//=== TEST CASE: div_result_into_int_let_unify ===
//! expect: use `./` for integer floor division
fn main() {
    let x: int = 3 / 4   // ERROR: expected int, got float (use ./)
    print(x)
}

//=== TEST CASE: float_div_under_multiply_Generic ===
// The hint follows the float through operators and a local binding.
//! expect: `/` is float division; its `float` result does not fit `int` -- use `./` for integer floor division
fn main() { let x: int = 2.0 * (3 / 4) }

//=== TEST CASE: float_div_under_negation_Generic ===
//! expect: `/` is float division; its `float` result does not fit `int` -- use `./` for integer floor division
fn main() { let x: int = -(3 / 4) }

//=== TEST CASE: float_div_through_let_Generic ===
//! expect: `/` is float division; its `float` result does not fit `int` -- use `./` for integer floor division
fn main() {
    let h = 8 / 3
    let x: int = 2 * h
}

//=== TEST CASE: int_newtype_slash_rejected_unify ===
//! expect: No overload for `__op_div` with argument types (Distance, Distance)
newtype Distance(int)

fn main() {
    let a = Distance(10)
    let b = Distance(4)
    print((a / b).0)   // ERROR: int newtype has `./`, not `/`
}

//=== TEST CASE: neg_bool_fail_Generic ===
// negating a bool must fail the numeric constraint
//! expect: operator `-` is not defined for `bool`
fn f(b: bool) -> int {
    let x = -b
    5
}

//=== TEST CASE: neg_string_fail_Generic ===
// negating a string must fail
//! expect: operator `-` is not defined for `string`
fn f(s: string) -> int {
    let x = -s
    5
}

//=== TEST CASE: not_int_fail_Generic ===
// negating a non-bool must fail
//! expect: operator `!` is not defined for `int`
fn f() -> bool {
    let b = !5
    b
}

//=== TEST CASE: lt_bool_fail_Generic ===
// ordering on bools must be rejected
//! expect: ordering operators require numeric operands, got bool
fn f() -> bool {
    let b = true < false
    b
}

//=== TEST CASE: lt_string_fail_Generic ===
// ordering on non-numeric operands (string) must be rejected
//! expect: ordering operators require numeric operands, got string
fn f() -> bool {
    "a" < "b"
}

