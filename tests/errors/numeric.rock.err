//=== TEST CASE: compare_nonnull_eq_null_Generic ===
//! expect: Cannot compare non-nullable type 'int' with null
fn f(x: int) -> bool {
    x == null
}

//=== TEST CASE: compare_nonnull_struct_to_null_Generic ===
// a struct value is non-nullable too.
//! expect: Cannot compare non-nullable type 'S' with null
struct S { v: int }
fn f(x: S) -> bool {
    x != null
}

//=== TEST CASE: compare_assignment_refined_field_to_null_Generic ===
// a nullable FIELD refined to non-null by a same-scope assignment is also dead
// to check (a path-refinement pattern in one scope).
//! expect: Cannot compare non-nullable type 'Inner' with null
struct Inner { v: int }
struct Top { inner: Inner? }
fn f(t: Top) -> bool {
    t.inner = Inner { v: 1 }
    return t.inner != null
}

//=== TEST CASE: sort_key_nullable_value_Generic ===
// A struct or tuple sort key compares its leaves with `<`. An absent value has
// no place in that order.
//! expect: cannot sort by a key of type `Vec2?`: `Vec2?` may be absent
struct It { id: int, p: Vec2? }
fn main() {
    let xs = [It { id: 1, p: null }, It { id: 2, p: v(1.0, 2.0) }]
    xs.sort(x => x.p)
}

//=== TEST CASE: sort_key_bool_leaf_Generic ===
//! expect: cannot sort by a key of type `(bool, int)`: `bool` has no order
fn main() {
    let ys = [1, 2]
    ys.sort(y => (y > 1, y))
}
