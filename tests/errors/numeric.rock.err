//=== TEST CASE: as_to_nominal_Generic ===
// `as` cannot reinterpret `any` as a nominal type: that asserts a type without
// static proof, a runtime nominal check, or backend representation validation.
// `cast<T>` is the explicit escape hatch for erased storage and FFI recovery.
//! expect: cannot convert `any` to `Point` with `as`; `as` converts only between numeric types, or where `any`
struct Point { x: int, y: int }
fn f(a: any) -> int {
    let p = a as Point
    5
}

//=== TEST CASE: aggregate_as_rejects_Generic ===
//! expect: cannot convert `Source` to `Target` with `as`; `as` converts only between numeric types, or where
value Source { x: int }
value Target { x: int }
fn convert(value: Source) -> Target {
    return value as Target
}

//=== TEST CASE: reference_as_rejects_Generic ===
//! expect: cannot convert `ref Source` to `ref Target` with `as`; `as` converts only between numeric types, or
struct Source { x: int }
struct Target { x: int }
fn convert(value: ref Source) -> ref Target {
    return value as ref Target
}

//=== TEST CASE: cast_string_to_int_MismatchedType ===
//! expect: cannot convert `string` to `int` with `as`
fn main() {
    let value = "42" as int
    print(value)
}

//=== TEST CASE: cast_struct_to_int_MismatchedType ===
//! expect: cannot convert `Point` to `int` with `as`
struct Point { x: int, y: int }

fn main() {
    let value = Point { x: 1, y: 2 } as int
    print(value)
}

//=== TEST CASE: cast_empty_array_unresolved_element_MismatchedType ===
// An empty array literal has no element type of its own. `[1, 2, 3] as [int]`
// (tests/types/checked_ascription.rock) is the accepted control -- there the operand
// types itself.
//! expect: cannot convert `[?E]` to `[int]` with `as`: the operand is not fully inferred on its own
fn main() {
    let value = [] as [int]
    print(value.len())
}

//=== TEST CASE: cast_bare_null_unresolved_MismatchedType ===
// A bare `null` carries only a fresh variable. `(null : int?)` is the ascription
// that legitimately binds it.
//! expect: cannot convert `null?` to `int?` with `as`: the operand is not fully inferred on its own
fn main() {
    let value = null as int?
    print(value == null)
}

//=== TEST CASE: cast_deferred_lambda_param_MismatchedType ===
// The lambda infers as `fn(?a) -> ?a`; taking `int` from the cast target is the
// contextual behaviour that belongs to ascription, not `as`.
//! expect: cannot convert `fn(?R) -> ?R` to `fn(int) -> int` with `as`: the operand is not fully inferred on its own
fn main() {
    let f = ((x) => x) as fn(int) -> int
}

//=== TEST CASE: cast_deferred_lambda_field_MismatchedType ===
// Same rule where the operand also has a deferred field access waiting on the
// parameter's type: `as` may not discharge it either.
//! expect: cannot convert `fn(p) -> ?R` to `fn(Point) -> int` with `as`: the operand is not fully inferred on its own
struct Point { x: int, y: int }

fn main() {
    let f = ((p) => p.x) as fn(Point) -> int
}

//=== TEST CASE: cast_target_hole_MismatchedType ===
// `_` is an inference hole in type position, so a hole target has nothing to
// validate against: the classification passes, and the surrounding expectation
// then binds the hole. That laundered `42 as string`, which rejects directly.
//! expect: cannot convert `int` to `_` with `as`: the target is not a written type
fn main() {
    let bad: string = 42 as _
    print(bad)
}

//=== TEST CASE: cast_nested_target_hole_MismatchedType ===
// The hole does not have to be the whole target.
//! expect: cannot convert `[int]` to `[_]` with `as`: the target is not a written type
fn main() {
    let bad: [string] = [1, 2, 3] as [_]
    print(bad.len())
}

//=== TEST CASE: cast_target_hole_identity_MismatchedType ===
// A hole target is rejected on its own terms, not only when it launders a bad
// pair -- `as` validates a written type, and `_` is not one.
//! expect: cannot convert `int` to `_` with `as`: the target is not a written type
fn main() {
    let same: int = 42 as _
    print(same)
}

//=== TEST CASE: ascribe_int_to_string_MismatchedType ===
//! expect: type mismatch: expected `string`, found `int`
fn main() {
    let value = (42 : string)
    print(value)
}

//=== TEST CASE: ascribe_float_to_int_MismatchedType ===
//! expect: type mismatch: expected `int`, found `float`
fn main() {
    let value = (3.14 : int)
    print(value)
}

//=== TEST CASE: ascribe_generic_fn_value_MismatchedType ===
//! expect: type mismatch: expected `int`, found `T`
fn identity<T>(x: T) -> T { x }

fn main() {
    let f = (identity : fn(int) -> int)
    print(f(1))
}

//=== TEST CASE: float_to_int_param_fail_Generic ===
// float -> int stays rejected everywhere
//! expect: type mismatch: expected `int`, found `float`
fn g(y: int) -> int { y }
fn f() -> int { g(1.5) }

//=== TEST CASE: float_to_int_let_fail_Generic ===
//! expect: type mismatch: expected `int`, found `float`
fn f() -> int {
    let x: int = 1.5
    x
}

//=== TEST CASE: float_return_as_int_fail_Generic ===
//! expect: type mismatch: expected `int`, found `float`
fn f() -> int { 1.5 }

//=== TEST CASE: cast_strips_nullability ===
//! expect: `cast` strips nullability from a `int?` -- a null-on-failure silently becomes a valid value
fn maybe_int() -> int? {
    return 1
}
fn main() {
    let x: int = cast(maybe_int())
    print("{x}")
}

//=== TEST CASE: transmute_strips_nullability ===
//! expect: `transmute` strips nullability from a `Mob?`
// `transmute` is the other stdlib nullability-eraser; same judgement.
struct Mob { hp: int }

fn maybe_mob() -> Mob? {
    return Mob { hp: 1 }
}
fn main() {
    let m: Mob = transmute(maybe_mob())
    print("{m.hp}")
}

//=== TEST CASE: nested_cast_outer_strip_rejects ===
//! expect: `cast` strips nullability from a `int?` -- a null-on-failure silently becomes a valid value
// The inner cast targets `int?` and preserves nullability, so it is clean; the
// outer one is the strip. Each call is judged on its own arg/result pair, so
// wrapping the launder in a preserving cast does not hide it.
fn maybe_int() -> int? {
    return 1
}
fn main() {
    let inner: int? = cast(maybe_int())
    let outer: int = cast(inner)
    print("{outer}")
}

//=== TEST CASE: allow_of_another_lint_does_not_suppress ===
//! expect: `cast` strips nullability from a `int?` -- a null-on-failure silently becomes a valid value
// Suppression matches the lint NAME. An `allow` for a different lint sitting on
// the same line leaves this one live.
fn maybe_int() -> int? {
    return 1
}
fn main() {
    // rock: allow(unused_var)
    let x: int = cast(maybe_int())
    print("{x}")
}

