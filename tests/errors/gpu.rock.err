fn use_frag_coord() -> Vec4 {
    return frag_coord()
}

fn main() {
    let _ = use_frag_coord()
}

//=== TEST CASE: at_direct_cpu_call_Generic ===
//! expect: `at` is GPU-only and cannot be called from CPU
fn use_at() -> float {
    let arr = cast<UniformArray<float>>(0)
    return at(arr, 0)
}

fn main() {
    let _ = use_at()
}

