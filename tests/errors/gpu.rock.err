//=== TEST CASE: uniform_values_with_two_parameters ===
//! expect: `@uniform_values` fn `vals` takes exactly one uniform group
value U { a: float }

@uniform_values inline(lua) fn vals<T>(u: T, extra: int) -> SemanticUniformBlock = """
    error("compiler-expanded")
"""

fn main() {
    print(vals(U { a: 1.0 }, 2).leaves.len())
}

//=== TEST CASE: uniform_values_returning_a_non_packet ===
//! expect: `@uniform_values` fn `vals` must return the canonical packet struct
value U { a: float }

@uniform_values inline(lua) fn vals<T>(u: T) -> int = """
    error("compiler-expanded")
"""

fn main() {
    print(vals(U { a: 1.0 }))
}

//=== TEST CASE: uniform_values_returning_a_packet_without_leaves ===
//! expect: `BadPacket` needs a `[CanonicalUniformLeaf] leaves` field
value U { a: float }
struct BadPacket { fingerprint: int }

@uniform_values inline(lua) fn vals<T>(u: T) -> BadPacket = """
    error("compiler-expanded")
"""

fn main() {
    print(vals(U { a: 1.0 }).fingerprint)
}

//=== TEST CASE: scene_handle_of_wrong_root_type_Generic ===
//! expect: type mismatch: expected `MenuState`, found `RoomState`
struct RoomState { n: int }
struct MenuState { label: string }

fn main() {
    let room: Scene<RoomState>? = scene_create((b) => {
        let r: RoomState? = RoomState { n: 1 }
        return r
    })
    let menu: Scene<MenuState> = room.unwrap()
    print("{menu._scene_id}")
}

//=== TEST CASE: scene_root_used_as_other_root_Generic ===
//! expect: type mismatch: expected `MenuState`, found `RoomState`
struct RoomState { n: int }
struct MenuState { label: string }

fn main() {
    let room: Scene<RoomState>? = scene_create((b) => {
        let r: RoomState? = RoomState { n: 1 }
        return r
    })
    let menu: MenuState = room.unwrap().get().unwrap()
    print(menu.label)
}

//=== TEST CASE: scene_owned_arena_of_wrong_element_Generic ===
//! expect: type mismatch: expected `Prop`, found `Actor`
struct Actor { hp: int }
struct Prop { solid: bool }
struct RoomState { actors: Arena<Actor> }

fn main() {
    let room: Scene<RoomState>? = scene_create((b) => {
        let r: RoomState? = RoomState { actors: b.arena() }
        return r
    })
    let props: Arena<Prop> = room.unwrap().get().unwrap().actors
    print("{props.len()}")
}

//=== TEST CASE: scene_create_root_type_mismatch_Generic ===
//! expect: type mismatch: expected `RoomState`, found `MenuState`
struct RoomState { n: int }
struct MenuState { label: string }

fn main() {
    let room: Scene<RoomState>? = scene_create((b) => {
        let m: MenuState? = MenuState { label: "x" }
        return m
    })
    print("{room.unwrap()._scene_id}")
}
