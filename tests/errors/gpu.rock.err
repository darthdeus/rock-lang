    error("compiler-expanded")
"""

fn main() {
    let xs: FlatVec<Inst> = flat_vec_new()
    let _ = vstride(xs, 2)
}

//=== TEST CASE: uniform_expand_with_two_parameters ===
//! expect: `@uniform_expand` fn `packu` takes either three arguments
value U { a: float }

