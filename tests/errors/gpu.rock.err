    discard()
}

fn main() {
    use_discard()
}

//=== TEST CASE: arg_not_a_fn_reference_Generic ===
//! expect: `rock_shader` argument must be a direct reference to a top-level `@shader(vertex)` fn
value AV { p: Vec2 }
value UV { m: Mat4 }
value Vary { position: Vec4 }

@shader(vertex)
fn vtx(@attr a: AV, @uniform u: UV) -> Vary {
    return Vary { position: u.m * Vec4 { x: a.p.x, y: a.p.y, z: 0.0, w: 1.0 } }
}

@shader(fragment)
fn frg(vary: Vary) -> Vec4 { return Vec4 { x: 1.0, y: 0.0, z: 1.0, w: 1.0 } }

fn main() {
    let _ = rock_shader(3, frg)
}

//=== TEST CASE: arg_is_a_local_not_direct_reference_Generic ===
//! expect: `rock_shader` argument must be a direct reference to a top-level `@shader(vertex)` fn
value AV { p: Vec2 }
value UV { m: Mat4 }
value Vary { position: Vec4 }

@shader(vertex)
fn vtx(@attr a: AV, @uniform u: UV) -> Vary {
    return Vary { position: u.m * Vec4 { x: a.p.x, y: a.p.y, z: 0.0, w: 1.0 } }
}

@shader(fragment)
fn frg(vary: Vary) -> Vec4 { return Vec4 { x: 1.0, y: 0.0, z: 1.0, w: 1.0 } }

fn main() {
    let f = vtx
    let _ = rock_shader(f, frg)
}

//=== TEST CASE: arg_is_not_a_shader_fn_Generic ===
//! expect: `rock_shader` argument `plain` is not a `@shader` fn
value AV { p: Vec2 }
value UV { m: Mat4 }
value Vary { position: Vec4 }

fn plain() -> int { return 0 }

@shader(fragment)
fn frg(vary: Vary) -> Vec4 { return Vec4 { x: 1.0, y: 0.0, z: 1.0, w: 1.0 } }

fn main() {
    let _ = rock_shader(plain, frg)
}

//=== TEST CASE: swapped_vertex_and_fragment_Generic ===
//! expect: `rock_shader` expects a `@shader(vertex)` fn here, but `frg` is `@shader(fragment)`
value AV { p: Vec2 }
value UV { m: Mat4 }
value Vary { position: Vec4 }

@shader(vertex)
fn vtx(@attr a: AV, @uniform u: UV) -> Vary {
    return Vary { position: u.m * Vec4 { x: a.p.x, y: a.p.y, z: 0.0, w: 1.0 } }
}

@shader(fragment)
fn frg(vary: Vary) -> Vec4 { return Vec4 { x: 1.0, y: 0.0, z: 1.0, w: 1.0 } }

fn main() {
    let _ = rock_shader(frg, vtx)
}

//=== TEST CASE: single_arg_vertex_fn_where_fragment_expected_Generic ===
//! expect: `rock_shader` expects a `@shader(fragment)` fn here, but `vtx` is `@shader(vertex)`
value AV { p: Vec2 }
value UV { m: Mat4 }
value Vary { position: Vec4 }

@shader(vertex)
fn vtx(@attr a: AV, @uniform u: UV) -> Vary {
    return Vary { position: u.m * Vec4 { x: a.p.x, y: a.p.y, z: 0.0, w: 1.0 } }
}

fn main() {
    let _ = rock_shader(vtx)
}

//=== TEST CASE: single_arg_not_a_shader_fn_Generic ===
//! expect: `rock_shader` argument `plain` is not a `@shader` fn
fn plain() -> int { return 0 }

fn main() {
    let _ = rock_shader(plain)
}

//=== TEST CASE: three_args_rejected_Generic ===
//! expect: No overload for `rock_shader` with argument types
value AV { p: Vec2 }
value UV { m: Mat4 }
value Vary { position: Vec4 }

@shader(vertex)
fn vtx(@attr a: AV, @uniform u: UV) -> Vary {
    return Vary { position: u.m * Vec4 { x: a.p.x, y: a.p.y, z: 0.0, w: 1.0 } }
}

@shader(fragment)
fn frg(vary: Vary) -> Vec4 { return Vec4 { x: 1.0, y: 0.0, z: 1.0, w: 1.0 } }

fn main() {
    let _ = rock_shader(vtx, frg, frg)
}

//=== TEST CASE: intrinsic_declared_with_wrong_arity ===
// The one-argument fingerprint form returns `int`; a one-argument packer
// returning unit is malformed.
//! expect: `@uniform_expand` fn `packu` takes either three arguments
value U { a: float }

// The one-argument fingerprint form returns `int`; a one-argument packer
// returning unit is malformed.
@uniform_expand inline(lua) fn packu<T>(u: T) = """
    error("compiler-expanded")
"""

fn main() {
    packu(U { a: 1.0 })
}

//=== TEST CASE: third_arg_not_a_value_struct ===
//! expect: `@uniform_expand` fn `packu`'s uniform-group argument must be a concrete `value` struct
@uniform_expand inline(lua) fn packu<T>(fv: Ptr<float>, iv: Ptr<int>, u: T) = """
    error("compiler-expanded")
"""

fn main() {
    let f = native_buffer_float(4)
    let i = native_buffer_int(4)
    packu(f.ptr, i.ptr, 7)
}

//=== TEST CASE: group_with_no_std140_form ===
//! expect: `@uniform_expand`: uniform block: `Outer` field `i` has type `Inner`, which has no std140 form here
value Inner { a: float }
value Outer { i: Inner, b: float }

@uniform_expand inline(lua) fn packu<T>(fv: Ptr<float>, iv: Ptr<int>, u: T) = """
    error("compiler-expanded")
"""

fn main() {
    let f = native_buffer_float(8)
    let i = native_buffer_int(8)
    packu(f.ptr, i.ptr, Outer { i: Inner { a: 1.0 }, b: 2.0 })
}

//=== TEST CASE: arg_not_a_buffer_Generic ===
//! expect: `@vertex_expand` fn `vstride` argument must be a `FlatVec<E>` or `NativeBuffer<E>` whose element is
@vertex_expand inline(lua) fn vstride<T>(u: T) -> int = """
    error("compiler-expanded")
"""

fn main() {
    let _ = vstride(3)
}

//=== TEST CASE: element_not_a_value_struct_Generic ===
//! expect: `@vertex_expand` fn `vstride` argument must be a `FlatVec<E>` or `NativeBuffer<E>` whose element is
@vertex_expand inline(lua) fn vstride<T>(buf: NativeBuffer<T>) -> int = """
    error("compiler-expanded")
"""

fn main() {
    let buf = native_buffer_int(4)
    let _ = vstride(buf)
}

