//=== TEST CASE: gpu_only_without_intrinsic_Generic ===
//! expect: `@gpu_only` marks an `@intrinsic` fn that only GPU backends map
@gpu_only fn bogus() -> int {
    return 1
}

fn main() {}

//=== TEST CASE: native_required_without_intrinsic_Generic ===
//! expect: `@native_required` marks an `@intrinsic` fn a backend must map natively
@native_required inline(lua) fn spin(x: int) -> int = """
    return x
"""

fn main() {
    let _ = spin(1)
}

//=== TEST CASE: native_required_no_luajit_mapping_Generic ===
//! expect: `@native_required` intrinsic `spun` has no luajit mapping
@native_required @intrinsic fn spun(x: int) -> int {
    return x
}

fn main() {
    let _ = spun(1)
}

//=== TEST CASE: texture_direct_cpu_call_Generic ===
//! expect: `texture` is GPU-only and cannot be called from CPU
fn use_texture() -> Vec4 {
    let s = Sampler2D { __handle: 0 }
    return texture(s, v(0.0, 0.0))
}

fn main() {
    let _ = use_texture()
}

//=== TEST CASE: texture_size_direct_cpu_call_Generic ===
//! expect: `texture_size` is GPU-only and cannot be called from CPU
fn use_texture_size() -> Vec2 {
    let s = Sampler2D { __handle: 0 }
    return texture_size(s)
}

fn main() {
    let _ = use_texture_size()
}

//=== TEST CASE: fwidth_direct_cpu_call_Generic ===
//! expect: `fwidth` is GPU-only and cannot be called from CPU
// The A2a fragment builtins are @gpu_only too -- a CPU call is a hard error.
fn use_fwidth() -> float {
    return fwidth(1.0)
}

fn main() {
    let _ = use_fwidth()
}

//=== TEST CASE: frag_coord_direct_cpu_call_Generic ===
