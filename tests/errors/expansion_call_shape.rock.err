//! Error: an expansion intrinsic (`@struct_expand`, `@vertex_expand`,
//!        `@uniform_expand`, `@uniform_values`) replaces its call at emit, so
//!        a declaration with the wrong parameter count or result type is
//!        rejected at the call with a spanned error instead of reaching the
//!        error body. A call that disagrees with a well-formed declaration is
//!        bone's ordinary argument error; these declarations are malformed.

//=== TEST CASE: struct_expand_with_two_parameters ===
//! expect: `@struct_expand` fn `epairs` takes exactly one argument
enum E { F(float), I(int) }
value S { x: float }

@struct_expand inline(lua) fn epairs<T>(u: T, extra: int) -> [(string, E)] = """
    error("compiler-expanded")
"""

fn main() {
    let _ = epairs(S { x: 1.0 }, 2)
}

//=== TEST CASE: vertex_expand_with_two_parameters ===
//! expect: `@vertex_expand` fn `vstride` takes exactly one argument
value Inst { pos: Vec2, rot: float }

@vertex_expand inline(lua) fn vstride<T>(buf: FlatVec<T>, extra: int) -> int = """
    error("compiler-expanded")
"""

fn main() {
    let xs: FlatVec<Inst> = flat_vec_new()
    let _ = vstride(xs, 2)
}

//=== TEST CASE: uniform_expand_with_two_parameters ===
//! expect: `@uniform_expand` fn `packu` takes either three arguments
value U { a: float }

@uniform_expand inline(lua) fn packu<T>(fv: Ptr<float>, u: T) = """
    error("compiler-expanded")
"""

fn main() {
    let f = native_buffer_float(4)
    packu(f.ptr, U { a: 1.0 })
}

//=== TEST CASE: uniform_values_with_two_parameters ===
//! expect: `@uniform_values` fn `vals` takes exactly one uniform group
value U { a: float }

@uniform_values inline(lua) fn vals<T>(u: T, extra: int) -> SemanticUniformBlock = """
    error("compiler-expanded")
"""

fn main() {
    print(vals(U { a: 1.0 }, 2).leaves.len())
}

//=== TEST CASE: uniform_values_returning_a_non_packet ===
//! expect: `@uniform_values` fn `vals` must return the canonical packet struct
value U { a: float }

@uniform_values inline(lua) fn vals<T>(u: T) -> int = """
    error("compiler-expanded")
"""

fn main() {
    print(vals(U { a: 1.0 }))
}

//=== TEST CASE: uniform_values_returning_a_packet_without_leaves ===
//! expect: `BadPacket` needs a `[CanonicalUniformLeaf] leaves` field
value U { a: float }
struct BadPacket { fingerprint: int }

@uniform_values inline(lua) fn vals<T>(u: T) -> BadPacket = """
    error("compiler-expanded")
"""

fn main() {
    print(vals(U { a: 1.0 }).fingerprint)
}
