//! Lambda expressions synthesize a function type `(P...) -> R`. This slice is
//! pure synthesis: params must be annotated, the body's type becomes the return
//! type. (Bidirectional propagation of expected param types from a call site or
//! an annotated slot is a later slice.) Exercises the HIR `Expr::Lambda` node,
//! the `TypeExpr::Function` construction, and its `render`.
//! Marker on the `let` binding holding the lambda.

//=== TEST CASE: lambda_body_type_error_Generic ===
// the lambda body is type-checked: an ordering op on a bool body must fail
//! expect: ordering operators require numeric operands, got bool
fn f() -> int {
    let g = (x: bool) => x < x
    5
}


//=== TEST CASE: break_inside_lambda_in_loop_Generic ===
//! expect: only valid inside a loop body
// A lambda body is not the enclosing loop's body: it runs when called. The
// enclosing loop must not make `break`/`continue` legal inside it (this used
// to type-check and then crash the compiler).
fn main() {
    for i in [1, 2] {
        let g = () => {
            break
        }
        g()
    }
}

//=== TEST CASE: continue_inside_lambda_in_loop_Generic ===
//! expect: only valid inside a loop body
fn main() {
    let x: int? = null
    for i in [1, 2] {
        let g = () => {
            let v = x else { continue }
            v
        }
        print(g())
    }
}

//=== TEST CASE: unpinned_lambda_param_errors_Generic ===
//! expect: cannot infer type of lambda parameter `x`: annotate it or use the lambda
struct W { a: float }
operator *(l: W, r: int) -> W { return l }
fn main() {
    let f = x => x * 2
}

//=== TEST CASE: first_use_pins_second_conflicts_Generic ===
//! expect: type mismatch: expected `W`, found `int`
struct W { a: float }
operator *(l: W, r: int) -> W { return l }
fn main() {
    let f = x => x * 2
    let a = f(W { a: 1.0 })
    let b = f(5)
}

//=== TEST CASE: solved_lambda_param_ambiguity_still_errors_Generic ===
//! expect: Ambiguous overload for `amb` with argument types (int, int)
fn amb(x: any, y: int) -> int { return 0 }
fn amb(x: int, y: any) -> int { return 1 }
fn main() {
    let f = (x: int) => amb(x, 3)
    let y = f(5)
}

//=== TEST CASE: lambda_param_monomorphic_fail_Generic ===
// Lambda params with no annotation AND no expected-type slot (non-arg
// position, e.g. `let f = x => ...`) get a fresh inference var rather than a
// hard error. The var is constrained monomorphically by the body and by every
// application site, and is left free (no error) if nothing constrains it.
// Verified against real rock: `x => x * 2` => `fn(int) -> int`, identity applied
// at int => `fn(int) -> int`, fully-unconstrained `x => x` is accepted, applying
// one binding at two types is a unify error.
// applying the same binding at two incompatible types is a unify error
// (the param is one monomorphic var, not let-polymorphic)
//! expect: type mismatch: expected `int`, found `string`
fn f() -> int {
    let g = x => x
    let a = g(3)
    let b = g("hi")
    5
}

//=== TEST CASE: unpinned_lambda_param_mul_Generic ===
// an unconstrained lambda param that no use in the body ever pins
// has no type -- defer-to-use does not invent one. The local
// `*(UnpinnedW, int)` overload ties with stdlib `*(int, int)`, so `x * 2` cannot
// pick eagerly, and with no later call the param stays unresolved.
struct UnpinnedW { a: float }

operator *(l: UnpinnedW, r: int) -> UnpinnedW {
    return UnpinnedW { a: l.a }
}

fn main() {
    let f = x => x * 2
    print("never calls f")
}

//=== TEST CASE: unpinned_placeholder_field_Generic ===
struct UnpinnedP { x: int }
struct UnpinnedQ { x: float }

fn main() {
    let get_x = _.x
    print("never calls get_x")
}
