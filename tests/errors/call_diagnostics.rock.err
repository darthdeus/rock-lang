//! Call diagnostics name what went wrong: the candidates that exist, why each
//! was rejected, and which parameter an argument failed to match.

//=== TEST CASE: nominal_mismatch_names_both_types_Generic ===
//! expect: type mismatch: expected `Mob`, found `Data`
struct Mob { x: int }
struct Data { y: int }
fn take_mob(m: Mob) -> int { return m.x }
fn caller(d: Data) -> int { return take_mob(d) }

//=== TEST CASE: field_called_as_method_with_free_fn_Generic ===
// A same-named free fn makes this a failed UFCS call; the error names the
// field called with `()`.
//! expect: `cooldown` is a field of `Data` (type `float`), not a method -- remove the `()` to read the field
struct Data { cooldown: float = 1.5 }
struct Thing { id: int }
fn make() -> Data { return Data { cooldown: 2.0 } }
fn cooldown(t: Thing) -> float { return 9.0 }
fn caller() -> float { return make().cooldown() }

//=== TEST CASE: field_called_as_method_without_free_fn_Generic ===
//! expect: `cooldown` is a field of `Data` (type `float`), not a method -- remove the `()` to read the field
struct Data { cooldown: float = 1.5 }
fn make() -> Data { return Data { cooldown: 2.0 } }
fn caller() -> float { return make().cooldown() }

//=== TEST CASE: no_overload_lists_candidates_Generic ===
//! expect: No overload for `draw`
//! expect: draw(a: A, tag: int) -> int
//! expect: draw(b: B) -> int
struct A { i: int }
struct B { i: int }
struct C { i: int }
fn draw(a: A, tag: int) -> int { return 0 }
fn draw(b: B) -> int { return 0 }
fn main() {
    let c = C { i: 0 }
    let _ = draw(c)
}

//=== TEST CASE: ambiguous_overload_lists_tied_candidates_Generic ===
// `two(T, int)` and `two(int, T)` each pay one bare-hole slot against
// `(int, int)`, so neither ranks above the other.
//! expect: Ambiguous overload for `two`
//! expect: two(a: T, b: int) -> string
//! expect: two(a: int, b: T) -> string
fn two<T>(a: T, b: int) -> string { return "left" }
fn two<T>(a: int, b: T) -> string { return "right" }
fn main() {
    let _ = two(1, 2)
}

//=== TEST CASE: rejected_bound_reason_is_surfaced_Generic ===
// The only near miss is an `Iterator`-bounded candidate whose parameters fit
// but whose bound does not; the error says why.
//! expect: No overload for `wrap`
//! expect: does not satisfy
struct Multi { i: int }
fn next(it: Multi) -> (bool, int, int) { return (false, 0, 0) }
fn wrap<I: Iterator<T>, T>(x: I, n: int) -> int { return n }
fn wrap(x: string, n: int) -> int { return n }
fn main() {
    let m = Multi { i: 0 }
    let _ = wrap(m, 1)
}

//=== TEST CASE: overloaded_fn_value_is_ambiguous_Generic ===
// Same-signature backend siblings collapse to one value; real overloads do not.
//! expect: ambiguous fn-value reference `pick`
fn pick(x: int) -> int { return x }
fn pick(x: float) -> float { return x }
fn use_it() -> int {
    let g = pick
    return g(1)
}

//=== TEST CASE: named_and_positional_for_one_parameter_Generic ===
//! expect: Multiple values provided for parameter `a`
fn two(a: int, b: int) -> int { a + b }
fn main() { two(1, a: 2) }

//=== TEST CASE: spread_field_names_no_parameter_Generic ===
//! expect: spread field `c` names no parameter of the callee
struct ABC { a: int, b: int, c: int }
fn two(a: int, b: int) -> int { a + b }
fn main() {
    let p = ABC { a: 1, b: 2, c: 3 }
    two(..p)
}

//=== TEST CASE: named_argument_before_spread_Generic ===
//! expect: parameter `a` is given before the spread that also supplies it
struct AB { a: int, b: int }
fn two(a: int, b: int) -> int { a + b }
fn main() {
    let p = AB { a: 1, b: 2 }
    two(a: 9, ..p)
}

//=== TEST CASE: two_spreads_supply_one_parameter_Generic ===
//! expect: two spreads both supply parameter `a`
struct AB { a: int, b: int }
struct AC { a: int, c: int }
fn three(a: int, b: int, c: int) -> int { a + b + c }
fn main() {
    let x = AB { a: 1, b: 2 }
    let y = AC { a: 8, c: 3 }
    three(..x, ..y)
}
