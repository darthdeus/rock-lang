//=== TEST CASE: nullable_null_to_int_Generic ===
// `null` must NOT satisfy a non-nullable slot.
//! expect: type mismatch: expected `int`, found `null?`
fn f() -> int {
    let x: int = null
    5
}

//=== TEST CASE: null_coalesce_type_mismatch_Generic ===
// default's type must match the inner type.
//! expect: type mismatch: expected `string`, found `int`
fn f() -> int {
    let x: int? = null
    let y = x ?? "hi"
    5
}

//=== TEST CASE: nullable_field_on_struct_Generic ===
// Field access on nullable type must use ?. for safety
struct Foo { x: int }

fn test() {
    let f: Foo? = null
    let result = f.x  // ERROR: Cannot use '.' to access field 'x' on nullable type
}

fn main() { test() }

//=== TEST CASE: nullable_field_nested_Generic ===
struct Inner { value: int }
struct Outer { inner: Inner? }

fn test() {
    let o = Outer { inner: null }
    let result = o.inner.value  // ERROR: Cannot use '.' to access field 'value' on nullable type
}

fn main() { test() }

//=== TEST CASE: nullable_field_chain_Generic ===
struct Chain { value: int = 0, next: Chain? = null }

fn test() {
    let c = Chain { next: Chain { value: 42 } }
    let result = c.next.value  // ERROR: Cannot use '.' to access field 'value' on nullable type
}

fn main() { test() }

//=== TEST CASE: divergence_refinement_of_global_unsound_Generic ===
// D4: divergence-based narrowing
// A global refinement must NOT survive an intervening effect: a non-@pure
// call may reassign the global, so a use AFTER such a call is unrefined and
// `g_div.x` must error. (bone DOES refine a global after `if g == null {
// return }` when nothing reassigns it -- see
// bone-semantic/tests/fixtures/global_nullable_refine.rock; rock never
// refines a global at all. Both reject THIS case: the impure call drops the
// refinement.)
struct GFoo { x: int }
global g_div: GFoo? = GFoo { x: 1 }

fn impure() -> int { 0 }

fn use_global_div() -> int {
    if g_div == null {
        return 0
    }
    impure()
    g_div.x  // ERROR: Cannot use '.' to access field 'x' on nullable type
}

fn main() { use_global_div() }

//=== TEST CASE: nullable_ordering_rejected_Generic ===
// Joining a nullable with its base type is the LUB `T?` (verified vs rock):
// `int? == int` type-checks, `[a, 1]` infers `[int?]`, but ordering a
// nullable (`int? < int`) is still rejected ("Cannot compare nullable").
// The bug: `join` fell through to `unify`, which can't unify `int?` with
// `int`. Fix lives in `join` (peel either/both nullable, join inners,
// re-wrap once), so equality accepts and ordering's orderable-check rejects.
// Ordering a nullable is still rejected.
//! expect: ordering operators require numeric operands, got int?
fn f(a: int?) -> bool {
    a < 1
}

//=== TEST CASE: refine_or_rhs_neq_no_narrow_Generic ===
// Intra-`||` refinement: the RHS of `||` runs only when the LHS is false, so it
// sees the LHS's ELSE narrowings. Dual of the `&&` RHS seeing the LHS's THEN
// narrowings (nullable_path_refinement `refine_and_chain`). This is what lets
// `if c == null || !c.in_reach()` type-check -- the guard-combine of two
// `if c == null { .. }` / `if !c.in_reach() { .. }` early returns.
//
// DIVERGENCE from rock: rock does not narrow across `||` operands at all. bone implements the intended dual-of-`&&`
// rule; the guard-combine is the motivating case.
// SOUNDNESS: `x != null` false in the RHS => `x` IS null there, so no narrowing.
// The RHS `x.v` must stay a compile error (plain `.field` on a nullable).
//! expect: cannot access field `v` on non-struct type S?
struct S { v: int }
fn f(x: S?) -> bool {
    return x != null || x.v > 0
}

//=== TEST CASE: nullable_tuple_index_write_Generic ===
// Assignment through tuple index on nullable type
// `t.0 = v` where `t: (int, int)?` would crash at runtime if `t` is
// null (live emits invalid Lua; typed-ANF rejects). Refine via
// null-check first or use a non-nullable tuple. Per CLAUDE.md
// "NEVER swallow errors": semantic surfaces this so it never reaches
// codegen.
fn maybe_tup() -> (int, int)? { (1, 2) }

fn test() {
    let t = maybe_tup()
    t.0 = 99  // ERROR: Cannot assign through tuple index on nullable type
}

fn main() { test() }

//=== TEST CASE: nullable_tuple_index_read_Generic ===
// Reading a tuple element off a nullable base must use ?. for safety
// `t.0` where `t: (int, int)?` would index `nil` at runtime if `t` is
// null. Plain `.N` on a nullable base is rejected exactly like plain
// `.field` on a nullable struct (`nullable_field_on_struct` above);
// the nil-safe form is `?.0`. After the TupleIndex->FieldAccess
// unification, `.0` is a FieldAccess with a numeric field name and a
// nullable base is rejected in `infer_tuple_index`.
fn maybe_tup() -> (int, int)? { (1, 2) }

fn test() -> int {
    let t = maybe_tup()
    t.0  // ERROR: Cannot index tuple element of nullable type
}

fn main() { let _ = test() }

//=== TEST CASE: let_nullable_value_call_into_non_null_Generic ===
// nullable value-struct can't implicitly unwrap to non-null
//
// These tests pin the SEMANTIC checks that make the Bucket-C ANF
// guards at `rock-codegen/src/anf/lower.rs` (sites tagged "H3 R3
// nullable cdata value-returning call") structurally unreachable.
// If semantic ever stops rejecting these shapes, ANF would fire its
// defensive `Unsupported` reject and the test below would FAIL
// differently (panic instead of compile-error) — surfacing the
// lost upstream guard.
value V2 { x: int, y: int }

fn make() -> V2? { return V2 { x: 1, y: 2 } }

fn test() {
    let v: V2 = make()  // ERROR: Type mismatch: found V2?, expected V2
}

fn main() { test() }

//=== TEST CASE: nullable_value_call_as_arg_Generic ===
value V2 { x: int, y: int }

fn make() -> V2? { return V2 { x: 1, y: 2 } }
fn use_v(v: V2) -> int { v.x + v.y }

fn test() {
    let r = use_v(make())  // ERROR: Type mismatch: found V2?, expected V2
}

fn main() { test() }

//=== TEST CASE: nullable_value_field_unsafe_access_Generic ===
value V2 { x: int, y: int }

fn make() -> V2? { return V2 { x: 1, y: 2 } }

fn test() {
    let r = make().x  // ERROR: Cannot use '.' to access field 'x' on nullable type
}

fn main() { test() }

//=== TEST CASE: nested_guard_revokes_captured_local_Generic ===
//! expect: S?
value S { f: int? }
fn consume(x: S) -> int { 0 }
fn bad() -> int {
    let x: S? = S { f: 1 }
    let kill = () => { x = null }
    if x != null && x.f != null { kill(); return consume(x) }
    return 0
}

//=== TEST CASE: leaving_inner_guard_does_not_restore_revoked_narrow_Generic ===
//! expect: S?
value S { f: int? }
fn consume(x: S) -> int { 0 }
fn bad() -> int {
    let x: S? = S { f: 1 }
    let kill = () => { x = null }
    if x != null {
        if x.f != null { kill() }
        return consume(x)
    }
    return 0
}

//=== TEST CASE: call_in_safe_nav_in_cond_Generic ===
//! expect: got (int?, int)
struct G { f: int? }
struct H { n: int }
global g: G = G { f: 1 }
fn H.evil(h) -> bool { g.f = null; return true }

fn bad(h: H?) -> int {
    if g.f != null && h?.evil() == true { return g.f + 1 }
    return 0
}

//=== TEST CASE: call_in_index_in_cond_Generic ===
//! expect: got (int?, int)
struct G { f: int? }
global g: G = G { f: 1 }
fn evil() -> int { g.f = null; return 0 }

fn bad(xs: [int]) -> int {
    if g.f != null && xs[evil()] == 0 { return g.f + 1 }
    return 0
}

//=== TEST CASE: call_in_interpolation_in_cond_Generic ===
//! expect: got (int?, int)
struct G { f: int? }
global g: G = G { f: 1 }
fn evil() -> int { g.f = null; return 0 }

fn bad() -> int {
    if g.f != null && "{evil()}" == "0" { return g.f + 1 }
    return 0
}

//=== TEST CASE: call_in_cast_in_cond_Generic ===
//! expect: got (int?, int)
struct G { f: int? }
global g: G = G { f: 1 }
fn evil() -> int { g.f = null; return 0 }

fn bad() -> int {
    if g.f != null && (evil() as float) == 0.0 { return g.f + 1 }
    return 0
}

//=== TEST CASE: call_in_match_in_cond_Generic ===
//! expect: got (int?, int)
struct G { f: int? }
global g: G = G { f: 1 }
fn evil() -> int { g.f = null; return 0 }

fn bad() -> int {
    if g.f != null && (match evil() { 0 => true, _ => false }) { return g.f + 1 }
    return 0
}

//=== TEST CASE: call_in_safe_nav_let_in_cond_Generic ===
//! expect: got (int?, int)
struct G { f: int? }
global g: G = G { f: 1 }
fn evil() -> bool { g.f = null; return true }

fn bad(v: int?) -> int {
    if g.f != null && (v?.let { evil() } ?? false) { return g.f + 1 }
    return 0
}

// A whole local is normally immune to calls: a callee cannot reassign it.
// A lambda declared in the same body can, and a call may run that lambda.

//=== TEST CASE: closure_nulls_local_before_fn_value_call_Generic ===
//! expect: got (int?, int)
fn bad() -> int {
    let x: int? = 1
    let kill = () => { x = null }
    if x != null { kill(); return x + 1 }
    return 0
}

//=== TEST CASE: closure_nulls_local_before_named_call_Generic ===
//! expect: got (int?, int)
fn run(f: fn()) { f() }

fn bad() -> int {
    let x: int? = 1
    let kill = () => { x = null }
    if x != null { run(kill); return x + 1 }
    return 0
}

//=== TEST CASE: closure_nulls_local_guard_statement_Generic ===
//! expect: got (int?, int)
fn run(f: fn()) { f() }

fn bad() -> int {
    let x: int? = 1
    let kill = () => { x = null }
    if x == null { return 0 }
    run(kill)
    return x + 1
}

//=== TEST CASE: same_name_predicate_does_not_prove_nonnull_Generic ===
//! expect: cannot access field `n` on non-struct type Payload?
struct Payload { n: int }
fn is_null(_value: Payload?) -> bool { false }
fn bad(x: Payload?) -> int {
    if !is_null(x) { return x.n }
    return 0
}

