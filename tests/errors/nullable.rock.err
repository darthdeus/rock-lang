//=== TEST CASE: wrong_nullable_param_type_MismatchedType ===
//! expect: type mismatch: expected `int`, found `string`
fn process(maybe_int: int?) {}

fn main() {
    process("hello")
}

//=== TEST CASE: nullable_in_arithmetic_without_unwrap_Generic ===
//! expect: operator `+` expects operands (int, int), got (int?, int)
fn main() {
    let x: int? = null
    let y = x + 5
}

//=== TEST CASE: null_to_bare_any_NullAssignmentToNonNullable ===
//! expect: `null` cannot be assigned to bare `any` (which excludes null) -- use `any?`
fn main() {
    let x: any = null
}

//=== TEST CASE: unwrap_method_Generic ===
fn main() {
    let x: int = 5
    //! expect: argument of `unwrap` is not nullable -- the `unwrap` is redundant
    print(x.unwrap())
}

//=== TEST CASE: unwrap_ufcs_Generic ===
fn main() {
    let x: int = 5
    //! expect: argument of `unwrap` is not nullable -- the `unwrap` is redundant
    print(unwrap(x))
}

//=== TEST CASE: expect_method_Generic ===
fn main() {
    let s = "hi"
    //! expect: argument of `expect` is not nullable -- the `expect` is redundant
    print(s.expect("present"))
}

//=== TEST CASE: unwrap_or_method_Generic ===
fn main() {
    let x: int = 5
    //! expect: argument of `unwrap_or` is not nullable -- the `unwrap_or` is redundant
    print(x.unwrap_or(0))
}

//=== TEST CASE: unwrap_after_null_guard_Generic ===
fn find() -> int? { return 3 }

fn main() {
    let x = find()
    if x == null { return }
    //! expect: argument of `unwrap` is not nullable -- the `unwrap` is redundant
    print(x.unwrap())
}

//=== TEST CASE: unwrap_struct_value_Generic ===
struct P { x: int }

fn main() {
    let p = P { x: 1 }
    //! expect: argument of `unwrap` is not nullable -- the `unwrap` is redundant
    print(p.unwrap().x)
}
