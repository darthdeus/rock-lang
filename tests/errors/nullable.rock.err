//! expect: type mismatch: expected `int`, found `null?`
struct Foo { x: int }

fn main() {
    let f = Foo { x: null }
}

//=== TEST CASE: null_coalesce_non_nullable_lhs_Generic ===
//! expect: left operand of `??` is not nullable -- the `?? default` is redundant
fn main() {
    let x: int = 5
    let y = x ?? 0
}

//=== TEST CASE: safe_nav_field_non_nullable_Generic ===
//! expect: receiver of `?.` is not nullable -- use `.` instead
struct Bar { val: int }

fn main() {
    let b: Bar = Bar { val: 1 }
    let v = b?.val
}

//=== TEST CASE: safe_nav_method_non_nullable_Generic ===
//! expect: receiver of `?.` is not nullable -- use `.` instead
fn main() {
    let x: int = 5
    let s = x?.to_string()
}

