//=== TEST CASE: same_name_call_can_invalidate_a_path_Generic ===
//! expect: got (int?, int)
struct State { value: int? }
global state: State = State { value: 1 }
struct Token {}
fn is_null(_value: Token) -> bool { state.value = null; true }
fn bad() -> int {
    if state.value != null && is_null(Token {}) { return state.value + 1 }
    return 0
}

//=== TEST CASE: local_function_value_does_not_prove_nonnull_Generic ===
//! expect: got (int?, int)
fn bad(x: int?) -> int {
    let is_null = (_value: int?) => false
    if !is_null(x) { return x + 1 }
    return 0
}

