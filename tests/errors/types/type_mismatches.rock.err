//! Error: Type mismatch error tests
//! Tags: types, mismatches

//=== TEST CASE: string_to_int_mismatch_MismatchedType ===
fn main() {
    let x: int = "hello"  // This should fail - type mismatch
}

//=== TEST CASE: int_to_string_mismatch_MismatchedType ===
fn main() {
    let s: string = 42
}

//=== TEST CASE: array_element_mismatch_MismatchedType ===
fn main() {
    let numbers: [int] = [1, 2, "three"]
}

//=== TEST CASE: default_param_type_mismatch_MismatchedType ===
// Error: int parameter cannot have string default
fn bad_func(x: int = "hello") {
    print(x)
}

fn main() {
    bad_func()
}

//=== TEST CASE: nominal_mismatch_after_quiet_trial_Generic ===
// A quiet failed trial (the nullable coerce) does not lose the reported types.
//! expect: type mismatch: expected `Foo`, found `Bar`
struct Foo { x: int }
struct Bar { x: int }
fn main() { let a: Foo? = Bar { x: 1 } }

//=== TEST CASE: constructor_mismatch_Generic ===
//! expect: type mismatch: expected `[int]`, found `Foo` (different type constructors)
struct Foo { x: int }
fn main() { let a: [int] = Foo { x: 1 } }
