//=== TEST CASE: bound_callback_nullable_nobox_return ===
//! expect: a function returning a `nobox` value cannot be used as one returning a nullable value
// A stored function returning a nobox value has a fixed leaf return ABI.
// A nullable return adds a presence slot, so the value needs a lambda adapter.
fn accepts_nullable_position(callback: () -> Vec2?) -> Vec2 {
    return callback().unwrap()
}

fn main() {
    let callback: () -> Vec2 = () => v(7.0, 9.0)
    let position = accepts_nullable_position(callback) // ERROR: incompatible return ABI
    print("{position.x}")
}

//=== TEST CASE: opaque_body_via_global_init_Generic ===
//! expect: `lscore` cannot be taken as a fn value because its fixed ABI does not match the type-derived
// a fn whose fixed ABI cannot adopt the type-derived `nobox` fn-value
// ABI is rejected in a GLOBAL INITIALIZER, exactly as it already is at
// a direct call site. A call through a fn value cannot see its callee,
// so both ends agree only by reading the same signature -- at a `nobox`
// param that means splatted leaves, which an opaque body, an `extern`
// and a `@nomangle` fn all keep their own boxed ABI against.
//
// The gate ran on fn bodies and decorator bodies but not on global
// initializers, so this route reached codegen and MISCOMPILED: the
// leaves splat, the callee binds one param per leaf, and everything
// shifts by one. `fn(p: P, k: float) -> float { return k }` returned
// `p.y`. A dispatch table (`global HANDLERS: [(Vec2) -> float]`) is an
// ordinary shape, so this was reachable from real code.
nobox value P { x: float, y: float }

inline(lua) fn lscore(p: P) -> float = """
    return p.x * 100.0 + p.y
"""

global HANDLER: (P) -> float = lscore   // ERROR: fixed ABI cannot adopt the leaf ABI

fn main() {
    let g = HANDLER
    print("{g(P { x: 3.0, y: 7.0 })}")
}

//=== TEST CASE: opaque_body_in_global_vec_Generic ===
//! expect: `lscore` cannot be taken as a fn value because its fixed ABI does not match the type-derived
nobox value P { x: float, y: float }

inline(lua) fn lscore(p: P) -> float = """
    return p.x * 100.0 + p.y
"""

global FS: [(P) -> float] = [lscore]   // ERROR: same gate, through a container

fn main() {
    let g = FS[0]
    print("{g(P { x: 3.0, y: 7.0 })}")
}

//=== TEST CASE: nomangle_fn_via_global_init_Generic ===
//! expect: `scorer` cannot be taken as a fn value because its fixed ABI does not match the type-derived
nobox value P { x: float, y: float }

// Not an opaque body -- an ordinary Rock fn whose `@nomangle` bare name pins its
// declared boxed ABI. It produced a SILENT wrong answer (returned `p.y` for `k`).
@nomangle fn scorer(p: P, k: float) -> float { return k }

global HANDLER: (P, float) -> float = scorer   // ERROR: fixed ABI cannot adopt the leaf ABI

fn main() {
    let g = HANDLER
    print("{g(P { x: 3.0, y: 7.0 }, 999.0)}")
}

//=== TEST CASE: extern_fn_via_global_init_Generic ===
//! expect: `take_p` cannot be taken as a fn value because its fixed ABI does not match the type-derived
nobox value P { x: float, y: float }

extern(lua) fn take_p(p: P) -> float

global H: (P) -> float = take_p   // ERROR: an FFI boundary cannot splat leaves

fn main() {
    let g = H
    print("{g(P { x: 1.0, y: 2.0 })}")
}

//=== TEST CASE: nobox_bare_return_from_inline_lua ===
//! expect: nobox value `NV2` cannot cross the boxed return of `hand_boxed`
// a BARE (non-tuple) `nobox` return from an opaque body. The callee
// writes its own `return`, so a hand-written box is handed back where
// the call site expects leaves -- and Lua's `.field` does not
// distinguish a table from cdata, so it COMPILED CLEAN AND PASSED.
// The guarantee was violated with no diagnostic at all.
//
// The param direction (`reject_nobox_boxed_call_args`) and the TUPLE return
// (`reject_nobox_opaque_tuple_return`) were both already checked; a plain
// `-> NV2` was the one uncovered position.
//
// The escape is `@scalar_abi` + returning the leaves, which the message names.
// Positive control (accepted, leaves returned): `tests/nobox/opaque_return.rock`.
nobox value NV2 { x: float, y: float }

inline(lua) fn hand_boxed() -> NV2 = """
    return NV2_ct(3.0, 4.0)
"""

fn main() {
    print("{hand_boxed().x}")
}

//=== TEST CASE: nobox_bare_return_from_nomangle_inline_lua ===
//! expect: nobox value `NV2` cannot cross the boxed return of `hand_boxed_fixed_name`
nobox value NV2 { x: float, y: float }

@nomangle inline(lua) fn hand_boxed_fixed_name() -> NV2 = """
    return NV2_ct(3.0, 4.0)
"""

fn main() {
    print("{hand_boxed_fixed_name().x}")
}

//=== TEST CASE: nobox_materialization_in_a_shader_body ===
//! expect: nobox value `NV2` survived lowering as an implicit materialization, while emitting
// a `@shader` fn's body is ordinary CPU-executable Lua -- the authoring
// contract promises shader fns "compile
// to Lua as normal fns, so shader helper math is CPU-callable and
// `@test`-able", and nothing rejects a CPU call to one. So the `nobox`
// guarantee applies to it like any other body: an implicit
// materialization inside a `@shader` fn must reject.
//
// The materialization below is unrelated to any GPU intrinsic: a box is
// authorized only AT a `@gpu_only` call boundary, never anywhere inside a body
// that happens to be annotated.
//
// The sink has to be a shape with nowhere to put the value but a box. A bare
// nobox global stores LEAVES and a value-struct outer stores flat leaf keys, so
// either would pass here for the wrong reason.
//
// Interpolating a WHOLE tuple that carries one is the sink, and it is chosen
// because it is PERMANENT: asking for a single runtime-typed value is F1
// erasure, a justified box that is meant to stay a rejection
// (`tests/errors/nobox.rock.err`). A tuple element in a COLLECTION used to
// stand here and was the wrong choice -- that was an open gap, it closed, and
// this case went green while the shader rule it guards was untouched. Do not
// re-point this at a sink the matrix lists as live.
nobox value NV2 { x: float, y: float }

@shader(fragment)
fn leaky_frag(tc: NV2) -> Vec4 {
    let t = (tc, 1.0)
    let s = "{t}"
    return v(0.0, 0.0, 0.0, 1.0)
}

fn main() {
    let _ = leaky_frag(NV2 { x: 1.0, y: 2.0 })
}

//=== TEST CASE: whole_tuple_escape_of_a_nobox_Generic ===
//! expect: nobox value `SNV` survived lowering as an implicit materialization, while emitting `main`
// NOT an unbuilt mechanism -- the guarantee firing, pinned so the boundary
// cannot move unnoticed. A nullable tuple carrying a nobox element is bound and
// used slot-wise (seventeen shapes in `tests/nobox/nullable_tuple.rock`), but
// interpolating the WHOLE tuple asks for one value with a runtime type, which is
// a box by definition -- the same justified-box class as `inspect` over a column
// vec. Project the slots instead (`t.0.x`), or `materialize` deliberately.
nobox value SNV { x: int, y: int }
fn maybe(b: bool) -> (SNV, int)? {
    if b { return (SNV { x: 3, y: 6 }, 1) }
    return null
}
fn main() {
    let t = maybe(true)
    print("{t}")   // ERROR: the whole tuple escapes, so its nobox element boxes
}

//=== TEST CASE: inline_tuple_interpolation_of_a_nobox_Generic ===
//! expect: nobox value `INV` survived lowering as an implicit materialization, while emitting `main`
// The same boundary reached WITHOUT a binding. It rejects through a different
// site (`stringify_non_null`, not the packed repr) and is pinned separately
// because it once compiled while the bound form above rejected: the box had
// already widened, so `inspect` walked a 3-slot table and would have rendered a
// 3-tuple. That is a silent wrong answer, which the widened box cannot leave to
// the residue check -- there is no `<name>_ct` left for it to find.
nobox value INV { x: float, y: float }
fn inv(k: float) -> INV { return INV { x: k, y: 2.0 } }
fn main() {
    print("{(inv(1.0), 1.0)}")   // ERROR: the widened box would render as a wider tuple
}

//=== TEST CASE: direct_inspect_of_a_tuple_carrying_a_nobox_Generic ===
//! expect: cannot inspect a tuple carrying a nobox value
// The call-boundary spelling of the case above: `inspect` reached by name rather
// than through interpolation. Pinned as its own case because the two are checked
// at different sites and only one of them used to exist.
nobox value DNV { x: float, y: float }
fn dnv(k: float) -> DNV { return DNV { x: k, y: 2.0 } }
fn main() {
    print(inspect((dnv(1.0), 1.0)))   // ERROR: same widened box, reached by call
}

//=== TEST CASE: implicit_tuple_at_an_inline_body_Generic ===
//! expect: a tuple carrying a nobox value cannot cross boxed call boundary `count`
// The guarantee firing at a body the compiler cannot see into: it would be
// handed the flat box and read a wider tuple. `materialize(t)` hands it one
// boxed value per element (`tests/nobox/tuple.rock`).
nobox value BNV { x: float, y: float }
inline(lua) fn count(v: any) -> int = """ return #v """
fn main() {
    let t = (BNV { x: 1.0, y: 2.0 }, 3)
    print(count(t))   // ERROR: a tuple carrying a nobox value cannot cross
}

//=== TEST CASE: coroutine_yields_a_bare_nobox_value_Generic ===
// The yield channel threads flat-enum leaves through frame slots; a bare value
// has no channel and rides the boxed `resume()` result.
//! expect: nobox value `NV` survived lowering as an implicit materialization
nobox value NV { x: int, y: int }
co fn gen(k: int) -> Coroutine<NV> {
    yield NV { x: k, y: k + 1 }   // ERROR: the yield value boxes
}
fn main() {
    let c = gen(1)
    print("{c.resume()?.x ?? -1}")
}

//=== TEST CASE: coroutine_returns_a_bare_nobox_value_Generic ===
// `result()` reads one frame cell.
//! expect: nobox value `NV` survived lowering as an implicit materialization
nobox value NV { x: int, y: int }
co fn finish(k: int) -> Coroutine<int, NV> {
    yield k
    return NV { x: k, y: 2 }   // ERROR: the result boxes
}
fn main() {
    let c = finish(1)
    let _a = c.resume()
    let _b = c.resume()
    print("{c.result()?.x ?? -1}")
}

//=== TEST CASE: static_local_holding_a_nobox_value_Generic ===
// A `static` local is one private global cell plus a done flag. A nobox global
// is one global per leaf; statics do not use that layout yet.
//! expect: nobox value `NV` survived lowering as an implicit materialization
nobox value NV { x: int, y: int }
fn bump() -> int {
    static s = NV { x: 1, y: 2 }   // ERROR: the static cell boxes
    s = NV { x: s.x + 1, y: s.y }
    return s.x
}
fn main() { print("{bump()}") }

//=== TEST CASE: newtype_wrapping_a_nobox_value_Generic ===
// A newtype is erased to what it wraps, but the value-shape oracles key on the
// nominal name and do not see through the newtype to the nobox leaves.
//! expect: nobox value `NV` survived lowering as an implicit materialization
nobox value NV { x: int, y: int }
newtype NT(NV)
fn mk(k: int) -> NT {
    return NT(NV { x: k, y: k + 1 })   // ERROR: the wrapped value boxes
}
fn main() {
    let NT(v) = mk(4)
    print("{v.x}")
}

//=== TEST CASE: generic_newtype_at_a_nobox_type_Generic ===
//! expect: nobox value `NV` survived lowering as an implicit materialization
nobox value NV { x: int, y: int }
newtype GBox<T>(T)
fn mk(k: int) -> GBox<NV>? {
    if k < 0 { return null }
    return GBox(NV { x: k, y: 7 })   // ERROR: the wrapped value boxes
}
fn main() { print("{mk(2) == null}") }

//=== TEST CASE: generic_struct_field_at_a_nobox_type_Generic ===
// A generic `T` field is one slot whatever `T` is, so `Wrap<NV>` would hold a
// box. The concrete `struct W { v: NV }` splices the leaves and works.
//! expect: nobox value `NV` survived lowering as an implicit materialization
nobox value NV { x: int, y: int }
struct Wrap<T> { v: T }
fn wrap(k: int) -> Wrap<NV> {
    return Wrap { v: NV { x: k, y: 1 } }   // ERROR: the generic field boxes
}
fn main() { print("{wrap(8).v.x}") }

//=== TEST CASE: returns_disagree_across_swapped_recursion ===
//! expect: returns a `ref` to a flat-stored container element on one path and a differently stored reference on another
value Inner { v: int }
value Cell { inner: Inner, w: int }
value Outer { cell: Cell, z: int }

// The swapped recursive call enters the other storage, so one instance
// returns the vec element on one path and the nested field on the other.
fn swap_pick(a: ref Cell, b: ref Cell, n: int) -> ref Cell {
    if n == 0 { return a }
    return swap_pick(b, a, n - 1)
}

fn bump(c: ref Cell) { c.w += 1 }

fn main() {
    let xs: [Cell] = [Cell { inner: Inner { v: 1 }, w: 2 }]
    let os: [Outer] = [Outer { cell: Cell { inner: Inner { v: 3 }, w: 4 }, z: 5 }]
    bump(swap_pick(xs[0], os[0].cell, 3))
}

//=== TEST CASE: safe_nav_call_cannot_receive_a_flat_ref_result ===
//! expect: returns a `ref` to a flat-stored container element, which only a direct call can receive on this backend
value Cell { w: int }

fn borrow_cell(a: Arena<Cell>, e: Entity<Cell>) -> (ref Cell)? {
    return a.borrow(e)
}

fn bump(c: ref Cell) { c.w += 1 }

fn main() {
    let a: Arena<Cell>? = arena_new()
    let e = a.unwrap().insert(Cell { w: 1 })
    let c = a?.borrow_cell(e)
    if c != null { bump(c) }
}

//=== TEST CASE: whole_read_of_a_nullable_flat_ref_result ===
//! expect: returns a nullable `ref` to a flat-stored `Cell`; bind it with `let` and check it for null before reading it
value Cell { v: int, w: int }

fn maybe(c: ref Cell, ok: bool) -> (ref Cell)? {
    if ok { return c }
    return null
}

fn same(c: ref Cell) -> bool {
    return maybe(c, true) == Cell { v: 3, w: 4 }
}

fn main() {
    let xs: [Cell] = [Cell { v: 3, w: 4 }]
    print(same(xs[0]))
}

//=== TEST CASE: whole_read_of_a_nullable_flat_ref_binding ===
//! expect: a nullable `ref` to a flat-stored container element can be compared with null
value Cell { v: int, w: int }

fn maybe(c: ref Cell, ok: bool) -> (ref Cell)? {
    if ok { return c }
    return null
}

fn read_through(c: ref Cell) -> bool {
    let m = maybe(c, true)
    return m == Cell { v: 3, w: 4 }
}

fn main() {
    let xs: [Cell] = [Cell { v: 3, w: 4 }]
    print(read_through(xs[0]))
}

//=== TEST CASE: named_fn_vec_result_Generic ===
fn pair(n: int) -> [int] { return [n, n] }

fn main() {
    //! expect: this callback returns `[int]`, not an iterator; only a lambda's result is coerced
    print([1, 2].flat_map(pair).count())
}

//=== TEST CASE: named_fn_nullable_vec_result_Generic ===
fn pair(n: int?) -> [int?] { return [n, n] }

fn main() {
    let a: [int?] = [1, null]
    //! expect: this callback returns `[int?]`, not an iterator
    print(a.flat_map(pair).count())
}

//=== TEST CASE: native_buffer_alloc_generic_gc_value ===
//! expect: `native_buffer_alloc<Named>` requires a valid native-buffer element ctype
struct FlatVec<T> { buf: NativeBuffer<T>, len: int }

value Named { s: string }   // string field -> GC-carrying value struct, no C layout

@inline fn flat_vec_new<T>(cap: int) -> FlatVec<T> {
    return FlatVec { buf: native_buffer_alloc(cap), len: 0 }
}

fn main() {
    let fv: FlatVec<Named> = flat_vec_new(8)
    print("{fv.len}")
}

