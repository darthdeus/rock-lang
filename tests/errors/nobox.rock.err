struct Heap { xs: [int] }

fn bad(n: int) -> NativeBuffer<Heap> {
    return native_buffer_alloc(n)
}

fn main() {
    let b = bad(4)
    print("{b.len}")
}

//=== TEST CASE: nb_index_must_be_int_Generic ===
//! expect: type mismatch: expected `int`, found `string`
fn f(buf: NativeBuffer<float>) -> int {
    let x = buf["nope"]
    5
}

//=== TEST CASE: gc_value_extern_param_Generic ===
//! expect: `Bag` is a GC-carrying `value` struct (immutable Lua table) and cannot cross an `extern` C boundary
value Bag { xs: [int], n: int }

extern(lua) fn c_takes_bag(b: Bag) -> int

fn main() {
    print("{c_takes_bag(Bag { xs: [1], n: 2 })}")
}

