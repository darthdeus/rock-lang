//=== TEST CASE: negative_uint_literal_Generic ===
//! expect: uint literal must be in the range 0..=4294967295, found -1
fn f() -> uint { -1 }

//=== TEST CASE: oversized_uint_literal_Generic ===
//! expect: uint literal must be in the range 0..=4294967295, found 4294967296
fn f() -> uint { 4294967296 }

//=== TEST CASE: uint_is_not_int_Generic ===
//! expect: type mismatch: expected `int`, found `uint`
fn f(x: uint) -> int { x }

//=== TEST CASE: uint_shift_count_Generic ===
//! expect: uint shift count must be in the range 0..=31, found 32
fn bad_shift(x: uint) -> uint { x << 32 }

//=== TEST CASE: negative_uint_cast_Generic ===
//! expect: numeric literal -1 is out of range for `Uint`
fn bad_cast() -> uint { -1 as uint }

//=== TEST CASE: mixed_uint_int_Generic ===
//! expect: type mismatch: expected `uint`, found `float`
fn mixed(x: uint, y: int) -> uint { x + y }

//=== TEST CASE: mixed_uint_int_equality_Generic ===
//! expect: type mismatch: expected `int`, found `uint`
fn mixed_eq(x: uint, y: int) -> bool { x == y }

