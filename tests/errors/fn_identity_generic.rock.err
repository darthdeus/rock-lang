//! Error: comparing fn values THROUGH a generic wrapper is rejected at the
//!        call site. `fn same<T>(a: T, b: T) -> bool { a == b }` type-checks
//!        (the operands are `T`, not a fn type), but a call that binds `T` to a
//!        fn type reaches an `==` on fn values -- whose identity is not
//!        meaningful (a capture-free lambda is one shared hoisted fn; a
//!        capturing lambda is a fresh record per creation). The direct ban is
//!        in tests/errors/fn_identity_compare.rock.err; this closes the
//!        generic bypass at the call site (bone-semantic fn_identity).
//!        Aliased operands: fn_identity_generic_let_alias.rock.err;
//!        forwarding through another generic:
//!        fn_identity_generic_transitive.rock.err.
//! Tags: closures, fn-values, equality, generics

//=== TEST CASE: generic_eq_capture_free_fn_arg_Generic ===
fn same<T>(a: T, b: T) -> bool { return a == b }
fn mk() -> fn() -> int { return () => 1 }

fn main() {
    if same(mk(), mk()) { print("same") }   // ERROR: fn identity via generic
}

//=== TEST CASE: generic_eq_capturing_fn_arg_Generic ===
fn same<T>(a: T, b: T) -> bool { return a == b }
fn mk2(x: int) -> fn() -> int { return () => x }

fn main() {
    if same(mk2(1), mk2(1)) { print("same") }   // ERROR: fn identity via generic
}

//=== TEST CASE: generic_neq_fn_arg_Generic ===
fn diff<T>(a: T, b: T) -> bool { return a != b }
fn mk() -> fn() -> int { return () => 1 }

fn main() {
    if diff(mk(), mk()) { print("diff") }   // ERROR: fn identity via generic
}

//=== TEST CASE: generic_eq_nullable_fn_arg_Generic ===
fn same<T>(a: T, b: T) -> bool { return a == b }
fn mk() -> (fn() -> int)? { return () => 1 }

fn main() {
    if same(mk(), mk()) { print("same") }   // ERROR: nullable-fn identity via generic
}

// Aliasing ONE operand does not escape: `x` infers as `T`.
//=== TEST CASE: generic_eq_single_unannotated_alias_Generic ===
fn same<T>(a: T, b: T) -> bool { let x = a; return x == b }
fn mk() -> fn() -> int { return () => 1 }

fn main() {
    if same(mk(), mk()) { print("same") }   // ERROR: `x` is still a T operand
}

// ANNOTATED aliases are T-typed too. (The unannotated both-alias form:
// fn_identity_generic_let_alias.rock.err.)
//=== TEST CASE: generic_eq_annotated_both_alias_Generic ===
fn same<T>(a: T, b: T) -> bool { let x: T = a; let y: T = b; return x == y }
fn mk() -> fn() -> int { return () => 1 }

fn main() {
    if same(mk(), mk()) { print("same") }   // ERROR: annotated aliases stay T-typed
}
