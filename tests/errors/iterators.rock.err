//=== TEST CASE: both_branch_join_then_use_Generic ===
//! expect: use of consumed binding
fn check_both_branches(flag: bool) {
    let it = [1, 2, 3].iter()
    if flag {
        let _ = it.collect()
    } else {
        let _ = it.collect()
    }
    let _ = it.collect()
}
fn main() { check_both_branches(true) }

//=== TEST CASE: one_branch_join_then_use_Generic ===
//! expect: use of consumed binding
fn check_one_branch(flag: bool) {
    let it = [1, 2, 3].iter()
    if flag {
        let _ = it.collect()
    }
    let _ = it.collect()
}
fn main() { check_one_branch(true) }

//=== TEST CASE: partial_next_then_one_consume_then_reuse_Generic ===
//! expect: use of consumed binding
fn main() {
    let it = [1, 2, 3].iter()
    let (more, first) = it.next()
    let _ = more
    let _ = first
    let rest = it.collect()
    let again = it.collect()
    print("{rest.len} {again.len}")
}

//=== TEST CASE: passing_to_consuming_function_then_reuse_Generic ===
//! expect: use of consumed binding
fn drain<I: Iterator<int>>(it: I) -> int {
    return it.count()
}

fn main() {
    let it = [1, 2, 3].iter()
    let n = drain(it)
    let again = drain(it)
    print("{n} {again}")
}

