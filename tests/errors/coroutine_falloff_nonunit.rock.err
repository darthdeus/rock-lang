//! Error: a `co fn` whose declared result R is a concrete non-unit,
//!        non-nullable type must not be able to FALL OFF the end of its body:
//!        bone coerces only explicit `return <expr>` statements to R (a
//!        coroutine's body tail is discarded, never coerced), so a reachable
//!        fall-off would stamp the completed terminal with `__return` nil --
//!        and `result()`/`take_result` would hand out a nil typed as R. The
//!        rejection is EMIT-time (skull-mir `lower_root`), on the bone-accepted
//!        program. Unit R (the default) and nullable R (nil is a legal value)
//!        stay admitted; a body whose end is unreachable (every path returns /
//!        `while true`) is fine. A generic R is checked per concrete
//!        instantiation: falling off at a non-unit, non-nullable R rejects,
//!        including when the instantiation is reached through a generic caller
//!        (tests/coroutines/generic_result_falloff.rock pins the admitted ones).
//! Tags: skull, coroutine, emit-time, fall-off

//=== TEST CASE: falloff_int_result ===
co fn gen() -> Coroutine<int, string> {
    yield 1
}
fn main() {
    let c = gen()
    resume(c)
}

//=== TEST CASE: falloff_after_conditional_return ===
// One arm returns, the other falls through to the end -- the fall-off is
// reachable, so it still rejects.
co fn maybe(flag: bool) -> Coroutine<int, int> {
    yield 1
    if flag {
        return 7
    }
}
fn main() {
    let c = maybe(true)
    resume(c)
}

//=== TEST CASE: falloff_generic_result_at_int ===
co fn gen<R>(x: R) -> Coroutine<int, R> {
    yield 1
}
fn main() {
    let c = gen(5)
    resume(c)
}

//=== TEST CASE: falloff_generic_result_through_generic_caller ===
co fn gen<R>(x: R) -> Coroutine<int, R> {
    yield 1
}
co fn wrap<R>(x: R) -> Coroutine<int, R> {
    let r = await gen(x)
    return r
}
fn main() {
    let c = wrap("s")
    resume(c)
}
