//! Error: `static` local rejects.
//!        Diagnostics distinguish declaration restrictions, captures and name lookup.

//=== TEST CASE: static_in_pure_fn_writes_globals_Generic ===
//! expect: `@pure` function declares a `static` (writes module state)
// The declaration itself writes module state; no extra assignment is needed.
@pure
fn p() -> int {
    static n = 0
    return n
}
fn main() { let _ = p() }

//=== TEST CASE: static_in_co_fn_hard_reject_Generic ===
//! expect: `static` is not allowed in a `co fn`
// Inference rejects the declaration in a coroutine even without a later use.
co fn gen() -> Coroutine<int> {
    static scratch = 0
    yield 1
}
fn main() { let c = gen()  let _ = c.resume() }

//=== TEST CASE: static_init_reads_param_Generic ===
//! expect: static initializer may not read local `count`
// The initializer runs once, not per call -- a param read would silently
// snapshot the first reaching call's value. Rejected.
fn draw(count: int) -> int {
    static scratch = count
    return scratch
}
fn main() { let _ = draw(10) }

//=== TEST CASE: static_init_reads_local_Generic ===
//! expect: static initializer may not read local `base`
// Same rule for an enclosing local.
fn f() -> int {
    let base = 7
    static v = base + 1
    return v
}
fn main() { let _ = f() }

//=== TEST CASE: static_init_reads_sibling_static_Generic ===
//! expect: static initializer may not read local `a`
// A static initializer may not read another static (init-order hazard).
fn f() -> int {
    static a = 1
    static b = a + 1
    return b
}
fn main() { let _ = f() }

//=== TEST CASE: static_init_reads_local_shadowing_global_Generic ===
//! expect: static initializer may not read local `base`
// Must ERROR on the local read, NOT silently bind the like-named global. This
// is why enforcement is resolve-then-reject, not module-scope re-resolution.
global base: int = 100
fn f() -> int {
    let base = 7
    static v = base + 1   // binds the local `base` -> rejected (not the global)
    return v
}
fn main() { let _ = f() }

//=== TEST CASE: static_mangled_cell_name_unresolvable_from_source_Generic ===
//! expect: `__static_f_n` did not resolve to any definition
// This generated-looking name is absent from source scope. It is not the
// current emitted cell spelling, so this alone does not prove cell privacy.
fn f() -> int {
    static n = 0
    return __static_f_n
}
fn main() { let _ = f() }

//=== TEST CASE: static_tuple_pattern_Generic ===
//! expect: a `static` takes a plain name
fn f() {
    static (a, b) = (1, 2)
    print(a + b)
}
fn main() { f() }

//=== TEST CASE: static_record_pattern_Generic ===
//! expect: a `static` takes a plain name
struct P { x: int, y: int }
fn f() {
    static P { x, y } = P { x: 1, y: 2 }
    print(x + y)
}
fn main() { f() }
