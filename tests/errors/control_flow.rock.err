fn f() -> int {
    let x = 5
}

//=== TEST CASE: return_unit_mismatch_Generic ===
// bare `return` (returns unit) in an int function must be rejected.
//! expect: type mismatch: expected `int`, found `()`
fn f() -> int {
    let z = 1
    return
}

//=== TEST CASE: bare_return_value_position_rejected_Generic ===
// a bare `return` in VALUE position is still a unit return -- the position does
// not change that it returns nothing where an int is declared. Must be rejected
// (bone is intentionally stricter than rock here: rock accepts this).
//! expect: type mismatch: expected `int`, found `()`
fn f() -> int {
    let x: int = return
    x
}

//=== TEST CASE: body_return_mismatch_Generic ===
// The body's tail must match the declared return type.
//! expect: type mismatch: expected `int`, found `string`
fn f() -> int { "hi" }

//=== TEST CASE: return_value_from_unannotated_fn_Generic ===
struct Trail { x: int }

fn make() -> Trail {
    return Trail { x: 1 }
}

fn no_annotation() {
    return make()
}

fn main() {
    no_annotation()
}

