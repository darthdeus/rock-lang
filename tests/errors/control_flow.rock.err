}

//=== TEST CASE: break_not_in_loop_InvalidBreak ===
//! expect: `break`/`continue` is only valid inside a loop body
fn test() {
    if true { break } else { 42 }
}

//=== TEST CASE: chain_else_keeps_no_clause_narrowing_Generic ===
//! expect: expects operands (int, int)
// Every clause's miss lands in the same `else`, so a refinement proved by
// one clause failing (here `x == null` being false) must NOT be assumed
// there: the first clause missing can arrive with `x` still null.
fn probe(m: Map<int, int>, x: int?) -> int {
    if let a = m.get(1) && x == null {
        return 1
    } else {
        return x + 100
    }
}
fn main() {}

//=== TEST CASE: chain_else_narrowing_condition_first_Generic ===
//! expect: expects operands (int, int)
// Same rule with the narrowing condition FIRST: its refinement is ambient
// while the later clauses are checked, but it does not hold on the arrival
// where the condition itself failed.
fn probe(m: Map<int, int>, x: int?) -> int {
    if x != null && let a = m.get(1) {
        return a
    } else {
        return x + 100
    }
}
fn main() {}

//=== TEST CASE: chain_else_narrowing_condition_middle_Generic ===
//! expect: expects operands (int, int)
fn probe(m: Map<int, int>, w: int?, v: int?) -> int {
    if let y = w && v != null && let z = m.get(1) {
        return y + z
    } else {
        return v + 1
    }
}
fn main() {}

//=== TEST CASE: while_cond_not_bool_Generic ===
// the condition must be bool.
//! expect: type mismatch: expected `bool`, found `int`
fn f() -> int {
    while 5 {
        let x = 1
    }
    5
}

//=== TEST CASE: for_tuple_arity_mismatch_Generic ===
// Pattern arity must match the element's tuple arity. A `Map<K, V>` yields a
// 2-tuple; a 3-binding pattern must be rejected.
//! expect: tuple pattern expected 2 elements, but got 3
fn f(m: Map<int, string>) -> int {
    for (a, b, c) in m {
        let p = a
    }
    5
}

//=== TEST CASE: for_tuple_on_scalar_Generic ===
// Destructuring a non-tuple element with a tuple pattern must be rejected.
// (The local protocol makes the array iterable, so the failure is the pattern
// arity -- not a missing-iterator error.)
//! expect: expected a tuple type in pattern, got int
struct FIter<T> { last: T }
fn iter<T>(v: [T]) -> FIter<T> { return FIter { last: v[0] } }
fn next<T>(it: FIter<T>) -> (bool, T) { return (false, it.last) }
fn f(xs: [int]) -> int {
    for (a, b) in xs {
        let p = a
    }
    5
}


