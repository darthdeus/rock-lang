//! Error: `.N` on a vec-of-tuples no longer auto-projects; use `.map(_.N)`
//! Tags: tuple, vec, projection

//=== TEST CASE: vec_of_tuples_dot0_rejected_Generic ===
// `[(A,B)].0` used to auto-project to `[A]` (map .0 over the vec). That
// magic was removed -- a tuple index applies to a tuple/newtype, not a
// vec of them. The explicit form is `pairs.map(_.0)`.
fn test() -> int {
    let pairs: [(int, string)] = [(1, "a"), (2, "b")]
    let firsts = pairs.0  // ERROR: Expected tuple or newtype, found [(int, string)]
    vec_len(firsts)
}

fn main() { let _ = test() }
