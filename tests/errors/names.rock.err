//=== PROLOGUE: print_driver ===
fn main() {
    print("hi")
}

//=== TEST CASE: same_signature_uncalled_DuplicateSymbol ===
//! expect: duplicate definition of `t()`: already defined at test.rock:1
@test(output = "1") fn t() { print(1) }
@test(output = "2") fn t() { print(2) }

//=== TEST CASE: return_type_and_param_names_do_not_distinguish_DuplicateSymbol ===
//! expect: duplicate definition of `f(int)`: already defined at test.rock:1
fn f(x: int) -> int { x }
fn f(y: int) -> float { 1.0 }

fn main() {}

//=== TEST CASE: receiver_form_is_the_same_function_DuplicateSymbol ===
//! expect: duplicate definition of `g(P)`: already defined at test.rock:2
struct P { x: int }
fn P.g(p) -> int { 1 }
fn g(p: P) -> int { 2 }

fn main() {}

//=== TEST CASE: same_generic_signature_DuplicateSymbol ===
//! expect: duplicate definition of `id(T)`: already defined at test.rock:1
fn id<T>(x: T) -> T { x }
fn id<T>(x: T) -> T { x }

fn main() {}

//=== TEST CASE: same_signature_across_files_DuplicateSymbol ===
//! expect: duplicate definition of `helper(string)`: already defined at a.rock:1
//--- FILE: a.rock ---
fn helper(s: string) -> int { 1 }
//--- FILE: b.rock ---
fn helper(s: string) -> int { 2 }

fn main() {}

//=== TEST CASE: same_arity_macros_DuplicateSymbol ===
//! expect: duplicate definition of macro `dbl` taking 1 argument: already defined at test.rock:1
macro dbl(x: expr) -> int { x + x }
macro dbl(y: expr) -> int { y * 3 }

fn main() {
    print(dbl(2))
}

//=== TEST CASE: overlapping_macro_arity_DuplicateSymbol ===
//! expect: duplicate definition of macro `pick` taking 1 argument: already defined at test.rock:1
macro pick(x: expr, y: expr = 0) -> int { x + y }
macro pick(x: expr) -> int { x }

fn main() {
    print(pick(2))
}

//=== TEST CASE: struct_and_enum_same_name_DuplicateSymbol ===
//! expect: duplicate definition `Shape`
struct Shape { x: int }
enum Shape { Circle }

fn main() {}

//=== TEST CASE: struct_and_newtype_across_files_DuplicateSymbol ===
//! expect: duplicate definition `Meters`
//--- FILE: a.rock ---
struct Meters { v: float }
//--- FILE: b.rock ---
newtype Meters(float)

fn main() {}

//=== TEST CASE: same_decorator_across_files_DuplicateSymbol ===
//! expect: duplicate definition of decorator `reg`: already defined at a.rock:1
//--- FILE: a.rock ---
deco init reg {}
//--- FILE: b.rock ---
deco init reg {}

fn main() {}

//=== TEST CASE: decorator_params_do_not_distinguish_DuplicateSymbol ===
//! expect: duplicate definition of decorator `reg`: already defined at test.rock:1
deco init reg {}
deco init reg(x: int) {}

fn main() {}

//=== TEST CASE: duplicate_struct_field_Generic ===
//! expect: Duplicate field `x` in struct `Foo`
struct Foo {
    x: int,
    x: float
}

fn main() {
    print("duplicate struct field must not compile")
}

//=== TEST CASE: duplicate_enum_variant_Generic ===
//! expect: Duplicate variant `Tick` in enum `Ev`
enum Ev {
    Tick,
    Tick
}

fn main() {
    print("duplicate enum variant must not compile")
}

//=== TEST CASE: duplicate_record_payload_field_Generic ===
//! expect: Duplicate field `w` in variant `Rect` of enum `Shape`
enum Shape {
    Rect { w: int, w: int },
    Dot
}

fn main() {
    print("duplicate field in a record payload must not compile")
}

//=== TEST CASE: duplicate_struct_DuplicateSymbol ===
//! expect: duplicate definition `Player`
struct Player {
    x: int,
    y: int,
    health: int
}

struct Player {
    name: string,
    score: int
}

fn main() {
    print("Testing duplicate struct detection")
}

//=== TEST CASE: duplicate_struct_across_modules_DuplicateSymbol ===
//! expect: duplicate definition `Foo`
//--- FILE: a.rock ---
struct Foo { x: int }
//--- FILE: b.rock ---
struct Foo { y: string }

fn main() {
    print("Testing cross-module duplicate struct detection")
}

//=== TEST CASE: function_and_global_across_modules_DuplicateSymbol ===
//! expect: duplicate definition `foo`
//--- FILE: a.rock ---
fn foo() -> int { 1 }
//--- FILE: b.rock ---
global foo: int = 2

fn main() {
    print("{foo}")
}

//=== TEST CASE: function_and_global_same_module_DuplicateSymbol ===
//! expect: duplicate definition `foo`
fn foo() -> int { 1 }
global foo: int = 2

fn main() {
    print("{foo()}")
}

//=== TEST CASE: enum_cannot_shadow_stdlib_struct_DuplicateSymbol ===
//! expect: types `Envelope` and `Envelope` would both emit as `Envelope`

enum Envelope { Empty, Text(string) }

fn main() {}

//=== TEST CASE: undefined_function_SymbolNotFound ===
//! expect: `undefined_function` did not resolve to any definition
fn main() {
    undefined_function()
}

//=== TEST CASE: undefined_variable_Generic ===
//! expect: `undefined_var` did not resolve to any definition
fn main() {
    let x = undefined_var
}

//=== TEST CASE: undefined_in_operator_arg_Generic ===
// An undefined name used as an operator argument is reported like one in a
// regular call.
//! expect: `undefined_thing` did not resolve to any definition
fn main() {
    let r = undefined_thing + 1
}

//=== TEST CASE: global_r1_Generic ===
//! expect: `r1` collides with a reserved codegen identifier
global r1: int = 100
fn use_it(a: int) -> int { return a + r1 }
fn main() { print("{use_it(7)}") }

//=== TEST CASE: global_c0_Generic ===
//! expect: `c0` collides with a reserved codegen identifier
global c0: int = 5
fn use_it(a: int) -> int { return a + c0 }
fn main() { print("{use_it(1)}") }

//=== TEST CASE: global_rock_env_Generic ===
//! expect: `__rock_env` collides with a reserved codegen identifier
global __rock_env: int = 9
fn use_it(a: int) -> int { return a + __rock_env }
fn main() { print("{use_it(1)}") }

//=== TEST CASE: nomangle_fn_r2_Generic ===
//! expect: `r2` collides with a reserved codegen identifier
@nomangle fn r2() -> int { return 3 }
fn main() { print("{r2()}") }

//=== TEST CASE: global_vs_lambda_Generic ===
//! expect: compiler-reserved synthetic name
global f_0__lambda0: int = 5
fn f() { let g = () => 3 print("{g()} {g()}") }
fn main() { f() }

//=== TEST CASE: nomangle_fn_vs_lambda_Generic ===
//! expect: compiler-reserved synthetic name
@nomangle fn f_0__lambda0() -> int { return 7 }
fn f() { let g = () => 3 print("{g()} {g()}") }
fn main() { f() }

//=== TEST CASE: nomangle_fn_vs_capturing_lambda_Generic ===
//! expect: compiler-reserved synthetic name
// A CAPTURING lambda (env record) routes through the same mint_synthetic guard
// as the capture-free one.
@nomangle fn cap_int__lambda0() -> int { return 7 }
fn cap(x: int) -> fn() -> int { return () => x }
fn main() { let f = cap(5) print("{f()}") }

//=== TEST CASE: nomangle_fn_vs_hook_Generic ===
//! expect: compiler-reserved synthetic name
@nomangle fn worker_0__on_killed() -> int { return 999 }
co fn worker() -> Coroutine<int> {
    on_killed { }
    yield 1
}
fn main() { let w = worker() }

//=== TEST CASE: nomangle_fn_vs_step_Generic ===
//! expect: compiler-reserved synthetic name
@nomangle fn worker_0__step() -> int { return 1 }
co fn worker() -> Coroutine<int> {
    yield 1
    yield 2
}
fn main() { let w = worker() }

//=== TEST CASE: nomangle_fn_vs_specialized_lambda_Generic ===
//! expect: compiler-reserved synthetic name
// A specialized body names its lambdas after the instance symbol.
@nomangle fn spec_T_spec_p_int__lambda0() -> int { return 7 }
fn spec<T>(x: T) -> T {
    let g = () => x
    g()
    return g()
}
fn main() { print("{spec(5)}") print("{spec_T_spec_p_int__lambda0()}") }

//=== TEST CASE: distinct_signatures_collide_Generic ===
//! expect: mangled name `foo_int_int` is produced by two distinct function signatures
// `foo(int, int) -> int` and `foo_int(int) -> int` both mangle to `foo_int_int`.
fn foo(x: int, y: int) -> int { return x }
fn foo_int(x: int) -> int { return 0 }
fn main() { let a = foo(1, 2) let b = foo_int(1) }

//=== TEST CASE: mangled_equals_exempt_bare_name_Generic ===
//! expect: mangled name `bar_int` is produced by two distinct function signatures
// `bar(int) -> int` mangles to `bar_int`, which is the bare name a
// `@nomangle` fn `bar_int` keeps -- one emitted symbol for two functions.
fn bar(x: int) -> int { return x }
@nomangle fn bar_int() -> int { return 2 }
fn main() { let a = bar(1) let b = bar_int() }

//=== TEST CASE: misplaced_mod_header_rejects ===
