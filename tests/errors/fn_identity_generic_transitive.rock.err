//! Error: forwarding a generic into a callee that `==`-compares it is itself
//!        a comparison. `outer<T>` instantiates `same`'s compared generic with
//!        its own `T`, so the generic fn-eq summary (bone-semantic
//!        fn_identity, a whole-program fixpoint after inference) marks
//!        `outer`'s `T` compared too, and `outer(mk(), mk())` is rejected.
//!        Base cases: tests/errors/fn_identity_generic.rock.err.
//! Tags: closures, fn-values, equality, generics

//=== TEST CASE: generic_eq_fn_arg_transitive_Generic ===
fn same<T>(a: T, b: T) -> bool { return a == b }
fn outer<T>(a: T, b: T) -> bool { return same(a, b) }
fn mk() -> fn() -> int { return () => 1 }

fn main() {
    if outer(mk(), mk()) { print("same") }   // ERROR: fn identity two levels down
}

//=== TEST CASE: generic_eq_fn_arg_transitive_two_levels_Generic ===
fn same<T>(a: T, b: T) -> bool { return a == b }
fn mid<U>(a: U, b: U) -> bool { return same(a, b) }
fn outer<V>(a: V, b: V) -> bool { return mid(a, b) }
fn mk() -> fn() -> int { return () => 1 }

fn main() {
    if outer(mk(), mk()) { print("same") }   // ERROR: fn identity three levels down
}

//=== TEST CASE: generic_eq_fn_arg_mutual_recursion_Generic ===
fn ping<T>(a: T, b: T, n: int) -> bool {
    if n == 0 { return a == b }
    return pong(a, b, n - 1)
}
fn pong<T>(a: T, b: T, n: int) -> bool { return ping(a, b, n) }
fn mk() -> fn() -> int { return () => 1 }

fn main() {
    if pong(mk(), mk(), 2) { print("same") }   // ERROR: compared through a cycle
}
