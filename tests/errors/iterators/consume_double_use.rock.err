//! `@consume` values cannot be reused after ownership transfer, including
//! through branches, containers, calls, closures, and returns. Iterator `next`
//! borrows the cursor, so a partial read before one terminal consume is valid.
//! Tags: iterators, consume, affine

//=== TEST CASE: double_for_over_cursor_Generic ===
//! expect: use of consumed binding
fn main() {
    let v = [1, 2, 3]
    let it = v.iter()
    let a = 0
    for x in it { a += x }
    let b = 0
    for x in it { b += x }
    print("{a} {b}")
}

//=== TEST CASE: for_then_terminal_Generic ===
//! expect: use of consumed binding
fn main() {
    let v = [1, 2, 3]
    let it = v.iter().map(x => x * 2)
    let a = 0
    for x in it { a += x }
    let r = it.collect()
    print("{a} {r.len}")
}

//=== TEST CASE: wrap_then_use_Generic ===
//! expect: use of consumed binding
fn main() {
    let v = [1, 2, 3]
    let it = v.iter()
    let doubled = it.map(x => x * 2)
    let a = 0
    for x in it { a += x }
    let b = 0
    for x in doubled { b += x }
    print("{a} {b}")
}

//=== TEST CASE: copy_then_use_Generic ===
//! expect: use of consumed binding
fn main() {
    let v = [1, 2, 3]
    let it = v.iter()
    let alias = it
    let a = 0
    for x in alias { a += x }
    let b = 0
    for x in it { b += x }
    print("{a} {b}")
}

//=== TEST CASE: loop_reuse_of_outer_cursor_Generic ===
//! expect: cannot consume
fn main() {
    let v = [1, 2, 3]
    let it = v.iter()
    let total = 0
    for round in 0..2 {
        for x in it { total += x }
    }
    print("{total}")
}

//=== TEST CASE: both_branch_join_then_use_Generic ===
//! expect: use of consumed binding
fn check_both_branches(flag: bool) {
    let it = [1, 2, 3].iter()
    if flag {
        let _ = it.collect()
    } else {
        let _ = it.collect()
    }
    let _ = it.collect()
}
fn main() { check_both_branches(true) }

//=== TEST CASE: one_branch_join_then_use_Generic ===
//! expect: use of consumed binding
fn check_one_branch(flag: bool) {
    let it = [1, 2, 3].iter()
    if flag {
        let _ = it.collect()
    }
    let _ = it.collect()
}
fn main() { check_one_branch(true) }

//=== TEST CASE: partial_next_then_one_consume_then_reuse_Generic ===
//! expect: use of consumed binding
fn main() {
    let it = [1, 2, 3].iter()
    let (more, first) = it.next()
    let _ = more
    let _ = first
    let rest = it.collect()
    let again = it.collect()
    print("{rest.len} {again.len}")
}

//=== TEST CASE: passing_to_consuming_function_then_reuse_Generic ===
//! expect: use of consumed binding
fn drain<I: Iterator<int>>(it: I) -> int {
    return it.count()
}

fn main() {
    let it = [1, 2, 3].iter()
    let n = drain(it)
    let again = drain(it)
    print("{n} {again}")
}

//=== TEST CASE: captured_cursor_then_consume_Generic ===
//! expect: use of consumed binding
fn main() {
    let it = [1, 2, 3].iter()
    let read = () => it.count()
    let n = it.count()
    print("{n}")
}

//=== TEST CASE: cursor_binding_stored_in_field_then_reused_Generic ===
//! expect: use of consumed binding
struct Holder<I> {
    cursor: I,
}

fn main() {
    let it = [1, 2, 3].iter()
    let holder = Holder { cursor: it }
    let n = it.count()
    print("{n}")
}

//=== TEST CASE: cursor_pushed_then_reused_Generic ===
//! expect: use of consumed binding
fn main() {
    let cursors: [VecIter<int>] = []
    let it = [1, 2, 3].iter()
    cursors.push(it)
    let n = it.count()
    print("{n}")
}

//=== TEST CASE: cursor_returned_then_reused_Generic ===
//! expect: use of consumed binding
fn return_cursor(it: VecIter<int>) -> VecIter<int> {
    return it
}

fn main() {
    let it = [1, 2, 3].iter()
    let returned = return_cursor(it)
    let n = it.count()
    print("{n} {returned.count()}")
}

//=== TEST CASE: user_consume_struct_double_use_Generic ===
//! expect: use of consumed binding
@consume
struct Ticket {
    id: int,
}

fn punch(t: Ticket) -> int {
    return t.id
}

fn main() {
    let t = Ticket { id: 7 }
    let a = punch(t)
    let b = punch(t)
    print("{a} {b}")
}

