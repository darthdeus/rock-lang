//! Iterator bounds make generic bindings affine, including inside an uncalled function.

//=== TEST CASE: bounded_generic_double_for_Generic ===
//! expect: use of consumed binding `it`
fn drain<I: Iterator<int>>(it: I) {
    for x in it {}
    for x in it {}
}
fn main() {}

//=== TEST CASE: bounded_generic_next_after_for_Generic ===
//! expect: use of consumed binding `it`
fn drain<I: Iterator<int>>(it: I) {
    for x in it {}
    let _ = it.next()
}
fn main() {}

//=== TEST CASE: bounded_generic_reassignment_consumes_rhs_Generic ===
//! expect: use of consumed binding `fresh`
fn drain<I: Iterator<int>>(it: I, fresh: I) {
    for x in it {}
    it = fresh
    for x in it {}
    for x in fresh {}
}
fn main() {}
