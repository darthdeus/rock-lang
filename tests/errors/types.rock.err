//=== TEST CASE: struct_to_struct_mismatch_MismatchedType ===
//! expect: type mismatch: expected `Point`, found `Color`
struct Point { x: int, y: int }
struct Color { r: int, g: int, b: int }

// Error: Point parameter cannot have Color default
fn bad_func(p: Point = Color { r: 255, g: 0, b: 0 }) {
    print("This should not compile")
}

fn main() {
    bad_func()
}

//=== TEST CASE: null_to_non_nullable_NullAssignmentToNonNullable ===
//! expect: type mismatch: expected `Point`, found `null?`
struct Point { x: int, y: int }

// Error: Cannot assign null to non-nullable type
fn bad_func(p: Point = null) {
    print("This should not compile")
}

fn main() {
    bad_func()
}

//=== TEST CASE: function_type_default_mismatch_Generic ===
//! expect: type mismatch: expected `int`, found `string`
fn dummy_int() -> int {
    return 42
}

fn dummy_string() -> string {
    return "hello"
}

// Error: Function returning string cannot be default for function returning int
fn bad_func(f: fn() -> int = dummy_string) {
    print(f())
}

fn main() {
    bad_func()
}

//=== TEST CASE: array_element_mismatch_MismatchedType ===
//! expect: type mismatch: expected `int`, found `string`
fn main() {
    let numbers: [int] = [1, 2, "three"]
}

//=== TEST CASE: nominal_mismatch_after_quiet_trial_Generic ===
// A quiet failed trial (the nullable coerce) does not lose the reported types.
//! expect: type mismatch: expected `Foo`, found `Bar`
struct Foo { x: int }
struct Bar { x: int }
fn main() { let a: Foo? = Bar { x: 1 } }

//=== TEST CASE: constructor_mismatch_Generic ===
//! expect: type mismatch: expected `[int]`, found `Foo` (different type constructors)
struct Foo { x: int }
fn main() { let a: [int] = Foo { x: 1 } }

//=== TEST CASE: heterogeneous_struct_spread_Generic ===
//! expect: type mismatch: expected `int`, found `string`
struct Mixed {
    name: string,
    age: int,
    score: float,
}

fn main() {
    let person = Mixed { name: "Alice", age: 25, score: 95.5 }
    let data: [int] = [...person, 100]
}

//=== TEST CASE: heterogeneous_tuple_spread_into_int_array_MismatchedType ===
//! expect: type mismatch: expected `int`, found `float`
fn main() {
    let floats = (1.0, 2.0, 3.0)
    let data: [int] = [...floats, 4]
}

//=== TEST CASE: heterogeneous_tuple_spread_untyped_TypeMismatch ===
// Every spread element must share the array element type.
//! expect: type mismatch: expected `string`, found `int`
fn main() {
    let mixed = (1, "hello", 3.14)
    let data = [...mixed]
}

//=== TEST CASE: tuple_unify_mismatch_Generic ===
// element mismatch: (int, int) arg vs (int, bool) param fails at unify
//! expect: type mismatch: expected `bool`, found `int`
fn pair<T>(x: T) -> (T, T) { (x, x) }
fn takes(p: (int, bool)) -> int { 5 }
fn f() -> int { takes(pair(5)) }

//=== TEST CASE: tuple_unify_length_mismatch_Generic ===
// length mismatch: 2-tuple arg vs 3-tuple param fails at unify
//! expect: Failed to unify (int, int) and (int, int, int), tuples of different length
fn pair<T>(x: T) -> (T, T) { (x, x) }
fn takes3(p: (int, int, int)) -> int { 5 }
fn f() -> int { takes3(pair(5)) }

//=== TEST CASE: tuple_index_oob_Generic ===
// out-of-bounds index on a 2-tuple must error
//! expect: tuple index 2 out of bounds (len 2)
fn f() -> int {
    let t = (1, true)
    let x = t.2
    5
}

//=== TEST CASE: tuple_index_non_tuple_Generic ===
// indexing a non-tuple must error
//! expect: cannot index a non-tuple type int
fn f() -> int {
    let y = 5
    let x = y.0
    5
}

//=== TEST CASE: negative_tuple_index ===
//! expect: must be followed by an identifier or integer
fn main() {
    let t = (1, 2)
    print(t.-1)   // ERROR: field access `.` must be followed by an identifier or integer
}

//=== TEST CASE: negative_safe_navigation_index ===
//! expect: expected CloseParen
fn main() {
    let t: (int, int)? = (1, 2)
    print(t?.-1)   // ERROR: expected CloseParen, got Int(-1)
}

//=== TEST CASE: index_array_bad_index_Generic ===
// a non-int index into an array must fail
//! expect: type mismatch: expected `int`, found `bool`
fn f() -> int {
    let xs = [1, 2, 3]
    let x = xs[true]
    5
}

//=== TEST CASE: index_map_bad_key_Generic ===
// a wrong key type into a map must fail
//! expect: type mismatch: expected `string`, found `int`
fn f(m: Map<string, int>) -> int {
    let v = m[5]
    5
}

//=== TEST CASE: index_non_indexable_Generic ===
// indexing a non-indexable type must fail
//! expect: cannot index into type int
fn f() -> int {
    let y = 5
    let x = y[0]
    5
}

//=== TEST CASE: array_literal_heterogeneous_Generic ===
// Array literal elements unify: int and bool do not.
//! expect: type mismatch: expected `bool`, found `int`
fn f() -> int {
    let xs = [1, true]
    5
}

//=== TEST CASE: array_int_to_float_rejected_MismatchedType ===
//! expect: type mismatch: expected `float`, found `int`
fn g() -> int {
    let xs: [int] = [1, 2, 3]
    let ys: [float] = xs
    ys.len()
}

//=== TEST CASE: struct_missing_type_args_Generic ===
//! expect: Generic type `GenericStruct` requires 1 type argument(s)
struct GenericStruct<T> {
    value: T
}

fn main() {
    let x: GenericStruct = GenericStruct { value: 42 }
    print(x.value)
}

//=== TEST CASE: enum_missing_type_args_Generic ===
//! expect: Generic type `GenericEnum` requires 1 type argument(s)
enum GenericEnum<T> {
    Some(T),
    None
}

fn main() {
    let x: GenericEnum = GenericEnum::Some(42)
    print("test")
}

//=== TEST CASE: entity_missing_type_args_Generic ===
//! expect: Generic type `Entity` requires 1 type argument(s)
fn main() {
    let e: Entity = entity_new(arena_new(), 0, 0)
    print("test")
}

//=== TEST CASE: function_param_missing_type_args_Generic ===
//! expect: Generic type `Entity` requires 1 type argument(s)
fn buggy_entity_equals(a: Entity, b: Entity) -> bool {
    return true
}

fn main() {
    print("test")
}

//=== TEST CASE: entity_invariance_MismatchedType ===
//! expect: type mismatch: expected `float`, found `int`
fn main() {
    let arena: Arena<int> = arena_new()
    let int_entity: Entity<int> = entity_new(arena, 1, 0)
    // Entity<T> is invariant: Entity<int> is NOT an Entity<float>,
    // even though a bare int widens to float.
    let float_entity: Entity<float> = int_entity
}

//=== TEST CASE: custom_struct_invariance_MismatchedType ===
//! expect: type mismatch: expected `float`, found `int`
struct Container<T> {
    item: T
}

fn process_float_container(c: Container<float>) {}

fn main() {
    let int_container: Container<int> = Container { item: 5 }
    // Container<T> invariant: Container<int> is NOT a Container<float>.
    process_float_container(int_container)
}

//=== TEST CASE: too_few_args_bare_Generic ===
//! expect: Generic type `P` requires at least 1 type argument(s)
struct P<T, U = int> {
    a: T,
    b: U,
}

fn main() {
    let p: P = P { a: 1, b: 2 }
}

//=== TEST CASE: too_many_args_Generic ===
//! expect: Generic type `P` expects 1 to 2 type argument(s), found 3
struct P<T, U = int> {
    a: T,
    b: U,
}

fn main() {
    let p: P<int, int, int> = P { a: 1, b: 2 }
}

//=== TEST CASE: non_trailing_default_Generic ===
//! expect: type parameter `B` without a default follows defaulted `A`; defaults must be trailing
struct Bad<A = int, B> {
    a: A,
    b: B,
}

fn main() {
}

//=== TEST CASE: fn_generic_default_Generic ===
//! expect: default type params are not supported on fn generics
fn f<T = int>(x: T) -> T {
    x
}

fn main() {
    f(1)
}

//=== TEST CASE: sibling_ref_default_Generic ===
//! expect: default for type parameter `U` may not reference sibling type parameter `T`
struct S<T, U = T> {
    a: T,
    b: U,
}

fn main() {
}

//=== TEST CASE: unsupported_shape_default_Generic ===
//! expect: unsupported default for type parameter `U` on a struct: only builtin types and bare type names are supported
struct S<T, U = [int]> {
    a: T,
    b: U,
}

fn main() {
}

//=== TEST CASE: unknown_name_default_Generic ===
//! expect: `Nope` did not resolve to any definition
struct S<T, U = Nope> {
    a: T,
    b: U,
}

fn main() {
}

