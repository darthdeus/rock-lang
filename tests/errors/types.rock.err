//=== TEST CASE: vec_unknown_field_fail_Generic ===
//! expect: struct `Vec` has no field `nope`
fn f(v: [int]) -> int {
    v.nope
}

//=== TEST CASE: vec2_component_out_of_arity_Rejected ===
//! expect: `Vec2` has no `z` component (swizzle `xz`)
fn main() {
    let p = v(1.0, 2.0)
    let q = p.xz   // ERROR: Vec2 has no z component
    print("{q.x}")
}

//=== TEST CASE: mixed_alphabet_Rejected ===
//! expect: swizzle `xg` mixes the `xyzw` and `rgba` alphabets
fn main() {
    let c = v(1.0, 2.0, 3.0, 4.0)
    let q = c.xg   // ERROR: mixed swizzle alphabets
    print("{q.x}")
}

//=== TEST CASE: swizzle_assignment_Rejected ===
//! expect: cannot assign to swizzle `yx`: swizzles are read-only
fn main() {
    let p = v(1.0, 2.0)
    p.yx = v(3.0, 4.0)   // ERROR: swizzles are read-only
}

//=== TEST CASE: swizzle_compound_assignment_Rejected ===
//! expect: cannot assign to swizzle `xy`: swizzles are read-only
fn main() {
    let p = v(1.0, 2.0)
    p.xy += v(1.0, 1.0)   // ERROR: swizzles are read-only
}

//=== TEST CASE: swizzle_name_on_non_vec_struct_Rejected ===
//! expect: struct `Foo` has no field `yx`
struct Foo { x: float }

fn main() {
    let f = Foo { x: 1.0 }
    let q = f.yx   // ERROR: no such field on Foo
    print("{q}")
}

//=== TEST CASE: too_long_swizzle_Rejected ===
//! expect: swizzle `xyxyx` has more than 4 components
fn main() {
    let p = v(1.0, 2.0)
    let q = p.xyxyx   // ERROR: swizzles are at most 4 components
    print("{q}")
}

//=== TEST CASE: vec_of_tuples_dot0_rejected_Generic ===
//! expect: cannot index a non-tuple type [(int, string)]
// A tuple index applies to a tuple or newtype, not to a vec of them; the
// explicit form is `pairs.map(_.0)`.
fn test() -> int {
    let pairs: [(int, string)] = [(1, "a"), (2, "b")]
    let firsts = pairs.0  // ERROR: Expected tuple or newtype, found [(int, string)]
    vec_len(firsts)
}

fn main() { let _ = test() }

//=== TEST CASE: newtype_no_base_coercion_Generic ===
// The wrapped base type does not implicitly become the newtype.
//! expect: type mismatch: expected `UserId`, found `int`
newtype UserId(int)
fn f() -> int {
    let bad: UserId = 5
    0
}

//=== TEST CASE: newtype_construct_wrong_arg_Generic ===
// Construction arg must match the wrapped type.
//! expect: type mismatch: expected `int`, found `string`
newtype UserId(int)
fn f() -> int {
    let id = UserId("nope")
    0
}

//=== TEST CASE: map_key_value_conflict_TypeMismatch ===
// Map<T, T> requires the key and value positions to bind the same T;
// Map<int, string> binds T to two different types.
//! expect: type mismatch: expected `int`, found `string`
newtype Diag<T>(Map<T, T>)

fn main() {
    let m: Map<int, string> = map_new()
    m[1] = "x"
    let d = Diag(m)
}

//=== TEST CASE: non_app_arg_for_app_pattern_TypeMismatch ===
// The pattern is Entity<T>; a plain int cannot match a type application.
//! expect: type mismatch: expected `Entity<T>`, found `int`
newtype Wrap<T>(Entity<T>)

fn main() {
    let w = Wrap(42)
}

//=== TEST CASE: multi_field_newtype_def_rejected ===
//! expect: a newtype wraps exactly one type
newtype Bad(int, string)

fn main() {
    print("never constructed")
}
