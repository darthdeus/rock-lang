//! Error: `::` is a checked contextual ascription -- the ascribed type is the
//!        operand's expected type, so only ordinary assignment compatibility
//!        is accepted. Explicit narrowing belongs to `as`.
//! Tags: ascription, types, mono

//=== TEST CASE: ascribe_int_to_string_MismatchedType ===
fn main() {
    let value = 42 :: string
    print(value)
}

//=== TEST CASE: ascribe_float_to_int_MismatchedType ===
fn main() {
    let value = 3.14 :: int
    print(value)
}

//=== TEST CASE: ascribe_string_to_int_MismatchedType ===
fn main() {
    let value = "42" :: int
    print(value)
}

//=== TEST CASE: ascribe_generic_fn_value_MismatchedType ===
fn identity<T>(x: T) -> T { x }

fn main() {
    let f = identity :: fn(int) -> int
    print(f(1))
}
