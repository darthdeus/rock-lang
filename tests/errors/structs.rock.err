//=== TEST CASE: unknown_type_still_errors_Generic ===
// a genuinely unknown type name is still rejected.
//! expect: `Nope` did not resolve to any definition
fn f(p: Nope) -> int {
    5
}

//=== TEST CASE: struct_literal_wrong_field_type_Generic ===
// a field value with the wrong type is rejected.
//! expect: type mismatch: expected `int`, found `bool`
struct Point { x: int, y: int }
fn f() -> int {
    let p = Point { x: 1, y: true }
    5
}

//=== TEST CASE: struct_literal_missing_field_Generic ===
// a missing field is rejected.
//! expect: Missing field `y` in struct `Point` literal
struct Point { x: int, y: int }
fn f() -> int {
    let p = Point { x: 1 }
    5
}

//=== TEST CASE: struct_literal_unknown_field_Generic ===
// an unknown field is rejected.
//! expect: struct `Point` has no field named `z`
struct Point { x: int, y: int }
fn f() -> int {
    let p = Point { x: 1, y: 2, z: 3 }
    5
}

//=== TEST CASE: struct_unknown_field_access_Generic ===
// accessing a field the struct doesn't have is rejected.
//! expect: struct `Point` has no field `z`
struct Point { x: int, y: int }
fn f() -> int {
    let p = Point { x: 1, y: 2 }
    let a = p.z
    5
}

//=== TEST CASE: field_access_on_non_struct_Generic ===
// accessing a field on a non-struct is rejected.
//! expect: cannot access field `x` on non-struct type int
fn f() -> int {
    let n = 5
    let a = n.x
    5
}

//=== TEST CASE: non_default_field_required_Generic ===
// A non-defaulted field is still required.
//! expect: Missing field `kind` in struct `Slime` literal
struct Slime { kind: int, health: int = 100 }
fn f() -> int {
    let s = Slime { health: 5 }
    0
}

//=== TEST CASE: update_wrong_nominal_base_MismatchedType ===
//! expect: type mismatch: expected `B`, found `A`
// Rule 6: the base must have the SAME nominal type as the literal.
struct A { x: int, y: int }
struct B { x: int, y: int }

fn main() {
    let a = A { x: 1, y: 2 }
    let b = B { ..a, y: 9 }   // ERROR: base is `A`, literal is `B`
    print(b.x)
}

//=== TEST CASE: update_two_bases_Generic ===
//! expect: a functional-update literal takes at most one `..base`
// Rule 5: two same-type bases both supply every field (collision).
struct P { x: int, y: int }

fn main() {
    let a = P { x: 1, y: 2 }
    let b = P { x: 3, y: 4 }
    let c = P { ..a, ..b }   // ERROR: at most one base allowed
    print(c.x)
}

//=== TEST CASE: enum_payload_mismatch_Generic ===
// wrong payload type is rejected.
//! expect: type mismatch: expected `float`, found `bool`
enum Shape { Circle(float), Rect(float, float) }
fn f() -> Shape {
    Shape::Circle(true)
}

//=== TEST CASE: embed_whole_value_binding_Generic ===
//! expect: `p` is an `embed` field: it has no independently storable value
// THE headline case: illegal even where flattening would physically be a no-op.
struct Pt { x: int, y: int }
struct Holder { embed p: Pt, tag: int }

fn main() {
    let h = Holder { p: Pt { x: 1, y: 2 }, tag: 3 }
    let q = h.p   // ERROR: binds the whole embedded field
    print("{q.x}")
}

//=== TEST CASE: embed_whole_value_return_Generic ===
//! expect: `p` is an `embed` field: it has no independently storable value
struct Pt { x: int, y: int }
struct Holder { embed p: Pt, tag: int }

fn leak(h: Holder) -> Pt {
    return h.p   // ERROR: returns the whole embedded field
}

fn main() {
    let h = Holder { p: Pt { x: 1, y: 2 }, tag: 3 }
    print("{leak(h).x}")
}

//=== TEST CASE: embed_closure_capture_Generic ===
//! expect: `p` is an `embed` field: it has no independently storable value
struct Pt { x: int, y: int }
struct Holder { embed p: Pt, tag: int }

fn main() {
    let h = Holder { p: Pt { x: 1, y: 2 }, tag: 3 }
    let f = () => h.p   // ERROR: captures the whole embedded field
    print("{f().x}")
}

//=== TEST CASE: embed_collection_element_Generic ===
//! expect: `p` is an `embed` field: it has no independently storable value
struct Pt { x: int, y: int }
struct Holder { embed p: Pt, tag: int }

fn main() {
    let h = Holder { p: Pt { x: 1, y: 2 }, tag: 3 }
    let xs = [h.p]   // ERROR: an embedded field cannot be a collection element
    print("{xs.len}")
}

//=== TEST CASE: embed_any_boundary_Generic ===
//! expect: `p` is an `embed` field: it has no independently storable value
struct Pt { x: int, y: int }
struct Holder { embed p: Pt, tag: int }

fn main() {
    let h = Holder { p: Pt { x: 1, y: 2 }, tag: 3 }
    let a: any = h.p   // ERROR: erasing an embedded field materializes it
    print("{a}")
}

//=== TEST CASE: embed_non_scalar_abi_callee_Generic ===
//! expect: `p` is an `embed` field: it has no independently storable value
// A `@nomangle` / `extern` / inline callee receives a BOX, so it is not a
// scalar-ABI consumer even though the syntax looks like the legal call form.
struct Pt { x: int, y: int }
struct Holder { embed p: Pt, tag: int }

@nomangle inline(lua) fn sink_pt(p: Pt) -> int = """
    return p.x
"""

fn main() {
    let h = Holder { p: Pt { x: 1, y: 2 }, tag: 3 }
    print("{sink_pt(h.p)}")   // ERROR: callee does not take leaves
}

//=== TEST CASE: embed_readable_field_ref_Generic ===
//! expect: a readable selector would hand out the whole value
// The extraction hole `WriteFieldRef` closed: `.p` may satisfy a write-only
// selector, but a readable one hands out the whole value.
struct Pt { x: int, y: int }
struct Holder { embed p: Pt, tag: int }

fn read_slot(f: ReadFieldRef<Holder, Pt>) {}

fn main() {
    read_slot(.p)   // ERROR: no readable selector for an embedded field
}

//=== TEST CASE: embed_full_field_ref_Generic ===
//! expect: a readable selector would hand out the whole value
struct Pt { x: int, y: int }
struct Holder { embed p: Pt, tag: int }

fn rw_slot(f: FieldRef<Holder, Pt>) {}

fn main() {
    rw_slot(.p)   // ERROR: FieldRef coerces onward to a readable selector
}

//=== TEST CASE: embed_nullable_let_binding_Generic ===
//! expect: `p` is an `embed` field: it has no independently storable value
// Presence is a leaf, so presence ops are projections -- but `?.let` binds the
// whole value.
struct Pt { x: int, y: int }
struct Holder { embed p: Pt?, tag: int }

fn main() {
    let h = Holder { p: null, tag: 3 }
    let r = h.p?.let { 1 }   // ERROR: binds the whole embedded field
    print("{r}")
}

//=== TEST CASE: embed_nullable_coalesce_Generic ===
//! expect: `p` is an `embed` field: it has no independently storable value
struct Pt { x: int, y: int }
struct Holder { embed p: Pt?, tag: int }

fn main() {
    let h = Holder { p: null, tag: 3 }
    let q = h.p ?? Pt { x: 0, y: 0 }   // ERROR: coalesces the whole field
    print("{q.x}")
}

