fn main() {
    let h = Holder { c: Color::Red }
    print("{h.c}")
}

//=== TEST CASE: embed_generic_param_Generic ===
//! expect: cannot `embed` field `t`: a generic parameter has no statically known leaves to inline
// A generic param has no statically known leaves at the declaration.
struct Holder<T> { embed t: T }

fn main() {
    let h: Holder<int> = Holder { t: 1 }
    print("{h.t}")
}

//=== TEST CASE: embed_self_cycle_Generic ===
//! expect: cannot `embed` field `next`: the embed graph is cyclic, so the layout has no finite size
struct Node { embed next: Node, v: int }

fn main() {
    print("unreachable")
}

//=== TEST CASE: embed_mutual_cycle_Generic ===
//! expect: cannot `embed` field `b`: the embed graph is cyclic, so the layout has no finite size
struct A { embed b: B, v: int }
struct B { embed a: A, w: int }

fn main() {
    print("unreachable")
}

