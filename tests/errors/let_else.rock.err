//! Error: `let ... else` rejections

//=== TEST CASE: else_must_diverge_NonDiverging ===
//! expect: must diverge
fn main() {
    let v: int? = 5
    let x = v else {
        print("missing")
    }
    print(x)
}

//=== TEST CASE: else_value_tail_NonDiverging ===
//! expect: must diverge
fn f(v: int?) -> int {
    let x = v else {
        0
    }
    x
}

//=== TEST CASE: irrefutable_else_never_runs_Useless ===
//! expect: never runs
fn f(v: int) -> int {
    let x = v else {
        return 0
    }
    x
}

//=== TEST CASE: else_does_not_see_bindings_Scope ===
//! expect: `x` did not resolve to any definition
fn f(v: int?) -> int {
    let x = v else {
        return x
    }
    x
}

//=== TEST CASE: loop_with_break_does_not_diverge_NonDiverging ===
//! expect: must diverge
fn f(v: int?) -> int {
    let x = v else {
        loop {
            break
        }
    }
    x
}
fn main() {}

//=== TEST CASE: loop_with_expression_break_does_not_diverge_NonDiverging ===
//! expect: must diverge
fn f(v: int?, w: int?) -> int {
    let x = v else {
        loop {
            let y = w ?? break
            print(y)
        }
    }
    x
}
fn main() {}

//=== TEST CASE: loop_with_let_else_break_does_not_diverge_NonDiverging ===
//! expect: must diverge
fn f(v: int?, w: int?) -> int {
    let x = v else {
        loop {
            let y = w else { break }
            print(y)
        }
    }
    x
}
fn main() {}
