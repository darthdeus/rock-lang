//! Error: relocatable element references cannot be retained by coroutines.
//! Tags: coroutines, refs, flat-storage

//=== TEST CASE: coroutine_cannot_receive_a_flat_element_ref ===
//! expect: cannot pass a reference into a relocatable Vec or Map element to `bump`: the reference is retained by a coroutine
value Cell { w: int }
co fn bump(c: ref Cell) -> Coroutine<int> {
    c.w += 1
    yield c.w
}
fn main() {
    let xs: [Cell] = [Cell { w: 1 }]
    let c = bump(xs[0])
    resume(c)
}

//=== TEST CASE: coroutine_cannot_receive_a_forwarded_flat_element_ref ===
//! expect: cannot pass a reference into a relocatable Vec or Map element to `relay`: the reference is retained by a coroutine
value Cell { w: int }
co fn bump(c: ref Cell) -> Coroutine<int> {
    c.w += 1
    yield c.w
}
fn relay(c: ref Cell) -> Coroutine<int> { return bump(c) }
fn main() {
    let xs: [Cell] = [Cell { w: 1 }]
    let c = relay(xs[0])
    resume(c)
}

//=== TEST CASE: coroutine_cannot_receive_a_map_element_ref ===
//! expect: cannot pass a reference into a relocatable Vec or Map element to `bump`: the reference is retained by a coroutine
value Cell { w: int }
co fn bump(c: ref Cell) -> Coroutine<int> { yield c.w }
fn main() {
    let cells: Map<string, Cell> = map_new()
    cells["a"] = Cell { w: 1 }
    let task = bump(cells["a"])
}

//=== TEST CASE: coroutine_cannot_receive_an_explicit_vec_element_ref ===
//! expect: cannot retain a reference into relocatable Vec or Map storage
value Cell { w: int }
co fn read(c: ref Cell) -> Coroutine<int> { yield c.w }
fn main() {
    let cells: [Cell] = [Cell { w: 1 }]
    let borrowed: ref Cell = cells[0]
    let task = read(borrowed)
}

//=== TEST CASE: coroutine_cannot_receive_an_explicit_map_element_ref ===
//! expect: cannot retain a reference into relocatable Vec or Map storage
value Cell { w: int }
co fn read(c: ref Cell) -> Coroutine<int> { yield c.w }
fn main() {
    let cells: Map<string, Cell> = map_new()
    cells["a"] = Cell { w: 1 }
    let borrowed: ref Cell = cells["a"]
    let task = read(borrowed)
}

