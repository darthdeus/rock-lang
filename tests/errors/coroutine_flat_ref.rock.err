value Cell { w: int }
co fn read(c: ref Cell) -> Coroutine<int> { yield c.w }
fn main() {
    let cells: [Cell] = [Cell { w: 1 }]
    let task = read(cells[0])
}

//=== TEST CASE: overloaded_coroutine_cannot_receive_a_map_element_ref ===
//! expect: cannot pass a reference into a relocatable Vec or Map element to `read`: the reference is retained by a coroutine
value Cell { w: int }
co fn read(c: ref Cell) -> Coroutine<int> { yield c.w }
fn main() {
    let cells: Map<string, Cell> = map_new()
    cells["a"] = Cell { w: 1 }
    let task = read(cells["a"])
