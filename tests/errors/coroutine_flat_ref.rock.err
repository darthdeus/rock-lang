//=== TEST CASE: coroutine_cannot_borrow_a_spread_vec_element_field ===
//! expect: No overload for `read` with argument types (Wrapper)
value Cell { w: int }
value Wrapper { c: Cell }
co fn read(c: ref Cell) -> Coroutine<int> { yield c.w }
fn main() {
    let cells: [Wrapper] = [Wrapper { c: Cell { w: 1 } }]
    let task = read(..cells[0])
}

//=== TEST CASE: coroutine_cannot_borrow_a_spread_map_element_field ===
//! expect: No overload for `read` with argument types (Wrapper)
value Cell { w: int }
value Wrapper { c: Cell }
co fn read(c: ref Cell) -> Coroutine<int> { yield c.w }
fn main() {
    let cells: Map<string, Wrapper> = map_new()
    cells["a"] = Wrapper { c: Cell { w: 1 } }
    let task = read(..cells["a"])
}
