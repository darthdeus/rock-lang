//=== TEST CASE: let_annotation_mismatch_Generic ===
// The initializer must match the annotation.
//! expect: type mismatch: expected `bool`, found `int`
fn f() -> int {
    let x: bool = 5
    x
}

//=== TEST CASE: else_must_diverge_NonDiverging ===
// `let ... else` rejections
//! expect: must diverge
fn main() {
    let v: int? = 5
    let x = v else {
        print("missing")
    }
    print(x)
}

//=== TEST CASE: else_value_tail_NonDiverging ===
//! expect: must diverge
fn f(v: int?) -> int {
    let x = v else {
        0
    }
    x
}

//=== TEST CASE: irrefutable_else_never_runs_Useless ===
//! expect: never runs
fn f(v: int) -> int {
    let x = v else {
        return 0
    }
    x
}

//=== TEST CASE: else_does_not_see_bindings_Scope ===
//! expect: `x` did not resolve to any definition
fn f(v: int?) -> int {
    let x = v else {
        return x
    }
    x
}

//=== TEST CASE: loop_with_break_does_not_diverge_NonDiverging ===
//! expect: must diverge
fn f(v: int?) -> int {
    let x = v else {
        loop {
            break
        }
    }
    x
}
fn main() {}

//=== TEST CASE: loop_with_expression_break_does_not_diverge_NonDiverging ===
//! expect: must diverge
fn f(v: int?, w: int?) -> int {
    let x = v else {
        loop {
            let y = w ?? break
            print(y)
        }
    }
    x
}
fn main() {}

//=== TEST CASE: loop_with_let_else_break_does_not_diverge_NonDiverging ===
//! expect: must diverge
fn f(v: int?, w: int?) -> int {
    let x = v else {
        loop {
            let y = w else { break }
            print(y)
        }
    }
    x
}
fn main() {}

//=== TEST CASE: let_no_init_simple_Generic ===
// `let` binding requires an initializer (uninitialized `let x: T` removed)
//! expect: let without value is not supported
// Uninitialized `let x: T` is disallowed — declare and assign in one
// step (`let x = <value>`). Previously allowed (pre-declare a slot,
// assign later); removed.
fn test() -> int {
    let x: int   // ERROR: `let` binding requires an initializer
    x = 5
    x
}
fn main() { let _ = test() }

//=== TEST CASE: let_no_init_tuple_Generic ===
//! expect: let without value is not supported
fn test() {
    let (x, y): (int, int)   // ERROR: `let` binding requires an initializer
    x = 1
    y = 2
    print("{x} {y}")
}
fn main() { test() }

//=== TEST CASE: let_no_init_value_struct_Generic ===
//! expect: let without value is not supported
value V2i { x: int, y: int }

fn test() {
    let v: V2i   // ERROR: `let` binding requires an initializer
    v = V2i { x: 1, y: 2 }
    print("{v.x} {v.y}")
}
fn main() { test() }

//=== TEST CASE: let_enum_variant_Refutable ===
// refutable patterns in `let`/`for` are rejected
//
// A `let` or `for` pattern must match every value of its type; a pattern
// that can fail belongs in `match`, `if let`, or `let ... else`.
//! expect: can fail
enum Opt { None, Some(int) }
fn main() {
    let v = Opt::Some(1)
    let Opt::Some(x) = v
    print(x)
}

//=== TEST CASE: let_literal_Refutable ===
//! expect: can fail
fn main() {
    let 5 = 5
}

//=== TEST CASE: let_tuple_literal_elem_Refutable ===
//! expect: can fail
fn main() {
    let (a, 3) = (1, 3)
    print(a)
}

//=== TEST CASE: for_enum_variant_Refutable ===
//! expect: can fail
enum Opt { None, Some(int) }
fn main() {
    let xs = [Opt::Some(1)]
    for Opt::Some(x) in xs {
        print(x)
    }
}

//=== TEST CASE: annotated_tuple_mismatch_TypeMismatch ===
//! expect: mismatch
fn main() {
    let (a, b): (int, string) = (1, 2)
    print(a)
}

//=== TEST CASE: struct_field_literal_Refutable ===
//! expect: can fail
struct Point { x: int, y: int }
fn main() {
    let p = Point { x: 0, y: 1 }
    let Point { x: 0, y } = p
    print(y)
}

//=== TEST CASE: newtype_literal_Refutable ===
//! expect: can fail
newtype Id(int)
fn main() {
    let Id(0) = Id(1)
}

//=== TEST CASE: or_pattern_in_let_Parse ===
//! expect: unexpected token
enum Opt { None, Some(int) }
fn main() {
    let v = Opt::Some(1)
    let Opt::Some(x) | Opt::None = v else {
        return
    }
}

//=== TEST CASE: guard_in_let_Parse ===
//! expect: expected
enum Opt { None, Some(int) }
fn main() {
    let v = Opt::Some(1)
    let Opt::Some(x) if x > 0 = v else {
        return
    }
    print(x)
}
