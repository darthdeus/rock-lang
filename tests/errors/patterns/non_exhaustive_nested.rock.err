//! Error: exhaustiveness looks inside compound patterns. Tuple elements,
//!        enum payloads, record and struct fields and nullable values are
//!        checked together, so a value whose parts are each matched by some
//!        arm, but not all by the same arm, is still reported as missing.
//!        Without the check such a value reached the unreachable fallthrough
//!        block at runtime.
//! Tags: patterns, match, exhaustiveness, tuples, enums

//=== TEST CASE: tuple_int_columns_NonExhaustive ===
//! expect: Non-exhaustive match expression. Missing patterns:
//! expect: `(1.., 5..)`
fn f(a: int, b: int) -> int {
    return match (a, b) {
        (0, x) => x,
        (n, 1..5) => n,
    }
}

fn main() {
    print(f(1, 7))
}

//=== TEST CASE: tuple_bools_NonExhaustive ===
//! expect: Non-exhaustive match expression. Missing patterns: `(true, false)`
fn f(a: bool, b: bool) -> int {
    return match (a, b) {
        (true, true) => 1,
        (false, _) => 2,
    }
}

fn main() {
    print(f(true, false))
}

//=== TEST CASE: tuple_enums_NonExhaustive ===
//! expect: Non-exhaustive match expression. Missing patterns: `(C::R, C::G)`
enum C { R, G }

fn f(a: C, b: C) -> int {
    return match (a, b) {
        (C::R, C::R) => 1,
        (C::G, _) => 2,
    }
}

fn main() {
    print(f(C::R, C::G))
}

//=== TEST CASE: enum_payload_int_NonExhaustive ===
//! expect: Non-exhaustive match expression. Missing patterns: `Option::Some(..=-1)`, `Option::Some(1..)`
enum Option<T> { None, Some(T) }

fn f(o: Option<int>) -> int {
    return match o {
        Option::Some(0) => 1,
        Option::None => 2,
    }
}

fn main() {
    print(f(Option::Some(5)))
}

//=== TEST CASE: enum_tuple_payload_NonExhaustive ===
//! expect: Missing patterns: `Shape::Rect(..=-1, ..=0)`, `Shape::Rect(1.., ..=0)`
enum Shape { Circle(int), Rect(int, int) }

fn f(s: Shape) -> int {
    return match s {
        Shape::Circle(r) => r,
        Shape::Rect(0, h) => h,
        Shape::Rect(w, 1..) => w,
    }
}

fn main() {
    print(f(Shape::Rect(3, -1)))
}

//=== TEST CASE: nested_tuple_NonExhaustive ===
//! expect: Missing patterns: `((..=-1, true), _)`, `((1.., true), _)`
fn f(p: ((int, bool), int)) -> int {
    return match p {
        ((0, true), _) => 1,
        ((_, false), _) => 2,
    }
}

fn main() {
    print(f(((1, true), 0)))
}

//=== TEST CASE: enum_in_enum_payload_NonExhaustive ===
//! expect: Missing patterns: `Outer::Wrap(Inner::B)`
enum Inner { A, B }
enum Outer { Empty, Wrap(Inner) }

fn f(o: Outer) -> int {
    return match o {
        Outer::Empty => 0,
        Outer::Wrap(Inner::A) => 1,
    }
}

fn main() {
    print(f(Outer::Wrap(Inner::B)))
}

//=== TEST CASE: bool_NonExhaustive ===
//! expect: Non-exhaustive match expression. Missing patterns: `false`
fn f(a: bool) -> int {
    return match a {
        true => 1,
    }
}

fn main() {
    print(f(false))
}

//=== TEST CASE: string_literals_NonExhaustive ===
//! expect: Non-exhaustive match expression. Missing patterns: `_`
fn f(s: string) -> int {
    return match s {
        "a" => 1,
        "b" => 2,
    }
}

fn main() {
    print(f("c"))
}

//=== TEST CASE: float_literals_NonExhaustive ===
//! expect: Non-exhaustive match expression. Missing patterns: `_`
fn f(x: float) -> int {
    return match x {
        1.0 => 1,
        2.0 => 2,
    }
}

fn main() {
    print(f(3.0))
}

//=== TEST CASE: string_in_tuple_NonExhaustive ===
//! expect: Missing patterns: `(_, false)`
fn f(s: string, b: bool) -> int {
    return match (s, b) {
        ("a", _) => 1,
        (_, true) => 2,
    }
}

fn main() {
    print(f("z", false))
}

//=== TEST CASE: record_variant_field_NonExhaustive ===
//! expect: Missing patterns: `Shape::Circle { r: ..=-1 }`, `Shape::Circle { r: 1.. }`
enum Shape { Circle { r: int }, Square { s: int } }

fn f(s: Shape) -> int {
    return match s {
        Shape::Circle { r: 0 } => 0,
        Shape::Square { s } => s,
    }
}

fn main() {
    print(f(Shape::Circle { r: 2 }))
}

//=== TEST CASE: struct_field_NonExhaustive ===
//! expect: Missing patterns: `Point { x: ..=-1, .. }`, `Point { x: 1.., .. }`
struct Point { x: int, y: int }

fn f(p: Point) -> int {
    return match p {
        Point { x: 0, y } => y,
    }
}

fn main() {
    print(f(Point { x: 1, y: 2 }))
}

//=== TEST CASE: nullable_NonExhaustive ===
//! expect: Missing patterns: `null`, `..=4`, `6..`
fn f(a: int?) -> int {
    return match a {
        5 => 1,
    }
}

fn main() {
    print(f(null))
}

//=== TEST CASE: guarded_tuple_arm_does_not_cover_NonExhaustive ===
//! expect: Missing patterns: `(false, _)`
fn f(a: bool, b: int) -> int {
    return match (a, b) {
        (true, _) => 1,
        (false, n) if n > 0 => 2,
    }
}

fn main() {
    print(f(false, -1))
}

//=== TEST CASE: or_pattern_of_tuples_NonExhaustive ===
//! expect: Missing patterns: `(false, false)`, `(true, false)`
fn f(a: bool, b: bool) -> int {
    return match (a, b) {
        (true, true) | (false, true) => 1,
    }
}

fn main() {
    print(f(true, false))
}

//=== TEST CASE: missing_patterns_capped_NonExhaustive ===
//! expect: Missing patterns: `..=-1`, `1`, `3`, `5`, `7`, `9`, `11`, `13`, `15`, `17` and more
fn f(x: int) -> int {
    return match x {
        0 => 0, 2 => 2, 4 => 4, 6 => 6, 8 => 8, 10 => 10,
        12 => 12, 14 => 14, 16 => 16, 18 => 18, 20 => 20,
    }
}

fn main() {
    print(f(1))
}
