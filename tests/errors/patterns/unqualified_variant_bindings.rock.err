//! Error: a bare uppercase name against an enum scrutinee is a variant test
//! Tags: patterns, enums

// `match` has always read an uppercase arm name as a variant (and rejected a
// typo'd one). The same rule now applies to every pattern position, so an
// `if let`/`while let` typo cannot silently become a catch-all, and a plain
// `let` cannot bind a name that compiles as a never-bound tag test.

//=== TEST CASE: if_let_variant_typo_Generic ===
//! expect: has no variant `Rde`
enum Color { Red, Green, Blue }
fn main() {
    let c = Color::Blue
    if let Rde = c {
        print("oops")
    }
}

//=== TEST CASE: while_let_variant_typo_Generic ===
//! expect: has no variant `Grene`
enum Color { Red, Green, Blue }
fn f(c: Color?) {
    while let Grene = c {
        break
    }
}
fn main() {}

//=== TEST CASE: let_variant_tag_is_refutable_Refutable ===
//! expect: can fail
enum Color { Red, Green, Blue }
fn main() {
    let c = Color::Blue
    let Red = c
}

//=== TEST CASE: let_else_variant_typo_Generic ===
//! expect: has no variant `Blu`
enum Color { Red, Green, Blue }
fn f(c: Color) -> int {
    let Blu = c else {
        return 0
    }
    1
}
fn main() {}
