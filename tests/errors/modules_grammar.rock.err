//! Error: module grammar rejections.

//=== TEST CASE: misplaced_mod_header_rejects ===
//! expect: `mod path;` is a file header and must be the file's first item
fn main() {
    print("hi")
}

mod combat;

//=== TEST CASE: second_mod_header_rejects ===
//! expect: a file has one `mod path;` header
mod combat;
mod casting;

fn main() {
    print("hi")
}

//=== TEST CASE: use_as_underscore_rejects ===
//! expect: `use ... as _` has no activation semantics in modules-v1
use stone::engine as _;

fn main() {
    print("hi")
}

//=== TEST CASE: private_set_on_item_rejects ===
//! expect: `private(set)` applies to stored struct fields, not to items
private(set) fn main() {
    print("hi")
}

//=== TEST CASE: macro_generated_module_item_rejects ===
//! expect: macro-generated `mod`/`use` is not supported
macro emit_use() {
    use stone::engine::State;
}

emit_use()

fn main() {
    print("hi")
}
