//=== TEST CASE: nested_path_Generic ===
//! expect: the receiver path may have only one segment (`Type.name`)
// A second dot-separated receiver segment is rejected; this is not a
// check of module-qualified `lib::Type.method` syntax.
struct Mob { hp: int }
fn Mob.Sub.foo(m) -> int {
    return 0
}
fn main() {}

//=== TEST CASE: unknown_receiver_type_Unknown ===
//! expect: `Ghost` did not resolve to any definition
// Not a parse error -- desugars, then bone rejects the unknown param type.
fn Ghost.haunt(g) -> int {
    return 0
}
fn main() {}

//=== TEST CASE: nested_fn_reads_enclosing_param_Generic ===
//! expect: nested function may not read enclosing local `threshold`
// A hoisted nested fn lives at module scope -- the enclosing param does not
// exist there. Reading it is a compile error.
fn outer(threshold: int) -> int {
    fn keep(x: int) -> bool { x > threshold }
    return if keep(5) { 1 } else { 0 }
}
fn main() { let _ = outer(3) }

//=== TEST CASE: nested_fn_reads_enclosing_local_Generic ===
//! expect: nested function may not read enclosing local `bonus`
// Same rule for an enclosing local.
fn outer() -> int {
    let bonus = 10
    fn add(x: int) -> int { x + bonus }
    return add(5)
}
fn main() { let _ = outer() }

//=== TEST CASE: nested_fn_with_generics_Generic ===
//! expect: nested functions cannot be generic
// v1: no generics on nested fns.
fn outer() -> int {
    fn id<T>(x: T) -> T { x }
    return id(7)
}
fn main() { let _ = outer() }

//=== TEST CASE: nested_fn_with_annotation_Generic ===
//! expect: nested functions cannot have annotations
// v1: no annotations on nested fns.
fn outer() -> int {
    @pure
    fn inc(x: int) -> int { x + 1 }
    return inc(7)
}
fn main() { let _ = outer() }

//=== TEST CASE: nested_fn_forward_reference_Generic ===
//! expect: `later` did not resolve to any definition
// v1 decl-before-use: calling a nested fn before its declaration does not
// resolve (there is no like-named top-level fn).
fn outer() -> int {
    let r = later(5)
    fn later(x: int) -> int { x + 1 }
    return r
}
fn main() { let _ = outer() }

//=== TEST CASE: nested_fn_out_of_scope_Generic ===
//! expect: `helper` did not resolve to any definition
// A nested fn is block-scoped (privacy is a property): calling it outside the
// block it is declared in does not resolve.
fn outer() -> int {
    {
        fn helper(x: int) -> int { x + 1 }
        let _ = helper(1)
    }
    return helper(2)
}
fn main() { let _ = outer() }

//=== TEST CASE: nested_fn_mutual_recursion_Generic ===
//! expect: `is_odd` did not resolve to any definition
// v1 decl-before-use forbids mutual recursion: `is_even` calls `is_odd` before
// it is declared.
fn parity(n: int) -> bool {
    fn is_even(k: int) -> bool { if k == 0 { return true }  return is_odd(k - 1) }
    fn is_odd(k: int) -> bool { if k == 0 { return false }  return is_even(k - 1) }
    return is_even(n)
}
fn main() { let _ = parity(4) }

//=== TEST CASE: nested_fn_reads_enclosing_param_in_format_spec_Generic ===
//! expect: nested function may not read enclosing local `digits`
// A read in an interpolation's dynamic precision is a read like any other.
fn outer(digits: int) -> string {
    fn show(x: float) -> string { "{x:.{digits}f}" }
    return show(1.5)
}
fn main() { let _ = outer(2) }

//=== TEST CASE: field_ref_picked_slot_not_fieldref_Generic ===
struct Mob { health: int }

fn probe(a: int, b: int) -> int { return a + b }
fn probe(a: string, b: int) -> int { return b }

fn main() {
    let m = Mob { health: 1 }
    let r = probe(1, .health)
    print("{r}")
}

//=== TEST CASE: inline_lua_arg_typechecked_Generic ===
// the declared signature is still enforced at the call site.
//! expect: type mismatch: expected `int`, found `bool`
inline(lua) fn myadd(x: int, y: int) -> int = "return x + y"
fn f() -> int {
    let r = myadd(1, true)
    r
}

//=== TEST CASE: polymorphic_recursion ===
fn rec<T>(x: T, n: int) -> int {
    if n <= 0 { return 0 }
    return rec([x], n - 1)
}

fn main() {
    print("{rec(1, 3)}")
}

