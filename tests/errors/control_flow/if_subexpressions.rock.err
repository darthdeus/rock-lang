//! Error: Control flow statements in if-expression subexpressions
//! Tags: control-flow, if-expressions, restrictions

//=== TEST CASE: continue_in_multi_assign_rhs_ControlFlowInSubexpression ===
//! expect: control flow (return/break/continue) is not allowed in an `if` used as a tuple element of a destructuring assignment
fn test() {
    for i in 0..10 {
        let (x, y) = (1, if i > 5 { continue } else { i })
    }
}

//=== TEST CASE: break_in_multi_assign_rhs_ControlFlowInSubexpression ===
//! expect: control flow (return/break/continue) is not allowed in an `if` used as a tuple element of a destructuring assignment
fn test() {
    for i in 0..10 {
        let (x, y) = (1, if i > 5 { break } else { i })
    }
}

//=== TEST CASE: return_in_multi_assign_rhs_ControlFlowInSubexpression ===
//! expect: control flow (return/break/continue) is not allowed in an `if` used as a tuple element of a destructuring assignment
fn test() {
    let (x, y) = (1, if true { return } else { 42 })
}

//=== TEST CASE: if_without_else_with_continue_MissingElseBranch ===
//! expect: `if` without a final `else` cannot be used as a value
fn test() {
    for i in 0..10 {
        let x = if i > 5 { continue }
    }
}

//=== TEST CASE: if_without_else_with_break_MissingElseBranch ===
//! expect: `if` without a final `else` cannot be used as a value
fn test() {
    for i in 0..10 {
        let x = if i > 5 { break }
    }
}

//=== TEST CASE: if_without_else_with_return_MissingElseBranch ===
//! expect: `if` without a final `else` cannot be used as a value
fn test() {
    let x = if true { return }
}

//=== TEST CASE: continue_not_in_loop_InvalidContinue ===
//! expect: `break`/`continue` is only valid inside a loop body
fn test() {
    if true { continue } else { 42 }
}

//=== TEST CASE: break_not_in_loop_InvalidBreak ===
//! expect: `break`/`continue` is only valid inside a loop body
fn test() {
    if true { break } else { 42 }
}
