//! Error: Control flow statements in if-expression subexpressions
//! Tags: control-flow, if-expressions, restrictions

//=== TEST CASE: continue_in_multi_assign_rhs_ControlFlowInSubexpression ===
fn test() {
    for i in 0..10 {
        let (x, y) = (1, if i > 5 { continue } else { i })
    }
}

//=== TEST CASE: break_in_multi_assign_rhs_ControlFlowInSubexpression ===
fn test() {
    for i in 0..10 {
        let (x, y) = (1, if i > 5 { break } else { i })
    }
}

//=== TEST CASE: return_in_multi_assign_rhs_ControlFlowInSubexpression ===
fn test() {
    let (x, y) = (1, if true { return } else { 42 })
}

