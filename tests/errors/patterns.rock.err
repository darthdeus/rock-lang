}

//=== TEST CASE: guarded_range_does_not_cover_NonExhaustive ===
//! expect: Missing patterns: `..=-1`
fn main() {
    let x = -3
    let flag = false
    let result = match x {
        ..=-1 if flag => "negative"
        0.. => "non-negative"
    }
    print(result)
}

