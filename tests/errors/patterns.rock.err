//=== TEST CASE: duplicate_wildcard_DuplicatePattern ===
//! expect: duplicate wildcard pattern in match expression - only one unguarded `_` arm is allowed
fn test() -> int {
    let t = 1
    match t {
        0 => 10
        1 => 20
        _ => 30
        _ => 40  // Duplicate wildcard - should be an error!
    }
}

fn main() {
    test()
}

//=== TEST CASE: missing_plain_variant_NonExhaustive ===
//! expect: Non-exhaustive match expression. Missing patterns: Blue
enum Color { Red, Green, Blue }

fn main() {
    let color = Color::Red
    let name = match color {
        Color::Red => "red",
        Color::Green => "green"
    }
    print(name)
}

//=== TEST CASE: missing_generic_variant_NonExhaustive ===
//! expect: Non-exhaustive match expression. Missing patterns: None
enum Option<T> {
    None,
    Some(T),
}

fn main() {
    let opt: Option<int> = Option::Some(42)
    let value = match opt {
        Option::Some(n) => n
    }
    print("{value}")
}

