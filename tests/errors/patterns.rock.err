}

//=== TEST CASE: let_else_variant_typo_Generic ===
//! expect: has no variant `Blu`
enum Color { Red, Green, Blue }
fn f(c: Color) -> int {
    let Blu = c else {
        return 0
    }
    1
}
fn main() {}

//=== TEST CASE: comment_inside_pattern_Parse ===
//! expect: a comment cannot appear inside a pattern
struct P { x: int, y: int }
fn main() {
    let p = P { x: 1, y: 2 }
    let P { x, /* mid */ y } = p
    print(x + y)
}

//=== TEST CASE: unqualified_variant_arm_does_not_catch_all ===
//! expect: Non-exhaustive match expression. Missing patterns: B
enum Choice { A, B }

fn f(c: Choice) -> int {
    match c {
        A => 1   // ERROR: `B` is uncovered; a bare `A` is a tag test, not a catch-all
    }
}

fn main() {
    print("{f(Choice::B)}")
}

//=== TEST CASE: non_exhaustive_empty_Generic ===
