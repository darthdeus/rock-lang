}

//=== TEST CASE: missing_patterns_capped_NonExhaustive ===
//! expect: Missing patterns: `..=-1`, `1`, `3`, `5`, `7`, `9`, `11`, `13`, `15`, `17` and more
fn f(x: int) -> int {
    return match x {
        0 => 0, 2 => 2, 4 => 4, 6 => 6, 8 => 8, 10 => 10,
        12 => 12, 14 => 14, 16 => 16, 18 => 18, 20 => 20,
    }
}

fn main() {
    print(f(1))
}

//=== TEST CASE: struct_destructure_unknown_field_Generic ===
struct P { x: int }

fn f(p: P) -> int {
    //! expect: struct `P` has no field `z`
    match p {
        P { z } => return z
    }
    return 0
}

fn main() { print(f(P { x: 1 })) }

//=== TEST CASE: record_variant_other_variants_field_Generic ===
enum E { A { a: int }, B { b: int } }

fn g(e: E) -> int {
    //! expect: record variant `A` has no field `b`
    match e {
        E::A { b } => return b,
        E::B { b } => return b,
    }
    return 0
}

fn main() { print(g(E::A { a: 1 })) }

//=== TEST CASE: unqualified_unknown_variant_rejected ===
//! expect: enum `Choice` has no variant `Nope`
enum Choice { A, B }

fn f(c: Choice) -> int {
    match c {
        A => 1
        Nope => 2   // ERROR: `Nope` is not a variant of `Choice`
    }
}

fn main() {
    print("{f(Choice::A)}")
}

