enum Sig { Idle, Num(int) }
fn f(s: Sig?) -> int {
    match s {
        Sig::Idle => 0,
        Sig::Num(x) => x,
    }
}
fn main() {}

//=== TEST CASE: match_arm_mismatch_Generic ===
//! expect: type mismatch: expected `int`, found `string`
enum Color { Red, Green, Blue }
fn f(c: Color) -> int {
    let r = match c {
        Color::Red => 1,
        _ => "no",
    }
    r
}

//=== TEST CASE: or_binding_rejected_Generic ===
//! expect: or-patterns cannot bind variables, use `_` for payload
enum E { A(int), B(int) }
fn f(e: E) -> int {
    match e { A(x) | B(x) => x }
}

//=== TEST CASE: or_mixed_literal_rejected_Generic ===
//! expect: type mismatch: expected `int`, found `string`
fn f(n: int) -> string {
    match n { 1 | "two" => "x", _ => "y" }
}

//=== TEST CASE: tuple_on_non_tuple_rejected_Generic ===
//! expect: expected a tuple type in pattern, got int
fn f(n: int) -> int {
    match n { (a, b) => a, _ => 0 }
}

//=== TEST CASE: tuple_arity_mismatch_rejected_Generic ===
//! expect: tuple pattern expected 2 elements, but got 3
fn f(p: (int, int)) -> int {
    match p { (a, b, c) => a, _ => 0 }
}

//=== TEST CASE: no_condition_chain_Parse ===
//! expect: expected OpenCurly, got And
fn main() {
    let v: int? = 1
    while let x = v && x > 0 {
        break
    }
}

//=== TEST CASE: irrefutable_non_nullable_Useless ===
// A `while let` pattern that cannot miss is an infinite loop.
//! expect: never runs
fn main() {
    while let x = 5 {
        print(x)
        break
    }
}

//=== TEST CASE: arity_mismatch_too_many_Generic ===
//! expect: newtype pattern `UserId` takes exactly one argument
newtype UserId(int)

fn main() {
    let user_id = UserId(42)
    let UserId(a, b) = user_id
    print(a)
}

//=== TEST CASE: nested_arity_mismatch_Generic ===
//! expect: expected 2 subpatterns, but got 1
enum Pair { Two(int, int) }
newtype Wrap(Pair)

fn main() {
    let w = Wrap(Pair::Two(1, 2))
    let Wrap(Two(x)) = w
    print(x)
}

//=== TEST CASE: destructure_struct_with_newtype_Generic ===
//! expect: cannot destructure this value with newtype pattern `UserId` - the value is not a newtype `UserId`
newtype UserId(int)

struct User {
    id: int,
    name: string,
}

fn main() {
    let user = User { id: 42, name: "Alice" }
    let UserId(x) = user
    print(x)
}
