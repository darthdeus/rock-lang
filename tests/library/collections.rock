// Stdlib collection calls on vecs and maps: push/set/pop, insert/remove/get,
// contains/len/clear, to_array, map and filter with inferred lambda params,
// the unified `.get(key) -> T?` accessor (null on miss), enumerate, nested
// collections, nullable map values, iteration stability, growth to 100 keys
// and special-character keys; plus the assert_* family.

@test(output = "hi\nbye\nfoo\nfoo\nbye\nlen: 0")
fn vector_insert_and_lookup() {
    let v = vec_new()

    vec_push(v, "hi")
    print(vec_get(v, 0))

    vec_set(v, 0, "bye")
    vec_push(v, "foo")
    print(vec_get(v, 0))
    print(vec_get(v, 1))

    let a = pop(v)
    let b = pop(v)
    let _c = pop(v)

    print(a)
    print(b)
    print("len: {vec_len(v)}")
}

@test(output = "100\n100\ntrue\nVec {{ }}\nVec {{ {{ \"hp\", 100 }} }}\nVec {{ {{ \"hp\", 150 }} }}")
fn map_insert_remove_and_to_array() {
    let m: Map<string, int> = map_new()
    insert(m, "hp", 100)
    print(get(m, "hp"))
    print(remove(m, "hp"))
    print(get(m, "hp") == null)
    let empty: Map<int, string> = map_new()
    print(inspect(to_array(empty)))
    insert(m, "hp", 100)
    print(inspect(to_array(m)))
    insert(m, "hp", 150)
    print(inspect(to_array(m)))
}

@test(output = "0\nfalse\ntrue\nfalse\n2\n0")
fn contains_len_and_clear() {
    let empty: Map<int, string> = map_new()
    print(empty.len())
    print(empty.contains(42))

    let m: Map<string, int> = map_new()
    insert(m, "a", 1)
    insert(m, "b", 2)
    print(m.contains("a"))
    print(m.contains("c"))
    print(m.len())
    clear(m)
    print(m.len())
}

// Unannotated lambda params infer `int` from the receiver.
@test
fn vec_map_and_filter() {
    assert_eq([1, 2, 3, 4, 5].iter().map((x) => x * 2).collect(), [2, 4, 6, 8, 10])
    assert_eq([10, 20, 30].iter().map((x) => x + 5).collect(), [15, 25, 35])
    let empty: [int] = vec_new()
    assert(vec_len(empty.iter().map((x) => x * 2).collect()) == 0)

    assert_eq([1, 2, 3, 4, 5, 6].iter().filter((x) => x % 2 == 0).collect(), [2, 4, 6])
    assert(vec_len([1, 3, 5, 7, 9].iter().filter((x) => x % 2 == 0).collect()) == 0)
    assert_eq([2, 4, 6, 8].iter().filter((x) => x % 2 == 0).collect(), [2, 4, 6, 8])
}

@test
fn test_assertion_functions() {
    assert_eq(5, 5, "Five should equal five")
    assert_eq("hello", "hello", "Strings should match")

    assert_ne(5, 10, "Five should not equal ten")
    assert_ne("hello", "world", "Different strings should not be equal")

    assert_true(true, "True should be true")
    assert_true(5 > 3, "5 should be greater than 3")

    assert_false(false, "False should be false")
    assert_false(3 > 5, "3 should not be greater than 5")

    let null_value: int? = null
    assert_null(null_value, "Null value should be null")

    let non_null_value: int? = 42
    assert_not_null(non_null_value, "Non-null value should not be null")

    print("All assertion tests passed!")
}

@test
fn vec_get_ufcs() {
    let v = [10, 20, 30]
    assert(v.get(0) == 10)
    assert(v.get(1) == 20)
    assert(v.get(2) == 30)
    assert(v.get(3) == null)
    assert(v.get(-1) == null)
}

@test
fn map_get_ufcs() {
    let m: Map<string, int> = map_new()
    insert(m, "hp", 100)
    insert(m, "mp", 50)
    assert(m.get("hp") == 100)
    assert(m.get("mp") == 50)
    assert(m.get("missing") == null)
}

@test
fn get_chains_with_null_coalesce() {
    let v = [10, 20, 30]
    let m: Map<string, int> = map_new()
    insert(m, "answer", 42)

    let x = v.get(100) ?? -1
    assert(x == -1)

    let y = m.get("answer") ?? 0
    assert(y == 42)

    let z = m.get("missing") ?? 0
    assert(z == 0)
}

@test
fn test_array_operations() {
    let numbers = [10, 20, 30, 40, 50]

    assert $ vec_len(numbers) == 5
    assert $ numbers[0] == 10
    assert $ numbers[4] == 50

    let sum = 0
    let index_sum = 0
    for (i, num) in enumerate(numbers) {
        sum = sum + num
        index_sum = index_sum + i
    }
    assert sum == 150
    assert index_sum == 10
}

struct Room {
    name: string,
    items: [string],
    connections: Map<string, string>,
}

@test
fn test_complex_nested_structures() {
    let dungeon: Map<string, Room> = map_new()

    let items1 = ["sword", "key"]
    let connections1: Map<string, string> = map_new()
    insert(connections1, "north", "room2")
    insert(connections1, "east", "room3")

    insert(dungeon, "room1", Room {
        name: "Starting Room",
        items: items1,
        connections: connections1
    })

    let items2 = ["potion", "gold"]
    let connections2: Map<string, string> = map_new()
    insert(connections2, "south", "room1")

    insert(dungeon, "room2", Room {
        name: "Treasure Room",
        items: items2,
        connections: connections2
    })

    let total_rooms = 0
    let total_items = 0
    let total_connections = 0

    for (room_id, room) in dungeon {
        total_rooms = total_rooms + 1
        total_items = total_items + vec_len(room.items)

        for (direction, target) in room.connections {
            total_connections = total_connections + 1
        }
    }

    assert total_rooms == 2
    assert total_items == 4
    assert total_connections == 3
}

// Inserting null removes the key on Lua, so only present values are stored.
@test
fn test_map_with_nullable_values() {
    let optional_map: Map<string, int?> = map_new()

    insert(optional_map, "has_value", 42)
    insert(optional_map, "zero_value", 0)

    assert $ optional_map.len() == 2

    let non_null_count = 0
    let zero_count = 0

    for (key, value) in optional_map {
        if value == 0 {
            zero_count = zero_count + 1
            assert key == "zero_value"
        } else {
            non_null_count = non_null_count + 1
            assert key == "has_value"
            assert value == 42
        }
    }

    assert non_null_count == 1
    assert zero_count == 1

    assert $ get(optional_map, "no_value") == null
    assert $ get(optional_map, "nonexistent") == null
}

// Map order is unspecified but stable between two walks.
@test
fn test_map_iteration_consistency() {
    let test_map: Map<string, int> = map_new()

    insert(test_map, "z", 1)
    insert(test_map, "a", 2)
    insert(test_map, "m", 3)

    let first_run = ""
    let second_run = ""

    for (key, value) in test_map {
        first_run = first_run + key
    }

    for (key, value) in test_map {
        second_run = second_run + key
    }

    assert first_run == second_run
    assert $ first_run.len() == 3

    assert $ first_run == "zam" || first_run == "zma" || first_run == "azm" || first_run == "amz" || first_run == "mza" || first_run == "maz"
}

@test
fn test_large_collections() {
    let large_map: Map<string, int> = map_new()

    for i in 0..100 {
        let key = "item_" + to_string(i)
        insert(large_map, key, i * 2)
    }

    assert $ large_map.len() == 100

    assert $ get(large_map, "item_0") == 0
    assert $ get(large_map, "item_50") == 100
    assert $ get(large_map, "item_99") == 198

    let count = 0
    let sum = 0

    for (key, value) in large_map {
        count = count + 1
        sum = sum + value

        assert $ key.len() > 5
        assert $ value >= 0
        assert $ value < 200
    }

    assert count == 100
    assert sum == 9900
}

// String keys with special characters, including the empty string, round-trip
// through get and iteration.
@test
fn test_special_character_keys() {
    let keys = ["normal", "with spaces", "with-dashes", "with_underscores", "with.dots", "123numbers", "UPPERCASE", ""]
    let m: Map<string, int> = map_new()
    for (i, k) in enumerate(keys) {
        insert(m, k, i + 1)
    }
    assert $ m.len() == 8
    for (i, k) in enumerate(keys) {
        assert $ get(m, k) == i + 1
    }

    let seen = 0
    let total = 0
    for (k, v) in m {
        assert $ keys[v - 1] == k
        seen = seen + 1
        total = total + v
    }
    assert seen == 8
    assert total == 36
}
