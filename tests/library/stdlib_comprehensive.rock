// Assertions, math and general stdlib calls.

@test(output = "hi\nbye\nfoo\nfoo\nbye\nlen: 0")
fn vector_insert_and_lookup() {
    let v = vec_new()

    vec_push(v, "hi")
    print(vec_get(v, 0))

    vec_set(v, 0, "bye")
    vec_push(v, "foo")
    print(vec_get(v, 0))
    print(vec_get(v, 1))

    let a = pop(v)
    let b = pop(v)
    let _c = pop(v)

    print(a)
    print(b)
    print("len: {vec_len(v)}")
}

@test(output = "100\n100\ntrue\nVec {{ }}\nVec {{ {{ \"hp\", 100 }} }}\nVec {{ {{ \"hp\", 150 }} }}")
fn map_insert_remove_and_to_array() {
    let m: Map<string, int> = map_new()
    insert(m, "hp", 100)
    print(get(m, "hp"))
    print(remove(m, "hp"))
    print(get(m, "hp") == null)
    let empty: Map<int, string> = map_new()
    print(inspect(to_array(empty)))
    insert(m, "hp", 100)
    print(inspect(to_array(m)))
    insert(m, "hp", 150)
    print(inspect(to_array(m)))
}

@test(output = "0\nfalse\ntrue\nfalse\n2\n0")
fn contains_len_and_clear() {
    let empty: Map<int, string> = map_new()
    print(empty.len())
    print(empty.contains(42))

    let m: Map<string, int> = map_new()
    insert(m, "a", 1)
    insert(m, "b", 2)
    print(m.contains("a"))
    print(m.contains("c"))
    print(m.len())
    clear(m)
    print(m.len())
}

// Unannotated lambda params infer `int` from the receiver.
@test
fn vec_map_and_filter() {
    assert_eq([1, 2, 3, 4, 5].iter().map((x) => x * 2).collect(), [2, 4, 6, 8, 10])
    assert_eq([10, 20, 30].iter().map((x) => x + 5).collect(), [15, 25, 35])
    let empty: [int] = vec_new()
    assert(vec_len(empty.iter().map((x) => x * 2).collect()) == 0)

    assert_eq([1, 2, 3, 4, 5, 6].iter().filter((x) => x % 2 == 0).collect(), [2, 4, 6])
    assert(vec_len([1, 3, 5, 7, 9].iter().filter((x) => x % 2 == 0).collect()) == 0)
    assert_eq([2, 4, 6, 8].iter().filter((x) => x % 2 == 0).collect(), [2, 4, 6, 8])
}

@test
fn test_assertion_functions() {
    assert_eq(5, 5, "Five should equal five")
    assert_eq("hello", "hello", "Strings should match")
    
    assert_ne(5, 10, "Five should not equal ten")
    assert_ne("hello", "world", "Different strings should not be equal")
    
    assert_true(true, "True should be true")
    assert_true(5 > 3, "5 should be greater than 3")
    
    assert_false(false, "False should be false")
    assert_false(3 > 5, "3 should not be greater than 5")
    
    let null_value: int? = null
    assert_null(null_value, "Null value should be null")
    
    let non_null_value: int? = 42
    assert_not_null(non_null_value, "Non-null value should not be null")
    
    print("All assertion tests passed!")
}

@test
fn test_integer_arithmetic() {
    assert_eq(1 + 1, 2)
    assert_eq(5 - 3, 2)
    assert_eq(4 * 3, 12)
    assert_eq(10 ./ 2, 5)

    assert_eq(2 + 3 * 4, 14)
    assert_eq((2 + 3) * 4, 20)
    assert_eq(10 - 2 * 3, 4)

    assert_eq(-5 + 3, -2)
    assert_eq(-5 * -5, 25)
    assert_eq(10 + -5, 5)

    assert_eq(10 % 3, 1)
    assert_eq(20 % 4, 0)
    assert_eq(17 % 5, 2)

    assert_eq(1000 * 1000, 1000000)
    assert_eq(999999 + 1, 1000000)
}
