// Integer arithmetic: operators, precedence, negatives, modulo and large values.

@test
fn test_integer_arithmetic() {
    assert_eq(1 + 1, 2)
    assert_eq(5 - 3, 2)
    assert_eq(4 * 3, 12)
    assert_eq(10 ./ 2, 5)

    assert_eq(2 + 3 * 4, 14)
    assert_eq((2 + 3) * 4, 20)
    assert_eq(10 - 2 * 3, 4)

    assert_eq(-5 + 3, -2)
    assert_eq(-5 * -5, 25)
    assert_eq(10 + -5, 5)

    assert_eq(10 % 3, 1)
    assert_eq(20 % 4, 0)
    assert_eq(17 % 5, 2)

    assert_eq(1000 * 1000, 1000000)
    assert_eq(999999 + 1, 1000000)
}
