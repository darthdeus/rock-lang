// log_once called from a top-level global initializer. User global
// initializers can run before the stdlib's log-level global is set, so
// log_once's lazy init must not read it uninitialized. Kept in its own file:
// a failure here aborts module load, which would take down every other test
// in the file.

global startup_log_count: int = {
    log_once("INIT_TEST", "from global initializer", "global-init-key")
    1
}

@test
fn test_log_once_from_global_initializer_doesnt_crash() {
    // If this @test runs at all, module load did not crash on log_once.
    assert(startup_log_count == 1)
}
