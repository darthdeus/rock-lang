// ffi_out_int() / ffi_out_float() return raw single-element LuaJIT ffi
// cdata typed as Ptr<int> / Ptr<float>. .read() dispatches on the Ptr<T>
// phantom — no wrapper struct.

inline(lua) fn _poke_int(buf: any, v: int) = "buf[0] = v"
inline(lua) fn _poke_float(buf: any, v: float) = "buf[0] = v"

@test
fn int_out_roundtrip() {
    let out = ffi_out_int()
    _poke_int(out, 42)
    assert(out.read() == 42)
}

@test
fn float_out_roundtrip() {
    let out = ffi_out_float()
    _poke_float(out, 3.25)
    assert(out.read() == 3.25)
}
