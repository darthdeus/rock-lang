// JS runtime helpers: deepcopy, put and try_call.

struct Inner { v: int }

struct State { a: Inner, b: Inner }

// A shared inner struct copies ONCE: mutating via `a` shows through `b`; the
// original is untouched.
@test(output = "99\n99\n1")
fn shared_ref_copies_once() {
    let inner = Inner { v: 1 }
    let s = State { a: inner, b: inner }
    let c = deepcopy(s)
    c.a.v = 99
    print(c.a.v)
    print(c.b.v)
    print(s.a.v)
}

struct Node { tag: int, next: Node? }

// A self-referential struct copies without hanging; the copy's cycle points
// into the COPY.
@test(output = "5\n5\n1")
fn cycle_copies_without_hanging() {
    let n = Node { tag: 1, next: null }
    n.next = n
    let c = deepcopy(n)
    c.tag = 5
    print(c.tag)
    if c.next != null {
        print(c.next.tag)
    }
    print(n.tag)
}

// A deep-copied Vec, and the vecs nested in it, are independent of the
// original.
@test(output = "10\n1\n1\n99")
fn vec_copy_is_independent() {
    let v = [1, 2, 3]
    let c = deepcopy(v)
    c.set(0, 10)
    print(c[0])
    print(v[0])
    let orig = [[1], [2]]
    let nested = deepcopy(orig)
    nested[0][0] = 99
    print(orig[0][0])
    print(nested[0][0])
}

// A deep-copied Map is independent of the original.
@test(output = "20\n2")
fn map_copy_is_independent() {
    let m = map_new()
    m["k"] = 2
    let c = deepcopy(m)
    c["k"] = 20
    print(c["k"])
    print(m["k"])
}

// Primitives pass through unchanged.
@test(output = "42\ntrue\ntrue")
fn primitive_passthrough() {
    print(deepcopy(42))
    print(deepcopy("foo") == "foo")
    print(deepcopy(true))
}

// `clone_into` of a column-stored Vec copies each column; the copy owns them.
@test(returns = 132)
fn clone_into_copies_column_storage() -> int {
    let owner: [int] = []
    let points = [Vec2 { x: 1.0, y: 2.0 }, Vec2 { x: 3.0, y: 4.0 }]
    let copied = points.clone_into(owner.storage)
    points[0] = Vec2 { x: 9.0, y: 10.0 }
    copied.push(Vec2 { x: 5.0, y: 6.0 })
    return int(copied[0].x) * 100 + copied.len() * 10 + points.len()
}

@intrinsic @inline inline(lua) fn put(s: string) = "io.write(s)"

// Bare `put` writes with no separators or newline: three calls -> "abc".
@test(output = "abc")
fn put_no_newline() {
    put("a")
    put("b")
    put("c")
}

// Embedded `\n` from a `put` is preserved (only leading/trailing whitespace is
// trimmed by the harness compare).
@test(output = "x=1\ny=2")
fn put_embedded_newline() {
    put("x=1")
    put("\n")
    put("y=2")
}

// `put` and `print` share one buffer, in call order (`print` adds its newline).
@test(output = "head\ntail")
fn put_and_print_interleave() {
    put("head\n")
    print("tail")
}

@intrinsic @nomangle inline(lua) fn try_call(f: fn()) -> bool = """
    local ok, err = pcall(f)
    return not ok
"""

@test(returns = 1)
fn test_catches_error() -> int {
    if try_call(() => { error("boom") }) { 1 } else { 0 }
}

@test(returns = 0)
fn test_success_is_false() -> int {
    if try_call(() => { let x = 1 + 1 }) { 1 } else { 0 }
}

// An out-of-bounds Vec read throws even when the value is discarded.
@test(returns = 1)
fn test_vec_oob_read_errors() -> int {
    let xs = [1, 2, 3]
    if try_call(() => { let _ = xs[10] }) { 1 } else { 0 }
}

// An in-bounds Vec read does not error.
@test(returns = 0)
fn test_vec_inbounds_ok() -> int {
    let xs = [1, 2, 3]
    if try_call(() => { let _ = xs[0] }) { 1 } else { 0 }
}

// A negative index also throws.
@test(returns = 1)
fn test_vec_negative_errors() -> int {
    let xs = [1, 2, 3]
    if try_call(() => { let _ = xs[-1] }) { 1 } else { 0 }
}
