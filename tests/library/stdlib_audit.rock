// Tests for stdlib audit fixes
// Each section corresponds to one audited stdlib item.

// --- Item 2: PI precision ---

@test
fn test_pi_precision() {
    // With 8-digit PI (3.14159265), sin(PI) ~ 3.58e-9; with full precision
    // ~1.22e-16. Below 1e-10 catches the 8-digit truncation.
    let s = sin(PI)
    assert(abs(s) < 0.0000000001, "sin(PI) should be near zero, got: {s}")
    let pi_str = to_string(PI)
    assert(pi_str.starts_with("3.14159265358"), "PI should have at least 12 correct digits, got: {pi_str}")
}

// --- Item 4: replace % in replacement ---

@test
fn test_string_replace_is_literal() {
    // % is special in gsub replacements (%1 = first capture); replace must
    // treat both the search and the replacement as literal text.
    assert_eq("hello world".replace("world", "100%"), "hello 100%", "Percent in replacement should be literal")
    assert_eq("abc".replace("b", "%1"), "a%1c", "%1 in replacement should be literal")
    assert_eq("a.b.c".replace(".", "-"), "a-b-c", "Dots in search should be literal")
    assert_eq("hello world".replace("world", "rock"), "hello rock")
}

// --- Item 5: __op_eq structural equality ---

struct EqTestPoint { x: int, y: int }

@test
fn test_op_eq() {
    let a = EqTestPoint { x: 1, y: 2 }
    let b = EqTestPoint { x: 1, y: 2 }
    let c = EqTestPoint { x: 3, y: 4 }
    assert_eq(a, b, "Same-valued structs should be equal")
    assert_ne(a, c, "Different structs should not be equal")
    assert_eq(42, 42)
    assert_ne(42, 99)
    assert_eq("hello", "hello")
    assert_ne("hello", "world")
    assert_eq(true, true)
    assert_ne(true, false)
}

// --- Item 13: sort correctness ---

@test
fn test_vec_sort() {
    let v: [int] = vec_new()
    for x in [5, 1, 3, 2, 4] { vec_push(v, x) }
    sort(v, x => x)
    assert_eq(v, [1, 2, 3, 4, 5])
    sort(v, x => -x)
    assert_eq(v, [5, 4, 3, 2, 1], "descending key")
    sort(v, x => -x)
    assert_eq(v, [5, 4, 3, 2, 1], "already sorted")
    let one = [42]
    sort(one, x => x)
    assert_eq(one, [42], "single element")
}

struct SortItem { name: string, priority: int }

@test
fn test_vec_sort_by_field() {
    let v: [SortItem] = vec_new()
    vec_push(v, SortItem { name: "c", priority: 3 })
    vec_push(v, SortItem { name: "a", priority: 1 })
    vec_push(v, SortItem { name: "b", priority: 2 })
    sort(v, x => x.priority)
    assert_eq(v[0].name, "a")
    assert_eq(v[1].name, "b")
    assert_eq(v[2].name, "c")
}

// --- Item 14: find/any/all ---

@test
fn test_vec_find_any_all() {
    let v = [10, 20, 30]
    assert_eq(v.find(x => x > 15).unwrap(), 20)
    assert_null(v.find(x => x > 100))
    assert_true(v.iter().any(x => x == 20))
    assert_false(v.iter().any(x => x == 99))
    let evens = [2, 4, 6]
    assert_true(evens.iter().all(x => x % 2 == 0))
    evens.push(7)
    assert_false(evens.iter().all(x => x % 2 == 0))
    let empty: [int] = vec_new()
    assert_null(empty.find(x => true))
    assert_false(empty.any(x => true))
    assert_true(empty.all(x => false))
}

// --- Item 16: unwrap/expect ---

@test
fn test_unwrap_family() {
    let x: int? = null
    assert_eq(unwrap_or(x, 42), 42)
    let y: int? = 10
    assert_eq(unwrap_or(y, 42), 10)
    assert_eq(unwrap(y), 10)
    assert_eq(expect(y, "should not fail"), 10)
}

// --- Item 1: inspect deduplication ---

struct InspectPoint { x: int, y: int }

@test(output = "InspectPoint {{ x = 1, y = 2 }}\nVec {{ 1, 2, 3 }}\n\"hello\"\n42\nVec {{ }}")
fn test_inspect() {
    print(inspect(InspectPoint { x: 1, y: 2 }))
    let v: [int] = vec_new()
    vec_push(v, 1)
    vec_push(v, 2)
    vec_push(v, 3)
    print(inspect(v))
    print(inspect("hello"))
    print(inspect(42))
    let empty: [int] = vec_new()
    print(inspect(empty))
}

// --- Item 17: __rock_range has an exclusive upper bound ---

@test
fn test_rock_range_exclusive_upper_bound() {
    let r = __rock_range(0, 4)
    assert_eq(vec_len(r), 4, "__rock_range(0, 4) should have 4 elements")
    assert_eq(r[0], 0)
    assert_eq(r[3], 3)
    let one = __rock_range(0, 1)
    assert_eq(vec_len(one), 1, "__rock_range(0, 1) should have 1 element")
    assert_eq(one[0], 0)
}

// --- Item 10: UFCS .len() works uniformly ---

struct LenArenaItem { value: int }

@test
fn test_len_ufcs() {
    let v: [int] = vec_new()
    assert_eq(v.len(), 0)
    vec_push(v, 10)
    vec_push(v, 20)
    vec_push(v, 30)
    assert_eq(v.len(), 3)

    assert_eq("hello".len(), 5)
    assert_eq("".len(), 0)
    assert_eq("a".len(), 1)

    let m: Map<string, int> = map_new()
    assert_eq(m.len(), 0)
    insert(m, "a", 1)
    insert(m, "b", 2)
    assert_eq(m.len(), 2)

    let a: Arena<LenArenaItem> = arena_new()
    assert_eq(a.len(), 0)
    a.insert(LenArenaItem { value: 1 })
    a.insert(LenArenaItem { value: 2 })
    assert_eq(a.len(), 2)
}

// --- Item 18: keys/values sort stability ---

@test
fn test_map_keys_and_values_sorted_by_key() {
    let m: Map<string, int> = map_new()
    insert(m, "cherry", 3)
    insert(m, "apple", 1)
    insert(m, "banana", 2)
    assert_eq(keys(m), ["apple", "banana", "cherry"])
    assert_eq(values(m), [1, 2, 3])

    let im: Map<int, string> = map_new()
    insert(im, 30, "c")
    insert(im, 10, "a")
    insert(im, 20, "b")
    assert_eq(keys(im), [10, 20, 30])
}
