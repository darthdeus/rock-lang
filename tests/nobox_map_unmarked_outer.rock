// The OTHER Map shape that rejects with the same diagnostic sentence: an
// UNMARKED (GC-tier `_vt`) value outer carrying a NULLABLE nobox field, stored
// in a Map. It is not the Map mechanism -- the `_vt` ctor has no
// presence-carrying leaf form -- so this pins which of the two it is.

nobox value NV2 { x: float, y: float }
value Opt { pos: NV2? }

@test fn map_unmarked_outer_with_nullable_nobox_field() {
    let m: Map<string, Opt> = map_new()
    m["a"] = Opt { pos: NV2 { x: 1.0, y: 2.0 } }
    assert_eq(m["a"].pos?.x ?? -1.0, 1.0)
    assert_eq(m["a"].pos?.y ?? -1.0, 2.0)
}

@test fn map_unmarked_outer_absent_field() {
    let m: Map<string, Opt> = map_new()
    m["b"] = Opt { pos: null }
    assert_eq(m["b"].pos?.x ?? -1.0, -1.0)
}
