// Negative: Map<T, T> pattern requires K and V positions to bind the
// same generic T. Map<int, string> arg conflicts.

newtype Diag<T>(Map<T, T>)

@test(expect_failure = true)
fn rejects_map_kv_mismatch() {
    let m: Map<int, string> = map_new()
    m[1] = "x"
    let d = Diag(m)
    print(d.0[1])
}
