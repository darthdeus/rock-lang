// An element read raises on an out-of-range index even when nothing uses the
// value. Column and strided storage share one VecCheckedIndex per element
// access across their leaf reads; dead-code elimination of the leaves must
// not take the check with them.

nobox value Four { a: int, b: int, c: int, d: int }
nobox value Six { a: int, b: int, c: int, d: int, e: int, f: int }
enum Dense { A(int), B(int, int) }

@nomangle inline(lua) fn raises(f: fn()) -> bool = """
    local ok, err = pcall(f)
    return not ok
"""

@test(output = "true true true true true")
fn unused_out_of_range_reads_raise_on_every_tier() {
    let boxed = raises(() => {
        let xs: [int] = [1]
        let _ = xs[5]
    })
    let columns = raises(() => {
        let xs: [Four] = [Four { a: 1, b: 1, c: 1, d: 1 }]
        let _ = xs[5]
    })
    let dense = raises(() => {
        let xs: [Dense] = [Dense::A(1)]
        let _ = xs[5]
    })
    let rows = raises(() => {
        let xs: [Six] = [Six { a: 1, b: 1, c: 1, d: 1, e: 1, f: 1 }]
        let _ = xs[5]
    })
    let field = raises(() => {
        let xs: [Six] = [Six { a: 1, b: 1, c: 1, d: 1, e: 1, f: 1 }]
        let _ = xs[5].a
    })
    print("{boxed} {columns} {dense} {rows} {field}")
}
