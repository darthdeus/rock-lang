// When value structs are copied and when they are shared: demanded, whole-use and descriptor copies, snapshots and nobox branches.

value Detail { kept: int, spare: int }

value Snapshot {
    used: int,
    unused0: int = 0, unused1: int = 0, unused2: int = 0, unused3: int = 0,
    unused4: int = 0, unused5: int = 0, unused6: int = 0, unused7: int = 0,
    child: Detail?, ignored: Detail? = null, notes: [int],
}

struct Holder { snapshot: Snapshot, reads: int = 0, mutations: int = 0 }

fn holder(present: bool) -> Holder {
    return Holder { snapshot: Snapshot { used: 7,
        child: if present { Detail { kept: 11, spare: 13 } } else { null },
        notes: [] } }
}

fn mutate(h: Holder) {
    h.mutations += 1
    h.snapshot.used = 70
    if h.snapshot.child != null { h.snapshot.child.kept = 110 }
}

fn consume(h: Holder) -> int {
    let saved = h.snapshot
    // A local value write requires owning the nullable children.
    saved.used += 1
    mutate(h)
    return saved.used + (saved.child?.kept ?? 0)
}

fn read_only(h: Holder) -> int {
    let saved = h.snapshot
    mutate(h)
    return saved.used + (saved.child?.kept ?? 0)
}

fn produced(h: Holder) -> Holder { h.reads += 1; return h }

fn read_produced(h: Holder) -> int {
    let saved = produced(h).snapshot
    mutate(h)
    return saved.used + (saved.child?.kept ?? 0)
}

@test(output = "19 8 180 19 19\n18 7 18 1")
fn snapshots_keep_their_leaves_before_the_source_mutates() {
    let present = holder(true)
    let absent = holder(false)
    let saved_present = consume(present)
    let saved_absent = consume(absent)
    let ignored = holder(true)
    ignored.snapshot.ignored = Detail { kept: 23, spare: 31 }
    print("{saved_present} {saved_absent} {present.snapshot.used + (present.snapshot.child?.kept ?? 0)} {consume(ignored)} {consume(holder(true))}")
    let a = read_only(holder(true))
    let b = read_only(holder(false))
    let producer = holder(true)
    let c = read_produced(producer)
    print("{a} {b} {c} {producer.reads}")
}

value Pt { x: int, y: int }
value GcH { xs: [int], n: int }
struct Owner { p: Pt, h: GcH }
value NestOuter { xs: [int], p: Pt }
struct NestOwner { g: NestOuter }

fn mk_owner(seed: int) -> Owner {
    return Owner { p: Pt { x: seed, y: seed }, h: GcH { xs: [seed], n: seed } }
}

fn owner_identity(o: Owner) -> Owner { return o }
fn mk_pt(seed: int) -> Pt { return Pt { x: seed, y: seed } }
fn mk_gc(seed: int) -> GcH { return GcH { xs: [seed], n: seed } }
fn ident_pt(p: Pt) -> Pt { return p }

fn mk_nest(seed: int) -> NestOwner {
    return NestOwner { g: NestOuter { xs: [seed], p: Pt { x: seed, y: seed } } }
}

global G_OWNER: Owner = mk_owner(1)
global G_PT: Pt = mk_pt(1)
global G_GC: GcH = mk_gc(1)

// Both tiers; a nested value is copied through its leaves, a reference leaf is shared.
@test(output = "1 99 1 99\n1 77 1 77\n1 55 1 55\n1 99\n1 99 7 7\n1 99")
fn whole_value_reads_copy() {
    let o = mk_owner(1)
    let copy = o.p
    let stored = Owner { p: owner_identity(o).p, h: o.h }
    o.p.x = 99
    assert_eq(stored.p.x, 1)
    let og = mk_owner(1)
    let copy_gc = og.h
    let stored_gc = Owner { p: og.p, h: owner_identity(og).h }
    og.h.n = 99
    assert_eq(stored_gc.h.n, 1)
    print("{copy.x} {o.p.x} {copy_gc.n} {og.h.n}")

    let gp = G_OWNER.p
    G_OWNER.p.x = 77
    let gh = G_OWNER.h
    G_OWNER.h.n = 77
    print("{gp.x} {G_OWNER.p.x} {gh.n} {G_OWNER.h.n}")

    let bp = G_PT
    G_PT.x = 55
    let bg = G_GC
    G_GC.n = 55
    print("{bp.x} {G_PT.x} {bg.n} {G_GC.n}")

    let v: [GcH] = [mk_gc(1)]
    let elem = v[0]
    v[0].n = 99
    print("{elem.n} {v[0].n}")

    let nest = mk_nest(1)
    let nest_copy = nest.g
    nest.g.p.x = 99
    let shared = mk_nest(1)
    let shared_copy = shared.g
    shared.g.xs[0] = 7
    print("{nest_copy.p.x} {nest.g.p.x} {shared_copy.xs[0]} {shared.g.xs[0]}")

    let r = mk_owner(1)
    let round = ident_pt(r.p)
    r.p.x = 99
    print("{round.x} {r.p.x}")
}

value V2 { x: float, y: float }

fn nb_v2(n: int) -> NativeBuffer<V2> {
    return native_buffer_alloc(n)
}

// A whole NativeBuffer element read copies; a leaf projection reads the live slot.
@test(output = "1 99")
fn native_buffer_element_reads() {
    let buf = nb_v2(1)
    buf[0] = V2 { x: 1.0, y: 2.0 }
    let v = buf[0]
    buf[0] = V2 { x: 99.0, y: 99.0 }
    let live = nb_v2(1)
    live[0] = V2 { x: 1.0, y: 2.0 }
    live[0] = V2 { x: 99.0, y: 99.0 }
    print("{v.x.floor()} {live[0].x.floor()}")
}

fn rewrapped_nb_v2(n: int) -> NativeBuffer<V2> {
    let fresh: NativeBuffer<V2> = native_buffer_alloc(n)
    return NativeBuffer { ptr: fresh.ptr, len: fresh.len }
}

value PtrHolder { p: Ptr<float>, n: int }
value BufHolder { buf: NativeBuffer<V2>, tag: int }
struct BufOwner { nb: NativeBuffer<V2> }

fn rewrap(h: PtrHolder) -> NativeBuffer<float> {
    return NativeBuffer { ptr: h.p, len: h.n }
}

fn bump(h: BufHolder) {
    h.buf[1] = V2 { x: h.buf[1].x + 1.0, y: h.buf[1].y + 2.0 }
}

global OWNED: NativeBuffer<float> = native_buffer_float(4)

@test(output = "2.5 4 7 9\n2 1 1\n4 3\n7")
fn pointer_values_copy_their_leaves() {
    let fb = native_buffer_float(4)
    fb[2] = 2.5
    let ph = PtrHolder { p: fb.ptr, n: fb.len }
    let pcopy = ph
    let again = rewrap(pcopy)
    let h = BufHolder { buf: rewrapped_nb_v2(2), tag: 1 }
    h.buf[1] = V2 { x: 3.0, y: 5.0 }
    let hcopy = h
    bump(hcopy)
    let a = rewrapped_nb_v2(3)
    let b = a
    b[2] = V2 { x: 9.0, y: 0.0 }
    print("{again[2]} {h.buf[1].x} {hcopy.buf[1].y} {a[2].x}")

    let o = BufOwner { nb: rewrapped_nb_v2(2) }
    o.nb[1] = V2 { x: 1.0, y: 0.0 }
    let before = o.nb
    o.nb.len = 1
    print("{before.len} {o.nb.len} {o.nb[0].x + before[1].x}")

    let gbefore = OWNED
    OWNED.len = 3
    print("{gbefore.len} {OWNED.len}")

    let po = BufOwner { nb: rewrapped_nb_v2(1) }
    let other = rewrapped_nb_v2(1)
    other[0] = V2 { x: 7.0, y: 0.0 }
    po.nb.ptr = other.ptr
    print("{po.nb[0].x}")
}

value Vec2i { x: int, y: int }

global VS_GLOBAL: Vec2i = Vec2i { x: 0, y: 0 }
global VS_LIST: [Vec2i] = [Vec2i { x: 1, y: 1 }]

@test
fn replacing_a_value_leaves_earlier_reads_intact() {
    let snapshot = VS_GLOBAL
    VS_GLOBAL = Vec2i { x: 7, y: 9 }
    assert(snapshot.x == 0 && snapshot.y == 0)
    assert(VS_GLOBAL.x == 7 && VS_GLOBAL.y == 9)
    assert(snapshot == Vec2i { x: 0, y: 0 })
    let held = VS_LIST[0]
    VS_LIST.push(Vec2i { x: 9, y: 9 })
    VS_LIST[0] = Vec2i { x: 5, y: 5 }
    assert(held.x == 1 && held.y == 1)
    assert(VS_LIST[0].x == 5)
}

// https://github.com/darthdeus/rock-lang/issues/404
value CopyChild { x: int, y: int }
nobox value FlatChild { x: int, y: int }
value CopyParent { value: CopyChild, flat: FlatChild }
nobox value SingleChild { x: int }
value SingleParent { child: SingleChild }

fn observe_copy_parent(x: CopyParent) { print(x.flat.x) }

fn copy_parent_across_branch(input: int) {
    let flat = FlatChild { x: -1, y: 0 }
    let value = CopyChild { x: input, y: input }
    let whole = CopyParent { value: value, flat: flat }
    let copy = whole
    if false { print(0) }
    observe_copy_parent(whole)
    observe_copy_parent(copy)
}

fn copy_single_parent_across_branch(input: int) {
    let whole = SingleParent { child: SingleChild { x: input } }
    let copy = whole
    if input > 0 {}
    print(whole.child.x)
    print(copy.child.x)
}

@test(output = "-1\n-1\n0\n0\n1\n1")
fn nested_nobox_copy_across_branch() {
    copy_parent_across_branch(3)
    for input in 0..2 { copy_single_parent_across_branch(input) }
    let whole = SingleParent { child: SingleChild { x: 3 } }
    let copy = whole
    if false { print(0) }
    whole.child.x = 7
    assert_eq(whole.child.x, 7)
    assert_eq(copy.child.x, 3)
}

value WideInteger { x: int }
struct IntegerCell { v: WideInteger }

fn show_integer_cell(c: IntegerCell) { print(c.v.x) }

// https://github.com/darthdeus/rock-lang/issues/399
@test(output = "2147483647\n-2147483648")
fn integer_leaves_keep_signed_32_bit_boundaries() {
    show_integer_cell(IntegerCell { v: WideInteger { x: 2147483647 } })
    let local = WideInteger { x: 0 }
    local.x = -2147483648
    show_integer_cell(IntegerCell { v: local })
    let s = WideInteger { x: -2147483648 }
    assert(s.x == -2147483648)
    s.x = 2147483647
    assert(s.x == 2147483647)
    // Ordinary int arithmetic retains its wider range.
    assert(s.x + 1 == 2147483648)
}

// Value-semantics decision points, each pinned to the chosen rule.

struct RefPt { x: int }

// A local reassigned after capture is captured by cell, the same rule for
// values, ints and reference structs; without reassignment it reads the value.
@test(output = "9 9 9 1")
fn capture_then_reassign_is_by_cell_for_every_type() {
    let p = Pt { x: 1, y: 2 }
    let fp = () => p.x
    p = Pt { x: 9, y: 9 }
    let i = 1
    let fi = () => i
    i = 9
    let r = RefPt { x: 1 }
    let fr = () => r.x
    r = RefPt { x: 9 }
    let q = Pt { x: 1, y: 2 }
    let fq = () => q.x
    print("{fp()} {fi()} {fr()} {fq()}")
}

// A boxed inline(lua) argument is a fresh shallow pack at every caller shape and
// tier: a scalar-leaf write is lost, a write through a reference leaf aliases.
value GcM { m: Map<int, int>, n: int }
struct C3Own { p: Pt }
struct C3GcOwn { g: GcM }

@nomangle inline(lua) fn c3_read_x(p: Pt) -> int = "return p.x"
@nomangle inline(lua) fn c3_poke(p: Pt) = "p.x = 999"
@nomangle inline(lua) fn c3_poke_gc(g: GcM) = "g.n = 999"
@nomangle inline(lua) fn c3_poke_map(g: GcM) = "g.m[1] = 777"

fn c3_mk(a: int) -> Pt { return Pt { x: a, y: 0 } }

global C3_G: Pt = Pt { x: 5, y: 0 }

@test(output = "5 5 5 5 5\n5 5\n777 777", backends = "lua")
fn inline_lua_boxed_argument_is_a_shallow_copy() {
    let a = c3_mk(5)
    c3_poke(a)
    let o = C3Own { p: c3_mk(5) }
    c3_poke(o.p)
    c3_poke(C3_G)
    let xs = [c3_mk(5)]
    c3_poke(xs[0])
    let b: NativeBuffer<Pt> = native_buffer_alloc(2)
    b[0] = c3_mk(5)
    c3_poke(b[0])
    print("{c3_read_x(a)} {o.p.x} {C3_G.x} {xs[0].x} {b[0].x}")

    let g = GcM { m: map_new(), n: 5 }
    c3_poke_gc(g)
    let og = C3GcOwn { g: GcM { m: map_new(), n: 5 } }
    c3_poke_gc(og.g)
    print("{g.n} {og.g.n}")

    let gm = GcM { m: map_new(), n: 5 }
    gm.m[1] = 1
    c3_poke_map(gm)
    let ogm = C3GcOwn { g: GcM { m: map_new(), n: 5 } }
    ogm.g.m[1] = 1
    c3_poke_map(ogm.g)
    print("{gm.m[1]} {ogm.g.m[1]}")
}

struct ConstOwner { p: Pt }
value ConstOther { x: int, y: int }
struct OtherConstOwner { p: ConstOther }

fn const_owner() -> ConstOwner { ConstOwner { p: Pt { x: 1, y: 1 } } }
fn other_const_owner() -> OtherConstOwner { OtherConstOwner { p: ConstOther { x: 1, y: 1 } } }
@nomangle fn const_sum(v: Pt) -> int { v.x + v.y }

global CONST_OWNER: ConstOwner = const_owner()

@test
fn identical_constant_value_constructors_do_not_alias_on_write() {
    let first = const_owner()
    let second = const_owner()
    let other = other_const_owner()
    first.p.x = 5
    assert_eq((first.p.x, second.p.x, CONST_OWNER.p.x, other.p.x), (5, 1, 1, 1))
    assert_eq(const_sum(Pt { x: 10, y: 11 }), 21)
    assert_eq(const_sum(Pt { x: 20, y: 22 }), 42)
    assert_eq(const_sum(Pt { x: first.p.x, y: 3 }), 8)
}
