// Value-struct operator overloads take their operands and return their result
// through the scalar ABI; a mixed value/scalar operator keeps the scalar
// operand as a single argument.

value V2 { x: int, y: int }

operator +(a: V2, b: V2) -> V2 {
    return V2 { x: a.x + b.x, y: a.y + b.y }
}

operator -(a: V2, b: V2) -> V2 {
    return V2 { x: a.x - b.x, y: a.y - b.y }
}

operator *(v: V2, s: int) -> V2 {
    return V2 { x: v.x * s, y: v.y * s }
}

fn add(a: V2, b: V2) -> V2 {
    return a + b
}

fn sub(a: V2, b: V2) -> V2 {
    return a - b
}

fn chain_let(a: V2, b: V2, c: V2) -> V2 {
    let t = a + b
    return t + c
}

@test(output = "11 22\n8 12\n6 6\n9 3")
fn test_value_operator_overloads() {
    let p = add(V2 { x: 10, y: 20 }, V2 { x: 1, y: 2 })
    print("{p.x} {p.y}")
    let m = V2 { x: 2, y: 3 } * 4
    print("{m.x} {m.y}")
    let cl = chain_let(V2 { x: 1, y: 1 }, V2 { x: 2, y: 2 }, V2 { x: 3, y: 3 })
    print("{cl.x} {cl.y}")
    let d = sub(V2 { x: 10, y: 5 }, V2 { x: 1, y: 2 })
    let e = add(d, V2 { x: 0, y: 0 })
    print("{e.x} {e.y}")
}
