// Escape-site rematerialization rebuilds only non-nullable value bindings: a
// `V?` binding stays boxed, so its null path must return null. `Pair` is the
// cdata tier, `Bag` the GC tier.

value Pair { a: int, b: int }
value Bag { xs: [int] }

fn pick_pair(c: bool) -> Pair? {
    let v: Pair? = null
    if c { v = Pair { a: 1, b: 2 } }
    return v
}

fn pick_bag(c: bool) -> Bag? {
    let v: Bag? = null
    if c { v = Bag { xs: [9] } }
    return v
}

fn alias_pair(cond: bool, side: bool) -> Pair? {
    let r: Pair? = null
    if cond { r = Pair { a: 4, b: 5 } }
    let c = r
    if side { let _ = 0 }
    return c
}

fn alias_bag(cond: bool, side: bool) -> Bag? {
    let r: Bag? = null
    if cond { r = Bag { xs: [8] } }
    let c = r
    if side { let _ = 0 }
    return c
}

fn passthru_pair(v: Pair?) -> Pair? {
    if v != null { return v }
    return null
}

fn passthru_bag(v: Bag?) -> Bag? {
    if v != null { return v }
    return null
}

fn pair_sum(p: Pair?) -> int { return if p != null { p.a + p.b } else { -1 } }
fn bag_head(b: Bag?) -> int { return if b != null { b.xs[0] } else { -1 } }

struct Cell { tag: int }
global CELLS: Arena<Cell> = arena_new()

fn find_cell(want: int) -> Entity<Cell>? {
    for (e, cell) in CELLS {
        if cell.tag == want { return e }
    }
    return null
}

@test(output = "3 -1 9 -1\n9 -1 8 -1\n30 -1 5 -1\n20 -1")
fn nullable_values_stay_boxed_and_hits_rematerialize() {
    print("{pair_sum(pick_pair(true))} {pair_sum(pick_pair(false))} {bag_head(pick_bag(true))} {bag_head(pick_bag(false))}")
    print("{pair_sum(alias_pair(true, true))} {pair_sum(alias_pair(false, true))} {bag_head(alias_bag(true, true))} {bag_head(alias_bag(false, true))}")
    print("{pair_sum(passthru_pair(Pair { a: 10, b: 20 }))} {pair_sum(passthru_pair(null))} {bag_head(passthru_bag(Bag { xs: [5] }))} {bag_head(passthru_bag(null))}")
    CELLS.clear()
    let _ = CELLS.insert(Cell { tag: 10 })
    let _ = CELLS.insert(Cell { tag: 20 })
    let hit = find_cell(20)
    let miss = find_cell(99)
    print("{if hit != null { hit.get().unwrap().tag } else { -1 }} {if miss != null { miss.get().unwrap().tag } else { -1 }}")
}
