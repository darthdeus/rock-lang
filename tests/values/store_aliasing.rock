// Storing one value into two places copies it: a later write through either
// place must not reach the other, whatever the source of the stored value.

value AliasPoint { x: int, y: int }
value AliasWrap { p: AliasPoint, n: int }
struct AliasHolder { a: AliasPoint, b: AliasPoint, o: AliasPoint? = null, w: AliasWrap? = null }

fn alias_store_twice(e: AliasPoint?, h: AliasHolder) {
    if let v = e {
        h.a = v
        h.b = v
    }
}

fn alias_store_optional(e: AliasPoint?, h: AliasHolder) { h.o = e }

fn holder(o: AliasPoint?) -> AliasHolder {
    return AliasHolder { a: AliasPoint { x: 0, y: 0 }, b: AliasPoint { x: 0, y: 0 }, o: o }
}

fn wrap_holder() -> AliasHolder {
    return AliasHolder { a: AliasPoint { x: 0, y: 0 }, b: AliasPoint { x: 0, y: 0 }, w: AliasWrap { p: AliasPoint { x: 1, y: 2 }, n: 0 } }
}

@test
fn storing_one_value_twice_copies() {
    let h = holder(null)
    alias_store_twice(AliasPoint { x: 1, y: 2 }, h)
    h.a.x = 5
    assert_eq(h.b.x, 1, "param")

    let src = holder(AliasPoint { x: 3, y: 4 })
    let dst = holder(null)
    alias_store_optional(src.o, dst)
    alias_store_twice(dst.o, dst)
    dst.a.x = 9
    assert_eq(dst.b.x, 3, "field through a parameter")

    let hf = holder(AliasPoint { x: 1, y: 2 })
    if let v = hf.o {
        hf.a = v
        hf.b = v
    }
    hf.a.x = 5
    assert_eq(hf.b.x, 1, "optional field if-let")
    assert_eq(hf.o.unwrap().x, 1, "optional field source")

    let m: Map<string, AliasPoint?> = map_new()
    m["k"] = AliasPoint { x: 1, y: 2 }
    let hm = holder(null)
    if let v = m["k"] {
        hm.a = v
        hm.b = v
    }
    hm.a.x = 5
    assert_eq(hm.b.x, 1, "map optional value")

    let mg: Map<string, AliasPoint> = map_new()
    mg["k"] = AliasPoint { x: 1, y: 2 }
    let hg = holder(null)
    if let v = mg.get("k") {
        hg.a = v
        hg.b = v
    }
    hg.a.x = 5
    assert_eq(hg.b.x, 1, "map get")

    let xs: [AliasPoint?] = [AliasPoint { x: 1, y: 2 }, null]
    let hx = holder(null)
    if let v = xs[0] {
        hx.a = v
        hx.b = v
    }
    hx.a.x = 5
    assert_eq(hx.b.x, 1, "optional element")

    let hl = holder(null)
    for e in xs {
        if let v = e {
            hl.a = v
            hl.b = v
        }
    }
    hl.a.x = 5
    assert_eq(hl.b.x, 1, "optional element loop")

    let hc = holder(AliasPoint { x: 1, y: 2 })
    let vc = hc.o ?? AliasPoint { x: 9, y: 9 }
    hc.a = vc
    hc.b = vc
    hc.a.x = 5
    assert_eq(hc.b.x, 1, "coalesce")

    let hu = holder(AliasPoint { x: 1, y: 2 })
    let vu = hu.o.unwrap()
    hu.a = vu
    hu.b = vu
    hu.a.x = 5
    assert_eq(hu.b.x, 1, "unwrap")

    let hk = holder(AliasPoint { x: 1, y: 2 })
    let o = hk.o
    let f = () => {
        if let v = o {
            hk.a = v
            hk.b = v
        }
        return 0
    }
    f()
    hk.a.x = 5
    assert_eq(hk.b.x, 1, "closure capture")

    let s = holder(AliasPoint { x: 1, y: 2 })
    let d = holder(null)
    d.o = s.o
    if let x = d.o {
        d.a = x
    }
    d.a.x = 5
    assert_eq(s.o.unwrap().x, 1, "optional field to optional field")
}

@test
fn storing_a_wrapped_value_twice_copies() {
    let h = wrap_holder()
    if let w = h.w {
        h.a = w.p
        h.b = w.p
    }
    h.a.x = 5
    assert_eq(h.b.x, 1, "wrapper field")

    let src = wrap_holder()
    let g = holder(null)
    if let x = src.w {
        g.w = x
    }
    if let gw = g.w {
        g.a = gw.p
    }
    g.a.x = 5
    assert_eq(src.w.unwrap().p.x, 1, "wrapper stored then written")
}

value AliasLabel { text: string, n: int }
struct AliasLabelHolder { a: AliasLabel, b: AliasLabel }

fn alias_label_store_twice(v: AliasLabel, h: AliasLabelHolder) {
    h.a = v
    h.b = v
}

fn gc_alias_store_twice(e: AliasLabel?, h: AliasLabelHolder) {
    if let v = e {
        h.a = v
        h.b = v
    }
}

@test
fn storing_one_gc_value_twice_copies() {
    let h = AliasLabelHolder { a: AliasLabel { text: "a", n: 0 }, b: AliasLabel { text: "b", n: 0 } }
    alias_label_store_twice(AliasLabel { text: "x", n: 1 }, h)
    h.a.n = 5
    assert_eq(h.b.n, 1, "plain")
    let g = AliasLabelHolder { a: AliasLabel { text: "a", n: 0 }, b: AliasLabel { text: "b", n: 0 } }
    gc_alias_store_twice(AliasLabel { text: "x", n: 1 }, g)
    g.a.n = 5
    assert_eq(g.b.n, 1, "optional")
}

// A `V?` read out of a mutable place copies its leaves when present and stays
// null when absent, at every place root; an absent value must not be indexed.
struct NonNull1 { p: AliasPoint }
struct NonNull2 { p: AliasPoint }
struct Nullable1 { p: AliasPoint? }
struct Nullable2 { p: AliasPoint? }
struct Owner { inner: Nullable1? }
struct NNB { p: AliasPoint }
struct OwnerNN { inner: NNB? }

fn nullable_identity(a: Nullable1) -> Nullable1 { return a }

fn read_out_of_param(a: Nullable1) {
    let b = Nullable2 { p: a.p }
    if b.p != null && a.p != null {
        b.p.x = 99
        print("b={b.p.x} a={a.p.x}")
    }
}

global G_PT: AliasPoint? = null

// Through a fn so the read site sees the declared `AliasPoint?`, not a refinement.
fn set_g_pt(v: AliasPoint?) {
    G_PT = v
}

fn presence(b: Nullable2) -> string { return if b.p == null { "null" } else { "boxed" } }

@test(output = "b=99 a=1\nb=99 a=1\nc=1 a=99\nb=99 a=1\nb=99 g=1\nb=99 e=1\nb=99 m=1\nb=99 a=1\nb=99 a=1\nb=99 a=1\nnull null null null")
fn whole_value_reads_of_places_copy() {
    let nn = NonNull1 { p: AliasPoint { x: 1, y: 2 } }
    let nb = NonNull2 { p: nn.p }
    nb.p.x = 99
    print("b={nb.p.x} a={nn.p.x}")

    let na = Nullable1 { p: AliasPoint { x: 1, y: 2 } }
    let b = Nullable2 { p: nullable_identity(na).p }
    if b.p != null && na.p != null {
        b.p.x = 99
        print("b={b.p.x} a={na.p.x}")
    }

    let la = Nullable1 { p: AliasPoint { x: 1, y: 2 } }
    let c = la.p
    if la.p != null { la.p.x = 99 }
    if c != null && la.p != null { print("c={c.x} a={la.p.x}") }

    read_out_of_param(Nullable1 { p: AliasPoint { x: 1, y: 2 } })

    set_g_pt(AliasPoint { x: 1, y: 2 })
    let gb = Nullable2 { p: G_PT }
    if gb.p != null {
        gb.p.x = 99
        if G_PT != null { print("b={gb.p.x} g={G_PT.x}") }
    }

    let xs: [AliasPoint?] = [AliasPoint { x: 1, y: 2 }]
    let xb = Nullable2 { p: xs[0] }
    if xb.p != null {
        xb.p.x = 99
        let e = xs[0]
        if e != null { print("b={xb.p.x} e={e.x}") }
    }

    let m: Map<int, AliasPoint?> = map_new()
    m[7] = AliasPoint { x: 1, y: 2 }
    let mb = Nullable2 { p: m[7] }
    if mb.p != null {
        mb.p.x = 99
        let mv = m[7]
        if mv != null { print("b={mb.p.x} m={mv.x}") }
    }

    let o = Owner { inner: Nullable1 { p: AliasPoint { x: 1, y: 2 } } }
    let ob = Nullable2 { p: o.inner?.p }
    if ob.p != null && o.inner != null && o.inner.p != null {
        ob.p.x = 99
        print("b={ob.p.x} a={o.inner.p.x}")
    }

    let on = OwnerNN { inner: NNB { p: AliasPoint { x: 1, y: 2 } } }
    let onb = Nullable2 { p: on.inner?.p }
    if onb.p != null && on.inner != null {
        onb.p.x = 99
        print("b={onb.p.x} a={on.inner.p.x}")
    }

    let r = OwnerNN { inner: NNB { p: AliasPoint { x: 1, y: 2 } } }
    if r.inner != null {
        let rb = Nullable2 { p: r.inner.p }
        if rb.p != null {
            rb.p.x = 99
            print("b={rb.p.x} a={r.inner.p.x}")
        }
    }

    let absent_field = Nullable1 { p: null }
    let af = Nullable2 { p: absent_field.p }
    set_g_pt(null)
    let ag = Nullable2 { p: G_PT }
    let sf = Owner { inner: Nullable1 { p: null } }
    let asf = Nullable2 { p: sf.inner?.p }
    let sb = Owner { inner: null }
    let asb = Nullable2 { p: sb.inner?.p }
    print("{presence(af)} {presence(ag)} {presence(asf)} {presence(asb)}")
}
