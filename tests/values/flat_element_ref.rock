// References to flat vec elements: writes and reads.

value FerInner { v: int }

value FerCell { inner: FerInner, w: int }

value FerOuter { cell: FerCell, z: int }

nobox value FerQ2 { x: float, y: float }

nobox value FerWide { kind: int, at: FerQ2, a: int, b: int, c: int }

struct FerBox { cell: FerCell }

struct FerPair { a: FerCell, b: FerCell }

fn fer_cells() -> [FerCell] {
    let xs: [FerCell] = []
    xs.push(FerCell { inner: FerInner { v: 1 }, w: 2 })
    xs.push(FerCell { inner: FerInner { v: 3 }, w: 4 })
    return xs
}

fn fer_bump(c: ref FerCell) -> int {
    c.w += 1
    return c.w
}

fn fer_bump_inner(c: ref FerInner) -> int {
    c.v += 1
    return c.v
}

fn fer_bump_both(c: ref FerCell) -> int {
    fer_bump(c)
    return fer_bump_inner(c.inner)
}

fn fer_tick(c: ref FerCell) -> int {
    c.inner.v++
    return c.inner.v
}

fn fer_bump_pair(c: ref FerCell) -> (int, int) {
    c.w += 1
    c.inner.v += 1
    return (c.w, c.inner.v)
}

fn fer_bump_wide(c: ref FerWide) -> int {
    c.b += 10
    return c.b
}

fn fer_move_at(q: ref FerQ2) -> float {
    q.y += 0.5
    return q.y
}

// The stored value is the preceding caller's input, not a call-count formula.
fn fer_static_exchange<T>(c: ref FerInner, tag: T) -> int {
    static previous = 0
    let incoming = c.v
    c.v = previous
    previous = incoming
    return incoming
}

fn fer_static_from_another_root(incoming: int) -> (int, int) {
    let xs: [FerInner] = [FerInner { v: incoming }]
    let sent = fer_static_exchange(xs[0], 0)
    return (xs[0].v, sent)
}

nobox value FerStaticWide { inner: FerInner, a: int, b: int, c: int, d: int, e: int }

struct FerStaticBox { inner: FerInner }

@test
fn fer_static_history_is_shared_across_flat_storage_shapes() {
    let boxed = FerStaticBox { inner: FerInner { v: 17 } }
    let first = fer_static_exchange(boxed.inner, 0)
    let initial = boxed.inner.v
    defer {
        boxed.inner.v = initial
        fer_static_exchange(boxed.inner, 0)
    }
    let xs: [FerInner] = [FerInner { v: 29 }]
    let second = fer_static_exchange(xs[0], 0)
    assert_eq(xs[0].v, first, "column ref sees ordinary call history")
    let nested: [FerCell] = [FerCell { inner: FerInner { v: 43 }, w: 71 }]
    let third = fer_static_exchange(nested[0].inner, 0)
    assert_eq(nested[0].inner.v, second, "nested prefix shares the same history")
    assert_eq(nested[0].w, 71, "sibling is not overwritten")
    let rows: [FerStaticWide] = [FerStaticWide {
        inner: FerInner { v: 59 }, a: 1, b: 2, c: 3, d: 4, e: 5
    }]
    let fourth = fer_static_exchange(rows[0].inner, 0)
    assert_eq(rows[0].inner.v, third, "strided prefix shares column history")
    assert_eq(rows[0].e, 5, "strided sibling is not overwritten")
    let m: Map<string, FerInner> = map_new()
    m["key"] = FerInner { v: 83 }
    let fifth = fer_static_exchange(m["key"], 0)
    assert_eq(m["key"].v, fourth, "Map ref shares the same history")
    let arena: Arena<FerInner> = arena_new()
    let entity = arena.insert(FerInner { v: 97 })
    let sixth = fer_static_exchange(arena.borrow(entity).unwrap(), 0)
    assert_eq(entity.get().unwrap().v, fifth, "Arena ref shares the same history")
    let (other_history, seventh) = fer_static_from_another_root(113)
    assert_eq(other_history, sixth, "another root shares the same cells")
    fer_static_exchange(boxed.inner, 0)
    assert_eq(boxed.inner.v, seventh, "ordinary call sees the final flat-ref write")
}

@test
fn fer_static_concrete_callables_keep_distinct_histories() {
    let boxed = FerStaticBox { inner: FerInner { v: 101 } }
    let control = FerStaticBox { inner: FerInner { v: 211 } }
    let first = fer_static_exchange(boxed.inner, false)
    let initial = boxed.inner.v
    defer {
        boxed.inner.v = initial
        fer_static_exchange(boxed.inner, false)
    }
    let control_first = fer_static_exchange(control.inner, "control")
    let control_initial = control.inner.v
    defer {
        control.inner.v = control_initial
        fer_static_exchange(control.inner, "control")
    }
    let xs: [FerInner] = [FerInner { v: 307 }, FerInner { v: 409 }]
    let next = fer_static_exchange(xs[0], false)
    assert_eq(xs[0].v, first, "bool instance retains its own history")
    let control_next = fer_static_exchange(xs[1], "control")
    assert_eq(xs[1].v, control_first, "string instance retains its own history")
    fer_static_exchange(boxed.inner, false)
    fer_static_exchange(control.inner, "control")
    assert_eq(boxed.inner.v, next, "ordinary bool instance sees only bool writes")
    assert_eq(control.inner.v, control_next, "ordinary string instance sees only string writes")
}

@test
fn fer_vec_element_ref_args_write_the_element() {
    let xs: [FerCell] = []
    xs.push(FerCell { inner: FerInner { v: 10 }, w: 20 })
    xs.push(FerCell { inner: FerInner { v: 30 }, w: 40 })
    let snapshot = xs[1]
    assert_eq(fer_bump(xs[0]), 21, "whole element")
    assert_eq(xs[0].w, 21, "vec element holds the ref write")
    assert_eq(xs[0].inner.v, 10, "sibling leaf unchanged")
    assert_eq(xs[1].w, 40, "neighbouring element unchanged")
    assert_eq(fer_bump_inner(xs[1].inner), 31, "nested field")
    assert_eq(xs[1].inner.v, 31, "nested field holds the ref write")
    assert_eq(xs[1].w, 40, "owner's sibling leaf unchanged")
    assert_eq(fer_bump_both(xs[1]), 32, "ref param passed on")
    assert_eq(xs[1].w, 41, "the passed-on whole-element write landed")
    assert_eq(fer_tick(xs[1]), 33, "increment through the ref")
    xs[1].w++
    assert_eq(xs[1].inner.v, 33, "element holds the increment through the ref")
    assert_eq(xs[1].w, 42, "element holds the indexed increment")
    let (w, v) = fer_bump_pair(xs[1])
    assert_eq((w, v), (43, 34), "tuple-returning callee")
    assert_eq(xs[1].w, 43, "element holds the whole-element write")
    assert_eq(xs[1].inner.v, 34, "element holds the nested write")
    assert_eq(xs[0].w, 21, "neighbouring element unchanged")
    assert_eq(xs[0].inner.v, 10, "neighbouring element unchanged")
    assert_eq(snapshot.w, 40, "a whole-element copy keeps the old leaves")
    assert_eq(snapshot.inner.v, 30, "a whole-element copy keeps the old nested leaf")

    let os: [FerOuter] = []
    os.push(FerOuter { cell: FerCell { inner: FerInner { v: 1 }, w: 2 }, z: 3 })
    os.push(FerOuter { cell: FerCell { inner: FerInner { v: 4 }, w: 5 }, z: 6 })
    assert_eq(fer_bump(os[1].cell), 6, "deep prefix")
    assert_eq(fer_bump_inner(os[1].cell.inner), 5, "deeper prefix")
    assert_eq(os[1].cell.w, 6, "cell field holds the ref write")
    assert_eq(os[1].cell.inner.v, 5, "inner field holds the ref write")
    assert_eq(os[1].z, 6, "owner's sibling leaf unchanged")
    assert_eq(os[0].cell.w, 2, "neighbouring element unchanged")
    assert_eq(os[0].cell.inner.v, 1, "neighbouring element unchanged")
}

@test
fn fer_map_ref_args_write_the_value() {
    let m: Map<string, FerCell> = map_new()
    m["a"] = FerCell { inner: FerInner { v: 10 }, w: 20 }
    m["b"] = FerCell { inner: FerInner { v: 30 }, w: 40 }
    assert_eq(fer_bump(m["a"]), 21, "whole value")
    assert_eq(m["a"].w, 21, "map value holds the ref write")
    assert_eq(m["a"].inner.v, 10, "sibling leaf unchanged")
    assert_eq(m["b"].w, 40, "neighbouring value unchanged")
    assert_eq(fer_bump_inner(m["b"].inner), 31, "nested field")
    assert_eq(m["b"].inner.v, 31, "nested field holds the ref write")
    assert_eq(m["b"].w, 40, "owner's sibling leaf unchanged")
    assert_eq(m["a"].inner.v, 10, "neighbouring value unchanged")
}

// No flat argument, but the result addresses an Arena value column.
fn fer_borrow(a: Arena<FerCell>, e: Entity<FerCell>) -> (ref FerCell)? {
    return a.borrow(e)
}

fn fer_bump_unit(c: ref FerCell) { c.w += 1 }

@test
fn fer_arena_borrows_write_the_element() {
    let a: Arena<FerCell> = arena_new()
    let first = a.insert(FerCell { inner: FerInner { v: 10 }, w: 20 })
    let second = a.insert(FerCell { inner: FerInner { v: 30 }, w: 40 })
    let c = a.borrow(first)
    assert(c != null, "a live entity borrows")
    assert_eq(fer_bump(c.unwrap()), 21, "arena borrow")
    assert_eq(a.get(first).unwrap().w, 21, "arena element holds the ref write")
    assert_eq(a.get(first).unwrap().inner.v, 10, "sibling leaf unchanged")
    assert_eq(a.get(second).unwrap().w, 40, "neighbouring element unchanged")
    let d = second.borrow()
    if d != null {
        fer_bump_inner(d.inner)
    }
    assert_eq(second.get().unwrap().inner.v, 31, "the nested entity-borrow write landed")
    assert_eq(second.get().unwrap().w, 40, "owner's sibling leaf unchanged")
    assert_eq(first.get().unwrap().inner.v, 10, "neighbouring element unchanged")
    let e = fer_borrow(a, first)
    if e != null { fer_bump_unit(e) }
    assert_eq(first.get().unwrap().w, 22, "the borrowed ref result took the write")
    assert_eq(second.get().unwrap().w, 40, "the other element is unchanged")
    a.remove(first)
    assert(a.borrow(first) == null, "a dead entity does not borrow")
}

// Recursive `ref` returns hand the argument back up the call chain, so every
// return addresses the argument's storage, flat or boxed.
fn fer_descend(c: ref FerCell, n: int) -> ref FerCell {
    if n == 0 { return c }
    return fer_descend(c, n - 1)
}

// The odd half returns only through the cycle.
fn fer_descend_even(c: ref FerCell, n: int) -> ref FerCell {
    if n == 0 { return c }
    return fer_descend_odd(c, n - 1)
}

fn fer_descend_odd(c: ref FerCell, n: int) -> ref FerCell {
    return fer_descend_even(c, n - 1)
}

@test
fn fer_recursive_ref_returns_write_the_element() {
    let xs: [FerCell] = []
    xs.push(FerCell { inner: FerInner { v: 10 }, w: 20 })
    xs.push(FerCell { inner: FerInner { v: 30 }, w: 40 })
    xs.push(FerCell { inner: FerInner { v: 50 }, w: 60 })
    let os: [FerOuter] = []
    os.push(FerOuter { cell: FerCell { inner: FerInner { v: 1 }, w: 2 }, z: 3 })
    os.push(FerOuter { cell: FerCell { inner: FerInner { v: 4 }, w: 5 }, z: 6 })
    let boxed = FerBox { cell: FerCell { inner: FerInner { v: 7 }, w: 8 } }
    assert_eq(fer_bump(fer_descend(xs[0], 12)), 21, "vec element through the returned ref")
    assert_eq(xs[0].w, 21, "vec element holds the write")
    assert_eq(xs[0].inner.v, 10, "sibling leaf unchanged")
    assert_eq(xs[1].w, 40, "neighbouring element unchanged")
    assert_eq(fer_bump(fer_descend(os[1].cell, 5)), 6, "nested field through the returned ref")
    assert_eq(os[1].cell.w, 6, "nested field holds the write")
    assert_eq(os[1].z, 6, "owner's sibling leaf unchanged")
    assert_eq(os[0].cell.w, 2, "neighbouring element unchanged")
    assert_eq(fer_bump(fer_descend(boxed.cell, 3)), 9, "boxed value through the returned ref")
    assert_eq(boxed.cell.w, 9, "boxed value holds the write")
    assert_eq(boxed.cell.inner.v, 7, "boxed sibling leaf unchanged")
    assert_eq(fer_bump(fer_descend_even(xs[0], 6)), 22, "even entry")
    assert_eq(fer_bump(fer_descend_odd(xs[1], 7)), 41, "odd entry")
    assert_eq(fer_bump(fer_descend_odd(boxed.cell, 3)), 10, "boxed odd entry")
    assert_eq(xs[0].w, 22, "element reached through the even entry holds the write")
    assert_eq(xs[1].w, 41, "element reached through the odd entry holds the write")
    assert_eq(xs[2].w, 60, "neighbouring element unchanged")
    assert_eq(xs[2].inner.v, 50, "neighbouring element unchanged")
    assert_eq(boxed.cell.w, 10, "boxed value holds the cycle write")
}

// Rebinding a local `ref` moves it to another element: writes before the
// rebinding land in the first target, writes after it only in the second.
fn fer_rebind_write(a: ref FerCell, b: ref FerCell) -> (int, int) {
    let r: ref FerCell = a
    r.w += 1
    let first = r.w
    r = b
    r.w += 100
    return (first, r.w)
}

fn fer_pick(a: ref FerCell, b: ref FerCell, second: bool) -> ref FerCell {
    let r: ref FerCell = a
    if second {
        r = b
    }
    return r
}

fn fer_rebind_through_call(a: ref FerCell, b: ref FerCell) -> int {
    let r: ref FerCell = a
    r = fer_descend(b, 3)
    return fer_bump(r)
}

// Alternates the target on every iteration, so each rebinding must replace
// both the container and the slot the previous one left in the binding.
fn fer_rebind_in_loop(a: ref FerCell, b: ref FerCell, n: int) -> int {
    let r: ref FerCell = a
    let total = 0
    for i in 0..n {
        r.w += 1
        total += r.w
        if i % 2 == 0 {
            r = b
        } else {
            r = a
        }
    }
    return total
}

fn fer_rebind_wide(a: ref FerWide, b: ref FerWide) -> int {
    let r: ref FerWide = a
    r = b
    r.b += 10
    return r.b
}

fn fer_rebind_param(a: ref FerCell, b: ref FerCell) -> int {
    a.w += 1
    a = b
    a.w += 100
    return a.w
}

@test
fn fer_rebound_refs_write_only_their_new_target() {
    let xs: [FerCell] = []
    xs.push(FerCell { inner: FerInner { v: 10 }, w: 20 })
    xs.push(FerCell { inner: FerInner { v: 30 }, w: 40 })
    xs.push(FerCell { inner: FerInner { v: 50 }, w: 60 })
    assert_eq(fer_rebind_write(xs[0], xs[1]), (21, 140), "writes before and after rebinding")
    assert_eq(xs[0].w, 21, "first target holds only the write before rebinding")
    assert_eq(xs[1].w, 140, "second target holds the write after rebinding")
    assert_eq(xs[0].inner.v, 10, "first target's sibling unchanged")
    assert_eq(xs[1].inner.v, 30, "second target's sibling unchanged")
    assert_eq(xs[2].w, 60, "neighbouring element unchanged")
    assert_eq(fer_bump(fer_pick(xs[0], xs[1], true)), 141, "the chosen element")
    assert_eq(xs[0].w, 21, "the element not chosen is unchanged")
    assert_eq(fer_bump(fer_pick(xs[0], xs[1], false)), 22, "the kept element")
    assert_eq(xs[1].w, 141, "the element not kept is unchanged")
    assert_eq(fer_rebind_through_call(xs[0], xs[1]), 142, "rebound to a ref result")
    assert_eq(xs[1].w, 142, "the element the call returned holds the write")
    assert_eq(xs[0].w, 22, "the element bound first is unchanged")
    let pair = FerPair { a: xs[0], b: xs[1] }
    let flat_total = fer_rebind_in_loop(xs[0], xs[1], 5)
    let boxed_total = fer_rebind_in_loop(pair.a, pair.b, 5)
    assert_eq(flat_total, boxed_total, "flat and boxed refs rebind alike in a loop")
    assert_eq(xs[0].w, pair.a.w, "first element took the same writes as the boxed one")
    assert_eq(xs[1].w, pair.b.w, "second element took the same writes as the boxed one")
    let flat_seen = fer_rebind_param(xs[0], xs[1])
    let boxed_seen = fer_rebind_param(pair.a, pair.b)
    assert_eq(flat_seen, boxed_seen, "flat and boxed parameters rebind alike")
    assert_eq(xs[0].w, pair.a.w, "first element took only the write before rebinding")
    assert_eq(xs[1].w, flat_seen, "second element holds the write after rebinding")
    assert_eq(xs[0].inner.v, 10, "sibling leaf unchanged")
    assert_eq(xs[1].inner.v, 30, "sibling leaf unchanged")
}

@test
fn fer_rebound_ref_moves_between_containers_and_prefixes() {
    let xs: [FerCell] = [FerCell { inner: FerInner { v: 1 }, w: 2 }]
    let ys: [FerCell] = [FerCell { inner: FerInner { v: 3 }, w: 4 }]
    let m: Map<string, FerCell> = map_new()
    m["a"] = FerCell { inner: FerInner { v: 5 }, w: 6 }
    m["b"] = FerCell { inner: FerInner { v: 7 }, w: 8 }
    let (vec_first, vec_second) = fer_rebind_write(xs[0], ys[0])
    assert_eq(xs[0].w, vec_first, "first vec holds the write before rebinding")
    assert_eq(ys[0].w, vec_second, "second vec holds the write after rebinding")
    let (map_first, map_second) = fer_rebind_write(m["a"], m["b"])
    assert_eq(m["a"].w, map_first, "first map value holds the write before rebinding")
    assert_eq(m["b"].w, map_second, "second map value holds the write after rebinding")
    assert_eq(m["b"].inner.v, 7, "map sibling unchanged")
    let os: [FerOuter] = []
    os.push(FerOuter { cell: FerCell { inner: FerInner { v: 1 }, w: 2 }, z: 3 })
    os.push(FerOuter { cell: FerCell { inner: FerInner { v: 4 }, w: 5 }, z: 6 })
    assert_eq(fer_rebind_write(os[0].cell, os[1].cell), (3, 105), "nested prefix targets")
    assert_eq(os[0].cell.w, 3, "first nested target holds its write")
    assert_eq(os[1].cell.w, 105, "second nested target holds its write")
    assert_eq(os[0].z, 3, "owner's sibling leaf unchanged")
    assert_eq(os[1].z, 6, "owner's sibling leaf unchanged")
}

fn fer_q_sum(q: FerQ2) -> float { return q.x * 100.0 + q.y }

fn fer_wide_rewrite(r: ref FerWide) -> float {
    let before = r.at
    r.b = 100
    r.at.y = 0.5
    r.c += 1
    return before.y * 1000.0 + fer_q_sum(r.at)
}

@test
fn fer_strided_row_refs_write_and_read_the_row() {
    let ws: [FerWide] = vec_new_with_capacity(4)
    ws.push(FerWide { kind: 1, at: FerQ2 { x: 1.0, y: 2.0 }, a: 3, b: 4, c: 5 })
    ws.push(FerWide { kind: 6, at: FerQ2 { x: 7.0, y: 8.0 }, a: 9, b: 10, c: 11 })
    assert_eq(fer_bump_wide(ws[1]), 20, "whole-row ref")
    assert_eq(fer_move_at(ws[1].at), 8.5, "nested ref")
    assert_eq(ws[1].b, 20, "row holds the whole-element ref write")
    assert_eq(ws[1].at.y, 8.5, "row holds the nested ref write")
    assert_eq(ws[1].a, 9, "sibling leaf unchanged")
    assert_eq(ws[1].at.x, 7.0, "nested sibling leaf unchanged")
    assert_eq(fer_rebind_wide(ws[0], ws[1]), 30, "rebound row ref")
    assert_eq(ws[1].b, 30, "the second row holds the write")
    assert_eq(ws[1].c, 11, "the second row's sibling is unchanged")
    assert_eq(fer_wide_rewrite(ws[1]), 9200.5, "nested reads before and after")
    assert_eq(ws[1].b, 100, "the row holds the write")
    assert_eq(ws[1].c, 12, "the row holds the compound write")
    assert_eq(ws[1].at.x, 7.0, "the nested sibling is unchanged")
    assert_eq(ws[0].b, 4, "the neighbouring row is unchanged")
    assert_eq(ws[0].at.y, 2.0, "the neighbouring row is unchanged")
}

fn fer_inner_v(i: FerInner) -> int { return i.v }

fn fer_id<T>(x: T) -> T { return x }

fn fer_snapshot_then_bump(c: ref FerCell) -> FerCell {
    let copy = FerCell { inner: c.inner, w: c.w }
    c.w += 1
    return copy
}

fn fer_nested_reads_around_a_write(c: ref FerCell) -> int {
    let before = fer_inner_v(c.inner)
    c.inner.v += 5
    return before * 100 + fer_inner_v(c.inner)
}

// Equality reads the whole element before and after a write through `c`.
fn fer_equal_before_and_after(c: ref FerCell) -> (bool, bool) {
    let before = c == FerCell { inner: FerInner { v: 3 }, w: 4 }
    c.w = 40
    let after = c == FerCell { inner: FerInner { v: 3 }, w: 40 }
    return (before, after)
}

fn fer_alias_sees_write(c: ref FerCell) -> int {
    let r = fer_id(c)
    c.w += 10
    return r.w
}

// A tuple result with a table-held leaf returns through the flat variant.
fn fer_label_and_bump(c: ref FerCell) -> (string, int) {
    c.w += 1
    return ("w{c.w}", c.inner.v)
}

@test
fn fer_value_reads_through_refs_see_the_current_leaves() {
    let xs = fer_cells()
    assert_eq(fer_inner_v(fer_descend(xs[1], 3).inner), 3, "nested value of a ref result")
    assert_eq(fer_descend(xs[1], 2).w, 4, "leaf of a ref result")
    assert(fer_descend(xs[1], 2) == FerCell { inner: FerInner { v: 3 }, w: 4 }, "whole ref result")
    assert(fer_descend(xs[0], 1) != FerCell { inner: FerInner { v: 3 }, w: 4 }, "the other element")
    let copy = fer_snapshot_then_bump(xs[0])
    assert_eq(copy.w, 2, "the value read keeps the old leaf")
    assert_eq(copy.inner.v, 1, "the value read keeps the old nested leaf")
    assert_eq(xs[0].w, 3, "the element took the write")
    assert_eq(fer_equal_before_and_after(xs[1]), (true, true), "whole reads around a write")
    assert_eq(xs[1].w, 40, "the element took the write")
    assert_eq(fer_nested_reads_around_a_write(xs[1]), 308, "nested reads before and after")
    assert_eq(xs[1].inner.v, 8, "the nested write landed")
    assert_eq(fer_alias_sees_write(xs[0]), 13, "a ref through a generic identity aliases")
    assert_eq(xs[0].w, 13, "the element took the write")
    let (label, v) = fer_label_and_bump(xs[1])
    assert_eq(label, "w41", "the string leaf reads the write")
    assert_eq(v, 8, "the int leaf")
    assert_eq(xs[1].w, 41, "the element took the write")
}

struct FerIndex { next: int }

fn fer_next_index(cursor: FerIndex) -> int {
    let current = cursor.next
    cursor.next += 1
    return current
}

fn fer_change_first_leaf(cursor: FerIndex, xs: [FerCell]) -> int {
    assert_eq(cursor.next, 1, "address evaluated before the RHS")
    xs[0].inner.v = 99
    return 4
}

fn fer_update_first(r: ref FerCell, cursor: FerIndex, xs: [FerCell]) -> (int, int) {
    let before = r.inner.v
    r.inner.v += fer_change_first_leaf(cursor, xs)
    return (before, r.inner.v)
}

@test
fn fer_returned_place_survives_compound_rhs_mutation() {
    let xs = fer_cells()
    let cursor = FerIndex { next: 0 }
    let (before, after) = fer_update_first(fer_descend_even(xs[fer_next_index(cursor)], 2), cursor, xs)
    assert_eq(before, 1, "read before the update")
    assert_eq(after, 5, "compound update uses the pre-RHS value")
    assert_eq(xs[0].inner.v, 5, "write uses the saved slot")
    assert_eq(xs[1].inner.v, 3, "the adjacent slot is untouched")
    assert_eq(cursor.next, 1, "index evaluated once")
}

co fn fer_sample(xs: [FerCell]) -> Coroutine<int> {
    yield fer_descend_even(xs[0], 2).inner.v
}

co fn fer_sample_twice(xs: [FerCell]) -> Coroutine<int> {
    let read = () => fer_descend_odd(xs[0], 3).inner.v
    yield read()
    await fer_sample(xs)
    yield read()
}

@test
fn fer_flat_return_reads_current_slot_across_await() {
    let xs = fer_cells()
    let samples = fer_sample_twice(xs)
    assert_eq(samples.resume(), 1)
    xs[0].inner.v = 15
    assert_eq(samples.resume(), 15)
    xs[0].inner.v = 27
    assert_eq(samples.resume(), 27)
    assert_eq(samples.resume(), null)
}
