nobox value ThingLeaf { value: int }
nobox value ThingSlot { leaf: ThingLeaf }
struct ThingInner { slot: ThingSlot }
struct ThingOuter { inner: ThingInner }
struct Thing { outer: ThingOuter, flagged: bool }
enum ThingRef { None, Plain(Entity<Thing>), Flagged(Entity<Thing>) }

fn thing_ref(entity: Entity<Thing>, thing: Thing) -> ThingRef {
    return if thing.flagged { ThingRef::Flagged(entity) } else { ThingRef::Plain(entity) }
}

// A native enum return must replace the leaves initialized by a variant.
@test fn enum_return_copy_assignment_projects_variant_and_leaf() {
    let rows: Arena<Thing> = arena_new()
    let thing = rows.insert(Thing {
        flagged: true,
        outer: ThingOuter {
            inner: ThingInner { slot: ThingSlot { leaf: ThingLeaf { value: 29 } } },
        },
    })
    let target_leaf: ThingLeaf? = null
    let kind = ThingRef::Plain(thing)
    if let target = thing.get() {
        kind = thing_ref(thing, target)
        target_leaf = target.outer.inner.slot.leaf
    }
    match kind {
        ThingRef::Flagged(entity) => assert(entity == thing),
        _ => assert(false),
    }
    if let leaf = target_leaf {
        assert_eq(leaf.value, 29)
    } else { assert(false) }
    let _ = arena_destroy(rows)
    let _ = __arena_drain_retired()
}
