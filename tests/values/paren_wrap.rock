// Regression coverage for `(value_returning_call())` — i.e. a parenthesized
// value-returning call in a Lua single-value slot (let-RHS, field access,
// arg position). Paren is semantically transparent, but
// `generate_expr_emit` in rock/src/backend/lua/value_types.rs must peek
// through it for every arm — not just BinOp — otherwise the scalarized
// multi-return gets collapsed to its first scalar by Lua's parentheses
// rule, and indexing the result crashes at runtime.

value V2 {
    x: int,
    y: int,
}

fn make_v2(a: int, b: int) -> V2 {
    return V2 { x: a, y: b }
}

fn take_v2(v: V2) -> int {
    return v.x * 100 + v.y
}

@test(output = "3\n4")
fn test_paren_let_rhs() {
    let r = (make_v2(3, 4))
    print(r.x)
    print(r.y)
}

@test(output = "5")
fn test_paren_field_access() {
    let x = (make_v2(5, 9)).x
    print(x)
}

@test(output = "708")
fn test_paren_arg_position() {
    let n = take_v2((make_v2(7, 8)))
    print(n)
}

// Double-parens: `((make_v2()))`. Paren nodes are preserved (not flattened)
// by the parser, so the unwrap must peek through all layers, not just one.
@test(output = "11\n22")
fn test_double_paren_let_rhs() {
    let r = ((make_v2(11, 22)))
    print(r.x)
    print(r.y)
}

// Paren around a value-typed Ident in a let-RHS: the Ident arm must
// also see the inner.
@test(output = "99\n5")
fn test_paren_ident_passthrough() {
    let src = make_v2(99, 5)
    let copy = (src)
    print(copy.x)
    print(copy.y)
}
