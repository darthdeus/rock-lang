// Reads through a `ref` to a flat-stored container element (Vec value
// columns, strided `nobox` rows): the whole value, a nested value field and a
// leaf, through a `ref` parameter, a `ref` passed on to a generic and a `ref`
// result. A read after a write through the same `ref` sees the write; a value
// read before it keeps the old leaves. tests/values/flat_element_ref.rock
// covers the writes themselves.

value FrInner { v: int }
value FrCell { inner: FrInner, w: int }
nobox value FrQ2 { x: float, y: float }
nobox value FrWide { kind: int, at: FrQ2, a: int, b: int, c: int }

fn fr_inner_v(i: FrInner) -> int { return i.v }
fn fr_q_sum(q: FrQ2) -> float { return q.x * 100.0 + q.y }
fn fr_id<T>(x: T) -> T { return x }

fn fr_descend(c: ref FrCell, n: int) -> ref FrCell {
    if n == 0 { return c }
    return fr_descend(c, n - 1)
}

fn fr_cells() -> [FrCell] {
    let xs: [FrCell] = []
    xs.push(FrCell { inner: FrInner { v: 1 }, w: 2 })
    xs.push(FrCell { inner: FrInner { v: 3 }, w: 4 })
    return xs
}

fn fr_snapshot_then_bump(c: ref FrCell) -> FrCell {
    let copy = FrCell { inner: c.inner, w: c.w }
    c.w += 1
    return copy
}

fn fr_nested_reads_around_a_write(c: ref FrCell) -> int {
    let before = fr_inner_v(c.inner)
    c.inner.v += 5
    return before * 100 + fr_inner_v(c.inner)
}

// Equality reads the whole element before and after a write through `c`.
fn fr_equal_before_and_after(c: ref FrCell) -> (bool, bool) {
    let before = c == FrCell { inner: FrInner { v: 3 }, w: 4 }
    c.w = 40
    let after = c == FrCell { inner: FrInner { v: 3 }, w: 40 }
    return (before, after)
}

// A `ref` handed through a generic identity still addresses the element.
fn fr_alias_sees_write(c: ref FrCell) -> int {
    let r = fr_id(c)
    c.w += 10
    return r.w
}

// No flat argument, but the result addresses an Arena value column.
fn fr_borrow(a: Arena<FrCell>, e: Entity<FrCell>) -> (ref FrCell)? {
    return a.borrow(e)
}

fn fr_bump(c: ref FrCell) { c.w += 1 }

// A tuple result with a table-held leaf returns through the flat variant.
fn fr_label_and_bump(c: ref FrCell) -> (string, int) {
    c.w += 1
    return ("w{c.w}", c.inner.v)
}

fn fr_wide_rewrite(r: ref FrWide) -> float {
    let before = r.at
    r.b = 100
    r.at.y = 0.5
    r.c += 1
    return before.y * 1000.0 + fr_q_sum(r.at)
}

@test
fn fr_value_read_before_a_write_keeps_the_old_leaves() {
    let xs = fr_cells()
    let copy = fr_snapshot_then_bump(xs[0])
    assert_eq(copy.w, 2, "the value read keeps the old leaf")
    assert_eq(copy.inner.v, 1, "the value read keeps the old nested leaf")
    assert_eq(xs[0].w, 3, "the element took the write")
    assert_eq(xs[1].w, 4, "the neighbour is unchanged")
}

@test
fn fr_nested_value_reads_see_the_write_between_them() {
    let xs = fr_cells()
    assert_eq(fr_nested_reads_around_a_write(xs[1]), 308, "nested reads before and after")
    assert_eq(xs[1].inner.v, 8, "the nested write landed")
    assert_eq(xs[1].w, 4, "the sibling leaf is unchanged")
}

@test
fn fr_whole_element_equality_reads_the_current_leaves() {
    let xs = fr_cells()
    let (before, after) = fr_equal_before_and_after(xs[1])
    assert(before, "the whole read matches the stored element")
    assert(after, "the whole read after the write matches the new element")
    assert_eq(xs[1].w, 40, "the element took the write")
}

@test
fn fr_ref_through_a_generic_identity_aliases_the_element() {
    let xs = fr_cells()
    assert_eq(fr_alias_sees_write(xs[0]), 12, "the alias reads the write")
    assert_eq(xs[0].w, 12, "the element took the write")
    assert_eq(xs[1].w, 4, "the neighbour is unchanged")
}

@test
fn fr_ref_results_read_whole_nested_and_leaf_values() {
    let xs = fr_cells()
    assert_eq(fr_inner_v(fr_descend(xs[1], 3).inner), 3, "nested value of a ref result")
    assert_eq(fr_descend(xs[1], 2).w, 4, "leaf of a ref result")
    assert(fr_descend(xs[1], 2) == FrCell { inner: FrInner { v: 3 }, w: 4 }, "whole ref result")
    assert(fr_descend(xs[0], 1) != FrCell { inner: FrInner { v: 3 }, w: 4 }, "the other element")
}

@test
fn fr_strided_row_reads_around_writes() {
    let ws: [FrWide] = vec_new_with_capacity(4)
    ws.push(FrWide { kind: 1, at: FrQ2 { x: 1.0, y: 2.0 }, a: 3, b: 4, c: 5 })
    ws.push(FrWide { kind: 6, at: FrQ2 { x: 7.0, y: 8.0 }, a: 9, b: 10, c: 11 })
    assert_eq(fr_wide_rewrite(ws[1]), 8700.5, "nested reads before and after")
    assert_eq(ws[1].b, 100, "the row holds the write")
    assert_eq(ws[1].c, 12, "the row holds the compound write")
    assert_eq(ws[1].at.x, 7.0, "the nested sibling is unchanged")
    assert_eq(ws[0].b, 4, "the neighbouring row is unchanged")
}

@test
fn fr_ref_result_of_a_call_without_flat_arguments_writes_the_element() {
    let a: Arena<FrCell> = arena_new()
    let first = a.insert(FrCell { inner: FrInner { v: 1 }, w: 2 })
    let second = a.insert(FrCell { inner: FrInner { v: 3 }, w: 4 })
    let c = fr_borrow(a, first)
    if c != null { fr_bump(c) }
    assert_eq(first.get().unwrap().w, 3, "the borrowed element took the write")
    assert_eq(second.get().unwrap().w, 4, "the other element is unchanged")
}

@test
fn fr_tuple_result_with_a_string_reads_after_the_write() {
    let xs = fr_cells()
    let (label, v) = fr_label_and_bump(xs[1])
    assert_eq(label, "w5", "the string leaf reads the write")
    assert_eq(v, 3, "the int leaf")
    assert_eq(xs[1].w, 5, "the element took the write")
}
