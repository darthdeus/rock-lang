// `==` on value structs compares contents, whichever route it takes: a
// per-type native `==`, leaf-wise comparison of scalarized operands, or the
// structural walk.

value V2 { x: float, y: float }
value Wrap { tag: int, name: string }
value Handle<T> { slot: int, generation: int }

fn make(tag: string, x: float, y: float) -> V2 {
    print(tag)
    return V2 { x: x, y: y }
}

@test(output = "lhs\nrhs\ntrue")
fn each_operand_is_evaluated_once() {
    print(make("lhs", 1.0, 2.0) == make("rhs", 1.0, 2.0))
}

fn eq_scalar(ax: float, ay: float, bx: float, by: float) -> bool {
    return V2 { x: ax, y: ay } == V2 { x: bx, y: by }
}

fn ne_scalar(ax: float, ay: float, bx: float, by: float) -> bool {
    return V2 { x: ax, y: ay } != V2 { x: bx, y: by }
}

fn eq_gc_same_ref(tag: int) -> bool {
    let n = "shared"
    return Wrap { tag: tag, name: n } == Wrap { tag: tag, name: n }
}

fn ne_gc_different_tag(tag_a: int, tag_b: int) -> bool {
    let n = "shared"
    return Wrap { tag: tag_a, name: n } != Wrap { tag: tag_b, name: n }
}

@test(output = "true false true false true true")
fn scalar_and_gc_carrying_values_compare_contents() {
    print("{eq_scalar(1.0, 2.0, 1.0, 2.0)} {eq_scalar(1.0, 2.0, 1.0, 3.0)} {ne_scalar(1.0, 2.0, 1.0, 3.0)} {ne_scalar(1.0, 2.0, 1.0, 2.0)} {eq_gc_same_ref(5)} {ne_gc_different_tag(5, 6)}")
}

fn same(x: Handle<int>, y: Handle<int>) -> bool { return x == y }
fn differ(x: Handle<int>, y: Handle<int>) -> bool { return x != y }

fn handle_eq(a: int, b: int, c: int, d: int) -> bool {
    let x: Handle<int> = Handle { slot: a, generation: b }
    return same(x, Handle { slot: c, generation: d })
}

fn handle_ne(a: int, b: int, c: int, d: int) -> bool {
    let x: Handle<int> = Handle { slot: a, generation: b }
    return differ(x, Handle { slot: c, generation: d })
}

@test(output = "true false false false true")
fn leaf_wise_equality_compares_every_field() {
    print("{handle_eq(1, 2, 1, 2)} {handle_eq(1, 2, 1, 3)} {handle_eq(1, 2, 4, 2)} {handle_ne(1, 2, 1, 2)} {handle_ne(1, 2, 1, 3)}")
}

// A C-layout `value` stores `float` leaves as single precision, so leaves read
// back from storage are rounded while a scalarized operand's leaves are not.
value Tint { r: float, g: float, n: int }
struct TintHolder { tint: Tint? = null }

fn same_tint(h: TintHolder, t: Tint) -> bool { return h.tint.unwrap() == t }
fn differ_tint(h: TintHolder, t: Tint) -> bool { return h.tint.unwrap() != t }

fn stored_float_eq(r: float, g: float) -> bool {
    let h = TintHolder {}
    h.tint = Tint { r: r, g: g, n: 3 }
    return same_tint(h, Tint { r: r, g: g, n: 3 })
}

fn stored_float_ne(r: float, g: float) -> bool {
    let h = TintHolder {}
    h.tint = Tint { r: r, g: g, n: 3 }
    return differ_tint(h, Tint { r: r, g: g, n: 3 })
}

@test(output = "true false true")
fn a_stored_float_value_equals_a_fresh_operand() {
    print("{stored_float_eq(0.4, 0.1)} {stored_float_ne(0.4, 0.1)} {stored_float_eq(0.5, 0.25)}")
}

value Child { name: string, amount: int }
value Parent { name: string, child: Child? = null }
struct Holder { row: Parent }
fn same_row(a: Holder, b: Holder) -> bool { return a.row == b.row }

struct Reference { name: string }
value ReferenceParent { child: Reference? = null }
struct ReferenceHolder { row: ReferenceParent }
fn same_reference(a: ReferenceHolder, b: ReferenceHolder) -> bool { return a.row == b.row }

fn row(amount: int) -> Holder {
    return Holder { row: Parent { name: "parent", child: Child { name: "child", amount: amount } } }
}
fn absent() -> Holder { return Holder { row: Parent { name: "parent" } } }
fn reference_row(r: Reference) -> ReferenceHolder {
    return ReferenceHolder { row: ReferenceParent { child: r } }
}

// Nullable value fields compare contents; nullable reference fields keep
// reference identity.
@test(output = "true false true false true false")
fn nullable_fields_in_enclosing_values() {
    let a = row(3)
    let r = Reference { name: "same" }
    let shared = same_reference(reference_row(r), reference_row(r))
    let fresh = same_reference(reference_row(r), reference_row(Reference { name: "same" }))
    print("{same_row(a, row(3))} {same_row(a, row(4))} {same_row(absent(), absent())} {same_row(a, absent())} {shared} {fresh}")
}
