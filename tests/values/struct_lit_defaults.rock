// Sentinel for value-struct literal with declaration defaults.
// Ported through ANF lowerer (Bucket A — Inc 4):
// `value V { x: int, y: int = 6 }` lit `V { x: 1 }` injects the
// `y: 6` declaration default at the scalar-emission path.
value V3 { x: int = 5, y: int = 6 }

@test(output = "5, 6")
fn anf_value_struct_lit_all_defaults() {
    let v = V3 { }
    print("{v.x}, {v.y}")
}

@test(output = "7, 6")
fn anf_value_struct_lit_partial_default() {
    let v = V3 { x: 7 }
    print("{v.x}, {v.y}")
}

@test(output = "5, 8")
fn anf_value_struct_lit_partial_default_other() {
    let v = V3 { y: 8 }
    print("{v.x}, {v.y}")
}
