// A multi-return receive is read in place, not copied into a second set of
// locals (single_receive_cells in skull-codegen-lua). Each shape here must not
// qualify, or must still read the latest value.
nobox value W { a: float, b: float, c: float, d: float, e: float, f: float }

fn mk(x: float) -> W {
    return W { a: x, b: x + 1.0, c: x + 2.0, d: x + 3.0, e: x + 4.0, f: x + 5.0 }
}

fn bump(w: W) -> W {
    return W { a: w.a + 10.0, b: w.b, c: w.c, d: w.d, e: w.e, f: w.f + 10.0 }
}

fn param_receive(w: W) -> float {
    let before = w.f
    w = mk(50.0)
    return before + w.a
}

struct Holder { w: W }

co fn co(out: [float]) -> Coroutine<int, int, ()> {
    let w = mk(4.0)
    out.push(w.a)
    yield 1
    out.push(w.f)
    return 0
}

@test fn straight_line_receives() {
    // A load before the receive in the same block, used after it.
    let e = mk(1.0)
    let old = e.a
    e = mk(100.0)
    assert_eq(old + e.f, 106.0)
    assert_eq(param_receive(mk(1.0)), 56.0)
    // Two receives into the same cells in different branches.
    let b = mk(0.0)
    if b.a < 1.0 {
        b = mk(2.0)
    } else {
        b = mk(7.0)
    }
    assert_eq(b.a + b.f + b.c, 13.0)
    let cl = mk(2.0)
    let f = () => cl.f
    cl = mk(0.0)
    assert_eq(f() + cl.a, 5.0)
    let ch = mk(1.0)
    let s = ch.a
    ch = bump(ch)
    s += ch.a
    ch = bump(ch)
    s += ch.f
    assert_eq(s, 38.0)
    let w1 = mk(1.0)
    let w2 = mk(10.0)
    let t = w1.f + w2.a
    let w3 = mk(w1.a + w2.f)
    assert_eq(t + w3.a + w3.f + w1.a + w2.b, 65.0)
    let st = mk(3.0)
    let h = Holder { w: st }
    st = mk(0.0)
    assert_eq(h.w.f + st.a, 8.0)
    let out: [float] = []
    let c = co(out)
    let _ = c.resume()
    let _ = c.resume()
    assert_eq(out[0] + out[1], 13.0)
}

@test fn loop_receives() {
    // A value read from a receive survives to the next iteration in a cell.
    let acc = 0.0
    let prev = 0.0
    let i = 0
    while i < 3 {
        let w = mk(float(i))
        acc += prev
        prev = w.f
        i += 1
    }
    assert_eq(acc + prev, 18.0)
    let b = mk(1.0)
    let n = 0
    for j in 0..(b.f as int) {
        n += 1
    }
    assert_eq(n, 6)
}
