// A value-returning call wrapped in a transparent wrapper -- parentheses, a
// `::` ascription, or an identity `as` cast -- must still deliver the whole
// value in every single-value slot. A dropped wrapper peel truncated the
// scalar multi-return to its first leaf (`attempt to index a number value`).
// A non-identity `as` (float to int) is not transparent and keeps its
// conversion. Each test covers one slot with every wrapper form.

value V2 {
    x: int,
    y: int,
}

value IRect {
    x: int,
    y: int,
    w: int,
    h: int,
}

fn make_v2() -> V2 {
    return V2 { x: 10, y: 20 }
}

fn make_rect() -> IRect {
    return IRect { x: 1, y: 2, w: 3, h: 4 }
}

fn __op_add(a: V2, b: V2) -> V2 {
    return V2 { x: a.x + b.x, y: a.y + b.y }
}

fn take_rect_int(a: IRect, b: int) -> int {
    return a.w + b
}

fn three_v2(a: V2, b: V2, c: int) -> int {
    return a.x + b.x + c
}

struct Holder {
    v: V2,
    r: IRect,
}

@test fn let_rhs() {
    let a = make_rect() :: IRect
    assert_eq(a.w, 3)
    assert_eq(a.h, 4)
    let b = (make_rect())
    assert_eq(b.w, 3)
    assert_eq(b.h, 4)
    let c = make_rect() as IRect
    assert_eq(c.w, 3)
    assert_eq(c.h, 4)
    let f = (make_rect() :: IRect)
    assert_eq(f.w, 3)
    let h = make_rect() :: IRect :: IRect
    assert_eq(h.w, 3)
    let v = (((make_v2() :: V2) as V2) :: V2)
    assert_eq(v.x, 10)
    assert_eq(v.y, 20)
}

@test fn nonlast_arg() {
    assert_eq(take_rect_int(make_rect() :: IRect, 7), 10)
    assert_eq(take_rect_int((make_rect()), 7), 10)
    assert_eq(take_rect_int(make_rect() as IRect, 7), 10)
    assert_eq(three_v2(make_v2() :: V2, make_v2(), 100), 120)
    assert_eq(three_v2(make_v2() as V2, make_v2(), 100), 120)
    assert_eq(three_v2(make_v2(), make_v2() :: V2, 100), 120)
    assert_eq(three_v2(make_v2(), make_v2() as V2, 100), 120)
}

@test fn field_access() {
    assert_eq((make_rect() :: IRect).w, 3)
    assert_eq((make_rect()).w, 3)
    assert_eq((make_rect() as IRect).w, 3)
    let s = (make_rect() :: IRect).w + (make_rect() :: IRect).h
    assert_eq(s, 7)
}

@test fn binop_operand() {
    let a = (make_v2() :: V2) + make_v2()
    assert_eq(a.x, 20)
    assert_eq(a.y, 40)
    let b = make_v2() + (make_v2() :: V2)
    assert_eq(b.x, 20)
    assert_eq(b.y, 40)
    let c = (make_v2() as V2) + make_v2()
    assert_eq(c.x, 20)
    let d = make_v2() + (make_v2() as V2)
    assert_eq(d.y, 40)
}

@test fn struct_literal_field() {
    let h = Holder { v: make_v2() :: V2, r: make_rect() }
    assert_eq(h.v.x, 10)
    assert_eq(h.r.w, 3)
    let g = Holder { v: make_v2() as V2, r: make_rect() as IRect }
    assert_eq(g.v.y, 20)
    assert_eq(g.r.h, 4)
}

@test fn if_branch_ascription() {
    let flag = true
    let v = if flag { make_v2() :: V2 } else { make_v2() }
    assert_eq(v.x, 10)
    assert_eq(v.y, 20)
}

@test fn reassign() {
    let v = V2 { x: 0, y: 0 }
    v = make_v2() :: V2
    assert_eq(v.x, 10)
    v = make_v2() as V2
    assert_eq(v.y, 20)
}

@test fn nullable_let() {
    let a: V2? = make_v2() :: V2
    let b: V2? = make_v2() as V2
    if a != null && b != null {
        assert_eq(a.x, 10)
        assert_eq(a.y, 20)
        assert_eq(b.x, 10)
        assert_eq(b.y, 20)
    } else {
        assert(false)
    }
}

@test fn lambda_body() {
    let f = () => make_v2() :: V2
    let a = f()
    assert_eq(a.x, 10)
    assert_eq(a.y, 20)
    let g = () => make_v2() as V2
    let b = g()
    assert_eq(b.x, 10)
    assert_eq(b.y, 20)
}

@test fn container_elements() {
    let xs = [make_v2() :: V2, make_v2()]
    assert_eq(xs[0].x, 10)
    assert_eq(xs[1].y, 20)
    let ys = [make_v2() as V2, make_v2()]
    assert_eq(ys[0].x, 10)
    let t = (make_v2() :: V2, make_v2(), 42)
    assert_eq(t.0.x, 10)
    assert_eq(t.1.y, 20)
    assert_eq(t.2, 42)
    let pushed: [V2] = []
    pushed.push(make_v2() :: V2)
    pushed.push(make_v2() as V2)
    assert_eq(pushed[0].x, 10)
    assert_eq(pushed[1].y, 20)
    let m: Map<int, V2> = map_new()
    m[0] = make_v2() :: V2
    m[1] = make_v2() as V2
    assert_eq(m[0].x, 10)
    assert_eq(m[1].y, 20)
}

fn _ret_asc() -> V2 { return make_v2() :: V2 }
fn _ret_as() -> V2 { return make_v2() as V2 }

@test fn return_stmt() {
    let a = _ret_asc()
    assert_eq(a.x, 10)
    assert_eq(a.y, 20)
    let b = _ret_as()
    assert_eq(b.x, 10)
    assert_eq(b.y, 20)
}

@test fn match_leaf() {
    let a = match 1 {
        1 => make_v2() :: V2,
        _ => make_v2(),
    }
    assert_eq(a.x, 10)
    assert_eq(a.y, 20)
    let b = match 1 {
        1 => make_v2() as V2,
        _ => make_v2(),
    }
    assert_eq(b.x, 10)
    assert_eq(b.y, 20)
}

fn _v2_sum(v: V2) -> int { return v.x + v.y }

@test fn ufcs_receiver() {
    assert_eq((make_v2() :: V2)._v2_sum(), 30)
    assert_eq((make_v2() as V2)._v2_sum(), 30)
}

fn _v2_lit(x: int, y: int) -> V2 { return V2 { x: x, y: y } }
fn _v2_add(a: V2, b: V2) -> V2 { return a + b }
fn _v2_sum2(v: V2, k: int) -> int { return v.x + v.y + k }

// The operator result is itself a scalar multi-return before the wrapper.
@test fn wrapped_binop_result() {
    let v = ((_v2_add(_v2_lit(1, 2), _v2_lit(3, 4))) :: V2)
    assert_eq(v.x, 4)
    assert_eq(v.y, 6)
    assert_eq(_v2_sum2((_v2_lit(1, 2) + _v2_lit(3, 4)) :: V2, 100), 110)
    assert_eq(((_v2_lit(1, 2) + _v2_lit(3, 4)) as V2).x, 4)
    let a = ((make_v2() + make_v2()) :: V2) :: V2
    assert_eq(a.x, 20)
    assert_eq(a.y, 40)
}

co fn _co_yields() -> Coroutine<V2> {
    yield make_v2() :: V2
    yield make_v2() as V2
}

@test fn coroutine_yield_wrapped() {
    let c = _co_yields()
    let a = c.resume()
    let b = c.resume()
    if a != null && b != null {
        assert_eq(a.x, 10)
        assert_eq(b.y, 20)
    } else {
        assert(false)
    }
}

fn _maybe_v2(yes: bool) -> V2? {
    if yes { return make_v2() }
    return null
}

@test fn coalesce_rhs() {
    let a = _maybe_v2(false) ?? (make_v2() :: V2)
    assert_eq(a.x, 10)
    let b = _maybe_v2(false) ?? (make_v2() as V2)
    assert_eq(b.y, 20)
}

@test fn vec_map_wrapped_return() {
    let xs = [1, 2, 3]
    let ys: [V2] = xs.iter().map(i => V2 { x: i, y: i * 2 } :: V2).collect()
    assert_eq(ys[0].x, 1)
    assert_eq(ys[1].y, 4)
    assert_eq(ys[2].x, 3)
}

fn _take_int(i: int) -> int { return i }

@test fn non_identity_as_keeps_its_conversion() {
    assert_eq(5.7 as int, 5)
    assert_eq(_take_int(3.9 as int), 3)
    assert_eq((3.9 as int) as int, 3)
    let v = V2 { x: 5.7 as int, y: 3.9 as int } :: V2
    assert_eq(v.x, 5)
    assert_eq(v.y, 3)
}

value _Line { a: V2, b: V2 }

fn _make_line() -> _Line {
    return _Line { a: V2 { x: 1, y: 2 }, b: V2 { x: 3, y: 4 } }
}

fn _take_line_k(l: _Line, k: int) -> int { return l.a.x + l.b.y + k }

@test fn nested_value() {
    let l = _make_line() :: _Line
    assert_eq(l.a.x, 1)
    assert_eq(l.b.y, 4)
    assert_eq((_make_line() as _Line).b.y, 4)
    assert_eq(_take_line_k(_make_line() :: _Line, 100), 105)
}

// A value literal whose fields are value-returning calls packs each field,
// with or without a wrapper.
value _Path { start: V2, end: V2 }

fn _make_path_bare() -> _Path {
    return _Path { start: make_v2(), end: make_v2() }
}

fn _make_path_ascription() -> _Path {
    return _Path { start: make_v2() :: V2, end: make_v2() }
}

fn _make_path_as() -> _Path {
    return _Path { start: make_v2() as V2, end: make_v2() as V2 }
}

@test fn nested_struct_literal_field_calls() {
    let a = _make_path_bare()
    assert_eq(a.start.x, 10)
    assert_eq(a.end.y, 20)
    let b = _make_path_ascription()
    assert_eq(b.start.x, 10)
    assert_eq(b.end.y, 20)
    let c = _make_path_as()
    assert_eq(c.start.x, 10)
    assert_eq(c.end.y, 20)
}

@test fn deep_compound_mixed_wrappers() {
    let v = (((make_v2() :: V2) + (make_v2() as V2)) :: V2)
        + ((make_v2() as V2) :: V2)
    assert_eq(v.x, 30)
    assert_eq(v.y, 60)
}

@test fn if_and_match_in_nonlast_arg() {
    let flag = true
    assert_eq(_v2_sum2(if flag { make_v2() :: V2 } else { make_v2() }, 100), 130)
    let k = 1
    let r = _v2_sum2(match k {
        1 => make_v2() :: V2,
        _ => make_v2(),
    }, 100)
    assert_eq(r, 130)
}

@test fn lambda_call_result() {
    let f = () => make_v2()
    let a = f() :: V2
    assert_eq(a.x, 10)
    assert_eq(a.y, 20)
    let b = f() as V2
    assert_eq(b.x, 10)
    assert_eq(b.y, 20)
}

value _Poly { p1: _Path, p2: _Path }

@test fn three_level_nested_wrapped() {
    let z = _Poly {
        p1: _Path { start: make_v2() :: V2, end: make_v2() as V2 },
        p2: _make_path_ascription() :: _Path,
    }
    assert_eq(z.p1.start.x, 10)
    assert_eq(z.p2.end.y, 20)
}
