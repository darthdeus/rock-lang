// Flat vecs of value structs, element reads, spreads and recursive storage.

value RayTarget { angle: float, x: float, y: float }

@test(output = "0\n3\n7\n2\n42")
fn test_flat_vec_push_get_len() {
    let rays: FlatVec<RayTarget> = flat_vec_new(2)
    print("{rays.len}")

    rays.push(RayTarget { angle: 0.5, x: 1.0, y: 2.0 })
    rays.push(RayTarget { angle: 0.1, x: 3.0, y: 4.0 })
    rays.push(RayTarget { angle: 0.9, x: 5.0, y: 6.0 })
    print("{rays.len}")

    // The grown buffer preserved every element field-wise.
    let sum = rays.get(0).x + rays.get(1).x + rays.get(2).x
    print("{(sum - 2.0).floor()}")

    rays.set(1, RayTarget { angle: 0.1, x: 30.0, y: 40.0 })
    print("{(rays.get(1).x - 28.0).floor()}")

    rays.clear()
    rays.push(RayTarget { angle: 0.0, x: 42.0, y: 0.0 })
    print("{rays.get(0).x.floor()}")
}

@test(output = "0.1\n0.5\n0.9")
fn test_flat_vec_sort_non_capturing() {
    let rays: FlatVec<RayTarget> = flat_vec_new(4)
    rays.push(RayTarget { angle: 0.9, x: 0.0, y: 0.0 })
    rays.push(RayTarget { angle: 0.1, x: 0.0, y: 0.0 })
    rays.push(RayTarget { angle: 0.5, x: 0.0, y: 0.0 })

    rays.sort((t) => t.angle)

    for i in 0..rays.len {
        print("{rays.get(i).angle}")
    }
}

// Descending input -- the insertion-sort worst case, where every element shifts
// the whole prefix. The pivot is held across those shifts, so this is what goes
// wrong if a whole-value element read binds interior storage instead of copying:
// the shift overwrites the slot the pivot came from and the sort loses elements.
@test(output = "1\n2\n3\n4\n5\n15")
fn test_flat_vec_sort_pivot_survives_shifts() {
    let rays: FlatVec<RayTarget> = flat_vec_new(8)
    for i in 0..5 {
        let k = (5 - i) as float
        rays.push(RayTarget { angle: k, x: k, y: k })
    }

    rays.sort((t) => t.angle)

    let sum = 0.0
    for i in 0..rays.len {
        print("{rays.get(i).angle.floor()}")
        sum = sum + rays.get(i).x
    }
    print("{sum.floor()}")
}

// fv[i] unified-indexing + `for v in fv` sugar over FlatVec<T: value>.
// fv[i] indexes the buf storage (debug capacity-checked; fv.get is the
// len-checked accessor); `for` is a numeric loop over 0..fv.len.

value SV2 { x: float, y: float }

@test
fn flat_vec_index_read_write() {
    let fv: FlatVec<SV2> = flat_vec_new(4)
    fv.push(SV2 { x: 1.0, y: 2.0 })
    fv.push(SV2 { x: 3.0, y: 4.0 })
    fv[0] = SV2 { x: 9.0, y: 8.0 }
    let a = fv[0]
    let b = fv[1]
    assert_eq(a.x, 9.0)
    assert_eq(a.y, 8.0)
    assert_eq(b.x, 3.0)
    assert_eq(fv.len, 2)
}

@test
fn flat_vec_for_iterates_len_not_capacity() {
    let fv: FlatVec<SV2> = flat_vec_new(8)
    fv.push(SV2 { x: 1.0, y: 10.0 })
    fv.push(SV2 { x: 2.0, y: 20.0 })
    fv.push(SV2 { x: 3.0, y: 30.0 })
    let sx = 0.0
    let n = 0
    for v in fv {
        sx = sx + v.x
        n = n + 1
    }
    assert_eq(sx, 6.0)
    assert_eq(n, 3)
}

@test(output = "0 1\n1 2\n2 3\n2 3")
fn flat_vec_enumerate_counts_live_elements() {
    let fv: FlatVec<SV2> = flat_vec_new(8)
    fv.push(SV2 { x: 1.0, y: 10.0 })
    fv.push(SV2 { x: 2.0, y: 20.0 })
    fv.push(SV2 { x: 3.0, y: 30.0 })
    for (i, v) in enumerate(fv) {
        print("{i} {v.x.floor()}")
    }
    let last = 0
    for pair in enumerate(fv) {
        last = pair.0
    }
    print("{last} {fv.get(last).x.floor()}")
}

// `==` over FlatVec<T> compares the first `len` elements by value. Without a
// FlatVec case, __op_eq's generic walk reached the NativeBuffer's cdata
// pointer and compared ADDRESSES: two FlatVecs with equal contents were
// never equal, so a cache keyed on one never hit.

value P2 { x: float, y: float }

fn pair(a: float, b: float, c: float, d: float, cap: int = 4) -> FlatVec<P2> {
    let fv: FlatVec<P2> = flat_vec_new(cap)
    fv.push(P2 { x: a, y: b })
    fv.push(P2 { x: c, y: d })
    return fv
}

@test
fn flat_vec_equality_compares_live_elements_by_value() {
    assert_eq(pair(1.0, 2.0, 3.0, 4.0) == pair(1.0, 2.0, 3.0, 4.0), true, "equal contents")
    let fv = pair(1.0, 2.0, 3.0, 4.0)
    assert_eq(fv == fv, true, "same instance")
    assert_eq(pair(1.0, 2.0, 3.0, 4.0) == pair(1.0, 2.0, 3.0, 5.0), false, "different element")
    let longer = pair(1.0, 2.0, 3.0, 4.0)
    longer.push(P2 { x: 0.0, y: 0.0 })
    assert_eq(pair(1.0, 2.0, 3.0, 4.0) == longer, false, "different len")
    assert_eq(pair(1.0, 2.0, 3.0, 4.0, cap: 4) == pair(1.0, 2.0, 3.0, 4.0, cap: 32), true, "capacity ignored")
    let reused: FlatVec<P2> = flat_vec_new(4)
    reused.push(P2 { x: 9.0, y: 9.0 })
    reused.push(P2 { x: 9.0, y: 9.0 })
    reused.push(P2 { x: 9.0, y: 9.0 })
    reused.clear()
    reused.push(P2 { x: 1.0, y: 2.0 })
    reused.push(P2 { x: 3.0, y: 4.0 })
    assert_eq(reused == pair(1.0, 2.0, 3.0, 4.0), true, "stale elements past len ignored")
    let a: FlatVec<P2> = flat_vec_new(2)
    let b: FlatVec<P2> = flat_vec_new(8)
    assert_eq(a == b, true, "empty vectors")
}

// An element read raises on an out-of-range index even when nothing uses the
// value. Column and strided storage share one VecCheckedIndex per element
// access across their leaf reads; dead-code elimination of the leaves must
// not take the check with them.

nobox value Four { a: int, b: int, c: int, d: int }

nobox value Six { a: int, b: int, c: int, d: int, e: int, f: int }

enum Dense { A(int), B(int, int) }

@nomangle inline(lua) fn raises(f: fn()) -> bool = """
    local ok, err = pcall(f)
    return not ok
"""

@nomangle inline(js) fn raises(f: fn()) -> bool = """
    try { __rock_call(f); return false; } catch (e) { return true; }
"""

@test(output = "true true true true true")
fn unused_out_of_range_reads_raise_on_every_tier() {
    let boxed = raises(() => {
        let xs: [int] = [1]
        let _ = xs[5]
    })
    let columns = raises(() => {
        let xs: [Four] = [Four { a: 1, b: 1, c: 1, d: 1 }]
        let _ = xs[5]
    })
    let dense = raises(() => {
        let xs: [Dense] = [Dense::A(1)]
        let _ = xs[5]
    })
    let rows = raises(() => {
        let xs: [Six] = [Six { a: 1, b: 1, c: 1, d: 1, e: 1, f: 1 }]
        let _ = xs[5]
    })
    let field = raises(() => {
        let xs: [Six] = [Six { a: 1, b: 1, c: 1, d: 1, e: 1, f: 1 }]
        let _ = xs[5].a
    })
    print("{boxed} {columns} {dense} {rows} {field}")
}

value V2 { x: int, y: int }

fn make_v2(x: int, y: int) -> V2 {
    return V2 { x: x, y: y }
}

fn sum2(v: V2) -> int {
    return v.x + v.y
}

@test(output = "3")
fn test_index_field_read() {
    let xs: [V2] = [make_v2(1, 2), make_v2(3, 4)]
    print(xs[0].x + xs[0].y)
}

@test(output = "3")
fn test_index_into_scalar_abi_arg() {
    let xs: [V2] = [make_v2(1, 2), make_v2(3, 4)]
    print(sum2(xs[0]))
}

@test(output = "3, 4")
fn test_value_vec_index() {
    let vs: [V2] = [V2 { x: 1, y: 2 }, V2 { x: 3, y: 4 }]
    let v = vs[1]
    print("{v.x}, {v.y}")
}

@test(output = "1, 2\n3, 4")
fn test_value_vec_for_loop() {
    let vs: [V2] = [V2 { x: 1, y: 2 }, V2 { x: 3, y: 4 }]
    for v in vs {
        print("{v.x}, {v.y}")
    }
}

nobox value Spec { x: float, y: float }

enum Shape { A(Spec), B(Spec) }

struct Holder { id: int, flag: bool, shape: Shape }

@test(output = "17 false 3 5")
fn struct_update_carries_a_flat_enum_field_from_its_physical_slots() {
    let h = Holder { id: 17, flag: true, shape: Shape::A(Spec { x: 3.0, y: 5.0 }) }
    let c = Holder { ..h, flag: false }
    match c.shape {
        Shape::A(s) => print("{c.id} {c.flag} {s.x as int} {s.y as int}"),
        Shape::B(s) => print("wrong {s.x}"),
    }
}

fn consume_shape(id: int, flag: bool, shape: Shape) {
    match shape {
        Shape::A(s) => print("{id} {flag} {s.x as int} {s.y as int}"),
        Shape::B(s) => print("wrong {s.x}"),
    }
}

@test(output = "19 true 7 11")
fn call_spread_carries_a_flat_enum_field_from_its_physical_slots() {
    let h = Holder { id: 19, flag: true, shape: Shape::A(Spec { x: 7.0, y: 11.0 }) }
    consume_shape(..h)
}

struct ChildHolder { p: Spec, id: int }

fn consume_child(p: Spec, id: int) {
    print("{id} {p.x as int} {p.y as int}")
}

@test(output = "31 23 29")
fn call_spread_carries_a_nobox_child_from_its_physical_slots() {
    let h = ChildHolder { p: Spec { x: 23.0, y: 29.0 }, id: 31 }
    consume_child(..h)
}

struct MaybeHolder { p: Spec?, id: int }

fn consume_maybe(p: Spec?, id: int) {
    if p == null {
        print("{id} absent")
        return
    }
    let s = p
    print("{id} {s.x as int} {s.y as int}")
}

@test(output = "43 37 41\n47 absent")
fn call_spread_carries_nullable_nobox_presence_and_leaves() {
    let present = MaybeHolder { p: Spec { x: 37.0, y: 41.0 }, id: 43 }
    let absent = MaybeHolder { p: null, id: 47 }
    consume_maybe(..present)
    consume_maybe(..absent)
}

value RecursiveRefCell { w: int }

fn recursive_ref_first(c: ref RecursiveRefCell, n: int) -> ref RecursiveRefCell {
    if n == 0 { return c }
    return recursive_ref_second(c, n - 1)
}

fn recursive_ref_second(c: ref RecursiveRefCell, n: int) -> ref RecursiveRefCell {
    return recursive_ref_third(c, n)
}

fn recursive_ref_third(c: ref RecursiveRefCell, n: int) -> ref RecursiveRefCell {
    return recursive_ref_first(c, n)
}

fn recursive_ref_write(c: ref RecursiveRefCell) { c.w += 1 }

@test
fn mutually_recursive_ref_returns_settle_on_the_flat_element_storage() {
    let xs: [RecursiveRefCell] = [RecursiveRefCell { w: 7 }, RecursiveRefCell { w: 13 }]
    recursive_ref_write(recursive_ref_first(xs[0], 5))
    assert_eq(xs[0].w, 8)
    assert_eq(xs[1].w, 13)
}
