// String interpolation of value structs: field reads, arithmetic and calls
// inside a placeholder, and whole values (`"{v}"`, nested values, call
// results) rendered as the debug form without truncation. Expected strings
// avoid a literal brace, since that is interpolation syntax in a @test
// annotation.

value V2 { x: int, y: int }

fn make_v2(a: int, b: int) -> V2 {
    return V2 { x: a, y: b }
}

fn __op_add(a: V2, b: V2) -> V2 {
    return V2 { x: a.x + b.x, y: a.y + b.y }
}

// Per-field interp — direct field access, no pack involved.
@test(output = "x=3 y=4")
fn interp_value_field_access() {
    let v = V2 { x: 3, y: 4 }
    print("x={v.x} y={v.y}")
}

// Arithmetic inside the placeholder, with a field access on a
// value-returning call. Pre-fix this path truncated make_v2's
// multi-return to a scalar when bound inside inspect()/tostring().
@test(output = "sum=7")
fn interp_value_call_field_access() {
    print("sum={make_v2(3, 4).x + make_v2(3, 4).y}")
}

// Field access on a value binop that dispatches through the scalar
// ABI. `(a+b).x` must route through the pack-aware emission rather
// than the raw multi-return.
@test(output = "xy=6")
fn interp_value_binop_field_access() {
    let a = V2 { x: 1, y: 2 }
    let b = V2 { x: 3, y: 0 }
    print("xy={(a + b).x + (a + b).y}")
}

// Whole-value interp — the exact `inspect` format is intentionally
// not pinned (it's a LuaJIT/inspect.lua detail), but the output must
// contain the field values so a user debugging sees real data, not
// just the first scalar.
@test
fn interp_whole_value_contains_fields() {
    let v = V2 { x: 42, y: 99 }
    let s = "{v}"
    assert(s.contains("42"), "rendered string should include x value")
    assert(s.contains("99"), "rendered string should include y value")
}

// Same as above but for a value-returning call in the placeholder.
@test
fn interp_whole_value_call_contains_fields() {
    let s = "{make_v2(123, 456)}"
    assert(s.contains("123"), "rendered string should include x from call")
    assert(s.contains("456"), "rendered string should include y from call")
}

value Seg { a: V2, b: V2 }

fn show(v: V2) -> string {
    return "{v}"
}

@test(output = "true")
fn test_value_param_interpoland_renders() {
    let s = show(V2 { x: 3, y: 7 })
    print(s.contains("x: 3"))
}

@test(output = "true")
fn test_value_literal_interpoland_renders() {
    let a = V2 { x: 1, y: 2 }
    let s = "{a}"
    print(s.contains("y: 2"))
}

@test(output = "true")
fn test_nested_value_interpoland_renders() {
    let g = Seg { a: V2 { x: 1, y: 2 }, b: V2 { x: 3, y: 4 } }
    let s = "{g}"
    print(s.contains("Seg"))
}

@test(output = "3-7")
fn test_value_field_interpolands() {
    let v = V2 { x: 3, y: 7 }
    print("{v.x}-{v.y}")
}
