// String interpolation of value structs: field reads, arithmetic and calls
// inside a placeholder, and whole values (`"{v}"`, nested values, call
// results) rendered as the debug form without truncation. Expected strings
// avoid a literal brace, since that is interpolation syntax in a @test
// annotation.

value V2 { x: int, y: int }

fn make_v2(a: int, b: int) -> V2 {
    return V2 { x: a, y: b }
}

fn __op_add(a: V2, b: V2) -> V2 {
    return V2 { x: a.x + b.x, y: a.y + b.y }
}

value Seg { a: V2, b: V2 }

fn show(v: V2) -> string {
    return "{v}"
}

// `(a + b).x` and a field of a value-returning call must not truncate the
// scalar-ABI multi-return to one scalar.
@test(output = "sum=7\nxy=6\n3-7")
fn interp_value_fields_calls_and_whole_values() {
    print("sum={make_v2(3, 4).x + make_v2(3, 4).y}")
    let a = V2 { x: 1, y: 2 }
    let b = V2 { x: 3, y: 0 }
    print("xy={(a + b).x + (a + b).y}")
    let call = "{make_v2(123, 456)}"
    assert(call.contains("123") && call.contains("456"), "whole call result renders every field")
    assert(show(V2 { x: 3, y: 7 }).contains("x: 3"), "value param renders")
    let literal = "{a}"
    assert(literal.contains("x: 1") && literal.contains("y: 2"), "value local renders")
    let g = Seg { a: V2 { x: 1, y: 2 }, b: V2 { x: 3, y: 4 } }
    assert("{g}".contains("Seg"), "nested value renders")
    let v = V2 { x: 3, y: 7 }
    print("{v.x}-{v.y}")
}
