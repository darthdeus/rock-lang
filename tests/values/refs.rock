// `ref` parameters and places: a ref param borrowing a struct place, refs into
// a local whose storage holds a `value` struct (the borrowed root must stay
// whole through the MIR transforms), and refs to a stored value whose field is
// a `nobox` value.
//
// -- Ref params on plain structs --

struct RefTestPlayer {
    hp: int,
}

fn ref_test_set_hp(player: ref RefTestPlayer, hp: int) {
    player.hp = hp
}

fn ref_test_read_hp(player: ref RefTestPlayer) -> int {
    return player.hp
}

@test
fn ref_parameter_borrows_a_struct_place_and_an_entity() {
    let local = RefTestPlayer { hp: 10 }
    ref_test_set_hp(local, 42)
    assert_eq(ref_test_read_hp(local), 42)

    let players: Arena<RefTestPlayer> = arena_new()
    let entity = players.insert(RefTestPlayer { hp: 7 })
    let player = entity.borrow().unwrap()

    ref_test_set_hp(player, 99)

    assert_eq(player.ref_test_read_hp(), 99)
    assert_eq(entity.get().unwrap().hp, 99)
}

value RefTestNamedCell { name: string, w: int }
value RefTestListCell { xs: [int], w: int }
value RefTestMaybeCell { w: int? }

fn ref_test_bump_named(c: ref RefTestNamedCell) { c.w += 1 }
fn ref_test_bump_list(c: ref RefTestListCell) { c.w += 1 }
fn ref_test_set_maybe(c: ref RefTestMaybeCell) { c.w = 9 }

@test
fn borrow_of_a_table_stored_value_element_writes_through() {
    let named: Arena<RefTestNamedCell> = arena_new()
    let a = named.insert(RefTestNamedCell { name: "x", w: 5 })
    ref_test_bump_named(named.borrow(a).unwrap())
    ref_test_bump_named(a.borrow().unwrap())
    assert_eq(named.get(a).unwrap().w, 7)

    let lists: Arena<RefTestListCell> = arena_new()
    let b = lists.insert(RefTestListCell { xs: [], w: 5 })
    ref_test_bump_list(lists.borrow(b).unwrap())
    assert_eq(lists.get(b).unwrap().w, 6)

    let maybes: Arena<RefTestMaybeCell> = arena_new()
    let c = maybes.insert(RefTestMaybeCell { w: 5 })
    ref_test_set_maybe(maybes.borrow(c).unwrap())
    assert_eq(maybes.get(c).unwrap().w ?? 0, 9)
}

// A `ref` (local, argument, or returned place) into a local holding a `value`
// struct writes through an alias the MIR transforms cannot see, so the borrowed
// root cell must stay whole through SROA and copy propagation. Each shape gets
// its own owner local.

value RaQuery {
    head: int = -1,
}

value RaGcQuery {
    head: int = -1,
    free: [int] = [],
}

struct RaGraph {
    query: RaQuery = RaQuery {},
}

struct RaGcGraph {
    query: RaGcQuery = RaGcQuery {},
}

fn ra_set(q: ref RaQuery, v: int) {
    q.head = v
}

fn ra_set_gc(q: ref RaGcQuery, v: int) {
    q.head = v
}

fn seed(n: int) -> int { return n }

@test
fn ref_local_writes_reach_the_owner() {
    let g = RaGraph {}
    let q: ref RaQuery = g.query
    q.head = 3
    assert_eq(g.query.head, 3)

    let r = RaGraph {}
    let rq: ref RaQuery = r.query
    rq.head = seed(7)
    rq.head += 1
    assert_eq(r.query.head, 8)
    assert_eq(rq.head, 8)

    let gc = RaGcGraph {}
    let gq: ref RaGcQuery = gc.query
    gq.head = 3
    gq.free.push(1)
    assert_eq(gc.query.head, 3)
    assert_eq(gc.query.free.len(), 1)

    let s = RaGraph {}
    let before = s.query
    let sq: ref RaQuery = s.query
    sq.head = 5
    assert_eq(before.head, -1)
    assert_eq(s.query.head, 5)

    let p = RaQuery {}
    let pq: ref RaQuery = p
    pq.head = 5
    assert_eq(p.head, 5)

    let o = RaOuter {}
    let oq: ref RaQuery = o.q
    oq.head = 7
    assert_eq(o.q.head, 7)
}

@test
fn ref_local_rebinding_borrows_each_new_place() {
    let first = RaGraph {}
    let second = RaGraph {}
    let q: ref RaQuery = first.query
    q.head = 1
    let before = second.query
    q = second.query
    q.head = 2
    assert_eq(first.query.head, 1)
    assert_eq(second.query.head, 2)
    assert_eq(before.head, -1)

    let local = RaQuery { head: 3 }
    let snapshot = local
    q = local
    q.head = 4
    assert_eq(local.head, 4)
    assert_eq(snapshot.head, 3)
    assert_eq(second.query.head, 2)

    let original: ref RaQuery = first.query
    q = original
    q.head = 5
    assert_eq(first.query.head, 5)
    assert_eq(local.head, 4)
}

value RaOuter {
    q: RaQuery = RaQuery {},
    n: int = 0,
}

@inline
fn ra_graph_set(g: ref RaGraph, v: int) {
    let q: ref RaQuery = g.query
    q.head = v
}

@inline
fn ra_query_of(g: ref RaGraph) -> ref RaQuery {
    return g.query
}

@inline
fn ra_set_inline(q: ref RaQuery, v: int) {
    q.head = v
}

fn ra_query_of_outlined(g: ref RaGraph) -> ref RaQuery {
    return g.query
}

@test
fn ref_param_and_returned_ref_writes_reach_the_owner() {
    let g = RaGraph {}
    ra_set(g.query, 4)
    assert_eq(g.query.head, 4)

    let c = RaGraph {}
    ra_set(c.query, 4)
    let cq = c.query
    assert_eq(cq.head, 4)

    let gc = RaGcGraph {}
    ra_set_gc(gc.query, 4)
    let gq = gc.query
    assert_eq(gq.head, 4)

    let p = RaQuery {}
    ra_set(p, 4)
    assert_eq(p.head, 4)

    let o = RaOuter {}
    ra_set(o.q, 6)
    assert_eq(o.q.head, 6)

    let s = RaGraph {}
    ra_graph_set(s, 8)
    assert_eq(s.query.head, 8)

    let r = RaGraph {}
    let rq: ref RaQuery = ra_query_of(r)
    rq.head = 9
    assert_eq(r.query.head, 9)

    let u = RaGraph {}
    let uq: ref RaQuery = ra_query_of_outlined(u)
    uq.head = 9
    assert_eq(u.query.head, 9)

    let i = RaGraph {}
    ra_set_inline(i.query, 3)
    assert_eq(i.query.head, 3)
}

// A `ref` to a stored `value` whose field is a `nobox` value reaches the row's
// own representation of the child (dotted leaf keys and a presence tag on a
// table parent, leaf-wise on a cdata parent) instead of packing it into a box.

nobox value RnId {
    value: int,
}

nobox value RnPair {
    a: RnId,
    b: int,
}

value RnBinding {
    id: int,
    live: RnId? = null,
}

value RnPlain {
    id: int,
    live: RnId,
}

value RnGcPlain {
    tags: [int] = [],
    live: RnId,
}

value RnNested {
    id: int,
    pair: RnPair? = null,
}

value RnDeep {
    id: int,
    pair: RnPair,
}

struct RnRow {
    binding: RnBinding,
    plain: RnPlain,
    gc: RnGcPlain,
    nested: RnNested,
    deep: RnDeep,
}

fn rn_row(id: int) -> RnRow {
    return RnRow {
        binding: RnBinding { id: id },
        plain: RnPlain { id: id, live: RnId { value: id } },
        gc: RnGcPlain { live: RnId { value: id } },
        nested: RnNested { id: id },
        deep: RnDeep { id: id, pair: RnPair { a: RnId { value: id }, b: id } },
    }
}

fn rn_resume(binding: ref RnBinding, mob: RnId) -> bool {
    if binding.live != null { return false }
    binding.live = mob
    return true
}

fn rn_suspend(binding: ref RnBinding) -> bool {
    if binding.live == null { return false }
    binding.live = null
    return true
}

fn rn_live_value(binding: ref RnBinding) -> int {
    if let live = binding.live {
        return live.value
    }
    return -1
}

fn rn_bump_plain(p: ref RnPlain) -> int {
    let cur = p.live
    p.live = RnId { value: cur.value + 1 }
    return cur.value
}

fn rn_bump_gc(p: ref RnGcPlain) -> int {
    let cur = p.live
    p.live = RnId { value: cur.value + 10 }
    p.tags.push(cur.value)
    return cur.value
}

fn rn_set_pair(n: ref RnNested, v: int) {
    n.pair = RnPair { a: RnId { value: v }, b: v * 2 }
}

fn rn_pair_a(n: ref RnNested) -> int {
    if let pair = n.pair {
        return pair.a.value + pair.b
    }
    return -1
}

fn rn_clear_pair(n: ref RnNested) {
    n.pair = null
}

fn rn_swap_deep(d: ref RnDeep) -> int {
    let old = d.pair
    d.pair = RnPair { a: RnId { value: old.b }, b: old.a.value }
    return old.a.value * 10 + old.b
}

@test
fn ref_nullable_nobox_field_read_write_and_clear_reach_the_row() {
    let rows: [RnRow] = []
    rows.push(rn_row(1))
    let row = rows[0]
    assert_eq(rn_live_value(row.binding), -1)
    assert(rn_resume(row.binding, RnId { value: 7 }))
    assert_eq(rows[0].binding.live.unwrap().value, 7)
    assert_eq(rn_live_value(rows[0].binding), 7)
    assert(!rn_resume(rows[0].binding, RnId { value: 8 }))
    assert_eq(rows[0].binding.live.unwrap().value, 7)
    assert(rn_suspend(row.binding))
    assert(rows[0].binding.live == null)
    assert_eq(rn_live_value(row.binding), -1)
    assert(!rn_suspend(row.binding))
    assert(rn_resume(rows[0].binding, RnId { value: 3 }))
    let before = rows[0].binding
    assert(rn_suspend(rows[0].binding))
    assert_eq(before.live.unwrap().value, 3)
    assert(rows[0].binding.live == null)
}

@test
fn ref_non_nullable_nobox_field_on_scalar_and_gc_parents() {
    let rows: [RnRow] = []
    rows.push(rn_row(4))
    let row = rows[0]
    assert_eq(rn_bump_plain(row.plain), 4)
    assert_eq(rn_bump_plain(rows[0].plain), 5)
    assert_eq(rows[0].plain.live.value, 6)
    assert_eq(rn_bump_gc(row.gc), 4)
    assert_eq(rows[0].gc.live.value, 14)
    assert_eq(rows[0].gc.tags.len(), 1)
    let cur = row.plain.live
    row.plain.live = RnId { value: cur.value + 10 }
    assert_eq(rows[0].plain.live.value, 16)
    assert_eq(cur.value, 6)
}

@test
fn ref_nested_nobox_in_nullable_nobox_field() {
    let rows: [RnRow] = []
    rows.push(rn_row(5))
    let row = rows[0]
    assert_eq(rn_pair_a(row.nested), -1)
    rn_set_pair(row.nested, 3)
    assert_eq(rows[0].nested.pair.unwrap().a.value, 3)
    assert_eq(rn_pair_a(rows[0].nested), 9)
    rn_clear_pair(row.nested)
    assert(rows[0].nested.pair == null)
    assert_eq(rn_pair_a(row.nested), -1)
}

@test
fn ref_nested_nobox_field_of_a_cdata_parent() {
    let rows: [RnRow] = []
    rows.push(rn_row(6))
    rows[0].deep.pair = RnPair { a: RnId { value: 1 }, b: 2 }
    let row = rows[0]
    assert_eq(rn_swap_deep(row.deep), 12)
    assert_eq(rows[0].deep.pair.a.value, 2)
    assert_eq(rows[0].deep.pair.b, 1)
    assert_eq(rn_swap_deep(rows[0].deep), 21)
    assert_eq(rows[0].deep.pair.a.value, 1)
}

// -- Frame-reference uses the borrow rules accept --

value RefRulePosition { x: int }
struct RefRulePlayer { position: RefRulePosition, hp: int }
global REF_RULE_ORIGIN: RefRulePosition = RefRulePosition { x: 5 }

fn ref_rule_move(position: ref RefRulePosition) { position.x = 2 }
fn ref_rule_same(position: ref RefRulePosition) -> ref RefRulePosition { return position }
fn ref_rule_damage(player: RefRulePlayer) { player.hp = 1 }

fn ref_rule_retain(player: ref RefRulePlayer) {
    let from_player: ref RefRulePosition = ref_rule_same(player.position)
    let from_global: ref RefRulePosition = REF_RULE_ORIGIN
    from_player.x = from_global.x
}

fn ref_rule_damage_through(player: ref RefRulePlayer) { ref_rule_damage(player) }

// A Vec element lives through an immediate ref call (the later push is no
// hazard); subfields of a ref input and globals are frame-stable, so they can
// be retained; an explicit ref fills an identity parameter.
@test(output = "2\n2\n5\n1")
fn frame_reference_uses_the_borrow_rules_accept() {
    let positions = [RefRulePosition { x: 1 }]
    ref_rule_move(positions[0])
    positions.push(RefRulePosition { x: 3 })
    print(positions[0].x)
    print(positions.len())
    let player = RefRulePlayer { position: RefRulePosition { x: 0 }, hp: 3 }
    ref_rule_retain(player)
    print(player.position.x)
    let other = RefRulePlayer { position: RefRulePosition { x: 0 }, hp: 3 }
    ref_rule_damage_through(other)
    print(other.hp)
}
