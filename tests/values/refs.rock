// `ref` parameters and places: a ref param borrowing a struct place, refs into
// a local whose storage holds a `value` struct (the borrowed root must stay
// whole through the MIR transforms), and refs to a stored value whose field is
// a `nobox` value.
//
// -- Ref params on plain structs --

struct RefTestPlayer {
    hp: int,
}

fn ref_test_set_hp(player: ref RefTestPlayer, hp: int) {
    player.hp = hp
}

fn ref_test_read_hp(player: ref RefTestPlayer) -> int {
    return player.hp
}

@test
fn ref_parameter_borrows_a_struct_place() {
    let player = RefTestPlayer { hp: 10 }
    ref_test_set_hp(player, 42)
    assert_eq(ref_test_read_hp(player), 42)
}

@test
fn entity_borrow_resolves_a_frame_reference() {
    let players: Arena<RefTestPlayer> = arena_new()
    let entity = players.insert(RefTestPlayer { hp: 7 })
    let player = entity.borrow().unwrap()

    ref_test_set_hp(player, 99)

    assert_eq(player.ref_test_read_hp(), 99)
    assert_eq(entity.get().unwrap().hp, 99)
}

value RefTestNamedCell { name: string, w: int }
value RefTestListCell { xs: [int], w: int }
value RefTestMaybeCell { w: int? }

fn ref_test_bump_named(c: ref RefTestNamedCell) { c.w += 1 }
fn ref_test_bump_list(c: ref RefTestListCell) { c.w += 1 }
fn ref_test_set_maybe(c: ref RefTestMaybeCell) { c.w = 9 }

@test
fn borrow_of_a_table_stored_value_element_writes_through() {
    let named: Arena<RefTestNamedCell> = arena_new()
    let a = named.insert(RefTestNamedCell { name: "x", w: 5 })
    ref_test_bump_named(named.borrow(a).unwrap())
    ref_test_bump_named(a.borrow().unwrap())
    assert_eq(named.get(a).unwrap().w, 7)

    let lists: Arena<RefTestListCell> = arena_new()
    let b = lists.insert(RefTestListCell { xs: [], w: 5 })
    ref_test_bump_list(lists.borrow(b).unwrap())
    assert_eq(lists.get(b).unwrap().w, 6)

    let maybes: Arena<RefTestMaybeCell> = arena_new()
    let c = maybes.insert(RefTestMaybeCell { w: 5 })
    ref_test_set_maybe(maybes.borrow(c).unwrap())
    assert_eq(maybes.get(c).unwrap().w ?? 0, 9)
}

// -- Refs into a scalarizable owner --
//
// A `ref` (local, argument, or returned place) into a local whose storage
// holds a `value` struct. The write goes through an alias the MIR transforms
// cannot see, so the borrowed root cell must stay whole: SROA splitting or
// rematerializing it, or copy-prop forwarding its loads to the value ctor,
// moves the write onto a temporary while reads fold to the ctor's original
// operands. The lowering marks the root cell `borrowed`.
//
// Sibling coverage: tests/values/field_write_scalarized_local.rock (direct
// `h.p.x = v` writes on the owner).

value RaQuery {
    head: int = -1,
}

value RaGcQuery {
    head: int = -1,
    free: [int] = [],
}

struct RaGraph {
    query: RaQuery = RaQuery {},
}

struct RaGcGraph {
    query: RaGcQuery = RaGcQuery {},
}

fn ra_set(q: ref RaQuery, v: int) {
    q.head = v
}

fn ra_set_gc(q: ref RaGcQuery, v: int) {
    q.head = v
}

fn seed(n: int) -> int { return n }

@test
fn ref_local_write_reaches_scalarized_owner() {
    let g = RaGraph {}
    let q: ref RaQuery = g.query
    q.head = 3
    assert_eq(g.query.head, 3)
}

@test
fn ref_local_runtime_write_reaches_scalarized_owner() {
    let g = RaGraph {}
    let q: ref RaQuery = g.query
    q.head = seed(7)
    q.head += 1
    assert_eq(g.query.head, 8)
    assert_eq(q.head, 8)
}

@test
fn ref_local_write_reaches_gc_value_owner() {
    let g = RaGcGraph {}
    let q: ref RaGcQuery = g.query
    q.head = 3
    q.free.push(1)
    assert_eq(g.query.head, 3)
    assert_eq(g.query.free.len(), 1)
}

@test
fn ref_param_write_reaches_scalarized_owner() {
    let g = RaGraph {}
    ra_set(g.query, 4)
    assert_eq(g.query.head, 4)
}

@test
fn ref_param_write_is_seen_by_a_later_copy() {
    let g = RaGraph {}
    ra_set(g.query, 4)
    let q = g.query
    assert_eq(q.head, 4)
}

@test
fn ref_param_write_is_seen_by_a_later_copy_of_gc_value() {
    let g = RaGcGraph {}
    ra_set_gc(g.query, 4)
    let q = g.query
    assert_eq(q.head, 4)
}

@test
fn copy_taken_before_ref_write_stays_a_snapshot() {
    let g = RaGraph {}
    let before = g.query
    let q: ref RaQuery = g.query
    q.head = 5
    assert_eq(before.head, -1)
    assert_eq(g.query.head, 5)
}

value RaOuter {
    q: RaQuery = RaQuery {},
    n: int = 0,
}

@inline
fn ra_graph_set(g: ref RaGraph, v: int) {
    let q: ref RaQuery = g.query
    q.head = v
}

@inline
fn ra_query_of(g: ref RaGraph) -> ref RaQuery {
    return g.query
}

@inline
fn ra_set_inline(q: ref RaQuery, v: int) {
    q.head = v
}

fn ra_query_of_outlined(g: ref RaGraph) -> ref RaQuery {
    return g.query
}

@test
fn ref_param_write_reaches_whole_value_local() {
    let p = RaQuery {}
    ra_set(p, 4)
    assert_eq(p.head, 4)
}

@test
fn ref_local_write_reaches_whole_value_local() {
    let p = RaQuery {}
    let q: ref RaQuery = p
    q.head = 5
    assert_eq(p.head, 5)
}

@test
fn ref_param_write_reaches_nested_value_local() {
    let o = RaOuter {}
    ra_set(o.q, 6)
    assert_eq(o.q.head, 6)
}

@test
fn ref_local_write_reaches_nested_value_local() {
    let o = RaOuter {}
    let q: ref RaQuery = o.q
    q.head = 7
    assert_eq(o.q.head, 7)
}

@test
fn struct_ref_param_projects_a_written_value_field() {
    let g = RaGraph {}
    ra_graph_set(g, 8)
    assert_eq(g.query.head, 8)
}

@test
fn returned_ref_write_reaches_scalarized_owner() {
    let g = RaGraph {}
    let q: ref RaQuery = ra_query_of(g)
    q.head = 9
    assert_eq(g.query.head, 9)
}

@test
fn returned_ref_write_reaches_scalarized_owner_outlined() {
    let g = RaGraph {}
    let q: ref RaQuery = ra_query_of_outlined(g)
    q.head = 9
    assert_eq(g.query.head, 9)
}

@test
fn inlined_ref_param_write_reaches_scalarized_owner() {
    let g = RaGraph {}
    ra_set_inline(g.query, 3)
    assert_eq(g.query.head, 3)
}

// -- Refs to a stored value with a nobox field --
//
// A `ref` parameter to a stored `value` whose field is a `nobox` value. Reads
// and writes through the ref reach the stored row's own representation of the
// child (dotted leaf keys and a presence tag on a table parent) instead of
// packing the child into a box. Covers a nullable child (read, non-null write,
// null write), a non-nullable child on a cdata and on a GC-table parent, a
// nobox child nested inside a nullable nobox child, and a nested nobox child of
// a cdata parent. A cdata parent nests a non-inline child, so its whole-field
// write goes leaf-wise through the stored child, with or without a ref.

nobox value RnId {
    value: int,
}

nobox value RnPair {
    a: RnId,
    b: int,
}

value RnBinding {
    id: int,
    live: RnId? = null,
}

value RnPlain {
    id: int,
    live: RnId,
}

value RnGcPlain {
    tags: [int] = [],
    live: RnId,
}

value RnNested {
    id: int,
    pair: RnPair? = null,
}

value RnDeep {
    id: int,
    pair: RnPair,
}

struct RnRow {
    binding: RnBinding,
    plain: RnPlain,
    gc: RnGcPlain,
    nested: RnNested,
    deep: RnDeep,
}

fn rn_row(id: int) -> RnRow {
    return RnRow {
        binding: RnBinding { id: id },
        plain: RnPlain { id: id, live: RnId { value: id } },
        gc: RnGcPlain { live: RnId { value: id } },
        nested: RnNested { id: id },
        deep: RnDeep { id: id, pair: RnPair { a: RnId { value: id }, b: id } },
    }
}

fn rn_resume(binding: ref RnBinding, mob: RnId) -> bool {
    if binding.live != null { return false }
    binding.live = mob
    return true
}

fn rn_suspend(binding: ref RnBinding) -> bool {
    if binding.live == null { return false }
    binding.live = null
    return true
}

fn rn_live_value(binding: ref RnBinding) -> int {
    if let live = binding.live {
        return live.value
    }
    return -1
}

fn rn_bump_plain(p: ref RnPlain) -> int {
    let cur = p.live
    p.live = RnId { value: cur.value + 1 }
    return cur.value
}

fn rn_bump_gc(p: ref RnGcPlain) -> int {
    let cur = p.live
    p.live = RnId { value: cur.value + 10 }
    p.tags.push(cur.value)
    return cur.value
}

fn rn_set_pair(n: ref RnNested, v: int) {
    n.pair = RnPair { a: RnId { value: v }, b: v * 2 }
}

fn rn_pair_a(n: ref RnNested) -> int {
    if let pair = n.pair {
        return pair.a.value + pair.b
    }
    return -1
}

fn rn_clear_pair(n: ref RnNested) {
    n.pair = null
}

fn rn_swap_deep(d: ref RnDeep) -> int {
    let old = d.pair
    d.pair = RnPair { a: RnId { value: old.b }, b: old.a.value }
    return old.a.value * 10 + old.b
}

@test
fn ref_nullable_nobox_field_read_write_and_clear_reach_the_row() {
    let rows: [RnRow] = []
    rows.push(rn_row(1))
    let row = rows[0]
    assert_eq(rn_live_value(row.binding), -1)
    assert(rn_resume(row.binding, RnId { value: 7 }))
    assert_eq(rows[0].binding.live.unwrap().value, 7)
    assert_eq(rn_live_value(rows[0].binding), 7)
    assert(!rn_resume(rows[0].binding, RnId { value: 8 }))
    assert_eq(rows[0].binding.live.unwrap().value, 7)
    assert(rn_suspend(row.binding))
    assert(rows[0].binding.live == null)
    assert_eq(rn_live_value(row.binding), -1)
    assert(!rn_suspend(row.binding))
}

@test
fn ref_nobox_field_copy_taken_before_write_keeps_the_old_value() {
    let rows: [RnRow] = []
    rows.push(rn_row(2))
    assert(rn_resume(rows[0].binding, RnId { value: 3 }))
    let before = rows[0].binding
    assert(rn_suspend(rows[0].binding))
    assert_eq(before.live.unwrap().value, 3)
    assert(rows[0].binding.live == null)
}

@test
fn ref_non_nullable_nobox_field_on_scalar_and_gc_parents() {
    let rows: [RnRow] = []
    rows.push(rn_row(4))
    let row = rows[0]
    assert_eq(rn_bump_plain(row.plain), 4)
    assert_eq(rn_bump_plain(rows[0].plain), 5)
    assert_eq(rows[0].plain.live.value, 6)
    assert_eq(rn_bump_gc(row.gc), 4)
    assert_eq(rows[0].gc.live.value, 14)
    assert_eq(rows[0].gc.tags.len(), 1)
}

@test
fn ref_nested_nobox_in_nullable_nobox_field() {
    let rows: [RnRow] = []
    rows.push(rn_row(5))
    let row = rows[0]
    assert_eq(rn_pair_a(row.nested), -1)
    rn_set_pair(row.nested, 3)
    assert_eq(rows[0].nested.pair.unwrap().a.value, 3)
    assert_eq(rn_pair_a(rows[0].nested), 9)
    rn_clear_pair(row.nested)
    assert(rows[0].nested.pair == null)
    assert_eq(rn_pair_a(row.nested), -1)
}

@test
fn ref_nested_nobox_field_of_a_cdata_parent() {
    let rows: [RnRow] = []
    rows.push(rn_row(6))
    rows[0].deep.pair = RnPair { a: RnId { value: 1 }, b: 2 }
    let row = rows[0]
    assert_eq(rn_swap_deep(row.deep), 12)
    assert_eq(rows[0].deep.pair.a.value, 2)
    assert_eq(rows[0].deep.pair.b, 1)
    assert_eq(rn_swap_deep(rows[0].deep), 21)
    assert_eq(rows[0].deep.pair.a.value, 1)
}

@test
fn direct_whole_nobox_field_write_on_a_cdata_parent() {
    let rows: [RnRow] = []
    rows.push(rn_row(8))
    let row = rows[0]
    let cur = row.plain.live
    row.plain.live = RnId { value: cur.value + 1 }
    assert_eq(rows[0].plain.live.value, 9)
    assert_eq(cur.value, 8)
}
