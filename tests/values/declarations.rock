// Value declarations: catalog, extern, nomangle returns and envelopes.

value Color {
    r: float,
    g: float,
    b: float,
    a: float,
}

value V {
    x: float,
}

value FixVec3 {
    x: float,
    y: float,
    z: float,
}

value Mixed {
    x: int,
    y: float,
    active: bool,
}

value Inner {
    a: float,
    b: float,
}

value Outer {
    pos: Inner,
    scale: float,
}

@test
fn value_types_construct_and_coexist() {
    let c = Color { r: 1.0, g: 0.5, b: 0.0, a: 1.0 }
    assert(c.r == 1.0)
    assert(c.g == 0.5)
    assert(c.b == 0.0)
    assert(c.a == 1.0)
    assert(c == Color { r: 1.0, g: 0.5, b: 0.0, a: 1.0 })

    let v = V { x: 42.0 }
    assert(v.x == 42.0)

    let f = FixVec3 { x: 1.0, y: 2.0, z: 3.0 }
    assert(f.x == 1.0)
    assert(f.y == 2.0)
    assert(f.z == 3.0)

    let m = Mixed { x: 1, y: 2.0, active: true }
    assert(m.x == 1)
    assert(m.y == 2.0)
    assert(m.active == true)

    let o = Outer { pos: Inner { a: 1.0, b: 2.0 }, scale: 3.0 }
    assert(o.pos.a == 1.0)
    assert(o.scale == 3.0)

    let fv = FixVec2 { x: 3.0, y: 4.0 }
    assert(fv.x == 3.0)
    assert(fv.y == 4.0)
    let s = Stats { a: 10, b: 20 }
    assert(s.a == 10)
    assert(s.b == 20)
    let r = RenderStats { draw_calls: 5, shader_switches: 3 }
    assert(r.draw_calls == 5)
    assert(r.shader_switches == 3)
}

value CatalogValueDef {
    is_open: fn() -> bool,
    scope: string,
    stage: int,
}

@artifact_definition(catalog="value_definitions", key_param="key")
deco init catalog_value(key: string) {}

@artifact_catalog(catalog="value_definitions")
@intrinsic extern(lua) fn value_definition_plan() -> [ArtifactDefinition<CatalogValueDef>]

@catalog_value(key="first")
fn define_catalog_first() -> CatalogValueDef {
    return CatalogValueDef { is_open: () => true, scope: "first", stage: 100 }
}

@catalog_value(key="second")
fn define_catalog_second() -> CatalogValueDef {
    return CatalogValueDef { is_open: () => false, scope: "second", stage: 10 }
}

// Widget entries keep declaration order, not key order, and a catalog with no
// members is an empty list rather than missing.
@test(output = "catalog values preserved")
fn definition_catalog_preserves_value_factory_results() {
    let direct = define_catalog_first()
    assert(direct.is_open(), "direct value return preserves callable")
    assert(direct.scope == "first", "direct value return preserves string")
    assert(direct.stage == 100, "direct value return preserves stage")

    let plan = value_definition_plan()
    assert(plan.len == 2, "catalog contains both entries")
    assert(plan[0].definition.is_open(), "first catalog callable")
    assert(plan[0].definition.scope == "first", "first catalog string")
    assert(plan[0].definition.stage == 100, "first catalog stage")
    assert(!plan[1].definition.is_open(), "second catalog callable")
    assert(plan[1].definition.scope == "second", "second catalog string")
    assert(plan[1].definition.stage == 10, "second catalog stage")

    plan.sort(entry => entry.definition.stage * 10000 + entry.ordinal)
    assert(plan[0].key == "second", "sort reads complete catalog values")
    let copied = plan[0].definition
    assert(!copied.is_open() && copied.scope == "second" && copied.stage == 10,
        "catalog values remain complete after copying")

    let widgets = widget_definition_plan()
    assert_eq(widgets.len, 2)
    assert_eq(widgets[0].key, "beta")
    assert_eq(widgets[0].definition.value, 2)
    assert_eq(widgets[1].key, "alpha")
    assert_eq(empty_widget_definition_plan().len, 0)
    print("catalog values preserved")
}

struct WidgetDef { value: int }

@artifact_definition(catalog="widgets", key_param="key")
deco init widget(key: string) {}

@artifact_definition(catalog="empty_widgets", key_param="key")
deco init empty_widget(key: string) {}

@artifact_catalog(catalog="widgets")
@intrinsic extern(lua) fn widget_definition_plan() -> [ArtifactDefinition<WidgetDef>]

@artifact_catalog(catalog="empty_widgets")
@intrinsic extern(lua) fn empty_widget_definition_plan() -> [ArtifactDefinition<WidgetDef>]

@widget(key="beta")
fn make_beta() -> WidgetDef { return WidgetDef { value: 2 } }

@widget(key="alpha")
fn make_alpha() -> WidgetDef { return WidgetDef { value: 1 } }

value FixVec2 { x: float, y: float }

value Stats { a: int, b: int }

value RenderStats {
    draw_calls: int,
    shader_switches: int,
}

// C: void get_stats(Stats* out)
extern(ffi, "testlib") fn get_stats() -> Stats

// C: void apply_offset(FixVec2 offset)
extern(ffi, "testlib") fn apply_offset(offset: FixVec2)

// C: void add_vecs(FixVec2* out, FixVec2 a, FixVec2 b)
extern(ffi, "testlib") fn add_vecs(a: FixVec2, b: FixVec2) -> FixVec2

extern(ffi, "testlib") fn scale_vec(v: FixVec2, factor: float) -> FixVec2

extern(ffi, "testlib") fn get_render_stats() -> RenderStats

extern(ffi, "testlib") fn reset_stats()

value V2 { x: int, y: int }

// @nomangle => emitted name == source name == cdata ABI (a single cdata
// return, because the value is unmarked).
@nomangle fn mk_v2(x: int, y: int) -> V2 {
    return V2 { x: x, y: y }
}

// A regular (mangled) fn still uses the scalar ABI.
fn mk_v2_mangled(x: int, y: int) -> V2 {
    return V2 { x: x, y: y }
}

@test(output = "3\n4\n30")
fn test_nomangle_and_mangled_value_returns() {
    let v = mk_v2(3, 4)
    print("{v.x}")
    print("{v.y}")
    let m = mk_v2_mangled(5, 6)
    print("{m.x * m.y}")
}

const STEP: float = 1.0 / 60.0

@test
fn test_envelope_attack_release_and_retarget() {
    let e = envelope(0.2, 0.5)
    assert_eq(e.value, 0, "starts at zero")
    for _i in 0..6 { e.step_by(1.0, STEP) }
    assert(e.value > 0.45 && e.value < 0.55, "half attack after 0.1s")
    for _i in 0..12 { e.step_by(1.0, STEP) }
    assert_eq(e.value, 1.0, "reaches goal exactly, no asymptotic tail")

    let r = envelope(0.1, 0.5)
    let first = r.step_by(1.0, STEP)
    assert_eq(first, r.value, "step_by returns the new value")
    for _i in 0..11 { r.step_by(1.0, STEP) }
    assert_eq(r.value, 1.0, "attacked to full")
    for _i in 0..6 { r.step_by(0.0, STEP) }
    assert(r.value > 0.75 && r.value < 0.85, "release at its own rate")
    for _i in 0..60 { r.step_by(0.0, STEP) }
    assert_eq(r.value, 0.0, "releases to exactly zero")

    let p = envelope(0.2, 0.4)
    for _i in 0..120 { p.step_by(0.25, STEP) }
    assert_eq(p.value, 0.25, "sustains a partial goal from below")
    for _i in 0..120 { p.step_by(1.0, STEP) }
    for _i in 0..120 { p.step_by(0.25, STEP) }
    assert_eq(p.value, 0.25, "settles onto a partial goal from above")

    let t = envelope(0.2, 0.2)
    for _i in 0..3 { t.step_by(1.0, STEP) }
    let mid = t.value
    assert(mid > 0.2 && mid < 0.3, "mid-attack")
    t.step_by(0.0, STEP)
    assert(t.value < mid, "flip to release moves down from current value")
    assert(mid - t.value < 0.1, "no pop on retarget")
}
