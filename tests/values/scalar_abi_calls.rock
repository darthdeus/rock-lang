// Scalar ABI: call arguments, containers, yields and leaf name ambiguity.

value V2 { x: float, y: float }
value V3 { r: float, g: float, b: float }

fn make_v2(a: float, b: float) -> V2 {
    return V2 { x: a, y: b }
}

fn make_v3(r: float, g: float, b: float) -> V3 {
    return V3 { r: r, g: g, b: b }
}

fn sum_xy(v: V2) -> float {
    return v.x + v.y
}

fn sum3(v: V3) -> float {
    return v.r + v.g + v.b
}

fn plus2(a: V2, b: V2, bias: float) -> V2 {
    return V2 { x: a.x + b.x + bias, y: a.y + b.y + bias }
}

fn mix(bias: float, v: V2) -> V2 {
    return V2 { x: v.x + bias, y: v.y + bias }
}

fn maybe_scale(v: V2?, k: float) -> float {
    if v != null {
        return v.x * k + v.y * k
    }
    return 0
}

fn tagged(label: string, v: V2, scale: float) -> float {
    return v.x * scale + v.y * scale
}

fn sum3_scaled(v: V3, scale: float) -> float {
    return (v.r + v.g + v.b) * scale
}

@test fn value_call_arguments() {
    let r = mix(10.0, make_v2(20.0, 50.0))
    assert_eq(r.x * 100.0 + r.y, 3060.0)
    assert_eq(maybe_scale(V2 { x: 10, y: 20 }, 3.0), 90.0)
    assert_eq(maybe_scale(null, 3.0), 0.0)
    assert_eq(maybe_scale(make_v2(5.0, 5.0), 3.0), 30.0)
    let n = plus2(plus2(make_v2(1, 2), make_v2(10, 20), 5), make_v2(50, 100), 5)
    assert_eq(n.x * 1000.0 + n.y, 71132.0)
    assert_eq(make_v2(10, 20).x, 10.0)
    assert_eq(sum3(make_v3(5.0, 10.0, 15.0)), 30.0)
    assert_eq(tagged("hi", make_v2(10, 20), scale: 3), 90.0)
    let yes = true
    let no = false
    assert_eq(sum3_scaled(if no { V3 { r: 1, g: 1, b: 1 } } else { make_v3(3.0, 4.0, 5.0) }, 3.0), 36.0)
    assert_eq(sum3_scaled(if yes { make_v3(1.0, 1.0, 1.0) } else { V3 { r: 9, g: 9, b: 9 } }, 3.0), 9.0)
    assert_eq(sum3_scaled(if no { make_v3(1.0, 1.0, 1.0) } else { make_v3(2.0, 3.0, 4.0) }, 3.0), 27.0)
    assert_eq(sum_xy(V2 { x: 1, y: 2 }), 3.0)
    let v = make_v2(3, 7)
    assert_eq(sum_xy(v), 10.0)
}

value IV2 { x: int, y: int }

fn make_iv2(a: int, b: int) -> IV2 {
    return IV2 { x: a, y: b }
}

fn iv2_sum(v: IV2) -> int {
    return v.x + v.y
}

fn iv2_scale(v: IV2, k: int) -> IV2 {
    return IV2 { x: v.x * k, y: v.y * k }
}

@test(output = "3\n7\n10\n21")
fn arena_of_values() {
    let a: Arena<IV2> = arena_new()
    let e1 = a.insert(IV2 { x: 1, y: 2 })
    let e2 = a.insert(make_iv2(3, 4))
    let e3 = a.insert(iv2_scale(IV2 { x: 1, y: 1 }, 5))
    let v1 = e1.get() ?? IV2 { x: 0, y: 0 }
    let v2 = e2.get() ?? IV2 { x: 0, y: 0 }
    let v3 = e3.get() ?? IV2 { x: 0, y: 0 }
    print(iv2_sum(v1))
    print(iv2_sum(v2))
    print(iv2_sum(v3))
    let b: Arena<IV2> = arena_new()
    b.insert(IV2 { x: 1, y: 2 })
    b.insert(IV2 { x: 3, y: 4 })
    b.insert(IV2 { x: 5, y: 6 })
    let sum = 0
    for (_, v) in b {
        sum = sum + v.x + v.y
    }
    print(sum)
}

co fn yield_value_call() -> Coroutine<IV2> {
    yield make_iv2(1, 2)
    yield make_iv2(10, 20)
}

co fn yield_value_literal() -> Coroutine<IV2> {
    yield IV2 { x: 7, y: 8 }
    yield IV2 { x: 100, y: 200 }
}

co fn yield_value_local() -> Coroutine<IV2> {
    let v = IV2 { x: 5, y: 6 }
    yield v
    let w = make_iv2(50, 60)
    yield w
}

fn drain2(c: Coroutine<IV2>) -> int {
    let a = c.resume() ?? IV2 { x: 0, y: 0 }
    let b = c.resume() ?? IV2 { x: 0, y: 0 }
    return iv2_sum(a) * 1000 + iv2_sum(b)
}

@test fn yields_of_values() {
    assert_eq(drain2(yield_value_call()), 3030)
    assert_eq(drain2(yield_value_literal()), 15300)
    assert_eq(drain2(yield_value_local()), 11110)
}

global SIDE_EFFECT_ACC: int = 0

fn record_sum(v: IV2) -> IV2 {
    SIDE_EFFECT_ACC = SIDE_EFFECT_ACC + v.x + v.y
    return v
}

fn __op_add(a: IV2, b: IV2) -> IV2 {
    return IV2 { x: a.x + b.x, y: a.y + b.y }
}

fn __op_mul(a: IV2, k: int) -> IV2 {
    return IV2 { x: a.x * k, y: a.y * k }
}

// Generic instantiations keep the boxed ABI.
fn box_first<T>(items: [T]) -> T? {
    if items.len() > 0 {
        return items[0]
    }
    return null
}

@test fn fn_refs_operators_generics_and_defer() {
    let f: fn(IV2) -> int = iv2_sum
    let g: fn(IV2, int) -> IV2 = iv2_scale
    assert_eq(f(IV2 { x: 10, y: 20 }), 30)
    let scaled = g(IV2 { x: 10, y: 10 }, 10)
    assert_eq(scaled.x + scaled.y, 200)
    assert_eq(f(make_iv2(3, 4)), 7)
    let a = IV2 { x: 1, y: 2 }
    let b = IV2 { x: 3, y: 1 }
    let c = IV2 { x: 2, y: 3 }
    let r = (a + b) * 2 + c
    assert_eq(r.x * 100 + r.y, 1009)
    let xs: [IV2] = [IV2 { x: 2, y: 3 }, IV2 { x: 10, y: 20 }]
    let first = box_first(xs) ?? IV2 { x: 0, y: 0 }
    assert_eq(first.x + first.y, 5)
    SIDE_EFFECT_ACC = 0
    {
        defer {
            record_sum(make_iv2(1, 2))
            record_sum(iv2_scale(IV2 { x: 1, y: 1 }, 7) * 1)
        }
    }
    assert_eq(SIDE_EFFECT_ACC, 17)
}

nobox value P { x: float, y: float }

nobox value R { tl: P, tl__x: float }

fn apply(f: (R) -> float, r: R) -> float { return f(r) }

@test fn ambiguous_leaves_read_correctly() {
    let r = R { tl: P { x: 1.0, y: 20.0 }, tl__x: 300.0 }
    assert_eq(apply((a) => a.tl.x + a.tl.y + a.tl__x, r), 321.0)
    assert_eq(apply((a) => a.tl__x, r), 300.0)
    assert_eq(apply((a) => a.tl.x, r), 1.0)
    assert_eq(r.tl.x, 1.0)
    assert_eq(r.tl.y, 20.0)
    assert_eq(r.tl__x, 300.0)
}
