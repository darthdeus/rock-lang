// Reassigning a scalarized value local (one cell per leaf) writes every leaf
// from a literal, another local or a call.

value V2 { x: int, y: int }

@test(output = "30")
fn test_value_local_reassign_struct_lit() {
    let v = V2 { x: 1, y: 2 }
    v = V2 { x: 10, y: 20 }
    print(v.x + v.y)
}

@test(output = "30")
fn test_value_local_reassign_from_other_local() {
    let v1 = V2 { x: 10, y: 20 }
    let v = V2 { x: 1, y: 2 }
    v = v1
    print(v.x + v.y)
}

fn make_v2(a: int, b: int) -> V2 {
    return V2 { x: a, y: b }
}

@test(output = "30")
fn test_value_local_reassign_from_call() {
    let v = V2 { x: 1, y: 2 }
    v = make_v2(10, 20)
    print(v.x + v.y)
}

// Reassignment must COPY, not bind the source place: the tests above check
// that the value arrives, these that it is independent of its source.

struct Box { p: V2 }
struct NBox { p: V2? }

@test(output = "v=1 src=99")
fn reassign_from_field_copies() {
    let src = Box { p: V2 { x: 1, y: 2 } }
    let v = V2 { x: 0, y: 0 }
    v = src.p
    src.p.x = 99
    print("v={v.x} src={src.p.x}")
}

@test(output = "v=1 src=99")
fn reassign_from_nullable_field_copies() {
    let src = NBox { p: V2 { x: 1, y: 2 } }
    let v = V2 { x: 0, y: 0 }
    if src.p != null {
        v = src.p
        src.p.x = 99
        print("v={v.x} src={src.p.x}")
    }
}

@test(output = "7")
fn reassign_nullable_local() {
    let a: V2? = V2 { x: 1, y: 2 }
    a = V2 { x: 7, y: 8 }
    if a != null { print("{a.x}") }
}
