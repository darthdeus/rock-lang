value Point { x: int, y: int }
value Record { child: Point?, refs: [int] }
struct Owner { record: Record }
value Branch { record: Record?, refs: [int] }
struct Tree { branch: Branch }
value Solid { child: Point, refs: [int] }

fn read_snapshot(owner: Owner) -> int {
    let saved = owner.record
    if owner.record.child != null { owner.record.child.x = 99 }
    return saved.child?.x ?? -1
}

fn read_child(child: Point?) -> int { child?.x ?? -1 }

fn read_nested_snapshot(tree: Tree) -> int {
    let saved = tree.branch
    if tree.branch.record != null {
        if tree.branch.record.child != null { tree.branch.record.child.x = 99 }
    }
    return saved.record?.child?.x ?? -1
}

fn pass_snapshot_child(owner: Owner) -> int {
    let saved = owner.record
    if owner.record.child != null { owner.record.child.x = 99 }
    return read_child(saved.child)
}

fn read_vec_snapshot(records: [Solid]) -> int {
    let saved = records[0]
    records[0].child.x = 99
    return saved.child.x
}

fn share_reference_child(owner: Owner) -> int {
    let saved = owner.record
    owner.record.refs.push(7)
    return saved.refs.len()
}

fn owner(child: Point?) -> Owner { Owner { record: Record { child: child, refs: [] } } }

// Retained value children are snapshots; reference leaves stay shared.
@test(output = "1 1 1 1 1\n-1 -1 -1\n1\n2\n3")
fn retained_value_children_are_snapshots() {
    let tree = Tree { branch: Branch {
        record: Record { child: Point { x: 1, y: 2 }, refs: [] }, refs: [] } }
    let records: [Solid] = [Solid { child: Point { x: 1, y: 2 }, refs: [] }]
    print("{read_snapshot(owner(Point { x: 1, y: 2 }))} {read_nested_snapshot(tree)} {pass_snapshot_child(owner(Point { x: 1, y: 2 }))} {read_vec_snapshot(records)} {share_reference_child(owner(null))}")
    let empty_tree = Tree { branch: Branch { record: null, refs: [] } }
    let empty_record = Tree { branch: Branch { record: Record { child: null, refs: [] }, refs: [] } }
    print("{read_snapshot(owner(null))} {read_nested_snapshot(empty_tree)} {read_nested_snapshot(empty_record)}")
    let looped = owner(Point { x: 1, y: 2 })
    for i in 1..4 {
        looped.record.child = Point { x: i, y: 2 }
        let saved = looped.record
        looped.record.child.x = 99
        print(saved.child?.x ?? -1)
    }
}
