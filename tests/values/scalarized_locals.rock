// Scalarized value locals: reassignment, field writes and nullable children.

value V2 { x: int, y: int }

fn make_v2(a: int, b: int) -> V2 {
    return V2 { x: a, y: b }
}

struct Box { p: V2 }

struct NBox { p: V2? }

// Reassignment copies the value; it does not bind the source place.
@test(output = "30 30 30\nv=1 src=99\nv=1 src=99\n7")
fn reassignment() {
    let a = V2 { x: 1, y: 2 }
    a = V2 { x: 10, y: 20 }
    let v1 = V2 { x: 10, y: 20 }
    let b = V2 { x: 1, y: 2 }
    b = v1
    let c = V2 { x: 1, y: 2 }
    c = make_v2(10, 20)
    print("{a.x + a.y} {b.x + b.y} {c.x + c.y}")
    let src = Box { p: V2 { x: 1, y: 2 } }
    let v = V2 { x: 0, y: 0 }
    v = src.p
    src.p.x = 99
    print("v={v.x} src={src.p.x}")
    let nsrc = NBox { p: V2 { x: 1, y: 2 } }
    let w = V2 { x: 0, y: 0 }
    if nsrc.p != null {
        w = nsrc.p
        nsrc.p.x = 99
        print("v={w.x} src={nsrc.p.x}")
    }
    let n: V2? = V2 { x: 1, y: 2 }
    n = V2 { x: 7, y: 8 }
    if n != null { print("{n.x}") }
}

// The default-arg path would receive nil and return -1.
fn consume_or_default(dest: V2? = null) -> int {
    if dest == null {
        return -1
    }
    let d = dest
    return d.x + d.y
}

fn consume_nonnull(d: V2) -> int { return d.x * 100 + d.y }

value FV2 { x: float, y: float }

// The join over a refined nullable is typed nullable, but the return slot is
// the scalar ABI, so the result must splat at the return boundary.
fn opt_or_fn(v: FV2?, fb: FV2) -> FV2 {
    if v != null { v } else { fb }
}

fn takes_v(v: FV2) -> float { return v.x + v.y }

@test(output = "1020\n30\n30\n2")
fn nullable_arg_and_return_slots() {
    let v = make_v2(10, 20)
    print(consume_nonnull(v))
    print(consume_or_default(v))
    let some: FV2? = FV2 { x: 10.0, y: 20.0 }
    let none: FV2? = null
    let fb = FV2 { x: 1.0, y: 1.0 }
    print(takes_v(opt_or_fn(some, fb)))
    print(takes_v(opt_or_fn(none, fb)))
}

value Handle { id: int, tags: [int] }

value Asset { image: Handle?, shadow: Handle?, width: int }

global ART: Asset? = null

global KEPT: Asset? = null

fn sample(a: Asset) -> int { return (a.image?.id ?? 0) + (a.shadow?.id ?? 0) + a.width }

fn draw_asset() -> int {
    let art = ART ?? return -1
    return sample(art) + sample(art)
}

fn keep_asset() { let art = ART ?? return; KEPT = art }

fn mutate(a: ref Asset) { if a.image != null { a.image.id = 99 } }

fn borrow_asset() { let art = ART ?? return; mutate(art) }

// Fifty fields keep `W` boxed, so the copy really owns a nullable child.
value W {
    f0: int, f1: int, f2: int, f3: int, f4: int, f5: int, f6: int, f7: int, f8: int, f9: int,
    f10: int, f11: int, f12: int, f13: int, f14: int, f15: int, f16: int, f17: int, f18: int, f19: int,
    f20: int, f21: int, f22: int, f23: int, f24: int, f25: int, f26: int, f27: int, f28: int, f29: int,
    f30: int, f31: int, f32: int, f33: int, f34: int, f35: int, f36: int, f37: int, f38: int, f39: int,
    f40: int, f41: int, f42: int, f43: int, f44: int, f45: int, f46: int, f47: int, f48: int, f49: int,
}

value WOuter { w: W?, xs: [int] }

struct WHolder { o: WOuter }

fn mkw() -> W {
    return W {
        f0: 1, f1: 1, f2: 1, f3: 1, f4: 1, f5: 1, f6: 1, f7: 1, f8: 1, f9: 1,
        f10: 1, f11: 1, f12: 1, f13: 1, f14: 1, f15: 1, f16: 1, f17: 1, f18: 1, f19: 1,
        f20: 1, f21: 1, f22: 1, f23: 1, f24: 1, f25: 1, f26: 1, f27: 1, f28: 1, f29: 1,
        f30: 1, f31: 1, f32: 1, f33: 1, f34: 1, f35: 1, f36: 1, f37: 1, f38: 1, f39: 1,
        f40: 1, f41: 1, f42: 1, f43: 1, f44: 1, f45: 1, f46: 1, f47: 1, f48: 1, f49: 1,
    }
}

@test(output = "-1\n24\n2 2\n2\n1")
fn coalesced_and_copied_nullable_children_keep_owned_copies() {
    print(draw_asset())
    ART = Asset { image: Handle { id: 2, tags: [] }, shadow: Handle { id: 3, tags: [] }, width: 7 }
    print(draw_asset())
    keep_asset()
    borrow_asset()
    print("{ART?.image?.id ?? 0} {KEPT?.image?.id ?? 0}")
    if ART != null && ART.image != null { ART.image.id = 11 }
    print(KEPT?.image?.id ?? 0)
    let src = WHolder { o: WOuter { w: mkw(), xs: [] } }
    let o = src.o
    if src.o.w != null { src.o.w.f0 = 99 }
    print(o.w?.f0 ?? -1)
}

value Pt { x: int, y: int }

value Inner { a: int }

value Outer { i: Inner, b: int }

struct Holder { p: Pt }

struct Deep { o: Outer }

fn seed(n: int) -> int { return n }

fn read_x(h: Holder) -> int { return h.p.x }

fn param_write(h: Holder) -> int {
    h.p.x = 5
    return h.p.x
}

// A leaf write through a struct-held value in a local is observable through
// the local and leaves sibling leaves and other locals alone.
@test(output = "5 11 2\n5 2\n9 2\n7 8\n5 1\n7 5 1")
fn struct_held_leaf_writes() {
    let s = seed(1)
    let h1 = Holder { p: Pt { x: s, y: 2 } }
    h1.p.x = 5
    let h2 = Holder { p: Pt { x: s, y: 2 } }
    h2.p.x = h2.p.x + 10
    let h3 = Holder { p: Pt { x: s, y: 2 } }
    h3.p.x++
    print("{h1.p.x} {h2.p.x} {h3.p.x}")
    let h4 = Holder { p: Pt { x: 1, y: 2 } }
    h4.p.x = 5
    print("{h4.p.x} {h4.p.y}")
    let d = Deep { o: Outer { i: Inner { a: 1 }, b: 2 } }
    d.o.i.a = 9
    print("{d.o.i.a} {d.o.b}")
    let h5 = Holder { p: Pt { x: 1, y: 2 } }
    h5.p = Pt { x: 7, y: 8 }
    print("{h5.p.x} {h5.p.y}")
    let a = Holder { p: Pt { x: 1, y: 2 } }
    let b = Holder { p: Pt { x: 1, y: 2 } }
    a.p.x = 5
    print("{a.p.x} {b.p.x}")
    let esc = Holder { p: Pt { x: s, y: 2 } }
    esc.p.x = 7
    let held = Holder { p: Pt { x: seed(1), y: 2 } }
    let ro = Holder { p: Pt { x: s, y: 2 } }
    print("{read_x(esc)} {param_write(held)} {ro.p.x}")
}
