// Value structs at call and expression shapes where a multi-value return
// could be truncated to its first leaf or a pack could be skipped:
// non-last arguments, Lua parentheses (which keep only the first value),
// variadic surplus arguments, `inline(lua)` splices, compound assignment
// through a user operator, and declaration defaults.

value V2 { x: float, y: float }

fn make_v2() -> V2 {
    return V2 { x: 10.0, y: 20.0 }
}

// inline(lua) bodies keep the boxed ABI, so the non-last argument must pack.
inline(lua) fn scale_v2_inline(v: V2, factor: float) -> V2 = """
return __rock_create_struct("V2", { x = v.x * factor, y = v.y * factor })
"""

value IV2 { x: int, y: int }

@inline
inline(lua) fn make_v(x: int, y: int) -> IV2 = "return IV2_ct(x, y)"

@test(backends = "lua")
fn inline_lua_value_calls() {
    let r = scale_v2_inline(make_v2(), 4.0)
    assert_eq(r.x * 1000.0 + r.y, 40080.0)
    let v = make_v(7, 9)
    assert_eq(v.x, 7)
    assert_eq(v.y, 9)
}

fn make_pv2(a: int, b: int) -> IV2 {
    return IV2 { x: a, y: b }
}

fn take_v2(v: IV2) -> int {
    return v.x * 100 + v.y
}

fn vfn(args: ...any) -> int {
    7
}

fn mixed_with_surplus(a: int, args: ...any) -> int {
    a * 2
}

nobox value UfcsV2 { x: int, y: int }

@scalar_abi fn ufcs_variadic(receiver: UfcsV2, first: int, args: ...any) -> int {
    return receiver.x
}

@test fn paren_and_variadic_arguments() {
    assert_eq(take_v2((make_pv2(7, 8))), 708)
    // Paren nodes nest unflattened; the unwrap must peek through all layers.
    let r = ((make_pv2(11, 22)))
    assert_eq(r.x * 100 + r.y, 1122)
    let src = make_pv2(99, 5)
    let copy = (src)
    assert_eq(copy.x * 100 + copy.y, 9905)
    let v = IV2 { x: 1, y: 2 }
    assert_eq(vfn(v, v), 7)
    assert_eq(mixed_with_surplus(7, v, v), 14)
    let u = UfcsV2 { x: 11, y: 12 }
    assert_eq(u.ufcs_variadic(1, 2, 3), 11)
}

value CV2 { x: int, y: int }

@pure operator +(a: CV2, b: CV2) -> CV2 {
    CV2 { x: a.x + b.x, y: a.y + b.y }
}

@pure operator -(a: CV2, b: CV2) -> CV2 {
    CV2 { x: a.x - b.x, y: a.y - b.y }
}

value V3 { x: int = 5, y: int = 6 }

@test(output = "4, 6\n-2, -2\n7, 10\n5, 6\n7, 6\n5, 8")
fn compound_assign_and_defaults() {
    let a = CV2 { x: 1, y: 2 }
    let w = CV2 { x: 3, y: 4 }
    a += w
    print("{a.x}, {a.y}")
    let s = CV2 { x: 1, y: 2 }
    s -= w
    print("{s.x}, {s.y}")
    let c = CV2 { x: 1, y: 2 }
    c += CV2 { x: 3, y: 4 }
    c += CV2 { x: 3, y: 4 }
    print("{c.x}, {c.y}")
    let all = V3 { }
    print("{all.x}, {all.y}")
    let x = V3 { x: 7 }
    print("{x.x}, {x.y}")
    let y = V3 { y: 8 }
    print("{y.x}, {y.y}")
}

// A direct UFCS call through safe navigation on a `value` receiver keeps its
// instantiation. Each control holds one factor fixed: a boxed receiver, and
// the same value receiver reached through a refinement. Every receiver type
// is distinct so one call's instantiation cannot supply another's.

value VHandle<T> { slot: int, payload: T }

fn VHandle<T>.fetch(h) -> T? {
    if h.slot < 0 { return null }
    return h.payload
}

fn find_value(slot: int) -> VHandle<int>? {
    if slot == 0 { return null }
    return VHandle { slot: slot, payload: slot * 100 }
}

struct SHandle<T> { slot: int, payload: T }

fn SHandle<T>.fetch(h) -> T? {
    if h.slot < 0 { return null }
    return h.payload
}

fn find_struct(slot: int) -> SHandle<int>? {
    if slot == 0 { return null }
    return SHandle { slot: slot, payload: slot * 100 }
}

value RHandle<T> { slot: int, payload: T }

fn RHandle<T>.fetch(h) -> T? {
    if h.slot < 0 { return null }
    return h.payload
}

fn find_refined(slot: int) -> RHandle<int>? {
    if slot == 0 { return null }
    return RHandle { slot: slot, payload: slot * 100 }
}

fn probe(slot: int) -> int? {
    let h = find_refined(slot)
    if h != null { return h.fetch() }
    return null
}

@test(output = "300\n-1\n300\n-1\n300\n-1")
fn safe_nav_ufcs_keeps_its_instantiation() {
    print("{find_value(3)?.fetch() ?? -1}")
    print("{find_value(0)?.fetch() ?? -1}")
    print("{find_struct(3)?.fetch() ?? -1}")
    print("{find_struct(0)?.fetch() ?? -1}")
    print("{probe(3) ?? -1}")
    print("{probe(0) ?? -1}")
}

value ScalarPair { x: int, y: int }
fn make_scalar_pair(x: int, y: int) -> ScalarPair { ScalarPair { x: x, y: y } }
struct NBox { p: ScalarPair? }

// The default-arg path would receive nil and return -1.
fn consume_or_default(dest: ScalarPair? = null) -> int {
    if dest == null {
        return -1
    }
    let d = dest
    return d.x + d.y
}

fn consume_nonnull(d: ScalarPair) -> int { return d.x * 100 + d.y }

value FloatScalarPair { x: float, y: float }

// The join over a refined nullable is typed nullable, but the return slot is
// the scalar ABI, so the result must splat at the return boundary.
fn opt_or_fn(v: FloatScalarPair?, fb: FloatScalarPair) -> FloatScalarPair {
    if v != null { v } else { fb }
}

fn takes_v(v: FloatScalarPair) -> float { return v.x + v.y }

@test(output = "1020\n30\n30\n2")
fn nullable_arg_and_return_slots() {
    let v = make_scalar_pair(10, 20)
    print(consume_nonnull(v))
    print(consume_or_default(v))
    let some: FloatScalarPair? = FloatScalarPair { x: 10.0, y: 20.0 }
    let none: FloatScalarPair? = null
    let fb = FloatScalarPair { x: 1.0, y: 1.0 }
    print(takes_v(opt_or_fn(some, fb)))
    print(takes_v(opt_or_fn(none, fb)))
}
