// extern(ffi) declarations with value types: value params and value returns
// (lowered through an out-param wrapper). The C functions are not called;
// these pin that the declarations compile and the structs construct.

value FixVec2 { x: float, y: float }
value Stats { a: int, b: int }

// Return value: compiler generates out-param wrapper
// C signature: void get_stats(Stats* out)
// Lua wrapper: local __out = ffi.new("Stats[1]"); lib.get_stats(__out); return __out[0]
extern(ffi, "testlib") fn get_stats() -> Stats

// Pass value by value as parameter
// C signature: void apply_offset(FixVec2 offset)
// Lua wrapper: lib.apply_offset(offset)
extern(ffi, "testlib") fn apply_offset(offset: FixVec2)

// Pass value and return value
// C signature: void add_vecs(FixVec2* out, FixVec2 a, FixVec2 b)
// Lua wrapper: local __out = ffi.new("FixVec2[1]"); lib.add_vecs(__out, a, b); return __out[0]
extern(ffi, "testlib") fn add_vecs(a: FixVec2, b: FixVec2) -> FixVec2

// Mixed: value param + primitive params + value return
extern(ffi, "testlib") fn scale_vec(v: FixVec2, factor: float) -> FixVec2

// Test that value values can be constructed and passed around
// (this actually runs, unlike the extern calls)
@test fn construct_for_ffi_param() {
    let v = FixVec2 { x: 3.0, y: 4.0 }
    assert(v.x == 3.0)
    assert(v.y == 4.0)
}

@test fn construct_stats_for_ffi() {
    let s = Stats { a: 10, b: 20 }
    assert(s.a == 10)
    assert(s.b == 20)
}

// Verify codegen patterns by compiling to Lua and checking the output
// The actual verification is done by the test runner compiling this file
// successfully — if the extern(ffi) codegen is wrong, compilation fails.

value RenderStats {
    draw_calls: int,
    shader_switches: int,
}

// This extern(ffi) returns a value — compiler should generate
// out-param wrapper: allocate RenderRenderStats[1], call C with pointer, return [0]
extern(ffi, "testlib") fn get_render_stats() -> RenderStats

// Regular extern(ffi) without value return — unchanged behavior
extern(ffi, "testlib") fn reset_stats()

// Test that we can construct and use the struct normally
@test
fn test_struct_c_construction() {
    let s = RenderStats { draw_calls: 5, shader_switches: 3 }
    assert(s.draw_calls == 5)
    assert(s.shader_switches == 3)
}
