// A `value` struct with value-struct fields crosses calls whole, field by
// field, and as an element of a Vec.

value V2 {
    x: float,
    y: float,
}

value Seg {
    a: V2,
    b: V2,
}

value Ray {
    o: V2,
    t: float,
}

fn ident_seg(s: Seg) -> Seg {
    return s
}

fn mk_seg(ax: float, ay: float, bx: float, by: float) -> Seg {
    return Seg { a: V2 { x: ax, y: ay }, b: V2 { x: bx, y: by } }
}

fn seg_a(s: Seg) -> V2 {
    return s.a
}

fn ray_t(r: Ray) -> float {
    return r.t
}

@test(output = "1\n2\n3\n4\n7\n9\n42\n5\n6")
fn test_nested_values_cross_calls() {
    let s = mk_seg(1, 2, 3, 4)
    let s2 = ident_seg(s)
    print("{s2.a.x.floor()}")
    print("{s2.a.y.floor()}")
    print("{s2.b.x.floor()}")
    print("{s2.b.y.floor()}")
    let t = mk_seg(7, 9, 0, 0)
    let p = seg_a(t)
    print("{p.x.floor()}")
    print("{p.y.floor()}")
    let r = Ray { o: V2 { x: 1, y: 2 }, t: 42 }
    print("{ray_t(r).floor()}")
    let xs: [Seg] = []
    xs.push(mk_seg(5, 6, 0, 0))
    let g = xs[0]
    print("{g.a.x.floor()}")
    print("{g.a.y.floor()}")
}
