// An all-scalar `value` struct used as a WHOLE value (compared with `==`,
// stored in a Vec, returned/passed boxed) keeps a `MakeValueStruct` through
// cleanup; the JS backend emits it as a plain `{__ty, ...}` object whose
// structural deep-eq matches LuaJIT's byte-value equality for all-scalar
// leaves. GC-carrying value-struct equality is values/gc_carrying.rock.

value V { x: int, y: int }

value Line { a: V, b: V }

// An ordinary value holding a flat enum crosses a return as leaves.
enum Payload { A, B }
enum Kind { Plain, Payload(Payload) }
value Row { kind: Kind, key: string, count: int }

fn make_row(kind: Kind, n: int) -> Row {
    return match kind {
        Kind::Plain => Row { kind, key: "plain", count: n + 1 },
        Kind::Payload(_) => Row { kind, key: "payload", count: n + 1 },
    }
}

fn consume_row(row: Row) -> int {
    let key_bonus = if row.key == "payload" { 10 } else { 0 }
    return match row.kind {
        Kind::Plain => row.count + key_bonus,
        Kind::Payload(payload) => match payload {
            Payload::A => row.count + key_bonus,
            Payload::B => row.count + key_bonus + 4,
        },
    }
}

// A value stored in a Vec keeps its inline children and nullable nobox field.
nobox value Id { value: int }
value Cell { id: int, tag: Id? = null, pos: V }

@test
fn test_whole_value_structs() {
    let a = V { x: 1, y: 2 }
    let b = V { x: 1, y: 2 }
    let c = V { x: 1, y: 3 }
    assert(a == b, "equal contents compare equal")
    assert(!(a == c), "different contents")
    let xs = [V { x: 2, y: 3 }]
    let e = xs[0]
    assert_eq(e.x + e.y, 5)
    let p = Line { a: V { x: 1, y: 2 }, b: V { x: 3, y: 4 } }
    let q = Line { a: V { x: 1, y: 2 }, b: V { x: 3, y: 4 } }
    assert(p == q, "nested all-scalar values compare by contents")
    assert_eq(consume_row(make_row(Kind::Payload(Payload::B), 4)), 19)
    let cells: [Cell] = []
    cells.push(Cell { id: 1, tag: Id { value: 5 }, pos: V { x: 2, y: 3 } })
    let pos = cells[0].pos
    let tag = cells[0].tag.unwrap()
    assert_eq(pos.x * 100 + pos.y * 10 + tag.value + cells[0].id, 236)
}

// `field_get` over a nullable nobox field evaluates its owner once, copies the
// payload, and keeps `false` and nested absence distinct from null.
nobox value Place { area: int, x: int, y: int }
struct Owner { place: Place?, other: Place?, reads: int }
nobox value Flag { enabled: bool, place: Place? }
struct Flags { flag: Flag? }

fn reflected_read<T, R>(owner: T, field: ReadFieldRef<T, R>) -> R {
    return field_get(owner, field)
}

fn owner_once(owner: Owner) -> Owner {
    owner.reads += 1
    return owner
}

@test
fn test_nullable_field_get() {
    let owner = Owner { place: Place { area: 3, x: 5, y: 7 }, other: null, reads: 0 }
    let snapshot = field_get(f: .place, o: owner_once(owner)).unwrap()
    owner.place = Place { area: 11, x: 13, y: 17 }
    assert_eq(owner.reads, 1)
    assert_eq(snapshot.area * 100 + snapshot.x * 10 + snapshot.y, 357)

    let flags = Flags { flag: Flag { enabled: false, place: null } }
    let flag = reflected_read(flags, .flag).unwrap()
    assert(!flag.enabled && flag.place == null, "absent payload")
    flags.flag = Flag { enabled: true, place: Place { area: 19, x: 23, y: 29 } }
    let present = reflected_read(flags, .flag).unwrap()
    assert(present.enabled && present.place.unwrap().x == 23, "present payload")
    flags.flag = null
    assert(reflected_read(flags, .flag) == null, "cleared payload")

    let other = Owner { place: Place { area: 7, x: 11, y: 13 }, other: null, reads: 0 }
    let read = reflected_read(other, .place).unwrap()
    assert_eq(read.area * 10000 + read.x * 100 + read.y, 71113)
    assert(reflected_read(other, .other) == null, "absent field")
    other.place = null
    assert(reflected_read(other, .place) == null, "cleared field")
    other.place = Place { area: 17, x: 19, y: 23 }
    let reread = reflected_read(other, .place).unwrap()
    assert_eq(reread.area * 10000 + reread.x * 100 + reread.y, 171923)
}
