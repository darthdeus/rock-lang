
struct EqTile { x: int, y: int }

enum EqMarch { None, Tile(EqTile), Landmark(int) }

value EqSpec { march: EqMarch, label: string }

value EqOuter { spec: EqSpec, n: int }

fn eq_none() -> EqMarch { EqMarch::None }

fn eq_tile(x: int) -> EqMarch { EqMarch::Tile(EqTile { x: x, y: 2 }) }

fn eq_landmark(n: int) -> EqMarch { EqMarch::Landmark(n) }

fn eq_spec(m: EqMarch) -> EqSpec { EqSpec { march: m, label: "same" } }

nobox value EqInline { march: EqMarch }

value EqEmbedded { child: EqInline, label: string }

// Two global reads are copied leaf Groups; the enum payload still compares
// structurally, not by its table's identity.
global EQ_G1: EqSpec = EqSpec { march: eq_tile(1), label: "same" }

global EQ_G2: EqSpec = EqSpec { march: eq_tile(1), label: "same" }

@test(output = "true true false false\ntrue\ntrue false true\ntrue false false\ntrue false\ntrue false\ntrue false")
fn enum_payloads_compare_structurally_inside_values() {
    print("{eq_none() == eq_none()} {eq_tile(1) == eq_tile(1)} {eq_tile(1) == eq_tile(3)} {eq_tile(1) == eq_landmark(1)}")
    print(eq_spec(eq_none()) == eq_spec(eq_none()))
    let a = eq_spec(eq_tile(1))
    let b = eq_spec(eq_tile(1))
    let c = eq_spec(eq_tile(3))
    print("{a == b} {a == c} {a != c}")
    let la = eq_spec(eq_landmark(7))
    let lb = eq_spec(eq_landmark(7))
    let lc = eq_spec(eq_landmark(8))
    print("{la == lb} {la == lc} {la == eq_spec(eq_none())}")
    let oa = EqOuter { spec: eq_spec(eq_tile(1)), n: 9 }
    let ob = EqOuter { spec: eq_spec(eq_tile(1)), n: 9 }
    let oc = EqOuter { spec: eq_spec(eq_tile(3)), n: 9 }
    print("{oa == ob} {oa == oc}")
    let ea = EqEmbedded { child: EqInline { march: eq_tile(1) }, label: "same" }
    let eb = EqEmbedded { child: EqInline { march: eq_tile(1) }, label: "same" }
    let ec = EqEmbedded { child: EqInline { march: eq_tile(3) }, label: "same" }
    print("{ea == eb} {ea == ec}")
    print("{EQ_G1 == EQ_G2} {EQ_G1 == eq_spec(eq_tile(3))}")
}

// A stored absent inline child keeps a nil presence leaf; a literal `null`
// child carries `false`. Neither raw leaf decides equality.
nobox value EqPoint { x: int }

enum EqKind { Empty, Named(string) }

value EqParent { child: EqPoint?, kind: EqKind, label: string }

nobox value EqMid { child: EqPoint? }

value EqGrand { mid: EqMid, kind: EqKind, label: string }

global EQ_ABSENT: EqParent = EqParent { child: null, kind: EqKind::Named("same"), label: "same" }

global EQ_PRESENT: EqParent = EqParent { child: EqPoint { x: 1 }, kind: EqKind::Named("same"), label: "same" }

global EQ_GRAND: EqGrand = EqGrand { mid: EqMid { child: null }, kind: EqKind::Empty, label: "same" }

@test(output = "true true false false\ntrue false false true\ntrue false")
fn inline_child_presence_eq() {
    let a = EQ_ABSENT == EqParent { child: null, kind: EqKind::Named("same"), label: "same" }
    let b = EqParent { child: null, kind: EqKind::Named("same"), label: "same" } == EQ_ABSENT
    let c = EQ_ABSENT != EqParent { child: null, kind: EqKind::Named("same"), label: "same" }
    let d = EqParent { child: null, kind: EqKind::Named("same"), label: "same" } != EQ_ABSENT
    print("{a} {b} {c} {d}")
    let pa = EQ_PRESENT == EqParent { child: EqPoint { x: 1 }, kind: EqKind::Named("same"), label: "same" }
    let pb = EQ_PRESENT == EqParent { child: EqPoint { x: 2 }, kind: EqKind::Named("same"), label: "same" }
    let pc = EQ_PRESENT == EqParent { child: null, kind: EqKind::Named("same"), label: "same" }
    let pd = EQ_PRESENT != EqParent { child: null, kind: EqKind::Named("same"), label: "same" }
    print("{pa} {pb} {pc} {pd}")
    let ga = EQ_GRAND == EqGrand { mid: EqMid { child: null }, kind: EqKind::Empty, label: "same" }
    let gb = EQ_GRAND != EqGrand { mid: EqMid { child: null }, kind: EqKind::Empty, label: "same" }
    print("{ga} {gb}")
}

enum PotionKind {
    Heal,
    Cure,
}

enum ItemKind {
    Plain,
    Potion(PotionKind),
}

enum Action {
    Spell(PotionKind),
    Item(ItemKind),
}

value ItemView {
    kind: ItemKind,
}

value DragState {
    action: Action,
}

fn project() -> ItemView {
    return ItemView { kind: ItemKind::Potion(PotionKind::Heal) }
}

fn begin_drag(view: ItemView) -> DragState {
    return DragState { action: Action::Item(view.kind) }
}

struct Point { x: int, y: int }

enum Shape { Empty, Dot(Point) }

@test(output = "true true")
fn nested_and_struct_payloads_keep_structural_equality() {
    let expected = Action::Item(ItemKind::Potion(PotionKind::Heal))
    let drag = begin_drag(project())
    let a = Shape::Dot(Point { x: 1, y: 2 })
    let b = Shape::Dot(Point { x: 1, y: 2 })
    print("{drag.action == expected} {a == b}")
}

value V2 { x: float, y: float }

value Wrap { tag: int, name: string }

value Handle<T> { slot: int, generation: int }

fn make(tag: string, x: float, y: float) -> V2 {
    print(tag)
    return V2 { x: x, y: y }
}

@test(output = "lhs\nrhs\ntrue")
fn each_operand_is_evaluated_once() {
    print(make("lhs", 1.0, 2.0) == make("rhs", 1.0, 2.0))
}

fn eq_scalar(ax: float, ay: float, bx: float, by: float) -> bool {
    return V2 { x: ax, y: ay } == V2 { x: bx, y: by }
}

fn ne_scalar(ax: float, ay: float, bx: float, by: float) -> bool {
    return V2 { x: ax, y: ay } != V2 { x: bx, y: by }
}

fn eq_gc_same_ref(tag: int) -> bool {
    let n = "shared"
    return Wrap { tag: tag, name: n } == Wrap { tag: tag, name: n }
}

fn ne_gc_different_tag(tag_a: int, tag_b: int) -> bool {
    let n = "shared"
    return Wrap { tag: tag_a, name: n } != Wrap { tag: tag_b, name: n }
}

fn same(x: Handle<int>, y: Handle<int>) -> bool { return x == y }

fn differ(x: Handle<int>, y: Handle<int>) -> bool { return x != y }

fn handle_eq(a: int, b: int, c: int, d: int) -> bool {
    let x: Handle<int> = Handle { slot: a, generation: b }
    return same(x, Handle { slot: c, generation: d })
}

fn handle_ne(a: int, b: int, c: int, d: int) -> bool {
    let x: Handle<int> = Handle { slot: a, generation: b }
    return differ(x, Handle { slot: c, generation: d })
}

// A C-layout `value` stores `float` leaves as single precision, so leaves read
// back from storage are rounded while a scalarized operand's leaves are not.
value Tint { r: float, g: float, n: int }

struct TintHolder { tint: Tint? = null }

fn same_tint(h: TintHolder, t: Tint) -> bool { return h.tint.unwrap() == t }

fn differ_tint(h: TintHolder, t: Tint) -> bool { return h.tint.unwrap() != t }

fn stored_float_eq(r: float, g: float) -> bool {
    let h = TintHolder {}
    h.tint = Tint { r: r, g: g, n: 3 }
    return same_tint(h, Tint { r: r, g: g, n: 3 })
}

fn stored_float_ne(r: float, g: float) -> bool {
    let h = TintHolder {}
    h.tint = Tint { r: r, g: g, n: 3 }
    return differ_tint(h, Tint { r: r, g: g, n: 3 })
}

@test(output = "true false true false true true\ntrue false false false true\ntrue false true")
fn leaf_wise_equality_compares_every_field() {
    print("{eq_scalar(1.0, 2.0, 1.0, 2.0)} {eq_scalar(1.0, 2.0, 1.0, 3.0)} {ne_scalar(1.0, 2.0, 1.0, 3.0)} {ne_scalar(1.0, 2.0, 1.0, 2.0)} {eq_gc_same_ref(5)} {ne_gc_different_tag(5, 6)}")
    print("{handle_eq(1, 2, 1, 2)} {handle_eq(1, 2, 1, 3)} {handle_eq(1, 2, 4, 2)} {handle_ne(1, 2, 1, 2)} {handle_ne(1, 2, 1, 3)}")
    print("{stored_float_eq(0.4, 0.1)} {stored_float_ne(0.4, 0.1)} {stored_float_eq(0.5, 0.25)}")
}

value Child { name: string, amount: int }

value Parent { name: string, child: Child? = null }

struct Holder { row: Parent }

fn same_row(a: Holder, b: Holder) -> bool { return a.row == b.row }

struct Reference { name: string }

value ReferenceParent { child: Reference? = null }

struct ReferenceHolder { row: ReferenceParent }

fn same_reference(a: ReferenceHolder, b: ReferenceHolder) -> bool { return a.row == b.row }

fn row(amount: int) -> Holder {
    return Holder { row: Parent { name: "parent", child: Child { name: "child", amount: amount } } }
}

fn absent() -> Holder { return Holder { row: Parent { name: "parent" } } }

fn reference_row(r: Reference) -> ReferenceHolder {
    return ReferenceHolder { row: ReferenceParent { child: r } }
}

// Nullable value fields compare contents; nullable reference fields keep
// reference identity.
@test(output = "true false true false true false")
fn nullable_fields_in_enclosing_values() {
    let a = row(3)
    let r = Reference { name: "same" }
    let shared = same_reference(reference_row(r), reference_row(r))
    let fresh = same_reference(reference_row(r), reference_row(Reference { name: "same" }))
    print("{same_row(a, row(3))} {same_row(a, row(4))} {same_row(absent(), absent())} {same_row(a, absent())} {shared} {fresh}")
}
