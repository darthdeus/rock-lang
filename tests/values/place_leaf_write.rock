// A leaf write through a container element (`buf[i].x = 5`) or a struct field
// is a place write: the store lands on the slot, not on a copy of it. The
// element-read copy rule (tests/values/whole_read_copies.rock) applies to
// whole-value rvalue reads only, so an assignment target's base never packs.

value Pt { x: int, y: int }
value Inner { a: int, b: int }
struct Wrap { pts: NativeBuffer<Pt> }

fn nb_pt(n: int) -> NativeBuffer<Pt> {
    return native_buffer_alloc(n)
}

fn vec_pt(seed: int) -> [Pt] {
    return [Pt { x: seed, y: seed }]
}

@test(output = "99 1\n99 1\n42\n7 6\n3 4")
fn element_leaf_writes() {
    let buf = nb_pt(1)
    buf[0] = Pt { x: 1, y: 1 }
    buf[0].x = 99
    print("{buf[0].x} {buf[0].y}")
    let v = vec_pt(1)
    v[0].x = 99
    print("{v[0].x} {v[0].y}")
    let w = Wrap { pts: nb_pt(2) }
    w.pts[1] = Pt { x: 0, y: 0 }
    w.pts[1].y = 42
    print("{w.pts[1].y}")
    let c = nb_pt(1)
    c[0] = Pt { x: 5, y: 0 }
    c[0].x += 2
    let i = nb_pt(1)
    i[0] = Pt { x: 5, y: 0 }
    i[0].x++
    print("{c[0].x} {i[0].x}")
    let whole = nb_pt(1)
    whole[0] = Pt { x: 1, y: 1 }
    whole[0] = Pt { x: 3, y: 4 }
    print("{whole[0].x} {whole[0].y}")
}

struct Owner { p: Pt }
struct Deep { inner: Inner }
struct DeepOwner { d: Deep }

fn mk_owner(seed: int) -> Owner {
    return Owner { p: Pt { x: seed, y: seed } }
}

fn mk_deep(seed: int) -> DeepOwner {
    return DeepOwner { d: Deep { inner: Inner { a: seed, b: seed } } }
}

@test(output = "5 1\n8 1")
fn struct_field_leaf_writes() {
    let o = mk_owner(1)
    o.p.x = 5
    print("{o.p.x} {o.p.y}")
    let d = mk_deep(1)
    d.d.inner.a = 8
    print("{d.d.inner.a} {d.d.inner.b}")
}
