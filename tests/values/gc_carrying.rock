// A `value` with a non-C-mappable field, or a generic one, is GC-carrying: it
// materializes as a `<Name>_vt` table sharing one metatable, and equality is
// structural for scalar and value fields, by reference for GC-ref fields.

value Bag { xs: [int], n: int }
struct Holder { bag: Bag, tag: int }
value Marks { a: [int], b: [int] }
value Pair<T> { a: T, b: T }

fn make_bag(a: int, b: int, c: int, n: int) -> Bag {
    return Bag { xs: [a, b, c], n: n }
}

fn bag_sum(b: Bag) -> int {
    let s = 0
    for x in b.xs { s = s + x }
    return s + b.n
}

fn find_bag(want: int) -> Bag? {
    if want == 0 { return null }
    return make_bag(want, want * 2, want * 3, want)
}

global GBAG: Bag? = null

co fn co_bags() -> Coroutine<Bag> {
    yield make_bag(1, 1, 1, 1)
    yield make_bag(2, 2, 2, 2)
}

global ORDER: [int] = []

fn mark(n: int) -> [int] {
    ORDER.push(n)
    return [n]
}

fn make_marks() -> Marks? {
    return Marks { a: mark(1), b: mark(2) }
}

fn make_pair(x: int, y: int) -> Pair<int> {
    return Pair { a: x, b: y }
}

fn pair_sum(p: Pair<int>) -> int {
    return p.a + p.b
}

fn find_pair(want: int) -> Pair<int>? {
    if want == 0 { return null }
    return make_pair(want, want * 10)
}

@test(output = "7 -1 34 16 7 42 10\n4 8\n1 2\n33 -1 132")
fn gc_materialization_shapes() {
    let b = find_bag(1)
    if b == null { print("no bag"); return }
    let none = find_bag(0)
    let bags: [Bag] = []
    bags.push(make_bag(1, 2, 3, 4))
    bags.push(make_bag(5, 6, 7, 6))
    let total = 0
    for x in bags { total = total + bag_sum(x) }
    let h = Holder { bag: make_bag(2, 4, 6, 4), tag: 9 }
    let refined = Holder { bag: b, tag: 0 }
    GBAG = make_bag(10, 20, 9, 3)
    let gsum = bag_sum(GBAG)
    let captured = make_bag(1, 2, 3, 4)
    let f = () => bag_sum(captured)
    print("{bag_sum(b)} {if none != null { bag_sum(none) } else { -1 }} {total} {bag_sum(h.bag)} {bag_sum(refined.bag)} {gsum} {f()}")

    let c = co_bags()
    let y1 = c.resume()
    let y2 = c.resume()
    print("{if y1 != null { bag_sum(y1) } else { -1 }} {if y2 != null { bag_sum(y2) } else { -1 }}")

    let m = make_marks()
    if m == null { print("none") } else { print("{ORDER[0]} {ORDER[1]}") }

    let p = find_pair(3)
    let pn = find_pair(0)
    let ps: [Pair<int>] = []
    ps.push(make_pair(1, 10))
    ps.push(make_pair(11, 110))
    let ptotal = 0
    for q in ps { ptotal = ptotal + pair_sum(q) }
    print("{if p != null { pair_sum(p) } else { -1 }} {if pn != null { pair_sum(pn) } else { -1 }} {ptotal}")
}

value VecBox { xs: [int], n: int }
value SBox { s: string, n: int }
value Point { x: int, y: int }
value Tagged { p: Point, xs: [int] }
value Wrap { inner: VecBox, k: int }
struct Ref { v: int }
value HasRef { r: Ref, n: int }

// deepcopy of a GC-carrying value copies its GC-ref fields, so the copy compares unequal.
@test(output = "true false false false true\ntrue true false true false true false true false\n7 false true")
fn gc_equality_per_field_kind() {
    let xs = [1, 2, 3]
    let a = Bag { xs: xs, n: 5 }
    let b = Bag { xs: xs, n: 5 }
    let c = Bag { xs: [1, 2, 3], n: 5 }
    let d = Bag { xs: xs, n: 6 }
    let e = Bag { xs: [1, 2, 3], n: 5 }
    let shelf = Holder { bag: a, tag: 0 }
    print("{a == b} {a == c} {a == d} {e == c} {shelf.bag == b}")

    let w = "wor"
    let s1 = SBox { s: "{w}ld", n: 1 }
    let s2 = SBox { s: "world", n: 1 }
    let ys = [1, 2]
    let t1 = Tagged { p: Point { x: 1, y: 2 }, xs: ys }
    let t2 = Tagged { p: Point { x: 1, y: 2 }, xs: ys }
    let t3 = Tagged { p: Point { x: 9, y: 2 }, xs: ys }
    let shared = [7, 8]
    let w1 = Wrap { inner: VecBox { xs: shared, n: 3 }, k: 9 }
    let w2 = Wrap { inner: VecBox { xs: shared, n: 3 }, k: 9 }
    let w3 = Wrap { inner: VecBox { xs: [7, 8], n: 3 }, k: 9 }
    let r = Ref { v: 7 }
    let r1 = HasRef { r: r, n: 1 }
    let r2 = HasRef { r: r, n: 1 }
    let r3 = HasRef { r: Ref { v: 7 }, n: 1 }
    let p1 = make_pair(3, 4)
    let p2 = make_pair(3, 4)
    let p3 = make_pair(3, 5)
    print("{s1 == s2} {t1 == t2} {t1 == t3} {w1 == w2} {w1 == w3} {r1 == r2} {r1 == r3} {p1 == p2} {p1 == p3}")

    let orig = make_bag(1, 2, 3, 1)
    let copy = deepcopy(orig)
    print("{bag_sum(copy)} {orig == copy} {bag_sum(orig) == bag_sum(copy)}")
}

@test
fn inspect_gc_carrying_values() {
    assert_eq(inspect(VecBox { xs: [1, 2, 3], n: 5 }), "VecBox {{ n = 5, xs = Vec {{ 1, 2, 3 }} }}")
    assert_eq(inspect(SBox { s: "hi", n: 2 }), "SBox {{ n = 2, s = \"hi\" }}")
    assert_eq(inspect(HasRef { r: Ref { v: 7 }, n: 1 }), "HasRef {{ n = 1, r = Ref {{ v = 7 }} }}")
    assert_eq(inspect(Pair { a: 3, b: 4 }), "Pair {{ a = 3, b = 4 }}")
}
