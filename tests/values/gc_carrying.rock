// GC-carrying value structs: materialization shapes, then equality.
//
// A `value` struct with a non-C-mappable field (`[int]`, `Arena<T>`, ...) or a
// generic `value` struct is GC-CARRYING: it scalarizes through calls exactly
// like an FFI-clean value struct, but materializes as an immutable Lua table
// (`<Name>_vt(...)`), not cdata. Before the two-tier work these files CRASHED
// at every materialization site -- `value_struct_defs` skipped the cdef, so a
// nullable return / container store / capture emitted `<Name>_ct(...)` against
// an undefined ctor ("attempt to call global 'Bag_ct'").
//
// Every test asserts a RUNTIME VALUE, not just compilation. The eq cases pin
// the locked contract: scalar fields structural, GC-ref fields BY REFERENCE.

value Bag {
    xs: [int],
    n: int,
}

fn make_bag(a: int, b: int, c: int, n: int) -> Bag {
    return Bag { xs: [a, b, c], n: n }
}

fn bag_sum(b: Bag) -> int {
    let s = 0
    for x in b.xs { s = s + x }
    return s + b.n
}

// ----- 1. Nullable return (keeps the boxed ABI -> forces materialization).

fn find_bag(want: int) -> Bag? {
    if want == 0 { return null }
    return make_bag(want, want * 2, want * 3, want)
}

@test(output = "7\n-1")
fn gc_nullable_return() {
    let b = find_bag(1)
    print(if b != null { bag_sum(b) } else { -1 })   // (1+2+3) + 1 = 7
    let none = find_bag(0)
    print(if none != null { bag_sum(none) } else { -1 })
}

// ----- 2. Vec store + read-back.

@test(output = "34")
fn gc_vec_store() {
    let bags: [Bag] = []
    bags.push(make_bag(1, 2, 3, 4))    // sum 6+4 = 10
    bags.push(make_bag(5, 6, 7, 6))    // sum 18+6 = 24
    let total = 0
    for b in bags { total = total + bag_sum(b) }
    print(total)
}

// ----- 3. Struct-field store.

struct Holder {
    bag: Bag,
    tag: int,
}

@test(output = "16")
fn gc_struct_field_store() {
    let h = Holder { bag: make_bag(2, 4, 6, 4), tag: 9 }
    print(bag_sum(h.bag))              // 12 + 4 = 16
}

// ----- 4. Global store (nullable global).

global GBAG: Bag? = null

@test(output = "42")
fn gc_global_store() {
    GBAG = make_bag(10, 20, 9, 3)      // 39 + 3 = 42; GBAG refines non-null here
    print(bag_sum(GBAG))
}

// ----- 5. Capture in a closure.

@test(output = "10")
fn gc_capture() {
    let b = make_bag(1, 2, 3, 4)
    let f = () => bag_sum(b)
    print(f())                          // 6 + 4 = 10
}

// ----- 6. Coroutine yielding the whole value (boxed across the yield).

co fn co_bags() -> Coroutine<Bag> {
    yield make_bag(1, 1, 1, 1)          // 3 + 1 = 4
    yield make_bag(2, 2, 2, 2)          // 6 + 2 = 8
}

@test(output = "4\n8")
fn gc_coroutine_yield_value() {
    let c = co_bags()
    let a = c.resume()
    print(if a != null { bag_sum(a) } else { -1 })
    let b = c.resume()
    print(if b != null { bag_sum(b) } else { -1 })
}

// ----- 7. String interpolation of a container-carrying value is rejected at
// compile time (tests/errors/enum_format_unsupported_payload.rock.err).

// ----- 8. Equality: scalar structural, GC-ref BY REFERENCE.

@test(output = "true false")
fn gc_eq_ref_identity() {
    let xs = [1, 2, 3]
    let a = Bag { xs: xs, n: 5 }
    let b = Bag { xs: xs, n: 5 }        // same xs ref, same n -> equal
    let ys = [1, 2, 3]
    let c = Bag { xs: ys, n: 5 }        // different xs ref (equal contents) -> not equal
    print("{a == b} {a == c}")
}

@test(output = "false")
fn gc_eq_scalar_differs() {
    let xs = [1, 2, 3]
    let a = Bag { xs: xs, n: 5 }
    let b = Bag { xs: xs, n: 6 }        // same xs ref, different n -> not equal
    print("{a == b}")
}

// ----- 9. Generic value struct (generic => GC-tier, uniform slot).

value Pair<T> {
    a: T,
    b: T,
}

fn make_pair(x: int, y: int) -> Pair<int> {
    return Pair { a: x, b: y }
}

fn pair_sum(p: Pair<int>) -> int {
    return p.a + p.b
}

fn find_pair(want: int) -> Pair<int>? {
    if want == 0 { return null }
    return make_pair(want, want * 10)
}

@test(output = "33\n-1")
fn gc_generic_nullable_return() {
    let p = find_pair(3)
    print(if p != null { pair_sum(p) } else { -1 })   // 3 + 30 = 33
    let none = find_pair(0)
    print(if none != null { pair_sum(none) } else { -1 })
}

@test(output = "132")
fn gc_generic_vec_store() {
    let ps: [Pair<int>] = []
    ps.push(make_pair(1, 10))          // 11
    ps.push(make_pair(11, 110))        // 121
    let total = 0
    for p in ps { total = total + pair_sum(p) }
    print(total)                        // 132
}

// ----- 10. deepcopy of a GC-carrying value struct DEEP-COPIES (not shares):
// its fields survive, and because a value struct may hold a mutable ref the
// walk copies that ref -- so the GC-ref field is a fresh instance and value eq
// (GC-ref BY REFERENCE) reports the copy as distinct. (Self-contained cdata
// value structs are shared; the plan's "copy is share" holds only for those.)

@test(output = "7 false true")
fn gc_deepcopy_deep_copies_and_preserves_fields() {
    let b = make_bag(1, 2, 3, 1)       // xs=[1,2,3], n=1 -> sum 7
    let c = deepcopy(b)
    print("{bag_sum(c)} {b == c} {bag_sum(b) == bag_sum(c)}")
}

// GC-carrying value-struct equality: the per-field ref/contents split.
//
// A `value` struct with a non-C-mappable field (Vec, string, generic T, a
// reference struct, a nested value struct) is GC-CARRYING: it materializes as
// a table (`<Name>_vt`) with a per-type `__eq` that compares SCALAR and nested
// VALUE-struct fields structurally (`==`) but GC-REF fields BY REFERENCE
// (`rawequal`). This corpus is the cross-backend oracle for that split -- it
// is GREEN on luajit and must stay byte-identical on JS once the type-aware
// registry (`__rock_vt_eq`) lands. The load-bearing case is
// `diff_ref_equal_contents_ne`: two Vecs with EQUAL CONTENTS but different
// identity compare != -- exactly where value-struct eq diverges from the
// contents-walk a reference struct gets.

value VecBox {
    xs: [int],
    n: int,
}

// ----- 1. Same GC-ref identity -> equal.

@test(output = "true")
fn same_ref_vec_field_eq() {
    let shared = [1, 2, 3]
    let a = VecBox { xs: shared, n: 5 }
    let b = VecBox { xs: shared, n: 5 }
    print(a == b)
}

// ----- 2. Equal CONTENTS, different GC-ref identity -> NOT equal (the divergence).

@test(output = "false")
fn diff_ref_equal_contents_ne() {
    let a = VecBox { xs: [1, 2, 3], n: 5 }
    let b = VecBox { xs: [1, 2, 3], n: 5 }
    print(a == b)
}

// ----- 3. Same ref, differing scalar -> NOT equal (scalar field structural).

@test(output = "false")
fn same_ref_diff_scalar_ne() {
    let shared = [1, 2, 3]
    let a = VecBox { xs: shared, n: 5 }
    let b = VecBox { xs: shared, n: 6 }
    print(a == b)
}

// ----- 4. String field compares BY VALUE (Lua interns; JS `===` is by-value).

value SBox {
    s: string,
    n: int,
}

@test(output = "true")
fn string_field_by_value_eq() {
    let w = "wor"
    let a = SBox { s: "{w}ld", n: 1 }
    let b = SBox { s: "world", n: 1 }
    print(a == b)
}

// ----- 5. Nested SCALAR value-struct field: structural (a cdata `Point` on
// luajit compares byte-value; equal contents -> equal, differing -> not).

value Point {
    x: int,
    y: int,
}

value Tagged {
    p: Point,
    xs: [int],
}

@test(output = "true false")
fn nested_scalar_valuestruct_field_structural() {
    let xs = [1, 2]
    let a = Tagged { p: Point { x: 1, y: 2 }, xs: xs }
    let b = Tagged { p: Point { x: 1, y: 2 }, xs: xs }
    let c = Tagged { p: Point { x: 9, y: 2 }, xs: xs }
    print("{a == b} {a == c}")
}

// ----- 6. Nested GC-carrying value-struct field: structural (recurses into
// that struct's own per-field split -- its inner Vec is still BY REFERENCE).

value Wrap {
    inner: VecBox,
    k: int,
}

@test(output = "true false")
fn nested_gc_valuestruct_field_structural() {
    let shared = [7, 8]
    let a = Wrap { inner: VecBox { xs: shared, n: 3 }, k: 9 }
    let b = Wrap { inner: VecBox { xs: shared, n: 3 }, k: 9 }
    // Same inner Vec ref + equal scalars -> equal.
    let c = Wrap { inner: VecBox { xs: [7, 8], n: 3 }, k: 9 }
    // Inner Vec has equal contents but different identity -> not equal.
    print("{a == b} {a == c}")
}

// ----- 7. Reference-struct field compares BY REFERENCE (the `rawequal` arm).

struct Ref {
    v: int,
}

value HasRef {
    r: Ref,
    n: int,
}

@test(output = "true false")
fn ref_struct_field_by_reference() {
    let shared = Ref { v: 7 }
    let a = HasRef { r: shared, n: 1 }
    let b = HasRef { r: shared, n: 1 }
    let c = HasRef { r: Ref { v: 7 }, n: 1 }
    // b shares the Ref identity (equal); c has an equal-contents but distinct
    // Ref (NOT equal -- a reference struct field is compared by identity).
    print("{a == b} {a == c}")
}

// ----- 8. Generic value struct (generic => GC-tier). Fields are the generic
// `T`, compared by reference; for `int` payloads that is value-eq.
@test(output = "true false")
fn generic_pair_eq() {
    let a = make_pair(3, 4)
    let b = make_pair(3, 4)
    let c = make_pair(3, 5)
    print("{a == b} {a == c}")
}

// ----- 9. inspect: a GC-carrying value struct is a `_vt` TABLE on luajit,
// walked by the generic equals-format walker (NOT the colon `_vt.__tostring`,
// which inspect never calls) -- byte-agreeing with the JS `{__ty,..}`-object
// render. `assert_eq(inspect(..), "..")` byte-checks on BOTH backends. (A
// GC-FREE value struct stays gated: it is cdata, rendered colon via __tostring.)

@test
fn inspect_vec_field() {
    assert_eq(inspect(VecBox { xs: [1, 2, 3], n: 5 }), "VecBox {{ n = 5, xs = Vec {{ 1, 2, 3 }} }}")
}

@test
fn inspect_string_field() {
    assert_eq(inspect(SBox { s: "hi", n: 2 }), "SBox {{ n = 2, s = \"hi\" }}")
}

@test
fn inspect_ref_struct_field() {
    assert_eq(inspect(HasRef { r: Ref { v: 7 }, n: 1 }), "HasRef {{ n = 1, r = Ref {{ v = 7 }} }}")
}

@test
fn inspect_generic_pair() {
    assert_eq(inspect(Pair { a: 3, b: 4 }), "Pair {{ a = 3, b = 4 }}")
}
