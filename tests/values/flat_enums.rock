// Flat enum layouts: field key collisions, record projection, nesting, leaf gaps and mixed reads.

enum Sig { A, B(string) }

// Each `show` takes the struct by param so the parent survives as a table (a
// non-escaping parent scalarizes away and never exposes the key collision).
struct TagHolder { sig: Sig, sig__tag: int }

fn show_tag(h: TagHolder) {
    match h.sig {
        Sig::A => print("A {h.sig__tag}")
        Sig::B(n) => print("B {n} {h.sig__tag}")
    }
}

struct PayloadHolder { sig: Sig, sig__0: int }

fn show_payload(h: PayloadHolder) {
    match h.sig {
        Sig::A => print("A {h.sig__0}")
        Sig::B(n) => print("B {n} {h.sig__0}")
    }
}

enum Shape { Dot, Circle { r: string } }

struct ShapeHolder { shape: Shape, shape__r: int }

fn show_shape(h: ShapeHolder) {
    match h.shape {
        Shape::Dot => print("dot {h.shape__r}")
        Shape::Circle { r } => print("circle {r} {h.shape__r}")
    }
}

struct Plain { sig: Sig, other: int }

fn show_plain(h: Plain) {
    match h.sig {
        Sig::A => print("A {h.other}")
        Sig::B(n) => print("B {n} {h.other}")
    }
}

// User fields named like the flattened tag, positional and named payload slots;
// `Plain` is the control with no colliding field.
@test(output = "B seven 42\nB seven 7\ncircle big 5\nB seven 1")
fn test_flat_enum_slots_vs_user_fields() {
    show_tag(TagHolder { sig: Sig::B("seven"), sig__tag: 42 })
    show_payload(PayloadHolder { sig: Sig::B("seven"), sig__0: 7 })
    show_shape(ShapeHolder { shape: Shape::Circle { r: "big" }, shape__r: 5 })
    show_plain(Plain { sig: Sig::B("seven"), other: 1 })
}

nobox value ProjectedId { scene: int, arena: int, slot: int, generation: int }

enum ProjectedTarget { Player, Mob(ProjectedId) }

nobox value ProjectedLock { target: ProjectedTarget, visible: bool }

nobox value ProjectedSnapshot { lock: ProjectedLock }

struct ProjectedState { snapshot: ProjectedSnapshot }

fn projected_state(snapshot: ProjectedSnapshot) -> ProjectedState {
    return ProjectedState { snapshot }
}

fn projected_is_player(state: ProjectedState) -> bool {
    if let ProjectedTarget::Player = state.snapshot.lock.target {
        return true
    }
    return false
}

fn projected_payload(state: ProjectedState) -> int {
    return match state.snapshot.lock.target {
        ProjectedTarget::Player => -1,
        ProjectedTarget::Mob(id) => id.scene + id.arena + id.slot + id.generation,
    }
}

global PROJECTED_READS: int = 0

fn projected_once(state: ProjectedState) -> ProjectedState {
    PROJECTED_READS += 1
    return state
}

@test
fn flat_enum_record_projection_reads_unit_and_payload() {
    let state = projected_state(ProjectedSnapshot {
        lock: ProjectedLock { target: ProjectedTarget::Player, visible: false },
    })
    assert(projected_is_player(state))
    assert_eq(projected_payload(state), -1)
    state.snapshot.lock.target = ProjectedTarget::Mob(ProjectedId {
        scene: 1, arena: 2, slot: 3, generation: 4,
    })
    assert(!projected_is_player(state))
    assert_eq(projected_payload(state), 10)

    let literal = ProjectedState {
        snapshot: ProjectedSnapshot {
            lock: ProjectedLock { target: ProjectedTarget::Player, visible: false },
        },
    }
    assert(projected_is_player(literal))
    let snapshot = ProjectedSnapshot {
        lock: ProjectedLock {
            target: ProjectedTarget::Mob(ProjectedId {
                scene: 11, arena: 13, slot: 17, generation: 19,
            }),
            visible: true,
        },
    }
    literal.snapshot = snapshot
    assert_eq(projected_payload(literal), 60)
    let copied = literal.snapshot
    literal.snapshot.lock.target = ProjectedTarget::Player
    assert_eq(projected_payload(projected_state(copied)), 60)
    assert(projected_is_player(literal))

    PROJECTED_READS = 0
    let player = false
    if let ProjectedTarget::Player = projected_once(literal).snapshot.lock.target {
        player = true
    }
    assert(player)
    assert_eq(PROJECTED_READS, 1)
}

nobox value ProjectedOptionalSnapshot { lock: ProjectedLock? }

struct ProjectedOptionalState { snapshot: ProjectedOptionalSnapshot }

fn projected_optional_state(snapshot: ProjectedOptionalSnapshot) -> ProjectedOptionalState {
    return ProjectedOptionalState { snapshot }
}

fn projected_optional_payload(state: ProjectedOptionalState) -> int {
    if let lock = state.snapshot.lock {
        return match lock.target {
            ProjectedTarget::Player => 0,
            ProjectedTarget::Mob(id) => id.slot,
        }
    }
    return -1
}

@test
fn flat_enum_record_projection_preserves_nullable_child() {
    let state = projected_optional_state(ProjectedOptionalSnapshot { lock: null })
    assert_eq(projected_optional_payload(state), -1)
    state.snapshot.lock = ProjectedLock {
        target: ProjectedTarget::Mob(ProjectedId {
            scene: 2, arena: 3, slot: 5, generation: 7,
        }),
        visible: false,
    }
    assert_eq(projected_optional_payload(state), 5)
    state.snapshot.lock = ProjectedLock { target: ProjectedTarget::Player, visible: false }
    assert_eq(projected_optional_payload(state), 0)
    state.snapshot.lock = null
    assert_eq(projected_optional_payload(state), -1)
}

nobox value MixedPatternPlace { space: int, x: int, y: int }

struct MixedPatternSpec { name: string }

enum MixedPatternOccupant { None, Prop(int, int), Fixture(MixedPatternSpec) }

enum MixedPatternSubject { None, Object(MixedPatternPlace, MixedPatternOccupant) }

enum SentInner { Named(string), Empty }

enum SentOuter { Msg(SentInner), Other }

fn mixed_pattern_subject(occupant: MixedPatternOccupant) -> MixedPatternSubject {
    return MixedPatternSubject::Object(MixedPatternPlace { space: 1, x: 11, y: 10 }, occupant)
}

@test
fn nested_flat_enum_binds_mixed_payload() {
    let subject = mixed_pattern_subject(MixedPatternOccupant::Prop(0, 1))
    let result = match subject {
        MixedPatternSubject::Object(place, occupant) => match occupant {
            MixedPatternOccupant::Prop(id, orient) => place.x == 11 && id == 0 && orient == 1,
            _ => false,
        },
        _ => false,
    }
    assert(result, "the constructed payload survives separate matches")
    let nested = match mixed_pattern_subject(MixedPatternOccupant::Prop(0, 1)) {
        MixedPatternSubject::Object(place, MixedPatternOccupant::Prop(id, orient)) => place.x == 11 && id == 0 && orient == 1,
        _ => false,
    }
    // A nested flat enum shares the parent's slots: the inner pattern reads them directly.
    assert(nested, "nested mixed-enum pattern binds its flattened payload")
    let v = SentOuter::Msg(SentInner::Named("Harm"))
    let got = ""
    match v {
        SentOuter::Msg(SentInner::Named(spell)) => { got = spell }
        SentOuter::Msg(_) => { got = "fallback" }
        SentOuter::Other => { got = "other" }
    }
    assert_eq(got, "Harm", "a nested arm binds a string payload from the parent's slots")
}

co fn nested_mixed_pattern_coroutine() -> Coroutine<int> {
    yield 0
    match mixed_pattern_subject(MixedPatternOccupant::Prop(0, 1)) {
        MixedPatternSubject::Object(place, MixedPatternOccupant::Prop(id, orient)) => {
            yield if place.x == 11 && id == 0 && orient == 1 { 1 } else { -1 }
        },
        _ => { yield -2 },
    }
}

@test
fn nested_flat_enum_mixed_payload_after_yield() {
    let c = nested_mixed_pattern_coroutine()
    assert_eq(c.resume() ?? -9, 0)
    assert_eq(c.resume() ?? -9, 1)
}

nobox value ItemLeaf { value: int }

nobox value ItemSlot { leaf: ItemLeaf }

struct ItemInner { slot: ItemSlot }

struct ItemOuter { inner: ItemInner }

struct Item { outer: ItemOuter, flagged: bool }

enum ItemRef { None, Plain(Entity<Item>), Flagged(Entity<Item>) }

fn item_ref(entity: Entity<Item>, item: Item) -> ItemRef {
    return if item.flagged { ItemRef::Flagged(entity) } else { ItemRef::Plain(entity) }
}

// A native enum return must replace the leaves initialized by a variant.
@test fn enum_return_assignment_projects_variant_and_leaf() {
    let rows: Arena<Item> = arena_new()
    let item = rows.insert(Item {
        flagged: true,
        outer: ItemOuter {
            inner: ItemInner { slot: ItemSlot { leaf: ItemLeaf { value: 17 } } },
        },
    })
    let target_leaf: ItemLeaf? = null
    let kind = ItemRef::Plain(item)
    if let target = item.get() {
        kind = item_ref(item, target)
        target_leaf = target.outer.inner.slot.leaf
    }
    match kind {
        ItemRef::Flagged(entity) => assert(entity == item),
        _ => assert(false),
    }
    if let leaf = target_leaf {
        assert_eq(leaf.value, 17)
    } else { assert(false) }
    let _ = arena_destroy(rows)
    let _ = __arena_drain_retired()
}

struct RecordLeft { id: int }

struct RecordRight { id: int }

enum RecordKind { Left(RecordLeft), Right(RecordRight) }

struct Record { right: bool }

fn Record.kind(record) -> RecordKind? {
    if record.right { return RecordKind::Right(RecordRight { id: 43 }) }
    return null
}

// A nullable native return replaces both presence and payload leaves.
@test fn nullable_enum_return_assignment_projects_presence_and_payload() {
    let records: Arena<Record> = arena_new()
    let record = records.insert(Record { right: true })
    let kind: RecordKind? = null
    if let value = record.get() { kind = value.kind() }
    if let value = kind {
        match value {
            RecordKind::Right(right) => assert_eq(right.id, 43),
            RecordKind::Left(_) => assert(false),
        }
    } else { assert(false) }
    if let value = record.get() { value.right = false }
    kind = record.get().unwrap().kind()
    assert(kind == null)
    let _ = arena_destroy(records)
    let _ = __arena_drain_retired()
}

enum State { Idle, Casting(string, int), Named { name: string } }

struct Combat { state: State }

fn set_state(combat: Combat, i: int) {
    combat.state = if i % 4 == 0 { State::Casting("spell", i) }
        else if i % 4 == 2 { State::Named { name: "named" } }
        else { State::Idle }
}

fn field_read_loop() -> bool {
    let combat = Combat { state: State::Idle }
    for i in 0..12 {
        set_state(combat, i)
        let state = combat.state
        if i % 2 == 1 { if state != State::Idle { return false } }
        else if state == State::Idle { return false }
    }
    return true
}

@test
fn mixed_enum_field_read_loop_clears_previous_payload() {
    assert(field_read_loop())
}

co fn tick() -> Coroutine<int> { yield 1 }

co fn field_read_await_loop(combat: Combat) -> Coroutine<int> {
    for i in 0..12 {
        set_state(combat, i)
        let state = combat.state
        await tick()
        if i % 2 == 1 { yield if state == State::Idle { 1 } else { 0 } }
        else { yield if state != State::Idle { 1 } else { 0 } }
    }
}

fn field_read_coroutine() -> bool {
    let c = field_read_await_loop(Combat { state: State::Idle })
    for _ in 0..12 {
        if c.resume() != 1 { return false }
        if c.resume() != 1 { return false }
    }
    return c.resume() == null
}

@test
fn mixed_enum_field_read_across_await_clears_previous_payload() {
    assert(field_read_coroutine())
}

nobox value NavId { a: int, b: int }
enum NavRef { Player(NavId), Mob(NavId) }
struct NavHolder { id: int, name: string = "", live: NavRef? = null }

fn nav_live(holder: NavHolder?) -> NavRef? { return holder?.live }

@test fn safe_navigation_reads_a_flat_enum_field() {
    let holder = NavHolder { id: 1, live: NavRef::Mob(NavId { a: 3, b: 4 }) }
    match nav_live(holder) ?? NavRef::Player(NavId { a: 0, b: 0 }) {
        NavRef::Mob(id) => assert_eq(id.a + id.b, 7)
        NavRef::Player(_) => assert(false)
    }
    assert(nav_live(NavHolder { id: 2 }) == null)
    assert(nav_live(null) == null)
}

struct OptionalSignal { sig: Sig? }

@noalloc
fn signal_is_absent(holder: OptionalSignal) -> bool {
    return null == holder.sig
}

@noalloc
fn signal_is_present(holder: OptionalSignal) -> bool {
    if holder.sig != null { return true }
    return false
}

@test
fn flat_enum_presence_only_reads_the_tag() {
    let holder = OptionalSignal { sig: null }
    assert(signal_is_absent(holder))
    assert(!signal_is_present(holder))
    holder.sig = Sig::A
    assert(!signal_is_absent(holder))
    assert(signal_is_present(holder))
    holder.sig = Sig::B("payload")
    assert(!signal_is_absent(holder))
    assert(signal_is_present(holder))
}

enum SignalWithList { Quiet, Active([int]) }
struct ListSignalHolder { sig: SignalWithList? }

global LIST_SIGNAL_READS: int = 0

@noalloc
fn read_list_signal(holder: ListSignalHolder) -> ListSignalHolder {
    LIST_SIGNAL_READS += 1
    return holder
}

@noalloc
fn signal_is_quiet(holder: ListSignalHolder) -> bool {
    return SignalWithList::Quiet == read_list_signal(holder).sig
}

@noalloc
fn signal_is_not_quiet(holder: ListSignalHolder) -> bool {
    return read_list_signal(holder).sig != SignalWithList::Quiet
}

@test
fn flat_enum_unit_equality_only_reads_the_tag() {
    LIST_SIGNAL_READS = 0
    let holder = ListSignalHolder { sig: null }
    assert(!signal_is_quiet(holder))
    assert(signal_is_not_quiet(holder))
    holder.sig = SignalWithList::Quiet
    assert(signal_is_quiet(holder))
    assert(!signal_is_not_quiet(holder))
    holder.sig = SignalWithList::Active([123])
    assert(!signal_is_quiet(holder))
    assert(signal_is_not_quiet(holder))
    assert_eq(LIST_SIGNAL_READS, 6)
}
