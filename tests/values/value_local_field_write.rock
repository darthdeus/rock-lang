// A field write through a value local or a by-value parameter replaces that
// binding's whole value (#107): `a.b.c = v` means `a = A { ..a, b: B { ..a.b,
// c: v } }`, whatever the representation (boxed, scalarized, nobox). No other
// copy observes the write: not the value it was copied from, not a caller's
// argument, not a container it was pushed into. A call result or literal is
// still a temporary, and `field_set` still cannot take a value
// (tests/errors/value_struct_field_write.rock.err).
//
// Sibling coverage: writes through mutable storage are
// tests/values/place_leaf_write.rock and field_write_scalarized_local.rock.

value In { c: int, s: string }          // GC-carrying (string field)
value Pt { x: int, b: In }
value FPoint { x: float, y: float }     // FFI-clean, scalarizable
value MaybeIn { x: int, b: In? }        // opaque nullable child
value Gen<T> { v: T, n: int }           // generic child
nobox value Sid { value: int }
nobox value Place { space: Sid, pos: FPoint }
nobox value MaybeSid { a: Sid?, k: int }
enum Mode { Off, On(int) }
value WithEnum { m: Mode, k: int }
struct Holder { p: Pt }
value Wide {
    a0: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int, a7: int, a8: int, a9: int,
    b0: int, b1: int, b2: int, b3: int, b4: int, b5: int, b6: int, b7: int, b8: int, b9: int,
    c0: int, c1: int, c2: int, c3: int, c4: int, c5: int, c6: int, c7: int, c8: int, c9: int,
    d0: int, d1: int, d2: int, d3: int, d4: int, d5: int, d6: int, d7: int, d8: int, d9: int,
    e0: int, e1: int, e2: int, e3: int, e4: int, e5: int, e6: int, e7: int, e8: int, e9: int,
    s: string,
}

global G: Pt = Pt { x: 1, b: In { c: 1, s: "g" } }

fn mk() -> Pt { return Pt { x: 1, b: In { c: 1, s: "a" } } }
fn mkp() -> Place { return Place { space: Sid { value: 3 }, pos: FPoint { x: 1.0, y: 2.0 } } }

fn mode_n(m: Mode) -> int {
    return match m {
        Mode::Off => 0,
        Mode::On(n) => n,
    }
}

// -- Plain, compound and inc/dec forms on a local --

@test(output = "1 9")
fn copy_does_not_see_write() {
    let v = mk()
    let a = v
    a.x = 9
    print("{v.x} {a.x}")
}

@test(output = "9 1")
fn source_write_does_not_reach_copy() {
    let v = mk()
    let a = v
    v.x = 9
    print("{v.x} {a.x}")
}

@test(output = "1 6 1")
fn nested_compound() {
    let v = mk()
    let a = v
    let i = a.b
    a.b.c += 5
    print("{v.b.c} {a.b.c} {i.c}")
}

@test(output = "2 0 1 2")
fn incdec_prefix_postfix() {
    let a = mk()
    let old = a.x++
    let new = --a.b.c
    print("{a.x} {a.b.c} {old} {a.x}")
    assert_eq(new, 0)
}

@test(output = "1 2")
fn whole_child_replaced() {
    let a = mk()
    let b = a
    a.b = In { c: 2, s: "z" }
    print("{b.b.c} {a.b.c}")
}

@test(output = "x 1 y a")
fn gc_carrying_fields() {
    let v = mk()
    let a = v
    let b = v
    a.b.s = "x"
    b.b.s = "y"
    print("{a.b.s} {a.b.c} {b.b.s} {v.b.s}")
}

@test(output = "0.5 1")
fn scalarized_local() {
    let s = FPoint { x: 0.5, y: 0.5 }
    s.y *= 2.0
    print("{s.x} {s.y}")
}

@test(output = "3 1")
fn written_in_a_loop() {
    let p = FPoint { x: 0.0, y: 1.0 }
    let i = 0
    while i < 3 {
        p.x += 1.0
        i++
    }
    print("{p.x} {p.y}")
}

@test(output = "2 1")
fn written_on_one_branch() {
    let p = FPoint { x: 1.0, y: 1.0 }
    let q = p
    if q.x > 0.0 {
        q.x = 2.0
    } else {
        q.y = 5.0
    }
    print("{q.x} {p.x}")
}

@test(output = "1 3")
fn math_value_local() {
    let v = Vec2 { x: 1.0, y: 2.0 }
    let w = v
    w.y += 1.0
    print("{v.x} {w.y}")
}

@test(output = "0 2 9")
fn enum_field() {
    let w = WithEnum { m: Mode::Off, k: 0 }
    let v = w
    w.m = Mode::On(2)
    w.k = 9
    print("{mode_n(v.m)} {mode_n(w.m)} {w.k}")
}

// -- Where the local's value came from --

@test(output = "1 9")
fn reassigned_from_another_local() {
    let v = mk()
    let a = mk()
    a = v
    a.x = 9
    print("{v.x} {a.x}")
}

@test(output = "1 9")
fn copied_from_global() {
    let a = G
    a.x = 9
    print("{G.x} {a.x}")
}

@test(output = "1 9")
fn copied_from_struct_field() {
    let h = Holder { p: mk() }
    let a = h.p
    a.x = 9
    print("{h.p.x} {a.x}")
}

@test(output = "1 9")
fn copied_from_element() {
    let xs = [mk()]
    let a = xs[0]
    a.b.c = 9
    print("{xs[0].b.c} {a.b.c}")
}

@test(output = "1 5")
fn child_built_from_another_local() {
    let i = In { c: 1, s: "a" }
    let a = Pt { x: 1, b: i }
    a.b.c = 5
    print("{i.c} {a.b.c}")
}

@test(output = "1 5")
fn child_assigned_from_another_local() {
    let i = In { c: 1, s: "a" }
    let a = mk()
    a.b = i
    a.b.c = 5
    print("{i.c} {a.b.c}")
}

@test(output = "0 1 2")
fn pushed_copies_keep_their_values() {
    let xs: [Pt] = []
    let a = mk()
    for i in 0..3 {
        a.b.c = i
        xs.push(a)
    }
    print("{xs[0].b.c} {xs[1].b.c} {xs[2].b.c}")
}

fn written_copy_of(p: Pt) -> Pt {
    let a = p
    a.b.s = "w"
    return a
}

@test(output = "a w")
fn returned_written_copy() {
    let v = mk()
    let w = written_copy_of(v)
    print("{v.b.s} {w.b.s}")
}

// -- Parameter roots: the caller's argument never changes --

fn bump_param(p: Pt) -> int {
    p.b.c = 7
    p.x += 1
    return p.b.c + p.x
}

@test(output = "1 1 9")
fn param_root() {
    let v = mk()
    let r = bump_param(v)
    print("{v.b.c} {v.x} {r}")
}

fn double_y(p: FPoint) -> FPoint {
    p.y *= 2.0
    return p
}

@test(output = "0.5 1")
fn scalarized_param_root() {
    let s = FPoint { x: 0.5, y: 0.5 }
    let t = double_y(s)
    print("{s.y} {t.y}")
}

fn Pt.bump(p) -> int {
    p.x += 1
    return p.x
}

@test(output = "2 1")
fn method_receiver_is_by_value() {
    let v = mk()
    let r = v.bump()
    print("{r} {v.x}")
}

fn mkwide() -> Wide {
    return Wide {
        a0: 0, a1: 1, a2: 2, a3: 3, a4: 4, a5: 5, a6: 6, a7: 7, a8: 8, a9: 9,
        b0: 0, b1: 1, b2: 2, b3: 3, b4: 4, b5: 5, b6: 6, b7: 7, b8: 8, b9: 9,
        c0: 0, c1: 1, c2: 2, c3: 3, c4: 4, c5: 5, c6: 6, c7: 7, c8: 8, c9: 9,
        d0: 0, d1: 1, d2: 2, d3: 3, d4: 4, d5: 5, d6: 6, d7: 7, d8: 8, d9: 9,
        e0: 0, e1: 1, e2: 2, e3: 3, e4: 4, e5: 5, e6: 6, e7: 7, e8: 8, e9: 9,
        s: "w",
    }
}

// Wider than the scalar ABI cut, so it crosses the call as one box.
fn bump_wide(w: Wide) -> int {
    w.e9 += 100
    w.s = "changed"
    return w.e9
}

@test(output = "109 9 w")
fn boxed_param_root() {
    let w = mkwide()
    let r = bump_wide(w)
    print("{r} {w.e9} {w.s}")
}

@test(output = "9 50")
fn boxed_local_copy() {
    let w = mkwide()
    let v = w
    v.e9 = 50
    print("{w.e9} {v.e9}")
}

@test(output = "1 2")
fn lambda_param_root() {
    let v = mk()
    let f = (p: Pt) => {
        p.x += 1
        return p.x
    }
    let r = f(v)
    print("{v.x} {r}")
}

// -- Pattern, loop and static bindings are locals too --

@test(output = "1 1 1")
fn for_binding_is_a_copy() {
    let xs = [mk(), mk()]
    for p in xs {
        p.x = 9
        p.b.c = 9
    }
    print("{xs[0].x} {xs[1].x} {xs[0].b.c}")
}

@test(output = "1 9")
fn if_let_binding() {
    let o: Pt? = mk()
    let r = 0
    if let p = o {
        p.x = 9
        r = p.x
    }
    print("{o?.x ?? 0} {r}")
}

enum Slot { Full(Pt), Empty }

@test(output = "1 9")
fn match_payload_binding() {
    let e = Slot::Full(mk())
    let r = 0
    match e {
        Slot::Full(p) => {
            p.x = 9
            r = p.x
        },
        Slot::Empty => {},
    }
    match e {
        Slot::Full(p) => print("{p.x} {r}"),
        Slot::Empty => {},
    }
}

fn static_counter() -> int {
    static s = Pt { x: 0, b: In { c: 0, s: "" } }
    let snap = s
    s.x += 1
    return s.x * 10 + snap.x
}

@test(output = "10 21")
fn static_root() {
    let a = static_counter()
    let b = static_counter()
    print("{a} {b}")
}

// -- Nullable roots and children --

// A `V?` local is written once it is known to be present.
@test(output = "1 5")
fn nullable_root_after_check() {
    let v: Pt? = mk()
    let w = v
    if v != null {
        v.x = 5
    }
    print("{w?.x ?? 0} {v?.x ?? 0}")
}

@test(output = "5 1")
fn nullable_child_after_check() {
    let a = MaybeIn { x: 1, b: In { c: 1, s: "a" } }
    let b = a
    if a.b != null {
        a.b.c = 5
    }
    print("{a.b?.c ?? 0} {b.b?.c ?? 0}")
}

@test(output = "1 5")
fn nullable_child_built_from_another_local() {
    let i = In { c: 1, s: "a" }
    let a = MaybeIn { x: 1, b: i }
    if a.b != null {
        a.b.c = 5
    }
    print("{i.c} {a.b?.c ?? 0}")
}

@test(output = "1 1 5")
fn nullable_child_copied_from_element() {
    let i = In { c: 1, s: "a" }
    let xs = [MaybeIn { x: 0, b: i }]
    let a = xs[0]
    if a.b != null {
        a.b.c = 5
    }
    print("{i.c} {xs[0].b?.c ?? 0} {a.b?.c ?? 0}")
}

// The binding holds its leaves; the opaque child's box is still the source's.
@test(output = "1 5 1")
fn nullable_child_of_if_let_binding() {
    let o: MaybeIn? = MaybeIn { x: 1, b: In { c: 1, s: "a" } }
    let r = 0
    if let p = o {
        if p.b != null {
            p.b.c = 5
            r = p.b.c
        }
    }
    print("{o?.b?.c ?? 0} {r} {o?.x ?? 0}")
}

@test(output = "1 5")
fn nullable_child_read_out_before_write() {
    let a = MaybeIn { x: 1, b: In { c: 1, s: "a" } }
    let i = a.b
    if a.b != null {
        a.b.c = 5
    }
    print("{i?.c ?? 0} {a.b?.c ?? 0}")
}

fn read_out_then_write(a: MaybeIn) -> int {
    let i = a.b
    if a.b != null {
        a.b.c = 5
    }
    return (i?.c ?? 0) * 10 + (a.b?.c ?? 0)
}

@test(output = "15 1")
fn nullable_child_of_param_read_out_before_write() {
    let a = MaybeIn { x: 1, b: In { c: 1, s: "a" } }
    let r = read_out_then_write(a)
    print("{r} {a.b?.c ?? 0}")
}

@test(output = "1 2 7")
fn generic_child() {
    let g = Gen { v: mk(), n: 1 }
    let h = g
    g.v.x = 7
    h.n = 2
    print("{g.n} {h.n} {g.v.x}")
}

@test(output = "1 5")
fn generic_child_built_from_another_local() {
    let i = In { c: 1, s: "a" }
    let g = Gen { v: i, n: 0 }
    g.v.c = 5
    print("{i.c} {g.v.c}")
}

// -- Safe navigation: `v?.f = x` writes only when every link is present --

value Wrap { p: Pt?, n: int }
value Deep { q: Pt?, n: int }
nobox value MaybeSid2 { a: Sid?, k: int }

fn mkn(present: bool) -> Pt? {
    if present {
        return mk()
    }
    return null
}

fn mkd(present: bool) -> Deep? {
    if present {
        return Deep { q: mk(), n: 0 }
    }
    return null
}

@test(output = "1 5")
fn safe_nav_root_copied_from_call() {
    let w = mkn(true)
    let v = w
    v?.x = 5
    print("{w?.x ?? 0} {v?.x ?? 0}")
}

@test(output = "1 5")
fn safe_nav_root_copied_from_local() {
    let w: Pt? = mk()
    let v = w
    v?.x = 5
    print("{w?.x ?? 0} {v?.x ?? 0}")
}

@test(output = "0 true")
fn safe_nav_absent_root_is_a_no_op() {
    let v = mkn(false)
    v?.x = 5
    v?.x += 2
    print("{v?.x ?? 0} {v == null}")
}

@test(output = "3 1")
fn safe_nav_compound() {
    let w = mkn(true)
    let v = w
    v?.x += 2
    print("{v?.x ?? 0} {w?.x ?? 0}")
}

@test(output = "7 1")
fn safe_nav_whole_child() {
    let w = mkn(true)
    let v = w
    v?.b = In { c: 7, s: "z" }
    print("{(v?.b)?.c ?? 0} {(w?.b)?.c ?? 0}")
}

@test(output = "3 1")
fn safe_nav_opaque_child() {
    let w = Wrap { p: mk(), n: 0 }
    let v = w
    v.p?.x += 2
    print("{v.p?.x ?? 0} {w.p?.x ?? 0}")
}

@test(output = "5 1 0")
fn safe_nav_two_links() {
    let d = mkd(true)
    let e = d
    e?.q?.x = 5
    let f = mkd(false)
    f?.q?.x = 5
    print("{(e?.q)?.x ?? 0} {(d?.q)?.x ?? 0} {(f?.q)?.x ?? 0}")
}

fn safe_nav_through_param(w: Wrap, v: Pt?) -> int {
    w.p?.x = 5
    v?.x += 10
    return (w.p?.x ?? 0) * 100 + (v?.x ?? 0)
}

@test(output = "511 1 1")
fn safe_nav_param_roots() {
    let w = Wrap { p: mk(), n: 0 }
    let v = mkn(true)
    let r = safe_nav_through_param(w, v)
    print("{r} {w.p?.x ?? 0} {v?.x ?? 0}")
}

@test(output = "4 3 0")
fn safe_nav_nobox_child() {
    let m = MaybeSid2 { a: Sid { value: 3 }, k: 0 }
    let n = m
    n.a?.value += 1
    let z = MaybeSid2 { a: null, k: 0 }
    z.a?.value = 9
    print("{n.a?.value ?? 0} {m.a?.value ?? 0} {z.a?.value ?? 0}")
}

// -- nobox values: leaves only, never a box --

@test(output = "3 9 1 4.5 3")
fn nobox_local() {
    let p = mkp()
    let q = p
    q.space.value = 9
    q.pos.x += 3.5
    q.pos.y++
    print("{p.space.value} {q.space.value} {p.pos.x} {q.pos.x} {q.pos.y}")
}

@test(output = "7 3")
fn nobox_whole_child() {
    let p = mkp()
    let q = p
    q.space = Sid { value: 7 }
    print("{q.space.value} {p.space.value}")
}

fn nobox_param(p: Place) -> int {
    p.space.value *= 2
    p.pos = FPoint { x: 0.0, y: 0.0 }
    return p.space.value + p.pos.x as int
}

@test(output = "6 3 1")
fn nobox_param_root() {
    let p = mkp()
    let r = nobox_param(p)
    print("{r} {p.space.value} {p.pos.x}")
}

@test(output = "5 3")
fn nobox_nullable_child() {
    let m = MaybeSid { a: Sid { value: 3 }, k: 0 }
    let n = m
    if n.a != null {
        n.a.value = 5
    }
    print("{n.a?.value ?? 0} {m.a?.value ?? 0}")
}

// -- Captures and coroutines --

// A closure shares the binding, so it sees a field write exactly as it sees
// a whole-value reassignment.
@test(output = "5 5")
fn capture_sees_write_like_reassignment() {
    let a = mk()
    let b = mk()
    let fa = () => a.x
    let fb = () => b.x
    a.x = 5
    b = Pt { ..b, x: 5 }
    print("{fa()} {fb()}")
}

@test(output = "1 3")
fn captured_source_does_not_see_copy_write() {
    let v = mk()
    let f = () => v.x
    let a = v
    a.x = 3
    print("{f()} {a.x}")
}

@test(output = "1 7 7")
fn closure_writes_nested_field() {
    let v = mk()
    let a = v
    let set = (n: int) => { a.b.c = n }
    set(7)
    let get = () => a.b.c
    print("{v.b.c} {a.b.c} {get()}")
}

@test(output = "1 5 5")
fn escaping_closure() {
    let v = mk()
    let a = v
    let fs: [fn() -> int] = []
    fs.push(() => a.x)
    a.x = 5
    print("{v.x} {a.x} {fs[0]()}")
}

@test(output = "3 2")
fn nobox_capture() {
    let p = FPoint { x: 1.0, y: 2.0 }
    let q = Sid { value: 0 }
    let f = () => p.x + q.value as float
    p.x = 3.0
    print("{f()} {p.y}")
}

co fn co_param(p: Pt) -> Coroutine<int, (), ()> {
    p.x += 10
    yield p.x
    p.b.c += 1
    yield p.b.c
}

@test(output = "11 2 1")
fn coroutine_param_root() {
    let v = mk()
    let c = co_param(v)
    let a = c.resume() ?? -1
    let b = c.resume() ?? -1
    print("{a} {b} {v.x}")
}

co fn co_local() -> Coroutine<int, (), ()> {
    let a = mk()
    let b = a
    let f = () => a.b.c
    a.x = 4
    yield a.x
    a.b.c = 6
    yield b.x * 10 + f()
}

@test(output = "4 16")
fn coroutine_local_and_capture() {
    let c = co_local()
    let x = c.resume() ?? -1
    let y = c.resume() ?? -1
    print("{x} {y}")
}

co fn co_nobox() -> Coroutine<int, (), ()> {
    let p = mkp()
    p.space.value = 11
    yield p.space.value
    p.space.value += 1
    yield p.space.value
}

@test(output = "11 12")
fn coroutine_nobox_local() {
    let c = co_nobox()
    let a = c.resume() ?? -1
    let b = c.resume() ?? -1
    print("{a} {b}")
}

// -- Value tests: these also run under `rock test --backend glsl` --

fn shift3(v: Vec3) -> float {
    v.z *= 2.0
    v.x++
    return v.x + v.z
}

@test(returns = 12.0)
fn vec3_param_root() -> float {
    let v = Vec3 { x: 1.0, y: 0.0, z: 3.0 }
    let r = shift3(v)
    return r + v.x + v.z
}

@test(returns = 3.5)
fn vec2_local_copy() -> float {
    let v = Vec2 { x: 1.0, y: 2.0 }
    let w = v
    w.y += 0.5
    return v.x + w.y
}

@test(returns = 5.0)
fn vec2_postfix_result() -> float {
    let v = Vec2 { x: 2.0, y: 0.0 }
    let old = v.x++
    return old + v.x
}

@test(returns = 7.0)
fn vec2_prefix_result() -> float {
    let v = Vec2 { x: 2.0, y: 0.0 }
    let new = ++v.x
    return new + v.x + v.y + 1.0
}
