// A field write through a value local or a by-value parameter replaces that
// binding's whole value (#107): `a.b.c = v` means `a = A { ..a, b: B { ..a.b,
// c: v } }`, whatever the representation (boxed, scalarized, nobox). No other
// copy observes the write. Writes through mutable storage are
// tests/values/place_leaf_write.rock.

value In { c: int, s: string }          // GC-carrying (string field)
value Pt { x: int, b: In }
value FPoint { x: float, y: float }     // FFI-clean, scalarizable
value MaybeIn { x: int, b: In? }        // opaque nullable child
value Gen<T> { v: T, n: int }
nobox value Sid { value: int }
nobox value Place { space: Sid, pos: FPoint }
nobox value MaybeSid { a: Sid?, k: int }
enum Mode { Off, On(int) }
value WithEnum { m: Mode, k: int }
struct Holder { p: Pt }
value Wide {
    a0: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int, a7: int, a8: int, a9: int,
    b0: int, b1: int, b2: int, b3: int, b4: int, b5: int, b6: int, b7: int, b8: int, b9: int,
    c0: int, c1: int, c2: int, c3: int, c4: int, c5: int, c6: int, c7: int, c8: int, c9: int,
    d0: int, d1: int, d2: int, d3: int, d4: int, d5: int, d6: int, d7: int, d8: int, d9: int,
    e0: int, e1: int, e2: int, e3: int, e4: int, e5: int, e6: int, e7: int, e8: int, e9: int,
    s: string,
}

global G: Pt = Pt { x: 1, b: In { c: 1, s: "g" } }

fn mk() -> Pt { return Pt { x: 1, b: In { c: 1, s: "a" } } }
fn mkp() -> Place { return Place { space: Sid { value: 3 }, pos: FPoint { x: 1.0, y: 2.0 } } }

fn mode_n(m: Mode) -> int {
    return match m {
        Mode::Off => 0,
        Mode::On(n) => n,
    }
}

@test(output = "1 9 9 1\n1 6 1\n2 0 1 2\n1 2\nx 1 y a\n0 2 9")
fn local_forms() {
    let v = mk()
    let a = v
    a.x = 9
    let v2 = mk()
    let a2 = v2
    v2.x = 9
    print("{v.x} {a.x} {v2.x} {a2.x}")
    let v3 = mk()
    let a3 = v3
    let i = a3.b
    a3.b.c += 5
    print("{v3.b.c} {a3.b.c} {i.c}")
    let a4 = mk()
    let old = a4.x++
    let new = --a4.b.c
    print("{a4.x} {a4.b.c} {old} {a4.x}")
    assert_eq(new, 0)
    let a5 = mk()
    let b5 = a5
    a5.b = In { c: 2, s: "z" }
    print("{b5.b.c} {a5.b.c}")
    let v6 = mk()
    let a6 = v6
    let b6 = v6
    a6.b.s = "x"
    b6.b.s = "y"
    print("{a6.b.s} {a6.b.c} {b6.b.s} {v6.b.s}")
    let w = WithEnum { m: Mode::Off, k: 0 }
    let w2 = w
    w.m = Mode::On(2)
    w.k = 9
    print("{mode_n(w2.m)} {mode_n(w.m)} {w.k}")
}

@test(output = "0.5 1 3 1 2 1")
fn scalarized_local_forms() {
    let s = FPoint { x: 0.5, y: 0.5 }
    s.y *= 2.0
    let p = FPoint { x: 0.0, y: 1.0 }
    let i = 0
    while i < 3 {
        p.x += 1.0
        i++
    }
    let o = FPoint { x: 1.0, y: 1.0 }
    let q = o
    if q.x > 0.0 {
        q.x = 2.0
    } else {
        q.y = 5.0
    }
    print("{s.x} {s.y} {p.x} {p.y} {q.x} {o.x}")
}

fn written_copy_of(p: Pt) -> Pt {
    let a = p
    a.b.s = "w"
    return a
}

@test(output = "1 9 1 9 1 9 1 9\n1 5 1 5\n0 1 2 a w")
fn copy_sources() {
    let v = mk()
    let a = mk()
    a = v
    a.x = 9
    let g = G
    g.x = 9
    let h = Holder { p: mk() }
    let hp = h.p
    hp.x = 9
    let xs = [mk()]
    let e = xs[0]
    e.b.c = 9
    print("{v.x} {a.x} {G.x} {g.x} {h.p.x} {hp.x} {xs[0].b.c} {e.b.c}")
    let i = In { c: 1, s: "a" }
    let built = Pt { x: 1, b: i }
    built.b.c = 5
    let j = In { c: 1, s: "a" }
    let assigned = mk()
    assigned.b = j
    assigned.b.c = 5
    print("{i.c} {built.b.c} {j.c} {assigned.b.c}")
    let ys: [Pt] = []
    let pushed = mk()
    for n in 0..3 {
        pushed.b.c = n
        ys.push(pushed)
    }
    let src = mk()
    let w = written_copy_of(src)
    print("{ys[0].b.c} {ys[1].b.c} {ys[2].b.c} {src.b.s} {w.b.s}")
}

fn bump_param(p: Pt) -> int {
    p.b.c = 7
    p.x += 1
    return p.b.c + p.x
}

fn double_y(p: FPoint) -> FPoint {
    p.y *= 2.0
    return p
}

fn Pt.bump(p) -> int {
    p.x += 1
    return p.x
}

fn mkwide() -> Wide {
    return Wide {
        a0: 0, a1: 1, a2: 2, a3: 3, a4: 4, a5: 5, a6: 6, a7: 7, a8: 8, a9: 9,
        b0: 0, b1: 1, b2: 2, b3: 3, b4: 4, b5: 5, b6: 6, b7: 7, b8: 8, b9: 9,
        c0: 0, c1: 1, c2: 2, c3: 3, c4: 4, c5: 5, c6: 6, c7: 7, c8: 8, c9: 9,
        d0: 0, d1: 1, d2: 2, d3: 3, d4: 4, d5: 5, d6: 6, d7: 7, d8: 8, d9: 9,
        e0: 0, e1: 1, e2: 2, e3: 3, e4: 4, e5: 5, e6: 6, e7: 7, e8: 8, e9: 9,
        s: "w",
    }
}

// Wider than the scalar ABI cut, so it crosses the call as one box.
fn bump_wide(w: Wide) -> int {
    w.e9 += 100
    w.s = "changed"
    return w.e9
}

@test(output = "1 1 9 0.5 1 2 1\n109 9 w 9 50\n1 2")
fn param_roots() {
    let v = mk()
    let r = bump_param(v)
    let s = FPoint { x: 0.5, y: 0.5 }
    let t = double_y(s)
    let m = mk()
    let mr = m.bump()
    print("{v.b.c} {v.x} {r} {s.y} {t.y} {mr} {m.x}")
    let w = mkwide()
    let wr = bump_wide(w)
    let w2 = mkwide()
    let w3 = w2
    w3.e9 = 50
    print("{wr} {w.e9} {w.s} {w2.e9} {w3.e9}")
    let l = mk()
    let f = (p: Pt) => {
        p.x += 1
        return p.x
    }
    let lr = f(l)
    print("{l.x} {lr}")
}

enum Slot { Full(Pt), Empty }

fn static_counter() -> int {
    static s = Pt { x: 0, b: In { c: 0, s: "" } }
    let snap = s
    s.x += 1
    return s.x * 10 + snap.x
}

@test(output = "1 1 1\n1 9\n1 9\n10 21")
fn pattern_and_static_bindings() {
    let xs = [mk(), mk()]
    for p in xs {
        p.x = 9
        p.b.c = 9
    }
    print("{xs[0].x} {xs[1].x} {xs[0].b.c}")
    let o: Pt? = mk()
    let r = 0
    if let p = o {
        p.x = 9
        r = p.x
    }
    print("{o?.x ?? 0} {r}")
    let e = Slot::Full(mk())
    let r2 = 0
    match e {
        Slot::Full(p) => {
            p.x = 9
            r2 = p.x
        },
        Slot::Empty => {},
    }
    match e {
        Slot::Full(p) => print("{p.x} {r2}"),
        Slot::Empty => {},
    }
    let a = static_counter()
    let b = static_counter()
    print("{a} {b}")
}

fn read_out_then_write(a: MaybeIn) -> int {
    let i = a.b
    if a.b != null {
        a.b.c = 5
    }
    return (i?.c ?? 0) * 10 + (a.b?.c ?? 0)
}

@test(output = "1 5 5 1\n1 5 1 1 5\n1 5 1\n1 5 15 1\n1 2 7 1 5")
fn nullable_roots_and_children() {
    let v: Pt? = mk()
    let w = v
    if v != null {
        v.x = 5
    }
    let a = MaybeIn { x: 1, b: In { c: 1, s: "a" } }
    let b = a
    if a.b != null {
        a.b.c = 5
    }
    print("{w?.x ?? 0} {v?.x ?? 0} {a.b?.c ?? 0} {b.b?.c ?? 0}")
    let i = In { c: 1, s: "a" }
    let built = MaybeIn { x: 1, b: i }
    if built.b != null {
        built.b.c = 5
    }
    let j = In { c: 1, s: "a" }
    let xs = [MaybeIn { x: 0, b: j }]
    let e = xs[0]
    if e.b != null {
        e.b.c = 5
    }
    print("{i.c} {built.b?.c ?? 0} {j.c} {xs[0].b?.c ?? 0} {e.b?.c ?? 0}")
    // The binding holds its leaves; the opaque child's box is still the source's.
    let o: MaybeIn? = MaybeIn { x: 1, b: In { c: 1, s: "a" } }
    let r = 0
    if let p = o {
        if p.b != null {
            p.b.c = 5
            r = p.b.c
        }
    }
    print("{o?.b?.c ?? 0} {r} {o?.x ?? 0}")
    let ro = MaybeIn { x: 1, b: In { c: 1, s: "a" } }
    let out = ro.b
    if ro.b != null {
        ro.b.c = 5
    }
    let pa = MaybeIn { x: 1, b: In { c: 1, s: "a" } }
    let pr = read_out_then_write(pa)
    print("{out?.c ?? 0} {ro.b?.c ?? 0} {pr} {pa.b?.c ?? 0}")
    let g = Gen { v: mk(), n: 1 }
    let h = g
    g.v.x = 7
    h.n = 2
    let k = In { c: 1, s: "a" }
    let gk = Gen { v: k, n: 0 }
    gk.v.c = 5
    print("{g.n} {h.n} {g.v.x} {k.c} {gk.v.c}")
}

value Wrap { p: Pt?, n: int }
value Deep { q: Pt?, n: int }

fn mkn(present: bool) -> Pt? {
    if present {
        return mk()
    }
    return null
}

fn mkd(present: bool) -> Deep? {
    if present {
        return Deep { q: mk(), n: 0 }
    }
    return null
}

fn safe_nav_through_param(w: Wrap, v: Pt?) -> int {
    w.p?.x = 5
    v?.x += 10
    return (w.p?.x ?? 0) * 100 + (v?.x ?? 0)
}

// `v?.f = x` writes only when every link is present.
@test(output = "1 5 1 5 3 1\n0 true\n7 1 3 1\n5 1 0\n511 1 1\n4 3 0")
fn safe_nav() {
    let w = mkn(true)
    let v = w
    v?.x = 5
    let wl: Pt? = mk()
    let vl = wl
    vl?.x = 5
    let wc = mkn(true)
    let vc = wc
    vc?.x += 2
    print("{w?.x ?? 0} {v?.x ?? 0} {wl?.x ?? 0} {vl?.x ?? 0} {vc?.x ?? 0} {wc?.x ?? 0}")
    let absent = mkn(false)
    absent?.x = 5
    absent?.x += 2
    print("{absent?.x ?? 0} {absent == null}")
    let wb = mkn(true)
    let vb = wb
    vb?.b = In { c: 7, s: "z" }
    let wo = Wrap { p: mk(), n: 0 }
    let vo = wo
    vo.p?.x += 2
    print("{(vb?.b)?.c ?? 0} {(wb?.b)?.c ?? 0} {vo.p?.x ?? 0} {wo.p?.x ?? 0}")
    let d = mkd(true)
    let e = d
    e?.q?.x = 5
    let f = mkd(false)
    f?.q?.x = 5
    print("{(e?.q)?.x ?? 0} {(d?.q)?.x ?? 0} {(f?.q)?.x ?? 0}")
    let pw = Wrap { p: mk(), n: 0 }
    let pv = mkn(true)
    let r = safe_nav_through_param(pw, pv)
    print("{r} {pw.p?.x ?? 0} {pv?.x ?? 0}")
    let m = MaybeSid { a: Sid { value: 3 }, k: 0 }
    let n = m
    n.a?.value += 1
    let z = MaybeSid { a: null, k: 0 }
    z.a?.value = 9
    print("{n.a?.value ?? 0} {m.a?.value ?? 0} {z.a?.value ?? 0}")
}

fn nobox_param(p: Place) -> int {
    p.space.value *= 2
    p.pos = FPoint { x: 0.0, y: 0.0 }
    return p.space.value + p.pos.x as int
}

@test(output = "3 9 1 4.5 3\n7 3\n6 3 1\n5 3")
fn nobox() {
    let p = mkp()
    let q = p
    q.space.value = 9
    q.pos.x += 3.5
    q.pos.y++
    print("{p.space.value} {q.space.value} {p.pos.x} {q.pos.x} {q.pos.y}")
    let p2 = mkp()
    let q2 = p2
    q2.space = Sid { value: 7 }
    print("{q2.space.value} {p2.space.value}")
    let p3 = mkp()
    let r = nobox_param(p3)
    print("{r} {p3.space.value} {p3.pos.x}")
    let m = MaybeSid { a: Sid { value: 3 }, k: 0 }
    let n = m
    if n.a != null {
        n.a.value = 5
    }
    print("{n.a?.value ?? 0} {m.a?.value ?? 0}")
}

// A closure shares the binding, so it sees a field write exactly as it sees
// a whole-value reassignment.
@test(output = "5 5\n1 3\n1 7 7\n1 5 5\n3 2")
fn captures() {
    let a = mk()
    let b = mk()
    let fa = () => a.x
    let fb = () => b.x
    a.x = 5
    b = Pt { ..b, x: 5 }
    print("{fa()} {fb()}")
    let v = mk()
    let f = () => v.x
    let c = v
    c.x = 3
    print("{f()} {c.x}")
    let v2 = mk()
    let a2 = v2
    let set = (n: int) => { a2.b.c = n }
    set(7)
    let get = () => a2.b.c
    print("{v2.b.c} {a2.b.c} {get()}")
    let v3 = mk()
    let a3 = v3
    let fs: [fn() -> int] = []
    fs.push(() => a3.x)
    a3.x = 5
    print("{v3.x} {a3.x} {fs[0]()}")
    let p = FPoint { x: 1.0, y: 2.0 }
    let q = Sid { value: 0 }
    let fp = () => p.x + q.value as float
    p.x = 3.0
    print("{fp()} {p.y}")
}

co fn co_param(p: Pt) -> Coroutine<int, (), ()> {
    p.x += 10
    yield p.x
    p.b.c += 1
    yield p.b.c
}

co fn co_local() -> Coroutine<int, (), ()> {
    let a = mk()
    let b = a
    let f = () => a.b.c
    a.x = 4
    yield a.x
    a.b.c = 6
    yield b.x * 10 + f()
}

co fn co_nobox() -> Coroutine<int, (), ()> {
    let p = mkp()
    p.space.value = 11
    yield p.space.value
    p.space.value += 1
    yield p.space.value
}

@test(output = "11 2 1\n4 16\n11 12")
fn coroutines() {
    let v = mk()
    let c = co_param(v)
    let a = c.resume() ?? -1
    let b = c.resume() ?? -1
    print("{a} {b} {v.x}")
    let l = co_local()
    let x = l.resume() ?? -1
    let y = l.resume() ?? -1
    print("{x} {y}")
    let n = co_nobox()
    let n1 = n.resume() ?? -1
    let n2 = n.resume() ?? -1
    print("{n1} {n2}")
}

// Builtin vector values; these also run under `rock test --backend glsl`.
fn shift3(v: Vec3) -> float {
    v.z *= 2.0
    v.x++
    return v.x + v.z
}

@test(returns = 12.0)
fn vec3_param_root() -> float {
    let v = Vec3 { x: 1.0, y: 0.0, z: 3.0 }
    let r = shift3(v)
    return r + v.x + v.z
}

@test(returns = 407.0)
fn vec2_local_writes() -> float {
    let v = Vec2 { x: 1.0, y: 2.0 }
    let w = v
    w.y += 0.5
    let a = Vec2 { x: 2.0, y: 0.0 }
    let old = a.x++
    let b = Vec2 { x: 2.0, y: 0.0 }
    let new = ++b.x
    return (v.x + w.y) * 100.0 + (old + a.x) * 10.0 + new + b.x + b.y + 1.0
}
