// A flat inner enum shares its tag and string payload slots with its parent.
// The nested arm must read and bind the payload, not just inspect the tag.
// Wider positions, named fields and suspension live in patterns/nested_flat_enum_pattern.rock.

enum SentInner {
    Named(string),
    Empty,
}

enum SentOuter {
    Msg(SentInner),
    Other,
}

@test
fn nested_flat_enum_binds_string_payload() {
    let v = SentOuter::Msg(SentInner::Named("Harm"))
    let got = ""
    match v {
        SentOuter::Msg(SentInner::Named(spell)) => { got = spell }
        SentOuter::Msg(_) => { got = "fallback" }
        SentOuter::Other => { got = "other" }
    }
    assert_eq(got, "Harm", "a nested flat-enum arm binds its payload from the parent's slots")
}
