// `embed` fields: legal projections, reflection over the logical form,
// nullable embeds nested inside embedded children, and embedded children
// holding non-ffi-clean enum fields. The rejection matrix is
// tests/errors/structs.rock.err.

struct Pt { x: int, y: int }
struct Holder { embed p: Pt, tag: int }

// The scalar-ABI round trip: leaves in, leaves out, no box.
fn advance(p: Pt, dt: int) -> Pt {
    return Pt { x: p.x + dt, y: p.y + dt }
}

@test(output = "1 2 3\n9 2\n12 2\n7 8\n17 18\nsame different")
fn test_embed_projections() {
    let h = Holder { p: Pt { x: 1, y: 2 }, tag: 3 }
    print("{h.p.x} {h.p.y} {h.tag}")
    h.p.x = 9
    print("{h.p.x} {h.p.y}")
    h.p.x += 3
    print("{h.p.x} {h.p.y}")
    h.p = Pt { x: 7, y: 8 }
    print("{h.p.x} {h.p.y}")
    h.p = advance(h.p, 10)
    print("{h.p.x} {h.p.y}")
    let a = Holder { p: Pt { x: 1, y: 2 }, tag: 3 }
    let b = Holder { p: Pt { x: 1, y: 2 }, tag: 3 }
    let c = Holder { p: Pt { x: 9, y: 2 }, tag: 3 }
    let first = if a.p == b.p { "same" } else { "differs" }
    let second = if a.p == c.p { "same" } else { "different" }
    print("{first} {second}")
}

// Nullable embed: presence is a leaf, so presence operations are projections.
struct Slot { embed p: Pt?, tag: int }

@test(output = "absent\npresent 5\n5 0\ncleared")
fn test_nullable_embed_presence() {
    let absent = Slot { p: null, tag: 1 }
    if absent.p == null { print("absent") } else { print("present") }
    let s = Slot { p: Pt { x: 5, y: 6 }, tag: 1 }
    if s.p != null { print("present {s.p.x}") } else { print("absent") }
    print("{s.p?.x ?? 0} {absent.p?.x ?? 0}")
    s.p = null
    if s.p == null { print("cleared") } else { print("still present") }
}

fn clear_tag<T>(o: T, f: WriteFieldRef<T, int>) {
    field_set(o, f, 0)
}

fn accept_embed_write_selector(f: WriteFieldRef<Holder, Pt>) -> int { return 1 }

struct PlainHolder { p: Pt, tag: int }

fn accept_plain_read_selector(f: ReadFieldRef<PlainHolder, Pt>) -> int { return 1 }
fn accept_plain_full_selector(f: FieldRef<PlainHolder, Pt>) -> int { return 2 }

// A write-only selector is admissible for an embedded field; readable ones
// stay legal for a plain child field.
@test(output = "0 1 1 2")
fn test_field_selectors_on_embed_and_plain_fields() {
    let h = Holder { p: Pt { x: 1, y: 2 }, tag: 3 }
    clear_tag(h, .tag)
    print("{h.tag} {accept_embed_write_selector(.p)} {accept_plain_read_selector(.p)} {accept_plain_full_selector(.p)}")
}

// On a value-struct parent `embed` only asserts the contiguous layout.
value V2 { x: float, y: float }
struct ValueHolder { embed v: V2, tag: int }
value ValueParent { embed v: V2, w: float }

// `embed` is a contextual keyword: it stays legal as a field name.
struct Legacy { embed: int, other: int }

@test(output = "1 2\n1 3\n1 2")
fn test_embed_value_fields_and_contextual_keyword() {
    let h = ValueHolder { v: V2 { x: 1.0, y: 2.0 }, tag: 3 }
    print("{h.v.x:.0f} {h.v.y:.0f}")
    let o = ValueParent { v: V2 { x: 1.0, y: 2.0 }, w: 3.0 }
    print("{o.v.x:.0f} {o.w:.0f}")
    let l = Legacy { embed: 1, other: 2 }
    print("{l.embed} {l.other}")
}

struct Inner { c: int }
struct RMid { embed b: Inner, m: int }
struct Outer { embed a: RMid, o: int }
struct RSlot { embed q: Pt?, tag: int }

// Reflection follows the logical form: the child is rebuilt from its leaves,
// physical keys and presence slots never surface. `PlainHolder` is the control.
@test(output = "Holder {{ p = Pt {{ x = 1, y = 2 }}, tag = 3 }}\nHolder {{ p = Pt {{ x = 4, y = 5 }}, tag = 6 }}\nHolder {{ p = Pt {{ x = 9, y = 2 }}, tag = 3 }}\nOuter {{ a = RMid {{ b = Inner {{ c = 1 }}, m = 2 }}, o = 3 }}\nRSlot {{ q = Pt {{ x = 5, y = 6 }}, tag = 1 }}\nRSlot {{ q = nil, tag = 1 }}\nPlainHolder {{ p = Pt {{ x = 1, y = 2 }}, tag = 3 }}")
fn test_inspect_renders_the_logical_child() {
    let h = Holder { p: Pt { x: 1, y: 2 }, tag: 3 }
    print("{inspect(h)}")
    let i = Holder { p: Pt { x: 4, y: 5 }, tag: 6 }
    print("{i}")
    h.p.x = 9
    print("{inspect(h)}")
    let t = Outer { a: RMid { b: Inner { c: 1 }, m: 2 }, o: 3 }
    print("{inspect(t)}")
    let present = RSlot { q: Pt { x: 5, y: 6 }, tag: 1 }
    print("{inspect(present)}")
    let absent = RSlot { q: null, tag: 1 }
    print("{inspect(absent)}")
    let plain = PlainHolder { p: Pt { x: 1, y: 2 }, tag: 3 }
    print("{inspect(plain)}")
}

enum Sig { A, B(string) }
struct FlatHolder { sig: Sig, other: int }

fn show_flat(h: FlatHolder) { print("{inspect(h)}") }

enum InspectSignal { Idle, Text(string), Pair(int, bool), Named { count: int, text: string } }
struct InspectHolder { sig: InspectSignal?, tag: int }
struct InspectOuter { embed child: InspectHolder, tag: int }

fn inspect_opaque(value: any) -> string { return inspect(value) }

nobox value InspectPoint { x: int, y: int }
enum InspectEvent { Empty, At(InspectPoint), Text(string) }
struct InspectEventHolder { event: InspectEvent }

@test(output = "FlatHolder {{ other = 1, sig = Sig::B {{ [1] = \"x\" }} }}\nInspectHolder {{ sig = InspectSignal::Idle, tag = 1 }}\nInspectHolder {{ sig = InspectSignal::Text {{ [1] = \"hello\" }}, tag = 1 }}\nInspectHolder {{ sig = InspectSignal::Pair {{ [1] = 7, [2] = false }}, tag = 1 }}\nInspectHolder {{ sig = InspectSignal::Named {{ count = 9, text = \"named\" }}, tag = 1 }}\nInspectHolder {{ sig = nil, tag = 1 }}\nInspectOuter {{ child = InspectHolder {{ sig = InspectSignal::Text {{ [1] = \"nested\" }}, tag = 2 }}, tag = 3 }}\nInspectEventHolder {{ event = InspectEvent::At {{ x = 4, y = 5 }} }}")
fn test_inspect_flat_enum_fields() {
    show_flat(FlatHolder { sig: Sig::B("x"), other: 1 })
    let h = InspectHolder { sig: InspectSignal::Idle, tag: 1 }
    print("{inspect_opaque(h)}")
    h.sig = InspectSignal::Text("hello")
    print("{inspect_opaque(h)}")
    h.sig = InspectSignal::Pair(7, false)
    print("{inspect_opaque(h)}")
    h.sig = InspectSignal::Named { count: 9, text: "named" }
    print("{inspect_opaque(h)}")
    h.sig = null
    print("{inspect_opaque(h)}")
    let outer = InspectOuter {
        child: InspectHolder { sig: InspectSignal::Text("nested"), tag: 2 }, tag: 3,
    }
    print("{inspect_opaque(outer)}")
    let e = InspectEventHolder { event: InspectEvent::At(InspectPoint { x: 4, y: 5 }) }
    print("{inspect_opaque(e)}")
}

// A value spliced into its holder keeps nested values and enums as leaves of
// the holder; reflection rebuilds each one from those leaves.
value InspectV2 { x: int, y: int }
enum InspectMode { Idle, Walk(int, int), Run { speed: int } }
value InspectWrap { inner: InspectV2, mode: InspectMode, sig: InspectSignal, k: int }
value InspectHost { name: string, embed w: InspectWrap }

@test(output = "InspectHost {{ name = \"a\", w = InspectWrap {{\n  inner = InspectV2 {{ x = 1, y = 2 }},\n  k = 3,\n  mode = InspectMode::Walk {{ [1] = 4, [2] = 5 }},\n  sig = InspectSignal::Named {{ count = 6, text = \"t\" }}\n}} }}\nInspectHost {{ name = \"a\", w = InspectWrap {{\n  inner = InspectV2 {{ x = 7, y = 2 }},\n  k = 3,\n  mode = InspectMode::Run {{ speed = 8 }},\n  sig = InspectSignal::Text {{ [1] = \"u\" }}\n}} }}")
fn test_inspect_rebuilds_values_nested_in_an_embedded_value() {
    let h = InspectHost {
        name: "a",
        w: InspectWrap {
            inner: InspectV2 { x: 1, y: 2 },
            mode: InspectMode::Walk(4, 5),
            sig: InspectSignal::Named { count: 6, text: "t" },
            k: 3,
        },
    }
    print("{inspect_opaque(h)}")
    h.w.inner.x = 7
    h.w.mode = InspectMode::Run { speed: 8 }
    h.w.sig = InspectSignal::Text("u")
    print("{inspect_opaque(h)}")
}

// A nullable embed nested inside an embedded child owns a presence slot at its
// composed path (`child.inner`), written by literals and whole-field stores alike.
@lua_named struct Leaf { v: int }
@lua_named struct Mid { embed inner: Leaf?, m: int }
@lua_named struct Top { embed child: Mid?, t: int }

global T: Top = Top { child: null, t: 0 }

fn fill_present() { T.child = Mid { inner: Leaf { v: 7 }, m: 1 } }
fn fill_absent() { T.child = Mid { inner: null, m: 2 } }
fn clear_child() { T.child = null }

fn probe_inner() -> int { return T.child?.inner?.v ?? -1 }
fn probe_m() -> int { return T.child?.m ?? -1 }
fn inner_is_null() -> bool { return T.child?.inner == null }

// The whole child crossing a call boundary reads the rebuilt box.
fn inner_is_null_of(m: Mid?) -> bool { return m?.inner == null }
fn inner_v_of(m: Mid?) -> int { return m?.inner?.v ?? -1 }

@test
fn nested_nullable_embed_tracks_inner_presence() {
    fill_absent()
    assert_eq(probe_m(), 2)
    assert_eq(probe_inner(), -1)
    assert_eq(inner_is_null(), true)
    assert_eq(T.child == null, false)
    assert_eq(inner_is_null_of(T.child), true)
    assert_eq(inner_v_of(T.child), -1)
    fill_present()
    assert_eq(probe_inner(), 7)
    assert_eq(probe_m(), 1)
    assert_eq(inner_is_null_of(T.child), false)
    assert_eq(inner_v_of(T.child), 7)
    clear_child()
    assert_eq(T.child == null, true)
    assert_eq(probe_inner(), -1)
    assert_eq(probe_m(), -1)
}

inline(lua) fn inner_presence_absent(o: Top) -> bool = """
    return o["child.inner"] == nil
"""

inline(lua) fn slot_keys(m: Mid) -> string = """
    local ks = {}
    for k, _ in pairs(m) do if k ~= "__ty" then ks[#ks + 1] = tostring(k) end end
    table.sort(ks)
    return table.concat(ks, ",")
"""

fn slot_keys_of(m: Mid?) -> string {
    if m == null { return "null" }
    return slot_keys(m)
}

// A rebuilt `Mid` keys its embedded inner exactly as `Mid { .. }` does.
@test(backends = "lua")
fn nested_nullable_embed_uses_the_canonical_flat_slots() {
    fill_present()
    assert_eq(inner_presence_absent(T), false)
    assert_eq(slot_keys_of(T.child), "inner,inner.v,m")
    fill_absent()
    assert_eq(inner_presence_absent(T), true)
}

// An embedded child's non-ffi-clean enum field stays flat under the composed
// key (`f.active.#`, `f.active.0`) across ctor, store and read. The boxed-child
// and top-level placements are controls.
enum Waitish {
    Frame,
    Secs(float),
    Until(() -> bool, int),
}

@lua_named struct Framed {
    handle: int,
    active: Waitish,
    last: int = -1,
}

@lua_named struct EmbedOwner { embed f: Framed, tag: int }
struct BoxedOwner { f: Framed, tag: int }
struct DirectOwner { active: Waitish }

global EMB: EmbedOwner = EmbedOwner { f: Framed { handle: 1, active: Waitish::Frame }, tag: 0 }
global BOX: BoxedOwner = BoxedOwner { f: Framed { handle: 1, active: Waitish::Frame }, tag: 0 }
global DIR: DirectOwner = DirectOwner { active: Waitish::Frame }

fn arm_embedded() { EMB.f.active = Waitish::Secs(1.5) }
fn arm_boxed() { BOX.f.active = Waitish::Secs(1.5) }
fn arm_direct() { DIR.active = Waitish::Secs(1.5) }

fn arm_embedded_closure(n: int) { EMB.f.active = Waitish::Until(() => n > 3, n) }

fn read_embedded() -> int {
    return match EMB.f.active {
        Waitish::Secs(s) => int(s * 10.0),
        Waitish::Until(p, k) => if p() { k } else { -k },
        Waitish::Frame => -1,
    }
}

fn read_boxed() -> int {
    return match BOX.f.active {
        Waitish::Secs(s) => int(s * 10.0),
        Waitish::Until(p, k) => if p() { k } else { -k },
        Waitish::Frame => -1,
    }
}

fn read_direct() -> int {
    return match DIR.active {
        Waitish::Secs(s) => int(s * 10.0),
        Waitish::Until(p, k) => if p() { k } else { -k },
        Waitish::Frame => -1,
    }
}

@test
fn embedded_child_flat_enum_roundtrips() {
    arm_embedded()
    assert_eq(read_embedded(), 15)
    arm_embedded_closure(7)
    assert_eq(read_embedded(), 7)
    arm_embedded_closure(2)
    assert_eq(read_embedded(), -2)
    arm_boxed()
    assert_eq(read_boxed(), 15)
    arm_direct()
    assert_eq(read_direct(), 15)
    EMB.f.handle = 21
    assert_eq(EMB.f.handle, 21)
}

inline(lua) fn raw_subslot_tag(o: EmbedOwner) -> string = """
    return tostring(o["f.active.#"])
"""

// Nothing may sit under the composed key itself.
inline(lua) fn raw_composed_key_absent(o: EmbedOwner) -> bool = """
    return o["f.active"] == nil
"""

@test(backends = "lua")
fn embedded_child_flat_enum_uses_one_encoding() {
    arm_embedded()
    assert_eq(raw_subslot_tag(EMB), "Secs")
    assert_eq(raw_composed_key_absent(EMB), true)
    let fresh = EmbedOwner { f: Framed { handle: 2, active: Waitish::Secs(0.9) }, tag: 5 }
    assert_eq(raw_subslot_tag(fresh), "Secs")
    assert_eq(raw_composed_key_absent(fresh), true)
}

// A discarded value still runs its effects, and an optional aggregate return
// never projects leaves out of a placeholder nil.

@nomangle inline(lua) fn raises(f: fn()) -> bool = """
    local ok, err = pcall(f)
    return not ok
"""

fn probe(n: int) -> int { let unused = n as uint; return 7 }

// The JS backend does not raise on a negative uint conversion.
@test(output = "true 7", backends = "lua")
fn unused_throwing_conversion_preserves_runtime_error() {
    print("{raises(() => { let _ = probe(-1) })} {probe(1)}")
}

fn normalize_optional_value(x: float, y: float) -> Vec2? {
    let delta = v(x, y)
    if delta.length() <= 0.001 { return null }
    return delta.normalize()
}
fn normalize_tail_value(x: float, y: float) -> Vec2? { v(x, y).normalize() }
fn normalize_optional_probe(x: float, y: float) -> float {
    let p = normalize_optional_value(x, y) ?? return -1
    return p.x + p.y
}
fn normalize_tail_probe(x: float, y: float) -> float {
    let p = normalize_tail_value(x, y) ?? return -1
    p.x + p.y
}

@test(output = "1.4 -1 1.4 0")
fn aggregate_return_materialization_does_not_project_placeholder_nil() {
    print("{normalize_optional_probe(3, 4)} {normalize_optional_probe(0, 0)} {normalize_tail_probe(3, 4)} {normalize_tail_probe(0, 0)}")
}
