// Every write into an `f32` field rounds to single precision, including the
// writes that `++`, `--`, a safe-nav assignment and a safe-nav compound
// assignment make. The float32 nearest 0.1, plus or minus one, is not a
// float32, so each write must store what a plain assignment of the result
// stores (`narrow`).

struct NarrowBox { f: f32 }
value NarrowValue { f: f32 }
struct NarrowHolder { inner: NarrowBox? }
nobox value NarrowSpot { f: f32, n: int }

global NARROW_SPOT: NarrowSpot = NarrowSpot { f: 0.1, n: 0 }

fn narrow(x: float) -> float {
    let b = NarrowBox { f: x }
    return b.f
}

@test
fn f32_increments_round_on_every_place() {
    let expect = narrow(1.1)
    assert(expect != 1.1, "a plain write rounds")
    let b = NarrowBox { f: 0.1 }
    b.f++
    assert_eq(b.f, expect, "struct field")
    let v = NarrowValue { f: 0.1 }
    let pre = ++v.f
    assert_eq(pre, expect, "prefix result is the stored value")
    assert_eq(v.f, expect, "value field")
    let xs: [NarrowBox] = [NarrowBox { f: 0.1 }]
    xs[0].f++
    assert_eq(xs[0].f, expect, "element field")
    let vs: [NarrowValue] = [NarrowValue { f: 0.1 }]
    vs[0].f++
    assert_eq(vs[0].f, expect, "flat element field")
    NARROW_SPOT.f++
    assert_eq(NARROW_SPOT.f, expect, "nobox global leaf")
    let d = NarrowBox { f: 0.1 }
    d.f--
    assert_eq(d.f, narrow(-0.9), "decrement")
}

@test
fn f32_safe_nav_writes_round() {
    let expect = narrow(1.1)
    let m: NarrowBox? = NarrowBox { f: 0.0 }
    m?.f = 1.1
    assert_eq(m.unwrap().f, expect, "safe-nav assignment")
    let c: NarrowBox? = NarrowBox { f: 0.1 }
    c?.f += 1.0
    assert_eq(c.unwrap().f, expect, "safe-nav compound assignment")
    let h = NarrowHolder { inner: NarrowBox { f: 0.1 } }
    h.inner?.f += 1.0
    assert_eq(h.inner.unwrap().f, expect, "safe-nav compound through a field")
    let none: NarrowBox? = null
    none?.f += 1.0
    assert(none == null, "a null receiver is left alone")
}
