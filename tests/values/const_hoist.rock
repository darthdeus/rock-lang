// An all-constant value ctor is hoisted to one shared module const and identical
// literals dedupe; a hoisted const reaching a mutable place must be fresh per
// construction, or a leaf write corrupts every other holder.

value Pt { x: int, y: int }
struct Owner { p: Pt }
value Other { x: int, y: int }
struct OtherOwner { o: Other }

fn mk() -> Owner { return Owner { p: Pt { x: 1, y: 1 } } }
fn mk_other() -> OtherOwner { return OtherOwner { o: Other { x: 1, y: 1 } } }

global G: Owner = mk()

@test(output = "5 1 1 9 1")
fn const_field_writes_do_not_alias_other_holders() {
    let a = mk()
    let b = mk()
    a.p.x = 5
    let local = mk()
    local.p.x = 7
    let c = mk()
    let d = mk_other()
    c.p.x = 9
    print("{a.p.x} {b.p.x} {G.p.x} {c.p.x} {d.o.x}")
}

value RO { a: int, b: int }

fn ro_sum() -> int {
    let r = RO { a: 2, b: 3 }
    return r.a + r.b
}

value V2 { x: int, y: int }

@nomangle
fn sum_v2(v: V2) -> int { v.x + v.y }

// Constant literals at an unmangled cdata-ABI slot hoist; a dynamic one packs per call.
@test(output = "5 5 21 42 5")
fn read_only_and_nomangle_argument_constants() {
    let n = 2
    print("{ro_sum()} {ro_sum()} {sum_v2(V2 { x: 10, y: 11 })} {sum_v2(V2 { x: 20, y: 22 })} {sum_v2(V2 { x: n, y: 3 })}")
}
