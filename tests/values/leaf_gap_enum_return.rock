// Assigning a native enum return over a local replaces every leaf the
// previous variant initialized: the tag and payload of a plain enum, and the
// presence plus payload of a nullable one. Nested nobox leaves read beside the
// assignment keep their own values.

nobox value ItemLeaf { value: int }
nobox value ItemSlot { leaf: ItemLeaf }
struct ItemInner { slot: ItemSlot }
struct ItemOuter { inner: ItemInner }
struct Item { outer: ItemOuter, flagged: bool }
enum ItemRef { None, Plain(Entity<Item>), Flagged(Entity<Item>) }

fn item_ref(entity: Entity<Item>, item: Item) -> ItemRef {
    return if item.flagged { ItemRef::Flagged(entity) } else { ItemRef::Plain(entity) }
}

// A native enum return must replace the leaves initialized by a variant.
@test fn enum_return_assignment_projects_variant_and_leaf() {
    let rows: Arena<Item> = arena_new()
    let item = rows.insert(Item {
        flagged: true,
        outer: ItemOuter {
            inner: ItemInner { slot: ItemSlot { leaf: ItemLeaf { value: 17 } } },
        },
    })
    let target_leaf: ItemLeaf? = null
    let kind = ItemRef::Plain(item)
    if let target = item.get() {
        kind = item_ref(item, target)
        target_leaf = target.outer.inner.slot.leaf
    }
    match kind {
        ItemRef::Flagged(entity) => assert(entity == item),
        _ => assert(false),
    }
    if let leaf = target_leaf {
        assert_eq(leaf.value, 17)
    } else { assert(false) }
    let _ = arena_destroy(rows)
    let _ = __arena_drain_retired()
}

nobox value ThingLeaf { value: int }
nobox value ThingSlot { leaf: ThingLeaf }
struct ThingInner { slot: ThingSlot }
struct ThingOuter { inner: ThingInner }
struct Thing { outer: ThingOuter, flagged: bool }
enum ThingRef { None, Plain(Entity<Thing>), Flagged(Entity<Thing>) }

fn thing_ref(entity: Entity<Thing>, thing: Thing) -> ThingRef {
    return if thing.flagged { ThingRef::Flagged(entity) } else { ThingRef::Plain(entity) }
}

// A native enum return must replace the leaves initialized by a variant.
@test fn enum_return_copy_assignment_projects_variant_and_leaf() {
    let rows: Arena<Thing> = arena_new()
    let thing = rows.insert(Thing {
        flagged: true,
        outer: ThingOuter {
            inner: ThingInner { slot: ThingSlot { leaf: ThingLeaf { value: 29 } } },
        },
    })
    let target_leaf: ThingLeaf? = null
    let kind = ThingRef::Plain(thing)
    if let target = thing.get() {
        kind = thing_ref(thing, target)
        target_leaf = target.outer.inner.slot.leaf
    }
    match kind {
        ThingRef::Flagged(entity) => assert(entity == thing),
        _ => assert(false),
    }
    if let leaf = target_leaf {
        assert_eq(leaf.value, 29)
    } else { assert(false) }
    let _ = arena_destroy(rows)
    let _ = __arena_drain_retired()
}

struct RecordLeft { id: int }
struct RecordRight { id: int }
enum RecordKind { Left(RecordLeft), Right(RecordRight) }
struct Record { right: bool }

fn Record.kind(record) -> RecordKind? {
    if record.right { return RecordKind::Right(RecordRight { id: 43 }) }
    return null
}

// A nullable native return replaces both presence and payload leaves.
@test fn nullable_enum_return_assignment_projects_presence_and_payload() {
    let records: Arena<Record> = arena_new()
    let record = records.insert(Record { right: true })
    let kind: RecordKind? = null
    if let value = record.get() { kind = value.kind() }
    if let value = kind {
        match value {
            RecordKind::Right(right) => assert_eq(right.id, 43),
            RecordKind::Left(_) => assert(false),
        }
    } else { assert(false) }
    if let value = record.get() { value.right = false }
    kind = record.get().unwrap().kind()
    assert(kind == null)
    let _ = arena_destroy(records)
    let _ = __arena_drain_retired()
}
