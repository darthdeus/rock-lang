// A loop copying a value element out reads only the fields it uses; the
// unused reads before a used one are dropped without changing results.

value Point { x: float, y: float }
value Layer { volume: float, speed: float, at: Point, name: string }
struct Step { layers: Vec<Layer> }

global calls: int = 0
fn count() -> int { calls += 1; return 1 }

fn step() -> Step {
    return Step { layers: [
        Layer { volume: 1.0, speed: 2.0, at: Point { x: 3.0, y: 4.0 }, name: "ab" },
        Layer { volume: 5.0, speed: 6.0, at: Point { x: 7.0, y: 8.0 }, name: "cde" },
    ] }
}

@test(output = "5")
fn one_field_of_each_copied_element() {
    let n = 0
    for layer in step().layers { n += layer.name.len() }
    print(n)
}

@test(output = "8 15")
fn nested_value_field_after_unused_fields() {
    let n = 0.0
    let m = 0
    for layer in step().layers {
        n += layer.at.y - layer.at.x + layer.volume
        m += layer.name.len() * 3
    }
    print("{n} {m}")
}

@test(output = "7 2")
fn unused_fields_before_a_call() {
    calls = 0
    let n = 0
    for layer in step().layers {
        let copy = layer
        n += count()
        n += copy.name.len()
    }
    print("{n} {calls}")
}
