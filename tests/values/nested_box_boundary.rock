// A boxed value crossing a call or storage boundary (opaque Lua results,
// relays, enum payloads, conditional locals, `ref` borrows) is a snapshot:
// later writes to its owner never reach it, and selecting it keeps evaluation
// order. The allocation side of the same boundaries is pinned in the skull
// Rust tests.

value Child {
    f0: int, f1: int, f2: int, f3: int, f4: int, f5: int, f6: int, f7: int, f8: int, f9: int,
    f10: int, f11: int, f12: int, f13: int, f14: int, f15: int, f16: int, f17: int, f18: int, f19: int,
    f20: int, f21: int, f22: int, f23: int, f24: int, f25: int, f26: int, f27: int, f28: int, f29: int,
    f30: int, f31: int, f32: int, f33: int, f34: int, f35: int, f36: int, f37: int, f38: int, f39: int,
    f40: int, f41: int, f42: int, f43: int, f44: int, f45: int, f46: int, f47: int, f48: int, f49: int,
}

value Wide {
    f0: int, f1: int, f2: int, f3: int, f4: int, f5: int, f6: int, f7: int, f8: int, f9: int,
    f10: int, f11: int, f12: int, f13: int, f14: int, f15: int, f16: int, f17: int, f18: int, f19: int,
    f20: int, f21: int, f22: int, f23: int, f24: int, f25: int, f26: int, f27: int, f28: int, f29: int,
    f30: int, f31: int, f32: int, f33: int, f34: int, f35: int, f36: int, f37: int, f38: int, f39: int,
    f40: int, f41: int, f42: int, f43: int, f44: int, f45: int, f46: int, f47: int, f48: int, f49: int,
    child: Child?,
}

struct WideOwner { row: Wide }

inline(lua) fn read_row(owner: WideOwner) -> Wide = "return owner.row"
inline(lua) fn read_optional(owner: WideOwner) -> Wide? = "return owner.row"
fn forward(owner: WideOwner) -> Wide { return read_row(owner) }
fn forward_optional(owner: WideOwner) -> Wide? { return read_optional(owner) }

fn change_wide(owner: WideOwner) -> int {
    owner.row.f0 = 3
    if owner.row.child != null { owner.row.child.f0 = 3 }
    return 0
}

fn observe(row: Wide, ignored: int) {
    assert_eq(row.f0, 1)
    assert_eq(row.child?.f0, 1)
}

@test(output = "ok", backends = "lua")
fn opaque_forwarded_results_snapshot_before_their_owner_changes() {
    let owner = WideOwner { row: Wide {
        f0: 1, f1: 1, f2: 1, f3: 1, f4: 1, f5: 1, f6: 1, f7: 1, f8: 1, f9: 1,
        f10: 1, f11: 1, f12: 1, f13: 1, f14: 1, f15: 1, f16: 1, f17: 1, f18: 1, f19: 1,
        f20: 1, f21: 1, f22: 1, f23: 1, f24: 1, f25: 1, f26: 1, f27: 1, f28: 1, f29: 1,
        f30: 1, f31: 1, f32: 1, f33: 1, f34: 1, f35: 1, f36: 1, f37: 1, f38: 1, f39: 1,
        f40: 1, f41: 1, f42: 1, f43: 1, f44: 1, f45: 1, f46: 1, f47: 1, f48: 1, f49: 1,
        child: Child {
            f0: 1, f1: 1, f2: 1, f3: 1, f4: 1, f5: 1, f6: 1, f7: 1, f8: 1, f9: 1,
            f10: 1, f11: 1, f12: 1, f13: 1, f14: 1, f15: 1, f16: 1, f17: 1, f18: 1, f19: 1,
            f20: 1, f21: 1, f22: 1, f23: 1, f24: 1, f25: 1, f26: 1, f27: 1, f28: 1, f29: 1,
            f30: 1, f31: 1, f32: 1, f33: 1, f34: 1, f35: 1, f36: 1, f37: 1, f38: 1, f39: 1,
            f40: 1, f41: 1, f42: 1, f43: 1, f44: 1, f45: 1, f46: 1, f47: 1, f48: 1, f49: 1,
        },
    } }
    let direct = read_row(owner)
    let forwarded = forward(owner)
    let optional = read_optional(owner)
    let forwarded_optional = forward_optional(owner)
    let callback: () -> Wide? = () => read_optional(owner)
    let indirect = callback()
    let selected = if true { read_row(owner) } else { read_row(owner) }
    let selected_optional = if true { read_optional(owner) } else { read_optional(owner) }
    let selected_match = match 0 { 0 => read_row(owner), _ => read_row(owner) }
    let selected_iflet = if let row = optional { read_row(owner) } else { read_row(owner) }
    let coalesced = read_optional(owner) ?? owner.row
    if let narrowed = callback() {
        owner.row.f0 = 2
        if owner.row.child != null { owner.row.child.f0 = 2 }
        assert_eq(narrowed.f0, 1)
        assert_eq(narrowed.child?.f0, 1)
        owner.row.f0 = 1
        if owner.row.child != null { owner.row.child.f0 = 1 }
    } else { assert(false) }
    owner.row.f0 = 99
    if owner.row.child != null { owner.row.child.f0 = 99 }
    assert_eq(direct.f0, 1)
    assert_eq(direct.child?.f0, 1)
    assert_eq(forwarded.f0, 1)
    assert_eq(forwarded.child?.f0, 1)
    assert_eq(optional?.f0, 1)
    assert_eq(optional?.child?.f0, 1)
    assert_eq(forwarded_optional?.f0, 1)
    assert_eq(forwarded_optional?.child?.f0, 1)
    assert_eq(indirect?.f0, 1)
    assert_eq(indirect?.child?.f0, 1)
    assert_eq(selected.f0, 1)
    assert_eq(selected.child?.f0, 1)
    assert_eq(selected_optional?.f0, 1)
    assert_eq(selected_optional?.child?.f0, 1)
    assert_eq(selected_match.child?.f0, 1, "match snapshot")
    assert_eq(selected_iflet.child?.f0, 1, "if-let snapshot")
    assert_eq(coalesced.f0, 1)
    assert_eq(coalesced.child?.f0, 1)
    owner.row.f0 = 1
    if owner.row.child != null { owner.row.child.f0 = 1 }
    observe(row: read_row(owner), ignored: change_wide(owner))
    owner.row.f0 = 1
    if owner.row.child != null { owner.row.child.f0 = 1 }
    fn observe_nested(row: Wide, ignored: int) -> int {
        return row.f0 + (row.child?.f0 ?? -1)
    }
    assert_eq(observe_nested(row: read_row(owner), ignored: change_wide(owner)), 2)
    print("ok")
}

value ChildRow { child: Child?, items: [int] }
struct RowOwner { row: ChildRow }

@test(output = "1")
fn an_immutable_local_snapshots_a_mutable_owners_child() {
    let owner = RowOwner { row: ChildRow { child: Child {
        f0: 1, f1: 1, f2: 1, f3: 1, f4: 1, f5: 1, f6: 1, f7: 1, f8: 1, f9: 1,
        f10: 1, f11: 1, f12: 1, f13: 1, f14: 1, f15: 1, f16: 1, f17: 1, f18: 1, f19: 1,
        f20: 1, f21: 1, f22: 1, f23: 1, f24: 1, f25: 1, f26: 1, f27: 1, f28: 1, f29: 1,
        f30: 1, f31: 1, f32: 1, f33: 1, f34: 1, f35: 1, f36: 1, f37: 1, f38: 1, f39: 1,
        f40: 1, f41: 1, f42: 1, f43: 1, f44: 1, f45: 1, f46: 1, f47: 1, f48: 1, f49: 1,
    }, items: [] } }
    let saved = owner.row
    if owner.row.child != null { owner.row.child.f0 = 99 }
    print(saved.child?.f0 ?? -1)
}

nobox value Hit { f0: float, f1: float, f2: float, f3: float, f4: float, f5: float, f6: float }
value Landing { a: Hit, b: Hit, c: Hit, d: Hit, e: Hit, f: Hit, g: Hit, environment: [float]? = null }
value Receipt { landing: Landing? = null, sequence: int }
enum Event { Cast(Receipt), Other }

@nomangle fn make(seed: float) -> Receipt {
    let hit = Hit { f0: seed, f1: 1.0, f2: 2.0, f3: 3.0, f4: 4.0, f5: 5.0, f6: 6.0 }
    return Receipt { sequence: 1, landing: Landing { a: hit, b: hit, c: hit, d: hit, e: hit, f: hit, g: hit } }
}
@nomangle fn retain(receipt: Receipt) -> Event { return Event::Cast(receipt) }
@nomangle fn relay(receipt: Receipt) -> Receipt { return receipt }

struct ReceiptOwner { receipt: Receipt }
global SAVED: Receipt? = null

fn change(receipt: ref Receipt) {
    if receipt.landing != null { receipt.landing.a.f0 = 99.0 }
}
fn borrowed_inside(receipt: Receipt) -> Receipt {
    change(receipt)
    return receipt
}
fn save_and_return(receipt: Receipt) -> Receipt {
    return { SAVED = receipt; receipt }
}
fn signal(receipt: Receipt) -> float { return receipt.landing.unwrap().a.f0 }
fn Receipt.pass(receipt) -> Receipt { return receipt }
inline(lua) fn foreign_receipt(owner: ReceiptOwner) -> Receipt = """return owner.receipt"""

@test(output = "ok", backends = "lua")
fn shared_boundary_results_copy_before_mutable_storage_and_ref_borrows() {
    let original = make(42.0)
    let owner = ReceiptOwner { receipt: relay(original) }
    change(owner.receipt)
    assert_eq(signal(original), 42.0)
    assert(signal(owner.receipt) == 99.0, "owner changed")
    let local = relay(original)
    change(local)
    assert_eq(signal(original), 42.0)
    assert(signal(local) == 99.0, "local changed")
    assert(signal(borrowed_inside(original)) == 99.0, "by-value parameter changed locally")
    assert_eq(signal(original), 42.0)
    let returned = save_and_return(original)
    if SAVED != null { change(SAVED) }
    assert_eq(signal(original), 42.0)
    assert_eq(signal(returned), 42.0)
    let items = [relay(original)]
    change(items[0])
    assert_eq(signal(original), 42.0)
    assert(signal(items[0]) == 99.0, "element changed")
    let event = retain(original)
    let again = ReceiptOwner { receipt: original }
    change(again.receipt)
    match event { Event::Cast(receipt) => assert_eq(signal(receipt), 42.0), _ => assert(false) }
    let foreign_owner = ReceiptOwner { receipt: make(42.0) }
    let foreign_copy = foreign_receipt(foreign_owner)
    change(foreign_owner.receipt)
    assert(signal(foreign_copy) == 42.0, "a foreign result is a snapshot")
    let maybe: Receipt? = original
    let method_owner = ReceiptOwner { receipt: maybe?.pass() ?? original }
    change(method_owner.receipt)
    assert(signal(original) == 42.0, "a safe-nav call result copies at a mutable store")
    print("ok")
}

struct SelectionOwner { receipt: Receipt }
struct SelectionState { effects: int = 0, flag: bool }

fn selected_flag(state: SelectionState) -> bool {
    state.effects = state.effects * 10 + 1
    return state.flag
}
fn selected_guard(state: SelectionState) -> bool {
    state.effects = state.effects * 10 + 2
    return true
}
@nomangle fn conditional_effect(first: Receipt, second: Receipt, state: SelectionState) -> Receipt {
    let selected = if selected_flag(state) { first } else { second }
    return selected
}
@nomangle fn match_effect(first: Receipt, second: Receipt, state: SelectionState) -> Receipt {
    let selected = match selected_flag(state) {
        true if selected_guard(state) => first,
        _ => second
    }
    return selected
}
fn conditional_ref(first: Receipt, second: Receipt, flag: bool) -> Receipt {
    let selected = if flag { first } else { second }
    change(selected)
    return selected
}
fn match_ref(first: Receipt, second: Receipt, flag: bool) -> Receipt {
    let selected = match flag { true => first, false => second }
    change(selected)
    return selected
}
@nomangle fn conditional_source(first: Receipt, second: Receipt, flag: bool) -> Receipt {
    let selected = if flag { first } else { second }
    change(first)
    change(second)
    return selected
}
@nomangle fn match_source(first: Receipt, second: Receipt, flag: bool) -> Receipt {
    let selected = match flag { true => first, false => second }
    change(first)
    change(second)
    return selected
}
fn conditional_storage(first: SelectionOwner, second: SelectionOwner, flag: bool) -> Receipt {
    let selected = if flag { first.receipt } else { second.receipt }
    return selected
}
inline(lua) fn selected_foreign(owner: SelectionOwner) -> Receipt = "return owner.receipt"
fn match_foreign(first: SelectionOwner, second: SelectionOwner, flag: bool) -> Receipt {
    let selected = match flag { true => selected_foreign(first), false => selected_foreign(second) }
    return selected
}

@test(output = "ok", backends = "lua")
fn conditional_locals_keep_snapshots_and_evaluation_order() {
    let first = make(42.0)
    let second = make(7.0)
    let yes = SelectionState { flag: true }
    let no = SelectionState { flag: false }
    assert_eq(signal(conditional_effect(first, second, yes)), 42.0)
    assert_eq(signal(conditional_effect(first, second, no)), 7.0)
    assert_eq(yes.effects, 1)
    assert_eq(no.effects, 1)
    assert_eq(signal(match_effect(first, second, yes)), 42.0)
    assert_eq(signal(match_effect(first, second, no)), 7.0)
    assert_eq(yes.effects, 112)
    assert_eq(no.effects, 11)
    assert_eq(signal(conditional_ref(first, second, true)), 99.0)
    assert_eq(signal(match_ref(first, second, false)), 99.0)
    assert_eq(signal(conditional_source(first, second, true)), 42.0)
    assert_eq(signal(match_source(first, second, false)), 7.0)
    assert_eq(signal(first), 42.0)
    assert_eq(signal(second), 7.0)
    let first_owner = SelectionOwner { receipt: first }
    let second_owner = SelectionOwner { receipt: second }
    let storage = conditional_storage(first_owner, second_owner, true)
    let foreign = match_foreign(first_owner, second_owner, false)
    change(first_owner.receipt)
    change(second_owner.receipt)
    assert_eq(signal(storage), 42.0)
    assert_eq(signal(foreign), 7.0)
    print("ok")
}
