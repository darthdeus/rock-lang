// Value-returning calls must deliver every leaf in a single-value slot.
// Each section covers a slot with bare calls and transparent wrappers:
// parentheses, `::` ascriptions and identity `as` casts. Non-identity casts
// still convert. Float and integer values exercise both leaf kinds.

value Float2 {
    x: float,
    y: float,
}

value Float3 {
    r: float,
    g: float,
    b: float,
}

fn make_float2(a: float, b: float) -> Float2 {
    return Float2 { x: a, y: b }
}

fn make_float3(a: float, b: float, c: float) -> Float3 {
    return Float3 { r: a, g: b, b: c }
}

fn sum2(v: Float2) -> float {
    return v.x + v.y
}

fn sum3(v: Float3) -> float {
    return v.r + v.g + v.b
}

enum Side {
    Left,
    Right,
    Both,
}

fn make_sum_closure(v: Float2) -> fn() -> float {
    return () => v.x + v.y
}

fn maybe_v2(on: bool) -> Float2? {
    if on { return make_float2(5.0, 6.0) }
    return null
}

fn v2_mag_sq(v: Float2) -> float {
    return v.x * v.x + v.y * v.y
}

fn nested_early_return(pick: int) -> Float2 {
    if pick == 0 {
        if true {
            return make_float2(1.0, 2.0)
        }
    }
    if pick == 1 {
        return make_float2(10.0, 20.0)
    }
    return make_float2(100.0, 200.0)
}

fn maybe_v2_some(on: bool) -> Float2 {
    if on {
        return make_float2(1.0, 2.0)
    }
    return make_float2(3.0, 4.0)
}

fn maybe_v2_match(s: Side) -> Float2 {
    return match s {
        Side::Left => make_float2(1.0, 1.0),
        Side::Right => make_float2(10.0, 20.0),
        Side::Both => make_float2(100.0, 100.0),
    }
}

enum Shape {
    Point(Float2),
    Circle(Float2, float),
    Color(Float3),
}

fn shape_describe(s: Shape) -> float {
    return match s {
        Shape::Point(p) => sum2(p),
        Shape::Circle(c, r) => sum2(c) + r,
        Shape::Color(col) => sum3(col),
    }
}

enum MaybeV2 {
    Just(Float2),
    Nope,
}

fn unwrap_or_zero(m: MaybeV2) -> float {
    return match m {
        MaybeV2::Just(v) => sum2(v),
        MaybeV2::Nope => 0.0,
    }
}

fn invoke_fn(f: fn(float, float) -> Float2, a: float, b: float) -> Float2 {
    return f(a, b)
}

fn identity_generic<T>(x: T) -> T {
    return x
}

fn make_pair() -> (Float2, Float3) {
    return (make_float2(1.0, 2.0), make_float3(3.0, 4.0, 5.0))
}

global GLOB_V2: Float2 = make_float2(10.0, 20.0)

fn maybe_safe_v2(on: bool) -> Float2? {
    if on { return make_float2(5.0, 12.0) }
    return null
}

fn v2_add(a: Float2, b: Float2) -> Float2 {
    return Float2 { x: a.x + b.x, y: a.y + b.y }
}

value V2 {
    x: int,
    y: int,
}

value IRect {
    x: int,
    y: int,
    w: int,
    h: int,
}

fn make_v2() -> V2 {
    return V2 { x: 10, y: 20 }
}

fn make_rect() -> IRect {
    return IRect { x: 1, y: 2, w: 3, h: 4 }
}

fn __op_add(a: V2, b: V2) -> V2 {
    return V2 { x: a.x + b.x, y: a.y + b.y }
}

fn take_rect_int(a: IRect, b: int) -> int {
    return a.w + b
}

fn three_v2(a: V2, b: V2, c: int) -> int {
    return a.x + b.x + c
}

struct Holder {
    v: V2,
    r: IRect,
}

fn _ret_asc() -> V2 { return (make_v2() : V2) }

fn _ret_as() -> V2 { return make_v2() as V2 }

fn _v2_sum(v: V2) -> int { return v.x + v.y }

fn _v2_lit(x: int, y: int) -> V2 { return V2 { x: x, y: y } }

fn _v2_add(a: V2, b: V2) -> V2 { return a + b }

fn _v2_sum2(v: V2, k: int) -> int { return v.x + v.y + k }

co fn _co_yields() -> Coroutine<V2> {
    yield (make_v2() : V2)
    yield make_v2() as V2
}

fn _maybe_v2(yes: bool) -> V2? {
    if yes { return make_v2() }
    return null
}

fn _take_int(i: int) -> int { return i }

value _Line { a: V2, b: V2 }

fn _make_line() -> _Line {
    return _Line { a: V2 { x: 1, y: 2 }, b: V2 { x: 3, y: 4 } }
}

fn _take_line_k(l: _Line, k: int) -> int { return l.a.x + l.b.y + k }

value _Path { start: V2, end: V2 }

fn _make_path_bare() -> _Path {
    return _Path { start: make_v2(), end: make_v2() }
}

fn _make_path_ascription() -> _Path {
    return _Path { start: (make_v2() : V2), end: make_v2() }
}

fn _make_path_as() -> _Path {
    return _Path { start: make_v2() as V2, end: make_v2() as V2 }
}

value _Poly { p1: _Path, p2: _Path }

// -- Bindings, fields and nullable slots --

@test fn let_rhs() {
    let a = (make_rect() : IRect)
    assert_eq(a.w, 3)
    assert_eq(a.h, 4)
    let b = (make_rect())
    assert_eq(b.w, 3)
    assert_eq(b.h, 4)
    let c = make_rect() as IRect
    assert_eq(c.w, 3)
    assert_eq(c.h, 4)
    let f = ((make_rect() : IRect))
    assert_eq(f.w, 3)
    let h = ((make_rect() : IRect) : IRect)
    assert_eq(h.w, 3)
    let v = (((((make_v2() : V2)) as V2) : V2))
    assert_eq(v.x, 10)
    assert_eq(v.y, 20)
}

@test fn reassign() {
    let v = V2 { x: 0, y: 0 }
    v = (make_v2() : V2)
    assert_eq(v.x, 10)
    v = make_v2() as V2
    assert_eq(v.y, 20)
}

@test fn field_access() {
    assert_eq(((make_rect() : IRect)).w, 3)
    assert_eq((make_rect()).w, 3)
    assert_eq((make_rect() as IRect).w, 3)
    let s = ((make_rect() : IRect)).w + ((make_rect() : IRect)).h
    assert_eq(s, 7)
}

@test fn struct_literal_field() {
    let h = Holder { v: (make_v2() : V2), r: make_rect() }
    assert_eq(h.v.x, 10)
    assert_eq(h.r.w, 3)
    let g = Holder { v: make_v2() as V2, r: make_rect() as IRect }
    assert_eq(g.v.y, 20)
    assert_eq(g.r.h, 4)
}

@test fn nullable_let() {
    let a: V2? = (make_v2() : V2)
    let b: V2? = make_v2() as V2
    if a != null && b != null {
        assert_eq(a.x, 10)
        assert_eq(a.y, 20)
        assert_eq(b.x, 10)
        assert_eq(b.y, 20)
    } else {
        assert(false)
    }
}

@test(output = "3")
fn adv_nullable_slot_value_call() {
    let v: Float2? = make_float2(1.0, 2.0)
    if v != null {
        print("{sum2(v).floor()}")
    }
}

@test(output = "30")
fn adv_global_value_call_init() {
    print("{sum2(GLOB_V2).floor()}")
}

@test(output = "5\n-1")
fn adv_safe_nav_value_field() {
    let a = maybe_safe_v2(true)?.x ?? -1.0
    let b = maybe_safe_v2(false)?.x ?? -1.0
    print("{a.floor()}")
    print("{b.floor()}")
}

// -- Arguments and receivers --

@test fn nonlast_arg() {
    assert_eq(take_rect_int((make_rect() : IRect), 7), 10)
    assert_eq(take_rect_int((make_rect()), 7), 10)
    assert_eq(take_rect_int(make_rect() as IRect, 7), 10)
    assert_eq(three_v2((make_v2() : V2), make_v2(), 100), 120)
    assert_eq(three_v2(make_v2() as V2, make_v2(), 100), 120)
    assert_eq(three_v2(make_v2(), (make_v2() : V2), 100), 120)
    assert_eq(three_v2(make_v2(), make_v2() as V2, 100), 120)
}

@test fn if_and_match_in_nonlast_arg() {
    let flag = true
    assert_eq(_v2_sum2(if flag { (make_v2() : V2) } else { make_v2() }, 100), 130)
    let k = 1
    let r = _v2_sum2(match k {
        1 => (make_v2() : V2),
        _ => make_v2(),
    }, 100)
    assert_eq(r, 130)
}

@test fn ufcs_receiver() {
    assert_eq(((make_v2() : V2))._v2_sum(), 30)
    assert_eq((make_v2() as V2)._v2_sum(), 30)
}

@test(output = "25")
fn adv_ufcs_on_value_call() {
    // make_float2(...).v2_mag_sq() -- the call result is the receiver.
    // Tests whether UFCS method lowering packs / handles the multi-
    // return correctly in the receiver position.
    print("{make_float2(3.0, 4.0).v2_mag_sq().floor()}")
}

@test(output = "3")
fn adv_generic_with_value_type() {
    let v = identity_generic(make_float2(1.0, 2.0))
    print("{sum2(v).floor()}")
}

// -- Branches, coalesces and returns --

@test fn if_branch_ascription() {
    let flag = true
    let v = if flag { (make_v2() : V2) } else { make_v2() }
    assert_eq(v.x, 10)
    assert_eq(v.y, 20)
}

@test fn match_leaf() {
    let a = match 1 {
        1 => (make_v2() : V2),
        _ => make_v2(),
    }
    assert_eq(a.x, 10)
    assert_eq(a.y, 20)
    let b = match 1 {
        1 => make_v2() as V2,
        _ => make_v2(),
    }
    assert_eq(b.x, 10)
    assert_eq(b.y, 20)
}

@test fn coalesce_rhs() {
    let a = _maybe_v2(false) ?? ((make_v2() : V2))
    assert_eq(a.x, 10)
    let b = _maybe_v2(false) ?? (make_v2() as V2)
    assert_eq(b.y, 20)
}

@test fn return_stmt() {
    let a = _ret_asc()
    assert_eq(a.x, 10)
    assert_eq(a.y, 20)
    let b = _ret_as()
    assert_eq(b.x, 10)
    assert_eq(b.y, 20)
}

@test(output = "3")
fn adv_match_arm_value_call() {
    let s = Side::Right
    let v = match s {
        Side::Left => make_float2(1.0, 1.0),
        Side::Right => make_float2(2.0, 1.0),
        Side::Both => make_float2(10.0, 10.0),
    }
    print("{sum2(v).floor()}")
}

@test(output = "12")
fn adv_match_arm_into_scalar_slot() {
    let s = Side::Both
    let total = sum2(match s {
        Side::Left => make_float2(1.0, 1.0),
        Side::Right => make_float2(2.0, 2.0),
        Side::Both => make_float2(5.0, 7.0),
    })
    print("{total.floor()}")
}

@test(output = "11\n30")
fn adv_coalesce_rhs_value_call() {
    let a = maybe_v2(true) ?? make_float2(10.0, 20.0)
    let b = maybe_v2(false) ?? make_float2(10.0, 20.0)
    print("{sum2(a).floor()}")
    print("{sum2(b).floor()}")
}

@test(output = "21")
fn adv_nested_if_iife() {
    let a = false
    let b = true
    let total = sum3(
        if a {
            make_float3(100.0, 100.0, 100.0)
        } else if b {
            make_float3(10.0, 7.0, 4.0)
        } else {
            make_float3(0.0, 0.0, 0.0)
        },
    )
    print("{total.floor()}")
}

@test(output = "3\n30\n300")
fn adv_nested_early_return() {
    print("{sum2(nested_early_return(0)).floor()}")
    print("{sum2(nested_early_return(1)).floor()}")
    print("{sum2(nested_early_return(2)).floor()}")
}

@test(output = "3\n7")
fn adv_direct_return_if() {
    print("{sum2(maybe_v2_some(true)).floor()}")
    print("{sum2(maybe_v2_some(false)).floor()}")
}

@test(output = "2\n30\n200")
fn adv_direct_return_match() {
    // `Side::Left` inside string interpolation `{}` breaks Rock's
    // format parser (the `::` confuses it); bind to locals first.
    let l = maybe_v2_match(Side::Left)
    let r = maybe_v2_match(Side::Right)
    let b = maybe_v2_match(Side::Both)
    print("{sum2(l).floor()}")
    print("{sum2(r).floor()}")
    print("{sum2(b).floor()}")
}

// -- Containers, iteration and destructuring --

@test fn container_elements() {
    let xs = [(make_v2() : V2), make_v2()]
    assert_eq(xs[0].x, 10)
    assert_eq(xs[1].y, 20)
    let ys = [make_v2() as V2, make_v2()]
    assert_eq(ys[0].x, 10)
    let t = ((make_v2() : V2), make_v2(), 42)
    assert_eq(t.0.x, 10)
    assert_eq(t.1.y, 20)
    assert_eq(t.2, 42)
    let pushed: [V2] = []
    pushed.push((make_v2() : V2))
    pushed.push(make_v2() as V2)
    assert_eq(pushed[0].x, 10)
    assert_eq(pushed[1].y, 20)
    let m: Map<int, V2> = map_new()
    m[0] = (make_v2() : V2)
    m[1] = make_v2() as V2
    assert_eq(m[0].x, 10)
    assert_eq(m[1].y, 20)
}

@test fn vec_map_wrapped_return() {
    let xs = [1, 2, 3]
    let ys: [V2] = xs.iter().map(i => (V2 { x: i, y: i * 2 } : V2)).collect()
    assert_eq(ys[0].x, 1)
    assert_eq(ys[1].y, 4)
    assert_eq(ys[2].x, 3)
}

@test(output = "3 7")
fn adv_tuple_with_value_call() {
    let t = (make_float2(1.0, 2.0), 7)
    print("{sum2(t.0).floor()} {t.1}")
}

@test(output = "3 30")
fn adv_tuple_two_value_calls() {
    let t = (make_float2(1.0, 2.0), make_float3(10.0, 10.0, 10.0))
    print("{sum2(t.0).floor()} {sum3(t.1).floor()}")
}

@test(output = "3\n7")
fn adv_vec_push_value_call() {
    let xs: [Float2] = []
    xs.push(make_float2(1.0, 2.0))
    xs.push(make_float2(3.0, 4.0))
    print("{sum2(xs[0]).floor()}")
    print("{sum2(xs[1]).floor()}")
}

@test(output = "3\n7")
fn adv_array_literal_value_calls() {
    let xs: [Float2] = [make_float2(1.0, 2.0), make_float2(3.0, 4.0)]
    print("{sum2(xs[0]).floor()}")
    print("{sum2(xs[1]).floor()}")
}

@test(output = "3")
fn adv_map_value_insert() {
    let m: Map<int, Float2> = map_new()
    m[7] = make_float2(1.0, 2.0)
    print("{sum2(m[7]).floor()}")
}

@test(output = "3\n7\n11")
fn adv_for_loop_value_array() {
    let xs = [make_float2(1.0, 2.0), make_float2(3.0, 4.0), make_float2(5.0, 6.0)]
    for v in xs {
        print("{sum2(v).floor()}")
    }
}

@test(output = "100 7")
fn adv_for_loop_map_value_destructure() {
    // A single-entry map iterates deterministically.
    let m: Map<int, Float2> = map_new()
    m[100] = make_float2(3.0, 4.0)
    for (k, v) in m {
        print("{k} {sum2(v).floor()}")
    }
}

@test(output = "3\n12")
fn adv_tuple_destructure_value_types() {
    let (a, b) = make_pair()
    print("{sum2(a).floor()}")
    print("{sum3(b).floor()}")
}

@test(output = "100\n7")
fn adv_vec_indexed_write_value_call() {
    let xs = [make_float2(1.0, 2.0), make_float2(3.0, 4.0)]
    xs[0] = make_float2(40.0, 60.0)
    print("{sum2(xs[0]).floor()}")
    print("{sum2(xs[1]).floor()}")
}

// -- Lambdas, function values and coroutine yields --

@test fn lambda_body() {
    let f = () => (make_v2() : V2)
    let a = f()
    assert_eq(a.x, 10)
    assert_eq(a.y, 20)
    let g = () => make_v2() as V2
    let b = g()
    assert_eq(b.x, 10)
    assert_eq(b.y, 20)
}

@test fn lambda_call_result() {
    let f = () => make_v2()
    let a = (f() : V2)
    assert_eq(a.x, 10)
    assert_eq(a.y, 20)
    let b = f() as V2
    assert_eq(b.x, 10)
    assert_eq(b.y, 20)
}

@test fn coroutine_yield_wrapped() {
    let c = _co_yields()
    let a = c.resume()
    let b = c.resume()
    if a != null && b != null {
        assert_eq(a.x, 10)
        assert_eq(b.y, 20)
    } else {
        assert(false)
    }
}

@test(output = "30")
fn adv_closure_captures_value_param() {
    let f = make_sum_closure(make_float2(10.0, 20.0))
    print("{f().floor()}")
}

@test(output = "7")
fn adv_lambda_returning_value() {
    let mk = (a: float, b: float) => make_float2(a, b)
    print("{sum2(mk(3.0, 4.0)).floor()}")
}

@test(output = "30")
fn adv_value_fn_ref_roundtrip() {
    let total = sum2(invoke_fn(make_float2, 10.0, 20.0))
    print("{total.floor()}")
}

// -- Enum payloads --

@test(output = "3\n13\n6")
fn adv_enum_variant_payload_value_call() {
    let p = Shape::Point(make_float2(1.0, 2.0))
    let c = Shape::Circle(make_float2(2.0, 1.0), 10.0)
    let col = Shape::Color(make_float3(1.0, 2.0, 3.0))
    print("{shape_describe(p).floor()}")
    print("{shape_describe(c).floor()}")
    print("{shape_describe(col).floor()}")
}

@test(output = "7\n0")
fn adv_option_like_payload_call() {
    let a = MaybeV2::Just(make_float2(3.0, 4.0))
    let b = MaybeV2::Nope
    print("{unwrap_or_zero(a).floor()}")
    print("{unwrap_or_zero(b).floor()}")
}

// -- Operators, conversions and interpolation --

@test fn binop_operand() {
    let a = ((make_v2() : V2)) + make_v2()
    assert_eq(a.x, 20)
    assert_eq(a.y, 40)
    let b = make_v2() + ((make_v2() : V2))
    assert_eq(b.x, 20)
    assert_eq(b.y, 40)
    let c = (make_v2() as V2) + make_v2()
    assert_eq(c.x, 20)
    let d = make_v2() + (make_v2() as V2)
    assert_eq(d.y, 40)
}

@test fn wrapped_binop_result() {
    let v = (((_v2_add(_v2_lit(1, 2), _v2_lit(3, 4))) : V2))
    assert_eq(v.x, 4)
    assert_eq(v.y, 6)
    assert_eq(_v2_sum2(((_v2_lit(1, 2) + _v2_lit(3, 4)) : V2), 100), 110)
    assert_eq(((_v2_lit(1, 2) + _v2_lit(3, 4)) as V2).x, 4)
    let a = ((((make_v2() + make_v2()) : V2)) : V2)
    assert_eq(a.x, 20)
    assert_eq(a.y, 40)
}

@test fn deep_compound_mixed_wrappers() {
    let v = (((((make_v2() : V2)) + (make_v2() as V2)) : V2))
        + (((make_v2() as V2) : V2))
    assert_eq(v.x, 30)
    assert_eq(v.y, 60)
}

@test fn non_identity_as_keeps_its_conversion() {
    assert_eq(5.7 as int, 5)
    assert_eq(_take_int(3.9 as int), 3)
    assert_eq((3.9 as int) as int, 3)
    let v = (V2 { x: 5.7 as int, y: 3.9 as int } : V2)
    assert_eq(v.x, 5)
    assert_eq(v.y, 3)
}

@test(output = "21")
fn adv_chained_value_binary_calls() {
    let sum = v2_add(v2_add(make_float2(1.0, 2.0), make_float2(3.0, 4.0)), make_float2(5.0, 6.0))
    print("{sum2(sum).floor()}")
}

@test(output = "sum=3")
fn adv_interpolation_with_value_call_field() {
    print("sum={sum2(make_float2(1.0, 2.0)).floor()}")
}

@test(output = "total=30")
fn adv_interp_deep_value_expr() {
    print("total={(sum2(v2_add(make_float2(1.0, 2.0), make_float2(10.0, 17.0)))).floor()}")
}

// -- Nested values --

@test fn nested_value() {
    let l = (_make_line() : _Line)
    assert_eq(l.a.x, 1)
    assert_eq(l.b.y, 4)
    assert_eq((_make_line() as _Line).b.y, 4)
    assert_eq(_take_line_k((_make_line() : _Line), 100), 105)
}

@test fn nested_struct_literal_field_calls() {
    let a = _make_path_bare()
    assert_eq(a.start.x, 10)
    assert_eq(a.end.y, 20)
    let b = _make_path_ascription()
    assert_eq(b.start.x, 10)
    assert_eq(b.end.y, 20)
    let c = _make_path_as()
    assert_eq(c.start.x, 10)
    assert_eq(c.end.y, 20)
}

@test fn three_level_nested_wrapped() {
    let z = _Poly {
        p1: _Path { start: (make_v2() : V2), end: make_v2() as V2 },
        p2: (_make_path_ascription() : _Path),
    }
    assert_eq(z.p1.start.x, 10)
    assert_eq(z.p2.end.y, 20)
}
