// Value-returning calls must deliver every leaf in a single-value slot, bare
// and through transparent wrappers: parentheses, `::` ascriptions and
// identity `as` casts. Float and integer values exercise both leaf kinds.

value Float2 {
    x: float,
    y: float,
}

value Float3 {
    r: float,
    g: float,
    b: float,
}

fn make_float2(a: float, b: float) -> Float2 {
    return Float2 { x: a, y: b }
}

fn make_float3(a: float, b: float, c: float) -> Float3 {
    return Float3 { r: a, g: b, b: c }
}

fn sum2(v: Float2) -> float {
    return v.x + v.y
}

fn sum3(v: Float3) -> float {
    return v.r + v.g + v.b
}

enum Side {
    Left,
    Right,
    Both,
}

fn make_sum_closure(v: Float2) -> fn() -> float {
    return () => v.x + v.y
}

fn maybe_v2(on: bool) -> Float2? {
    if on { return make_float2(5.0, 6.0) }
    return null
}

fn v2_mag_sq(v: Float2) -> float {
    return v.x * v.x + v.y * v.y
}

fn nested_early_return(pick: int) -> Float2 {
    if pick == 0 {
        if true {
            return make_float2(1.0, 2.0)
        }
    }
    if pick == 1 {
        return make_float2(10.0, 20.0)
    }
    return make_float2(100.0, 200.0)
}

fn maybe_v2_match(s: Side) -> Float2 {
    return match s {
        Side::Left => make_float2(1.0, 1.0),
        Side::Right => make_float2(10.0, 20.0),
        Side::Both => make_float2(100.0, 100.0),
    }
}

enum Shape {
    Point(Float2),
    Circle(Float2, float),
    Color(Float3),
}

fn shape_describe(s: Shape) -> float {
    return match s {
        Shape::Point(p) => sum2(p),
        Shape::Circle(c, r) => sum2(c) + r,
        Shape::Color(col) => sum3(col),
    }
}

enum MaybeV2 {
    Just(Float2),
    Nope,
}

fn unwrap_or_zero(m: MaybeV2) -> float {
    return match m {
        MaybeV2::Just(v) => sum2(v),
        MaybeV2::Nope => 0.0,
    }
}

fn invoke_fn(f: fn(float, float) -> Float2, a: float, b: float) -> Float2 {
    return f(a, b)
}

fn identity_generic<T>(x: T) -> T {
    return x
}

fn make_pair() -> (Float2, Float3) {
    return (make_float2(1.0, 2.0), make_float3(3.0, 4.0, 5.0))
}

global GLOB_V2: Float2 = make_float2(10.0, 20.0)

fn maybe_safe_v2(on: bool) -> Float2? {
    if on { return make_float2(5.0, 12.0) }
    return null
}

fn v2_add(a: Float2, b: Float2) -> Float2 {
    return Float2 { x: a.x + b.x, y: a.y + b.y }
}

value V2 {
    x: int,
    y: int,
}

value IRect {
    x: int,
    y: int,
    w: int,
    h: int,
}

fn make_v2() -> V2 {
    return V2 { x: 10, y: 20 }
}

fn make_rect() -> IRect {
    return IRect { x: 1, y: 2, w: 3, h: 4 }
}

fn __op_add(a: V2, b: V2) -> V2 {
    return V2 { x: a.x + b.x, y: a.y + b.y }
}

fn take_rect_int(a: IRect, b: int) -> int {
    return a.w + b
}

fn three_v2(a: V2, b: V2, c: int) -> int {
    return a.x + b.x + c
}

struct Holder {
    v: V2,
    r: IRect,
}

fn _ret_asc() -> V2 { return (make_v2() : V2) }

fn _ret_as() -> V2 { return make_v2() as V2 }

fn _v2_sum(v: V2) -> int { return v.x + v.y }

fn _v2_lit(x: int, y: int) -> V2 { return V2 { x: x, y: y } }

fn _v2_add(a: V2, b: V2) -> V2 { return a + b }

fn _v2_sum2(v: V2, k: int) -> int { return v.x + v.y + k }

co fn _co_yields() -> Coroutine<V2> {
    yield (make_v2() : V2)
    yield make_v2() as V2
}

fn _maybe_v2(yes: bool) -> V2? {
    if yes { return make_v2() }
    return null
}

fn _take_int(i: int) -> int { return i }

value _Line { a: V2, b: V2 }

fn _make_line() -> _Line {
    return _Line { a: V2 { x: 1, y: 2 }, b: V2 { x: 3, y: 4 } }
}

fn _take_line_k(l: _Line, k: int) -> int { return l.a.x + l.b.y + k }

value _Path { start: V2, end: V2 }

fn _make_path_bare() -> _Path {
    return _Path { start: make_v2(), end: make_v2() }
}

fn _make_path_ascription() -> _Path {
    return _Path { start: (make_v2() : V2), end: make_v2() }
}

fn _make_path_as() -> _Path {
    return _Path { start: make_v2() as V2, end: make_v2() as V2 }
}

value _Poly { p1: _Path, p2: _Path }

@test(output = "5\n-1")
fn bindings_fields_and_nullable_slots() {
    let a = (make_rect() : IRect)
    let b = (make_rect())
    let c = make_rect() as IRect
    assert_eq(a.w * 100 + a.h * 10 + b.w + b.h + c.w + c.h, 354)
    let f = ((make_rect() : IRect))
    let h = ((make_rect() : IRect) : IRect)
    assert_eq(f.w + h.w, 6)
    let v = (((((make_v2() : V2)) as V2) : V2))
    assert_eq(v.x + v.y, 30)
    let r = V2 { x: 0, y: 0 }
    r = (make_v2() : V2)
    assert_eq(r.x, 10)
    r = make_v2() as V2
    assert_eq(r.y, 20)
    assert_eq(((make_rect() : IRect)).w, 3)
    assert_eq((make_rect()).w, 3)
    assert_eq((make_rect() as IRect).w, 3)
    assert_eq(((make_rect() : IRect)).w + ((make_rect() : IRect)).h, 7)
    let hd = Holder { v: (make_v2() : V2), r: make_rect() }
    let gd = Holder { v: make_v2() as V2, r: make_rect() as IRect }
    assert_eq(hd.v.x + hd.r.w + gd.v.y + gd.r.h, 37)
    let na: V2? = (make_v2() : V2)
    let nb: V2? = make_v2() as V2
    if na != null && nb != null {
        assert_eq(na.x + na.y + nb.x + nb.y, 60)
    } else {
        assert(false)
    }
    let nf: Float2? = make_float2(1.0, 2.0)
    if nf != null {
        assert_eq(sum2(nf), 3.0)
    }
    assert_eq(sum2(GLOB_V2), 30.0)
    let sa = maybe_safe_v2(true)?.x ?? -1.0
    let sb = maybe_safe_v2(false)?.x ?? -1.0
    print("{sa.floor()}")
    print("{sb.floor()}")
}

@test fn arguments_and_receivers() {
    assert_eq(take_rect_int((make_rect() : IRect), 7), 10)
    assert_eq(take_rect_int((make_rect()), 7), 10)
    assert_eq(take_rect_int(make_rect() as IRect, 7), 10)
    assert_eq(three_v2((make_v2() : V2), make_v2(), 100), 120)
    assert_eq(three_v2(make_v2() as V2, make_v2(), 100), 120)
    assert_eq(three_v2(make_v2(), (make_v2() : V2), 100), 120)
    assert_eq(three_v2(make_v2(), make_v2() as V2, 100), 120)
    let flag = true
    assert_eq(_v2_sum2(if flag { (make_v2() : V2) } else { make_v2() }, 100), 130)
    let k = 1
    let r = _v2_sum2(match k {
        1 => (make_v2() : V2),
        _ => make_v2(),
    }, 100)
    assert_eq(r, 130)
    assert_eq(((make_v2() : V2))._v2_sum(), 30)
    assert_eq((make_v2() as V2)._v2_sum(), 30)
    assert_eq(make_float2(3.0, 4.0).v2_mag_sq(), 25.0)
    assert_eq(sum2(identity_generic(make_float2(1.0, 2.0))), 3.0)
}

@test fn branches_coalesces_and_returns() {
    let flag = true
    let v = if flag { (make_v2() : V2) } else { make_v2() }
    assert_eq(v.x * 100 + v.y, 1020)
    let a = match 1 {
        1 => (make_v2() : V2),
        _ => make_v2(),
    }
    let b = match 1 {
        1 => make_v2() as V2,
        _ => make_v2(),
    }
    assert_eq(a.x * 100 + a.y + b.x * 10 + b.y, 1140)
    let ca = _maybe_v2(false) ?? ((make_v2() : V2))
    let cb = _maybe_v2(false) ?? (make_v2() as V2)
    assert_eq(ca.x * 100 + cb.y, 1020)
    let ra = _ret_asc()
    let rb = _ret_as()
    assert_eq(ra.x * 100 + ra.y + rb.x * 10 + rb.y, 1140)
    let s = Side::Right
    let m = match s {
        Side::Left => make_float2(1.0, 1.0),
        Side::Right => make_float2(2.0, 1.0),
        Side::Both => make_float2(10.0, 10.0),
    }
    assert_eq(sum2(m), 3.0)
    let both = Side::Both
    let total = sum2(match both {
        Side::Left => make_float2(1.0, 1.0),
        Side::Right => make_float2(2.0, 2.0),
        Side::Both => make_float2(5.0, 7.0),
    })
    assert_eq(total, 12.0)
    assert_eq(sum2(maybe_v2(true) ?? make_float2(10.0, 20.0)), 11.0)
    assert_eq(sum2(maybe_v2(false) ?? make_float2(10.0, 20.0)), 30.0)
    let x = false
    let y = true
    let t3 = sum3(
        if x {
            make_float3(100.0, 100.0, 100.0)
        } else if y {
            make_float3(10.0, 7.0, 4.0)
        } else {
            make_float3(0.0, 0.0, 0.0)
        },
    )
    assert_eq(t3, 21.0)
    assert_eq(sum2(nested_early_return(0)), 3.0)
    assert_eq(sum2(nested_early_return(1)), 30.0)
    assert_eq(sum2(nested_early_return(2)), 300.0)
    assert_eq(sum2(maybe_v2_match(Side::Left)), 2.0)
    assert_eq(sum2(maybe_v2_match(Side::Right)), 30.0)
    assert_eq(sum2(maybe_v2_match(Side::Both)), 200.0)
}

@test(output = "3\n7\n11\n100 7")
fn containers_iteration_and_destructuring() {
    let xs = [(make_v2() : V2), make_v2()]
    let ys = [make_v2() as V2, make_v2()]
    assert_eq(xs[0].x + xs[1].y + ys[0].x, 40)
    let t = ((make_v2() : V2), make_v2(), 42)
    assert_eq(t.0.x + t.1.y + t.2, 72)
    let pushed: [V2] = []
    pushed.push((make_v2() : V2))
    pushed.push(make_v2() as V2)
    assert_eq(pushed[0].x * 100 + pushed[1].y, 1020)
    let m: Map<int, V2> = map_new()
    m[0] = (make_v2() : V2)
    m[1] = make_v2() as V2
    assert_eq(m[0].x * 100 + m[1].y, 1020)
    let ns = [1, 2, 3]
    let mapped: [V2] = ns.iter().map(i => (V2 { x: i, y: i * 2 } : V2)).collect()
    assert_eq(mapped[0].x * 100 + mapped[1].y * 10 + mapped[2].x, 143)
    let tf = (make_float2(1.0, 2.0), make_float3(10.0, 10.0, 10.0))
    assert_eq(sum2(tf.0) + sum3(tf.1), 33.0)
    let fs: [Float2] = []
    fs.push(make_float2(1.0, 2.0))
    fs.push(make_float2(3.0, 4.0))
    assert_eq(sum2(fs[0]) * 10.0 + sum2(fs[1]), 37.0)
    let fm: Map<int, Float2> = map_new()
    fm[7] = make_float2(1.0, 2.0)
    assert_eq(sum2(fm[7]), 3.0)
    let arr = [make_float2(1.0, 2.0), make_float2(3.0, 4.0), make_float2(5.0, 6.0)]
    for v in arr {
        print("{sum2(v).floor()}")
    }
    // A single-entry map iterates deterministically.
    let one: Map<int, Float2> = map_new()
    one[100] = make_float2(3.0, 4.0)
    for (k, v) in one {
        print("{k} {sum2(v).floor()}")
    }
    let (pa, pb) = make_pair()
    assert_eq(sum2(pa) * 100.0 + sum3(pb), 312.0)
    let ws = [make_float2(1.0, 2.0), make_float2(3.0, 4.0)]
    ws[0] = make_float2(40.0, 60.0)
    assert_eq(sum2(ws[0]) * 10.0 + sum2(ws[1]), 1007.0)
}

@test fn lambdas_fn_values_and_yields() {
    let f = () => (make_v2() : V2)
    let g = () => make_v2() as V2
    let a = f()
    let b = g()
    assert_eq(a.x * 100 + a.y + b.x * 10 + b.y, 1140)
    let h = () => make_v2()
    let c = (h() : V2)
    let d = h() as V2
    assert_eq(c.x * 100 + c.y + d.x * 10 + d.y, 1140)
    let co = _co_yields()
    let ya = co.resume()
    let yb = co.resume()
    if ya != null && yb != null {
        assert_eq(ya.x * 100 + yb.y, 1020)
    } else {
        assert(false)
    }
    assert_eq(make_sum_closure(make_float2(10.0, 20.0))(), 30.0)
    let mk = (x: float, y: float) => make_float2(x, y)
    assert_eq(sum2(mk(3.0, 4.0)), 7.0)
    assert_eq(sum2(invoke_fn(make_float2, 10.0, 20.0)), 30.0)
}

@test fn enum_payloads() {
    assert_eq(shape_describe(Shape::Point(make_float2(1.0, 2.0))), 3.0)
    assert_eq(shape_describe(Shape::Circle(make_float2(2.0, 1.0), 10.0)), 13.0)
    assert_eq(shape_describe(Shape::Color(make_float3(1.0, 2.0, 3.0))), 6.0)
    assert_eq(unwrap_or_zero(MaybeV2::Just(make_float2(3.0, 4.0))), 7.0)
    assert_eq(unwrap_or_zero(MaybeV2::Nope), 0.0)
}

@test(output = "total=30")
fn operators_conversions_and_interpolation() {
    let a = ((make_v2() : V2)) + make_v2()
    let b = make_v2() + ((make_v2() : V2))
    let c = (make_v2() as V2) + make_v2()
    let d = make_v2() + (make_v2() as V2)
    assert_eq(a.x * 100 + a.y + b.x * 100 + b.y + c.x + d.y, 4140)
    let v = (((_v2_add(_v2_lit(1, 2), _v2_lit(3, 4))) : V2))
    assert_eq(v.x * 10 + v.y, 46)
    assert_eq(_v2_sum2(((_v2_lit(1, 2) + _v2_lit(3, 4)) : V2), 100), 110)
    assert_eq(((_v2_lit(1, 2) + _v2_lit(3, 4)) as V2).x, 4)
    let w = ((((make_v2() + make_v2()) : V2)) : V2)
    assert_eq(w.x * 100 + w.y, 2040)
    let deep = (((((make_v2() : V2)) + (make_v2() as V2)) : V2))
        + (((make_v2() as V2) : V2))
    assert_eq(deep.x * 100 + deep.y, 3060)
    // Non-identity casts still convert.
    assert_eq(5.7 as int, 5)
    assert_eq(_take_int(3.9 as int), 3)
    assert_eq((3.9 as int) as int, 3)
    let n = (V2 { x: 5.7 as int, y: 3.9 as int } : V2)
    assert_eq(n.x * 10 + n.y, 53)
    let sum = v2_add(v2_add(make_float2(1.0, 2.0), make_float2(3.0, 4.0)), make_float2(5.0, 6.0))
    assert_eq(sum2(sum), 21.0)
    print("total={(sum2(v2_add(make_float2(1.0, 2.0), make_float2(10.0, 17.0)))).floor()}")
}

@test fn nested_values() {
    let l = (_make_line() : _Line)
    assert_eq(l.a.x * 10 + l.b.y, 14)
    assert_eq((_make_line() as _Line).b.y, 4)
    assert_eq(_take_line_k((_make_line() : _Line), 100), 105)
    let a = _make_path_bare()
    let b = _make_path_ascription()
    let c = _make_path_as()
    assert_eq(a.start.x + a.end.y + b.start.x + b.end.y + c.start.x + c.end.y, 90)
    let z = _Poly {
        p1: _Path { start: (make_v2() : V2), end: make_v2() as V2 },
        p2: (_make_path_ascription() : _Path),
    }
    assert_eq(z.p1.start.x * 100 + z.p2.end.y, 1020)
}
