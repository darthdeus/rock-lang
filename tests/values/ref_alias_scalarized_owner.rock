// A `ref` (local, argument, or returned place) into a local whose storage
// holds a `value` struct. The write goes through an alias the MIR transforms
// cannot see, so the borrowed root cell must stay whole: SROA splitting or
// rematerializing it, or copy-prop forwarding its loads to the value ctor,
// moves the write onto a temporary while reads fold to the ctor's original
// operands. The lowering marks the root cell `borrowed`.
//
// Sibling coverage: tests/value_field_write_scalarized_local.rock (direct
// `h.p.x = v` writes on the owner).

value RaQuery {
    head: int = -1,
}

value RaGcQuery {
    head: int = -1,
    free: [int] = [],
}

struct RaGraph {
    query: RaQuery = RaQuery {},
}

struct RaGcGraph {
    query: RaGcQuery = RaGcQuery {},
}

fn ra_set(q: ref RaQuery, v: int) {
    q.head = v
}

fn ra_set_gc(q: ref RaGcQuery, v: int) {
    q.head = v
}

fn seed(n: int) -> int { return n }

@test
fn ref_local_write_reaches_scalarized_owner() {
    let g = RaGraph {}
    let q: ref RaQuery = g.query
    q.head = 3
    assert_eq(g.query.head, 3)
}

@test
fn ref_local_runtime_write_reaches_scalarized_owner() {
    let g = RaGraph {}
    let q: ref RaQuery = g.query
    q.head = seed(7)
    q.head += 1
    assert_eq(g.query.head, 8)
    assert_eq(q.head, 8)
}

@test
fn ref_local_write_reaches_gc_value_owner() {
    let g = RaGcGraph {}
    let q: ref RaGcQuery = g.query
    q.head = 3
    q.free.push(1)
    assert_eq(g.query.head, 3)
    assert_eq(g.query.free.len(), 1)
}

@test
fn ref_param_write_reaches_scalarized_owner() {
    let g = RaGraph {}
    ra_set(g.query, 4)
    assert_eq(g.query.head, 4)
}

@test
fn ref_param_write_is_seen_by_a_later_copy() {
    let g = RaGraph {}
    ra_set(g.query, 4)
    let q = g.query
    assert_eq(q.head, 4)
}

@test
fn ref_param_write_is_seen_by_a_later_copy_of_gc_value() {
    let g = RaGcGraph {}
    ra_set_gc(g.query, 4)
    let q = g.query
    assert_eq(q.head, 4)
}

@test
fn copy_taken_before_ref_write_stays_a_snapshot() {
    let g = RaGraph {}
    let before = g.query
    let q: ref RaQuery = g.query
    q.head = 5
    assert_eq(before.head, -1)
    assert_eq(g.query.head, 5)
}

value RaOuter {
    q: RaQuery = RaQuery {},
    n: int = 0,
}

@inline
fn ra_graph_set(g: ref RaGraph, v: int) {
    let q: ref RaQuery = g.query
    q.head = v
}

@inline
fn ra_query_of(g: ref RaGraph) -> ref RaQuery {
    return g.query
}

@inline
fn ra_set_inline(q: ref RaQuery, v: int) {
    q.head = v
}

fn ra_query_of_outlined(g: ref RaGraph) -> ref RaQuery {
    return g.query
}

@test
fn ref_param_write_reaches_whole_value_local() {
    let p = RaQuery {}
    ra_set(p, 4)
    assert_eq(p.head, 4)
}

@test
fn ref_local_write_reaches_whole_value_local() {
    let p = RaQuery {}
    let q: ref RaQuery = p
    q.head = 5
    assert_eq(p.head, 5)
}

@test
fn ref_param_write_reaches_nested_value_local() {
    let o = RaOuter {}
    ra_set(o.q, 6)
    assert_eq(o.q.head, 6)
}

@test
fn ref_local_write_reaches_nested_value_local() {
    let o = RaOuter {}
    let q: ref RaQuery = o.q
    q.head = 7
    assert_eq(o.q.head, 7)
}

@test
fn struct_ref_param_projects_a_written_value_field() {
    let g = RaGraph {}
    ra_graph_set(g, 8)
    assert_eq(g.query.head, 8)
}

@test
fn returned_ref_write_reaches_scalarized_owner() {
    let g = RaGraph {}
    let q: ref RaQuery = ra_query_of(g)
    q.head = 9
    assert_eq(g.query.head, 9)
}

@test
fn returned_ref_write_reaches_scalarized_owner_outlined() {
    let g = RaGraph {}
    let q: ref RaQuery = ra_query_of_outlined(g)
    q.head = 9
    assert_eq(g.query.head, 9)
}

@test
fn inlined_ref_param_write_reaches_scalarized_owner() {
    let g = RaGraph {}
    ra_set_inline(g.query, 3)
    assert_eq(g.query.head, 3)
}
