// A generic struct instantiated at a `nobox` value, a nullable `nobox` value,
// a value struct or a flat enum lays out like the same struct written without
// generics: the payload's leaves are the struct's own fields.

value P { x: float, y: float }
nobox value N { x: float, y: float }
enum Pick { Left, Right(int) }
enum Fl { A(N), B(float, float) }
enum R<T> { Ok(T), Err(string) }

struct Box<T> { v: T, tag: int }
value VBox<T> { v: T, tag: int }
nobox value NBox<T> { v: T, tag: int }
struct Defaults<T> { v: T, tag: int = 7 }
struct Bag<T> { items: [T], by_name: Map<string, T>, last: T? }
struct Boxed<T> { result: R<T> }

// The non-generic spellings every instance must agree with.
struct BoxN { v: N, tag: int }
struct BoxFl { v: Fl, tag: int }
value VBoxP { v: P, tag: int }

fn wrap(m: N) -> Box<N> { return Box { v: m, tag: 3 } }
fn wrap_n(m: N) -> BoxN { return BoxN { v: m, tag: 3 } }
fn wrap_any<T>(v: T) -> Box<T> { return Box { v: v, tag: 4 } }

@test(output = "2 1 3 / 5 4")
fn nobox_payload_fields_read_and_write_through_the_instance() {
    let b = wrap(N { x: 1.0, y: 2.0 })
    let before = "{b.v.y} {b.v.x} {b.tag}"
    b.v.x = 5.0
    let c = wrap_any(N { x: 0.0, y: 9.0 })
    print("{before} / {b.v.x} {c.tag}")
}

fn maybe(k: int) -> Box<N?> {
    if k == 0 { return Box { v: null, tag: 0 } }
    return Box { v: N { x: k as float, y: 1.0 }, tag: k }
}

@test(output = "absent 0 / present 3 3")
fn nullable_nobox_payloads_keep_absence() {
    let a = maybe(0)
    let b = maybe(3)
    let da = if a.v == null { "absent" } else { "present" }
    let pb = b.v
    let db = if pb == null { "absent" } else { "present {pb.x}" }
    print("{da} {a.tag} / {db} {b.tag}")
}

@noalloc
fn vsum(n: int) -> float {
    let total = 0.0
    for i in 0..n {
        let a: VBox<P> = VBox { v: P { x: i as float, y: 0.5 }, tag: i }
        let b: NBox<N> = NBox { v: N { x: 1.0, y: i as float }, tag: 2 }
        total += a.v.x + a.v.y + b.v.y + b.tag as float
    }
    return total
}

@test
fn value_and_nobox_instances_flatten_their_payloads() {
    // Per i: i + 0.5 + i + 2.
    assert_eq(vsum(4), 2.0 * 6.0 + 4.0 * 2.5)
}

fn pick(k: int) -> Box<Pick> {
    if k < 0 { return Box { v: Pick::Left, tag: k } }
    return Box { v: Pick::Right(k), tag: k }
}

fn fl(k: int) -> Box<Fl> {
    if k < 0 { return Box { v: Fl::A(N { x: 1.0, y: 2.0 }), tag: k } }
    return Box { v: Fl::B(k as float, 0.5), tag: k }
}

fn describe_fl(b: Box<Fl>) -> string {
    return match b.v {
        Fl::A(n) => "a {n.x},{n.y}",
        Fl::B(x, y) => "b {x},{y}",
    }
}

@test(output = "left right 4 / a 1,2 b 3,0.5")
fn flat_enum_payloads_match_through_the_instance() {
    let l = match pick(-1).v { Pick::Left => "left", Pick::Right(k) => "right {k}" }
    let r = match pick(4).v { Pick::Left => "left", Pick::Right(k) => "right {k}" }
    print("{l} {r} / {describe_fl(fl(-1))} {describe_fl(fl(3))}")
}

fn describe_r(r: R<N>) -> string {
    return match r {
        R::Ok(n) => "ok {n.x},{n.y}",
        R::Err(e) => "err {e}",
    }
}

fn ok_box(k: int) -> R<VBox<N>> {
    if k < 0 { return R::Err("neg") }
    return R::Ok(VBox { v: N { x: k as float, y: 1.0 }, tag: k })
}

@test(output = "ok 2,0.5 err no / ok 5 1 5 neg / 6 3")
fn generic_structs_and_enums_nest_inside_each_other() {
    let a: Boxed<N> = Boxed { result: R::Ok(N { x: 2.0, y: 0.5 }) }
    let b: Boxed<N> = Boxed { result: R::Err("no") }
    let c = match ok_box(5) { R::Ok(vb) => "ok {vb.v.x} {vb.v.y} {vb.tag}", R::Err(e) => e }
    let d = match ok_box(-1) { R::Ok(vb) => "ok {vb.tag}", R::Err(e) => e }
    let e: Box<VBox<N>> = Box { v: VBox { v: N { x: 6.0, y: 0.0 }, tag: 1 }, tag: 3 }
    print("{describe_r(a.result)} {describe_r(b.result)} / {c} {d} / {e.v.v.x} {e.tag}")
}

fn last_x(bag: Bag<N>) -> float {
    let last = bag.last
    return if last == null { 0.0 } else { last.x }
}

@test(output = "2 7 / 3 9 1")
fn containers_and_defaults_hold_instance_payloads() {
    let bag: Bag<N> = Bag { items: [], by_name: map_new(), last: null }
    bag.items.push(N { x: 1.0, y: 2.0 })
    bag.items.push(N { x: 3.0, y: 4.0 })
    bag.by_name["k"] = N { x: 9.0, y: 0.0 }
    bag.last = N { x: 1.0, y: 0.0 }
    let d: Defaults<N> = Defaults { v: N { x: 0.0, y: 1.0 } }
    print("{bag.items.len()} {d.tag} / {bag.items[1].x} {bag.by_name["k"].x} {last_x(bag)}")
}

@test(output = "4 3 / 8")
fn functional_update_copies_inline_payloads() {
    let a = wrap(N { x: 4.0, y: 0.0 })
    let b = Box { ..a, tag: 8 }
    a.v.x = 1.0
    print("{b.v.x} {a.tag} / {b.tag}")
}

@test
fn inspect_equality_and_interpolation_match_the_non_generic_struct() {
    let n = N { x: 1.0, y: 2.0 }
    assert_eq(inspect(wrap(n)).replace("Box ", "BoxN "), inspect(wrap_n(n)))
    assert_eq(inspect(fl(3)).replace("Box ", "BoxFl "), inspect(BoxFl { v: Fl::B(3.0, 0.5), tag: 3 }))
    let v: VBox<P> = VBox { v: P { x: 1.0, y: 2.0 }, tag: 3 }
    let w = VBoxP { v: P { x: 1.0, y: 2.0 }, tag: 3 }
    assert_eq("{v}".replace("VBox ", "VBoxP "), "{w}")
    assert_eq(inspect(v).replace("VBox ", "VBoxP "), inspect(w))
    let same: VBox<P> = VBox { v: P { x: 1.0, y: 2.0 }, tag: 3 }
    let other: VBox<P> = VBox { v: P { x: 1.0, y: 5.0 }, tag: 3 }
    assert(v == same)
    assert(v != other)
    let nb: NBox<N> = NBox { v: n, tag: 1 }
    assert_eq("{nb}", "NBox {{ v: N {{ x: 1, y: 2 }}, tag: 1 }}")
}
