// A capturing lambda compiles to an env record `setmetatable({ __slot = .., c<N>
// = .. }, __rock_fn_mt)` -- a plain Lua table. Every generic table-walker
// (inspect, and interpolation of a composite, which routes through inspect) must
// render it as a FUNCTION value, matching a capture-free lambda (a raw Lua
// function), not leak its `{ __slot = .., c<N> = .. }` capture internals.

struct Holder { cb: fn() -> int, tag: int }

fn make_capfree() -> fn() -> int { return () => 42 }
fn make_capturing(x: int) -> fn() -> int { return () => x + 1 }

// Both a capture-free (raw function) and a capturing (record) lambda inspect to
// the `function: ...` form -- the record is rendered via its CodeRef, not walked.
@test(output = "true\ntrue")
fn test_inspect_record_renders_as_function() {
    print(inspect(make_capfree()).starts_with("function: "))
    print(inspect(make_capturing(10)).starts_with("function: "))
}

// No capture internals leak from a record's inspect output.
@test(output = "false")
fn test_inspect_record_no_leak() {
    print(inspect(make_capturing(10)).contains("__slot"))
}

// A struct holding a capturing lambda renders the field as a function, same as
// one holding a capture-free lambda -- the record does not leak through the walk.
@test(output = "true\ntrue\nfalse")
fn test_inspect_composite_with_record() {
    let hf = Holder { cb: make_capfree(), tag: 1 }
    let hc = Holder { cb: make_capturing(10), tag: 2 }
    print(inspect(hf).contains("cb = function: "))
    print(inspect(hc).contains("cb = function: "))
    print(inspect(hc).contains("__slot"))
}

// Interpolation of a composite holding a capturing lambda routes through inspect
// -- same no-leak guarantee.
@test(output = "false")
fn test_interp_composite_with_record() {
    let hc = Holder { cb: make_capturing(10), tag: 2 }
    let s = "{hc}"
    print(s.contains("__slot"))
}
