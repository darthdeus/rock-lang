// Core type inference tests migrated from rock/tests/type_system_tests.rs simple_inference_tests module
// Tests fundamental type inference patterns, error cases, and basic language constructs
// Covers literals, let bindings, function types, if expressions, loops, and semicolon handling

// ============================================
// Helper Function Definitions
// ============================================

fn foo_any(x: any) {
    print(x)
}

fn bar_string(x: string) -> string {
    return x
}

fn baz_string(x: string) -> string {
    print("test")
    return x
}

fn foo_unit() -> int { 5 }

fn foo_semicolon() -> int {
    let x = 5
    x + 10
}

fn foo_empty() {}

fn foo_let_unit() { let x = 5 }

fn process_int(x: int) -> int {
    return x
}

fn process_string(s: string) {
    print(s)
}

fn compute(x: int, y: int) -> int {
    return x * y + 5
}

fn is_positive(x: int) -> bool {
    return x > 0
}

fn add_one(x: int) -> int {
    return x + 1
}

fn multiply_by_three(x: int) -> int {
    return x * 3
}

fn log_and_double(x: int) -> int {
    print("Processing {x}")
    return x * 2
}

// ============================================
// Basic Type Inference Tests
// ============================================

@test(output = "false")
fn test_bool_literal_inference() {
    print(true == false)
}

@test(type_holes = [[0, "int"], [1, "int"]])
fn test_typed_let_inference() {
    let x: int = 5
    let y: ? = x
    let z: ? = 5
}

@test(output = "test")
fn test_function_parameter_types() {
    let a = 5
    let b = bar_string("test")
    print(b)
}

@test(output = "hello\\n5")
fn test_print_accepts_any() {
    let x = "hello"
    print(x)
    
    let y = 5
    print(y)
}

// ============================================
// If Expression Type Inference Tests
// ============================================

@test(output = "0")
fn test_if_no_else_is_unit() {
    // statement position: a no-else if is unit. In value position
    // (`let x = if true { () }`) bone rejects it (missing else).
    if true { () }
    print(0)
}

// ============================================
// While Loop Type Inference Tests
// ============================================

@test(type_holes = [[0, "int"], [1, "int"]])
fn test_while_loop_inference() {
    let x = 0
    let a: ? = x
    
    while x < 5 {
        x = x + 1
        let b: ? = x
    }
}

