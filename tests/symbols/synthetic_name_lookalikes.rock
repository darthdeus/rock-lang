// A user name shaped like a synthetic one collides only when the shape that
// mints it is present: these emit no synthetic of the same name, so they
// compile. The rejections are in tests/errors/synthetic_name_collision.rock.err.

@nomangle fn worker_0__on_killed() -> int { return 42 }
co fn worker() -> Coroutine<int> {
    yield 1
}

@test(output = "42")
fn a_hook_name_without_a_hook_compiles() {
    let w = worker()
    print("{worker_0__on_killed()}")
}

@nomangle fn bar_0__lambda0() -> int { return 3 }
fn bar() -> int { return 1 }

@test(output = "3 1")
fn a_lambda_name_without_a_lambda_compiles() {
    print("{bar_0__lambda0()} {bar()}")
}
