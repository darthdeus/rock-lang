// Scalar pointer indexing returns a Lua number, but equality still compares
// the underlying element bytes and must respect the element width.

@test
fn int_native_buffer_equality() {
    let a = native_buffer_int(2)
    let b = native_buffer_int(2)
    nb_set(a, 0, 7)
    nb_set(a, 1, -9)
    nb_set(b, 0, 7)
    nb_set(b, 1, -9)
    assert_eq(a == b, true)
    nb_set(b, 1, -8)
    assert_eq(a == b, false)
}

@test
fn float_native_buffer_equality() {
    let a = native_buffer_float(2)
    let b = native_buffer_float(2)
    nb_set(a, 0, 1.5)
    nb_set(a, 1, -2.25)
    nb_set(b, 0, 1.5)
    nb_set(b, 1, -2.25)
    assert_eq(a == b, true)
    nb_set(b, 1, -2.5)
    assert_eq(a == b, false)
}

@test
fn scalar_flat_vec_equality() {
    let a: FlatVec<float> = flat_vec_new(2)
    let b: FlatVec<float> = flat_vec_new(8)
    a.push(1.5)
    b.push(1.5)
    assert_eq(a == b, true)
    b.push(3.0)
    assert_eq(a == b, false)
}

@test
fn empty_scalar_native_buffers_are_equal() {
    assert_eq(native_buffer_int(0) == native_buffer_int(0), true)
    let a: FlatVec<int> = flat_vec_new(1)
    let b: FlatVec<int> = flat_vec_new(4)
    assert_eq(a == b, true)
}
