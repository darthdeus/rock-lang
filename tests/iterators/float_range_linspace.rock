// Tests for linspace (count-based float sequence) and float_range (step-based).

// ---- linspace -----------------------------------------------------------

@test
fn test_linspace_basic() {
    // 5 evenly-spaced values from 0.0 to 1.0 inclusive — step = 0.25
    let r = linspace(0.0, 1.0, 5)
    assert_eq(r.len, 5)
    assert_eq(r[0], 0.0)
    assert_eq(r[1], 0.25)
    assert_eq(r[2], 0.5)
    assert_eq(r[3], 0.75)
    assert_eq(r[4], 1.0)
}

@test
fn test_linspace_two_elements() {
    let r = linspace(0.0, 1.0, 2)
    assert_eq(r.len, 2)
    assert_eq(r[0], 0.0)
    assert_eq(r[1], 1.0)
}

@test
fn test_linspace_one_element() {
    let r = linspace(0.0, 1.0, 1)
    assert_eq(r.len, 1)
    assert_eq(r[0], 0.0)
}

@test
fn test_linspace_zero_count() {
    let r = linspace(0.0, 1.0, 0)
    assert_eq(r.len, 0)
}

@test
fn test_linspace_negative_range() {
    let r = linspace(-1.0, 1.0, 5)
    assert_eq(r.len, 5)
    assert_eq(r[0], -1.0)
    assert_eq(r[4], 1.0)
}

// ---- float_range --------------------------------------------------------

@test
fn test_float_range_basic() {
    // 0.0, 0.25, 0.5, 0.75 — excludes 1.0
    let r = float_range(0.0, 1.0, 0.25)
    assert_eq(r.len, 4)
    assert_eq(r[0], 0.0)
    assert_eq(r[1], 0.25)
    assert_eq(r[2], 0.5)
    assert_eq(r[3], 0.75)
}

@test
fn test_float_range_step_larger_than_range() {
    let r = float_range(0.0, 1.0, 2.0)
    assert_eq(r.len, 1)
    assert_eq(r[0], 0.0)
}

@test
fn test_float_range_empty_when_start_eq_end() {
    let r = float_range(0.0, 0.0, 0.1)
    assert_eq(r.len, 0)
}

@test
fn test_float_range_zero_step_returns_empty() {
    let r = float_range(0.0, 1.0, 0.0)
    assert_eq(r.len, 0)
}

@test
fn test_float_range_negative_step() {
    // 10.0, 7.0, 4.0, 1.0 — all > 0.0
    let r = float_range(10.0, 0.0, -3.0)
    assert_eq(r.len, 4)
    assert_eq(r[0], 10.0)
    assert_eq(r[1], 7.0)
    assert_eq(r[2], 4.0)
    assert_eq(r[3], 1.0)
}

@test
fn test_float_range_wrong_direction_returns_empty() {
    let r = float_range(0.0, 1.0, -0.5)
    assert_eq(r.len, 0)
}

@test
fn test_float_range_exact_endpoint_excluded() {
    // step of 0.5, end = 1.0: values 0.0, 0.5 — 1.0 is excluded
    let r = float_range(0.0, 1.0, 0.5)
    assert_eq(r.len, 2)
    assert_eq(r[0], 0.0)
    assert_eq(r[1], 0.5)
}
