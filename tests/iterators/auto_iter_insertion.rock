// Test file for automatic  insertion in for loops

@test
fn test_simple_identifier_gets_iter() {
    let arena = arena_new()
    insert(arena, 42)
    insert(arena, 100)

    let count = 0

    // This should automatically get  inserted: for item in arena
    for item in arena {
        count += 1
    }

    assert_eq(count, 2)
}

@test
fn test_array_literal_unchanged() {
    let count = 0

    // Array literals should not get  inserted
    for item in [1, 2, 3] {
        count += 1
    }

    assert_eq(count, 3)
}

@test
fn test_function_call_unchanged() {
    let arena = arena_new()
    insert(arena, 42)
    insert(arena, 100)

    let count = 0

    // Direct iteration over arena with 
    for (entity, value) in arena {
        count += 1
    }

    assert_eq(count, 2)
}

@test
fn test_map_iteration_with_auto_iter() {
    let map = map_new()
    insert(map, "a", 1)
    insert(map, "b", 2)

    let count = 0

    // This should automatically get  inserted: for item in map
    for item in map {
        count += 1
    }

    assert_eq(count, 2)
}

@test
fn test_range_iteration_with_auto_iter() {
    let count = 0

    // This should automatically get  inserted: for i in __rock_range(0, 3)
    // __rock_range(0, 3) returns [0, 1, 2] (exclusive upper bound), so 3 elements
    for i in __rock_range(0, 3) {
        count += 1
    }

    assert_eq(count, 3)
}
