// What a `[T]` element access does when the compiler can prove its index in
// bounds, and when it cannot. The compiler drops the check for a counter that
// a loop or a guard keeps below the vector's length, as long as nothing on
// the way can shrink the vector or rebind it; everywhere else the access
// still raises on an index outside `[0, len)`. These cases pin that the
// results and the errors are the same either way.

@intrinsic @nomangle inline(lua) fn try_call(f: fn()) -> bool = """
    local ok, err = pcall(f)
    return not ok
"""

struct Bag { items: [int] }

fn join(xs: [int]) -> string {
    let out = ""
    for x in xs { out = out + "{x}," }
    return out
}

@test(output = "0,2,4,6,")
fn counted_fill_writes_every_slot() {
    let xs = [9, 9, 9, 9]
    for i in 0..xs.len() { xs[i] = i * 2 }
    print(join(xs))
}

@test(output = "1,2,3,4,")
fn counted_read_modify_write() {
    let xs = [0, 1, 2, 3]
    for i in 0..xs.len() { xs[i] = xs[i] + 1 }
    print(join(xs))
}

@test(output = "7,1,2,3, 1,2,3,")
fn counted_loop_over_a_field() {
    let bag = Bag { items: [0, 1, 2, 3] }
    let copy: [int] = []
    for i in 0..bag.items.len() {
        if bag.items[i] > 0 { copy.push(bag.items[i]) }
        if i == 0 { bag.items[i] = 7 }
    }
    print("{join(bag.items)} {join(copy)}")
}

@test(output = "0,1,-1,-1, false")
fn break_stops_the_fill() {
    let xs = [-1, -1, -1, -1]
    let failed = try_call(() => {
        for i in 0..xs.len() {
            if i == 2 { break }
            xs[i] = i
        }
    })
    print("{join(xs)} {failed}")
}

@test(output = "0,-1,2,-1,")
fn continue_skips_a_slot() {
    let xs = [-1, -1, -1, -1]
    for i in 0..xs.len() {
        if i % 2 == 1 { continue }
        xs[i] = i
    }
    print(join(xs))
}

@test(output = "10,20,30, true")
fn a_pop_in_the_body_still_raises_on_the_missing_slot() {
    let xs = [1, 2, 3, 4]
    let failed = try_call(() => {
        for i in 0..xs.len() {
            if i == 0 { xs.pop() }
            xs[i] = xs[i] * 10
        }
    })
    print("{join(xs)} {failed}")
}

@test(output = "0,10,20,30,4, false")
fn a_push_in_the_body_keeps_the_writes_in_bounds() {
    let xs = [0, 1, 2, 3]
    let failed = try_call(() => {
        for i in 0..xs.len() {
            if i == 0 { xs.push(4) }
            xs[i] = xs[i] * 10
        }
    })
    print("{join(xs)} {failed}")
}

@test(output = "true 0,")
fn a_clear_in_the_body_raises() {
    let xs = [1, 2, 3]
    let failed = try_call(() => {
        for i in 0..xs.len() {
            xs[i] = 0
            xs.clear()
        }
    })
    xs.push(0)
    print("{failed} {join(xs)}")
}

fn endpoint_with_nonfinite_length(xs: [int]) -> int {
    xs.len = 1 ./ 0
    if xs.len > 0 { return xs[xs.len - 1] }
    return 0
}

@test(output = "true")
fn a_nonfinite_length_does_not_prove_the_last_index() {
    let xs = [7]
    print(try_call(() => { let result = endpoint_with_nonfinite_length(xs) }))
}

fn shrink(xs: [int]) { xs.pop() }

@test(output = "true 10,")
fn a_call_in_the_body_that_shrinks_the_vector_raises() {
    let xs = [1, 2]
    let failed = try_call(() => {
        for i in 0..xs.len() {
            xs[i] = xs[i] * 10
            shrink(xs)
        }
    })
    print("{failed} {join(xs)}")
}

@test(output = "true 1,0, 0,0,0,")
fn rebinding_the_vector_in_the_body_checks_the_new_one() {
    let xs = [1, 2]
    let ys = [0, 0, 0]
    let failed = try_call(() => {
        let v = ys
        for i in 0..v.len() {
            v[i] = 0
            v = xs
        }
    })
    print("{failed} {join(xs)} {join(ys)}")
}

@test(output = "true 1,2,")
fn a_parallel_vector_of_a_different_length_still_raises() {
    let xs = [1, 2, 3]
    let ys = [5, 6]
    let failed = try_call(() => {
        for i in 0..xs.len() { ys[i] = xs[i] }
    })
    print("{failed} {join(ys)}")
}

@test(output = "0,0,3,")
fn while_loop_against_the_live_length() {
    let xs = [1, 2, 3]
    let i = 0
    while i < xs.len() - 1 {
        xs[i] = 0
        i += 1
    }
    print(join(xs))
}

fn set_slot(xs: [int], i: int, v: int) -> bool {
    if i < 0 { return false }
    if i >= xs.len() { return false }
    xs[i] = v
    return true
}

@test(output = "true false false 1,7,3,")
fn a_guarded_slot_write() {
    let xs = [1, 2, 3]
    let a = set_slot(xs, 1, 7)
    let b = set_slot(xs, 3, 8)
    let c = set_slot(xs, -1, 9)
    print("{a} {b} {c} {join(xs)}")
}

fn bump(xs: [int], i: int) {
    let v = xs[i]
    xs[i] = v + 1
}

@test(output = "1,3,3, true")
fn a_checked_read_covers_the_write_that_follows() {
    let xs = [1, 2, 3]
    bump(xs, 1)
    let failed = try_call(() => { bump(xs, 3) })
    print("{join(xs)} {failed}")
}

@test(output = "1,2,3,4,5,6,")
fn nested_counted_loops_over_rows() {
    let rows = [[0, 0, 0], [0, 0, 0]]
    let n = 1
    for r in 0..rows.len() {
        for c in 0..rows[r].len() {
            rows[r][c] = n
            n += 1
        }
    }
    let out = ""
    for row in rows { out = out + join(row) }
    print(out)
}

@test(output = "1 of 3")
fn a_null_element_reads_as_null_in_a_counted_loop() {
    let xs: [int?] = [1, null, 3]
    let nulls = 0
    for i in 0..xs.len() {
        if xs[i] == null { nulls += 1 }
    }
    print("{nulls} of {xs.len()}")
}

@test(output = "2 false,true,false,")
fn false_elements_read_as_false_in_a_counted_loop() {
    let xs = [false, true, false]
    let falses = 0
    for i in 0..xs.len() {
        if xs[i] == false { falses += 1 }
    }
    let out = ""
    for i in 0..xs.len() { out = out + "{xs[i]}," }
    print("{falses} {out}")
}

@test(output = "true")
fn an_empty_vector_runs_no_turn() {
    let xs: [int] = []
    let failed = try_call(() => {
        for i in 0..xs.len() { xs[i] = 1 }
    })
    print("{!failed}")
}

@test(output = "0,1,2,3, true")
fn a_larger_bound_still_raises() {
    let xs = [0, 0, 0, 0]
    let failed = try_call(() => {
        for i in 0..xs.len() + 1 { xs[i] = i }
    })
    print("{join(xs)} {failed}")
}

@test(output = "9,1,2,")
fn a_descending_subtracted_bound_stays_in_bounds() {
    let xs = [0, 1, 2]
    for i in 0..xs.len() - 2 { xs[i] = 9 }
    print(join(xs))
}

fn main() {}

// --- Ways a loop body can reach the vector that the compiler must not miss.

fn popper(xs: [int]) -> int { xs.pop(); return 0 }

@test(output = "true []")
fn a_function_value_called_in_the_body_still_raises() {
    let xs = [1, 2]
    let f = popper
    let failed = try_call(() => {
        for i in 0..xs.len() { xs[i] = f(xs) }
    })
    print("{failed} [{join(xs)}]")
}

@debug_impure fn debug_pop(xs: [int]) -> int { xs.pop(); return 0 }
@pure fn via_debug_impure(xs: [int]) -> int { return debug_pop(xs) }

@test(output = "true []")
fn a_pure_callee_that_reaches_a_pop_still_raises() {
    let xs = [1, 2]
    let failed = try_call(() => {
        for i in 0..xs.len() { xs[i] = via_debug_impure(xs) }
    })
    print("{failed} [{join(xs)}]")
}

struct Tag { items: [int] }
fn Tag.to_string(t) -> string { t.items.pop(); return "tag" }

// Interpolation renders through the runtime, never a user `to_string`, so
// the body's only call is the renderer and nothing shrinks the vector.
@test(output = "false 0,0,")
fn an_interpolation_runs_no_user_to_string() {
    let t = Tag { items: [1, 2] }
    let out = ""
    let failed = try_call(() => {
        for i in 0..t.items.len() {
            out = out + "{t}"
            t.items[i] = 0
        }
    })
    print("{failed} {join(t.items)}")
}

struct Mark { xs: [int] }
operator +(a: Mark, b: Mark) -> int { a.xs.pop(); return 0 }

@test(output = "true []")
fn an_overloaded_operator_in_the_body_still_raises() {
    let m = Mark { xs: [1, 2] }
    let failed = try_call(() => {
        for i in 0..m.xs.len() { m.xs[i] = m + m }
    })
    print("{failed} [{join(m.xs)}]")
}

@test(output = "true []")
fn an_alias_of_the_vector_popped_in_the_body_still_raises() {
    let xs = [1, 2]
    let ys = xs
    let failed = try_call(() => {
        for i in 0..xs.len() {
            ys.pop()
            xs[i] = 0
        }
    })
    print("{failed} [{join(xs)}]")
}

@test(output = "true []")
fn a_closure_called_in_the_body_still_raises() {
    let xs = [1, 2]
    let shrink = () => { xs.pop() }
    let failed = try_call(() => {
        for i in 0..xs.len() {
            shrink()
            xs[i] = 0
        }
    })
    print("{failed} [{join(xs)}]")
}

@test(output = "true 5,6,7, 9,9,")
fn a_row_replaced_in_the_inner_loop_is_checked_against_the_new_row() {
    let short = [1, 2]
    let rows = [[5, 6, 7]]
    let failed = try_call(() => {
        for r in 0..rows.len() {
            for c in 0..rows[r].len() {
                rows[r] = short
                rows[r][c] = 9
            }
        }
    })
    print("{failed} {join([5, 6, 7])} {join(rows[0])}")
}

@test(output = "true -1,-1,")
fn an_index_below_zero_still_raises() {
    let xs = [-1, -1]
    let failed = try_call(() => {
        for i in 0..xs.len() { xs[i - 1] = i }
    })
    print("{failed} {join(xs)}")
}

co fn writer(xs: [int]) -> Coroutine<int> {
    for i in 0..xs.len() {
        xs[i] = i + 10
        yield i
    }
}

@test(output = "0 1 true 10,11,")
fn a_pop_across_a_yield_raises_and_terminates_the_coroutine() {
    let xs = [1, 2, 3]
    let c = writer(xs)
    let a = c.resume() ?? -9
    let b = c.resume() ?? -9
    xs.pop()
    assert(try_call(() => { let _ = c.resume() }))
    assert_eq(c.status(), "dead")
    assert(!c.completed())
    let dead = c.resume() == null
    print("{a} {b} {dead} {join(xs)}")
}

@test(output = "true 2,2,")
fn a_global_vector_shrunk_by_a_call_still_raises() {
    SHARED.clear()
    SHARED.push(1)
    SHARED.push(1)
    SHARED.push(1)
    let failed = try_call(() => {
        for i in 0..SHARED.len() {
            SHARED[i] = 2
            drop_last()
        }
    })
    print("{failed} {join(SHARED)}")
}

global SHARED: [int] = []
fn drop_last() { if SHARED.len() == 3 { SHARED.pop() } }

// --- Calls the compiler proves harmless, and the writes it must still see.

struct Counter { n: int }
fn bump(c: Counter) -> int { c.n = c.n + 1; return c.n }

@test(output = "1,2,3, 3")
fn a_callee_writing_another_field_keeps_the_loop_running_raw() {
    let xs = [0, 0, 0]
    let c = Counter { n: 0 }
    for i in 0..xs.len() { xs[i] = bump(c) }
    print("{join(xs)} {c.n}")
}

fn swap_items(b: Bag) -> int { b.items = [7]; return 0 }

@test(output = "true 7, 0,0,")
fn a_callee_rebinding_the_vector_field_still_raises() {
    let first = [0, 0]
    let b = Bag { items: first }
    let failed = try_call(() => {
        for i in 0..b.items.len() {
            b.items[i] = swap_items(b)
        }
    })
    print("{failed} {join(b.items)} {join(first)}")
}

fn total(xs: [int]) -> int {
    let t = 0
    for x in xs { t += x }
    return t
}

@test(output = "6,6,6,")
fn a_read_only_callee_over_the_same_vector_keeps_the_proof() {
    let xs = [1, 2, 3]
    let sums: [int] = [0, 0, 0]
    for i in 0..sums.len() { sums[i] = total(xs) }
    print(join(sums))
}

fn collect(out: [int], v: int) -> int { out.push(v); return out.len() }

@test(output = "1,2,3, 0,1,2,")
fn a_callee_that_only_pushes_elsewhere_keeps_the_proof() {
    let xs = [0, 0, 0]
    let out: [int] = []
    for i in 0..xs.len() { xs[i] = collect(out, i) }
    print("{join(xs)} {join(out)}")
}
