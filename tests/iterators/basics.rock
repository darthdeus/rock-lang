// Iterator tests - migrated from rock/tests/iterator_tests.rs
// Tests basic iteration patterns with arrays and vectors

@test(output = "3")
fn loop_basic_break() {
    let arr = [10, 20, 30]
    let total = 0
    let index_sum = 0

    for (i, value) in enumerate(arr) {
        total += value
        index_sum += i
    }

    assert_eq(total, 60)    // 10 + 20 + 30
    assert_eq(index_sum, 3) // 0 + 1 + 2 (0-based indexing)
    print(index_sum)
}

@test(output = "45\n3")
fn array_literal_iter_with_i() {
    let total = 0
    let index_sum = 0

    // Array literals with tuple destructuring give (index, value) with 0-based indexing
    for (i, value) in enumerate([5, 15, 25]) {
        total += value
        index_sum += i
    }

    print(total)    // 5 + 15 + 25
    print(index_sum) // 0 + 1 + 2 (0-based indexing)
}

@test(output = "45\n6")
fn array_literal_iter_with_i_workaround() {
    let total = 0
    let index_sum = 0

    // TODO: Tuple destructuring in for loops needs work
    // For now, use manual indexing with a counter (1-based to match expected output)
    let i = 1
    for value in [5, 15, 25] {
        total += value
        index_sum += i
        i = i + 1
    }

    print(total)    // 5 + 15 + 25
    print(index_sum) // 1 + 2 + 3 (1-based indexing)
}

@test(output = "45\n3", type_holes = [[0, "int"]])
fn array_literal_iter_without_i() {
    let total = 0
    let count = 0

    // Array literals with tuple destructuring give (index, value) with 1-based indexing
    for value in [5, 15, 25] {
        let value_typed: ? = value  // [0] - Should be int
        total += value
        count += 1
    }

    print(total)    // 5 + 15 + 25
    print(count)    // 3
}

@test(output = "9\n8\n7\n6\n5\n4\n3\n2\n1\n0")
fn rev_range() {
    for i in rev(0..10) {
        print(i)
    }
}

@test(output = "30\n20\n10")
fn rev_vec() {
    let v = [10, 20, 30]
    for x in rev(v) {
        print(x)
    }
}

@test(output = "0:2\n1:1\n2:0")
fn rev_with_enumerate() {
    for (i, x) in enumerate(rev(0..3)) {
        print("{i}:{x}")
    }
}

@test(output = "2:2\n1:1\n0:0")
fn rev_of_enumerate() {
    // `rev` is eager-Vec-only, so the lazy `enumerate` collects first.
    for (i, x) in rev(enumerate(0..3).collect()) {
        print("{i}:{x}")
    }
}
