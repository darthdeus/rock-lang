// Iterator terminal ops (collect, reduce, find, any, all, min_by, max_by) over
// `I: Iterator<T>`, on vectors, user iterators and through bounded generic
// forwarders. tests/iterators/combinators.rock covers the intermediate ops.

struct Countup {
    to: int,
}

struct CountupIter {
    cur: int,
    to: int,
}

fn iter(c: Countup) -> CountupIter {
    return CountupIter { cur: 0, to: c.to }
}

fn next(it: CountupIter) -> (bool, int) {
    if it.cur >= it.to { return (false, 0) }
    let v = it.cur
    it.cur = it.cur + 1
    return (true, v)
}

@test
fn collect_map_filter_chain() {
    let v = [1, 2, 3, 4, 5, 6]
    let r = v.iter().filter(x => x % 2 == 0).map(x => x * 10).collect()
    assert_eq(r.len, 3)
    assert_eq(r[0], 20)
    assert_eq(r[1], 40)
    assert_eq(r[2], 60)
}

@test
fn reduce_over_chain() {
    let v = [1, 2, 3, 4]
    let sum = v.iter().map(x => x * 2).reduce(0, (acc, x) => acc + x)
    assert_eq(sum, 20)
    let concat = ["a", "b", "c"].iter().reduce("", (acc, s) => acc + s)
    assert_eq(concat, "abc")
}

@test
fn find_hit_and_miss() {
    let v = [1, 2, 3, 4]
    let hit = v.iter().find(x => x > 2)
    assert(hit != null)
    if hit != null { assert_eq(hit, 3) }
    let miss = v.iter().find(x => x > 100)
    assert(miss == null)
}

@test
fn find_tuple_element_result() {
    let ps = [(1, "a"), (2, "b"), (3, "c")]
    let r = ps.iter().find(p => p.0 == 2)
    assert(r != null)
    if r != null {
        assert_eq(r.1, "b")
    }
}

@test
fn any_all_semantics() {
    let v = [2, 4, 6]
    assert(v.iter().any(x => x > 5))
    assert(!v.iter().any(x => x > 6))
    assert(v.iter().all(x => x % 2 == 0))
    assert(!v.iter().all(x => x > 2))
}

@test
fn any_all_empty_iterator() {
    let v: [int] = []
    assert(!v.iter().any(x => true))
    assert(v.iter().all(x => false))
}

@test
fn any_short_circuits() {
    let v = [1, 2, 3, 4]
    let calls = 0
    let hit = v.iter().any(x => {
        calls += 1
        return x == 2
    })
    assert(hit)
    assert_eq(calls, 2)
}

@test
fn terminals_on_user_iterator() {
    let c = Countup { to: 5 }
    let sum = c.iter().reduce(0, (acc, x) => acc + x)
    assert_eq(sum, 10)
    assert(c.iter().any(x => x == 4))
    assert(c.iter().all(x => x < 5))
    let evens = c.iter().filter(x => x % 2 == 0).collect()
    assert_eq(evens.len, 3)
}

@test
fn collect_after_take_while() {
    let v = [1, 2, 3, 10, 4]
    let r = v.iter().take_while(x => x < 5).collect()
    assert_eq(r.len, 3)
    assert_eq(r[2], 3)
}

// min_by/max_by at a nullable element type: an absent element is a legal
// element, never the "nothing seen yet" state, so it wins or loses its key
// comparison like any other.
value BV { x: float, y: float }

fn ki(v: int?) -> float {
    if v != null { return v as float }
    return 100.0
}

@test(returns = 100)
fn max_by_over_a_nullable_element() -> int {
    // The absent row has the LARGEST key here, so a sentinel collision and a
    // correct answer cannot agree: `null` must win.
    let a: [int?] = [3, null, 1, 2]
    return ki(a.max_by(ki)) as int
}

// The absent row is LAST, so "returns the last element" and "returns the
// keyed extreme" differ in the opposite direction from the tests above.
@test(returns = 1)
fn absent_last_still_finds_the_min() -> int {
    let a: [int?] = [3, 1, 2, null]
    return ki(a.min_by(ki)) as int
}

// Controls: non-nullable elements.

@test(returns = 1)
fn min_by_over_a_flat_element() -> int {
    let a: [int] = [3, 1, 2]
    return a.min_by(_ as float) ?? -1
}

@test(returns = 1)
fn min_by_over_a_flat_value_element() -> int {
    let a: [BV] = [BV { x: 3.0, y: 0.0 }, BV { x: 1.0, y: 0.0 }]
    return (a.min_by(_.x)?.x ?? -1.0) as int
}

// An empty source still returns null.
@test(returns = 1)
fn empty_source_returns_null() -> int {
    let a: [int?] = []
    return if a.min_by(ki) == null && a.max_by(ki) == null { 1 } else { 0 }
}

fn fwd_reduce<I: Iterator<int>>(it: I) -> int {
    return it.reduce(0, (acc, x) => acc + x)
}

fn fwd_any<I: Iterator<int>>(it: I) -> bool {
    return it.any(x => x > 2)
}

fn fwd_all<I: Iterator<int>>(it: I) -> bool {
    return it.all(x => x > 0)
}

fn fwd_find<I: Iterator<int>>(it: I) -> int {
    let r = it.find(x => x > 1)
    return r ?? -1
}

fn fwd_chained<I: Iterator<int>>(it: I) -> int {
    return it.skip(1).reduce(0, (acc, x) => acc + x)
}

// Capturing lambda: the closure reads the forwarding fn's own param.
fn fwd_capture<I: Iterator<int>>(it: I, floor: int) -> int {
    return it.reduce(0, (acc, x) => acc + (if x > floor { x } else { 0 }))
}

@test
fn test_fwd_reduce() {
    assert(fwd_reduce([1, 2, 3].iter()) == 6, "reduce through a bounded forwarder")
}

@test
fn test_fwd_any_all() {
    assert(fwd_any([1, 2, 3].iter()), "any through a bounded forwarder")
    assert(!fwd_any([1, 2].iter()), "any: no element passes")
    assert(fwd_all([1, 2, 3].iter()), "all through a bounded forwarder")
    assert(!fwd_all([0, 2].iter()), "all: zero fails the pred")
}

@test
fn test_fwd_find() {
    assert(fwd_find([1, 2, 3].iter()) == 2, "find through a bounded forwarder")
    assert(fwd_find([1].iter()) == -1, "find miss coalesces")
}

@test
fn test_fwd_chained_combinator() {
    assert(fwd_chained([1, 2, 3].iter()) == 5, "skip(1) then reduce")
}

@test
fn test_fwd_capturing_lambda() {
    assert(fwd_capture([1, 2, 3, 4].iter(), 2) == 7, "closure capturing the outer param")
}

fn total<I: Iterator<int>>(it: I) -> int {
    let s = 0
    for v in it { s = s + v }
    return s
}

fn tally<I: Iterator<string>>(it: I) -> int {
    let n = 0
    for _v in it { n = n + 1 }
    return n
}

@test(output = "6 2")
fn a_bounded_body_answers_each_instantiation() {
    let xs: [int] = [1, 2, 3]
    let ys: [string] = ["a", "b"]
    print("{total(xs.iter())} {tally(ys.iter())}")
}

// A non-generic `next` witness (`CharsIter.next`) reached through a generic
// combinator has no instantiation key; an empty key would name a
// specialization nothing defines.
@test(output = "5")
fn a_non_generic_witness_runs_through_a_generic_combinator() {
    print("{"hello".chars().count()}")
}
