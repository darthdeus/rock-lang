
@test(output = "45\n3", type_holes = [[0, "int"]])
fn array_literal_iter_without_i() {
    let total = 0
    let count = 0

    for value in [5, 15, 25] {
        let value_typed: ? = value
        total += value
        count += 1
    }

    print(total)
    print(count)
}

@test(output = "9\n8\n7\n6\n5\n4\n3\n2\n1\n0")
fn rev_range() {
    for i in rev(0..10) {
        print(i)
    }
}

@test(output = "30\n20\n10\nc\nb\na")
fn rev_vec() {
    let v = [10, 20, 30]
    for x in rev(v) {
        print(x)
    }
    let xs = ["a", "b", "c"]
    for s in rev(xs) {
        print("{s}")
    }
}

@test(output = "0:2\n1:1\n2:0")
fn rev_with_enumerate() {
    for (i, x) in enumerate(rev(0..3)) {
        print("{i}:{x}")
    }
}

@test(output = "2:2\n1:1\n0:0")
fn rev_of_enumerate() {
    // `rev` is eager-Vec-only, so the lazy `enumerate` collects first.
    for (i, x) in rev(enumerate(0..3).collect()) {
        print("{i}:{x}")
    }
}


struct PlayerStats {
    health: int,
    mana: int,
    level: int,
}

@test
fn test_map_struct_values() {
    let players: Map<string, PlayerStats> = map_new()

    insert(players, "warrior", PlayerStats { health: 100, mana: 20, level: 5 })
    insert(players, "mage", PlayerStats { health: 60, mana: 100, level: 7 })
    insert(players, "rogue", PlayerStats { health: 80, mana: 40, level: 6 })

    let total_health = 0
    let total_mana = 0
    let total_levels = 0
    let count = 0

    for (name, stats) in players {
        total_health = total_health + stats.health
        total_mana = total_mana + stats.mana
        total_levels = total_levels + stats.level
        count = count + 1

        assert stats.health > 0
        assert stats.mana >= 0
        assert stats.level > 0
    }

    assert total_health == 240
    assert total_mana == 160
    assert total_levels == 18
    assert count == 3
}

@test
fn test_empty_collections() {
    let empty_array: [int] = []
    let empty_map: Map<string, int> = map_new()

    let array_iterations = 0
    let map_iterations = 0

    for item in empty_array {
        array_iterations = array_iterations + 1
        error("Should not iterate over empty array")
    }

    for (key, value) in empty_map {
        map_iterations = map_iterations + 1
        error("Should not iterate over empty map")
    }

    assert array_iterations == 0
    assert map_iterations == 0
}

@test
fn test_nested_for_in_loops() {
    let groups: Map<string, [int]> = map_new()
    insert(groups, "odds", [1, 3, 5])
    insert(groups, "evens", [2, 4, 6])

    let total_sum = 0
    let group_count = 0
    let item_count = 0

    for (group_name, numbers) in groups {
        group_count = group_count + 1

        for num in numbers {
            item_count = item_count + 1
            total_sum = total_sum + num
        }
    }

    assert total_sum == 21
    assert group_count == 2
    assert item_count == 6
}

@test
fn test_for_in_type_inference() {
    let mixed_map: Map<string, int> = map_new()
    insert(mixed_map, "first", 42)
    insert(mixed_map, "second", 99)

    let key_lengths = 0
    let value_sum = 0

    for (key, value) in mixed_map {
        key_lengths = key_lengths + key.len()

        value_sum = value_sum + value * 2
    }

    assert key_lengths == 11
    assert value_sum == 282
}


@test
fn test_simple_identifier_gets_iter() {
    let arena = arena_new()
    insert(arena, 42)
    insert(arena, 100)

    let count = 0

    for item in arena {
        count += 1
    }

    assert_eq(count, 2)
}

@test
fn test_map_iteration_with_auto_iter() {
    let map = map_new()
    insert(map, "a", 1)
    insert(map, "b", 2)

    let count = 0

    for item in map {
        count += 1
    }

    assert_eq(count, 2)
}



struct Item {
    name: string,
    value: int,
}

@test(output = "sword:10 shield:5 0:sword 1:shield")
fn test_struct_vec_iteration() {
    let items = [
        Item { name: "sword", value: 10 },
        Item { name: "shield", value: 5 },
    ]
    let out = ""
    for item in items {
        out = out + "{item.name}:{item.value} "
    }
    for (i, item) in enumerate(items) {
        out = out + "{i}:{item.name} "
    }
    print(out.trim())
}
