// An `Iterator`-bounded body is emitted standalone at each instantiation, so
// two element types resolve the placeholder `next` separately.

fn total<I: Iterator<int>>(it: I) -> int {
    let s = 0
    for v in it { s = s + v }
    return s
}

fn tally<I: Iterator<string>>(it: I) -> int {
    let n = 0
    for _v in it { n = n + 1 }
    return n
}

@test(output = "6 2")
fn a_bounded_body_answers_each_instantiation() {
    let xs: [int] = [1, 2, 3]
    let ys: [string] = ["a", "b"]
    print("{total(xs.iter())} {tally(ys.iter())}")
}

// A non-generic `next` witness (`CharsIter.next`) reached through a generic
// combinator has no instantiation key; an empty key would name a
// specialization nothing defines.
@test(output = "5")
fn a_non_generic_witness_runs_through_a_generic_combinator() {
    print("{"hello".chars().count()}")
}
