// What a loop over a vector does when its body changes that vector, and the
// loop shapes around it. The length is read once before the first turn and
// each element is read, bounds-checked against the live length, when its turn
// comes: appended elements are not visited, a write to a later slot is seen,
// and a turn whose slot is gone raises the out-of-bounds error. A vector the
// body swaps in is not walked; the loop keeps the one it started on.

@intrinsic @nomangle inline(lua) fn loop_error(f: fn()) -> string = """
    local ok, err = pcall(f)
    if ok then return "ok" end
    return (tostring(err):gsub("^.-: ", ""))
"""

struct Bag { items: [int] }

@test(output = "1,2,3, len 5")
fn pushed_elements_are_not_visited() {
    let xs = [1, 2, 3]
    let out = ""
    for x in xs {
        if x < 3 { xs.push(x + 10) }
        out = out + "{x},"
    }
    print("{out} len {xs.len()}")
}

@test(output = "0:1,1:2,2:3,")
fn enumerate_does_not_visit_pushed_elements() {
    let xs = [1, 2, 3]
    let out = ""
    for (i, x) in enumerate(xs) {
        if i == 0 { xs.push(50) }
        out = out + "{i}:{x},"
    }
    print(out)
}

@test(output = "1,2,99,")
fn a_store_to_a_later_slot_is_seen() {
    let xs = [1, 2, 3]
    let out = ""
    for x in xs {
        xs[2] = 99
        out = out + "{x},"
    }
    print(out)
}

@test(output = "1,2, Vec index out of bounds: index 2 is outside [0, 2)")
fn popped_slot_raises_out_of_bounds() {
    let xs = [1, 2, 3, 4]
    let out = ""
    let err = loop_error(() => {
        for x in xs {
            if x == 1 {
                xs.pop()
                xs.pop()
            }
            out = out + "{x},"
        }
    })
    print("{out} {err}")
}

@test(output = "1,2,4, Vec index out of bounds: index 3 is outside [0, 3)")
fn removal_shifts_then_raises_out_of_bounds() {
    let xs = [1, 2, 3, 4]
    let out = ""
    let err = loop_error(() => {
        for x in xs {
            if x == 2 { xs.remove_at(0) }
            out = out + "{x},"
        }
    })
    print("{out} {err}")
}

@test(output = "1, Vec index out of bounds: index 1 is outside [0, 0)")
fn clearing_raises_out_of_bounds_on_the_next_turn() {
    let xs = [1, 2, 3]
    let out = ""
    let err = loop_error(() => {
        for x in xs {
            out = out + "{x},"
            xs.clear()
        }
    })
    print("{out} {err}")
}

@test(output = "a,b, Vec index out of bounds: index 2 is outside [0, 2)")
fn popped_string_slot_raises_out_of_bounds() {
    let xs = ["a", "b", "c"]
    let out = ""
    let err = loop_error(() => {
        for x in xs {
            if x == "a" { xs.pop() }
            out = out + "{x},"
        }
    })
    print("{out} {err}")
}

@test(output = "1,2,3, now 7")
fn replaced_field_keeps_walking_the_original() {
    let b = Bag { items: [1, 2, 3] }
    let out = ""
    for x in b.items {
        b.items = [7, 8, 9, 10, 11]
        out = out + "{x},"
    }
    print("{out} now {b.items[0]}")
}

@test(output = "1,2,3, now 5")
fn rebound_variable_keeps_walking_the_original() {
    let xs = [1, 2, 3]
    let out = ""
    for x in xs {
        xs = [7, 8, 9, 10, 11]
        out = out + "{x},"
    }
    print("{out} now {xs.len()}")
}

@test(output = "0,1, Vec index out of bounds: index 2 is outside [0, 2)")
fn range_over_a_stale_length_raises_out_of_bounds() {
    let xs = [0, 1, 2]
    let out = ""
    let err = loop_error(() => {
        for i in 0..xs.len() {
            if i == 0 { xs.pop() }
            out = out + "{xs[i]},"
        }
    })
    print("{out} {err}")
}

// Elements that are false or null read the same as any other.

@test(output = "true,false,false,true, 2")
fn false_elements_are_visited() {
    let xs = [true, false, false, true]
    let out = ""
    let falses = 0
    for x in xs {
        if !x { falses += 1 }
        out = out + "{x},"
    }
    print("{out} {falses}")
}

@test(output = "1,-,3,-, 2")
fn null_elements_are_visited() {
    let xs: [int?] = [1, null, 3, null]
    let out = ""
    let nulls = 0
    for x in xs {
        if let v = x {
            out = out + "{v},"
        } else {
            nulls += 1
            out = out + "-,"
        }
    }
    print("{out} {nulls}")
}

@test(output = "false null 7 Vec index out of bounds: index 3 is outside [0, 3)")
fn indexing_false_and_null_slots() {
    let flags = [true, false, true]
    let maybe: [int?] = [null, 7, null]
    let first = maybe[0]
    let shown = if first == null { "null" } else { "set" }
    let err = loop_error(() => { let _ = flags[3] })
    print("{flags[1]} {shown} {maybe[1] ?? -1} {err}")
}

@test(output = "Vec index out of bounds: index -1 is outside [0, 2)")
fn negative_index_raises_out_of_bounds() {
    let xs = [5, 6]
    let i = 0
    print(loop_error(() => { let _ = xs[i - 1] }))
}

// Loop shapes.

@test(output = "0 none")
fn empty_vector_runs_no_turn() {
    let xs: [int] = []
    let n = 0
    let last = "none"
    for x in xs {
        n += 1
        last = "{x}"
    }
    print("{n} {last}")
}

@test(output = "11,12,21,22,31,32, 6")
fn nested_loops_over_two_vectors() {
    let rows = [10, 20, 30]
    let cols = [1, 2]
    let out = ""
    let n = 0
    for r in rows {
        for c in cols {
            out = out + "{r + c},"
            n += 1
        }
    }
    print("{out} {n}")
}

@test(output = "1,2,1,2,3,4, 3")
fn nested_loops_over_a_vector_of_vectors() {
    let grid = [[1, 2], [], [1, 2, 3, 4]]
    let out = ""
    let rows = 0
    for row in grid {
        rows += 1
        for x in row { out = out + "{x}," }
    }
    print("{out} {rows}")
}

@test(output = "11,12,21,22, 4")
fn nested_loops_over_the_same_vector() {
    let xs = [1, 2]
    let out = ""
    let n = 0
    for a in xs {
        for b in xs {
            out = out + "{a * 10 + b},"
            n += 1
        }
    }
    print("{out} {n}")
}

@test(output = "1,3,5, stopped at 6")
fn break_and_continue() {
    let xs = [1, 2, 3, 4, 5, 6, 7]
    let out = ""
    let stopped = 0
    for x in xs {
        if x == 6 {
            stopped = x
            break
        }
        if x % 2 == 0 { continue }
        out = out + "{x},"
    }
    print("{out} stopped at {stopped}")
}

@test(output = "a1,a2,b1,b2, 2")
fn break_leaves_only_the_inner_loop() {
    let outer = ["a", "b"]
    let inner = [1, 2, 3]
    let out = ""
    let breaks = 0
    for o in outer {
        for i in inner {
            if i == 3 {
                breaks += 1
                break
            }
            out = out + "{o}{i},"
        }
    }
    print("{out} {breaks}")
}

@test(output = "10 20 30")
fn closures_capture_each_turns_element() {
    let xs = [1, 2, 3]
    let fs: [fn() -> int] = []
    for x in xs {
        fs.push(() => x * 10)
    }
    print("{fs[0]()} {fs[1]()} {fs[2]()}")
}

@test(output = "0:a 1:b 2:c")
fn closures_capture_each_turns_index_and_element() {
    let xs = ["a", "b", "c"]
    let fs: [fn() -> string] = []
    for (i, x) in enumerate(xs) {
        fs.push(() => "{i}:{x}")
    }
    print("{fs[0]()} {fs[1]()} {fs[2]()}")
}

@test(output = "6 3")
fn a_closure_called_in_the_body_reads_the_element() {
    let xs = [1, 2, 3]
    let total = 0
    let calls = 0
    for x in xs {
        let add = () => {
            total += x
            calls += 1
        }
        add()
    }
    print("{total} {calls}")
}

// `push` evaluates its argument before it grows the vector.

fn grow_and_report(xs: [int]) -> int {
    xs.push(100)
    return xs.len()
}

@test(output = "3,5,5,100,7, 8")
fn push_argument_is_evaluated_before_the_append() {
    let xs = [1, 2, 3]
    xs.push(xs.len())
    xs.push(xs[0] + xs.len())
    xs.push(xs[xs.len() - 1])
    xs.push(grow_and_report(xs))
    let out = ""
    for i in 3..xs.len() { out = out + "{xs[i]}," }
    print("{out} {xs.len()}")
}

struct Pair { a: int, b: [int] }

@test(output = "2 0 1 5")
fn push_argument_built_from_the_vector_it_extends() {
    let ps: [Pair] = []
    ps.push(Pair { a: ps.len(), b: [] })
    ps.push(Pair { a: ps.len(), b: [ps[0].a] })
    ps[1].b.push(ps[1].b.len() + 4)
    print("{ps.len()} {ps[0].a} {ps[1].a} {ps[1].b[1]}")
}
