// Implicit iterable->iterator coercion: at an `Iterator`-bounded param, an
// argument (incl. a UFCS receiver) that is not itself an iterator but has an
// `iter()` is passed through it automatically -- the same courtesy the `for`
// head has always extended. Explicit `.iter()` stays legal; exact matches
// (concrete overloads, real iterators) always win over the coerced form.

struct Mob {
    name: string,
    health: int,
}

fn sum_it<I: Iterator<int>>(it: I) -> int {
    let total = 0
    for x in it {
        total += x
    }
    return total
}

@test
fn terminals_on_vec_directly() {
    let v = [1, 2, 3, 4]
    assert(v.any(_ > 3))
    assert(!v.all(_ > 1))
    let hit = v.find(x => x > 2)
    assert(hit != null)
    if hit != null { assert_eq(hit, 3) }
    assert_eq(v.reduce(0, (acc, x) => acc + x), 10)
    assert_eq(v.collect().len, 4)
}

@test
fn combinators_on_vec_directly() {
    let v = [1, 2, 3, 4, 5, 6]
    let r = v.filter(_ % 2 == 0).map(_ * 10).collect()
    assert_eq(r.len, 3)
    assert_eq(r[0], 20)
    assert_eq(r[2], 60)
}

@test
fn free_call_forms() {
    let v = [1, 2, 3]
    assert(any(v, _ > 2))
    let doubled = collect(map(v, _ * 2))
    assert_eq(doubled[2], 6)
}

@test
fn user_bounded_fn_takes_iterable() {
    let v = [1, 2, 3, 4]
    assert_eq(sum_it(v), 10)
    assert_eq(sum_it(v.iter()), 10)
    assert_eq(sum_it(v.map(x => x * 2)), 20)
}

@test
fn zip_coerces_both_args() {
    let xs = [1, 2, 3]
    let ys = [10, 20, 30]
    let total = 0
    for (a, b) in zip(xs, ys) {
        total += a + b
    }
    assert_eq(total, 66)
    assert(xs.zip(ys).any(p => p.0 == 2 && p.1 == 20))
}

// The eager `Vec<T>.enumerate` is deleted, so a vec receiver now COERCES to the
// iterator overload and the result is lazy -- `.collect()` is how a caller asks
// for the materialized `[(int, T)]`.
@test
fn enumerate_on_vec_is_lazy() {
    let v = [10, 20, 30]
    let e = enumerate(v).collect()
    assert_eq(e.len, 3)
    assert_eq(e[1].1, 20)
}

// The RULE this file exists for is unchanged -- a concrete overload still
// outranks the coerced fit. `Map` keeps its eager `enumerate`, so this one
// resolves to the concrete overload and yields an indexable vec, not an iter.
@test
fn a_concrete_overload_still_outranks_the_coerced_fit() {
    let m: Map<string, int> = map_new()
    m["one"] = 1
    let e = enumerate(m)
    assert_eq(e.len, 1)
    assert_eq(e[0].1.0, "one")
}

@test
fn arena_coerces_to_pairs() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "rat", health: 10 })
    mobs.insert(Mob { name: "boss", health: 100 })
    let strong = mobs.filter(_.1.health >= 100).collect()
    assert_eq(strong.len, 1)
    let hit = mobs.find(_.1.name == "boss")
    assert(hit != null)
    if hit != null {
        assert_eq(hit.1.health, 100)
    }
}

@test
fn explicit_iter_unchanged() {
    let v = [1, 2, 3]
    assert_eq(v.iter().map(x => x * 2).reduce(0, (a, x) => a + x), 12)
}

@test
fn lazy_binding_then_for() {
    let v = [1, 2, 3]
    let it = v.map(_ * 2)
    let total = 0
    for x in it {
        total += x
    }
    assert_eq(total, 12)
}

@test
fn coerced_chain_in_string_interp() {
    let v = [1, 2, 3]
    let msg = "has_big={v.any(_ > 2)}"
    assert_eq(msg, "has_big=true")
}

// flat_map: the receiver coerces like any `Iterator`-bounded argument, for
// non-nullable, nullable and nobox elements alike, against the explicit-iter
// control. The callback's RESULT is not an argument and does not coerce:
// `[1, 2].flat_map(n => [n, n])` is rejected for every element kind (see
// tests/errors/flat_map_callback_result_not_coerced.rock.err).
nobox value FmV2 { x: float, y: float }

fn fm_pair(n: int) -> VecIter<int> { return [n, n].iter() }
fn fm_pair_opt(n: int?) -> VecIter<int?> { return [n, n].iter() }
fn fm_pair_v2(v: FmV2) -> VecIter<FmV2> { return [v, v].iter() }

@test
fn flat_map_explicit_iter_control() {
    assert_eq([1, 2, 3].iter().flat_map(fm_pair).count(), 6)
}

@test
fn flat_map_coerced_receiver() {
    assert_eq([1, 2, 3].flat_map(fm_pair).count(), 6)
}

@test
fn flat_map_coerced_receiver_nullable_elements() {
    let a: [int?] = [1, null, 3]
    assert_eq(a.flat_map(fm_pair_opt).count(), 6)
    assert_eq(a.flat_map(fm_pair_opt).filter(x => x == null).count(), 2)
}

@test
fn flat_map_coerced_receiver_nobox_elements() {
    let a = [FmV2 { x: 1.0, y: 2.0 }, FmV2 { x: 3.0, y: 4.0 }]
    assert_eq(a.flat_map(fm_pair_v2).map(v => v.y).sum_f(), 12.0)
}
