// Manual iterator protocol and float ranges.

struct ManualVecIter<T> {
    vec: [T],
    i: int,
}

fn manual_iter<T>(v: [T]) -> ManualVecIter<T> {
    return ManualVecIter { vec: v, i: 0 }
}

fn manual_next<T>(it: ManualVecIter<T>) -> (bool, T) {
    if it.i >= it.vec.len {
        return (false, phantom())
    }
    let x = it.vec[it.i]
    it.i = it.i + 1
    return (true, x)
}

@test
fn manual_protocol_sums_vec() {
    let v = [10, 20, 30]
    let it = manual_iter(v)
    let total = 0
    loop {
        let (ok, x) = manual_next(it)
        if !ok { break }
        total += x
    }
    assert_eq(total, 60)
}

@test
fn manual_protocol_empty_vec() {
    let v: [int] = []
    let it = manual_iter(v)
    let count = 0
    loop {
        let (ok, x) = manual_next(it)
        if !ok { break }
        count += 1
    }
    assert_eq(count, 0)
}

@test
fn manual_protocol_string_elems() {
    let v = ["a", "b", "c"]
    let it = manual_iter(v)
    let joined = ""
    loop {
        let (ok, x) = manual_next(it)
        if !ok { break }
        joined += x
    }
    assert_eq(joined, "abc")
}

@test
fn test_linspace() {
    // Evenly spaced from start to end inclusive.
    assert_eq(linspace(0.0, 1.0, 5), [0.0, 0.25, 0.5, 0.75, 1.0])
    assert_eq(linspace(0.0, 1.0, 2), [0.0, 1.0])
    assert_eq(linspace(0.0, 1.0, 1), [0.0])
    assert_eq(linspace(0.0, 1.0, 0).len, 0)
    assert_eq(linspace(-1.0, 1.0, 5), [-1.0, -0.5, 0.0, 0.5, 1.0])
}

@test
fn test_float_range() {
    // The end is excluded.
    assert_eq(float_range(0.0, 1.0, 0.25), [0.0, 0.25, 0.5, 0.75])
    assert_eq(float_range(0.0, 1.0, 0.5), [0.0, 0.5])
    assert_eq(float_range(0.0, 1.0, 2.0), [0.0])
    assert_eq(float_range(10.0, 0.0, -3.0), [10.0, 7.0, 4.0, 1.0])
    // Empty: start == end, zero step, step pointing away from the end.
    assert_eq(float_range(0.0, 0.0, 0.1).len, 0)
    assert_eq(float_range(0.0, 1.0, 0.0).len, 0)
    assert_eq(float_range(0.0, 1.0, -0.5).len, 0)
}
