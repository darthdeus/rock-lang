// Sentinel: ANF const-hoist for non-nullable value-struct literals
// at cdata-ABI position. Pre-fix, ANF only hoisted Nullable(value)
// shapes; non-nullable repeated literals re-packed per call. This
// pins the closed gap: a constant `V2 { x, y }` literal at a
// @nomangle / inline-lua / unmangled cdata-ABI slot interns once
// per module via `__rock_const_<Name>_<hash>`.

value V2 { x: int, y: int }

@nomangle
fn sum_v2(v: V2) -> int { v.x + v.y }

@test(output = "21")
fn anf_const_hoist_first_call() {
    print(sum_v2(V2 { x: 10, y: 11 }))
}

@test(output = "21")
fn anf_const_hoist_second_call_dedupes() {
    // Same literal as above — must share the same __rock_const_*.
    // Functional check is the value (21); the dedup invariant is
    // architectural and pinned by the doc here.
    print(sum_v2(V2 { x: 10, y: 11 }))
}

@test(output = "42")
fn anf_const_hoist_distinct_literals_distinct_locals() {
    // Distinct field values — distinct __rock_const_* locals.
    // Content-hash dedup is per-(struct_name, parts).
    print(sum_v2(V2 { x: 20, y: 22 }))
}

@test(output = "5")
fn anf_const_hoist_dynamic_field_no_hoist() {
    // Dynamic field expression — no hoist, per-call pack.
    // This still works; the test pins that dynamic shapes don't
    // crash through the hoist path.
    let n = 2
    print(sum_v2(V2 { x: n, y: 3 }))
}
