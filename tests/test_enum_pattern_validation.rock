// Test that enum type names in patterns are properly validated

enum Color {
    Red(int),
    Blue(string),
    Green(bool)
}

@test
fn test_valid_enum_pattern() {
    let color = Color::Red(255)
    
    match color {
        Color::Red(value) => {
            assert_eq(value, 255)
        },
        Color::Blue(name) => {
            assert_eq(name, "blue")
        },
        Color::Green(enabled) => {
            assert_eq(enabled, true)
        }
    }
}

// This test ensures that the compiler properly validates enum type names
// The following patterns should all compile successfully since they use the correct enum name
@test
fn test_enum_name_validation() {
    let color = Color::Blue("sky")
    
    match color {
        Color::Blue(name) => {
            assert_eq(name, "sky")
        },
        _ => {
            // This should not be reached
        }
    }
}

fn main() {
    print("Enum pattern validation test")
}