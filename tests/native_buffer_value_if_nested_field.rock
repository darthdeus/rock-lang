// Adversarial: nested-value field RHS is an `if` expression returning
// a value struct. `generate_expr_emit` for an If wrapping a
// StructLiteral / call... should still wind up packed via
// emit_value_arg_cdata in the leaf store path.

@intrinsic @inline inline(lua) fn put(s: string) = "io.write(s)"

value V2 {
    x: float,
    y: float,
}

value Pair {
    first: V2,
    second: V2,
}

@nomangle inline(lua) fn __nb_alloc_Pair(n: int) -> Ptr<Pair> = 'return ffi.new("Pair[?]", n)'

fn nb_pair(n: int) -> NativeBuffer<Pair> {
    return NativeBuffer { ptr: __nb_alloc_Pair(n), len: n }
}

@test(output = "f.x=1\nf.y=2\ns.x=99\ns.y=99")
fn test_if_nested_value_field() {
    let buf = nb_pair(1)
    let cond = true
    buf[0] = Pair {
        first: if cond { V2 { x: 1.0, y: 2.0 } } else { V2 { x: 0.0, y: 0.0 } },
        second: if cond { V2 { x: 99.0, y: 99.0 } } else { V2 { x: 0.0, y: 0.0 } },
    }
    let r = buf[0]
    put("f.x=")
    put("{r.first.x}")
    put("\n")
    put("f.y=")
    put("{r.first.y}")
    put("\n")
    put("s.x=")
    put("{r.second.x}")
    put("\n")
    put("s.y=")
    put("{r.second.y}")
    put("\n")
}
