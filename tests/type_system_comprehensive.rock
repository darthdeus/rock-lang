// Comprehensive type system tests - migrated from rock/tests/type_system_tests.rs
// Tests default arguments, struct types, overloading, null promotion, inference, and semantics

// ============================================
// Helper structures and functions
// ============================================

struct Point {
    x: int,
    y: int,
}

struct FixVec3 {
    x: float,
    y: float,
    z: float,
}

struct Container<T> {
    value: T,
}

struct Person {
    name: string,
    age: int,
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

enum Status {
    Active,
    Inactive,
    Pending,
}

// ============================================
// Default Argument Tests
// ============================================

@test(output = "5\n10")
fn default_arg() {
    print(foo())
    print(foo(10))
}

fn foo(x: int = 5) -> int {
    return x
}

@test(output = "3\n7\n11")
fn defaults_multiple() {
    print(add())        // 1 + 2
    print(add(5))       // 5 + 2
    print(add(5, 6))    // 5 + 6
}

fn add(a: int = 1, b: int = 2) -> int { 
    return a + b 
}

@test(output = "hello!\nhi?")
fn defaults_trailing() {
    print(greet("hello"))
    print(greet("hi", "?"))
}

fn greet(name: string, punct: string = "!") -> string { 
    return "{name}{punct}" 
}

@test(output = "3\n6")
fn overload_with_defaults() {
    print(sum(1, 2))        // calls first overload
    print(sum_three(3, 2, 1))    // calls second overload
}

fn sum(x: int, y: int) -> int { 
    return x + y 
}

fn sum_three(x: int, y: int = 1, z: int = 2) -> int { 
    return x + y + z 
}

// ============================================
// Struct Tests
// ============================================

@test(output = "5\n10")
fn struct_basic() {
    let p = Point { x: 5, y: 10 }
    print(p.x)
    print(p.y)
}

@test(output = "3\n6")
fn struct_field_access() {
    let p = Point { x: 3, y: 6 }
    let sum = p.x + p.y
    print(p.x)
    print(sum - p.x)
}

@test(output = "15")
fn struct_method_call() {
    let p = Point { x: 5, y: 10 }
    print(point_sum(p))
}

fn point_sum(p: Point) -> int {
    return p.x + p.y
}

@test(output = "FixVec3(1, 2, 3)")
fn struct_complex() {
    let v = FixVec3 { x: 1.0, y: 2.0, z: 3.0 }
    print(vec3_debug(v))
}

fn vec3_debug(v: FixVec3) -> string {
    return "FixVec3({v.x}, {v.y}, {v.z})"
}

// ============================================
// Generic Tests
// ============================================

@test(output = "42")
fn generic_basic() {
    let container = Container { value: 42 }
    print(get_value(container))
}

fn get_value<T>(c: Container<T>) -> T {
    return c.value
}

@test(output = "hello")
fn generic_string() {
    let container = Container { value: "hello" }
    print(get_value_string(container))
}

fn get_value_string<T>(c: Container<T>) -> T {
    return c.value
}

fn identity<T>(x: T) -> T {
    return x
}

// ============================================
// Null Promotion Tests
// ============================================

@test(output = "42\nnil")
fn null_promotion_basic() {
    let x: int? = 42
    print(x)
    
    let y: int? = null
    print(y)
}

@test(output = "hello\nnil")
fn null_promotion_string() {
    let s: string? = "hello"
    print(s)
    
    let n: string? = null
    print(n)
}

@test(output = "5\nnil")
fn null_promotion_struct() {
    let p_val = Point { x: 5, y: 10 }
    let p: Point? = p_val
    print(p?.x)
    
    let null_p: Point? = null
    print(null_p?.x)
}

// ============================================
// Simple Inference Tests
// ============================================

@test(output = "3.14")
fn inference_float() {
    let f = 3.14  // Should infer float
    print(f)
}

@test(output = "hello")
fn inference_string() {
    let s = "hello"  // Should infer string
    print(s)
}

@test(output = "true")
fn inference_bool() {
    let b = true  // Should infer bool
    print(b)
}

@test(output = "5\n10")
fn inference_tuple() {
    let t = (5, 10)  // Should infer (int, int)
    print(t.0)
    print(t.1)
}

// ============================================
// Array Tests
// ============================================

@test(output = "3")
fn array_length() {
    let arr = [1, 2, 3]
    print(vec_len(arr))
}

@test(output = "20")
fn array_access() {
    let arr = [10, 20, 30]
    print(arr[1])
}

@test(output = "1\n2\n3")
fn array_iteration() {
    let arr = [1, 2, 3]
    for x in arr {
        print(x)
    }
}

@test(output = "6")
fn array_sum() {
    let arr = [1, 2, 3]
    let sum = 0
    for x in arr {
        sum += x
    }
    print(sum)
}

// ============================================
// Global Variable Tests
// ============================================

global GLOBAL_INT: int = 100
global GLOBAL_STRING: string = "global"

@test(output = "100")
fn global_var_access() {
    print(GLOBAL_INT)
}

@test(output = "global")
fn global_string_access() {
    print(GLOBAL_STRING)
}

@test(output = "150")
fn global_var_modification() {
    GLOBAL_INT = 150
    print(GLOBAL_INT)
    GLOBAL_INT = 100  // Reset for other tests
}

// ============================================
// Nullable Tests
// ============================================

@test(output = "42")
fn nullable_unwrap() {
    let x: int? = 42
    print(unwrap(x))
}

@test(output = "0")
fn nullable_unwrap_or() {
    let x: int? = null
    print(unwrap_or(x, 0))
}

@test(output = "5\nnil")
fn nullable_safe_nav() {
    let p_val = Point { x: 5, y: 10 }
    let p: Point? = p_val
    print(p?.x)
    
    let null_p: Point? = null
    print(null_p?.x)
}

@test(output = "nil\n0")
fn nullable_coalesce() {
    let x: int? = null
    let y = x ?? 0
    print(x)
    print(y)
}

// ============================================
// Condition Tests
// ============================================

@test(output = "positive")
fn condition_basic() {
    let x = 5
    if x > 0 {
        print("positive")
    } else {
        print("negative")
    }
}

@test(output = "even")
fn condition_modulo() {
    let x = 4
    if x % 2 == 0 {
        print("even")
    } else {
        print("odd")
    }
}

@test(output = "large")
fn condition_complex() {
    let x = 15
    if x > 10 && x < 20 {
        print("large")
    } else {
        print("small")
    }
}

// ============================================
// Loop Tests
// ============================================

@test(output = "0\n1\n2\n3\n4")
fn loop_for_range() {
    for i in 0..5 {
        print(i)
    }
}

@test(output = "0\n2\n4")
fn loop_while_even() {
    let i = 0
    while i < 6 {
        print(i)
        i += 2
    }
}

@test(output = "3")
fn loop_break() {
    let i = 0
    loop {
        i += 1
        if i == 3 {
            break
        }
    }
    print(i)
}

@test(output = "1\n3\n5")
fn loop_continue() {
    for i in 1..6 {
        if i % 2 == 0 {
            continue
        }
        print(i)
    }
}

// ============================================
// Math Tests
// ============================================

@test(output = "15")
fn math_addition() {
    let result = 5 + 10
    print(result)
}

@test(output = "2.5")
fn math_division() {
    let result = 5.0 / 2.0
    print(result)
}

@test(output = "25")
fn math_multiplication() {
    let result = 5 * 5
    print(result)
}

@test(output = "3")
fn math_modulo() {
    let result = 13 % 5
    print(result)
}

@test(output = "8")
fn math_power() {
    let result = 2 * 2 * 2  // No built-in power operator, simulate 2^3
    print(result)
}

// ============================================
// Semantic Tests
// ============================================

@test(output = "hello world")
fn semantic_string_concat() {
    let greeting = "hello"
    let target = "world"
    print("{greeting} {target}")
}

@test(output = "Person(Alice, 30)")
fn semantic_struct_creation() {
    let person = Person { name: "Alice", age: 30 }
    print(person_debug(person))
}

fn person_debug(p: Person) -> string {
    return "Person({p.name}, {p.age})"
}

@test(output = "15")
fn semantic_function_call() {
    let result = calculate_sum(5, 10)
    print(result)
}

fn calculate_sum(a: int, b: int) -> int {
    return a + b
}

// ============================================
// Enum Tests
// ============================================

@test(output = "Active")
fn enum_basic() {
    let status = Status::Active
    let name = status_to_string(status)
    assert_eq(name, "Active")
    print(name)
}

fn status_to_string(s: Status) -> string {
    let result = match s {
        Status::Active => "Active",
        Status::Inactive => "Inactive",
        Status::Pending => "Pending",
    }
    return result
}

@test(output = "42")
fn enum_with_data() {
    let result = Result::Ok(42)
    match result {
        Result::Ok(value) => print(value),
        Result::Err(_) => print("error"),
    }
}

@test(output = "failed")
fn enum_error_case() {
    let result: Result<int, string> = Result::Err("failed")
    let message = match result {
        Result::Ok(value) => "success",
        Result::Err(_) => "failed",
    }
    print(message)
}
