// Bounds checks on Vec indexing: `xs[i]` read/store error on OOB via
// __vec_checked_get / __vec_checked_set (the __nb_checked_* pattern;
// release stripping is the same future work item as NativeBuffer's).
// `.get(i)` stays the null-returning checked accessor; `.set(i, v)`
// errors on OOB (a silent drop is the swallowed-error class).

@intrinsic @nomangle inline(lua) fn try_call(f: fn()) -> bool = """
    local ok, err = pcall(f)
    return not ok
"""

@test
fn in_bounds_read_store() {
    let xs = [10, 20, 30]
    xs[0] = 11
    xs[2] = 33
    assert(xs[0] == 11)
    assert(xs[1] == 20)
    assert(xs[2] == 33)
}

@test
fn compound_assign_in_bounds() {
    let xs = [1, 2, 3]
    xs[1] += 10
    assert(xs[1] == 12)
}

@test
fn oob_read_errors() {
    let xs = [1, 2, 3]
    assert(try_call(() => { let _ = xs[3] }))
    assert(try_call(() => { let _ = xs[-1] }))
}

@test
fn oob_store_errors() {
    let xs = [1, 2, 3]
    assert(try_call(() => { xs[3] = 9 }))
    assert(try_call(() => { xs[-1] = 9 }))
}

@test
fn get_returns_null_oob() {
    let xs = [1, 2, 3]
    assert(xs.get(3) == null)
    assert(xs.get(-1) == null)
    assert((xs.get(2) ?? -1) == 3)
}

@test
fn set_oob_errors() {
    let xs = [1, 2, 3]
    assert(try_call(() => xs.set(3, 9)))
    xs.set(1, 22)
    assert(xs[1] == 22)
}
