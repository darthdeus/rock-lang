// Small-tail: `for x in rev(e)` — the one call-iterable ANF
// absorbs. stdlib `rev` (inline(lua)) always materializes a
// {data,len} Vec, so iterating its result is a faithful VecLike
// numeric loop (byte-identical to live `local r = rev(e); for
// i=1,r.len do ...`). enumerate/filter/map stay reject-to-live.
// Pins runtime behavior; must pass with and without
// ROCK_ANF_FUNCTIONS=1.

@test(output = "5\n4\n3\n2\n1")
fn test_rev_vec() {
    let xs = [1, 2, 3, 4, 5]
    for x in rev(xs) {
        print("{x}")
    }
}

@test(output = "30")
fn test_rev_sum_with_continue() {
    let xs = [10, 20, 99, 30]
    let total = 0
    for x in rev(xs) {
        if x == 99 {
            continue
        }
        if x == 30 {
            continue
        }
        total = total + x
    }
    print("{total}")
}

@test(output = "c\nb\na")
fn test_rev_strings() {
    let xs = ["a", "b", "c"]
    for s in rev(xs) {
        print("{s}")
    }
}
