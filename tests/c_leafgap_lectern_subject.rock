struct LeafgapPresentation { id: int }
struct LeafgapAnchor { id: int }
enum LeafgapSubject { Lectern(LeafgapPresentation), Gallery(LeafgapAnchor) }
struct LeafgapPlayer { gallery: bool }

fn LeafgapPlayer.subject(player) -> LeafgapSubject? {
    if player.gallery { return LeafgapSubject::Gallery(LeafgapAnchor { id: 43 }) }
    return null
}

// A nullable native return replaces both presence and payload leaves.
@test fn c_lectern_subject_assignment_projects_presence_and_payload() {
    let players: Arena<LeafgapPlayer> = arena_new()
    let player = players.insert(LeafgapPlayer { gallery: true })
    let subject: LeafgapSubject? = null
    if let value = player.get() { subject = value.subject() }
    if let value = subject {
        match value {
            LeafgapSubject::Gallery(anchor) => assert_eq(anchor.id, 43),
            LeafgapSubject::Lectern(_) => assert(false),
        }
    } else { assert(false) }
    if let value = player.get() { value.gallery = false }
    subject = player.get().unwrap().subject()
    assert(subject == null)
    let _ = arena_destroy(players)
    let _ = __arena_drain_retired()
}
