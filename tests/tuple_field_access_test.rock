struct TestStruct {
    sprite: string,
    name: string,
}

@test 
fn test_tuple_field_access() {
    let s = TestStruct { sprite: "test.png", name: "test" }
    let tup: (int, TestStruct) = (1, s)
    
    let first = tuple_first(tup)
    let second = tuple_second(tup)
    
    // This should work - accessing field on the extracted value
    let sprite_name = second.sprite
    
    assert_eq(sprite_name, "test.png", "Should be able to access field on tuple element")
}