// Transparency premise: a newtype compiles to its inner value -- no
// `{__ty, [1]=...}` box, no tag, no allocation. The value IS the inner value
// at runtime; nominal distinctness is purely compile-time.
// The constructor is a function call and `.0` is a no-op read; the value is
// never scalarized or boxed across calls.

newtype Uid(int)
newtype Lbl(string)

inline(lua) fn host_type_of(v: any) -> string = "return type(v)"
inline(js) fn host_type_of(v: any) -> string = "return typeof v;"
inline(lua) fn host_raw_eq(a: any, b: any) -> bool = "return a == b"
inline(js) fn host_raw_eq(a: any, b: any) -> bool = "return a === b;"

// A newtype-wrapped int or string is a raw host scalar, not a table.
@test(output = "number\nstring")
fn test_newtype_is_raw_scalar() {
    print(host_type_of(Uid(42)))
    print(host_type_of(Lbl("hi")))
}

// Construction and `.0` unwrap are identity.
@test(output = "true\ntrue")
fn test_newtype_construct_and_unwrap_are_identity() {
    let id = Uid(7)
    print(host_raw_eq(id, 7))
    print(host_raw_eq(id.0, 7))
}

// Newtype patterns work in match position too, binding the inner value.
@test(output = "9")
fn match_newtype_pattern() {
    let v = Uid(9)
    let n = match v {
        Uid(n) => n,
    }
    print(n)
}

value TCell { hp: int }
newtype BoxedCell(TCell)

fn bump(c: ref TCell) {
    c.hp += 1
}

fn boxed(n: int) -> BoxedCell {
    return BoxedCell(TCell { hp: n })
}

fn unwrap_forms(w: BoxedCell) {
    let BoxedCell(inner) = w
    inner.hp = 99
    let BoxedCell(a) = w
    print(a.hp)
    let BoxedCell(borrow_me) = w
    bump(borrow_me)
    let projected = w.0
    projected.hp = 98
    let captured = () => {
        let BoxedCell(c) = w
        c.hp = 97
    }
    captured()
    let cells: [TCell] = []
    cells.push(w.0)
    cells[0].hp = 96
    print(w.0.hp)
}

// Every unwrap of a newtype over a value struct (`let`, `for` and `match`
// patterns, `.0`, inside a closure, into a container) binds a COPY: mutating it,
// directly or through a `ref` borrow, never writes back into the wrapper.
@test(output = "1
1
2
2
2")
fn newtype_unwrap_keeps_value_semantics() {
    let w = boxed(1)
    unwrap_forms(w)
    let ws = [boxed(2)]
    let BoxedCell(y) = ws[0]
    y.hp = 7
    print(ws[0].0.hp)
    let indexed = ws[0].0
    indexed.hp = 6
    for BoxedCell(z) in ws {
        z.hp = 8
    }
    print(ws[0].0.hp)
    match ws[0] {
        BoxedCell(m) => {
            bump(m)
        }
    }
    print(ws[0].0.hp)
}

// --- Newtype ABI: one plain value through calls, returns and `.0` unwraps ---

newtype UserId(int)

fn mk(n: int) -> UserId {
    return UserId(n)
}

fn raw(u: UserId) -> int {
    return u.0
}

fn add_ids(a: UserId, b: UserId) -> UserId {
    return UserId(a.0 + b.0)
}

@test(output = "42\n7")
fn test_construct_and_unwrap() {
    let u = mk(42)
    print("{raw(u)}")
    let v = UserId(7)
    print("{v.0}")
}

@test(output = "5")
fn test_newtype_arith_via_unwrap() {
    let s = add_ids(UserId(2), UserId(3))
    print("{s.0}")
}

@test(output = "true\nfalse\ntrue\ntrue")
fn test_newtype_eq() {
    let a = UserId(1)
    let b = UserId(1)
    let c = UserId(2)
    print("{a == b}")
    print("{a == c}")
    print("{a != c}")
    print("{a == UserId(1)}")
}
