// Transparency premise: a newtype compiles to its inner value -- no
// `{__ty, [1]=...}` box, no tag, no allocation. The value IS the inner value
// at runtime; nominal distinctness is purely compile-time.
// The constructor is a function call and `.0` is a no-op read; the value is
// never scalarized or boxed across calls.

newtype Uid(int)
newtype Lbl(string)
newtype Dist(int)

inline(lua) fn host_type_of(v: any) -> string = "return type(v)"
inline(js) fn host_type_of(v: any) -> string = "return typeof v;"
inline(lua) fn host_raw_eq(a: any, b: any) -> bool = "return a == b"
inline(js) fn host_raw_eq(a: any, b: any) -> bool = "return a === b;"

// A newtype-wrapped int is a raw host number, not a table.
@test(output = "number")
fn test_newtype_int_is_raw_scalar() {
    let id = Uid(42)
    print(host_type_of(id))
}

// A newtype-wrapped string is a raw host string.
@test(output = "string")
fn test_newtype_string_is_raw_scalar() {
    let l = Lbl("hi")
    print(host_type_of(l))
}

// Construction is identity: the wrapped value flows through unchanged.
@test(output = "true")
fn test_newtype_construct_is_identity() {
    let id = Uid(7)
    print(host_raw_eq(id, 7))
}

// `.0` unwrap is identity.
@test(output = "true")
fn test_newtype_unwrap_is_identity() {
    let id = Uid(9)
    print(host_raw_eq(id.0, 9))
}

// Operators forward and stay free (int + int natively); result is the newtype.
@test(output = "15")
fn test_newtype_arith_native() {
    let a = Dist(10)
    let b = Dist(5)
    print((a + b).0)
}

// Map keys natively (no unwrap hook): the key is the raw int.
@test(output = "south")
fn test_newtype_map_key_native() {
    let m: Map<Uid, string> = map_new()
    m[Uid(1)] = "south"
    print(m[Uid(1)])
}

// Pattern unwrap still binds the inner value.
@test(output = "42")
fn test_newtype_pattern_unwrap() {
    let id = Uid(42)
    let Uid(v) = id
    print(v)
}

// --- Newtype ABI: one plain value through calls, returns and `.0` unwraps ---

newtype UserId(int)
newtype Meters(float)

fn mk(n: int) -> UserId {
    return UserId(n)
}

fn raw(u: UserId) -> int {
    return u.0
}

fn passthrough(u: UserId) -> UserId {
    return u
}

fn add_ids(a: UserId, b: UserId) -> UserId {
    return UserId(a.0 + b.0)
}

@test(output = "42\n7")
fn test_construct_and_unwrap() {
    let u = mk(42)
    print("{raw(u)}")
    let v = UserId(7)
    print("{v.0}")
}

@test(output = "99")
fn test_passthrough() {
    let u = passthrough(UserId(99))
    print("{u.0}")
}

@test(output = "5")
fn test_newtype_arith_via_unwrap() {
    let s = add_ids(UserId(2), UserId(3))
    print("{s.0}")
}

@test(output = "true\nfalse")
fn test_newtype_eq() {
    let a = UserId(1)
    let b = UserId(1)
    let c = UserId(2)
    print("{a == b}")
    print("{a == c}")
}

@test(output = "3")
fn test_float_newtype() {
    let m = Meters(3.5)
    print("{m.0.floor()}")
}
