// Newtype construction, destructuring, implicit operators, nesting,
// newtypes wrapping generic-instantiated types, and newtypes as Map keys.

newtype UserId(int)
newtype Box<T>(T)
newtype Score(int)
newtype Distance(int)
newtype Temperature(int)
newtype Meters(float)

struct User {
    id: UserId,
    name: string,
    score: Score,
}

@test(output = "42\nhello")
fn test_generic_newtype_usage() {
    let boxed_int = Box(42)
    let boxed_str = Box("hello")
    let Box(val) = boxed_int
    print(val)
    print(boxed_str.0)
}

@test(output = "42\n42 Alice 100")
fn test_newtype_in_struct() {
    let user = User { id: UserId(42), name: "Alice", score: Score(100) }
    let UserId(id_val) = user.id
    print(id_val)
    print("{user.id.0} {user.name} {user.score.0}")
}

@test(output = "true\ntrue\ntrue\ntrue")
fn test_newtype_implicit_comparison() {
    let score1 = Score(100)
    let score2 = Score(200)
    print(score1 < score2)
    print(score2 > score1)
    print(score1 <= score2)
    print(score2 >= score1)
}

// Integer newtypes use integer division for `./`.
@test(output = "15\n5\n50\n2\n2\n-25")
fn test_newtype_int_operators() {
    let d1 = Distance(10)
    let d2 = Distance(5)
    print((d1 + d2).0)
    print((d1 - d2).0)
    print((d1 * d2).0)
    print((d1 ./ Distance(4)).0)
    print((d1 % Distance(4)).0)
    let neg_temp = -Temperature(25)
    print(neg_temp.0)
}

@test(output = "8\n2.5")
fn test_newtype_float_operators() {
    let sum = Meters(5.5) + Meters(2.5)
    print(sum.0)
    let quotient = Meters(5.0) / Meters(2.0)
    print(quotient.0)
}

@test(output = "id: 42\nuser=UserId(42)")
fn test_newtype_in_interpolation() {
    let id = UserId(42)
    print("id: {id.0}")
    print("user={id}")
}

@test(output = "42\nfallback\n0\n42")
fn test_nullable_newtype() {
    let present: UserId? = UserId(42)
    let absent: UserId? = null
    if present != null {
        print(present.0)
    }
    if absent == null {
        print("fallback")
    }
    print(absent?.0 ?? 0)
    print(present?.0 ?? 0)
}

newtype Wrapper(UserId)

@test(output = "42\n42\n42")
fn test_nested_newtype() {
    let w = Wrapper(UserId(42))
    let inner = w.0
    print(inner.0)
    print(w.0.0)
    let Wrapper(UserId(id)) = w
    print(id)
}

// Newtypes wrapping generic-instantiated types.
newtype EntityIntWrap(Entity<int>)
newtype IntListWrap([int])
newtype StrIntMapWrap(Map<string, int>)
newtype NestedAppWrap([Map<string, int>])

fn return_entity_wrap(e: Entity<int>) -> EntityIntWrap {
    EntityIntWrap(e)
}

@test(output = "42\n42\n55")
fn test_newtype_wraps_entity() {
    let a: Arena<int> = arena_new()
    let w = EntityIntWrap(insert(a, 42))
    print(w.0.get() ?? 0)
    let EntityIntWrap(inner) = w
    print(inner.get() ?? 0)
    let r = return_entity_wrap(insert(a, 55))
    print(r.0.get() ?? 0)
}

@test(output = "3\n10\n20\n30")
fn test_newtype_wraps_vec() {
    let w = IntListWrap([10, 20, 30])
    print(w.0.len())
    for v in w.0 {
        print(v)
    }
}

@test(output = "99\n1")
fn test_newtype_wraps_map_and_nested_app() {
    let m: Map<string, int> = map_new()
    m["k"] = 99
    let w = StrIntMapWrap(m)
    print(w.0["k"])
    let n: Map<string, int> = map_new()
    n["a"] = 1
    let nested = NestedAppWrap([n])
    print(nested.0[0]["a"])
}

// Newtype whose wrapped type is itself a generic newtype instantiation
newtype BoxedInt(Box<int>)

@test(output = "13")
fn test_newtype_wraps_user_generic_newtype_instantiation() {
    let b = BoxedInt(Box(13))
    let Box(v) = b.0
    print(v)
}

// A generic newtype wrapping an App-shaped pattern infers T by unifying the
// pattern with the argument (Entity<T> against Entity<int> gives T = int), not
// by taking T as the argument's type.
newtype GEntity<T>(Entity<T>)
newtype GList<T>([T])
newtype GStrMap<T>(Map<string, T>)
newtype GMap<K, V>(Map<K, V>)
newtype GNullable<T>(T?)
newtype GMapSameTwice<T>(Map<T, T>)
newtype GUnused<T>(int)
newtype GNestedApp<T>([Entity<T>])
newtype GDeepNested<T>([Map<string, T>])
newtype GNullableApp<T>(Entity<T>?)

// Inference through the ctor, pattern destructure, and Check mode through an
// ascription.
@test(output = "100\n44\n88")
fn test_g_entity_unifies() {
    let a: Arena<int> = arena_new()
    let g = GEntity(insert(a, 100))
    print(g.0.get() ?? 0)
    let GEntity(inner) = GEntity(insert(a, 44))
    print(inner.get() ?? 0)
    let ascribed: GEntity<int> = GEntity(insert(a, 88))
    print(ascribed.0.get() ?? 0)
}

@test(output = "3\n42\n7\n1")
fn test_g_collections_unify() {
    let g = GList([1, 2, 3])
    print(g.0.len())
    let m: Map<string, int> = map_new()
    m["a"] = 42
    m["k"] = 7
    print(GStrMap(m).0["a"])
    print(GMap(m).0["k"])
    let same: Map<int, int> = map_new()
    same[10] = 1
    print(GMapSameTwice(same).0[10])
}

@test(output = "9\n5")
fn test_g_nullable_unifies() {
    let x: int? = 9
    print(GNullable(x).0 ?? 0)
    print(GNullable(5).0 ?? 0)
}

// An unused T stays free, so an ascription fixes the type arg.
@test(output = "77")
fn test_g_unused_generic_constructs() {
    let g: GUnused<int> = GUnused(77)
    print(g.0)
}

@test(output = "11\n55\n21")
fn test_g_nested_apps_unify() {
    let a: Arena<int> = arena_new()
    let g = GNestedApp([insert(a, 11)])
    print(g.0[0].get() ?? 0)
    let m: Map<string, int> = map_new()
    m["k"] = 55
    print(GDeepNested([m]).0[0]["k"])
    let n = GNullableApp(insert(a, 21))
    let inner = n.0 ?? return
    print(inner.get() ?? 0)
}

// A tuple-shaped wrapped type constrains T through its element.
newtype GTuple<T>((T, int))

@test(output = "13")
fn test_g_tuple_wrapped() {
    let g = GTuple((13, 99))
    let (a, _) = g.0
    print(a)
}

newtype GFn<T>(fn(T) -> T)

@test(output = "21")
fn test_g_fn_wrapped() {
    let id = (x: int) => x
    let f = GFn(id)
    let g = f.0
    print(g(21))
}

newtype GTripleNest<T>([Map<string, [T]>])

@test(output = "42")
fn test_g_triple_nested() {
    let m: Map<string, [int]> = map_new()
    m["k"] = [42, 43]
    let g = GTripleNest([m])
    print(g.0[0]["k"][0])
}

// Generic newtype used as a Map key (native key, no unwrap)
newtype GKey<T>(T)

@test(output = "south")
fn test_g_used_as_map_key() {
    let m: Map<GKey<int>, string> = map_new()
    m[GKey(1)] = "south"
    print(m[GKey(1)])
}

// Rejected unifications are in
// tests/errors/types.rock.err.

// Newtypes as Map keys: direct indexing `m[k]` unwraps the key on read and
// write, agreeing with `get`/`insert`/`contains`/`remove`.
newtype Tag(string)

@test
fn test_direct_index_agrees_with_get_and_insert() {
    let m: Map<UserId, string> = map_new()
    m[UserId(42)] = "alice"
    assert_eq(m[UserId(42)], "alice", "direct write -> direct read roundtrip")
    assert_eq(m.get(UserId(42)) ?? "MISSING", "alice", "direct write visible via .get()")
    insert(m, UserId(3), "eve")
    assert_eq(m[UserId(3)], "eve", "insert value readable via m[k]")
    insert(m, UserId(3), "eve2")
    assert_eq(get(m, UserId(3)).unwrap(), "eve2", "insert through an equal key updates")
}

@test
fn test_map_contains_and_remove_newtype() {
    let m: Map<UserId, string> = map_new()
    m[UserId(1)] = "a"
    m[UserId(2)] = "b"
    assert(m.contains(UserId(1)))
    assert(!m.contains(UserId(99)))
    assert_eq(m.len(), 2)
    let removed = remove(m, UserId(1)) ?? ""
    assert_eq(removed, "a", "removed returns value")
    assert_true(m.get(UserId(1)) == null, "removed key is gone")
    assert(!m.contains(UserId(1)))
    assert_eq(m.get(UserId(2)) ?? "", "b", "other keys intact")
    assert_eq(m.len(), 1)
}

@test
fn test_map_clear_newtype() {
    let m: Map<UserId, string> = map_new()
    m[UserId(1)] = "a"
    m[UserId(2)] = "b"
    m[UserId(3)] = "c"
    clear(m)
    assert_eq(m.len(), 0, "cleared len=0")
    assert_true(m.get(UserId(1)) == null, "k1 gone")
    assert_true(m.get(UserId(2)) == null, "k2 gone")
}

@test
fn test_string_newtype_key() {
    let m: Map<Tag, int> = map_new()
    m[Tag("score")] = 100
    insert(m, Tag("hp"), 42)
    assert_eq(m.get(Tag("score")) ?? 0, 100, "string newtype roundtrip")
    assert_eq(m[Tag("hp")], 42, "string newtype direct read")
    assert(m.contains(Tag("hp")))
    assert(!m.contains(Tag("mp")))
    assert_eq(m.len(), 2)
}

@test
fn test_map_keys_from_vec_elements() {
    let data: Map<UserId, string> = map_new()
    let ids: [UserId] = [UserId(1), UserId(2), UserId(3), UserId(4), UserId(5)]
    let names = ["One", "Two", "Three", "Four", "Five"]
    for i in 0..5 {
        insert(data, ids[i], names[i])
    }
    for i in 0..5 {
        assert_eq(get(data, ids[i]).unwrap(), names[i])
    }
    assert_eq(data.len(), 5)
}
