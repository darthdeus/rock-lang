// Sentinel: compound-op assignment to a bare value-struct local.
// Branch-side `statements.rs:209` comment claims compound ops use
// the "plain string path" because operator overloads aren't
// value-Multi-aware. The field-of-struct case (`mob.pos += rhs`)
// works in the bitgun corpus today; this test pins the bare-local
// case.

value V2 { x: int, y: int }

@pure operator +(a: V2, b: V2) -> V2 {
    V2 { x: a.x + b.x, y: a.y + b.y }
}

@pure operator -(a: V2, b: V2) -> V2 {
    V2 { x: a.x - b.x, y: a.y - b.y }
}

@test(output = "4, 6")
fn anf_value_local_compound_add() {
    let v = V2 { x: 1, y: 2 }
    let w = V2 { x: 3, y: 4 }
    v += w
    print("{v.x}, {v.y}")
}

@test(output = "-2, -2")
fn anf_value_local_compound_sub() {
    let v = V2 { x: 1, y: 2 }
    let w = V2 { x: 3, y: 4 }
    v -= w
    print("{v.x}, {v.y}")
}

@test(output = "7, 10")
fn anf_value_local_compound_chain() {
    let v = V2 { x: 1, y: 2 }
    v += V2 { x: 3, y: 4 }
    v += V2 { x: 3, y: 4 }
    print("{v.x}, {v.y}")
}
