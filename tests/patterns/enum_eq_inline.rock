// Regression test for enum == / != specialization. Today this passes via the
// generic __op_eq fallback; after specialization, the generated Lua should
// emit native (a == b) for payloadless enums and a direct __op_eq_<Enum> call
// for payloaded enums, while this test still passes.

enum TileType { Floor, Wall, Water }
enum AiState { Idle, Wander, Chase }

enum Msg {
    Ping,
    Val(int),
    Str(string),
}

@test
fn test_payloadless_same_variant() {
    let a = TileType::Wall
    let b = TileType::Wall
    assert_eq(a == b, true)
    assert_eq(a != b, false)
}

@test
fn test_payloadless_different_variants() {
    let a = TileType::Floor
    let b = TileType::Water
    assert_eq(a == b, false)
    assert_eq(a != b, true)
}

@test
fn test_payloadless_variable_vs_literal() {
    let t = TileType::Wall
    assert_eq(t == TileType::Wall, true)
    assert_eq(TileType::Wall == t, true)
    assert_eq(t == TileType::Floor, false)
    assert_eq(TileType::Floor != t, true)
}

@test
fn test_payloadless_in_if() {
    let state = AiState::Wander
    let result = 0
    if state == AiState::Wander {
        result = 1
    }
    assert_eq(result, 1)
    if state != AiState::Idle {
        result = 2
    }
    assert_eq(result, 2)
}

@test
fn test_payloaded_same_payload() {
    let a = Msg::Val(5)
    let b = Msg::Val(5)
    assert_eq(a == b, true)
}

@test
fn test_payloaded_different_payload() {
    let a = Msg::Val(5)
    let b = Msg::Val(6)
    assert_eq(a == b, false)
    assert_eq(a != b, true)
}

@test
fn test_payloaded_different_variants() {
    let a = Msg::Val(5)
    let b = Msg::Str("hi")
    assert_eq(a == b, false)
}

@test
fn test_payloaded_vs_unit_variant() {
    let a = Msg::Ping
    let b = Msg::Val(0)
    assert_eq(a == b, false)
    assert_eq(a != b, true)
}

@test
fn test_mixed_enum_with_units_and_payloads() {
    let a = Msg::Ping
    let b = Msg::Ping
    assert_eq(a == b, true)
}

// Moved from enum_tuple_variants.rock: loop + match over heterogeneous vec
enum Shape {
    Point,
    Line(float, float, float, float),
    Circle(float, float, float),
}

@test
fn test_tuple_variant_nested_match() {
    let shapes = [
        Shape::Point,
        Shape::Line(0.0, 0.0, 5.0, 5.0),
        Shape::Circle(10.0, 10.0, 2.5),
    ]

    for shape in shapes {
        match shape {
            Shape::Point => print("Got a point"),
            Shape::Line(_, _, x2, y2) => print("Line ends at ({x2}, {y2})"),
            Shape::Circle(_, _, radius) => print("Circle with radius {radius}"),
        }
    }
}

enum Message {
    Quit,
    Move(int, int),
    Write(string),
    ChangeColor(int, int, int),
}

@test
fn test_mixed_variant_types() {
    let msg = Message::Move(10, 20)

    match msg {
        Message::Quit => print("Quit"),
        Message::Move(x, y) => {
            assert_eq(x, 10)
            assert_eq(y, 20)
            print("Move to ({x}, {y})")
        }
        Message::Write(text) => print("Write: {text}"),
        Message::ChangeColor(r, g, b) => print("Color: ({r}, {g}, {b})"),
    }
}
