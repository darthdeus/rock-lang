// Enum basics: unit, payload, generic and single-variant enums built, compared,
// stored in vectors and matched, including nested matches, enums passed to
// helpers across scopes and patterns that name payload variants.

enum Color {
    Red,
    Green,
    Blue,
}

enum Status {
    Pending,
    Success,
    Failed,
}

@test
fn test_enum_creation() {
    let red = Color::Red
    let green = Color::Green
    let blue = Color::Blue
    
    assert_not_null(red)
    assert_not_null(green)
    assert_not_null(blue)
}

@test
fn test_enum_equality() {
    let red1 = Color::Red
    let red2 = Color::Red
    let green = Color::Green
    
    assert_eq(red1, red2)
    assert_eq(red1, Color::Red)
    assert_ne(red1, green)
    assert_ne(red1, Color::Green)
}

@test
fn test_enum_in_arrays() {
    let colors = [Color::Red, Color::Green, Color::Blue]
    
    assert_eq(vec_len(colors), 3)
    assert_eq(vec_get(colors, 0).unwrap(), Color::Red)
    assert_eq(vec_get(colors, 1).unwrap(), Color::Green)
    assert_eq(vec_get(colors, 2).unwrap(), Color::Blue)
}

@test
fn test_enum_assignment() {
    let color = Color::Red
    assert_eq(color, Color::Red)
    
    color = Color::Green
    assert_eq(color, Color::Green)
    assert_ne(color, Color::Red)
}

@test
fn test_match_expressions() {
    let color = Color::Red
    let result = match color {
        Red => "red",
        Green => "green", 
        Blue => "blue",
    }
    
    assert_eq(result, "red")
}

@test
fn test_match_with_different_variants() {
    let status = Status::Success
    let message = match status {
        Pending => "waiting",
        Success => "done",
        Failed => "error",
    }
    
    assert_eq(message, "done")
}

@test(output="Red\nGreen\nBlue")
fn test_enum_print_output() {
    let red = Color::Red
    let green = Color::Green  
    let blue = Color::Blue
    
    match red {
        Red => print("Red"),
        Green => print("Green"),
        Blue => print("Blue"),
    }
    
    match green {
        Red => print("Red"),
        Green => print("Green"),
        Blue => print("Blue"),
    }
    
    match blue {
        Red => print("Red"),
        Green => print("Green"),
        Blue => print("Blue"),
    }
}

@test(output="It's red!\nStatus: done")
fn test_complex_enum_scenario() {
    let color = Color::Red
    let status = Status::Success
    
    if color == Color::Red {
        print("It's red!")
    }
    
    let message = match status {
        Pending => "waiting",
        Success => "done", 
        Failed => "error",
    }
    
    print("Status: {message}")
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

// Empty enums are not supported in Rock
// enum EmptyEnum { }

enum SingleVariant {
    Only,
}

@test
fn test_variant_not_found() {
    // This should give a compile error if uncommented:
    // let color = Color::Yellow  // Variant 'Yellow' not found
    
    // Instead, test valid cases
    let color = Color::Red
    assert_eq(color, Color::Red)
    print("Valid variant construction works")
}

@test
fn test_wrong_argument_count() {
    // These should give compile errors if uncommented:
    // let result = Result::Ok()  // Missing argument
    // let result = Result::Ok(1, 2)  // Too many arguments
    // let color = Color::Red(1)  // Unit variant with argument
    
    // Test valid cases
    let result: Result<int, string> = Result::Ok(42)
    match result {
        Result::Ok(n) => assert_eq(n, 42),
        Result::Err(_) => assert(false, "Should not be error"),
    }
    print("Correct argument count works")
}

@test
fn test_pattern_exhaustiveness() {
    let color = Color::Blue
    
    // This match is exhaustive
    let name = match color {
        Color::Red => "red",
        Color::Green => "green", 
        Color::Blue => "blue",
    }
    assert_eq(name, "blue")
    
    // If we uncomment this, it should give exhaustiveness error:
    // let bad = match color {
    //     Red => "red",
    //     Green => "green",
    //     // Missing Blue case
    // }
    
    print("Exhaustiveness checking works")
}

@test
fn test_single_variant_enum() {
    let single = SingleVariant::Only
    
    match single {
        SingleVariant::Only => print("Single variant enum works"),
    }
}

@test
fn test_deeply_nested_match() {
    let inner_result: Result<int, string> = Result::Ok(42)
    let outer: Result<Result<int, string>, string> = Result::Ok(inner_result)
    
    let value = match outer {
        Result::Ok(inner) => match inner {
            Result::Ok(n) => n,
            Result::Err(e) => 0,
        },
        Result::Err(e) => -1,
    }
    
    assert_eq(value, 42)
    print("Deeply nested matches work")
}

// Test that we can use enum variants in different scopes
fn helper_function(c: Color) -> string {
    match c {
        Color::Red => "R",
        Color::Green => "G",
        Color::Blue => "B",
    }
}

@test
fn test_enum_scope() {
    let color = Color::Red
    let result = helper_function(color)
    assert_eq(result, "R")
    
    // Test in nested scope
    {
        let inner_color = Color::Green
        let inner_result = helper_function(inner_color)
        assert_eq(inner_result, "G")
    }
    
    print("Enum variants work across scopes")
}

// Test generic enum edge cases
enum Box<T> {
    Empty,
    Full(T),
}

@test
fn test_generic_enum_inference() {
    // Type should be inferred from usage
    let box1 = Box::Full(42)
    let box2: Box<int> = Box::Empty  // Need explicit type for unit variants
    
    match box1 {
        Box::Full(n) => assert_eq(n, 42),
        Box::Empty => assert(false, "Should not be empty"),
    }
    
    match box2 {
        Box::Full(_) => assert(false, "Should be empty"),
        Box::Empty => print("Generic enum inference works"),
    }
}

// `E` is pinned by nothing here, so `result` has no fully concrete type and
// lowering has to plan the variant and the match from the nominal enum name.
@test(output="42")
fn test_enum_with_unconstrained_type_param() {
    let result = Result::Ok(42)
    match result {
        Result::Ok(value) => print(value),
        Result::Err(_) => print("error"),
    }
}

enum PayloadColor {
    Red(int),
    Blue(string),
    Green(bool)
}

@test
fn test_valid_enum_pattern() {
    let color = PayloadColor::Red(255)
    
    match color {
        PayloadColor::Red(value) => {
            assert_eq(value, 255)
        },
        PayloadColor::Blue(name) => {
            assert_eq(name, "blue")
        },
        PayloadColor::Green(enabled) => {
            assert_eq(enabled, true)
        }
    }
}

// This test ensures that the compiler properly validates enum type names
// The following patterns should all compile successfully since they use the correct enum name
@test
fn test_enum_name_validation() {
    let color = PayloadColor::Blue("sky")
    
    match color {
        PayloadColor::Blue(name) => {
            assert_eq(name, "sky")
        },
        _ => {
            // This should not be reached
        }
    }
}
