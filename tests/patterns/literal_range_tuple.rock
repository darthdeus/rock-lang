// Literal, range and tuple match arms, including negative-int and float
// literals. Range and tuple arms lower to short-circuit `&&`/`||` conditions;
// exhaustive enum and literal chains need no fallthrough arm, and a match
// result feeding later code must join at the real continuation.

enum Dir { North, East, South, West }

@test(output = "2")
fn test_exhaustive_enum() {
    let d = Dir::South
    print(match d {
        Dir::North => 0,
        Dir::East => 1,
        Dir::South => 2,
        Dir::West => 3,
    })
}

@test(output = "10")
fn test_range_two_arm() {
    print(match 3 { 1..5 => 10, _ => 20 })
}

@test(output = "20")
fn test_range_two_arm_miss() {
    print(match 9 { 1..5 => 10, _ => 20 })
}

@test(output = "30")
fn test_range_three_arm() {
    let f = (x: int) => match x { 1..5 => 10, 6..10 => 20, _ => 30 }
    print(f(100))
}

@test(output = "100")
fn test_tuple_pattern() {
    print(match (1, 2) { (1, 2) => 100, _ => 200 })
}

@test(output = "300")
fn test_literal_set() {
    let classify = (x: int) => match x { 1 => 100, 2 => 200, 3 => 300, _ => 0 }
    print(classify(3))
}

// Exhaustive match whose result feeds a following computation (join must be the
// real continuation, not the virtual exit).
@test(output = "7")
fn test_match_result_used() {
    let base = match Dir::East { Dir::North => 0, Dir::East => 5, Dir::South => 2, Dir::West => 3 }
    print(base + 2)
}

fn classify(n: int) -> int {
    return match n {
        0..10 => 1,
        10..=20 => 2,
        _ => 9,
    }
}

fn tup(p: (int, int)) -> int {
    return match p {
        (0, 0) => 100,
        (1, y) => y,
        (x, _) => x,
        _ => 42,
    }
}

fn open_range(n: int) -> int {
    return match n {
        ..0 => 0,
        100.. => 2,
        _ => 1,
    }
}

@test(output = "1\n2\n2\n9")
fn test_range_patterns() {
    print("{classify(5)}")
    print("{classify(15)}")
    print("{classify(20)}")
    print("{classify(99)}")
}

@test(output = "100\n7\n4")
fn test_tuple_patterns() {
    print("{tup((0, 0))}")
    print("{tup((1, 7))}")
    print("{tup((4, 9))}")
}

@test(output = "0\n1\n2")
fn test_open_ranges() {
    print("{open_range(-5)}")
    print("{open_range(50)}")
    print("{open_range(200)}")
}

@test(output = "neg
zero
pos
pi")
fn match_negative_int_pattern() {
    let xs: [int] = [-1, 0, 1]
    for x in xs {
        match x {
            -1 => print("neg"),
            0 => print("zero"),
            1 => print("pos"),
            _ => print("other"),
        }
    }
    let f: float = 3.14
    match f {
        3.14 => print("pi"),
        _ => print("other"),
    }
}
