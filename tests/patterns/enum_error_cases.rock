// Test error cases and edge cases for enum functionality

enum Color {
    Red,
    Green,
    Blue,
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

// Empty enums are not supported in Rock
// enum EmptyEnum { }

enum SingleVariant {
    Only,
}

@test
fn test_variant_not_found() {
    // This should give a compile error if uncommented:
    // let color = Color::Yellow  // Variant 'Yellow' not found
    
    // Instead, test valid cases
    let color = Color::Red
    assert_eq(color, Color::Red)
    print("Valid variant construction works")
}

@test
fn test_wrong_argument_count() {
    // These should give compile errors if uncommented:
    // let result = Result::Ok()  // Missing argument
    // let result = Result::Ok(1, 2)  // Too many arguments
    // let color = Color::Red(1)  // Unit variant with argument
    
    // Test valid cases
    let result: Result<int, string> = Result::Ok(42)
    match result {
        Result::Ok(n) => assert_eq(n, 42),
        Result::Err(_) => assert(false, "Should not be error"),
    }
    print("Correct argument count works")
}

@test
fn test_pattern_exhaustiveness() {
    let color = Color::Blue
    
    // This match is exhaustive
    let name = match color {
        Color::Red => "red",
        Color::Green => "green", 
        Color::Blue => "blue",
    }
    assert_eq(name, "blue")
    
    // If we uncomment this, it should give exhaustiveness error:
    // let bad = match color {
    //     Red => "red",
    //     Green => "green",
    //     // Missing Blue case
    // }
    
    print("Exhaustiveness checking works")
}

@test
fn test_single_variant_enum() {
    let single = SingleVariant::Only
    
    match single {
        SingleVariant::Only => print("Single variant enum works"),
    }
}

@test
fn test_deeply_nested_match() {
    let inner_result: Result<int, string> = Result::Ok(42)
    let outer: Result<Result<int, string>, string> = Result::Ok(inner_result)
    
    let value = match outer {
        Result::Ok(inner) => match inner {
            Result::Ok(n) => n,
            Result::Err(e) => 0,
        },
        Result::Err(e) => -1,
    }
    
    assert_eq(value, 42)
    print("Deeply nested matches work")
}

// Test that we can use enum variants in different scopes
fn helper_function(c: Color) -> string {
    match c {
        Color::Red => "R",
        Color::Green => "G",
        Color::Blue => "B",
    }
}

@test
fn test_enum_scope() {
    let color = Color::Red
    let result = helper_function(color)
    assert_eq(result, "R")
    
    // Test in nested scope
    {
        let inner_color = Color::Green
        let inner_result = helper_function(inner_color)
        assert_eq(inner_result, "G")
    }
    
    print("Enum variants work across scopes")
}

// Test generic enum edge cases
enum Box<T> {
    Empty,
    Full(T),
}

@test
fn test_generic_enum_inference() {
    // Type should be inferred from usage
    let box1 = Box::Full(42)
    let box2: Box<int> = Box::Empty  // Need explicit type for unit variants
    
    match box1 {
        Box::Full(n) => assert_eq(n, 42),
        Box::Empty => assert(false, "Should not be empty"),
    }
    
    match box2 {
        Box::Full(_) => assert(false, "Should be empty"),
        Box::Empty => print("Generic enum inference works"),
    }
}