// Flat enums: a flat-eligible boxed (non-cdata) enum threads as its tag and
// payload scalars instead of a box -- across fn params and returns, as the
// leaf cells of a local, as a nullable `E?` whose null is a nil tag, flattened
// into a parent struct field, and spread into a parent enum's slots where
// nested patterns read it back. A box materializes only where a whole value
// is needed (==, capture, containers); behavior must match the boxed form.

enum Cmd {
    Stop,
    Go(int),
    Move { dx: int, dy: int },
    Run(() -> ()),       // closure payload -> Cmd is non-cdata
}

// Returns a flat enum.
fn make_cmd(n: int) -> Cmd {
    if n == 0 { return Cmd::Stop }
    if n < 0 { return Cmd::Move { dx: n, dy: -n } }
    return Cmd::Go(n)
}

// Takes a flat enum by value and matches it (param threading).
fn eval(c: Cmd) -> int {
    return match c {
        Cmd::Stop => 0
        Cmd::Go(n) => n
        Cmd::Move { dx, dy } => dx + dy
        Cmd::Run(_) => -1
    }
}

@test
fn test_return_then_match() {
    assert_eq(eval(make_cmd(0)), 0)
    assert_eq(eval(make_cmd(5)), 5)
    assert_eq(eval(make_cmd(-3)), 0)
}

@test
fn test_param_by_value() {
    assert_eq(eval(Cmd::Go(9)), 9)
    assert_eq(eval(Cmd::Move { dx: 2, dy: 3 }), 5)
    assert_eq(eval(Cmd::Stop), 0)
    assert_eq(eval(Cmd::Run(() => {})), -1)
}

@test
fn test_returned_value_used_whole() {
    // The returned enum is bound and compared as a WHOLE value (forces a box
    // materialization at this boundary) -- must still be structural-eq correct.
    let c = make_cmd(5)
    assert_eq(c == Cmd::Go(5), true)
    assert_eq(c == Cmd::Go(6), false)
    assert_eq(eval(c), 5)
}

enum Ev {
    Idle,
    Tick(int),
    At { x: int, y: int },
    Cb(() -> int),
}

fn make_ev(n: int) -> Ev {
    if n == 0 { return Ev::Idle }
    if n < 0 { return Ev::At { x: n, y: -n } }
    return Ev::Tick(n)
}

fn read_ev(e: Ev) -> int {
    return match e {
        Ev::Idle => 0
        Ev::Tick(n) => n
        Ev::At { x, y } => x + y
        Ev::Cb(f) => f()
    }
}

@test
fn test_reassign_local() {
    let e = Ev::Idle
    assert_eq(read_ev(e), 0)
    e = Ev::Tick(9)
    assert_eq(read_ev(e), 9)
    e = Ev::At { x: 1, y: 2 }
    assert_eq(read_ev(e), 3)
    e = make_ev(7)
    assert_eq(read_ev(e), 7)
}

@test
fn test_local_whole_value_use() {
    let e = make_ev(4)
    // `==` forces a box materialization at this site; still structural-correct.
    assert_eq(e == Ev::Tick(4), true)
    assert_eq(e == Ev::Tick(5), false)
    // pass the whole value to another fn (materialize at the call)
    assert_eq(read_ev(e), 4)
}

@test
fn test_local_captured_by_closure() {
    let e = Ev::Tick(11)
    let get = () => read_ev(e)      // closure captures the threaded local (the cells)
    assert_eq(get(), 11)
    e = Ev::At { x: 5, y: 20 }
    assert_eq(get(), 25)         // captures the VARIABLE, so reads the new value
    assert_eq(read_ev(e), 25)
}

@test
fn test_local_cb_variant() {
    let e = Ev::Cb(() => 42)
    assert_eq(read_ev(e), 42)
}

enum Sig {
    Idle,
    Num(int),
    Pair(int, int),
    Act(() -> ()),      // closure payload -> Sig is non-cdata
}

// nullable RETURN (nil on the not-found path)
fn find(n: int) -> Sig? {
    if n < -100 { return null }
    if n == 0 { return Sig::Idle }
    if n < 0 { return Sig::Pair(n, -n) }
    return Sig::Num(n)
}

// nullable PARAM + refinement + match
fn describe(s: Sig?) -> int {
    if s == null { return -1000 }
    return match s {
        Sig::Idle => 0
        Sig::Num(x) => x
        Sig::Pair(a, b) => a + b
        Sig::Act(_) => -1
    }
}

@test
fn test_return_null() {
    assert_eq(find(-999) == null, true)
    assert_eq(find(-999) != null, false)
}

@test
fn test_return_value() {
    assert_eq(find(5) != null, true)
    assert_eq(describe(find(5)), 5)
    assert_eq(describe(find(0)), 0)
    assert_eq(describe(find(-3)), 0)
    assert_eq(describe(find(-999)), -1000)
}

@test
fn test_param_null() {
    assert_eq(describe(null), -1000)
}

@test
fn test_param_value() {
    assert_eq(describe(Sig::Num(7)), 7)
    assert_eq(describe(Sig::Idle), 0)
    assert_eq(describe(Sig::Pair(2, 3)), 5)
    assert_eq(describe(Sig::Act(() => {})), -1)
}

@test
fn test_nullable_local_reassign() {
    let x: Sig? = null
    assert_eq(x == null, true)
    assert_eq(describe(x), -1000)
    x = Sig::Num(11)
    assert_eq(x != null, true)
    assert_eq(describe(x), 11)
    x = null
    assert_eq(describe(x), -1000)
}

@test
fn test_coalesce() {
    let x: Sig? = null
    assert_eq(describe(x ?? Sig::Idle), 0)
    let y: Sig? = Sig::Num(9)
    assert_eq(describe(y ?? Sig::Idle), 9)
}

// A THREADED nullable param materialized into a container must produce `nil` for
// the null case (a `{__variant = nil}` box would fail `== null`).
fn boxit(s: Sig?) -> [Sig?] { return [s] }

@test
fn test_threaded_null_materialized() {
    let arr = boxit(null)
    assert_eq(arr[0] == null, true)
    let arr2 = boxit(Sig::Num(7))
    assert_eq(arr2[0] != null, true)
    assert_eq(describe(arr2[0]), 7)
}

enum FieldSig {
    Idle,
    Num(int),
    Pair(int, int),
    Act(() -> ()),   // closure payload -> FieldSig is non-cdata
}

struct Holder {
    sig: FieldSig,
}

fn read(h: Holder) -> int {
    return match h.sig {
        FieldSig::Idle => 0
        FieldSig::Num(x) => x
        FieldSig::Pair(a, b) => a + b
        FieldSig::Act(_) => -1
    }
}

@test
fn test_construct_each_variant() {
    assert_eq(read(Holder { sig: FieldSig::Idle }), 0)
    assert_eq(read(Holder { sig: FieldSig::Num(7) }), 7)
    assert_eq(read(Holder { sig: FieldSig::Pair(3, 4) }), 7)
    assert_eq(read(Holder { sig: FieldSig::Act(() => {}) }), -1)
}

@test
fn test_reassign_field() {
    let h = Holder { sig: FieldSig::Idle }
    assert_eq(read(h), 0)
    h.sig = FieldSig::Num(11)
    assert_eq(read(h), 11)
    h.sig = FieldSig::Pair(5, 6)
    assert_eq(read(h), 11)
    h.sig = FieldSig::Idle
    assert_eq(read(h), 0)
}

@test
fn test_structural_eq_on_field() {
    let h = Holder { sig: FieldSig::Num(5) }
    // Structural, NOT reference: a fresh ctor compares equal.
    assert_eq(h.sig == FieldSig::Num(5), true)
    assert_eq(h.sig == FieldSig::Num(6), false)
    assert_eq(h.sig == FieldSig::Idle, false)
    assert_eq(h.sig != FieldSig::Num(5), false)
    h.sig = FieldSig::Pair(1, 2)
    assert_eq(h.sig == FieldSig::Pair(1, 2), true)
    assert_eq(h.sig == FieldSig::Pair(2, 1), false)
}

@test
fn test_field_copy_between_holders() {
    let a = Holder { sig: FieldSig::Pair(8, 9) }
    let b = Holder { sig: FieldSig::Idle }
    b.sig = a.sig
    assert_eq(read(b), 17)
    assert_eq(b.sig == a.sig, true)
}

@test
fn test_if_let_on_field() {
    let h = Holder { sig: FieldSig::Num(42) }
    let got = if let FieldSig::Num(x) = h.sig { x } else { -1 }
    assert_eq(got, 42)
    let miss = if let FieldSig::Pair(a, b) = h.sig { a + b } else { -1 }
    assert_eq(miss, -1)
}

enum Shape {
    Empty,
    Circle { r: int },
    Rect { w: int, h: int },
    Line(int, int),              // a tuple variant alongside records (mixed)
    Draw(() -> ()),              // closure payload -> Shape is non-cdata
}

struct Canvas {
    shape: Shape,
}

fn area(c: Canvas) -> int {
    return match c.shape {
        Shape::Empty => 0
        Shape::Circle { r } => r * r * 3
        Shape::Rect { w, h } => w * h
        Shape::Line(a, b) => a + b
        Shape::Draw(_) => -1
    }
}

@test
fn test_construct_record_variants() {
    assert_eq(area(Canvas { shape: Shape::Empty }), 0)
    assert_eq(area(Canvas { shape: Shape::Circle { r: 4 } }), 48)
    assert_eq(area(Canvas { shape: Shape::Rect { w: 3, h: 5 } }), 15)
    assert_eq(area(Canvas { shape: Shape::Line(7, 8) }), 15)
    assert_eq(area(Canvas { shape: Shape::Draw(() => {}) }), -1)
}

@test
fn test_reassign_record_variants() {
    let c = Canvas { shape: Shape::Empty }
    assert_eq(area(c), 0)
    c.shape = Shape::Rect { w: 6, h: 7 }
    assert_eq(area(c), 42)
    c.shape = Shape::Circle { r: 2 }
    assert_eq(area(c), 12)
    c.shape = Shape::Line(10, 20)
    assert_eq(area(c), 30)
}

@test
fn test_structural_eq_record() {
    let c = Canvas { shape: Shape::Rect { w: 3, h: 5 } }
    assert_eq(c.shape == Shape::Rect { w: 3, h: 5 }, true)
    assert_eq(c.shape == Shape::Rect { w: 5, h: 3 }, false)
    assert_eq(c.shape == Shape::Circle { r: 3 }, false)
    c.shape = Shape::Circle { r: 9 }
    assert_eq(c.shape == Shape::Circle { r: 9 }, true)
}

@test
fn test_if_let_record() {
    let c = Canvas { shape: Shape::Rect { w: 4, h: 6 } }
    let got = if let Shape::Rect { w, h } = c.shape { w * h } else { -1 }
    assert_eq(got, 24)
}

enum InnerLeaf { Empty, Pair(int, int), Named(string) }
enum SlotHolder { Nothing, Held(int, InnerLeaf, int) }

fn slot_holder(leaf: InnerLeaf) -> SlotHolder {
    return SlotHolder::Held(7, leaf, 9)
}

@test
fn nested_flat_enum_in_non_first_position() {
    let result = match slot_holder(InnerLeaf::Pair(3, 4)) {
        SlotHolder::Held(lead, InnerLeaf::Pair(x, y), trail) => lead * 1000 + x * 100 + y * 10 + trail,
        _ => -1,
    }
    // lead=7 and trail=9 prove the slots on either side of the widened position
    // are still addressed by slot, not by payload position.
    assert_eq(result, 7349)
}

@test
fn nested_flat_enum_rejects_a_sibling_variant() {
    // The inner tag test has to still gate the arm: a `Named` payload must not
    // fall into the `Pair` arm and bind the neighbouring slots.
    let result = match slot_holder(InnerLeaf::Named("nope")) {
        SlotHolder::Held(lead, InnerLeaf::Pair(x, y), trail) => lead * 1000 + x * 100 + y * 10 + trail,
        SlotHolder::Held(lead, InnerLeaf::Named(s), trail) => lead + trail,
        _ => -1,
    }
    assert_eq(result, 16)
}

@test
fn nested_flat_enum_unit_variant_arm() {
    let result = match slot_holder(InnerLeaf::Empty) {
        SlotHolder::Held(_, InnerLeaf::Pair(x, y), _) => x + y,
        SlotHolder::Held(lead, InnerLeaf::Empty, trail) => lead * 10 + trail,
        _ => -1,
    }
    assert_eq(result, 79)
}

enum RectLike { Blank, Sized { w: int, h: int }, Label(string) }
enum RectHolder { NoRect, SomeRect(RectLike, int) }

fn rect_holder(r: RectLike) -> RectHolder {
    return RectHolder::SomeRect(r, 5)
}

@test
fn nested_flat_enum_with_named_fields() {
    let result = match rect_holder(RectLike::Sized { w: 12, h: 3 }) {
        RectHolder::SomeRect(RectLike::Sized { w, h }, n) => w * 100 + h * 10 + n,
        _ => -1,
    }
    assert_eq(result, 1235)
}

@test
fn nested_flat_enum_named_fields_reject_sibling() {
    let result = match rect_holder(RectLike::Label("x")) {
        RectHolder::SomeRect(RectLike::Sized { w, h }, n) => w * 100 + h * 10 + n,
        RectHolder::SomeRect(RectLike::Label(s), n) => n,
        _ => -1,
    }
    assert_eq(result, 5)
}

enum L3 { Zero3, Two3(int, int), Text3(string) }
enum L2 { Zero2, Wrap2(L3, int) }
enum L1 { Zero1, Top1(int, L2) }

fn three_levels(inner: L3) -> L1 {
    return L1::Top1(1, L2::Wrap2(inner, 6))
}

@test
fn nested_flat_enum_three_levels() {
    let result = match three_levels(L3::Two3(2, 3)) {
        L1::Top1(a, L2::Wrap2(L3::Two3(x, y), b)) => a * 1000 + x * 100 + y * 10 + b,
        _ => -1,
    }
    assert_eq(result, 1236)
}

@test
fn nested_flat_enum_three_levels_reject_innermost() {
    let result = match three_levels(L3::Text3("deep")) {
        L1::Top1(a, L2::Wrap2(L3::Two3(x, y), b)) => a * 1000 + x * 100 + y * 10 + b,
        L1::Top1(a, L2::Wrap2(L3::Text3(s), b)) => a + b,
        _ => -1,
    }
    assert_eq(result, 7)
}

co fn nested_flat_enum_after_yield() -> Coroutine<int> {
    yield 0
    match slot_holder(InnerLeaf::Pair(3, 4)) {
        SlotHolder::Held(lead, InnerLeaf::Pair(x, y), trail) => {
            yield lead * 1000 + x * 100 + y * 10 + trail
        },
        _ => { yield -1 },
    }
    match three_levels(L3::Two3(2, 3)) {
        L1::Top1(a, L2::Wrap2(L3::Two3(x, y), b)) => { yield a * 1000 + x * 100 + y * 10 + b },
        _ => { yield -2 },
    }
    match rect_holder(RectLike::Sized { w: 12, h: 3 }) {
        RectHolder::SomeRect(RectLike::Sized { w, h }, n) => { yield w * 100 + h * 10 + n },
        _ => { yield -3 },
    }
}

@test
fn nested_flat_enum_patterns_survive_suspension() {
    let c = nested_flat_enum_after_yield()
    assert_eq(c.resume() ?? -9, 0)
    assert_eq(c.resume() ?? -9, 7349)
    assert_eq(c.resume() ?? -9, 1236)
    assert_eq(c.resume() ?? -9, 1235)
}
