// Matching on a nullable scrutinee: `null` is its own pattern, structural
// patterns match the unwrapped value, and ARM ORDER does not matter -- an arm
// that tests structure misses nil instead of reading through it (a tuple
// index or range compare on nil would be a runtime error).

enum Sig {
    Idle,
    Num(int),
}

fn describe_sig(s: Sig?) -> int {
    match s {
        null => -1,
        Sig::Idle => 0,
        Sig::Num(x) => x,
    }
}

@test
fn null_arm_first() {
    let none: Sig? = null
    assert_eq(describe_sig(none), -1)
    assert_eq(describe_sig(Sig::Idle), 0)
    assert_eq(describe_sig(Sig::Num(9)), 9)
}

@test(output = "none\nc5")
fn enum_arm_before_null_arm() {
    fn tag(s: Sig?) -> string {
        match s {
            Sig::Num(r) => "c{r}",
            null => "none",
            _ => "idle",
        }
    }
    let none: Sig? = null
    print(tag(none))
    print(tag(Sig::Num(5)))
}

@test(output = "none\n7 0")
fn tuple_arm_before_null_arm() {
    fn first(t: (int, int)?) -> string {
        match t {
            (a, 0) => "{a} 0",
            null => "none",
            (a, b) => "{a} {b}",
        }
    }
    let none: (int, int)? = null
    print(first(none))
    print(first((7, 0)))
}

@test(output = "none\nsmall\nother")
fn range_arm_before_null_arm() {
    fn size(n: int?) -> string {
        match n {
            1..=9 => "small",
            null => "none",
            _ => "other",
        }
    }
    let none: int? = null
    print(size(none))
    print(size(3))
    print(size(100))
}
