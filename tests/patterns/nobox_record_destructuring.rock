nobox value Leaf { a: int, b: string }
value Parent { k: int, l: Leaf, z: int }
nobox value UnboxedParent { k: int, l: Leaf }
value OptionalParent { k: int, l: Leaf? }
enum Event { Data(Leaf), Empty }
struct EventBox { event: Event }

@test fn let_flattened_child() {
    let m = Parent { k: 1, l: Leaf { a: 2, b: "five" }, z: 3 }
    let Parent { k, l, z } = m
    assert(k == 1 && l.a == 2 && l.b == "five" && z == 3)
}

@test fn let_nested_flattened_child() {
    let m = Parent { k: 1, l: Leaf { a: 2, b: "five" }, z: 3 }
    let Parent { l: Leaf { a, .. }, .. } = m
    assert_eq(a, 2)
}

@test fn for_flattened_child() {
    let v = [Parent { k: 1, l: Leaf { a: 2, b: "five" }, z: 3 }]
    let sum = 0
    for Parent { l, .. } in v {
        sum += l.a
        assert_eq(l.b, "five")
    }
    assert_eq(sum, 2)
}

@test fn let_and_for_unboxed_parent() {
    let m = UnboxedParent { k: 1, l: Leaf { a: 2, b: "five" } }
    let UnboxedParent { k, l } = m
    let UnboxedParent { l: Leaf { a, .. }, .. } = m
    assert(k == 1 && l.a == 2 && a == 2)

    let sum = 0
    for UnboxedParent { l, .. } in [m] {
        sum += l.a
        assert_eq(l.b, "five")
    }
    assert_eq(sum, 2)
}

@test fn destructure_nullable_flattened_child() {
    let OptionalParent { l: present, .. } = OptionalParent { k: 1, l: Leaf { a: 2, b: "five" } }
    let OptionalParent { l: absent, .. } = OptionalParent { k: 1, l: null }
    if let Leaf { a, b } = present {
        assert(a == 2 && b == "five")
    } else {
        assert(false)
    }
    assert(absent == null)
}

fn envelope() -> EventBox {
    return EventBox { event: Event::Data(Leaf { a: 2, b: "five" }) }
}

@test fn destructure_flattened_enum_field() {
    let EventBox { event } = envelope()
    assert_eq(match event {
        Event::Data(l) => l.a,
        Event::Empty => -1,
    }, 2)
    assert_eq(match envelope() {
        EventBox { event: Event::Data(l) } => l.b,
        _ => "empty",
    }, "five")
}
