// Same-concrete-enum == / != specialization: payloadless enums compare
// natively and payloaded enums call a per-enum equality instead of the
// generic __op_eq dispatch. The second half covers adversarial shapes: enum
// fields, nullable refinement, containers, map keys and tuples.

enum TileType { Floor, Wall, Water }
enum AiState { Idle, Wander, Chase }

enum Msg {
    Ping,
    Val(int),
    Str(string),
}

@test
fn test_payloadless_same_variant() {
    let a = TileType::Wall
    let b = TileType::Wall
    assert_eq(a == b, true)
    assert_eq(a != b, false)
}

@test
fn test_payloadless_different_variants() {
    let a = TileType::Floor
    let b = TileType::Water
    assert_eq(a == b, false)
    assert_eq(a != b, true)
}

@test
fn test_payloadless_variable_vs_literal() {
    let t = TileType::Wall
    assert_eq(t == TileType::Wall, true)
    assert_eq(TileType::Wall == t, true)
    assert_eq(t == TileType::Floor, false)
    assert_eq(TileType::Floor != t, true)
}

@test
fn test_payloadless_in_if() {
    let state = AiState::Wander
    let result = 0
    if state == AiState::Wander {
        result = 1
    }
    assert_eq(result, 1)
    if state != AiState::Idle {
        result = 2
    }
    assert_eq(result, 2)
}

@test
fn test_payloaded_same_payload() {
    let a = Msg::Val(5)
    let b = Msg::Val(5)
    assert_eq(a == b, true)
}

@test
fn test_payloaded_different_payload() {
    let a = Msg::Val(5)
    let b = Msg::Val(6)
    assert_eq(a == b, false)
    assert_eq(a != b, true)
}

@test
fn test_payloaded_different_variants() {
    let a = Msg::Val(5)
    let b = Msg::Str("hi")
    assert_eq(a == b, false)
}

@test
fn test_payloaded_vs_unit_variant() {
    let a = Msg::Ping
    let b = Msg::Val(0)
    assert_eq(a == b, false)
    assert_eq(a != b, true)
}

@test
fn test_mixed_enum_with_units_and_payloads() {
    let a = Msg::Ping
    let b = Msg::Ping
    assert_eq(a == b, true)
}

// Moved from enum_tuple_variants.rock: loop + match over heterogeneous vec
enum Shape {
    Point,
    Line(float, float, float, float),
    Circle(float, float, float),
}

@test
fn test_tuple_variant_nested_match() {
    let shapes = [
        Shape::Point,
        Shape::Line(0.0, 0.0, 5.0, 5.0),
        Shape::Circle(10.0, 10.0, 2.5),
    ]

    for shape in shapes {
        match shape {
            Shape::Point => print("Got a point"),
            Shape::Line(_, _, x2, y2) => print("Line ends at ({x2}, {y2})"),
            Shape::Circle(_, _, radius) => print("Circle with radius {radius}"),
        }
    }
}

enum Message {
    Quit,
    Move(int, int),
    Write(string),
    ChangeColor(int, int, int),
}

@test
fn test_mixed_variant_types() {
    let msg = Message::Move(10, 20)

    match msg {
        Message::Quit => print("Quit"),
        Message::Move(x, y) => {
            assert_eq(x, 10)
            assert_eq(y, 20)
            print("Move to ({x}, {y})")
        }
        Message::Write(text) => print("Write: {text}"),
        Message::ChangeColor(r, g, b) => print("Color: ({r}, {g}, {b})"),
    }
}

enum Color { Red, Green, Blue }
enum Tag { A, B, C }

struct Item {
    color: Color,
    tag: Tag,
}

enum HeldShape {
    Point,
    Circle(int),
    Rect(int, int),
}

struct Holder {
    shape: HeldShape,
}

// Case 1: enum stored in a struct field, compared to a literal.
@test
fn test_enum_field_vs_literal() {
    let item = Item { color: Color::Red, tag: Tag::B }
    assert_eq(item.color == Color::Red, true)
    assert_eq(item.color == Color::Green, false)
    assert_eq(item.tag != Tag::A, true)
}

// Case 2: enum in nullable via null check refines to concrete.
@test
fn test_nullable_refinement() {
    let maybe: Color? = Color::Blue
    if maybe != null {
        assert_eq(maybe == Color::Blue, true)
        assert_eq(maybe == Color::Red, false)
    }
}

// Case 3: enum ?? default, then compared (result is concrete Color).
@test
fn test_null_coalesce_then_eq() {
    let maybe: Color? = null
    let c = maybe ?? Color::Green
    assert_eq(c == Color::Green, true)
    assert_eq(c != Color::Red, true)
}

// Case 4: enum comparisons chained with && and ||.
@test
fn test_chained_conditions() {
    let a = Color::Red
    let b = Tag::C
    assert_eq(a == Color::Red && b == Tag::C, true)
    assert_eq(a == Color::Red || b == Tag::A, true)
    assert_eq(a == Color::Green || b == Tag::A, false)
}

// Case 5: enum in a Vec and iterated.
@test
fn test_enum_in_vec() {
    let xs: [Color] = [Color::Red, Color::Green, Color::Blue, Color::Red]
    let count = 0
    let matches = 0
    for c in xs {
        count = count + 1
        if c == Color::Red {
            matches = matches + 1
        }
    }

    assert_eq(count, 4)
    assert_eq(matches, 2)
    assert_eq(xs[0] == Color::Red, true)
    assert_eq(xs[1] == Color::Green, true)
    assert_eq(xs[2] == Color::Blue, true)
    assert_eq(xs[3] == Color::Red, true)

    let indexed_matches = 0
    let idx = 0
    while idx < 4 {
        if xs[idx] == Color::Red {
            indexed_matches = indexed_matches + 1
        }
        idx = idx + 1
    }
    assert_eq(indexed_matches, 2)
}

// Case 6: payloaded enum stored in a struct, compared via fast path (==).
@test
fn test_payloaded_struct_field() {
    let h1 = Holder { shape: HeldShape::Circle(5) }
    let h2 = Holder { shape: HeldShape::Circle(5) }
    let h3 = Holder { shape: HeldShape::Rect(2, 3) }
    assert_eq(h1.shape == h2.shape, true)
    assert_eq(h1.shape == h3.shape, false)
    assert_eq(h1.shape != h3.shape, true)
}

// Case 7: match-like eq dispatch pattern.
@test
fn test_match_like_eq() {
    let c = Color::Green
    let name = if c == Color::Red { "r" } else if c == Color::Green { "g" } else { "b" }
    assert_eq(name, "g")
}

// Case 8: map with enum keys — exercises equality in map key paths.
@test
fn test_enum_as_map_key() {
    let m = map_new()
    m[Color::Red] = 1
    m[Color::Green] = 2
    assert_eq(m[Color::Red], 1)
    assert_eq(m[Color::Green], 2)
}

// Case 9: same-singleton identity via function roundtrip.
fn return_red() -> Color {
    Color::Red
}

@test
fn test_singleton_identity_via_fn() {
    let a = return_red()
    let b = Color::Red
    assert_eq(a == b, true)
    assert_eq(b == a, true)
}

// Case 10: unit-enum comparison inside a generic container element.
@test
fn test_enum_in_tuple() {
    let t = (Color::Red, 1)
    assert_eq(t.0 == Color::Red, true)
    assert_eq(t.0 != Color::Green, true)
}

// Case 11: payloaded variant with nested struct equality.
struct Pt { x: int, y: int }
enum Geo { Empty, Dot(Pt) }

@test
fn test_payloaded_with_struct() {
    let a = Geo::Dot(Pt { x: 1, y: 2 })
    let b = Geo::Dot(Pt { x: 1, y: 2 })
    let c = Geo::Dot(Pt { x: 1, y: 3 })
    // Same-type payloaded == goes through __op_eq_Geo -> compares field via __op_eq recursively.
    assert_eq(a == b, true)
    assert_eq(a == c, false)
    assert_eq(a == Geo::Empty, false)
}
