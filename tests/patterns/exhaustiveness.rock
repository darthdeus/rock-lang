// Match exhaustiveness: integer literal, range, open-range and or-pattern
// arms with and without a wildcard, then enum, generic enum and bool
// matches without one.

@test 
fn test_simple_range_pattern() {
    let x = 5
    
    // Test basic range parsing
    let result = match x {
        1..=10 => "small",
        _ => "other"
    }
    
    assert_eq(result, "small")
    print("Simple range pattern test passed")
}

@test
fn test_exhaustive_age_ranges() {
    let age = 25
    
    let category = match age {
        0..=17 => "minor"
        18..=64 => "adult"
        65.. => "senior"
        _ => "invalid"
    }
    
    assert_eq(category, "adult")
    print("Age range exhaustiveness test passed")
}

@test
fn test_exhaustive_grade_ranges() {
    let grade = 85
    
    let letter = match grade {
        0..=59 => "F"
        60..=69 => "D"
        70..=79 => "C"
        80..=89 => "B"
        90..=100 => "A"
        _ => "Invalid"
    }
    
    assert_eq(letter, "B")
    print("Grade range exhaustiveness test passed")
}

@test
fn test_mixed_literal_and_range() {
    let number = 5
    
    let description = match number {
        0 => "zero"
        1..=10 => "small"
        11..=100 => "medium"
        _ => "other"
    }
    
    assert_eq(description, "small")
    print("Mixed literal and range test passed")
}

@test
fn test_literal_and_range_mix() {
    let x = 0
    
    // Mix of literals and ranges should work
    let result = match x {
        ..=-1 => "negative",
        0 => "zero",
        1..=5 => "small",
        6.. => "large"  
    }
    
    assert_eq(result, "zero")
    print("Literal and range mix test passed")
}

@test
fn test_adjacent_ranges() {
    let score = 85
    
    // Adjacent ranges with no gaps
    let grade = match score {
        ..=-1 => "Invalid_negative",
        0..=59 => "F",
        60..=69 => "D", 
        70..=79 => "C",
        80..=89 => "B",
        90..=100 => "A",
        101.. => "Invalid_high"
    }
    
    assert_eq(grade, "B")
    print("Adjacent ranges test passed")
}

@test
fn test_inclusive_vs_exclusive() {
    let num = 10
    
    // Test both inclusive and exclusive ranges
    let category = match num {
        ..=-1 => "negative",
        0..5 => "very_small",
        5..=10 => "medium",
        11.. => "large"
    }
    
    assert_eq(category, "medium")
    print("Inclusive vs exclusive ranges test passed")
}

@test 
fn test_exhaustive_integer_coverage() {
    let x = 5
    
    // This should be exhaustive - covers all integers
    let result = match x {
        ..=0 => "negative_or_zero",
        1..=10 => "small_positive", 
        11.. => "large_positive"
    }
    
    assert_eq(result, "small_positive")
    print("Exhaustive integer coverage test passed")
}

@test
fn test_single_wildcard_exhaustive() {
    let x = 42
    
    // Wildcard should make any integer match exhaustive
    let result = match x {
        1..=10 => "small",
        _ => "other"
    }
    
    assert_eq(result, "other")
    print("Wildcard integer exhaustiveness test passed")
}

@test
fn test_negative_ranges_exhaustive() {
    let x = -5

    let result = match x {
        ..=-10 => "very_negative",
        -9..=-1 => "negative",
        0 => "zero",
        1.. => "positive"
    }

    assert_eq(result, "negative")
}

@test
fn test_or_pattern_ranges_exhaustive() {
    let x = 2

    let result = match x {
        ..=1 | 3.. => "not_two",
        2 => "two"
    }

    assert_eq(result, "two")
}

@test
fn test_overlapping_ranges_exhaustive() {
    let x = 7

    let result = match x {
        ..=10 => "low",
        5.. => "high"
    }

    assert_eq(result, "low")
}

@test
fn test_guarded_arm_with_binding_catch_all() {
    let x = 12

    let result = match x {
        n if n > 10 => "big",
        1..=10 => "small",
        n => "other"
    }

    assert_eq(result, "big")
}

enum Status { 
    Pending, 
    Running, 
    Complete, 
    Failed 
}

enum Option<T> {
    None,
    Some(T),
}

@test
fn test_exhaustive_enum_matching() {
    let status = Status::Pending
    
    // This should compile without wildcards
    let message = match status {
        Status::Pending => "waiting",
        Status::Running => "in progress", 
        Status::Complete => "done",
        Status::Failed => "error"
    }
    
    assert_eq(message, "waiting")
    print("Exhaustive enum test passed")
}

@test  
fn test_exhaustive_generic_enum() {
    let result: Option<int> = Option::Some(42)
    
    // This should compile without wildcards for generic enums too
    let value = match result {
        Option::None => 0,
        Option::Some(n) => n
    }
    
    assert_eq(value, 42)
    print("Exhaustive generic enum test passed")
}

@test
fn test_bool_exhaustiveness() {
    let flag = true
    
    // Bool should be exhaustively checkable
    let result = match flag {
        true => "yes",
        false => "no"
    }
    
    assert_eq(result, "yes")
    print("Bool exhaustiveness test passed")
}
