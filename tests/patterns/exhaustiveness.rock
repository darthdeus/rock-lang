// Match exhaustiveness: integer literal, range, open-range and or-pattern
// arms with and without a wildcard, then enum and generic enum matches
// without one.


@test
fn test_exhaustive_age_ranges() {
    let age = 25

    let category = match age {
        0..=17 => "minor"
        18..=64 => "adult"
        65.. => "senior"
        _ => "invalid"
    }

    assert_eq(category, "adult")
}

@test
fn test_literal_and_range_coverage() {
    // One exhaustive mix of literals, inclusive, exclusive and open ranges,
    // with every arm exercised (the old suite proved each shape compiled and
    // then checked a single input apiece).
    fn describe(x: int) -> string {
        match x {
            ..=-10 => "very_negative",
            -9..=-1 => "negative",
            0 => "zero",
            1..5 => "very_small",
            5..=10 => "medium",
            11..=100 => "large",
            101.. => "huge",
        }
    }
    assert_eq(describe(-10), "very_negative")
    assert_eq(describe(-5), "negative")
    assert_eq(describe(0), "zero")
    assert_eq(describe(4), "very_small")
    assert_eq(describe(5), "medium")
    assert_eq(describe(10), "medium")
    assert_eq(describe(85), "large")
    assert_eq(describe(101), "huge")
}

@test
fn test_or_pattern_ranges_exhaustive() {
    let x = 2

    let result = match x {
        ..=1 | 3.. => "not_two",
        2 => "two"
    }

    assert_eq(result, "two")
}

@test
fn test_overlapping_ranges_exhaustive() {
    let x = 7

    let result = match x {
        ..=10 => "low",
        5.. => "high"
    }

    assert_eq(result, "low")
}

@test
fn test_guarded_arm_with_binding_catch_all() {
    let x = 12

    let result = match x {
        n if n > 10 => "big",
        1..=10 => "small",
        n => "other"
    }

    assert_eq(result, "big")
}

enum Status {
    Pending,
    Running,
    Complete,
    Failed
}

enum Option<T> {
    None,
    Some(T),
}

@test
fn test_exhaustive_enum_matching() {
    let status = Status::Pending

    // This should compile without wildcards
    let message = match status {
        Status::Pending => "waiting",
        Status::Running => "in progress",
        Status::Complete => "done",
        Status::Failed => "error"
    }

    assert_eq(message, "waiting")
}

@test
fn test_exhaustive_generic_enum() {
    let result: Option<int> = Option::Some(42)

    // This should compile without wildcards for generic enums too
    let value = match result {
        Option::None => 0,
        Option::Some(n) => n
    }

    assert_eq(value, 42)
}
