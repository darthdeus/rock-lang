// Test shorthand field initialization syntax

struct Point {
    x: int
    y: int
}

struct Person {
    name: string
    age: int
    location: Point
}

@test
fn test_basic_shorthand() {
    let x = 10
    let y = 20

    // Shorthand syntax
    let p1 = Point { x, y }

    // Should be equivalent to explicit syntax
    let p2 = Point { x: x, y: y }

    assert_eq(p1.x, p2.x)
    assert_eq(p1.y, p2.y)
    assert_eq(p1.x, 10)
    assert_eq(p1.y, 20)
}

@test
fn test_mixed_shorthand_and_explicit() {
    let x = 5

    // Mix shorthand and explicit
    let p = Point { x, y: 15 }

    assert_eq(p.x, 5)
    assert_eq(p.y, 15)
}

@test
fn test_nested_struct_shorthand() {
    let name = "Alice"
    let age = 30
    let x = 100
    let y = 200
    let location = Point { x, y }

    // Use shorthand for nested struct
    let person = Person { name, age, location }

    assert_eq(person.name, "Alice")
    assert_eq(person.age, 30)
    assert_eq(person.location.x, 100)
    assert_eq(person.location.y, 200)
}

enum Color {
    RGB { r: int, g: int, b: int }
    HSL { h: int, s: int, l: int }
}

@test
fn test_enum_variant_shorthand() {
    let r = 255
    let g = 128
    let b = 0

    // Shorthand for enum variant with record fields
    let color1 = Color::RGB { r, g, b }

    // Should be equivalent to explicit
    let color2 = Color::RGB { r: r, g: g, b: b }

    // Pattern matching with enum variants has a separate issue
    // so we'll just test construction here
    // For now, we can only verify that construction works
    assert(true)  // Construction succeeded if we got here
}

@test
fn test_shorthand_with_expressions() {
    let base = 10

    // Shorthand only works with simple identifiers
    // These should use explicit syntax
    let p = Point {
        x: base * 2,  // expression, not shorthand
        y: base + 5   // expression, not shorthand
    }

    assert_eq(p.x, 20)
    assert_eq(p.y, 15)
}

fn main() {
    test_basic_shorthand()
    test_mixed_shorthand_and_explicit()
    test_nested_struct_shorthand()
    test_enum_variant_shorthand()
    test_shorthand_with_expressions()
    print("All shorthand field tests passed!")
}
