// Escape-site rematerialization (value-two-tier item 8): SROA rebuilds an
// escaping whole-value load of a NON-nullable value binding at the use site.
// The gate is a lowering-stamped per-cell flag; a `V?` binding is never
// flagged, so a nullable value load stays boxed (no rebuild-from-nil).
//
// Every case asserts a RUNTIME VALUE. The nullable/alias shapes here are the
// ones the ungated probe MISCOMPILED (FFI-clean crashed in the `_ct` ctor,
// GC-carrying silently returned a bogus non-null value); they must stay GREEN.
//
// Two tiers exercised: FFI-clean `Pair` (all C-mappable -> `_ct`) and
// GC-carrying `Bag` (a `[int]` field -> immutable-table `_vt`).

value Pair { a: int, b: int }
value Bag { xs: [int] }

fn bag_head(b: Bag) -> int { return b.xs[0] }

// ----- 1. Nullable pick, both branches, both tiers. `v: V?` binding is
// nullable -> NOT flagged -> stays boxed; the null branch must return null.

fn pick_pair(c: bool) -> Pair? {
    let v: Pair? = null
    if c { v = Pair { a: 1, b: 2 } }
    return v
}

fn pick_bag(c: bool) -> Bag? {
    let v: Bag? = null
    if c { v = Bag { xs: [9] } }
    return v
}

@test(output = "3\n-1\n9\n-1")
fn nullable_pick_both_tiers() {
    let p = pick_pair(true)
    print(if p != null { p.a + p.b } else { -1 })     // 1+2 = 3
    let pn = pick_pair(false)
    print(if pn != null { pn.a + pn.b } else { -1 })   // null -> -1
    let b = pick_bag(true)
    print(if b != null { bag_head(b) } else { -1 })    // 9
    let bn = pick_bag(false)
    print(if bn != null { bag_head(bn) } else { -1 })  // null -> -1
}

// ----- 2. Cross-block alias of a nullable root (the shape the "no nil store on
// the escaping cell" heuristic would miscompile). `let c = r` aliases a nullable
// binding; on the null path `c` must be null.

fn alias_pair(cond: bool, side: bool) -> Pair? {
    let r: Pair? = null
    if cond { r = Pair { a: 4, b: 5 } }
    let c = r
    if side { let _ = 0 }
    return c
}

fn alias_bag(cond: bool, side: bool) -> Bag? {
    let r: Bag? = null
    if cond { r = Bag { xs: [8] } }
    let c = r
    if side { let _ = 0 }
    return c
}

@test(output = "9\n-1\n8\n-1")
fn alias_of_nullable_both_tiers() {
    let p = alias_pair(true, true)
    print(if p != null { p.a + p.b } else { -1 })     // 4+5 = 9
    let pn = alias_pair(false, true)
    print(if pn != null { pn.a + pn.b } else { -1 })   // null -> -1
    let b = alias_bag(true, true)
    print(if b != null { bag_head(b) } else { -1 })    // 8
    let bn = alias_bag(false, true)
    print(if bn != null { bag_head(bn) } else { -1 })  // null -> -1
}

// ----- 3. Refined nullable: `if v != null { return v }`. The binding is `V?`
// (unflagged) even inside the refined region -- refinement is not plumbed to
// MIR -- so no rebuild; the value must survive the boxed passthrough.

fn passthru_pair(v: Pair?) -> Pair? {
    if v != null { return v }
    return null
}

fn passthru_bag(v: Bag?) -> Bag? {
    if v != null { return v }
    return null
}

@test(output = "30\n-1\n5\n-1")
fn refined_nullable_both_tiers() {
    let p = passthru_pair(Pair { a: 10, b: 20 })
    print(if p != null { p.a + p.b } else { -1 })     // 30
    let pn = passthru_pair(null)
    print(if pn != null { pn.a + pn.b } else { -1 })   // -1
    let b = passthru_bag(Bag { xs: [5] })
    print(if b != null { bag_head(b) } else { -1 })    // 5
    let bn = passthru_bag(null)
    print(if bn != null { bag_head(bn) } else { -1 })  // -1
}

// ----- 4. The SOUND remat case: a non-null value binding that escapes on a hit
// path and not on misses. Arena scan returning the matching Entity (the door_at
// shape) -- MISS returns null (crosses the done-sentinel nil), HIT the entity.

struct Cell { tag: int }
global CELLS: Arena<Cell> = arena_new()

fn find_cell(want: int) -> Entity<Cell>? {
    for (e, cell) in CELLS {
        if cell.tag == want { return e }
    }
    return null
}

@test(output = "20\n-1")
fn arena_scan_hit_and_miss() {
    CELLS.clear()
    let _ = CELLS.insert(Cell { tag: 10 })
    let _ = CELLS.insert(Cell { tag: 20 })
    let hit = find_cell(20)
    print(if hit != null { hit.get().unwrap().tag } else { -1 })   // 20
    let miss = find_cell(99)
    print(if miss != null { miss.get().unwrap().tag } else { -1 })  // null -> -1
}
