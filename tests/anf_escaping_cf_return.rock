// Item G — escaping-CF value-position block-expr.
//
// A `return` inside a value-position block-expr escapes the
// enclosing fn:
// production live emits `local lv; do <stmts>; lv = tail end`
// via `full-anf` hoisting, NOT the theoretical
// `(function() ... return v ... end)()` IIFE in `generate_block_expr`
// which is dead on the hot path. So `return v` is emitted as a real
// Lua `return v` inside the `do`, which leaves the fn.
//
// `f(5)`:
//   - The block-expr fires `return 100`; the fn returns 100.
// `f(-1)`:
//   - The block-expr's else-arm yields 5; `y = 5 + 1 = 6`;
//     the fn returns 6.

@test(output = "100\n6")
fn test_escaping_return_to_block() {
    print(f(5))
    print(f(-1))
}

fn f(x: int) -> int {
    let y = {
        if x > 0 { return 100 }
        let v = 5
        v
    } + 1
    y
}
