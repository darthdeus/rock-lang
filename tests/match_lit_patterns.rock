@test(output = "neg
zero
pos
pi")
fn match_negative_int_pattern() {
    let xs: [int] = [-1, 0, 1]
    for x in xs {
        match x {
            -1 => print("neg"),
            0 => print("zero"),
            1 => print("pos"),
            _ => print("other"),
        }
    }
    let f: float = 3.14
    match f {
        3.14 => print("pi"),
        _ => print("other"),
    }
}
