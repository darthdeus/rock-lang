@test
fn test_int_to_float_cast() {
    let int_value: int = 42
    let float_value: float = int_value as float
    assert_eq(float_value, 42.0)
}

@test
fn test_float_to_int_cast() {
    let float_value: float = 3.14
    let int_value = float_value as int

    assert(int_value == 3)
}

@test
fn test_identity_cast() {
    let int_value: int = 42
    let int_as_int: int = int_value as int
    assert_eq(int_as_int, 42)
}

@test
fn test_cast_with_operations() {
    let int_value: int = 10
    let float_value: float = 5.5
    let result = (int_value as float) + float_value
    assert_eq(result, 15.5)
}
