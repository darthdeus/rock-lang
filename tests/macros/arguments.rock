// Macro argument binding: labels bind by name exactly as in a fn call,
// defaults fill skipped params, and splat and spread forward caller
// expressions without substituting into them.

fn _bind3(a: int, b: int, c: int) -> string {
    return "{a}/{b}/{c}"
}

macro bind3(a: expr, b: expr = 20, c: expr = 30) -> string {
    _bind3(a, b, c)
}

// The control: same shape, but a fn. Every assertion below must hold for both.
fn bind3_fn(a: int, b: int = 20, c: int = 30) -> string {
    return "{a}/{b}/{c}"
}

@test
fn label_skips_a_defaulted_param() {
    assert(bind3(1, c: 3) == "1/20/3", "macro: {bind3(1, c: 3)}")
    assert(bind3_fn(1, c: 3) == "1/20/3", "fn: {bind3_fn(1, c: 3)}")
}

@test
fn labels_may_be_given_out_of_order() {
    assert(bind3(1, c: 3, b: 2) == "1/2/3", "macro: {bind3(1, c: 3, b: 2)}")
    assert(bind3_fn(1, c: 3, b: 2) == "1/2/3", "fn: {bind3_fn(1, c: 3, b: 2)}")
}

@test
fn positional_and_labelled_mix() {
    assert(bind3(1, 2, c: 3) == "1/2/3", "macro: {bind3(1, 2, c: 3)}")
    assert(bind3_fn(1, 2, c: 3) == "1/2/3", "fn: {bind3_fn(1, 2, c: 3)}")
}

@test
fn all_positional_is_unchanged() {
    assert(bind3(1, 2, 3) == "1/2/3", "macro: {bind3(1, 2, 3)}")
    assert(bind3(1) == "1/20/30", "macro: {bind3(1)}")
    assert(bind3(1, 2) == "1/2/30", "macro: {bind3(1, 2)}")
}

// A label naming the first parameter binds it, leaving the rest on defaults.
@test
fn label_may_name_the_first_param() {
    assert(bind3(a: 7) == "7/20/30", "macro: {bind3(a: 7)}")
}

// UFCS puts the receiver in the first slot positionally; labels still apply to
// the parameters after it.
struct Box { n: int }

fn _boxed(b: Box, k: int, j: int) -> string {
    return "{b.n}:{k}:{j}"
}

macro boxed(b: expr, k: expr = 5, j: expr = 9) -> string {
    _boxed(b, k, j)
}

@test
fn ufcs_receiver_plus_label() {
    let b = Box { n: 1 }
    assert(b.boxed(j: 3) == "1:5:3", "got {b.boxed(j: 3)}")
}

macro sp_count() -> int {
    0
}

macro sp_count(x: expr, rest: ...expr) -> int {
    1 + sp_count(...rest)
}

macro sp_sum() -> int {
    0
}

macro sp_sum(x: expr, rest: ...expr) -> int {
    if true {
        let partial = {
            x + sp_sum(...rest)
        }
        partial
    } else {
        0
    }
}

// A forwarded arg is the caller's expression: the macro's own `x` param must
// not be substituted into a caller variable that happens to be named `x`.
@test
fn test_splatted_args_are_not_substituted() {
    let x = 10
    assert(sp_sum(1, x) == 11, "1 + caller's x")
}

macro sp_in_lambda(rest: ...expr) -> int {
    let f = () => sp_count(...rest)
    f()
}

@test
fn test_splat_in_lambda_body() {
    assert(sp_in_lambda(7, 8, 9) == 3, "three captured args")
    assert(sp_in_lambda() == 0, "no captured args")
}

macro sp_id(v: expr) -> int {
    v
}

macro sp_shadowed(rest: ...expr) -> int {
    let outer = sp_count(...rest)
    let inner = {
        let rest = 40
        sp_id(...rest)
    }
    outer + inner
}

@test
fn test_body_local_named_like_variadic_is_not_splatted() {
    assert(sp_shadowed(1, 2) == 42, "2 captured args + local 40")
}

struct AB { a: int, b: int }

fn sum2(a: int, b: int) -> int { a + b }

macro bundled(p: expr) {
    sum2(..p)
}

@test(output = "3")
fn test_spread_in_macro() {
    let props = AB { a: 1, b: 2 }
    print(bundled(props))
}
