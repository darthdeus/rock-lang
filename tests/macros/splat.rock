// Splat and spread in macros.

macro sp_count() -> int {
    0
}

macro sp_count(x: expr, rest: ...expr) -> int {
    1 + sp_count(...rest)
}

macro sp_sum() -> int {
    0
}

macro sp_sum(x: expr, rest: ...expr) -> int {
    if true {
        let partial = {
            x + sp_sum(...rest)
        }
        partial
    } else {
        0
    }
}

@test
fn test_splat_in_nested_blocks() {
    assert(sp_sum(1, 2, 3, 4) == 10, "1 + 2 + 3 + 4")
}

// A forwarded arg is the caller's expression: the macro's own `x` param must
// not be substituted into a caller variable that happens to be named `x`.
@test
fn test_splatted_args_are_not_substituted() {
    let x = 10
    assert(sp_sum(1, x) == 11, "1 + caller's x")
}

macro sp_in_lambda(rest: ...expr) -> int {
    let f = () => sp_count(...rest)
    f()
}

@test
fn test_splat_in_lambda_body() {
    assert(sp_in_lambda(7, 8, 9) == 3, "three captured args")
    assert(sp_in_lambda() == 0, "no captured args")
}

macro sp_id(v: expr) -> int {
    v
}

macro sp_shadowed(rest: ...expr) -> int {
    let outer = sp_count(...rest)
    let inner = {
        let rest = 40
        sp_id(...rest)
    }
    outer + inner
}

@test
fn test_body_local_named_like_variadic_is_not_splatted() {
    assert(sp_shadowed(1, 2) == 42, "2 captured args + local 40")
}

struct AB { a: int, b: int }

fn sum2(a: int, b: int) -> int { a + b }

macro bundled(p: expr) {
    sum2(..p)
}

@test(output = "3")
fn test_spread_in_macro() {
    let props = AB { a: 1, b: 2 }
    print(bundled(props))
}
