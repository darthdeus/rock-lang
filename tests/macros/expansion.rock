// How a macro call expands: argument evaluation, assignment through params,
// fragment kinds, composition, return types, and macro calls in every
// expression and control-flow position.

global SIDE_EFFECT_COUNTER: int = 0

fn next_counter() -> int {
    SIDE_EFFECT_COUNTER = SIDE_EFFECT_COUNTER + 1
    SIDE_EFFECT_COUNTER
}

// A macro can assign through its params: the substituted caller places are
// written, and the body-local temporary cannot capture a caller `t`.
macro swap_places(a: expr, b: expr) {
    let t = a
    a = b
    b = t
}

@test
fn test_macro_assigns_through_params() {
    let x = 1
    let t = 2
    swap_places(x, t)
    assert(x == 2 && t == 1, "swap writes both caller locals")
}

macro double(x: expr) -> int {
    x + x
}

@test
fn test_side_effect_arg_evaluated_once() {
    SIDE_EFFECT_COUNTER = 0
    let result = double(next_counter())
    // Either substitution model is allowed, but the result must match it:
    // textual gives 1 + 2 with the counter at 2, let-bound gives 1 + 1.
    assert(SIDE_EFFECT_COUNTER == 1 || SIDE_EFFECT_COUNTER == 2, "counter advanced")
    if SIDE_EFFECT_COUNTER == 2 {
        assert(result == 3, "textual subst: 1 + 2 = 3")
    } else {
        assert(result == 2, "let-bound subst: 1 + 1 = 2")
    }
}

macro frag_only_expr(_x: expr) -> string {
    "expr_arm"
}

@test
fn test_fragment_kind_expr_accepts_anything() {
    assert(frag_only_expr(42) == "expr_arm", "literal")
    let v = 99
    assert(frag_only_expr(v) == "expr_arm", "ident")
    assert(frag_only_expr(next_counter()) == "expr_arm", "fn call")
    assert(frag_only_expr(1 + 2) == "expr_arm", "binary expr")
}

// `ident` and `expr` both resolve to TYPE_ANY, so `ident` also accepts a
// non-ident expression. Making `ident` syntactic would turn the second call
// into a compile error.
macro frag_pick_ident(_x: ident) -> string {
    "ident_arm"
}

@test
fn test_fragment_kind_ident_accepts_what() {
    let v = 99
    assert(frag_pick_ident(v) == "ident_arm", "ident accepts ident")
    assert(frag_pick_ident(42) == "ident_arm", "ident currently accepts non-ident exprs")
}

@test
fn test_macro_inside_if() {
    let r = if true { double(5) } else { 0 }
    assert(r == 10, "macro inside if-then branch")
}

macro returns_string(x: expr) -> string {
    "got_{x}"
}

macro returns_bool(x: expr) -> bool {
    x > 0
}

@test
fn test_macro_return_types() {
    assert(returns_string(42) == "got_42", "string return + interp")
    assert(returns_bool(5), "5 > 0")
    assert(!returns_bool(-3), "-3 not > 0")
}

// An unused param's arg may be dropped (textual) or evaluated once (let-bound).
macro ignores_arg(_x: expr) -> int {
    42
}

@test
fn test_unused_arg_still_evaluated() {
    SIDE_EFFECT_COUNTER = 0
    assert(ignores_arg(next_counter()) == 42, "body result ignores the arg")
    assert(SIDE_EFFECT_COUNTER == 0 || SIDE_EFFECT_COUNTER == 1, "evaluated at most once")
}

// Macro/fn name collisions are a compile error, pinned by
// `tests/errors/macros.rock.err`.

macro twice(x: expr) -> int { x + x }
macro pick(c: expr, a: expr, b: expr) -> int { if c { a } else { b } }

// === CONTROL FLOW EXPRESSIONS AS MACRO ARGS ===

@test
fn test_control_flow_exprs_as_macro_args() {
    assert(twice(if true { 5 } else { 0 }) == 10, "if-expr arg: 5+5=10")
    let n = 2
    let r = twice(match n {
        1 => 100
        2 => 50
        _ => 0
    })
    assert(r == 100, "match arg: 50+50=100")
    assert(twice({ let temp = 7; temp + 1 }) == 16, "block arg: 8+8=16")
}

// === MACRO IN CONTROL FLOW POSITIONS ===

@test
fn test_macro_in_control_flow_positions() {
    let r = if twice(2) == 4 { "yes" } else { "no" }
    assert(r == "yes", "macro in if condition")

    let sum = 0
    for i in 0..twice(2) {
        sum = sum + i
    }
    assert(sum == 6, "for 0..twice(2)=4: 0+1+2+3=6")

    let n = 0
    while twice(n) < 6 {
        n = n + 1
    }
    assert(n == 3, "loop until twice(n)>=6: n=3")

    let count = 0
    for _ in twice(0)..twice(3) {
        count = count + 1
    }
    assert(count == 6, "both range bounds: 0..6 = 6 iterations")
}

// === OPERATORS, ASSIGNMENT, INDEX ===

@test
fn test_macro_in_operator_positions() {
    assert(twice(3) * 10 + 1 == 61, "(3+3)*10+1 = 61")
    assert(-twice(5) == -10, "-(5+5) = -10")
    let p = (twice(4))
    assert(p == 8, "parenthesised macro call")
    let v = 10
    v = v + twice(5)
    assert(v == 20, "macro in RHS of assignment")
    let xs = [10, 20, 30, 40, 50]
    assert(xs[twice(1)] == 30, "macro as index expression")
    let none: int? = null
    assert((none ?? twice(5)) == 10, "?? right-hand side macro")
}

// === LAMBDAS, RETURN, NESTED, GENERIC CALLS ===

fn returns_via_macro(x: int) -> int {
    return twice(x)
}

fn first_of<T>(xs: [T]) -> T {
    xs[0]
}

@test
fn test_macro_in_call_positions() {
    let f = (n: int) => twice(n)
    assert(f(7) == 14, "lambda body containing macro call")
    assert(returns_via_macro(6) == 12, "return twice(6)")
    assert(pick(true, twice(twice(2)), 0) == 8, "macro nested 2 deep in macro arg position")
    assert(first_of([twice(3), twice(4), twice(5)]) == 6, "generic fn called with array of macro results")
}

// === COMPOUND LITERALS AND INTERPOLATION ===

struct Point { x: int, y: int }

@test
fn test_macro_inside_literals() {
    let p = Point { x: twice(3), y: twice(4) }
    assert(p.x == 6 && p.y == 8, "struct literal fields")
    assert("result is {twice(7)}" == "result is 14", "string interp containing macro")
    let xs = [twice(1), twice(2), twice(3)]
    assert(xs[0] == 2 && xs[1] == 4 && xs[2] == 6, "array literal")
    let t = (twice(1), twice(2), twice(3))
    assert(t.0 == 2 && t.1 == 4 && t.2 == 6, "tuple")
}

// === MACROS RETURNING NON-INT VALUES ===

macro mk_point() -> Point { Point { x: 10, y: 20 } }
macro maybe_int(b: expr) -> int? { if b { 42 } else { null } }
macro mk_vec() -> [int] { [1, 2, 3] }

@test
fn test_macro_returning_compound_values() {
    assert(mk_point().x == 10, "field access on macro-returned struct")
    assert((maybe_int(true) ?? 0) == 42, "coalesce on macro returning nullable")
    assert((maybe_int(false) ?? 0) == 0, "coalesce on macro returning null")
    assert(mk_vec().len() == 3, "method call on macro-returned vec")
}
