// Stress test: how macros interact with every Rock syntax construct.
// Each @test probes one construct. If a test fails, that's a real
// integration gap — investigate, don't soften.

macro twice(x: expr) -> int { x + x }
macro identity(x: expr) -> int { x }
macro pick(c: expr, a: expr, b: expr) -> int { if c { a } else { b } }

// === CONTROL FLOW EXPRESSIONS AS MACRO ARGS ===

@test
fn test_if_expr_as_macro_arg() {
    let r = twice(if true { 5 } else { 0 })
    assert(r == 10, "if-expr arg to macro: 5+5=10")
}

@test
fn test_match_expr_as_macro_arg() {
    let n = 2
    let r = twice(match n {
        1 => 100
        2 => 50
        _ => 0
    })
    assert(r == 100, "match arg: 50+50=100")
}

@test
fn test_block_expr_as_macro_arg() {
    let r = twice({ let temp = 7; temp + 1 })
    assert(r == 16, "block arg: 8+8=16")
}

// === MACRO IN CONTROL FLOW POSITIONS ===

@test
fn test_macro_in_if_condition() {
    let r = if twice(2) == 4 { "yes" } else { "no" }
    assert(r == "yes", "macro in if condition")
}

@test
fn test_macro_in_for_loop_iter() {
    let sum = 0
    for i in 0..twice(2) {
        sum = sum + i
    }
    assert(sum == 6, "for 0..twice(2)=4: 0+1+2+3=6")
}

@test
fn test_macro_in_while_condition() {
    let n = 0
    while twice(n) < 6 {
        n = n + 1
    }
    assert(n == 3, "loop until twice(n)>=6: n=3 (twice(3)=6)")
}

// === MACRO RETURN INSIDE EXPRESSIONS ===

@test
fn test_macro_in_binop() {
    let r = twice(3) * 10 + 1
    assert(r == 61, "(3+3)*10+1 = 61")
}

@test
fn test_macro_in_unary_neg() {
    let r = -twice(5)
    assert(r == -10, "-(5+5) = -10")
}

@test
fn test_macro_in_paren() {
    let r = (twice(4))
    assert(r == 8, "parenthesised macro call")
}

// === LAMBDAS ===

@test
fn test_macro_arg_inside_lambda_body() {
    let f = (n: int) => twice(n)
    assert(f(7) == 14, "lambda body containing macro call")
}

macro ignore_arg(_x: expr) -> int { 42 }

@test
fn test_macro_ignoring_arg() {
    // Macro that doesn't use its param; arg is just dropped.
    // (Passing a lambda here fails type inference because `expr` resolves
    // to `any` and Rock can't unify a lambda with any. Probe with a
    // plain int instead — the limitation is documented in macro plan.)
    let r = ignore_arg(99)
    assert(r == 42, "arg dropped because macro ignores it")
}

// === STRUCT LITERALS / FIELDS ===

struct Point { x: int, y: int }

@test
fn test_macro_inside_struct_literal_field() {
    let p = Point { x: twice(3), y: twice(4) }
    assert(p.x == 6, "field x")
    assert(p.y == 8, "field y")
}

macro mk_point() -> Point { Point { x: 10, y: 20 } }

@test
fn test_field_access_on_macro_call() {
    let p = mk_point()
    assert(p.x == 10, "field access on macro-returned struct")
}

// === STRING INTERPOLATION ===

@test
fn test_macro_inside_string_interp() {
    let s = "result is {twice(7)}"
    assert(s == "result is 14", "string interp containing macro")
}

// === ARRAY/VEC LITERALS ===

@test
fn test_macro_inside_array_literal() {
    let xs = [twice(1), twice(2), twice(3)]
    assert(xs[0] == 2, "[0]")
    assert(xs[1] == 4, "[1]")
    assert(xs[2] == 6, "[2]")
}

// === TUPLES ===

@test
fn test_macro_inside_tuple() {
    let t = (twice(1), twice(2), twice(3))
    assert(t.0 == 2, "tuple .0")
    assert(t.1 == 4, "tuple .1")
    assert(t.2 == 6, "tuple .2")
}

// === RANGE ===

@test
fn test_macro_in_range_bounds() {
    let count = 0
    for _ in twice(0)..twice(3) {
        count = count + 1
    }
    assert(count == 6, "0..6 = 6 iterations")
}

// === INDEX ===

@test
fn test_macro_as_index() {
    let xs = [10, 20, 30, 40, 50]
    let v = xs[twice(1)]    // index 2 → 30
    assert(v == 30, "macro as index expression")
}

// === NULLABLE / SAFE NAV / COALESCE ===

@test
fn test_macro_in_null_coalesce() {
    let n: int? = null
    let r = n ?? twice(5)
    assert(r == 10, "?? right-hand side macro")
}

macro maybe_int(b: expr) -> int? { if b { 42 } else { null } }

@test
fn test_safenav_on_macro_returning_nullable() {
    let r = maybe_int(true) ?? 0
    assert(r == 42, "safenav-style coalesce on macro return")
}

// === ASSIGNMENT ===

@test
fn test_macro_in_let_rhs() {
    let v = twice(11)
    assert(v == 22, "let bind macro return")
}

@test
fn test_macro_in_compound_assign() {
    let v = 10
    v = v + twice(5)
    assert(v == 20, "macro in RHS of assignment")
}

// === RETURN ===

fn returns_via_macro(x: int) -> int {
    return twice(x)
}

@test
fn test_macro_in_return_expr() {
    assert(returns_via_macro(6) == 12, "return twice(6)")
}

// === NESTED MACRO POSITIONS ===

@test
fn test_macro_in_macro_in_macro_arg() {
    // pick(true, twice(twice(2)), 0) = pick(true, 8, 0) = 8
    let r = pick(true, twice(twice(2)), 0)
    assert(r == 8, "macro nested 2 deep in macro arg position")
}

// === GENERICS ===

fn first_of<T>(xs: [T]) -> T {
    xs[0]
}

@test
fn test_macro_inside_generic_call() {
    let r = first_of([twice(3), twice(4), twice(5)])
    assert(r == 6, "generic fn called with array of macro results")
}

// === METHODS / UFCS ===

macro mk_vec() -> [int] { [1, 2, 3] }

@test
fn test_method_on_macro_returning_collection() {
    let v = mk_vec()
    assert(v.len() == 3, "method call on macro-returned vec")
}
