// How macro calls interact with Rock syntax constructs: control-flow
// expressions as args, and macro calls in every expression position.

macro twice(x: expr) -> int { x + x }
macro pick(c: expr, a: expr, b: expr) -> int { if c { a } else { b } }

// === CONTROL FLOW EXPRESSIONS AS MACRO ARGS ===

@test
fn test_control_flow_exprs_as_macro_args() {
    assert(twice(if true { 5 } else { 0 }) == 10, "if-expr arg: 5+5=10")
    let n = 2
    let r = twice(match n {
        1 => 100
        2 => 50
        _ => 0
    })
    assert(r == 100, "match arg: 50+50=100")
    assert(twice({ let temp = 7; temp + 1 }) == 16, "block arg: 8+8=16")
}

// === MACRO IN CONTROL FLOW POSITIONS ===

@test
fn test_macro_in_control_flow_positions() {
    let r = if twice(2) == 4 { "yes" } else { "no" }
    assert(r == "yes", "macro in if condition")

    let sum = 0
    for i in 0..twice(2) {
        sum = sum + i
    }
    assert(sum == 6, "for 0..twice(2)=4: 0+1+2+3=6")

    let n = 0
    while twice(n) < 6 {
        n = n + 1
    }
    assert(n == 3, "loop until twice(n)>=6: n=3")

    let count = 0
    for _ in twice(0)..twice(3) {
        count = count + 1
    }
    assert(count == 6, "both range bounds: 0..6 = 6 iterations")
}

// === OPERATORS, ASSIGNMENT, INDEX ===

@test
fn test_macro_in_operator_positions() {
    assert(twice(3) * 10 + 1 == 61, "(3+3)*10+1 = 61")
    assert(-twice(5) == -10, "-(5+5) = -10")
    let p = (twice(4))
    assert(p == 8, "parenthesised macro call")
    let v = 10
    v = v + twice(5)
    assert(v == 20, "macro in RHS of assignment")
    let xs = [10, 20, 30, 40, 50]
    assert(xs[twice(1)] == 30, "macro as index expression")
    let none: int? = null
    assert((none ?? twice(5)) == 10, "?? right-hand side macro")
}

// === LAMBDAS, RETURN, NESTED, GENERIC CALLS ===

fn returns_via_macro(x: int) -> int {
    return twice(x)
}

fn first_of<T>(xs: [T]) -> T {
    xs[0]
}

@test
fn test_macro_in_call_positions() {
    let f = (n: int) => twice(n)
    assert(f(7) == 14, "lambda body containing macro call")
    assert(returns_via_macro(6) == 12, "return twice(6)")
    assert(pick(true, twice(twice(2)), 0) == 8, "macro nested 2 deep in macro arg position")
    assert(first_of([twice(3), twice(4), twice(5)]) == 6, "generic fn called with array of macro results")
}

// === COMPOUND LITERALS AND INTERPOLATION ===

struct Point { x: int, y: int }

@test
fn test_macro_inside_literals() {
    let p = Point { x: twice(3), y: twice(4) }
    assert(p.x == 6 && p.y == 8, "struct literal fields")
    assert("result is {twice(7)}" == "result is 14", "string interp containing macro")
    let xs = [twice(1), twice(2), twice(3)]
    assert(xs[0] == 2 && xs[1] == 4 && xs[2] == 6, "array literal")
    let t = (twice(1), twice(2), twice(3))
    assert(t.0 == 2 && t.1 == 4 && t.2 == 6, "tuple")
}

// === MACROS RETURNING NON-INT VALUES ===

macro mk_point() -> Point { Point { x: 10, y: 20 } }
macro maybe_int(b: expr) -> int? { if b { 42 } else { null } }
macro mk_vec() -> [int] { [1, 2, 3] }

@test
fn test_macro_returning_compound_values() {
    assert(mk_point().x == 10, "field access on macro-returned struct")
    assert((maybe_int(true) ?? 0) == 42, "coalesce on macro returning nullable")
    assert((maybe_int(false) ?? 0) == 0, "coalesce on macro returning null")
    assert(mk_vec().len() == 3, "method call on macro-returned vec")
}
