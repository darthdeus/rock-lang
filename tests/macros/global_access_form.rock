// Slice 2: `_G.X` source form. Resolves `X` against the module-root
// scope, bypassing local shadows.

global GAF_GLOBAL: int = 200

@test
fn test_g_access_unshadowed() {
    assert_eq(_G.GAF_GLOBAL, 200)
}

@test
fn test_g_access_bypasses_local_shadow() {
    let GAF_GLOBAL = 11
    assert_eq(GAF_GLOBAL, 11)         // bare reads local
    assert_eq(_G.GAF_GLOBAL, 200)     // _G. reads global
}

global GAF_COUNTER: int = 0

@test
fn test_g_access_write() {
    _G.GAF_COUNTER = 5
    assert_eq(_G.GAF_COUNTER, 5)
    _G.GAF_COUNTER = 0  // reset for other tests
}

global GAF_SHADOWED: int = 50

@test
fn test_g_access_write_bypasses_shadow() {
    let GAF_SHADOWED = 999       // local, doesn't touch global
    _G.GAF_SHADOWED = 51
    assert_eq(GAF_SHADOWED, 999) // local unaffected
    assert_eq(_G.GAF_SHADOWED, 51)
    _G.GAF_SHADOWED = 50         // restore
}
