// Adversarial tests for the declarative macro implementation.
//
// Each @test fn probes one assumption the implementation could violate.
// Failures here are real findings — don't soften the assertion to make it
// pass; investigate.
//
// Bare identifiers in a macro body resolve at the call site; a macro reads a
// global through `_G.name` (test_hygiene_body_resolves_to_def_scope) and a
// caller binding through `^name`.

global SIDE_EFFECT_COUNTER: int = 0

fn next_counter() -> int {
    SIDE_EFFECT_COUNTER = SIDE_EFFECT_COUNTER + 1
    SIDE_EFFECT_COUNTER
}

// === HYGIENE ===

// A macro can assign through its params: the substituted caller places are
// written, and the body-local temporary cannot capture a caller `t`.
macro swap_places(a: expr, b: expr) {
    let t = a
    a = b
    b = t
}

@test
fn test_macro_assigns_through_params() {
    let x = 1
    let t = 2
    swap_places(x, t)
    assert(x == 2 && t == 1, "swap writes both caller locals")
}

// Hygiene: macro body introduces a local with same name as caller's local.
macro reads_local_temp(x: expr) -> int {
    let __tmp = x + 1
    __tmp * 2
}

@test
fn test_hygiene_body_local_no_collision() {
    let __tmp = 999     // caller's __tmp
    let result = reads_local_temp(5)
    assert(result == 12, "(5+1)*2 = 12")
    assert(__tmp == 999, "caller's __tmp must NOT be clobbered by macro's __tmp")
}

// Macro body references a name that ALSO matches a caller-scope binding.
// Should resolve to the macro definition's scope, not the caller's.
global MACRO_SCOPE_GLOBAL: int = 100

macro reads_global() -> int {
    _G.MACRO_SCOPE_GLOBAL
}

@test
fn test_hygiene_body_resolves_to_def_scope() {
    // rock: allow(unused_var, "intentional shadow — tests that body ignores caller local")
    let MACRO_SCOPE_GLOBAL = 7
    let result = reads_global()
    // If the macro body resolves identifiers in its DEF scope (correct),
    // we read 100 from the global. If it resolves in the CALLER scope
    // (broken hygiene), we'd read 7.
    assert(result == 100, "macro body must read its def-scope global, not the caller's local")
}

// === SIDE-EFFECT DUPLICATION ===

macro double(x: expr) -> int {
    x + x
}

@test
fn test_side_effect_arg_evaluated_once() {
    SIDE_EFFECT_COUNTER = 0
    let result = double(next_counter())
    // Naive textual substitution: x → next_counter(); body becomes
    // `next_counter() + next_counter()`, counter ends at 2, result = 1+2 = 3.
    // Hygenic / let-binding substitution: counter ends at 1, result = 1+1 = 2.
    // Test both possible behaviors and document which we get.
    assert(SIDE_EFFECT_COUNTER == 1 || SIDE_EFFECT_COUNTER == 2,
        "counter advanced — sanity check")
    if SIDE_EFFECT_COUNTER == 2 {
        // Naive substitution semantics — current likely behavior.
        assert(result == 3, "naive subst: 1 + 2 = 3")
    } else {
        // Hygenic semantics — let-bound, single eval.
        assert(result == 2, "hygenic subst: 1 + 1 = 2")
    }
}

// === FRAGMENT-KIND DISCRIMINATION ===

// Both `ident` and `expr` resolve to TYPE_ANY internally. If overload
// resolution can't distinguish them, calling f(world) with an ident overload
// AND an expr overload defined would be ambiguous.

macro frag_only_expr(_x: expr) -> string {
    "expr_arm"
}

@test
fn test_fragment_kind_expr_accepts_anything() {
    // expr should accept literal, ident, fn-call result, etc.
    assert(frag_only_expr(42) == "expr_arm", "literal")
    let v = 99
    assert(frag_only_expr(v) == "expr_arm", "ident")
    assert(frag_only_expr(next_counter()) == "expr_arm", "fn call")
    assert(frag_only_expr(1 + 2) == "expr_arm", "binary expr")
}

// Both kinds accept the same things if overload resolution is by arity
// only. This documents current behavior — if it changes (true subkinds),
// update.
macro frag_pick_ident(_x: ident) -> string {
    "ident_arm"
}

@test
fn test_fragment_kind_ident_accepts_what() {
    let v = 99
    assert(frag_pick_ident(v) == "ident_arm", "ident accepts ident")
    // The next line probes whether `ident` rejects non-idents. Today both
    // ident and expr resolve to ANY, so non-idents are accepted too.
    // If we tighten the impl to make ident syntactically restrictive,
    // this should become a compile error.
    assert(frag_pick_ident(42) == "ident_arm", "ident currently accepts non-ident exprs")
}

// === COMPOSITION ===

macro inner_sq(x: expr) -> int {
    x * x
}

macro outer_inc(y: expr) -> int {
    inner_sq(y) + 1
}

@test
fn test_macro_calling_macro() {
    let r = outer_inc(3)
    // Both expand: outer_inc(3) → inner_sq(3) + 1 → (3 * 3) + 1 = 10.
    assert(r == 10, "outer_inc(3) should expand to (3 * 3) + 1 = 10")
}

fn add_two(a: int, b: int) -> int {
    a + b
}

@test
fn test_macro_in_arg_to_regular_fn() {
    // Macro call as argument to a regular fn. Expansion happens at the
    // inner-call site; fn receives the expanded result.
    let r = add_two(double(3), double(4))
    assert(r == 14, "add_two(double(3), double(4)) = add_two(6, 8) = 14")
}

@test
fn test_macro_inside_if() {
    let r = if true { double(5) } else { 0 }
    assert(r == 10, "macro inside if-then branch")
}

// === RECURSION ===

// Non-variadic recursive macro. Inline pass typically detects recursion
// and refuses to inline indefinitely. Probe what happens.
macro maybe_recursive(x: expr) -> int {
    x   // no recursion — control case
}

@test
fn test_non_recursive_macro_ok() {
    assert(maybe_recursive(5) == 5, "trivial pass-through")
}

// === RETURN TYPES ===

macro returns_string(x: expr) -> string {
    "got_{x}"
}

@test
fn test_macro_returns_string() {
    assert(returns_string(42) == "got_42", "string return + interp")
}

macro returns_bool(x: expr) -> bool {
    x > 0
}

@test
fn test_macro_returns_bool() {
    assert(returns_bool(5), "5 > 0")
    assert(!returns_bool(-3), "-3 not > 0")
}

// === PARAM IGNORED ===

// Macro that doesn't use its param. With naive expansion the arg evaluation
// would be dropped; with let-binding it's still evaluated. Document.
macro ignores_arg(_x: expr) -> int {
    42
}

@test
fn test_unused_arg_still_evaluated() {
    SIDE_EFFECT_COUNTER = 0
    let _r = ignores_arg(next_counter())
    // If counter is 0, the arg was DROPPED entirely (likely on naive
    // textual subst when param is unused). If 1, it was let-bound.
    // Both are defensible — document which we get.
    assert(SIDE_EFFECT_COUNTER == 0 || SIDE_EFFECT_COUNTER == 1,
        "unused-arg behavior probe")
}

// === SAME-NAME ACROSS DEFINITIONS ===

// Two macros with same name, different arity. Already tested by `greet`
// in basic.rock; here also confirm 3-arity pattern works.
macro arity3(a: expr, b: expr, c: expr) -> int {
    a + b + c
}

macro arity3() -> int {
    0
}

@test
fn test_arity_dispatch_3_arms() {
    assert(arity3() == 0, "0-arg arm")
    assert(arity3(1, 2, 3) == 6, "3-arg arm")
}

// === MACRO + FN MIXED OVERLOAD SET ===
//
// Macro/fn name collisions are a compile error, pinned by
// `tests/errors/macro_name_collides_with_fn.rock.err`.
