// The sigil-form macro call (`foo!(...)`) and its UFCS variant
// (`xs.foo!(args)`, which desugars to `foo!(xs, args)`): argument-list
// edges, the type grammar at `ty:` arg position, nesting, parser-precedence
// boundaries, hygiene, splat forwarding and macros emitting items.

macro emit_zero(Name: ident) {
    fn Name() -> int { return 0 }
}

emit_zero!(zero_a)
emit_zero!(zero_b,)  // trailing comma
emit_zero(zero_c)    // sigil-less still works

macro decl3(A: ident, B: ident, C: ident) {
    fn A() -> int { return 1 }
    fn B() -> int { return 2 }
    fn C() -> int { return 3 }
}

decl3!(
    multiline_a,  // first arg on its own line
    multiline_b,  // trailing comment after comma
    multiline_c   // last arg, no trailing comma
)

macro answer() { 42 }

@test
fn test_arg_list_edges() {
    assert(zero_a() == 0, "sigil prefix, no trailing comma")
    assert(zero_b() == 0, "sigil prefix, trailing comma")
    assert(zero_c() == 0, "sigil-less, sanity")
    assert(multiline_a() == 1, "multi-line arg 1")
    assert(multiline_b() == 2, "multi-line arg 2")
    assert(multiline_c() == 3, "multi-line arg 3")
    assert(answer!() == 42, "sigil call with zero args")
}

// === Mixed `ty` + `expr` fragments in one sigil call ===

macro decl_with_init(Name: ident, Elem: ty, init: expr) {
    struct Name { v: Elem = init }
}

decl_with_init!(MixA, int, 7)
decl_with_init!(MixB, string, "hi")
decl_with_init!(MixC, Box3<int>, Box3 { v: 99 })

struct Box3<T> { v: T }

@test
fn test_mixed_ty_expr_args() {
    let a = MixA { }
    let b = MixB { }
    let c = MixC { }
    assert(a.v == 7, "ty=int, expr=7")
    assert(b.v == "hi", "ty=string, expr=\"hi\"")
    assert(c.v.v == 99, "ty=Box3<int>, expr=Box3 literal")
}

// === Nested sigil calls and sigil calls in other expressions ===

macro doubl(x: expr) { x * 2 }
macro tripl(x: expr) { x * 3 }

fn add(x: int, y: int) -> int { return x + y }

@test
fn test_nested_sigil_calls() {
    assert(doubl!(tripl!(5)) == 30, "doubl!(tripl!(5)) == 30")
    assert(doubl!(doubl!(doubl!(1))) == 8, "triple-nested sigil")
    let xs = [1, 2, 3]
    assert(doubl!(xs.len()) == 6, "sigil arg accepts a method chain")
    assert(add(doubl!(3), tripl!(2)) == 12, "sigil call as regular fn arg")
    let ys = [doubl!(1), doubl!(2), doubl!(3)]
    assert(ys[0] + ys[1] + ys[2] == 12, "sigil calls inside array literal")
}

// === UFCS sigil ===

macro inc(x: expr) -> int { x + 1 }

macro macro_lerp(a: expr, b: expr, t: expr) {
    a + (b - a) * t
}

@test
fn test_ufcs_sigil() {
    assert((((1).inc!()).inc!()).inc!() == 4, "chained UFCS sigil increments")
    assert((10).macro_lerp!(20, 1) == 20, "x.macro_lerp!(b, t) == macro_lerp!(x, b, t)")
    assert(((2 + 3)).inc!() == 6, "(complex).inc!() applies to whole expression")
}

// Macro params are fragment kinds, so the receiver's type is irrelevant.
macro tagged(x: expr, label: expr) -> string {
    "{label}: {x}"
}

@test
fn test_ufcs_sigil_receiver_types() {
    assert((42).tagged!("answer") == "answer: 42", "int receiver")
    assert("hello".tagged!("greeting") == "greeting: hello", "string receiver")
    assert(true.tagged!("flag") == "flag: true", "bool receiver")
    assert(inc!(10).tagged!("res") == "res: 11", "sigil result feeds UFCS sigil receiver")
}

// `Container: ident` substitutes into the StructLiteral name slot, which
// only accepts Ident-shaped types; inference picks the type arg.
struct Box4<T> { v: T }

macro store_in(receiver: expr, Container: ident) {
    Container { v: receiver }
}

@test
fn test_ufcs_with_ident_type_arg() {
    let r = (5).store_in!(Box4)
    assert(r.v == 5, "x.store_in!(Box4) == store_in!(x, Box4)")
}

// === Block expression as sigil arg (falls through to parse_expr) ===

macro pick(x: expr) { x }

@test
fn test_block_expr_as_sigil_arg() {
    assert(pick!({ let y = 7; y + 1 }) == 8, "single-line block arg")
    let r = pick!({
        let x = 7
        let y = 3
        x + y
    })
    assert(r == 10, "multi-line block arg")
}

// === Parenthesized comparison (Ident < ... carve-out must not eat it) ===

@test
fn test_paren_comparison_in_sigil_arg() {
    let a = 3
    let b = 7
    let r = pick!((a < b))
    assert(r == true, "paren-wrapped comparison stays an expression")
}

// === Hygiene through prefix and UFCS sigil ===

macro with_local(x: expr) {
    let __hyg_witness = x + 100
    __hyg_witness
}

@test
fn test_hygiene_through_sigil() {
    let __hyg_witness = 1
    assert(with_local!(5) == 105, "macro local renamed")
    assert(__hyg_witness == 1, "outer local untouched after sigil call")
    assert((5).with_local!() == 105, "UFCS sigil expansion renames macro body local")
    assert(__hyg_witness == 1, "outer local untouched after UFCS sigil")
}

// === Sigil on a regular fn falls through to fn dispatch ===

fn plain_fn(x: int) -> int { return x + 100 }

@test
fn test_sigil_on_regular_fn() {
    assert(plain_fn!(5) == 105, "sigil-form on a regular fn")
    assert((5).plain_fn!() == 105, "UFCS sigil on a regular fn desugars to fn(receiver)")
}

// === Expansion produces a struct literal ===

macro pair_struct(a: expr, b: expr) {
    Pair3 { left: a, right: b }
}

struct Pair3 { left: int, right: int }

@test
fn test_sigil_returns_struct_literal() {
    let p = pair_struct!(3, 4)
    assert(p.left == 3 && p.right == 4, "sigil expansion produces struct literal")
}

// === Item emission through sigil ===

macro emit_noop_fn(Name: ident) {
    fn Name() { }
}

emit_noop_fn!(noop_a)

// Binder and recursive call in the emitted body must agree after splice.
macro mk_factorial(Name: ident) {
    fn Name(n: int) -> int {
        if n <= 1 { return 1 }
        return n * Name(n - 1)
    }
}

mk_factorial!(my_fact)

@test
fn test_sigil_emitted_fns() {
    noop_a()
    assert(my_fact(5) == 120, "5! via macro-emitted self-recursive fn")
    assert(my_fact(0) == 1, "0! base case")
}

// === A macro body emitting another sigil call (resolved on re-expansion) ===

macro outer_quad(v: expr) {
    doubl!(doubl!(v))
}

@test
fn test_macro_emits_macro_call() {
    assert(outer_quad!(5) == 20, "outer_quad expansion runs doubl twice")
}

// === Variadic dispatch and splat forwarding ===

macro sum_of() -> int { 0 }
macro sum_of(x: expr, rest: ...expr) -> int { x + sum_of(...rest) }

macro fwd_two(a: expr, b: expr) -> int {
    sum_of(a, b)
}

@test
fn test_variadic_sigil() {
    assert(sum_of!(10, 20, 30) == 60, "variadic sigil composes")
    assert(sum_of!(7) == 7, "variadic sigil with single arg")
    assert(fwd_two(10, 20) == 30, "fixed-shape forwarder into variadic works")
}

// `sum_of!(...rest)` needs the sigil arg parser to accept `...ident`, and a
// variadic body splatting into a DIFFERENT variadic macro must dispatch
// through the registry rather than self-recursion.
macro fwd_sugar_splat(rest: ...expr) -> int { sum_of(...rest) }
macro fwd_sigil_splat(rest: ...expr) -> int { sum_of!(...rest) }
macro fwd_two_layer(rest: ...expr) -> int { fwd_sugar_splat(...rest) }

@test
fn test_splat_passthrough() {
    assert(fwd_sugar_splat(1, 2, 3) == 6, "sugar passthrough")
    assert(fwd_sigil_splat(1, 2, 3) == 6, "sigil passthrough")
    assert(fwd_two_layer(1, 2, 3, 4) == 10, "two-layer splat passthrough")
    assert(fwd_sigil_splat!(10, 20, 30) == 60, "outer sigil splat passthrough")
    assert(fwd_sugar_splat() == 0, "empty rest dispatches to 0-arg overload")
}

struct BoxL<T> { v: T }

macro hold(Name: ident, Elem: ty) {
    struct Name { v: Elem }
}

hold!(WrapBox, BoxL<int>)
hold!(ArrInt, [int])
hold!(WrapPair, (int, string))
hold!(WrapMap, Map<int, string>)
hold!(BoxArrInt, BoxL<[int]>)
hold!(ArrBox, [BoxL<int>])
hold!(ArrArrInt, [[int]])
hold!(BoxBoxInt, BoxL<BoxL<int>>)
hold!(TupNested, ([int], BoxL<string>))
hold!(MapToBox, Map<int, BoxL<int>>)

@test
fn test_compound_type_args() {
    assert(WrapBox { v: BoxL { v: 7 } }.v.v == 7, "BoxL<int>")
    assert(ArrInt { v: [1, 2, 3] }.v.len() == 3, "[int]")
    let p = WrapPair { v: (5, "hello") }
    assert(p.v.0 == 5 && p.v.1 == "hello", "(int, string)")
    let sm: Map<int, string> = map_new()
    sm[1] = "a"
    assert(WrapMap { v: sm }.v[1] == "a", "Map<int, string>")
    let ba = BoxArrInt { v: BoxL { v: [10, 20] } }
    assert(ba.v.v[0] + ba.v.v[1] == 30, "BoxL<[int]>")
    let ab = ArrBox { v: [BoxL { v: 5 }, BoxL { v: 7 }] }
    assert(ab.v[0].v + ab.v[1].v == 12, "[BoxL<int>]")
    let aa = ArrArrInt { v: [[1, 2], [3, 4]] }
    assert(aa.v[0][0] + aa.v[1][1] == 5, "[[int]]")
    assert(BoxBoxInt { v: BoxL { v: BoxL { v: 99 } } }.v.v.v == 99, "BoxL<BoxL<int>>")
    let t = TupNested { v: ([1, 2, 3], BoxL { v: "hi" }) }
    assert(t.v.0.len() == 3, "tuple first elem")
    assert(t.v.1.v == "hi", "tuple second elem")
    let m: Map<int, BoxL<int>> = map_new()
    m[1] = BoxL { v: 42 }
    assert(MapToBox { v: m }.v[1].v == 42, "Map<int, BoxL<int>>")
}

// === Nullable shapes ===

hold!(NullInt, int?)
hold!(NullBox, BoxL<int>?)
hold!(BoxOfNullInt, BoxL<int?>)

@test
fn test_nullable_type_args() {
    assert(NullInt { v: null }.v == null, "int? - null inhabits")
    assert(NullInt { v: 7 }.v == 7, "int? - non-null also inhabits")
    assert(NullBox { v: null }.v == null, "BoxL<int>? null")
    // The annotation makes `v` an `int?` rather than inferring `int` from a
    // bare literal; it only type-checks if the macro substituted BoxL<int?>.
    let v: BoxL<int?> = BoxL { v: null }
    assert(BoxOfNullInt { v: v }.v.v == null, "BoxL<int?> with null inner")
}

// === Line comments inside type args ===
//
// The parser must keep skipping comments after the cursor-backtracking
// `parse_type_expr` enters its sub-parser. A tuple ending with `)` also
// abuts the call's outer `)`.

hold!(
    HolderA,
    BoxL< // comment after `<`
        int  // comment before `>`
    >
)

hold!(
    TupHolder,
    (
        int?,    // nullable int
        [bool]   // vec of bool
    )
)

@test
fn test_comments_inside_type_args() {
    let h = HolderA { v: BoxL { v: 42 } }
    assert(h.v.v == 42, "type-app arg with internal comments parsed")
    let t = TupHolder { v: (null, [true, false]) }
    assert(t.v.0 == null, "nullable tuple element 0")
    assert(t.v.1.len() == 2, "vec tuple element 1 has expected len")
}
