nobox value Pos { x: int, y: int }
enum Target { None, Tagged(Pos), Named(string) }

@noalloc fn target(kind: int, x: int, y: int) -> Target {
    if kind == 0 { return Target::None }
    if kind == 1 { return Target::Tagged(Pos { x: x, y: y }) }
    return Target::Named("other")
}

@noalloc @nomangle fn equal_tag(kind: int, x: int, y: int) -> bool {
    return target(kind, x, y) == Target::Tagged(Pos { x: 3, y: 4 })
}

@noalloc @nomangle fn not_equal_tag(kind: int, x: int, y: int) -> bool {
    return target(kind, x, y) != Target::Tagged(Pos { x: 3, y: 4 })
}

@noalloc @nomangle fn equal_targets(a: int, ax: int, ay: int, b: int, bx: int, by: int) -> bool {
    return target(a, ax, ay) == target(b, bx, by)
}

@noalloc fn maybe_target(kind: int, x: int, y: int) -> Target? {
    if kind < 0 { return null }
    return target(kind, x, y)
}

@noalloc @nomangle fn equal_maybe(a: int, b: int) -> bool {
    return maybe_target(a, 3, 4) == maybe_target(b, 3, 4)
}

@test
fn scalarized_enum_equality() {
    assert(equal_tag(1, 3, 4))
    assert(!equal_tag(1, 3, 5))
    assert(!equal_tag(0, 3, 4))
    assert(!equal_tag(2, 3, 4))
    assert(!not_equal_tag(1, 3, 4))
    assert(not_equal_tag(1, 3, 5))
    assert(equal_targets(1, 3, 4, 1, 3, 4))
    assert(!equal_targets(1, 3, 4, 1, 3, 5))
    assert(equal_targets(0, 0, 0, 0, 9, 9))
    assert(!equal_targets(0, 0, 0, 2, 0, 0))
    assert(equal_maybe(-1, -1))
    assert(!equal_maybe(-1, 1))
    assert(equal_maybe(1, 1))
}
