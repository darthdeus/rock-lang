enum Left { A, B }
enum Right { C, D }
enum Kind { Plain, Left(Left), Right(Right) }

value Row {
    kind: Kind,
    key: string,
    count: int,
}

@noalloc fn make_row(kind: Kind, n: int) -> Row {
    return match kind {
        Kind::Plain => Row { kind, key: "plain", count: n + 1 },
        Kind::Left(_) => Row { kind, key: "left", count: n + 1 },
        Kind::Right(_) => Row { kind, key: "right", count: n + 1 },
    }
}

@noalloc fn consume_row(row: Row) -> int {
    return match row.kind {
        Kind::Plain => row.count,
        Kind::Left(value) => match value {
            Left::A => row.count,
            Left::B => row.count + 4,
        },
        Kind::Right(_) => row.count,
    }
}

@noalloc fn route_row(n: int) -> int { return consume_row(make_row(Kind::Left(Left::B), n)) }

fn store_row(n: int) -> int {
    let rows: [Row] = []
    rows.push(make_row(Kind::Left(Left::B), n))
    return consume_row(rows[0])
}

@test(output = "9 9")
fn nested_enum_cases_use_scalar_lanes() { print("{route_row(4)} {store_row(4)}") }
