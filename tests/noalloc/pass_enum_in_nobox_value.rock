@noalloc extern(lua, "string.len") fn scalar_strlen(s: string) -> int

enum Payload { Damage(float), Text(string) }
enum Subject { None, Mob(int) }
enum Source { Player, Named(string) }

nobox value Event {
    payload: Payload,
    subject: Subject,
    source: Source,
    label: string,
}

@noalloc fn make_event(n: int) -> Event {
    return Event {
        payload: Payload::Damage(n as float),
        subject: Subject::Mob(n),
        source: Source::Named("player"),
        label: "hit",
    }
}

@noalloc fn consume_event(event: Event) -> int {
    let amount = match event.payload {
        Payload::Damage(value) => value as int,
        Payload::Text(text) => scalar_strlen(text),
    }
    let subject = match event.subject {
        Subject::None => 0,
        Subject::Mob(id) => id,
    }
    let source = match event.source {
        Source::Player => 0,
        Source::Named(name) => scalar_strlen(name),
    }
    return amount + subject + source + scalar_strlen(event.label)
}

@noalloc fn route_event(n: int) -> int { return consume_event(make_event(n)) }

@test(backends = "lua", output = "17")
fn pass_enum_in_nobox_value() { print(route_event(4)) }
