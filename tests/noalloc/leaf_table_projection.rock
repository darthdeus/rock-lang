nobox value LeafPoint { x: int, y: int }
value LeafState { armed: bool, point: LeafPoint, anchor: LeafPoint?, age: float }
global STATE: LeafState = LeafState {
    armed: false, point: LeafPoint { x: 7, y: 9 },
    anchor: LeafPoint { x: 11, y: 13 }, age: 2.0
}
@noalloc @nomangle fn flag(p: ref LeafState) -> bool { return p.armed }
fn replace(p: ref LeafState) {
    p.armed = true
    p.point = LeafPoint { x: 17, y: 19 }
    p.anchor = null
}
fn check(p: ref LeafState) {
    let before = p.armed
    let point = p.point
    let anchor = p.anchor
    replace(p)
    print("{before} {point.x} {point.y} {anchor?.x ?? -1} {anchor?.y ?? -1}")
    print("{p.armed} {p.point.x} {p.point.y} {p.anchor?.x ?? -1}")
}
@test(output = "false 7 9 11 13\ntrue 17 19 -1")
fn leaf_table_projection_round_trips() { check(STATE) }


inline(lua) fn flag_skips_poisoned_siblings() -> bool = """
    local state = setmetatable({armed = true}, {
        __index = function(_, key) error("read unused state field: " .. key) end,
    })
    return flag(state)
"""

@test(backends = "lua")
fn a_single_reference_leaf_does_not_load_siblings() { assert(flag_skips_poisoned_siblings()) }
