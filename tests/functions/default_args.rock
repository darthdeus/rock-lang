// Parameter defaults: a call omitting trailing defaulted params gets the
// defaults injected at the call site, each lowered like a provided argument.
// Covers string, numeric, lambda and value-struct defaults, unit-returning
// callees, overload resolution in the presence of defaults, `@nomangle`
// callees, defaults whose argument tests join across branches and loops, and
// an explicit `null` overriding a non-null default (literally, through a
// variable, named, on methods, generics, inline bodies and decorators).

fn greet_bang(name: string, greeting: string = "hello", excl: int = 1) -> string {
    let s = "{greeting}, {name}"
    let bangs = ""
    let i = 0
    while i < excl {
        bangs = "{bangs}!"
        i = i + 1
    }
    return "{s}{bangs}"
}

fn add3(a: int, b: int = 10, c: int = 100) -> int {
    return a + b + c
}

@test(output = "hello, world!\nhi, bob!\nyo, sam!!!\n111\n123")
fn test_omit_trailing_defaults() {
    print(greet_bang("world"))
    print(greet_bang("bob", "hi"))
    print(greet_bang("sam", "yo", 3))
    print(add3(1))
    print(add3(1, 22))
}

fn greet(name: string = "world", prefix: string = "Hello, ") {
    print("{prefix}{name}")
}

@test(output = "Hello, world\nHello, Rust\n? Lua")
fn test_unit_callee_defaults() {
    greet()
    greet("Rust")
    greet("Lua", "? ")
}

fn mul(x:int, y:int) -> int { return x * y }
fn mul(x:int, y:int = 1, z:int = 1) -> int { return x * y * z }

fn thing(x: int, y:int = 1) -> int { return 1 }
fn thing(x: string, y:int = 1) -> int { return 2 }

// Exact arity picks the overload without defaults; otherwise the overload
// whose defaults fill the call is chosen.
@test(output = "42\n9\n2\n1")
fn test_overloads_with_defaults() {
    print(mul(7, 6))
    print(mul(9))
    print(thing("hello"))
    print(thing(5))
}

// A lambda as a parameter default, followed by another parameter. The
// lambda's own parameter binding is allocated while the function's
// parameters are being collected and must not land inside their range (that
// rejected `x` as an unannotated parameter of `apply_mid`).

fn apply_mid(v: int, f: fn(int) -> int = x => x * 10, k: int = 1) -> int {
    return f(v) + k
}

fn apply_last(v: int, k: int = 1, f: fn(int) -> int = x => x * 10) -> int {
    return f(v) + k
}

fn apply_two(v: int, f: fn(int) -> int = a => a + 1, g: fn(int) -> int = b => b * 2, k: int = 0) -> int {
    return g(f(v)) + k
}

@test
fn test_lambda_default_before_another_param() {
    assert_eq(apply_mid(2), 21)
    assert_eq(apply_mid(2, x => x + 1, 5), 8)
}

@test
fn test_lambda_default_last() {
    assert_eq(apply_last(2), 21)
    assert_eq(apply_last(2, 5, x => x + 1), 8)
}

@test
fn test_two_lambda_defaults() {
    assert_eq(apply_two(3), 8)
    assert_eq(apply_two(3, a => a, b => b, 1), 4)
}

// Defaults on `@nomangle` fns, including a value-struct default.

@nomangle
fn defaulted_int(a: int, b: int = 7) -> int {
    return a + b
}

@nomangle
fn defaulted_string(prefix: string = "hi:", name: string = "world") -> string {
    return prefix + " " + name
}

value V2 { x: int, y: int }

@nomangle
fn defaulted_value(v: V2 = V2 { x: 3, y: 4 }) -> int {
    return v.x + v.y
}

// Rock call sites inject the defaults; the body-side nil check is a safety
// net for callers that bypass mangling (raw Lua or JS, FFI). Exercise it by
// calling from an inline body with the default omitted.

@nomangle inline(lua) fn call_defaulted_int_raw() -> int =
    "return defaulted_int(8)"
@nomangle inline(js) fn call_defaulted_int_raw() -> int =
    "return defaulted_int(8);"

@test(output = "15")
fn nomangle_param_default_int_body_check_fires() {
    print(call_defaulted_int_raw())
}

@test(output = "15\n10\nhi: world\nyo: rock\n7\n20")
fn nomangle_param_defaults_omitted_and_passed() {
    print(defaulted_int(8))
    print(defaulted_int(8, 2))
    print(defaulted_string())
    print(defaulted_string("yo:", "rock"))
    print(defaulted_value())
    print(defaulted_value(V2 { x: 8, y: 12 }))
}

@inline fn scaled(x: int, by: int? = 3) -> int { return x * (by ?? 10) }
@inline fn bump_by(x: int, by: int = 1) -> int { return x + by }
fn joined(flag: bool) -> int {
    let by: int? = 2
    if flag {
        by = null
    }
    return scaled(5, by)
}
fn looped(n: int) -> int {
    let by: int? = null
    let total = 0
    for i in 0..n {
        total += scaled(1, by)
        by = i
    }
    return total
}
fn labelled(n: int) -> int {
    let total = 0
    let i = 0
    while i < n {
        i += 1
        if i == 2 {
            continue
        }
        total = bump_by(total)
        if i > 3 {
            break
        }
        total = bump_by(total, i)
    }
    return total
}
@test(output = "50 10 13 7")
fn joined_and_looped_arguments_keep_their_default_tests() {
    print("{joined(true)} {joined(false)} {looped(4)} {labelled(6)}")
}

fn seeded(seed: int? = 42) -> int? {
    return seed
}

fn forward(seed: int?) -> int? {
    return seeded(seed)
}

@test
fn plain_int_default() {
    assert_eq(seeded() ?? -1, 42)
    assert_eq(seeded(7) ?? -1, 7)
    assert_null(seeded(null))
    assert_null(seeded(seed: null))
    assert_eq(seeded(seed: 9) ?? -1, 9)
}

@test
fn forwarded_null_variable() {
    let s: int? = null
    assert_null(seeded(s))
    assert_null(forward(null))
    assert_eq(forward(3) ?? -1, 3)
}

struct Hint { v: int }

fn hinted(hint: Hint? = Hint { v: 1 }) -> int {
    if hint == null {
        return -1
    }
    return hint.v
}

@test
fn struct_default() {
    assert_eq(hinted(), 1)
    assert_eq(hinted(null), -1)
    assert_eq(hinted(Hint { v: 5 }), 5)
    let h: Hint? = null
    assert_eq(hinted(h), -1)
}

fn placed(at: V2? = V2 { x: 1, y: 2 }) -> int {
    if at == null {
        return -1
    }
    let p = at
    return p.x * 10 + p.y
}

@test
fn value_struct_default() {
    assert_eq(placed(), 12)
    assert_eq(placed(null), -1)
    assert_eq(placed(V2 { x: 3, y: 4 }), 34)
}

struct Counter { c: int }

fn Counter.bump(self, n: int? = 1) -> int {
    return self.c + (n ?? 100)
}

@test
fn method_default() {
    let k = Counter { c: 0 }
    assert_eq(k.bump(), 1)
    assert_eq(k.bump(null), 100)
    assert_eq(k.bump(n: null), 100)
    assert_eq(k.bump(5), 5)
}

// Two defaulted nullable parameters: positional, named and trailing omission
// each reach the right slot.
fn pair(a: int? = 1, b: int? = 2) -> string {
    return "{a ?? -1},{b ?? -1}"
}

@test
fn named_positional_and_trailing() {
    assert_eq(pair(), "1,2")
    assert_eq(pair(null), "-1,2")
    assert_eq(pair(null, null), "-1,-1")
    assert_eq(pair(b: null), "1,-1")
    assert_eq(pair(a: null), "-1,2")
    assert_eq(pair(5), "5,2")
    assert_eq(pair(b: 6), "1,6")
}

fn generic_n<T>(x: T, n: int? = 5) -> int {
    return n ?? -1
}

@test
fn generic_callee() {
    assert_eq(generic_n(1), 5)
    assert_eq(generic_n("a", null), -1)
    assert_eq(generic_n(1.5, n: null), -1)
}

fn flag(on: bool? = true) -> int {
    if on == null {
        return -1
    }
    return if on { 1 } else { 0 }
}

fn label(s: string? = "dflt") -> string {
    return s ?? "none"
}

@test
fn bool_and_string_defaults() {
    assert_eq(flag(), 1)
    assert_eq(flag(false), 0)
    assert_eq(flag(null), -1)
    assert_eq(label(), "dflt")
    assert_eq(label(null), "none")
}

// A null default and a non-nullable default keep their meaning.
fn plain(n: int = 3, m: int? = null) -> int {
    return n + (m ?? 0)
}

@test
fn other_defaults_unchanged() {
    assert_eq(plain(), 3)
    assert_eq(plain(m: 4), 7)
    assert_eq(plain(1, null), 1)
}

// The same rule across an inline wrapper and a decorator argument.

inline(lua) fn host_seeded(n: int? = 7) -> int = "return n == nil and -1 or n"
inline(js) fn host_seeded(n: int? = 7) -> int = "return n == null ? -1 : n;"

@test
fn inline_host_default() {
    assert_eq(host_seeded(), 7)
    assert_eq(host_seeded(3), 3)
    assert_eq(host_seeded(null), -1)
}

global REG: [string] = []

deco init register(priority: int? = 100) {
    vec_push(REG, "{target.name}:{priority ?? -1}")
}

@register
fn sys_default() {}

@register(priority = 10)
fn sys_ten() {}

@test
fn decorator_default() {
    let joined = ""
    for e in REG {
        joined = joined + e + ";"
    }
    assert_eq(joined.contains("sys_default:100;"), true)
    assert_eq(joined.contains("sys_ten:10;"), true)
}
