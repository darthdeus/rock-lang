// Function overload resolution: by argument type, arity and struct type,
// generic versus concrete candidates (with their genericity cost), overloads
// that differ in return type, for-loop variables as arguments, and overloads
// called from a global initializer.

// --- Basic overload resolution ---

fn show(x: int) -> string {
    return "int({x})"
}

fn show(x: string) -> string {
    return "string({x})"
}

fn show(x: float) -> string {
    return "float({x})"
}

fn show(x: bool) -> string {
    if x { return "bool(true)" }
    return "bool(false)"
}

@test(output = "int(42)")
fn test_overload_int() {
    print(show(42))
}

@test(output = "string(hello)")
fn test_overload_string() {
    print(show("hello"))
}

@test(output = "float(3.14)")
fn test_overload_float() {
    print(show(3.14))
}

@test(output = "bool(true)")
fn test_overload_bool() {
    print(show(true))
}

// --- Overload with different arity ---

fn combine(a: int) -> int {
    return a
}

fn combine(a: int, b: int) -> int {
    return a + b
}

fn combine(a: int, b: int, c: int) -> int {
    return a + b + c
}

@test(output = "1")
fn test_overload_arity_1() {
    print(combine(1))
}

@test(output = "3")
fn test_overload_arity_2() {
    print(combine(1, 2))
}

@test(output = "6")
fn test_overload_arity_3() {
    print(combine(1, 2, 3))
}

// --- Overload with struct types ---

struct Point { x: int, y: int }
struct Rect { x: int, y: int, w: int, h: int }

fn area(p: Point) -> int {
    return 0
}

fn area(r: Rect) -> int {
    return r.w * r.h
}

@test(output = "0")
fn test_overload_struct_point() {
    let p = Point { x: 0, y: 0 }
    print(area(p))
}

@test(output = "50")
fn test_overload_struct_rect() {
    let r = Rect { x: 0, y: 0, w: 10, h: 5 }
    print(area(r))
}

// --- Overload with generic ---

fn wrap_val(x: int) -> string {
    return "[int:{x}]"
}

fn wrap_val(x: string) -> string {
    return "[str:{x}]"
}

@test(output = "[int:42]")
fn test_overload_wrap_int() {
    print(wrap_val(42))
}

@test(output = "[str:hi]")
fn test_overload_wrap_string() {
    print(wrap_val("hi"))
}

// --- Overloads that differ in return type ---

// ============================================
// Function Definitions for Testing
// ============================================

fn f() -> int { return 42 }
fn f(x: int) { print(x) }  // returns ()

fn action() { print("action!") }     // returns ()
fn action(x: int) -> int { return x * x }

fn process() -> string { return "done" }
fn process(x: int) { print(x * 2) }  // returns ()
fn process(x: string) -> int { return len(x) }

fn compute() -> int { return 100 }
fn compute(x: int) { print("computing\t{x}") }  // returns ()

fn transform(x: int) -> string { return "int: {x}" }
fn transform(x: string) -> int { return len(x) }

fn greet() -> string { return "zero args" }
fn greet(x: int) -> string { return "one arg: {x}" }
fn greet(x: string) -> int { return len(x) }

fn calculate() -> int { return 100 }
fn calculate(x: int) -> int { return x * 2 }
fn calculate(x: string) { print("void call") }

fn get_value() -> string { return "default" }
fn get_value(x: int) -> string { return "processed: {x}" }

fn fetch() -> int { return 42 }
fn fetch(flag: bool) { print("nothing") }

fn work() -> string { return "simple" }
fn work(complexity: int) -> string { return "complex: {complexity}" }

// ============================================
// Basic Overload Return Type Tests
// ============================================

@test(output = "42\\n10")
fn test_overloads_with_different_return_types() {
    print(f())     // Should select zero-arg overload
    f(10)          // Should select one-arg overload
}

@test(output = "action!\\n16")
fn test_overloads_void_vs_value() {
    action()                    // Should print "action!"
    print(action(4))           // Should print 16
}

// ============================================
// Mixed Return Type Overload Tests (Ignored in original)
// ============================================

// Note: These tests were marked as #[ignore] in the original Rust tests
// They test more complex overload resolution scenarios that may not be fully implemented

@test(output = "done\\n10\\n5")
fn test_overloads_mixed_return_types() {
    print(process())        // Should print "done"
    process(5)              // Should print 10
    print(process("hello")) // Should print 5
}

@test(output = "100\\ncomputing\\t100")
fn test_overloads_in_expressions() {
    let result = compute()     // Should get 100
    print(result)
    compute(result)           // Should print "computing 100"
}

@test(output = "int: 42\\n5")
fn test_overload_selection_by_args_not_return() {
    print(transform(42))       // Should print "int: 42"
    print(transform("hello"))  // Should print 5
}

// ============================================
// Additional Overload Resolution Tests
// ============================================

@test(output = "zero args\\n11\\none arg: 10")
fn test_overload_resolution_clarity() {
    print(greet())
    print(greet("hello world"))  // Should return 11 chars
    print(greet(10))
}

@test(output = "100\\n200\\nvoid call")
fn test_mixed_void_and_value_overloads() {
    print(calculate())
    print(calculate(100))
    calculate("test")
}

// ============================================
// Complex Return Type Patterns Tests
// ============================================

@test(output = "default\\nprocessed: 5")
fn test_overload_context_selection() {
    let default_val = get_value()
    let processed_val = get_value(5)
    
    print(default_val)
    print(processed_val)
}

@test(output = "42\\nnothing")
fn test_overload_assignment_contexts() {
    let number = fetch()        // Should call int version
    print(number)
    fetch(true)                 // Should call void version
}

// ============================================
// Edge Cases and Error Conditions
// ============================================

@test(output = "simple\\ncomplex: 10")
fn test_overload_parameter_disambiguation() {
    print(work())
    print(work(10))
}

// ============================================
// Documentation of Error Cases
// ============================================

// The following demonstrate compile-time error cases for overload resolution.
// Since Rock's @test system focuses on runtime validation,
// these are documented as examples that should NOT compile.

// EXAMPLE 1: Ambiguous overload resolution
// fn ambiguous(x: int) -> string { return "string" }
// fn ambiguous(x: int) -> int { return 42 }
// let result = ambiguous(5)  // ERROR: Ambiguous - which return type?

// EXAMPLE 2: Return type cannot disambiguate when parameters are identical
// fn conflict() -> int { return 1 }
// fn conflict() -> string { return "test" }  // ERROR: Identical signatures

// EXAMPLE 3: Overload with missing return annotation
// fn unclear() { return 5 }    // Inferred return type
// fn unclear() -> int { return 10 }  // ERROR: Conflicts with inferred return

// EXAMPLE 4: Using void function result in expression
// fn void_func() { print("hi") }
// let x = void_func()  // ERROR: Cannot assign () to variable

// EXAMPLE 5: Overload resolution in complex expressions
// fn multi() -> int { return 1 }
// fn multi(x: string) { print(x) }
// let result = multi() + multi("test")  // ERROR: multi("test") returns (), not int

struct FixVec2 {
    x: float,
    y: float,
}

// --- Overload resolution with for-loop variables as arguments ---

fn fixv() -> FixVec2 {
    return FixVec2 { x: 0.0, y: 0.0 }
}

fn fixv(x: float) -> FixVec2 {
    return FixVec2 { x: x, y: x }
}

fn fixv(x: float, y: float) -> FixVec2 {
    return FixVec2 { x: x, y: y }
}

@test
fn test_overload_with_for_loop_int_vars() {
    // Test that fixv(x, y) correctly calls the two-argument version
    // when x and y are for loop variables
    for x in 1..3 {
        for y in 4..6 {
            let vec = fixv(x, y)
            assert_eq(vec.x, float(x))
            assert_eq(vec.y, float(y))
        }
    }
}

@test
fn test_overload_with_explicit_floats() {
    // This should work - explicit float literals
    let vec = fixv(1.0, 2.0)
    assert_eq(vec.x, 1.0)
    assert_eq(vec.y, 2.0)
}

@test
fn test_overload_with_int_variables() {
    // Test with int variables outside of loop
    let x = 3
    let y = 4
    let vec = fixv(x, y)
    assert_eq(vec.x, 3.0)
    assert_eq(vec.y, 4.0)
}

@test
fn test_single_arg_overload() {
    // Test single argument version
    let vec = fixv(5.0)
    assert_eq(vec.x, 5.0)
    assert_eq(vec.y, 5.0)
}

@test
fn test_zero_arg_overload() {
    // Test zero argument version
    let vec = fixv()
    assert_eq(vec.x, 0.0)
    assert_eq(vec.y, 0.0)
}

// Overload ranking has a genericity/specificity cost (`param_genericity` in
// bone-inference/src/calls.rs): a concrete param costs 0, a ctor/tuple/fn
// CONTAINING a generic hole (`[T]`, `Wrap<T>`) costs 1, a bare generic hole
// (`T`) costs 2 -- so `int` beats `[T]` beats `T` and a concrete overload
// always outranks a catch-all that also fits. Before this landed every case
// below rejected as an ambiguous tie (0-cost bare var vs 0-cost concrete).

fn pick(x: int) -> string { return "int" }
fn pick<T>(x: T) -> string { return "generic" }

// A concrete container beats a bare var; a bare var still catches everything else.
fn kind<T>(x: [T]) -> string { return "list" }
fn kind<T>(x: T) -> string { return "any" }

// A ctor-with-hole (`Wrap<T>`, cost 1) beats a bare var (cost 2).
struct Wrap<T> { inner: T }
fn shell<T>(w: Wrap<T>) -> string { return "wrap" }
fn shell<T>(w: T) -> string { return "bare" }

@test(output = "int generic")
fn concrete_beats_bare_var() {
    print("{pick(5)} {pick(true)}")
}

@test(output = "list any")
fn list_beats_bare_var() {
    print("{kind([1, 2, 3])} {kind(7)}")
}

@test(output = "wrap")
fn ctor_hole_beats_bare_var() {
    print("{shell(Wrap { inner: 1 })}")
}

// --- Overload resolution in a global initializer ---
// Inference must pick the overload, not declaration order.

struct InitVec2 { x: float, y: float }
struct InitIVec2 { x: int, y: int }

// Define overloads in an order that would trigger the bug
// The bug occurred when the wrong overload appeared first in iteration order
fn init_fixv(x: int, y: int) -> InitVec2 {
    return InitVec2 { x: 5.0, y: 9.0 }  // This should be selected for init_fixv(5, 9)
}

fn init_fixv(iv: InitIVec2) -> InitVec2 {
    return InitVec2 { x: 1.0, y: 2.0 }  // This was incorrectly selected due to iteration order
}

// Global variable initialization - this is where the bug occurred
// The compiler should select init_fixv(int, int) not init_fixv(InitIVec2) based on argument types
global CAMERA_POS: InitVec2 = init_fixv(5, 9)

@test
fn test_global_overload_resolution() {
    // The correct overload should have been selected
    // init_fixv(5, 9) should call init_fixv(int, int) -> InitVec2 { x: 5.0, y: 9.0 }
    assert_eq(CAMERA_POS.x, 5.0)
    assert_eq(CAMERA_POS.y, 9.0)

    // If the wrong overload was selected, we would get InitVec2 { x: 1.0, y: 2.0 }
    // This test will fail if the bug reappears
    assert(CAMERA_POS.x != 1.0)
    assert(CAMERA_POS.y != 2.0)
}

fn main() {
    // Additional test to verify the overloads work correctly in normal function calls
    let result1 = init_fixv(10, 20)
    assert_eq(result1.x, 5.0)
    assert_eq(result1.y, 9.0)

    let iv = InitIVec2 { x: 1, y: 2 }
    let result2 = init_fixv(iv)
    assert_eq(result2.x, 1.0)
    assert_eq(result2.y, 2.0)

    print("Overload resolution test passed!")
}
