
fn simple_default(x: int, y: int = 10) -> int {
    x + y
}

fn multi_default(a: int, b: int = 20, c: int = 30, d: int = 40) -> int {
    a + b + c + d
}

fn all_defaults(x: int = 1, y: int = 2, z: int = 3) -> int {
    x * 100 + y * 10 + z
}

fn string_func(prefix: string = "Hello", name: string = "World", suffix: string = "!") -> string {
    "{prefix} {name}{suffix}"
}

fn mixed_types(i: int = 10, f: float = 3.14, s: string = "test", b: bool = true) -> string {
    "i={i}, f={f}, s={s}, b={b}"
}

fn bool_func(flag1: bool = true, flag2: bool = false, flag3: bool = true) -> string {
    let s1 = if flag1 { "T" } else { "F" }
    let s2 = if flag2 { "T" } else { "F" }
    let s3 = if flag3 { "T" } else { "F" }
    "{s1}{s2}{s3}"
}

@test(output = "11\n25\n15\n35\n90\n90\n70\n100")
fn test_positional_and_named() {
    print(simple_default(1))
    print(simple_default(15, 10))
    print(simple_default(x: 5))
    print(simple_default(x: 5, y: 30))
    print(multi_default(0))
    print(multi_default(10, 10))
    print(multi_default(10, 10, 10))
    print(multi_default(10, 10, 10, 70))
}

@test(output = "100\n100\n100\n321\n321\n321\nHi Rock?\nHi Rock?\nHi Rock?")
fn test_named_reordering() {
    let a = 10
    let b = 20
    let c = 30
    let d = 40
    print(multi_default(a: a, b: b, c: c, d: d))
    print(multi_default(b: b, c: c, a: a, d: d))
    print(multi_default(c: c, b: b, a: a, d: d))
    print(all_defaults(x: 3, y: 2, z: 1))
    print(all_defaults(y: 2, z: 1, x: 3))
    print(all_defaults(z: 1, y: 2, x: 3))
    print(string_func(prefix: "Hi", name: "Rock", suffix: "?"))
    print(string_func(suffix: "?", prefix: "Hi", name: "Rock"))
    print(string_func(name: "Rock", suffix: "?", prefix: "Hi"))
}

@test(output = "55\n55\n85\n75\n65\n45\n35\n100\n101")
fn test_mixed_positional_and_named() {
    print(multi_default(5, c: 10, d: 20))
    print(multi_default(5, d: 20, c: 10))
    print(multi_default(5, b: 30, d: 20))
    print(multi_default(5, c: 10))
    print(multi_default(5, c: 10, d: 20, b: 30))
    print(multi_default(5, 10, c: 5, d: 25))
    print(multi_default(5, 10, 10, d: 10))
    print(multi_default(10, c: 30, b: 20, d: 40))
    print(multi_default(1, d: 50))
}

@test(output = "123\n155\n789\nHello World!\ni=10, f=3.14, s=test, b=true\ni=99, f=2.71, s=foo, b=false")
fn test_defaults_of_each_type() {
    print(all_defaults())
    print(all_defaults(y: 5, z: 5))
    print(all_defaults(z: 9, y: 8, x: 7))
    print(string_func())
    print(mixed_types())
    print(mixed_types(b: false, s: "foo", i: 99, f: 2.71))
}

@test(output = "TFT\nFFT\nTTF\nFTT\nFTF")
fn test_bool_arg_ordering() {
    print(bool_func())
    print(bool_func(flag1: false))
    print(bool_func(flag3: false, flag2: true))
    print(bool_func(flag2: true, flag1: false))
    print(bool_func(flag2: true, flag1: false, flag3: false))
}

fn many_params(
    p1: int = 1, p2: int = 2, p3: int = 3, p4: int = 4,
    p5: int = 5, p6: int = 6, p7: int = 7, p8: int = 8
) -> int {
    p1 + p2*10 + p3*100 + p4*1000 + p5*10000 + p6*100000 + p7*1000000 + p8*10000000
}

@test(output = "87654321\n87654321\n12345678")
fn test_many_params_ordering() {
    let result1 = many_params(p8: 8, p7: 7, p6: 6, p5: 5, p4: 4, p3: 3, p2: 2, p1: 1)
    print(result1)
    let result2 = many_params(p3: 3, p7: 7, p1: 1, p5: 5, p2: 2, p8: 8, p4: 4, p6: 6)
    print(result2)
    let result3 = many_params(8, 7, 6, 5, p8: 1, p7: 2, p6: 3, p5: 4)
    print(result3)
}

fn outer_func(x: int) -> int {
    multi_default(a: x, c: x*2, b: x*3, d: x*4)
}

@test(output = "100\n200")
fn test_nested_named_calls() {
    print(outer_func(10))
    print(outer_func(20))
}

@test(output = "15\n35")
fn test_named_args_with_shadowing() {
    let y = 100
    print(simple_default(x: 5))
    let x = 200
    print(simple_default(x: 5, y: 30))
}

// Named arguments on UFCS method calls: a named arg after skipped defaults must
// land in its own parameter position.

struct Color {
    r: float,
    g: float,
    b: float,
    a: float
}

fn color(r: float, g: float, b: float, a: float) -> Color {
    return Color { r: r, g: g, b: b, a: a }
}

struct Shape {
    x: float,
    y: float,
    width: float,
    height: float
}

fn shape_draw(shape: Shape, tint: Color = color(1.0, 0.0, 0.0, 0.5), duration: float? = null, border: float = 0.0) -> string {
    return "tint.r={tint.r}, border={border}"
}

@test
fn test_method_call_with_multiple_named_args() {
    let s = Shape { x: 1.0, y: 2.0, width: 3.0, height: 4.0 }

    let result = s.shape_draw(border: 2.5, tint: color(0.5, 0.5, 0.5, 1.0))
    assert(result == "tint.r=0.5, border=2.5", "Expected custom color and border, got: {result}")
}

@test
fn test_method_call_with_mixed_positional_and_named() {
    let s = Shape { x: 0.0, y: 0.0, width: 10.0, height: 10.0 }

    let green = color(0.0, 1.0, 0.0, 1.0)
    let result = s.shape_draw(green, border: 3.0)
    assert(result == "tint.r=0, border=3", "Expected green color and border=3, got: {result}")
}

fn complex_default() -> Color {
    return color(0.25, 0.25, 0.25, 0.75)
}

fn shape_draw_complex(shape: Shape, effect: Color = complex_default(), intensity: float = 1.0, radius: float = 0.0) -> string {
    return "effect.a={effect.a}, intensity={intensity}, radius={radius}"
}

@test
fn test_method_with_complex_default_expression() {
    let s = Shape { x: 5.0, y: 5.0, width: 15.0, height: 15.0 }

    let result = s.shape_draw_complex(radius: 7.5)
    assert(result == "effect.a=0.75, intensity=1, radius=7.5", "Expected default effect and intensity, custom radius, got: {result}")

    let result2 = s.shape_draw_complex(intensity: 0.5)
    assert(result2 == "effect.a=0.75, intensity=0.5, radius=0", "Expected default effect, custom intensity, default radius, got: {result2}")
}

// Generic inference and place/numeric coercion controls for reordered named
// arguments, including calls whose expected ABI differs by value layout.

fn named_append_first<T>(xs: [T], x: T) -> T {
    xs.push(x)
    return xs[0]
}

@test(output = "7\nnamed")
fn generic_named_empty_array_uses_its_parameter_type() {
    print(named_append_first(x: 7, xs: []))
    print(named_append_first(xs: [], x: "named"))
}

value NamedPlayerCase { hp: int }

fn named_update_hp(player: ref NamedPlayerCase, hp: int) {
    player.hp = hp
}

@test(output = "42")
fn reordered_named_ref_argument_borrows_the_original_place() {
    let player = NamedPlayerCase { hp: 10 }
    named_update_hp(hp: 42, player: player)
    print(player.hp)
}

value NamedNumericTag { code: int, weight: f32 }

fn named_boxed_numeric(wide: float, narrow: float) -> bool {
    return wide / 2.0 == 3.5 && narrow / 2.0 == 4.5
}

fn named_scalar_numeric(tag: NamedNumericTag, wide: float, narrow: float) -> bool {
    return tag.code == 1 && tag.weight / 2.0 == 4.5 && wide / 2.0 == 3.5 && narrow / 2.0 == 4.5
}

@test(output = "true\ntrue")
fn reordered_named_numeric_arguments_coerce_for_boxed_and_scalar_calls() {
    let seven: int = 7
    let nine: int = 9
    print(named_boxed_numeric(narrow: nine, wide: seven))
    print(named_scalar_numeric(narrow: nine, tag: NamedNumericTag { code: 1, weight: nine }, wide: seven))
}

struct CallSpread { a: int, b: int }

global ORDER: string = ""

fn tick(tag: string, val: int) -> int {
    ORDER = "{ORDER}{tag}"
    val
}

fn use2(a: int, b: int) -> string { "{a},{b}" }

// Fields written out of declared order still evaluate in SOURCE order.
@test(output = "10,20 order=ab\n10,20 order=ba")
fn test_spread_literal_eval_order() {
    ORDER = ""
    let r = use2(..CallSpread { a: tick("a", 10), b: tick("b", 20) })
    print("{r} order={ORDER}")
    ORDER = ""
    let s = use2(..CallSpread { b: tick("b", 20), a: tick("a", 10) })
    print("{s} order={ORDER}")
}
