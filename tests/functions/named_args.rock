// Named and default arguments: argument ordering and reordering, mixing
// positional and named args, skipping middle defaults, many-parameter and
// nested calls, and named args on method calls.

// =================================================================
// Basic function definitions with varying default argument patterns
// =================================================================

// Simple function with one default arg
fn simple_default(x: int, y: int = 10) -> int {
    x + y
}

// Function with multiple defaults
fn multi_default(a: int, b: int = 20, c: int = 30, d: int = 40) -> int {
    a + b + c + d
}

// Function with all defaults
fn all_defaults(x: int = 1, y: int = 2, z: int = 3) -> int {
    x * 100 + y * 10 + z
}

// Function with string defaults for variety
fn string_func(prefix: string = "Hello", name: string = "World", suffix: string = "!") -> string {
    "{prefix} {name}{suffix}"
}

// Function with mixed types
fn mixed_types(i: int = 10, f: float = 3.14, s: string = "test", b: bool = true) -> string {
    "i={i}, f={f}, s={s}, b={b}"
}

// =================================================================
// Basic named argument tests
// =================================================================

@test(output = "11\n25\n15\n35")
fn test_simple_named_args() {
    // Positional only
    print(simple_default(1))           // 1 + 10 = 11
    print(simple_default(15, 10))      // 15 + 10 = 25

    // Named args
    print(simple_default(x: 5))        // 5 + 10 = 15
    print(simple_default(x: 5, y: 30)) // 5 + 30 = 35
}

@test(output = "90\n90\n70\n100")
fn test_multi_default_basic() {
    print(multi_default(0))             // 0 + 20 + 30 + 40 = 90
    print(multi_default(10, 10))        // 10 + 10 + 30 + 40 = 90
    print(multi_default(10, 10, 10))    // 10 + 10 + 10 + 40 = 70
    print(multi_default(10, 10, 10, 70)) // 10 + 10 + 10 + 70 = 100
}

// =================================================================
// Argument ordering permutation tests - stress testing order
// =================================================================

@test(output = "100\n100\n100\n100\n100\n100")
fn test_argument_order_permutations() {
    // All 6 permutations of 3 named arguments should give same result
    let a = 10
    let b = 20
    let c = 30
    let d = 40

    // abc order variations
    print(multi_default(a: a, b: b, c: c, d: d))
    print(multi_default(a: a, c: c, b: b, d: d))
    print(multi_default(b: b, a: a, c: c, d: d))
    print(multi_default(b: b, c: c, a: a, d: d))
    print(multi_default(c: c, a: a, b: b, d: d))
    print(multi_default(c: c, b: b, a: a, d: d))
}

@test(output = "321\n321\n321\n321\n321\n321")
fn test_all_named_reordering() {
    // Test with a function that has all default parameters
    // Each permutation should produce the same result
    print(all_defaults(x: 3, y: 2, z: 1))
    print(all_defaults(x: 3, z: 1, y: 2))
    print(all_defaults(y: 2, x: 3, z: 1))
    print(all_defaults(y: 2, z: 1, x: 3))
    print(all_defaults(z: 1, x: 3, y: 2))
    print(all_defaults(z: 1, y: 2, x: 3))
}

// =================================================================
// Mixed positional and named arguments
// =================================================================

@test(output = "55\n55\n85\n75\n65\n45\n35")
fn test_mixed_positional_and_named() {
    // First arg positional, rest named in different orders
    print(multi_default(5, c: 10, d: 20))     // 5 + 20(default b) + 10 + 20 = 55
    print(multi_default(5, d: 20, c: 10))     // Same but reordered = 55

    // Different combinations
    print(multi_default(5, b: 30, d: 20))     // 5 + 30 + 30(default c) + 20 = 85
    print(multi_default(5, c: 10))            // 5 + 20(default b) + 10 + 40(default d) = 75

    // More combinations
    print(multi_default(5, c: 10, d: 20, b: 30))  // 5 + 30 + 10 + 20 = 65
    print(multi_default(5, 10, c: 5, d: 25))       // 5 + 10 + 5 + 25 = 45
    print(multi_default(5, 10, 10, d: 10))         // 5 + 10 + 10 + 10 = 35
}

@test(output = "100\n100\n100")
fn test_positional_with_named_reordering() {
    // First two positional, last two named in different orders
    print(multi_default(10, 20, c: 30, d: 40))
    print(multi_default(10, 20, d: 40, c: 30))

    // One positional, skip one, then named
    print(multi_default(10, c: 30, b: 20, d: 40))
}

// =================================================================
// String argument ordering tests
// =================================================================

@test(output = "Same\nSame\nSame\nSame")
fn test_string_arg_ordering() {
    let expected = "Hi Rock?"

    // All permutations should give the same result
    if string_func(prefix: "Hi", name: "Rock", suffix: "?") == expected {
        print("Same")
    }
    if string_func(name: "Rock", prefix: "Hi", suffix: "?") == expected {
        print("Same")
    }
    if string_func(suffix: "?", prefix: "Hi", name: "Rock") == expected {
        print("Same")
    }
    if string_func(name: "Rock", suffix: "?", prefix: "Hi") == expected {
        print("Same")
    }
}

// =================================================================
// Edge cases and stress tests
// =================================================================

@test(output = "123\n155\n555\n789")
fn test_all_defaults_partial_override() {
    // Override none
    print(all_defaults())                  // 1*100 + 2*10 + 3 = 123

    // Override some in random order
    print(all_defaults(y: 5, z: 5))       // 1*100 + 5*10 + 5 = 155
    print(all_defaults(x: 5, y: 5, z: 5)) // 5*100 + 5*10 + 5 = 555

    // Override in reverse order
    print(all_defaults(z: 9, y: 8, x: 7)) // 7*100 + 8*10 + 9 = 789
}

@test(output = "i=10, f=3.14, s=test, b=true\ni=99, f=2.71, s=foo, b=false")
fn test_mixed_types_ordering() {
    // Use all defaults
    print(mixed_types())

    // Override all in scrambled order
    print(mixed_types(b: false, s: "foo", i: 99, f: 2.71))
}

// =================================================================
// Complex ordering with many parameters
// =================================================================

fn many_params(
    p1: int = 1, p2: int = 2, p3: int = 3, p4: int = 4,
    p5: int = 5, p6: int = 6, p7: int = 7, p8: int = 8
) -> int {
    p1 + p2*10 + p3*100 + p4*1000 + p5*10000 + p6*100000 + p7*1000000 + p8*10000000
}

@test(output = "87654321\n87654321\n87654321\n12345678")
fn test_many_params_ordering() {
    // Reverse order
    let result1 = many_params(p8: 8, p7: 7, p6: 6, p5: 5, p4: 4, p3: 3, p2: 2, p1: 1)
    print(result1)

    // Random order 1
    let result2 = many_params(p3: 3, p7: 7, p1: 1, p5: 5, p2: 2, p8: 8, p4: 4, p6: 6)
    print(result2)

    // Random order 2
    let result3 = many_params(p6: 6, p2: 2, p8: 8, p4: 4, p1: 1, p3: 3, p5: 5, p7: 7)
    print(result3)

    // Mix positional and named - first 4 positional, rest named in reverse
    let result4 = many_params(8, 7, 6, 5, p8: 1, p7: 2, p6: 3, p5: 4)
    print(result4)
}

// =================================================================
// Test skipping middle arguments
// =================================================================

@test(output = "91\n91\n101\n41")
fn test_skipping_middle_args() {
    // Skip b (use default b=20)
    print(multi_default(1, c: 20, d: 50))      // 1 + 20(default b) + 20 + 50 = 91

    // Skip c (use default c=30)
    print(multi_default(1, b: 10, d: 50))      // 1 + 10 + 30(default c) + 50 = 91

    // Skip b and c (use both defaults)
    print(multi_default(1, d: 50))             // 1 + 20(default b) + 30(default c) + 50 = 101

    // Skip middle, override with different values
    print(multi_default(1, c: 0, d: 20))       // 1 + 20(default b) + 0 + 20 = 41
}

// =================================================================
// Test with boolean and float defaults
// =================================================================

fn bool_func(flag1: bool = true, flag2: bool = false, flag3: bool = true) -> string {
    let s1 = if flag1 { "T" } else { "F" }
    let s2 = if flag2 { "T" } else { "F" }
    let s3 = if flag3 { "T" } else { "F" }
    "{s1}{s2}{s3}"
}

@test(output = "TFT\nFFT\nTTF\nFTT\nFTF")
fn test_bool_arg_ordering() {
    print(bool_func())                              // T F T (defaults)
    print(bool_func(flag1: false))                  // F F T
    print(bool_func(flag3: false, flag2: true))     // T T F
    print(bool_func(flag2: true, flag1: false))     // F T T (flag3 uses default=true)
    print(bool_func(flag2: true, flag1: false, flag3: false))  // F T F
}

// =================================================================
// Test long chains of named arguments
// =================================================================

fn chain_test(
    a: string = "A", b: string = "B", c: string = "C",
    d: string = "D", e: string = "E", f: string = "F"
) -> string {
    if a == "1" && b == "2" && c == "3" && d == "4" && e == "5" && f == "6" {
        return "Chain1"
    }
    if a == "X" && b == "Y" && c == "Z" && d == "D" && e == "E" && f == "F" {
        return "Chain2"
    }
    if a == "A" && b == "B" && c == "C" && d == "!" && e == "@" && f == "#" {
        return "Chain3"
    }
    return "Unknown"
}

@test(output = "Chain1\nChain2\nChain3")
fn test_long_named_chains() {
    // Test that we can handle many named args in various orders
    print(chain_test(f: "6", b: "2", d: "4", a: "1", c: "3", e: "5"))
    print(chain_test(c: "Z", a: "X", b: "Y"))
    print(chain_test(e: "@", f: "#", d: "!"))
}

// =================================================================
// Test calling functions with named args as arguments
// =================================================================

fn outer_func(x: int) -> int {
    // Call inner function with named args
    multi_default(a: x, c: x*2, b: x*3, d: x*4)
}

@test(output = "100\n200\n300")
fn test_nested_named_calls() {
    print(outer_func(10))   // 10 + 30 + 20 + 40 = 100
    print(outer_func(20))   // 20 + 60 + 40 + 80 = 200
    print(outer_func(30))   // 30 + 90 + 60 + 120 = 300
}

// =================================================================
// Test shadowing with named arguments
// =================================================================

@test(output = "15\n25\n35")
fn test_named_args_with_shadowing() {
    let y = 100  // This y should not affect named arg y

    print(simple_default(x: 5))         // Uses default y=10, not local y=100
    print(simple_default(x: 5, y: 20))  // Explicit y=20

    let x = 200  // This x should not affect named arg x
    print(simple_default(x: 5, y: 30))  // Explicit x=5, y=30
}

// =================================================================
// Test empty calls with all defaults
// =================================================================

@test(output = "123\nHello World!\nTFT\ni=10, f=3.14, s=test, b=true")
fn test_empty_calls() {
    print(all_defaults())    // All defaults
    print(string_func())     // All defaults
    print(bool_func())       // All defaults
    print(mixed_types())     // All defaults
}

// Test with a local function that has optional parameters
fn local_func(x: int, y: int = 10, z: int = 20) -> int {
    x + y + z
}

@test
fn test_named_args_local() {
    // Test various combinations of named arguments
    assert_eq(local_func(1), 31)  // 1 + 10 + 20
    assert_eq(local_func(1, y: 5), 26)  // 1 + 5 + 20
    assert_eq(local_func(1, z: 30), 41)  // 1 + 10 + 30
    assert_eq(local_func(1, y: 5, z: 30), 36)  // 1 + 5 + 30
    assert_eq(local_func(1, z: 30, y: 5), 36)  // 1 + 5 + 30 (different order)
    
    // All named arguments
    assert_eq(local_func(x: 1, y: 5, z: 30), 36)
    assert_eq(local_func(z: 30, x: 1, y: 5), 36)  // Different order
    
    print("Local named arguments test passed!")
}

// Test with multiple optional parameters
fn draw_rect(x: float, y: float, w: float = 100.0, h: float = 100.0, color: string = "black") -> string {
    "{x},{y},{w}x{h} in {color}"
}

@test 
fn test_named_args_complex() {
    // Mix of positional and named
    assert_eq(draw_rect(10.0, 20.0), "10,20,100x100 in black")
    assert_eq(draw_rect(10.0, 20.0, color: "red"), "10,20,100x100 in red")
    assert_eq(draw_rect(10.0, 20.0, w: 50.0), "10,20,50x100 in black")
    assert_eq(draw_rect(10.0, 20.0, h: 50.0, color: "blue"), "10,20,100x50 in blue")
    
    // All named
    assert_eq(draw_rect(x: 5.0, y: 10.0, w: 200.0, h: 150.0, color: "green"), 
              "5,10,200x150 in green")
    
    // Different order with named args
    assert_eq(draw_rect(color: "yellow", x: 1.0, h: 75.0, y: 2.0, w: 125.0),
              "1,2,125x75 in yellow")
              
    print("Complex named arguments test passed!")
}

// Named arguments on UFCS method calls: a named arg after skipped defaults must
// land in its own parameter position.

struct Color {
    r: float,
    g: float,
    b: float,
    a: float
}

fn color(r: float, g: float, b: float, a: float) -> Color {
    return Color { r: r, g: g, b: b, a: a }
}

struct Shape {
    x: float,
    y: float,
    width: float,
    height: float
}

// Function with multiple default arguments that can be called as a method
fn shape_draw(shape: Shape, tint: Color = color(1.0, 0.0, 0.0, 0.5), duration: float? = null, border: float = 0.0) -> string {
    // Return a string representation to verify arguments are in correct positions
    return "tint.r={tint.r}, border={border}"
}

@test
fn test_method_call_with_named_arg_skipping_defaults() {
    let s = Shape { x: 10.0, y: 20.0, width: 30.0, height: 40.0 }

    // Call with named argument, skipping earlier defaults
    // This should use default tint and duration, but set border to 5.0
    let result = s.shape_draw(border: 5.0)
    assert(result == "tint.r=1, border=5", "Expected default color and border=5, got: {result}")
}

@test
fn test_method_call_with_multiple_named_args() {
    let s = Shape { x: 1.0, y: 2.0, width: 3.0, height: 4.0 }

    // Call with multiple named arguments in different order
    let result = s.shape_draw(border: 2.5, tint: color(0.5, 0.5, 0.5, 1.0))
    assert(result == "tint.r=0.5, border=2.5", "Expected custom color and border, got: {result}")
}

@test
fn test_method_call_with_mixed_positional_and_named() {
    let s = Shape { x: 0.0, y: 0.0, width: 10.0, height: 10.0 }

    // Mix positional and named arguments
    let green = color(0.0, 1.0, 0.0, 1.0)
    let result = s.shape_draw(green, border: 3.0)
    assert(result == "tint.r=0, border=3", "Expected green color and border=3, got: {result}")
}

// Test with more complex default expressions
fn complex_default() -> Color {
    return color(0.25, 0.25, 0.25, 0.75)
}

fn shape_draw_complex(shape: Shape, effect: Color = complex_default(), intensity: float = 1.0, radius: float = 0.0) -> string {
    return "effect.a={effect.a}, intensity={intensity}, radius={radius}"
}

@test
fn test_method_with_complex_default_expression() {
    let s = Shape { x: 5.0, y: 5.0, width: 15.0, height: 15.0 }

    // Skip complex default, set only radius
    let result = s.shape_draw_complex(radius: 7.5)
    assert(result == "effect.a=0.75, intensity=1, radius=7.5", "Expected default effect and intensity, custom radius, got: {result}")

    // Set intensity, skip others
    let result2 = s.shape_draw_complex(intensity: 0.5)
    assert(result2 == "effect.a=0.75, intensity=0.5, radius=0", "Expected default effect, custom intensity, default radius, got: {result2}")
}

// Test that verifies the original bug is fixed
struct DebugShape {
    id: int
}

fn debug_draw(shape: DebugShape, highlight: Color = color(1.0, 0.0, 0.0, 0.5), time: float? = null, inset: float = 0.0) -> bool {
    // This mirrors the original bug scenario
    // If arguments are in wrong positions, highlight.r would be a number (inset value)
    // causing "attempt to index local 'highlight' (a number value)"
    if highlight.r > 0.5 {
        return true
    }
    return false
}

@test
fn test_original_bug_scenario() {
    let shape = DebugShape { id: 42 }

    // This was the failing case: calling with only inset named argument
    // Previously would generate: debug_draw(shape, 0.2, nil, 0)
    // Now correctly generates: debug_draw(shape, color(1,0,0,0.5), nil, 0.2)
    let result = shape.debug_draw(inset: 0.2)
    assert(result == true, "Should return true for default red color (r=1.0)")

    // Test with custom color that returns false
    let blue = color(0.0, 0.0, 1.0, 1.0)
    let result2 = shape.debug_draw(blue, inset: 0.1)
    assert(result2 == false, "Should return false for blue color (r=0.0)")
}
