// Function bodies run with their arguments arriving at runtime: operands pass
// through `id` so no stage can fold them. Covers branches, loops, recursion,
// closures, default and named args, uint wrapping, shifts and conversions,
// multi-return forwarding, callee binding over recursion and function values,
// and vector loops with early exits.

fn id(x: int) -> int { return x }
fn idu(x: uint) -> uint { return x }
fn idf(x: float) -> float { return x }
fn ids(x: string) -> string { return x }

fn mysign(x: int) -> int { if x < 0 { 0 } else { 1 } }
fn floor_div(a: int, b: int) -> int { a ./ b }
fn mul_add(a: int, b: int) -> int { a * b + 1 }
fn bits(a: int, b: int) -> int { (a & b) | (a << 1) }
fn fact(n: int) -> int { if n <= 1 { 1 } else { n * fact(n - 1) } }

@test
fn scalar_arithmetic_and_branches() {
    assert_eq(mysign(id(-5)), 0)
    assert_eq(mysign(id(7)), 1)
    assert_eq(floor_div(id(-7), id(2)), -4)
    assert_eq(mul_add(id(6), id(7)), 43)
    assert_eq(bits(id(6), id(3)), 14)
    assert_eq(fact(id(5)), 120)
}

fn while_sum(n: int) -> int {
    let total = 0
    let i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    total
}

fn range_sum(n: int) -> int {
    let total = 0
    for i in 0..n { total = total + i }
    total
}

@test
fn loops_accumulate() {
    assert_eq(while_sum(id(10)), 55)
    assert_eq(range_sum(id(5)), 10)
}

struct P { x: int, y: int }

fn tuple_ends() -> int { let t = (10, 20, 30); t.0 + t.2 }
fn vec_ends() -> int { let xs = [3, 4, 5]; xs[0] + xs[2] }
fn struct_sum() -> int { let p = P { x: 7, y: 35 }; p.x + p.y }
fn destructure() -> int { let (a, b, c) = (10, 20, 12); a + b + c }
fn gx(p: P?) -> int? { p?.x }
fn none_p() -> P? { return null }

@test
fn aggregates_and_safe_nav() {
    assert_eq(tuple_ends(), 40)
    assert_eq(vec_ends(), 8)
    assert_eq(struct_sum(), 42)
    assert_eq(destructure(), 42)
    assert_eq(gx(P { x: id(9), y: 1 }) ?? -1, 9)
    assert(gx(none_p()) == null)
}

fn greet(name: string) -> string { "hi " + name }
fn label(n: int, name: string, ok: bool) -> string { "n={n} {name} ok={ok}" }
fn sub(a: int, b: int) -> int { a - b }
fn digits(a: int = 1, b: int = 2, c: int = 3) -> int { a * 100 + b * 10 + c }

@test
fn strings_defaults_and_named_args() {
    assert_eq(greet(ids("bob")), "hi bob")
    assert_eq(label(id(5), ids("hi"), true), "n=5 hi ok=true")
    assert_eq(sub(b: id(3), a: id(10)), 7)
    assert_eq(digits(c: id(9)), 129)
}

fn apply(f: fn(int) -> int, x: int) -> int { f(x) }

@test
fn closure_call_and_capture() {
    let bonus = id(100)
    assert_eq(apply(n => n + bonus, id(5)), 105)
}

fn cast_to_int(x: float) -> int { x as int }
fn cast_to_float(x: int) -> float { x as float }
fn square_plus(x: int) -> float { let y = x as float; y * y + y }
fn product_square_plus(a: int, b: int) -> float {
    let s = a * b
    let y = s as float
    y * y + y + (s + 1) as float
}

@test
fn float_int_casts() {
    assert_eq(cast_to_int(idf(3.9)), 3)
    assert_eq(cast_to_int(idf(-1.2)), -2)
    assert_eq(cast_to_float(id(5)), 5.0)
    assert_eq(square_plus(id(3)), 12.0)
    assert_eq(product_square_plus(id(2), id(3)), 49.0)
}

@inline inline(lua) fn clampx(x: int) -> int = """
    if x < 0 then return 0 end
    return x
"""
fn clamp_call(n: int) -> int { return clampx(n) }

// An early return keeps the body from splicing; the fallback call must agree.
@test(backends = "lua")
fn inline_lua_multistatement_body() {
    assert_eq(clamp_call(id(-5)), 0)
    assert_eq(clamp_call(id(7)), 7)
}

fn left0(v: uint) -> uint { v << 0 }
fn left1(v: uint) -> uint { v << 1 }
fn left16(v: uint) -> uint { v << 16 }
fn left31(v: uint) -> uint { v << 31 }
fn right0(v: uint) -> uint { v >> 0 }
fn right1(v: uint) -> uint { v >> 1 }
fn right16(v: uint) -> uint { v >> 16 }
fn right31(v: uint) -> uint { v >> 31 }

fn shifts(v: uint) -> string {
    return "{left0(idu(v))} {left1(idu(v))} {left16(idu(v))} {left31(idu(v))} {right0(idu(v))} {right1(idu(v))} {right16(idu(v))} {right31(idu(v))}"
}

@test(output = "0 0 0 0 0 0 0 0\n1 2 65536 2147483648 1 0 0 0\n2147483648 0 0 0 2147483648 1073741824 32768 1\n4294967295 4294967294 4294901760 2147483648 4294967295 2147483647 65535 1")
fn uint_constant_shifts_stay_unsigned() {
    print(shifts(0 as uint))
    print(shifts(1 as uint))
    print(shifts(2147483648 as uint))
    print(shifts(4294967295 as uint))
}

fn uadd(a: uint, b: uint) -> uint { a + b }
fn umul(a: uint, b: uint) -> uint { a * b }
fn ushift(value: uint, count: uint) -> uint { value << count }
fn above(a: uint, b: uint) -> bool { a > b }
fn numeric(a: uint) -> int { a as int }
fn bitcast_int(a: uint) -> int { bitcast<int>(a) }
fn udec() -> uint { let x: uint = 0; x--; x }
fn uinc() -> uint { let x: uint = 4294967295; x++; x }

@test
fn uint_wraps_orders_and_converts() {
    assert_eq(uadd(idu(4294967295 as uint), idu(1 as uint)), 0 as uint)
    assert_eq(umul(idu(4294967295 as uint), idu(4294967295 as uint)), 1 as uint)
    assert_eq(~idu(0 as uint), 4294967295 as uint)
    assert_eq(idu(2147483648 as uint) >> 31, 1 as uint)
    assert_eq(idu(2147483648 as uint) >> 1, 1073741824 as uint)
    assert_eq(idu(2147483648 as uint) >> 0, 2147483648 as uint)
    assert(above(idu(2147483648 as uint), idu(0 as uint)))
    assert_eq(ushift(idu(1 as uint), idu(31 as uint)), 2147483648 as uint)
    assert_eq(numeric(idu(2147483648 as uint)), 2147483648)
    assert_eq(bitcast_int(idu(2147483648 as uint)), -2147483648)
    assert_eq(udec(), 4294967295 as uint)
    assert_eq(uinc(), 0 as uint)
}

fn last_in_range(lo: uint, hi: uint) -> uint {
    let result: uint = 0
    for i in lo..hi { result = i }
    result
}
fn escaped_range() -> uint {
    let values: [uint] = (2147483648 as uint)..(2147483651 as uint)
    values[2]
}
fn buffer_uint() -> uint {
    let b = native_buffer_uint(1)
    b[0] = 4294967295
    b[0]
}

@test
fn uint_ranges_and_buffers_keep_unsigned_values() {
    assert_eq(last_in_range(idu(2147483648 as uint), idu(2147483651 as uint)), 2147483650 as uint)
    assert_eq(escaped_range(), 2147483650 as uint)
    assert_eq(buffer_uint(), 4294967295 as uint)
}

// A tail recursion deeper than the Lua stack survives: a non-tail recursion
// on LuaJIT overflows between 10,000 and 60,000 frames.
fn count_down(n: int, acc: int) -> int {
    if n == 0 { return acc }
    return count_down(n - 1, acc + 1)
}

fn pair(a: int) -> (int, int) { (a, a + 1) }
fn forward_pair(a: int) -> (int, int) { return pair(a) }
fn pair_total(a: int) -> int { let (x, y) = forward_pair(a); x * 100 + y }

@test(returns = 200000, backends = "lua")
fn deep_tail_recursion_survives() -> int {
    return count_down(id(200000), 0)
}

@test(returns = 708)
fn a_multi_return_forward_delivers_its_values() -> int {
    return pair_total(id(7))
}

// Mutually recursive legs and a call through a function value.
fn leaf(a: int) -> int { a * 3 + 1 }
fn is_even(n: int) -> bool {
    if n == 0 { return true }
    is_odd(n - 1)
}
fn is_odd(n: int) -> bool {
    if n == 0 { return false }
    is_even(n - 1)
}
fn apply_twice(f: fn(int) -> int, a: int) -> int { f(a) + f(a + 1) }
fn bound_total(a: int) -> int {
    let t = apply_twice(leaf, a)
    if is_even(a) { t = t + 100 }
    if is_odd(a + 1) { t = t + 1000 }
    t + leaf(a)
}

@test
fn callee_binding_over_recursion_and_function_values() {
    assert_eq(bound_total(id(6)), 1160)
    assert_eq(bound_total(id(7)), 69)
    assert_eq(bound_total(id(0)), 1106)
}

// Every inner bound is re-read per outer iteration, an empty inner vec runs
// zero times, and an early `return` out of the inner loop still fires.
struct B { slot: int }
struct D { bindings: [B] }
fn nested_sum(ds: [D], stop: int) -> int {
    let t = 0
    for d in ds { for b in d.bindings { if b.slot == stop { return t - 1000 }; t = t + b.slot } }
    t
}
fn nested_probe(stop: int) -> int {
    let ds = [D { bindings: [B { slot: 1 }, B { slot: 2 }] }, D { bindings: [] }, D { bindings: [B { slot: 3 }, B { slot: 4 }, B { slot: 5 }] }]
    nested_sum(ds, stop)
}

@test
fn nested_iterator_loop_with_early_return() {
    assert_eq(nested_probe(id(99)), 15)
    assert_eq(nested_probe(id(3)), -997)
    assert_eq(nested_probe(id(1)), -1000)
}

fn count_false(xs: [bool]) -> int {
    let n = 0
    for x in xs { if !x { n += 1 } }
    return n
}
fn count_null(xs: [int?]) -> int {
    let n = 0
    for x in xs { if x == null { n += 1 } }
    return n
}
fn at(xs: [int], i: int) -> int { return xs[i] }

@test(output = "2 3 6")
fn vec_reads_of_false_and_null_slots() {
    let a = count_false([true, false, false])
    let b = count_null([1, null, 3, null, null])
    print("{a} {b} {at([4, 5, 6], id(2))}")
}

@intrinsic @nomangle inline(lua) fn error_of(f: fn()) -> string = """
    local ok, err = pcall(f)
    return tostring(err)
"""

@test(output = "true\ntrue", backends = "lua")
fn vec_index_out_of_bounds_raises() {
    print(error_of(() => { let _ = at([4, 5, 6], id(3)) }).contains("Vec index out of bounds"))
    print(error_of(() => { let _ = at([4, 5, 6], id(-1)) }).contains("Vec index out of bounds"))
}

// A user function that shares a stdlib name is still called.
struct Row { n: int }
fn len(rows: [Row]) -> int { return 40 + rows.len }

@test(returns = 42)
fn a_user_len_over_a_vector_is_still_called() -> int {
    return len([Row { n: 1 }, Row { n: 2 }])
}

fn fill(xs: [int]) -> int {
    for i in 0..xs.len() { xs[i] = xs[i] + i }
    return xs[xs.len() - 1]
}
fn fill_twice(n: int) -> int {
    let xs: [int] = []
    for i in 0..n { xs.push(10) }
    fill(xs)
    return fill(xs)
}

@test
fn proven_stores_compute_the_same() {
    assert_eq(fill_twice(id(5)), 18)
    assert_eq(fill_twice(id(1)), 10)
}

value V { x: float, y: float }
fn sum_v(ps: [V]) -> float {
    let t = 0.0
    for p in ps { t += p.x * p.y }
    return t
}
fn skip_odd(xs: [int]) -> int {
    let t = 0
    for x in xs {
        if x % 2 == 1 { continue }
        if x > 100 { break }
        t += x
    }
    return t
}
fn total_len(ss: [string]) -> int {
    let n = 0
    for s in ss { n += s.len() }
    return n
}
fn find(xs: [int], key: int) -> int {
    for x in xs { if x == key { return x * 10 } }
    return -1
}

@test(output = "15 6 5 50 -1")
fn vec_loop_shapes_compute_the_same() {
    let a = sum_v([V { x: 1.5, y: 2.0 }, V { x: 3.0, y: 4.0 }])
    let b = skip_odd([1, 2, 3, 4, 200, 6])
    let c = total_len(["ab", "", "cde"])
    print("{a} {b} {c} {find([4, 5], id(5))} {find([], id(5))}")
}
