// Test that global initializers are properly type-checked

// Rejected initializers are in tests/errors/global_initializers.rock.err.

global good_global: int = 42

// Typed global with a string initializer
global inferred_global: string = "hello"

// Global referencing another global should work
global dependent_global: int = good_global + 10

@test
fn test_globals() {
    assert_eq(good_global, 42)
    assert_eq(inferred_global, "hello")
    assert_eq(dependent_global, 52)
}