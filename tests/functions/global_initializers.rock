// Global and const initializers: typed scalar globals, a global computed from
// another global, and lambdas stored in a struct field, directly in a global,
// in array literals, capturing an initializer local, and with a nested lambda
// in the body, a global mutated through calls inside one interpolation, and
// a nobox global stored as its leaves. Rejected initializers are in
// tests/errors/assignment.rock.err.

global good_global: int = 42

// Typed global with a string initializer
global inferred_global: string = "hello"

// Global referencing another global should work
global dependent_global: int = good_global + 10

@test
fn test_globals() {
    assert_eq(good_global, 42)
    assert_eq(inferred_global, "hello")
    assert_eq(dependent_global, 52)
}

struct Counter { value: int = 4 }
struct Queries { read: fn(Counter) -> int, double: fn(int) -> int }
struct Op { name: string, apply: fn(int) -> int }

fn double(value: int) -> int { return value * 2 }

const QUERIES: Queries = Queries {
    read: (counter: Counter) => counter.value + 1,
    double: double,
}

global BASE: int = 10
global SQUARE: fn(int) -> int = (x: int) => x * x
const OPS: [Op] = [
    Op { name: "inc", apply: (x: int) => x + 1 },
    Op { name: "base", apply: (x: int) => x + BASE },
]
const STEPS: [fn(int) -> int] = [(x: int) => x * 3, (x: int) => x - 2]
const OFFSET_BY: fn(int) -> int = {
    let offset = 3
    (value: int) => value + offset
}
const TWICE_PLUS_ONE: fn(int) -> int = (a: int) => {
    let twice = (b: int) => b * 2
    return twice(a) + 1
}

@test(output = "10")
fn test_const_struct_lambda_field() {
    print(QUERIES.double(QUERIES.read(Counter {})))
}

@test(output = "49 6 15 10")
fn test_global_lambda_direct_and_in_arrays() {
    print("{SQUARE(7)} {OPS[0].apply(5)} {OPS[1].apply(5)} {STEPS[1](STEPS[0](4))}")
}

@test(output = "25")
fn test_global_lambda_reads_current_global() {
    let saved = BASE
    BASE = 20
    let result = OPS[1].apply(5)
    BASE = saved
    print(result)
}

@test(output = "7 9")
fn test_global_lambda_capture_and_nested_lambda() {
    print("{OFFSET_BY(4)} {TWICE_PLUS_ONE(4)}")
}

global COUNTER: int = 0

fn bump() -> int {
    COUNTER = COUNTER + 1
    return COUNTER
}

// Mutate a global through a call chain and read it back between calls.
@test(output = "1 2 3")
fn counter_output() {
    COUNTER = 0
    print("{bump()} {bump()} {bump()}")
}

// A `nobox` global is stored as its leaves; its initializer assigns each one.
nobox value NP { x: int, y: int }

global ORIGIN: NP = NP { x: 3, y: 4 }

@test(returns = 34)
fn nobox_global_initializes_its_leaves() -> int {
    return ORIGIN.x * 10 + ORIGIN.y
}
