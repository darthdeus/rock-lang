global capture_seed: int = 10

fn snapshot_global() -> int {
    static n = capture_seed
    return n
}

@test(output = "10 10")
fn static_initializer_can_read_global_once() {
    capture_seed = 10
    let first = snapshot_global()
    capture_seed = 20
    print("{first} {snapshot_global()}")
}

fn initializer_local() -> int {
    static n = {
        let base = 7
        let add = x => x + base
        add(1)
    }
    return n
}

@test(output = "8 8")
fn static_initializer_can_bind_its_own_locals() {
    print("{initializer_local()} {initializer_local()}")
}

fn explicit_threshold(threshold: int) -> int {
    fn keep(x: int, limit: int) -> bool { x > limit }
    return if keep(5, threshold) { 1 } else { 0 }
}

@test(output = "1 0")
fn nested_function_can_receive_enclosing_value_as_argument() {
    print("{explicit_threshold(3)} {explicit_threshold(7)}")
}

global helper_offset: int = 4

fn sibling_call() -> int {
    fn earlier(x: int) -> int { x + helper_offset }
    fn later(x: int) -> int { earlier(x) * 2 }
    return later(3)
}

@test(output = "14")
fn nested_function_can_call_prior_sibling_and_read_global() {
    print(sibling_call())
}
