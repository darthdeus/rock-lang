// Nested named functions: a `fn` written inside another fn body, hoisted to a
// private top-level function, callable by name and passable as a zero-alloc
// value.
//
// STATUS: GREEN target for the feature. v1 semantics: no capture of enclosing
// params/locals, decl-before-use (self-recursion ok, no forward/mutual
// recursion), no generics, no annotations. A nested fn body MAY call in-scope
// sibling nested fns and read/write in-scope `static`s + module globals.

// --- Basic call by name ---

fn sum_incs(xs: [int]) -> int {
    fn inc(x: int) -> int { x + 1 }
    let s = 0
    for x in xs {
        s = s + inc(x)
    }
    return s
}

@test(output = "9")
fn test_nested_fn_basic_call() {
    print("{sum_incs([1, 2, 3])}")   // (1+1)+(2+1)+(3+1) = 9
}

// --- Passed as a value (zero-alloc fn reference, not a closure) ---

fn doubled(xs: [int]) -> [int] {
    fn dbl(x: int) -> int { x * 2 }
    return xs.iter().map(dbl).collect()
}

@test(output = "2 4 6")
fn test_nested_fn_as_value() {
    let ys = doubled([1, 2, 3])
    print("{ys[0]} {ys[1]} {ys[2]}")
}

@test(output = "2 4 6")
fn test_iterator_chain_inside_nested_fn_body() {
    fn mapped(xs: [int]) -> [int] {
        return xs.iter().map(x => x * 2).collect()
    }
    let ys = mapped([1, 2, 3])
    print("{ys[0]} {ys[1]} {ys[2]}")
}

// --- Self-recursion ---

fn fact_of(n: int) -> int {
    fn fac(k: int) -> int {
        if k <= 1 { return 1 }
        return k * fac(k - 1)
    }
    return fac(n)
}

@test(output = "120")
fn test_nested_fn_self_recursion() {
    print("{fact_of(5)}")
}

// --- Sibling blocks: same name, distinct hoisted fns ---

fn sibling_helpers() -> string {
    let a = 0
    {
        fn h(x: int) -> int { x + 1 }
        a = h(10)
    }
    let b = 0
    {
        fn h(x: int) -> int { x + 100 }
        b = h(10)
    }
    return "{a}:{b}"
}

@test(output = "11:110")
fn test_nested_fn_sibling_blocks_distinct() {
    print("{sibling_helpers()}")
}

// --- A nested fn shadows a like-named top-level fn ---

fn base_val(x: int) -> int { x + 1000 }

fn uses_shadow() -> int {
    fn base_val(x: int) -> int { x + 1 }   // shadows the top-level base_val
    return base_val(5)
}

@test(output = "6 1005")
fn test_nested_fn_shadows_toplevel() {
    let inner = uses_shadow()    // nested -> 6
    let outer = base_val(5)      // top-level -> 1005
    print("{inner} {outer}")
}

// --- A nested fn reads/writes an in-scope `static` ---

fn tick() -> int {
    static n = 0
    fn bump() { n = n + 1 }
    bump()
    bump()
    return n
}

@test(output = "2 4")
fn test_nested_fn_uses_static() {
    let a = tick()   // 2
    let b = tick()   // 4 (static persists across calls)
    print("{a} {b}")
}

// --- Named arguments reach the param they name ---

fn named_args() -> int {
    fn sub(a: int, b: int) -> int { return a - b }
    return sub(b: 2, a: 10)
}

@test(output = "8")
fn test_nested_fn_named_args_land_in_their_slot() {
    print("{named_args()}")
}

// --- A specialized generic fn converts its nested fn's lambdas ---

fn apply_ten(f: fn(int) -> int, x: int) -> int { return f(x) }

fn generic_with_nested<T>(tag: T, n: int) -> int {
    fn scaled(x: int) -> int {
        return apply_ten((v) => v * 10, x)
    }
    return scaled(n)
}

@test(output = "30 40")
fn test_generic_nested_fn_lambda() {
    print("{generic_with_nested(1.5, 3)} {generic_with_nested(\"a\", 4)}")
}
