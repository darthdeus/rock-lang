fn ident<T>(x: T) -> T { return x }
@inline fn wrap<T>(x: T) -> T { return ident(x) }
fn nudge(x: int) -> int { return x + 1 }
nobox value Pair { x: int, y: int }

@test
fn spliced_generics_keep_different_argument_shapes() {
    let scalar = wrap(1)
    let pair = wrap(Pair { x: 2, y: 3 })
    let callback = ident(nudge)
    let tuple = ident((4, 5))
    let array = ident([6, 7])
    let nullable: int? = 8
    let option = ident(nullable)
    let nested = ident([[9]])
    let (left, right) = tuple
    assert_eq(scalar + pair.x + callback(0), 4)
    assert_eq(left + right + array[0] + (option ?? 0) + nested[0][0], 32)
}

fn total<I: Iterator<Pair>>(it: I) -> int {
    let sum = 0
    for v in it { sum += v.x }
    return sum
}

@test(returns = 4)
fn bounded_value_results_resolve_after_splicing() -> int {
    let xs = [Pair { x: 1, y: 2 }, Pair { x: 3, y: 4 }]
    return total(xs.iter())
}

struct Item { id: int, p: float }

@test(returns = 1)
fn nested_iterator_witnesses_keep_their_bound_calls() -> int {
    let xs = [Item { id: 1, p: 3.0 }, Item { id: 2, p: 2.0 }]
    let ids = xs.map(_.id).collect()
    return ids[0]
}

@inline
fn outer(x: int) -> int {
    fn inner(y: int) -> int {
        fn child(z: int) -> int { return z + 1 }
        return child(y)
    }
    return inner(x)
}

fn top(x: int) -> int { return outer(x) + outer(x) }

@test(output = "6 8")
fn named_nested_functions_survive_splicing() {
    print("{top(2)} {top(3)}")
}

@inline
fn sum_inner(xs: [int]) -> int {
    let sum = 0
    for x in xs.iter() { sum += x }
    return sum
}

@test(returns = 6)
fn iterator_headers_survive_splicing() -> int {
    return sum_inner([1, 2, 3])
}

co fn counter() -> Coroutine<int, int, ()> {
    yield 1
    return 2
}

@test
fn coroutine_and_nested_container_instances_stay_distinct() {
    let c = ident(counter())
    let m: Map<string, Coroutine<int, int>> = map_new()
    let mapped = ident(m)
    assert_eq(c.resume() ?? 0, 1)
    assert_eq(len(mapped), 0)
    let xs = ident([1])
    let nested = ident([[2]])
    assert_eq(xs[0] + nested[0][0], 3)
}

value V2 { x: float, y: float }

@test(output = "1")
fn a_formatter_does_not_borrow_its_arguments_bound_tree() {
    let xs = [V2 { x: 1.0, y: 2.0 }]
    print("{xs.map(_.x).sum_f()}")
}
