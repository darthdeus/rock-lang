// Call-site spread of a generic struct instantiation (plan M2). Fields are
// known after substitution.

struct Pair<T> { a: T, b: T }

fn sum2(a: int, b: int) -> int { a + b }
fn cat2(a: string, b: string) -> string { "{a}{b}" }

@test(output = "3")
fn test_spread_generic_int() {
    let p = Pair { a: 1, b: 2 }
    print(sum2(..p))
}

@test(output = "xy")
fn test_spread_generic_string() {
    let p = Pair { a: "x", b: "y" }
    print(cat2(..p))
}
