// A generic fn that calls itself at the same type arguments needs one
// instance, so the instantiation depth bound must not refuse it.

fn countdown<T>(x: T, n: int) -> int {
    if n <= 0 { return 0 }
    return 1 + countdown(x, n - 1)
}

@test
fn same_instance_recursion_runs() {
    assert_eq(countdown(1, 5), 5)
    assert_eq(countdown("s", 3), 3)
}
