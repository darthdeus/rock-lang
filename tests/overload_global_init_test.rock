// The compiler was incorrectly selecting the first overload found instead of
// using the results from bidirectional type inference

struct FixVec2 { x: float, y: float }
struct IVec2 { x: int, y: int }

// Define overloads in an order that would trigger the bug
// The bug occurred when the wrong overload appeared first in iteration order
fn fixv(x: int, y: int) -> FixVec2 {
    return FixVec2 { x: 5.0, y: 9.0 }  // This should be selected for fixv(5, 9)
}

fn fixv(iv: IVec2) -> FixVec2 {
    return FixVec2 { x: 1.0, y: 2.0 }  // This was incorrectly selected due to iteration order
}

// Global variable initialization - this is where the bug occurred
// The compiler should select fixv(int, int) not fixv(IVec2) based on argument types
global CAMERA_POS: FixVec2 = fixv(5, 9)

@test
fn test_global_overload_resolution() {
    // The correct overload should have been selected
    // fixv(5, 9) should call fixv(int, int) -> FixVec2 { x: 5.0, y: 9.0 }
    assert_eq(CAMERA_POS.x, 5.0)
    assert_eq(CAMERA_POS.y, 9.0)

    // If the wrong overload was selected, we would get FixVec2 { x: 1.0, y: 2.0 }
    // This test will fail if the bug reappears
    assert(CAMERA_POS.x != 1.0)
    assert(CAMERA_POS.y != 2.0)
}

fn main() {
    // Additional test to verify the overloads work correctly in normal function calls
    let result1 = fixv(10, 20)
    assert_eq(result1.x, 5.0)
    assert_eq(result1.y, 9.0)

    let iv = IVec2 { x: 1, y: 2 }
    let result2 = fixv(iv)
    assert_eq(result2.x, 1.0)
    assert_eq(result2.y, 2.0)

    print("Overload resolution test passed!")
}
