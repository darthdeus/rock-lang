// Regression test: range bounds containing function calls with commas
// were incorrectly parsed by the __range() splitter, which used a naive
// split(", ") instead of parenthesis-aware splitting. This caused the
// loop to fall back to pairs() iteration over the Vec struct, yielding
// ("data", table) and ("len", number) instead of actual range values.

fn helper_min(a: int, b: int) -> int {
    if a < b { return a }
    return b
}

fn helper_max(a: int, b: int) -> int {
    if a > b { return a }
    return b
}

fn helper_clamp(v: int, lo: int, hi: int) -> int {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn identity(x: int) -> int { return x }

// The original bug: function call with comma in end bound
@test
fn test_range_with_min_end_bound() {
    let nums = vec_new()
    for i in 0..helper_min(5, 10) {
        vec_push(nums, i)
    }
    assert_eq(vec_len(nums), 5)
    assert_eq(unwrap(vec_get(nums, 0)), 0)
    assert_eq(unwrap(vec_get(nums, 4)), 4)
}

// Function call with comma in start bound
@test
fn test_range_with_max_start_bound() {
    let nums = vec_new()
    for i in helper_max(2, 0)..5 {
        vec_push(nums, i)
    }
    assert_eq(vec_len(nums), 3)
    assert_eq(unwrap(vec_get(nums, 0)), 2)
    assert_eq(unwrap(vec_get(nums, 2)), 4)
}

// Function calls with commas on BOTH sides
@test
fn test_range_with_function_calls_both_sides() {
    let nums = vec_new()
    for i in helper_max(1, 3)..helper_min(7, 10) {
        vec_push(nums, i)
    }
    assert_eq(vec_len(nums), 4)
    assert_eq(unwrap(vec_get(nums, 0)), 3)
    assert_eq(unwrap(vec_get(nums, 3)), 6)
}

// Three-argument function call (multiple commas inside parens)
@test
fn test_range_with_three_arg_function() {
    let nums = vec_new()
    for i in 0..helper_clamp(20, 0, 5) {
        vec_push(nums, i)
    }
    assert_eq(vec_len(nums), 5)
    assert_eq(unwrap(vec_get(nums, 0)), 0)
    assert_eq(unwrap(vec_get(nums, 4)), 4)
}

// Nested function calls (commas at multiple depths)
@test
fn test_range_with_nested_function_calls() {
    let nums = vec_new()
    for i in 0..helper_min(helper_max(3, 5), 8) {
        vec_push(nums, i)
    }
    assert_eq(vec_len(nums), 5)
    assert_eq(unwrap(vec_get(nums, 0)), 0)
    assert_eq(unwrap(vec_get(nums, 4)), 4)
}

// Deeply nested: function calls inside function calls on both sides
@test
fn test_range_deeply_nested_both_sides() {
    let nums = vec_new()
    for i in helper_max(identity(1), identity(2))..helper_min(identity(6), identity(8)) {
        vec_push(nums, i)
    }
    assert_eq(vec_len(nums), 4)
    assert_eq(unwrap(vec_get(nums, 0)), 2)
    assert_eq(unwrap(vec_get(nums, 3)), 5)
}

// Nested range loops where both use function call bounds
@test
fn test_nested_ranges_with_function_bounds() {
    let sum = 0
    for y in 0..helper_min(3, 10) {
        for x in 0..helper_min(4, 10) {
            sum = sum + 1
        }
    }
    assert_eq(sum, 12)
}

// Range with arithmetic AND function calls combined
@test
fn test_range_with_mixed_expressions() {
    let nums = vec_new()
    let offset = 2
    for i in (offset + 1)..helper_min(10, 7) {
        vec_push(nums, i)
    }
    assert_eq(vec_len(nums), 4)
    assert_eq(unwrap(vec_get(nums, 0)), 3)
    assert_eq(unwrap(vec_get(nums, 3)), 6)
}
