// `x++` / `x--` in statement position desugars to the compound assignment
// `x = x + 1` / `x = x - 1` with the value discarded; value-position pre and
// post increments yield the new and old values respectively.

@test(output = "5")
fn test_postincrement_in_while() {
    let i = 0
    while i < 5 {
        i++
    }
    print("{i}")
}

@test(output = "4")
fn test_postincrement_in_for() {
    let s = 0
    for k in 0..4 {
        s++
    }
    print("{s}")
}

@test(output = "7\n3\n2")
fn test_statement_increment_and_decrement() {
    let d = 10
    d--
    d--
    d--
    print("{d}")
    let a = 2
    a++
    print("{a}")
    let b = 3
    b--
    print("{b}")
}

// Value-position: post returns the pre-increment value; pre returns
// the post-increment value. Both also mutate the lvalue.
@test(output = "2 3\n3 3\n9 9")
fn test_value_position() {
    let x = 2
    let y = x++
    print("{y} {x}")
    let p = 2
    let q = ++p
    print("{q} {p}")
    let m = 10
    let n = --m
    print("{n} {m}")
}

fn _inc_id(n: int) -> int { n }

@test(output = "10 9")
fn test_postdecrement_in_call_arg() {
    let x = 10
    let r = _inc_id(x--)
    print("{r} {x}")
}
