// User operator overloads: every overloadable operator dispatching to its user
// fn, mixed-type overloads (V2 + int, int + V2, several overloads of one
// operator coexisting), compound assignment through an overload on locals,
// fields, vector elements and safe-navigation chains, chained overload calls,
// and call arguments that promote into an overload's float params. Definition
// and call-site symbols share skull-mir::mangle, so mixed operands must target
// the same mangled symbol.

value Mark { v: int }

operator +(a: Mark, b: Mark) -> int { return 1001 }

operator -(a: Mark, b: Mark) -> int { return 1002 }

operator *(a: Mark, b: Mark) -> int { return 1003 }

operator /(a: Mark, b: Mark) -> int { return 1004 }

operator %(a: Mark, b: Mark) -> int { return 1005 }

operator ./(a: Mark, b: Mark) -> int { return 1006 }

@test
fn every_overloadable_operator_dispatches_to_the_user_fn() {
    let a = Mark { v: 7 }
    let b = Mark { v: 3 }
    assert((a + b) == 1001, "+ must call the overload")
    assert((a - b) == 1002, "- must call the overload")
    assert((a * b) == 1003, "* must call the overload")
    assert((a / b) == 1004, "/ must call the overload")
    assert((a % b) == 1005, "% must call the overload")
    assert((a ./ b) == 1006, "./ must call the overload")
}

// Primitive arithmetic is native codegen and must not be diverted by the
// presence of overloads on an unrelated type.
@test
fn primitive_arithmetic_is_unaffected_by_user_overloads() {
    assert(7 + 3 == 10, "int add stays native")
    assert(7.0 / 2.0 == 3.5, "float div stays native")
    assert(7 ./ 2 == 3, "int floor-div stays native")
}

// A newtype over a primitive derives its operators through the same path, and
// the synthesized comparison operators are exempt from the rejection -- so
// ordering on a newtype must still work.
newtype Tally(int)

@test
fn a_newtype_still_derives_arithmetic_and_ordering() {
    assert((Tally(4) + Tally(5)).0 == 9, "derived add")
    assert(Tally(4) < Tally(5), "derived ordering survives the rejection")
    assert(Tally(9) >= Tally(9), "and so does the non-strict form")
}

@test
fn test_eval_order_nested_writes() {
    let arr = [10, 20, 30]
    let i = 0
    let bump = (v: int) => {
        arr[i] = v + { i += 1; i }
    }
    bump(5)
    // LHS captured i=0, RHS mutates i to 1: arr[0] = 5 + 1 = 6
    assert_eq(arr[0], 6)
    assert_eq(i, 1)
    bump(50)
    // arr[1] = 50 + 2 = 52
    assert_eq(arr[1], 52)
}

struct V2 {
    x: float,
    y: float,
}

// ---------- Multiple `+` overloads on the same struct -----------------------

fn __op_add(a: V2, b: V2) -> V2 {
    return V2 { x: a.x + b.x, y: a.y + b.y }
}

fn __op_add(a: V2, b: int) -> V2 {
    return V2 { x: a.x + float(b), y: a.y + float(b) }
}

fn __op_add(a: V2, b: float) -> V2 {
    return V2 { x: a.x + b, y: a.y + b }
}

// ---------- V2 + V2 still picks the right overload -------------------------
@test(output = "4	7")
fn test_v2_plus_v2_among_many_overloads() {
    let a = V2 { x: 1.0, y: 2.0 }
    let b = V2 { x: 3.0, y: 5.0 }
    let c = a + b
    print(int(c.x), int(c.y))
}

// ---------- Struct on the left, int or float on the right ------------------
@test(output = "11	12\n4	5")
fn test_v2_plus_primitive() {
    let a = V2 { x: 1.0, y: 2.0 }
    let c = a + 10
    print(int(c.x), int(c.y))
    let b = V2 { x: 1.5, y: 2.5 }
    let d = b + 2.5
    print(int(d.x), int(d.y))
}

// ---------- Compound `+=` with mixed Vec2 + int / float overloads -----------
@test(output = "11	12\n4	5")
fn test_v2_compound_plus_primitive() {
    let p = V2 { x: 1.0, y: 2.0 }
    p += 10
    print(int(p.x), int(p.y))
    let q = V2 { x: 1.5, y: 2.5 }
    q += 2.5
    print(int(q.x), int(q.y))
}

// ---------- Primitive on the LEFT: int + Vec2 -------------------------------
fn __op_add(a: int, b: V2) -> V2 {
    return V2 { x: float(a) + b.x, y: float(a) + b.y }
}

@test(output = "11	12")
fn test_int_plus_v2() {
    let b = V2 { x: 1.0, y: 2.0 }
    let c = 10 + b
    print(int(c.x), int(c.y))
}

// ---------- Multiple mixed overloads of different ops -----------------------
fn __op_sub(a: V2, b: int) -> V2 {
    return V2 { x: a.x - float(b), y: a.y - float(b) }
}

fn __op_mul(a: V2, b: int) -> V2 {
    return V2 { x: a.x * float(b), y: a.y * float(b) }
}

@test(output = "5	6\n20	40")
fn test_v2_minus_and_times_int() {
    let a = V2 { x: 15.0, y: 16.0 }
    let c = a - 10
    print(int(c.x), int(c.y))
    let b = V2 { x: 10.0, y: 20.0 }
    let d = b * 2
    print(int(d.x), int(d.y))
}

// ---------- Compound RHS uses a mixed overload: `p += a * 2` ----------------
// p, a are V2; `a * 2` selects __op_mul(V2, int) -> V2; then `p += V2` selects
// __op_add(V2, V2) -> V2.
@test(output = "21	42")
fn test_compound_with_mixed_rhs() {
    let p = V2 { x: 1.0, y: 2.0 }
    let a = V2 { x: 10.0, y: 20.0 }
    p += a * 2
    print(int(p.x), int(p.y))
}

// ---------- Compound `+=` with int on RHS, deep safe-nav target -------------
struct M1 { v: V2 }
struct M2 { m1: M1? }

@test(output = "11	12")
fn test_compound_safenav_with_mixed_rhs() {
    let m: M2? = M2 { m1: M1 { v: V2 { x: 1.0, y: 2.0 } } }
    m?.m1?.v += 10
    if m != null && m.m1 != null {
        print(int(m.m1.v.x), int(m.m1.v.y))
    }
}

// ---------- Vec-indexed compound `+=` with mixed primitive RHS --------------
@test(output = "11	12")
fn test_vec_index_compound_mixed_rhs() {
    let xs: [V2] = [V2 { x: 1.0, y: 2.0 }]
    xs[0] += 10
    print(int(xs[0].x), int(xs[0].y))
}

// --- Compound assignment (`+=` etc.) dispatches to the user overload ---

struct CV2 {
    x: float,
    y: float,
}

fn __op_add(a: CV2, b: CV2) -> CV2 {
    return CV2 { x: a.x + b.x, y: a.y + b.y }
}

fn __op_sub(a: CV2, b: CV2) -> CV2 {
    return CV2 { x: a.x - b.x, y: a.y - b.y }
}

fn __op_mul(a: CV2, s: float) -> CV2 {
    return CV2 { x: a.x * s, y: a.y * s }
}

fn __op_div(a: CV2, s: float) -> CV2 {
    return CV2 { x: a.x / s, y: a.y / s }
}

// ---------- `+=` on a field with multiplied RHS ----------
struct Holder { pos: CV2 }

@test(output = "5	11")
fn test_compound_add_overload_field() {
    let h = Holder { pos: CV2 { x: 1.0, y: 1.0 } }
    h.pos += CV2 { x: 2.0, y: 5.0 } * 2.0
    print(int(h.pos.x), int(h.pos.y))
}

// ---------- `-=` on a field ----------
@test(output = "8	6")
fn test_compound_sub_overload_field() {
    let h = Holder { pos: CV2 { x: 10.0, y: 10.0 } }
    h.pos -= CV2 { x: 2.0, y: 4.0 }
    print(int(h.pos.x), int(h.pos.y))
}

// ---------- `*=` struct * float (mixed-type overload) ----------
@test(output = "6	10")
fn test_compound_mul_overload_mixed() {
    let p = CV2 { x: 3.0, y: 5.0 }
    p *= 2.0
    print(int(p.x), int(p.y))
}

// ---------- `/=` struct / float ----------
@test(output = "5	4")
fn test_compound_div_overload_mixed() {
    let p = CV2 { x: 10.0, y: 8.0 }
    p /= 2.0
    print(int(p.x), int(p.y))
}

// ---------- Safe-nav target with overload: must skip cleanly when null ----------
struct Inner { vec: CV2 }
struct Outer { inner: Inner? }

@test(output = "12	22\nok")
fn test_compound_safenav_overload() {
    let o = Outer { inner: Inner { vec: CV2 { x: 10.0, y: 20.0 } } }
    o.inner?.vec += CV2 { x: 2.0, y: 2.0 }
    if o.inner != null {
        print(int(o.inner.vec.x), int(o.inner.vec.y))
    }
    let n = Outer { inner: null }
    n.inner?.vec += CV2 { x: 99.0, y: 99.0 }
    if n.inner == null {
        print("ok")
    }
}

// ---------- `+=` on a struct stored inside a Vec element ----------
@test(output = "7	11")
fn test_compound_add_overload_in_vec_index() {
    let xs: [CV2] = [CV2 { x: 1.0, y: 2.0 }, CV2 { x: 5.0, y: 9.0 }]
    xs[1] += CV2 { x: 2.0, y: 2.0 }
    print(int(xs[1].x), int(xs[1].y))
}

// ---------- Primitive `+=` stays native; strings need Lua `..`, not `+` ------
@test(output = "hello world\n8\n12")
fn test_compound_primitive() {
    let s = "hello"
    s += " world"
    print(s)
    let n = 3
    n += 5
    print(n)
    let m = 3
    m *= 4
    print(m)
}

// ---------- Deep safe-nav chain with overload at the leaf ----------
struct Lvl1 { vec: CV2 }
struct Lvl2 { l1: Lvl1? }
struct Lvl3 { l2: Lvl2? }

@test(output = "11	22\nok")
fn test_compound_deep_safenav_overload() {
    let root: Lvl3? = Lvl3 { l2: Lvl2 { l1: Lvl1 { vec: CV2 { x: 10.0, y: 20.0 } } } }
    root?.l2?.l1?.vec += CV2 { x: 1.0, y: 2.0 }
    if root != null && root.l2 != null && root.l2.l1 != null {
        print(int(root.l2.l1.vec.x), int(root.l2.l1.vec.y))
    }
    let empty: Lvl3? = Lvl3 { l2: null }
    empty?.l2?.l1?.vec += CV2 { x: 99.0, y: 99.0 }
    if empty != null && empty.l2 == null {
        print("ok")
    }
}

// ---------- Newtype `+=` (must unwrap, op, rewrap) ----------
newtype Money(int)

@test(output = "150")
fn test_compound_add_newtype() {
    let m = Money(100)
    m += Money(50)
    print(m.0)
}

// --- A chained `a + b + c` through a user overload keeps every operand ---

value ChainV2 { x: int, y: int }

operator +(a: ChainV2, b: ChainV2) -> ChainV2 {
    return ChainV2 { x: a.x + b.x, y: a.y + b.y }
}

fn add3(a: ChainV2, b: ChainV2, c: ChainV2) -> ChainV2 {
    return a + b + c
}

@test(output = "9\n12")
fn test_operator_triple_chain() {
    let r = add3(ChainV2 { x: 1, y: 2 }, ChainV2 { x: 3, y: 4 }, ChainV2 { x: 5, y: 6 })
    print("{r.x}")
    print("{r.y}")
}

// --- Arithmetic and loop-variable call arguments promote into float params;
// `fixv(x, y) * n` with an int `n` picks the int-scaled overload ---

struct FixVec2 {
    x: float,
    y: float,
}

fn fixv(x: float, y: float) -> FixVec2 {
    return FixVec2 { x: x, y: y }
}

operator *(v: FixVec2, scale: float) -> FixVec2 {
    return FixVec2 { x: v.x * scale, y: v.y * scale }
}

operator *(v: FixVec2, scale: int) -> FixVec2 {
    let s = float(scale)
    return FixVec2 { x: v.x * s, y: v.y * s }
}

@test
fn test_v_with_arithmetic_exprs() {
    let PAD = 10.0
    let BAR_HEIGHT = 20.0

    let vec = fixv(2.0 * PAD, 3.0 * (BAR_HEIGHT + PAD))

    assert_eq(vec.x, 20.0)
    assert_eq(vec.y, 90.0)
}

@test
fn test_v_in_nested_for_loops_with_multiplication() {
    let bg_size = 28
    let span = 3

    for x in (-span)..(span + 1) {
        for y in (-span)..(span + 1) {
            let result = fixv(x, y) * bg_size

            assert_eq(result.x, float(x * bg_size))
            assert_eq(result.y, float(y * bg_size))
        }
    }
}

