// Operator precedence: `as` binds tighter than the arithmetic operators, `%`
// sits on the `*`/`/` tier, and unary minus binds tighter than any binary
// operator.

@test
fn test_as_operator_precedence_with_division() {
    // Test that 'as' has higher precedence than division
    // 1 / 2 as float should parse as 1 / (2 as float) = 0.5
    // not as (1 / 2) as float = 0.0
    let result = 1 / 2 as float
    assert_eq(result, 0.5)
    let result = 1 / (2 as float)
    assert_eq(result, 0.5)
}

@test
fn test_as_operator_precedence_left_side() {
    // Test that 'as' still works correctly on the left side
    // 1 as float / 2 should parse as (1 as float) / 2 = 0.5
    let result = 1 as float / 2
    assert_eq(result, 0.5)
}

@test
fn test_as_operator_precedence_with_multiplication() {
    // Test that 'as' has higher precedence than multiplication
    // 2 * 3 as float should parse as 2 * (3 as float) = 6.0
    let result = 2 * 3 as float
    assert_eq(result, 6.0)
}

@test
fn test_as_operator_precedence_with_addition() {
    // Test that 'as' has higher precedence than addition
    // 5 + 2 as float should parse as 5 + (2 as float) = 7.0
    let result = 5 + 2 as float
    assert_eq(result, 7.0)
}

@test
fn test_as_operator_precedence_with_subtraction() {
    // Test that 'as' has higher precedence than subtraction
    // 10 - 3 as float should parse as 10 - (3 as float) = 7.0
    let result = 10 - 3 as float
    assert_eq(result, 7.0)
}

@test
fn test_as_operator_complex_expression() {
    // Test complex expression with multiple operators
    // 1 + 2 * 3 as float / 2 should parse as 1 + (2 * (3 as float) / 2) = 4.0
    let result = 1 + 2 * 3 as float / 2
    assert_eq(result, 4.0)
}

@test
fn test_as_operator_with_parentheses() {
    // Test that explicit parentheses still work correctly
    // (1 + 2) as float * 3 should parse as ((1 + 2) as float) * 3 = 9.0
    let result = (1 + 2) as float * 3
    assert_eq(result, 9.0)
}

@test
fn test_as_operator_int_to_float_casting() {
    // Test integer division vs float division
    let int_div = 5 ./ 2  // Should be 2 (integer division)
    let float_div = 5 / 2 as float  // Should be 2.5 (5 / (2 as float))

    assert_eq(int_div, 2)
    assert_eq(float_div, 2.5)
}

// `%` must bind with `*` and `/`, not below `+`/`-` and the comparisons.
//
// It did not: `rock-tokenizer`'s infix_bp put Mod at 21, which is under
// `==`/`!=` (19) only, and below `<<`/`>>` (23), the comparisons (25), `+`/`-`
// (31) and `*`/`/` (35). So `a + b % c` parsed as `(a + b) % c`, `a % b * c` as
// `a % (b * c)`, and `a % b < c` as `a % (b < c)` -- a modulo of a bool, which
// the typechecker rejected, so that shape simply could not be written. Only
// `a * b % c` came out right, by the accident of `*` already binding tighter.
//
// Same table and same class of defect as `nullable/coalesce_precedence.rock`.
//
// The guards at the bottom pin the other side, so lowering the level cannot
// silently drag `%` back under the operators it must stay above.

@test
fn mod_binds_tighter_than_plus_and_minus() {
    // 10 - (7 % 4) = 10 - 3 = 7. The old table read this as (10 - 7) % 4 = 3.
    assert_eq(10 - 7 % 4, 7)
    assert_eq(10 + 7 % 4, 13)
    // And on the left, where the old table swallowed the whole sum:
    // 7 % (4 + 2) = 1 under the old reading, (7 % 4) + 2 = 5 under this one.
    assert_eq(7 % 4 + 2, 5)
    assert_eq(7 % 4 - 1, 2)
}

@test
fn mod_is_left_associative_with_mul_and_div() {
    // (7 % 4) * 3 = 9. The old table read this as 7 % (4 * 3) = 7.
    assert_eq(7 % 4 * 3, 9)
    // (20 / 3) % 4, integer-divided: 6 % 4 = 2. Right either way, and that is
    // the point -- it is the one shape the old table got right, so it guards
    // against a fix that overshoots.
    assert_eq(20 ./ 3 % 4, 2)
    assert_eq(7 * 4 % 5, 3)
    // Left-associative among themselves.
    assert_eq(23 % 7 % 3, 2)
}

@test
fn mod_binds_tighter_than_the_comparisons() {
    // Not expressible at all before the fix: `7 % 4 < 2` parsed as
    // `7 % (4 < 2)`, and int % bool is a type error.
    assert_eq(7 % 4 < 2, false)
    assert_eq(7 % 4 > 2, true)
    assert_eq(7 % 4 >= 3, true)
    assert_eq(2 < 7 % 4, true)
}

@test
fn mod_binds_tighter_than_the_shifts() {
    // (7 % 4) << 2 = 12; `7 % (4 << 2)` = 7 under the old table.
    assert_eq(7 % 4 << 2, 12)
    // And on the right: the modulo is the SHIFT DISTANCE, not something applied
    // to the shifted value. 24 >> (2 % 5) = 24 >> 2 = 6, where the old table
    // read it as (24 >> 2) % 5 = 1.
    assert_eq(24 >> 2 % 5, 6)
}

// --- guards on the other side ---

@test
fn mod_still_binds_looser_than_equality_and_logic() {
    // `==` must still see the whole modulo as its operand.
    assert_eq(7 % 4 == 3, true)
    assert_eq(7 % 4 != 3, false)
    assert_eq(8 % 4 == 0 && 9 % 4 == 1, true)
    assert_eq(7 % 4 == 0 || 7 % 3 == 1, true)
}

@test
fn mod_still_binds_looser_than_field_and_call() {
    let v = [9, 8, 7]
    // Indexing and calls stay tighter, so the modulo takes the whole postfix.
    assert_eq(v[1] % 3, 2)
    assert_eq(v.len() % 2, 1)
}

// The float form takes the same path through the parser, so it moves with the
// integer one rather than being a separate case.
@test
fn mod_precedence_holds_for_floats() {
    assert_eq(10.0 - 7.0 % 4.0, 7.0)
    assert_eq(7.0 % 4.0 * 3.0, 9.0)
}

// Tests that unary minus binds tighter than binary operators.
// Bug: `-x / y - z / w` was being parsed as `-(x / y - z / w)`
// instead of `(-x) / y - z / w`

@test(output = "-7")
fn unary_minus_with_division() {
    let x = 10.0
    let y = 2.0
    // Should be (-10.0) / 2.0 = -5.0, then -5.0 - 2.0 = -7.0
    let result = -x / y - y
    print(result)
}

@test(output = "-5")
fn unary_minus_in_compound_expression() {
    let a = 6.0
    let b = 2.0
    let c = 4.0
    let d = 2.0
    // Should be (-6.0) / 2.0 - 4.0 / 2.0 = -3.0 - 2.0 = -5.0
    // Bug would compute: -(6.0 / 2.0 - 4.0 / 2.0) = -(3.0 - 2.0) = -1.0
    let result = -a / b - c / d
    print(result)
}

@test(output = "-5")
fn unary_minus_binds_before_division() {
    let x = 10.0
    let y = 2.0
    // Should be (-10.0) / 2.0 = -5.0
    // Bug would give -(10.0 / 2.0) = -5.0 (same result for simple case)
    let result = -x / y
    print(result)
}

@test(output = "-9")
fn unary_minus_field_access_with_division() {
    let pos = 6.0
    let tw = 1.0
    let th = 0.5
    // This is the actual pattern from the iso projection bug:
    // (-pos / tw - pos / th) / 2.0
    // Should be: ((-6) / 1 - 6 / 0.5) / 2 = (-6 - 12) / 2 = -9
    // Bug computes: (-(6 / 1 - 6 / 0.5)) / 2 = -(6 - 12) / 2 = 3
    let result = (-pos / tw - pos / th) / 2.0
    print(result)
}
