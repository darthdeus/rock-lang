@nomangle fn cast(value: float) -> uint { value as uint }
@nomangle fn from_int(value: int) -> uint { value as uint }
@nomangle fn left(value: uint, count: uint) -> uint { value << count }
@nomangle fn right(value: uint, count: uint) -> uint { value >> count }
@nomangle fn take(values: [uint]) -> uint {
    let value = values[0]
    values[0] += (1 as uint)
    value
}
@nomangle fn cast_once(values: [uint]) -> uint { (take(values) as float) as uint }
@nomangle fn left_once(values: [uint]) -> uint { take(values) << take(values) }
@nomangle fn right_once(values: [uint]) -> uint { take(values) >> take(values) }

@nomangle fn root(value: uint) -> uint { return value }

inline(lua) fn probe() = """
local function rejects(fn, message, ...)
  local ok, err = pcall(fn, ...)
  assert(not ok and tostring(err):sub(-#message) == message, tostring(err))
end
assert(cast(0) == 0 and cast(3.9) == 3 and cast(4294967295) == 4294967295)
assert(1 / cast(-0.0) == -math.huge)
assert(from_int(0) == 0 and from_int(4294967295) == 4294967295)
for _, value in ipairs({-1, 4294967296}) do
  rejects(from_int, 'uint conversion out of range', value)
end
for _, value in ipairs({-0.1, 4294967295.5, 0/0, math.huge, -math.huge}) do
  rejects(cast, 'uint conversion out of range', value)
end
assert(left(1, 0) == 1 and left(1, 31) == 2147483648)
assert(right(4294967295, 0) == 4294967295 and right(4294967295, 31) == 1)
for _, fn in ipairs({left, right}) do
  for _, count in ipairs({32, 4294967295}) do
    rejects(fn, 'uint shift count out of range', 0, count)
  end
end
local values = {[0]=1, 1}
assert(cast_once(values) == 1 and values[1] == 2)
values[1] = 1
assert(left_once(values) == 4 and values[1] == 3)
values[1] = 1
assert(right_once(values) == 0 and values[1] == 3)

assert(root(-1) == 4294967295)
"""

@test(backends = "lua")
fn exec_uint_checks_preserve_ranges_and_single_evaluation() { probe() }
