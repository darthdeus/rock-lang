// Bitwise operators `&`, `|`, `^`, `~`, `<<`, `>>`, binary and hex literals,
// and the signed 32-bit result range every backend must reproduce.

@test
fn test_and_or_xor_not() {
    assert_eq(5 & 3, 1)
    assert_eq(0xFF & 0x0F, 0x0F)
    assert_eq(7 & 4, 4)
    assert_eq(0 & 0xFF, 0)
    assert_eq(42 & 42, 42)
    assert_eq(5 | 3, 7)
    assert_eq(0xF0 | 0x0F, 0xFF)
    assert_eq(1 | 2 | 4, 7)
    assert_eq(0 | 0, 0)
    assert_eq(42 | 0, 42)
    assert_eq(5 ^ 3, 6)
    assert_eq(0xFF ^ 0xFF, 0)
    assert_eq(0xFF ^ 0x0F, 0xF0)
    assert_eq(7 ^ 7, 0)
    assert_eq(42 ^ 0, 42)
    assert_eq(~0, -1)
    assert_eq(~1, -2)
    assert_eq(~(-1), 0)
    assert_eq(~~42, 42)
    assert_eq(0 & 42, 0)
    assert_eq(0 | 42, 42)
    assert_eq(0 ^ 42, 42)
    assert_eq(-1 & 5, 5)
    assert_eq(-1 | 5, -1)
    assert_eq(16 & 15, 0)
    assert_eq(16 | 15, 31)
    assert_eq(16 ^ 15, 31)
    assert_eq(0xF0 & 0x3C, 0x30)
    assert_eq(0xF0 | 0x0C, 0xFC)
    assert_eq(0xF0 ^ 0x3C, 0xCC)
}

@test
fn test_shifts() {
    assert_eq(1 << 0, 1)
    assert_eq(1 << 1, 2)
    assert_eq(1 << 2, 4)
    assert_eq(1 << 3, 8)
    assert_eq(5 << 2, 20)
    assert_eq(0xFF << 8, 0xFF00)
    assert_eq(1 << 4, 16)
    assert_eq(8 >> 1, 4)
    assert_eq(8 >> 2, 2)
    assert_eq(8 >> 3, 1)
    assert_eq(20 >> 2, 5)
    assert_eq(0xFF00 >> 8, 0xFF)
    assert_eq(1 >> 1, 0)
    assert_eq(256 >> 4, 16)
    assert_eq(0 << 5, 0)
    assert_eq(0 >> 5, 0)
}

fn mask_low_bits(x: int) -> int {
    return x & 0b1111
}

@test
fn test_binary_and_hex_literals() {
    assert_eq(0b0, 0)
    assert_eq(0b1, 1)
    assert_eq(0b10, 2)
    assert_eq(0b1010, 10)
    assert_eq(0b11111111, 255)
    assert_eq(0b10101010, 170)
    assert_eq(0b1010_1010, 170)
    assert_eq(0b1111_1111_1111_1111, 65535)
    assert_eq(0x0, 0)
    assert_eq(0x1, 1)
    assert_eq(0xA, 10)
    assert_eq(0xF, 15)
    assert_eq(0xFF, 255)
    assert_eq(0x10, 16)
    assert_eq(0x100, 256)
    assert_eq(0xDEAD_BEEF, 3735928559)
    assert_eq(0xFF_FF, 65535)
    assert_eq(mask_low_bits(0b11110000), 0)
    assert_eq(mask_low_bits(0b11111111), 15)
    assert_eq(0b1010 & 0b1100, 8)
    assert_eq(0b1111 | 0b0000, 15)
}

@test
fn test_grouping_and_precedence() {
    assert_eq((5 & 3) | 4, 5)
    assert_eq((1 << 2) | (1 << 0), 5)
    assert_eq((0xFF & 0x0F) << 4, 0xF0)
    let a = 0b10101010
    let b = 0b11001100
    assert_eq(a & b, 0b10001000)
    assert_eq(a | b, 0b11101110)
    assert_eq(a ^ b, 0b01100110)
    assert_eq((2 + 3) & 7, 5)
    assert_eq((2 * 3) | 1, 7)
    assert_eq((8 ./ 2) ^ 3, 7)
    assert_eq(8 ./ (2 ^ 3), 8)
    assert_eq((5 | 3) & 1, 1)
    assert_eq(5 | (3 & 1), 5)
}

fn set_bit(n: int, pos: int) -> int {
    return n | (1 << pos)
}

fn clear_bit(n: int, pos: int) -> int {
    return n & ~(1 << pos)
}

fn toggle_bit(n: int, pos: int) -> int {
    return n ^ (1 << pos)
}

fn check_bit(n: int, pos: int) -> bool {
    return (n & (1 << pos)) != 0
}

fn extract_red(color: int) -> int {
    return (color & 0xFF0000) >> 16
}

fn extract_green(color: int) -> int {
    return (color & 0x00FF00) >> 8
}

fn extract_blue(color: int) -> int {
    return color & 0x0000FF
}

@test
fn test_bit_manipulation_patterns() {
    let n1 = set_bit(0, 0)
    assert_eq(n1, 1)
    let n2 = set_bit(n1, 2)
    assert_eq(n2, 5)
    assert_eq(check_bit(n2, 0), true)
    assert_eq(check_bit(n2, 1), false)
    assert_eq(check_bit(n2, 2), true)
    let n3 = clear_bit(n2, 0)
    assert_eq(n3, 4)
    let n4 = toggle_bit(n3, 1)
    assert_eq(n4, 6)
    let purple = 0xFF00FF
    assert_eq(extract_red(purple), 255)
    assert_eq(extract_green(purple), 0)
    assert_eq(extract_blue(purple), 255)
}

// Every op is 32-bit: operands coerce to int32, a shift count masks to 5 bits,
// and the result comes back SIGNED. `>>` shifts in zeros (it is not arithmetic),
// so a negative left operand goes positive. LuaJIT lowers these to `bit.*`; JS
// `>>>` yields an UNSIGNED value, so a naive mapping returns 4294967295 for
// `-1 >> 0` where LuaJIT returns -1, and JS `>>` would sign-fill.
@test
fn test_int32_wraparound_and_sign() {
    assert_eq(-1 >> 1, 2147483647)
    assert_eq(-8 >> 1, 2147483644)
    assert_eq(-16 >> 4, 268435455)
    assert_eq(-1 >> 0, -1)
    assert_eq(1 << 31, -2147483648)
    assert_eq(1 << 32, 1)
    assert_eq(~0xFFFFFFFF, 0)
    assert_eq(0xFFFFFFFF ^ 0, -1)
    assert_eq(0xFF00 >> 8 << 8, 0xFF00)
    assert_eq(-1 & 0xFF, 0xFF)
}

fn dynamic_signed_shifts(value: int, count: int) -> (int, int) {
    return (value << count, value >> count)
}

@test
fn dynamic_signed_shift_counts_mask_to_five_bits() {
    let (left, right) = dynamic_signed_shifts(0xFFFFFFFF, 33)
    assert_eq(left, -2)
    assert_eq(right, 2147483647)
    let (left, right) = dynamic_signed_shifts(0xFFFFFFFF, -1)
    assert_eq(left, -2147483648)
    assert_eq(right, 1)
}
