fn masks() -> (int, uint, uint, uint) {
    let zero: uint = 0
    let high: uint = 2147483648
    let all: uint = 4294967295
    let high_again: uint = 2147483648
    return (~(~2147483647), ~(~zero), high | 1, all ^ high_again)
}

@test
fn constant_masks_keep_signed_and_unsigned_results() {
    let (s, a, b, c) = masks()
    assert(s == 2147483647 && a == 0 && b == 2147483649 && c == 2147483647)
}
