// Basic arithmetic, division, comparison, logic and unary operators: `/` is
// always float division, `./` is floor division at the `*` tier, `&&` and
// `||` short-circuit, and unary operators dispatch to user overloads.

fn side_effect_true() -> bool {
    print("side effect called")
    return true
}

fn side_effect_false() -> bool {
    print("side effect called")
    return false
}

struct FixVec2 {
    x: float,
    y: float,
}

fn __unm(v: FixVec2) -> FixVec2 {
    return FixVec2 { x: 0.0 - v.x, y: 0.0 - v.y }
}

struct BoolWrapper {
    value: bool,
}

fn __not(b: BoolWrapper) -> BoolWrapper {
    return BoolWrapper { value: if b.value { false } else { true } }
}

@test(output = "3\n2\n10\n6\n5\n0")
fn int_arithmetic() {
    print(1 + 2)
    print(5 - 3)
    print(10 + 0)
    print(2 * 3)
    print(10 ./ 2)
    print(5 * 0)
}

@test(output = "4\n1.8\n10\n10\n3\n0")
fn float_arithmetic() {
    print(1.5 + 2.5)
    print(5.0 - 3.2)
    print(10.0 + 0.0)
    print(2.5 * 4.0)
    print(9.0 / 3.0)
    print(5.5 * 0.0)
}

@test(output = "3.5\n2\n10\n7\n3.5")
fn mixed_int_float_arithmetic() {
    print(1 + 2.5)
    print(5.0 - 3)
    print(10 + 0.0)
    print(2 * 3.5)
    print(7.0 / 2)
}

@test(output = "true\ntrue\ntrue\ntrue\ntrue\nfalse")
fn comparison_operators_int_and_float() {
    print(1 < 2)
    print(2 <= 2)
    print(3 > 1)
    print(3.5 >= 3.5)
    print(1 < 1.5)
    print(2.5 > 5)
}

@test(output = "false\nside effect called\ntrue")
fn short_circuit_and_operator() {
    let result1 = false && side_effect_true()
    print(result1)

    let result2 = true && side_effect_true()
    print(result2)
}

@test(output = "true\nside effect called\nfalse")
fn short_circuit_or_operator() {
    let result1 = true || side_effect_false()
    print(result1)

    let result2 = false || side_effect_false()
    print(result2)
}

@test(output = "2\n2\n1\n2")
fn pre_and_post_increment_float() {
    let x: float = 1.0
    let a = ++x
    print(a)
    print(x)
    let y: float = 1.0
    let b = y++
    print(b)
    print(y)
}

@test(output = "-5\n0\n-10\n-3.14\n1.5\n-2.5\n-8\n4\n-6")
fn unary_minus() {
    print(-5)
    print(-0)
    let x = 10
    print(-x)
    print(-3.14)
    print(-(-1.5))
    let y = 2.5
    print(-y)
    print(-(5 + 3))
    print(-(-4))
    print(-(2 * 3))
}

@test(output = "-2\n-2\n6\n-5\n-6\n-5")
fn unary_minus_with_binary_operations() {
    print(-5 + 3)
    print(2 + -4)
    print(-3 * -2)
    print(-10 ./ 2)
    print(-2 * 3)
    let x = 5
    print(-1 * x)
}

@test(output = "-3\n-4")
fn unary_minus_custom_type_overload() {
    let v = FixVec2 { x: 3.0, y: 4.0 }
    let neg_v = -v

    print(neg_v.x)
    print(neg_v.y)
}

@test(output = "false\ntrue")
fn not_operator_custom_type_overload() {
    let b = BoolWrapper { value: true }
    let not_b = !b
    print(not_b.value)

    let c = BoolWrapper { value: false }
    let not_c = !c
    print(not_c.value)
}

@test(output = "false\ntrue\ntrue\ntrue")
fn not_operator_in_expressions() {
    print(!true || false)
    print(true && !false)
    print(!(true && false))
    print(!false == true)
}

@test(output = "0.75")
fn test_slash_is_float_division() {
    // unannotated let infers float, no truncation
    let x = 3 / 4
    assert_eq(x, 0.75)
    let y: float = 3 / 4
    assert_eq(y, 0.75)
    assert_eq(10 / 4, 2.5)
    let r1: float = 5 / 2.0
    assert_eq(r1, 2.5)
    let r2: float = 5.0 / 2
    assert_eq(r2, 2.5)
    print(3 / 4)
}

@test
fn test_idiv_floors_at_the_mul_tier() {
    assert_eq(3 ./ 4, 0)
    assert_eq(7 ./ 2, 3)
    // floor, NOT truncation: rounds toward -inf
    assert_eq(-7 ./ 2, -4)
    // binds tighter than `+`: 1 + (6 ./ 4)
    assert_eq(1 + 6 ./ 4, 2)
    // same tier as `*`, left assoc: (2 * 3) ./ 2
    assert_eq(2 * 3 ./ 2, 3)
    let result: int = 5 ./ 2
    assert_eq(result, 2)
}

@test
fn test_int_arithmetic_promotes_into_float_binding() {
    let result1: float = 5 + 2
    assert_eq(result1, 7.0)
    let result2: float = 5 - 2
    assert_eq(result2, 3.0)
    let result3: float = 5 * 2
    assert_eq(result3, 10.0)
}

fn division_first_of<T>(a: T, b: T) -> T { return a }

// The int argument provisionally fixes `T`; the float division widens it back
// to float instead of reporting the `./` hint.
@test
fn float_division_widens_a_numeric_type_parameter() {
    let picked = division_first_of(1, (3.0 / 4.0) * 1.6)
    assert_eq(picked, 1.0)
}

@test
fn test_and_operator() {
    assert_eq(true && true, true)
    assert_eq(true && false, false)
    assert_eq(false && true, false)
    assert_eq(false && false, false)
}

@test
fn test_or_operator() {
    assert_eq(true || true, true)
    assert_eq(true || false, true)
    assert_eq(false || true, true)
    assert_eq(false || false, false)
}

@test
fn test_not_operator() {
    assert_eq(!true, false)
    assert_eq(!false, true)
    assert_eq(!!true, true)
    assert_eq(!(!false), false)
}

@test
fn test_complex_short_circuit_case() {
    let layer: int? = null

    // This should not crash - the right side should not be evaluated
    let result = layer != null && layer > 0

    assert_false(result, "Result should be false")
}

@test
fn primitive_arithmetic_dispatches_across_types() {
    let a = -7
    let b = 2
    assert_eq((a + b, a - b, a * b, a ./ b, a % b), (-5, -9, -14, -4, 1))
    let x = a as float
    let y = b as float
    assert_eq((x + y, x - y, x * y, x / y, x % y), (-5.0, -9.0, -14.0, -3.5, 1.0))
    let u: uint = 4294967295
    let two: uint = 2
    assert_eq((u + two, u - two, u * two, u ./ two, u % two),
        (1 as uint, 4294967293 as uint, 4294967294 as uint, 2147483647 as uint, 1 as uint))
    assert_eq("rock" + " salt", "rock salt")
}
