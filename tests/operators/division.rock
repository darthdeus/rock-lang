// Division: `/` is always float division (int operands promote), `./` is
// integer floor division at the `*` precedence tier, and int arithmetic
// assigned to a float-annotated binding promotes.

@test(output = "0.75")
fn test_slash_is_float_division() {
    // unannotated let infers float, no truncation
    let x = 3 / 4
    assert_eq(x, 0.75)
    let y: float = 3 / 4
    assert_eq(y, 0.75)
    assert_eq(10 / 4, 2.5)
    let r1: float = 5 / 2.0
    assert_eq(r1, 2.5)
    let r2: float = 5.0 / 2
    assert_eq(r2, 2.5)
    print(3 / 4)
}

@test
fn test_idiv_floors_at_the_mul_tier() {
    assert_eq(3 ./ 4, 0)
    assert_eq(7 ./ 2, 3)
    // floor, NOT truncation: rounds toward -inf
    assert_eq(-7 ./ 2, -4)
    // binds tighter than `+`: 1 + (6 ./ 4)
    assert_eq(1 + 6 ./ 4, 2)
    // same tier as `*`, left assoc: (2 * 3) ./ 2
    assert_eq(2 * 3 ./ 2, 3)
    let result: int = 5 ./ 2
    assert_eq(result, 2)
}

@test
fn test_int_arithmetic_promotes_into_float_binding() {
    let result1: float = 5 + 2
    assert_eq(result1, 7.0)
    let result2: float = 5 - 2
    assert_eq(result2, 3.0)
    let result3: float = 5 * 2
    assert_eq(result3, 10.0)
}

fn division_first_of<T>(a: T, b: T) -> T { return a }

// The int argument provisionally fixes `T`; the float division widens it back
// to float instead of reporting the `./` hint.
@test
fn float_division_widens_a_numeric_type_parameter() {
    let picked = division_first_of(1, (3.0 / 4.0) * 1.6)
    assert_eq(picked, 1.0)
}
