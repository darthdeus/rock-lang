// Map equality compares contents, order-free, directly and behind a struct
// field. Regression: a JS `Map` has no own enumerable keys, so a generic
// key-walk deep-eq compared every pair of Maps equal.

@test(output = "false false true")
fn map_direct_eq() {
    let a = map_new()
    a[1] = 10
    let diff_value = map_new()
    diff_value[1] = 20
    let diff_size = map_new()
    diff_size[1] = 10
    diff_size[2] = 20
    let reordered = map_new()
    reordered[2] = 20
    reordered[1] = 10
    print("{a == diff_value} {a == diff_size} {diff_size == reordered}")
}

@test(output = "true false")
fn map_string_keys() {
    let a = map_new()
    a["x"] = 1
    let b = map_new()
    b["x"] = 1
    let c = map_new()
    c["x"] = 2
    print("{a == b} {a == c}")
}

// A Map behind a reference-struct field takes the eq-walk path.

struct Holder {
    m: Map<int, int>,
    tag: int,
}

@test(output = "true false")
fn map_struct_field() {
    let a = Holder { m: map_new(), tag: 9 }
    a.m[1] = 10
    let b = Holder { m: map_new(), tag: 9 }
    b.m[1] = 10
    let c = Holder { m: map_new(), tag: 9 }
    c.m[1] = 99
    print("{a == b} {a == c}")
}
