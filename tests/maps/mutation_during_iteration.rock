// Map iteration follows the backend's live `next` walk. Do not assume key order.

value MapWalkCell {
    n: int,
    tag: int,
}

@test(output = "3 60 true")
fn scalar_map_remove_current_during_iteration() {
    let m: Map<string, int> = map_new()
    m["a"] = 10
    m["b"] = 20
    m["c"] = 30
    let seen = 0
    let sum = 0
    for (k, v) in m {
        m.remove(k)
        seen += 1
        sum += v
    }
    print("{seen} {sum} {m.is_empty()}")
}

@test(output = "3 6 true")
fn column_map_remove_current_during_iteration() {
    let m: Map<string, MapWalkCell> = map_new()
    m["a"] = MapWalkCell { n: 1, tag: 10 }
    m["b"] = MapWalkCell { n: 2, tag: 20 }
    m["c"] = MapWalkCell { n: 3, tag: 30 }
    let seen = 0
    let sum = 0
    for (k, v) in m {
        m.remove(k)
        seen += 1
        sum += v.n
    }
    print("{seen} {sum} {m.is_empty()}")
}

@test(output = "2 2")
fn scalar_map_remove_pending_key_during_iteration() {
    let m: Map<string, int> = map_new()
    m["a"] = 1
    m["b"] = 2
    m["c"] = 3
    let seen = 0
    let removed = ""
    for (k, _) in m {
        if seen == 0 {
            if k == "a" {
                removed = "b"
            } else if k == "b" {
                removed = "c"
            } else {
                removed = "a"
            }
            m.remove(removed)
        }
        seen += 1
    }
    print("{seen} {m.len()}")
}

@test(output = "2 2")
fn column_map_remove_pending_key_during_iteration() {
    let m: Map<string, MapWalkCell> = map_new()
    m["a"] = MapWalkCell { n: 1, tag: 10 }
    m["b"] = MapWalkCell { n: 2, tag: 20 }
    m["c"] = MapWalkCell { n: 3, tag: 30 }
    let seen = 0
    let removed = ""
    for (k, _) in m {
        if seen == 0 {
            if k == "a" {
                removed = "b"
            } else if k == "b" {
                removed = "c"
            } else {
                removed = "a"
            }
            m.remove(removed)
        }
        seen += 1
    }
    print("{seen} {m.len()}")
}

@test(output = "3 260")
fn scalar_map_updated_pending_values_are_visible() {
    let m: Map<string, int> = map_new()
    m["a"] = 10
    m["b"] = 20
    m["c"] = 30
    let seen = 0
    let sum = 0
    for (k, v) in m {
        if seen == 0 {
            if k != "a" { m["a"] = 110 }
            if k != "b" { m["b"] = 120 }
            if k != "c" { m["c"] = 130 }
        }
        seen += 1
        sum += v
    }
    print("{seen} {sum}")
}

@test(output = "3 260")
fn column_map_updated_pending_values_are_visible() {
    let m: Map<string, MapWalkCell> = map_new()
    m["a"] = MapWalkCell { n: 10, tag: 1 }
    m["b"] = MapWalkCell { n: 20, tag: 2 }
    m["c"] = MapWalkCell { n: 30, tag: 3 }
    let seen = 0
    let sum = 0
    for (k, v) in m {
        if seen == 0 {
            if k != "a" { m["a"] = MapWalkCell { n: 110, tag: 1 } }
            if k != "b" { m["b"] = MapWalkCell { n: 120, tag: 2 } }
            if k != "c" { m["c"] = MapWalkCell { n: 130, tag: 3 } }
        }
        seen += 1
        sum += v.n
    }
    print("{seen} {sum}")
}

@test(output = "9 3")
fn nested_map_iteration_and_break_restart() {
    let m: Map<string, int> = map_new()
    m["a"] = 1
    m["b"] = 2
    m["c"] = 3
    let pairs = 0
    for (_, _) in m {
        for (_, _) in m {
            pairs += 1
        }
    }
    for (_, _) in m { break }
    let seen = 0
    for (_, _) in m {
        seen += 1
    }
    print("{pairs} {seen}")
}
