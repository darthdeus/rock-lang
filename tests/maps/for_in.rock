// Test for-in loops with Map tuple destructuring
// This is a regression test for the bug where for-in loops on Maps
// generate wrong Lua code using ipairs instead of pairs and fail to destructure tuples

@test
fn test_map_for_in_basic() {
    let test_map: Map<string, string> = map_new()
    insert(test_map, "key1", "value1")
    insert(test_map, "key2", "value2")
    insert(test_map, "key3", "value3")

    let found_keys = 0
    let found_values = 0

    for (key, value) in test_map {
        found_keys = found_keys + 1
        found_values = found_values + 1

        // Make sure we get the right key-value pairs
        if key == "key1" {
            assert value == "value1"
        } else if key == "key2" {
            assert value == "value2"
        } else if key == "key3" {
            assert value == "value3"
        } else {
            error("Unexpected key: " + key)
        }
    }

    // Should iterate over all 3 entries
    assert found_keys == 3
    assert found_values == 3
}

@test
fn test_map_for_in_empty() {
    let empty_map: Map<string, int> = map_new()
    let iterations = 0

    for (key, value) in empty_map {
        iterations = iterations + 1
        error("Should not iterate over empty map")
    }

    assert iterations == 0
}

struct TestStruct {
    name: string,
    value: int,
}

@test
fn test_map_for_in_complex_values() {
    let struct_map: Map<string, TestStruct> = map_new()

    insert(struct_map, "struct1", TestStruct { name: "first", value: 10 })
    insert(struct_map, "struct2", TestStruct { name: "second", value: 20 })

    let total_value = 0
    let total_entries = 0

    for (key, item) in struct_map {
        total_entries = total_entries + 1
        total_value = total_value + item.value

        if key == "struct1" {
            assert item.name == "first"
            assert item.value == 10
        } else if key == "struct2" {
            assert item.name == "second"
            assert item.value == 20
        }
    }

    assert total_entries == 2
    assert total_value == 30
}