// Map equality and table unset behavior on the JS backend.

@test(output = "false false true")
fn map_direct_eq() {
    let a = map_new()
    a[1] = 10
    let diff_value = map_new()
    diff_value[1] = 20
    let diff_size = map_new()
    diff_size[1] = 10
    diff_size[2] = 20
    let reordered = map_new()
    reordered[2] = 20
    reordered[1] = 10
    print("{a == diff_value} {a == diff_size} {diff_size == reordered}")
}

@test(output = "true false")
fn map_string_keys() {
    let a = map_new()
    a["x"] = 1
    let b = map_new()
    b["x"] = 1
    let c = map_new()
    c["x"] = 2
    print("{a == b} {a == c}")
}

// A Map behind a reference-struct field takes the eq-walk path.

struct Holder {
    m: Map<int, int>,
    tag: int,
}

@test(output = "true false")
fn map_struct_field() {
    let a = Holder { m: map_new(), tag: 9 }
    a.m[1] = 10
    let b = Holder { m: map_new(), tag: 9 }
    b.m[1] = 10
    let c = Holder { m: map_new(), tag: 9 }
    c.m[1] = 99
    print("{a == b} {a == c}")
}

// A removed Map key reads back as nil and remove returns the old value;
// siblings survive, and removing an absent key returns null.
@test(returns = 1)
fn test_map_remove() -> int {
    let m = map_new()
    m[1] = 10
    m[2] = 20
    m[3] = 30
    let old = m.remove(2) ?? 0
    let absent = m.remove(99) ?? 0
    let gone = if m.get(2) == null { 1 } else { 0 }
    let a = m[1]
    let c = m[3]
    if old == 20 && absent == 0 && gone == 1 && a == 10 && c == 30 { 1 } else { 0 }
}

// Map.remove returns the old value.
// Vec.pop drains the last slot via table_unset; len shrinks.
@test(returns = 32)
fn test_vec_pop() -> int {
    let xs = [1, 2, 3]
    let last = xs.pop() ?? 0
    last * 10 + xs.len
}

// Vec.remove_at shifts survivors down and drains the tail slot.
@test(returns = 2132)
fn test_vec_remove_at() -> int {
    let xs = [10, 20, 30]
    let removed = xs.remove_at(1) ?? 0
    removed * 100 + xs[0] * 10 + xs[1] + xs.len
}

// Vec.swap_remove moves the tail into the hole then drains the tail.
@test(returns = 1)
fn test_vec_swap_remove() -> int {
    let xs = [10, 20, 30, 40]
    xs.swap_remove(0)
    xs.len - 2
}

// Vec.clear table_unsets every slot in a counted loop, then len = 0.
@test(returns = 0)
fn test_vec_clear() -> int {
    let xs = [1, 2, 3, 4, 5]
    xs.clear()
    xs.len
}

// clear then push reuses the array; the drained holes do not leak.
@test(returns = 68)
fn test_vec_clear_then_push() -> int {
    let xs = [1, 2, 3]
    xs.clear()
    xs.push(7)
    xs[0] * 10 + xs.len - 3
}
