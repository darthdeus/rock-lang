// `for` over a Map: `for (k, v) in m` lowers to a `pairs` walk (not `ipairs`).
// Covers pair destructuring with `_` on either side, single-binding loops,
// `continue`, string, int and struct keys and values, empty maps and an
// inferred map type. Map order is unspecified, so assertions are order-free.

@test(output = "6\n3\n3")
fn test_map_pair_iteration() {
    let m: Map<string, int> = map_new()
    m["a"] = 1
    m["b"] = 2
    insert(m, "c", 3)
    let total = 0
    let count = 0
    for (k, v) in m {
        if k == "a" {
            assert_eq(v, 1)
        } else if k == "b" {
            assert_eq(v, 2)
        } else if k == "c" {
            assert_eq(v, 3)
        } else {
            error("Unexpected key: " + k)
        }
        total = total + v
        count = count + 1
    }
    print("{total}")
    print("{count}")

    let item_count = 0
    for item in m {
        item_count = item_count + 1
    }
    print("{item_count}")
}

struct TestStruct {
    name: string,
    value: int,
}

@test
fn test_map_for_in_struct_values() {
    let struct_map: Map<string, TestStruct> = map_new()
    insert(struct_map, "struct1", TestStruct { name: "first", value: 10 })
    insert(struct_map, "struct2", TestStruct { name: "second", value: 20 })

    let total_value = 0
    let total_entries = 0
    for (key, item) in struct_map {
        total_entries = total_entries + 1
        total_value = total_value + item.value
        if key == "struct1" {
            assert item.name == "first"
            assert item.value == 10
        } else if key == "struct2" {
            assert item.name == "second"
            assert item.value == 20
        }
    }
    assert total_entries == 2
    assert total_value == 30
}

@test(output = "100\n2")
fn test_map_int_keys_and_continue() {
    let m: Map<int, int> = map_new()
    m[10] = 1
    m[40] = 1
    m[50] = 1
    let ksum = 0
    let seen = 0
    for (k, v) in m {
        ksum = ksum + k
        if k == 40 {
            continue
        }
        seen = seen + 1
    }
    print("{ksum}")
    print("{seen}")
}

@test(output = "3\nSum of values: 60")
fn test_map_iteration_with_wildcards() {
    let m: Map<string, int> = map_new()
    insert(m, "a", 10)
    insert(m, "b", 20)
    insert(m, "c", 30)

    let found = 0
    for (key, _) in m {
        if key == "a" || key == "b" || key == "c" {
            found = found + 1
        }
    }
    print(found)

    let sum = 0
    for (_, value) in m {
        sum = sum + value
    }
    print("Sum of values: {sum}")
}

@test(output = "0 0")
fn test_empty_map_iteration() {
    let empty_map: Map<string, int> = map_new()
    let pairs = 0
    for (key, value) in empty_map {
        pairs = pairs + 1
        error("Should not iterate over empty map")
    }
    let ints: Map<int, int> = map_new()
    let singles = 0
    for _ in ints {
        singles = singles + 1
    }
    print("{pairs} {singles}")
}

@test(output = "3")
fn test_map_iteration_type_inference() {
    let m = map_new()
    insert(m, "x", 1)
    insert(m, "y", 2)
    let total = 0
    for (k, v) in m {
        total = total + v
    }
    print(total)
}
