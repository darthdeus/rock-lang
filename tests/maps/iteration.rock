// Map iteration: pair and struct values, wildcards, restarts after break or
// insert, and removal or update during iteration.

@test(output = "6\n3\n3")
fn test_map_pair_iteration() {
    let m: Map<string, int> = map_new()
    m["a"] = 1
    m["b"] = 2
    insert(m, "c", 3)
    let total = 0
    let count = 0
    for (k, v) in m {
        if k == "a" {
            assert_eq(v, 1)
        } else if k == "b" {
            assert_eq(v, 2)
        } else if k == "c" {
            assert_eq(v, 3)
        } else {
            error("Unexpected key: " + k)
        }
        total = total + v
        count = count + 1
    }
    print("{total}")
    print("{count}")

    let item_count = 0
    for item in m {
        item_count = item_count + 1
    }
    print("{item_count}")
}

struct TestStruct {
    name: string,
    value: int,
}

@test
fn test_map_for_in_struct_values() {
    let struct_map: Map<string, TestStruct> = map_new()
    insert(struct_map, "struct1", TestStruct { name: "first", value: 10 })
    insert(struct_map, "struct2", TestStruct { name: "second", value: 20 })

    let total_value = 0
    let total_entries = 0
    for (key, item) in struct_map {
        total_entries = total_entries + 1
        total_value = total_value + item.value
        if key == "struct1" {
            assert item.name == "first"
            assert item.value == 10
        } else if key == "struct2" {
            assert item.name == "second"
            assert item.value == 20
        }
    }
    assert total_entries == 2
    assert total_value == 30
}

@test(output = "100\n2")
fn test_map_int_keys_and_continue() {
    let m: Map<int, int> = map_new()
    m[10] = 1
    m[40] = 1
    m[50] = 1
    let ksum = 0
    let seen = 0
    for (k, v) in m {
        ksum = ksum + k
        if k == 40 {
            continue
        }
        seen = seen + 1
    }
    print("{ksum}")
    print("{seen}")
}

@test(output = "3\nSum of values: 60")
fn test_map_iteration_with_wildcards() {
    let m: Map<string, int> = map_new()
    insert(m, "a", 10)
    insert(m, "b", 20)
    insert(m, "c", 30)

    let found = 0
    for (key, _) in m {
        if key == "a" || key == "b" || key == "c" {
            found = found + 1
        }
    }
    print(found)

    let sum = 0
    for (_, value) in m {
        sum = sum + value
    }
    print("Sum of values: {sum}")
}

@test(output = "0 0")
fn test_empty_map_iteration() {
    let empty_map: Map<string, int> = map_new()
    let pairs = 0
    for (key, value) in empty_map {
        pairs = pairs + 1
        error("Should not iterate over empty map")
    }
    let ints: Map<int, int> = map_new()
    let singles = 0
    for _ in ints {
        singles = singles + 1
    }
    print("{pairs} {singles}")
}

@test(output = "3")
fn test_map_iteration_type_inference() {
    let m = map_new()
    insert(m, "x", 1)
    insert(m, "y", 2)
    let total = 0
    for (k, v) in m {
        total = total + v
    }
    print(total)
}

fn filled(n: int) -> Map<string, int> {
    let m: Map<string, int> = map_new()
    for i in 0..n { m["k{i}"] = i + 1 }
    return m
}

@test
fn nested_walks_over_the_same_map_are_independent() {
    let m = filled(3)
    let pairs = 0
    let sum = 0
    for (_, a) in m {
        for (_, b) in m {
            pairs += 1
            sum += a * b
        }
    }
    assert_eq(pairs, 9)
    assert_eq(sum, 36)
}

@test
fn a_walk_after_break_restarts_from_the_beginning() {
    let m = filled(4)
    for _ in m { break }
    let seen = 0
    for (_, v) in m { seen += v }
    assert_eq(seen, 10)
}

@test
fn a_walk_after_an_insert_sees_the_new_key() {
    let m = filled(1)
    let before = 0
    for _ in m { before += 1 }
    m["late"] = 5
    let after = 0
    for _ in m { after += 1 }
    assert_eq(before, 1)
    assert_eq(after, 2)
}

newtype Label(string)

// Snapshots order their keys independently of insertion order, identically
// on every backend.
@test(output = "10 10 10 10 10")
fn snapshots_sort_string_and_numeric_keys() {
    let strings: Map<string, int> = map_new()
    strings["2"] = 2
    strings["10"] = 10
    let keys = strings.keys()
    let values = strings.values()
    let pairs = strings.to_array()
    let labels: Map<Label, int> = map_new()
    labels[Label("2")] = 2
    labels[Label("10")] = 10
    let label_keys = labels.keys()
    let numbers: Map<int, int> = map_new()
    numbers[2] = 2
    numbers[10] = 10
    let number_keys = numbers.keys()
    print("{keys[0]} {values[0]} {pairs[0].0} {label_keys[0].0} {number_keys[0]}")
}

value MapWalkCell {
    n: int,
    tag: int,
}

@test(output = "3 60 true")
fn scalar_map_remove_current_during_iteration() {
    let m: Map<string, int> = map_new()
    m["a"] = 10
    m["b"] = 20
    m["c"] = 30
    let seen = 0
    let sum = 0
    for (k, v) in m {
        m.remove(k)
        seen += 1
        sum += v
    }
    print("{seen} {sum} {m.is_empty()}")
}

@test(output = "3 6 true")
fn column_map_remove_current_during_iteration() {
    let m: Map<string, MapWalkCell> = map_new()
    m["a"] = MapWalkCell { n: 1, tag: 10 }
    m["b"] = MapWalkCell { n: 2, tag: 20 }
    m["c"] = MapWalkCell { n: 3, tag: 30 }
    let seen = 0
    let sum = 0
    for (k, v) in m {
        m.remove(k)
        seen += 1
        sum += v.n
    }
    print("{seen} {sum} {m.is_empty()}")
}

@test(output = "2 2")
fn scalar_map_remove_pending_key_during_iteration() {
    let m: Map<string, int> = map_new()
    m["a"] = 1
    m["b"] = 2
    m["c"] = 3
    let seen = 0
    let removed = ""
    for (k, _) in m {
        if seen == 0 {
            if k == "a" {
                removed = "b"
            } else if k == "b" {
                removed = "c"
            } else {
                removed = "a"
            }
            m.remove(removed)
        }
        seen += 1
    }
    print("{seen} {m.len()}")
}

@test(output = "2 2")
fn column_map_remove_pending_key_during_iteration() {
    let m: Map<string, MapWalkCell> = map_new()
    m["a"] = MapWalkCell { n: 1, tag: 10 }
    m["b"] = MapWalkCell { n: 2, tag: 20 }
    m["c"] = MapWalkCell { n: 3, tag: 30 }
    let seen = 0
    let removed = ""
    for (k, _) in m {
        if seen == 0 {
            if k == "a" {
                removed = "b"
            } else if k == "b" {
                removed = "c"
            } else {
                removed = "a"
            }
            m.remove(removed)
        }
        seen += 1
    }
    print("{seen} {m.len()}")
}

@test(output = "3 260")
fn scalar_map_updated_pending_values_are_visible() {
    let m: Map<string, int> = map_new()
    m["a"] = 10
    m["b"] = 20
    m["c"] = 30
    let seen = 0
    let sum = 0
    for (k, v) in m {
        if seen == 0 {
            if k != "a" { m["a"] = 110 }
            if k != "b" { m["b"] = 120 }
            if k != "c" { m["c"] = 130 }
        }
        seen += 1
        sum += v
    }
    print("{seen} {sum}")
}

@test(output = "3 260")
fn column_map_updated_pending_values_are_visible() {
    let m: Map<string, MapWalkCell> = map_new()
    m["a"] = MapWalkCell { n: 10, tag: 1 }
    m["b"] = MapWalkCell { n: 20, tag: 2 }
    m["c"] = MapWalkCell { n: 30, tag: 3 }
    let seen = 0
    let sum = 0
    for (k, v) in m {
        if seen == 0 {
            if k != "a" { m["a"] = MapWalkCell { n: 110, tag: 1 } }
            if k != "b" { m["b"] = MapWalkCell { n: 120, tag: 2 } }
            if k != "c" { m["c"] = MapWalkCell { n: 130, tag: 3 } }
        }
        seen += 1
        sum += v.n
    }
    print("{seen} {sum}")
}
