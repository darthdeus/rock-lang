// `table_unset(t, k)` is the stdlib primitive `t[k] = nil` backing Map.remove
// and the Vec drain ops (pop / remove_at / swap_remove / clear). On JS it
// dispatches on `instanceof Map` -- `map.delete(k)` vs `delete arr[k]` -- so a
// removed Map key reads back as nil and a popped Vec slot becomes a hole the
// tracked `.len` skips.

// A removed Map key reads back as nil and remove returns the old value;
// siblings survive, and removing an absent key returns null.
@test(returns = 1)
fn test_map_remove() -> int {
    let m = map_new()
    m[1] = 10
    m[2] = 20
    m[3] = 30
    let old = m.remove(2) ?? 0
    let absent = m.remove(99) ?? 0
    let gone = if m.get(2) == null { 1 } else { 0 }
    let a = m[1]
    let c = m[3]
    if old == 20 && absent == 0 && gone == 1 && a == 10 && c == 30 { 1 } else { 0 }
}

// Map.remove returns the old value.
// Vec.pop drains the last slot via table_unset; len shrinks.
@test(returns = 32)
fn test_vec_pop() -> int {
    let xs = [1, 2, 3]
    let last = xs.pop() ?? 0
    last * 10 + xs.len
}

// Vec.remove_at shifts survivors down and drains the tail slot.
@test(returns = 2132)
fn test_vec_remove_at() -> int {
    let xs = [10, 20, 30]
    let removed = xs.remove_at(1) ?? 0
    removed * 100 + xs[0] * 10 + xs[1] + xs.len
}

// Vec.swap_remove moves the tail into the hole then drains the tail.
@test(returns = 1)
fn test_vec_swap_remove() -> int {
    let xs = [10, 20, 30, 40]
    xs.swap_remove(0)
    xs.len - 2
}

// Vec.clear table_unsets every slot in a counted loop, then len = 0.
@test(returns = 0)
fn test_vec_clear() -> int {
    let xs = [1, 2, 3, 4, 5]
    xs.clear()
    xs.len
}

// clear then push reuses the array; the drained holes do not leak.
@test(returns = 68)
fn test_vec_clear_then_push() -> int {
    let xs = [1, 2, 3]
    xs.clear()
    xs.push(7)
    xs[0] * 10 + xs.len - 3
}
