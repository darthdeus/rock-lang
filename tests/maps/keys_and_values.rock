// Map keys, values and equality. A key is data, never a name in the host
// object model: a JS object literal inherits Object.prototype, so names like
// "constructor" and "__proto__" must still read back as absent until stored.
// A null value is no entry, and map equality compares entries regardless of
// insertion order.

value Slot { a: int, b: int }

global PROTO_KEYS: [string] = [
    "constructor", "toString", "hasOwnProperty", "valueOf", "__proto__",
    "isPrototypeOf", "propertyIsEnumerable", "toLocaleString",
]

@test
fn column_map_reports_no_inherited_keys() {
    let m: Map<string, Slot> = map_new()
    // Control: the probe answers correctly for a key that really is absent.
    assert(!m.contains("ordinary"), "a fresh column map does not contain an ordinary key")
    for k in PROTO_KEYS {
        assert(!m.contains(k), "a fresh column map must not report `{k}` as present")
    }
    assert(m.len() == 0, "a fresh column map is empty")
}

@test
fn column_map_stores_prototype_named_keys() {
    let m: Map<string, Slot> = map_new()
    for (i, k) in enumerate(PROTO_KEYS) {
        m[k] = Slot { a: i, b: i * 10 }
    }
    assert(m.len() == PROTO_KEYS.len(),
        "every prototype-named key occupies its own slot (got {m.len()})")
    for (i, k) in enumerate(PROTO_KEYS) {
        assert(m.contains(k), "`{k}` is present after storing")
        assert(m[k].a == i, "`{k}` reads back its own value")
        assert(m[k].b == i * 10, "`{k}` reads back its own second field")
    }
}

@test
fn column_map_removes_prototype_named_keys() {
    let m: Map<string, Slot> = map_new()
    m["constructor"] = Slot { a: 1, b: 2 }
    m["__proto__"] = Slot { a: 3, b: 4 }
    m["ordinary"] = Slot { a: 5, b: 6 }
    assert(m.len() == 3, "three distinct keys")
    m.remove("constructor")
    assert(!m.contains("constructor"), "a removed prototype-named key is gone")
    assert(m.contains("__proto__"), "removing one does not disturb another")
    assert(m.contains("ordinary"), "removing one does not disturb an ordinary key")
    assert(m.len() == 2, "the live count follows")
}

// The plain (non-column) path: an int value keeps the bare-table
// representation, so it exercises the other spelling of the same question.
@test
fn plain_map_reports_no_inherited_keys() {
    let m: Map<string, int> = map_new()
    assert(m.get("ordinary") == null, "control: an ordinary missing key reads null")
    for k in PROTO_KEYS {
        assert(m.get(k) == null, "a fresh plain map must not report `{k}` as present")
    }
}

@test
fn plain_map_stores_prototype_named_keys() {
    let m: Map<string, int> = map_new()
    for (i, k) in enumerate(PROTO_KEYS) {
        m[k] = i + 1
    }
    for (i, k) in enumerate(PROTO_KEYS) {
        let got = m.get(k)
        assert(got != null, "`{k}` reads back from a plain map")
        assert(got.unwrap() == i + 1, "`{k}` reads back its own value from a plain map")
    }
}

@test
fn inserting_null_adds_no_entry() {
    let m: Map<string, int?> = map_new()
    m.insert("a", null)
    assert_eq(m.len(), 0)
    assert(m.is_empty())
    assert(!m.contains("a"))
    assert_eq(m.keys().len(), 0)
}

@test
fn overwriting_with_null_removes_the_entry() {
    let m: Map<string, int?> = map_new()
    m.insert("a", 1)
    m.insert("b", 2)
    m["a"] = null
    assert_eq(m.len(), 1)
    assert(!m.contains("a"))
    for (k, _) in m {
        assert_eq(k, "b")
    }
}

struct MapStorageHandleRow { n: int }

global MAP_STORAGE_HANDLES: Map<int, Entity<MapStorageHandleRow>> = map_new()

global MAP_STORAGE_CLONES: [int] = []

@test
fn map_storage_accepts_column_stored_entity_handles() {
    let owner: Arena<MapStorageHandleRow> = arena_new()
    let handle = owner.insert(MapStorageHandleRow { n: 7 })
    MAP_STORAGE_HANDLES.insert(1, handle)
    let values = [17, 23].clone_into(map_storage(MAP_STORAGE_HANDLES))
    assert_eq(values[0], 17)
    assert_eq(values[1], 23)
    MAP_STORAGE_HANDLES.remove(1)
    assert(arena_destroy(owner))
}

value Q { x: float, y: float }

@lua_named struct Boxy { s: string }

@nomangle inline(lua) fn Map<K, V>.probe(map) -> int = """
    local n = 0
    for k, v in pairs(map) do n = n + 1 end
    return n
"""

@test(output = "1", backends = "lua")
fn an_implicit_method_receiver_at_a_boxed_value_is_correct() {
    let m: Map<string, Boxy> = map_new()
    m["a"] = Boxy { s: "z" }
    print("{m.probe()}")
}

@nomangle inline(lua) fn map_probe<V>(m: Map<string, V>) -> int = """
    local n = 0
    for k, v in pairs(m) do n = n + 1 end
    return n
"""

@test(output = "1", backends = "lua")
fn a_boxed_value_through_the_same_body_is_correct() {
    let m: Map<string, Boxy> = map_new()
    m["a"] = Boxy { s: "z" }
    print("{map_probe(m)}")
}

@nomangle inline(lua) fn map_shape(m: any) -> string = """
    if m.spine ~= nil then return "spine" end
    return "bare"
"""

@test(output = "spine", backends = "lua")
fn an_any_param_still_admits_a_column_map() {
    let m: Map<string, Q> = map_new()
    m["a"] = Q { x: 1.0, y: 2.0 }
    print("{map_shape(m)}")
}

@test(output = "1truetrue3")
fn a_column_map_still_works_through_the_stdlib_surface() {
    let m: Map<string, Q> = map_new()
    m["a"] = Q { x: 1.0, y: 2.0 }
    m["b"] = Q { x: 3.0, y: 4.0 }
    m.remove("a")
    print("{m.len()}{m.contains(\"b\")}{m.get(\"a\") == null}{m[\"b\"].x}")
}

@test(output = "false false true")
fn map_direct_eq() {
    let a = map_new()
    a[1] = 10
    let diff_value = map_new()
    diff_value[1] = 20
    let diff_size = map_new()
    diff_size[1] = 10
    diff_size[2] = 20
    let reordered = map_new()
    reordered[2] = 20
    reordered[1] = 10
    print("{a == diff_value} {a == diff_size} {diff_size == reordered}")
}

@test(output = "true false")
fn map_string_keys() {
    let a = map_new()
    a["x"] = 1
    let b = map_new()
    b["x"] = 1
    let c = map_new()
    c["x"] = 2
    print("{a == b} {a == c}")
}

// A Map behind a reference-struct field takes the eq-walk path.

struct Holder {
    m: Map<int, int>,
    tag: int,
}

@test(output = "true false")
fn map_struct_field() {
    let a = Holder { m: map_new(), tag: 9 }
    a.m[1] = 10
    let b = Holder { m: map_new(), tag: 9 }
    b.m[1] = 10
    let c = Holder { m: map_new(), tag: 9 }
    c.m[1] = 99
    print("{a == b} {a == c}")
}

// A removed Map key reads back as nil and remove returns the old value;
// siblings survive, and removing an absent key returns null.
@test(returns = 1)
fn test_map_remove() -> int {
    let m = map_new()
    m[1] = 10
    m[2] = 20
    m[3] = 30
    let old = m.remove(2) ?? 0
    let absent = m.remove(99) ?? 0
    let gone = if m.get(2) == null { 1 } else { 0 }
    let a = m[1]
    let c = m[3]
    if old == 20 && absent == 0 && gone == 1 && a == 10 && c == 30 { 1 } else { 0 }
}


@test
fn map_key_sort_preserves_equal_renderings() {
    let keys: [int] = []
    for i in 0..20 {
        keys.push((2 - i % 2) * 1000000000000000 + i)
    }
    __sort_map_keys(keys)
    for i in 0..10 {
        assert_eq(keys[i], 1000000000000001 + 2 * i)
        assert_eq(keys[i + 10], 2000000000000000 + 2 * i)
    }
}

@test
fn map_write_helpers_distinguish_missing_and_existing_keys() {
    let m: Map<string, int> = map_new()
    assert_eq(m.get_or_insert("kept", 3), 3)
    assert_eq(m.get_or_insert("kept", 9), 3)
    assert_eq(m.update("kept", 5), 3)
    assert_eq(m["kept"], 5)
    assert(m.update("absent", 2) == null)
    assert(!m.contains("absent"))
    assert(m.upsert("absent", 2) == null)
    assert_eq(m.upsert("absent", 9), 2)
    assert_eq(m["absent"], 9)
    assert_eq(m.len(), 2)
}

newtype SnapshotLabel(string)

@test
fn map_snapshots_order_keys_and_keep_their_values() {
    let words: Map<string, int> = map_new()
    let labels: Map<SnapshotLabel, int> = map_new()
    let numbers: Map<int, int> = map_new()
    for (word, number) in [("2", 2), ("10", 10)] {
        words[word] = number
        labels[SnapshotLabel(word)] = number
        numbers[number] = number
    }
    assert_eq(words.keys(), ["10", "2"])
    assert_eq(words.values(), [10, 2])
    assert_eq(words.to_array(), [("10", 10), ("2", 2)])
    assert_eq(labels.keys()[0].0, "10")
    assert_eq(numbers.keys()[0], 10)
}

value WalkCell { n: int, tag: int }

fn walking_map<T>(make: (int) -> T) -> Map<string, T> {
    let m: Map<string, T> = map_new()
    m["a"] = make(10)
    m["b"] = make(20)
    m["c"] = make(30)
    return m
}

fn check_map_walk<T>(make: (int) -> T, read: (T) -> int) {
    let m = walking_map(make)
    for _ in m { break }
    let pairs = 0
    for _ in m { for _ in m { pairs += 1 } }
    assert_eq(pairs, 9)

    let total = 0
    for (key, value) in m {
        m.remove(key)
        total += read(value)
    }
    assert_eq(total, 60)
    assert(m.is_empty())

    let pending = walking_map(make)
    let seen = 0
    for (key, _) in pending {
        if seen == 0 { pending.remove(if key == "a" { "b" } else { "a" }) }
        seen += 1
    }
    assert_eq((seen, pending.len()), (2, 2))

    let updated = walking_map(make)
    let sum = 0
    let count = 0
    for (key, value) in updated {
        if count == 0 {
            for (pending_key, n) in [("a", 110), ("b", 120), ("c", 130)] {
                if pending_key != key { updated[pending_key] = make(n) }
            }
        }
        sum += read(value)
        count += 1
    }
    assert_eq((count, sum), (3, 260))
}

@test
fn map_walks_observe_live_removals_and_updates() {
    check_map_walk((n: int) => n, (n: int) => n)
    check_map_walk((n: int) => WalkCell { n, tag: 0 }, (cell: WalkCell) => cell.n)
}
