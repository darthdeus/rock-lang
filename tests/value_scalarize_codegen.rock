// Exercises value-type scalarized ABI at runtime.
// Fn params expand to scalar Lua params; field access and Ident uses
// rewrite accordingly. Nested calls, returns, and literal args all
// need to agree on the scalar form.

value V2 {
    x: float,
    y: float,
}

// Simple: takes value, reads fields.
fn sum_xy(v: V2) -> float {
    return v.x + v.y
}

// Nested: inner returns V2 (Rock), outer takes V2 as last arg.
// Last-arg multi-return is preserved by Lua, so this works without
// pre-statement hoisting.
fn make(x: float, y: float) -> V2 {
    return V2 { x: x, y: y }
}

@test(output = "3\n10")
fn test_scalarized_abi() {
    // Literal in call-arg position.
    let a = sum_xy(V2 { x: 1, y: 2 })
    print("{a.floor()}")
    // Ident + nested Rock-to-Rock call (make returns V2, sum_xy takes
    // V2 — inner is the ONLY arg, so multi-return is last-arg safe).
    let v = make(3, 7)
    print("{sum_xy(v).floor()}")
}
