// Adversarial: a value-struct field with a declared StructLiteral
// default. Issue 4 pass-2 has its own default-recursion branch that
// must produce the same leaves as if the user had written the literal
// inline.

@intrinsic @inline inline(lua) fn put(s: string) = "io.write(s)"

value V2 {
    x: float,
    y: float,
}

value Holder {
    a: V2 = V2 { x: 11.0, y: 22.0 },
    b: float,
}

@nomangle inline(lua) fn __nb_alloc_Holder(n: int) -> Ptr<Holder> = 'return ffi.new("Holder[?]", n)'

fn nb_holder(n: int) -> NativeBuffer<Holder> {
    return NativeBuffer { ptr: __nb_alloc_Holder(n), len: n }
}

@test(output = "a.x=11\na.y=22\nb=99")
fn test_default_struct_literal() {
    let buf = nb_holder(1)
    // Field `a` omitted → uses declared default `V2 { x: 11, y: 22 }`.
    buf[0] = Holder { b: 99.0 }
    let h = buf[0]
    put("a.x=")
    put("{h.a.x}")
    put("\n")
    put("a.y=")
    put("{h.a.y}")
    put("\n")
    put("b=")
    put("{h.b}")
}
