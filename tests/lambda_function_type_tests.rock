// Lambda function type tests - migrated from rock/tests/lambda_function_type_test.rs
// Tests lambdas with function type parameters and complex lambda patterns

// Helper functions for testing
fn is_even(n: int) -> bool {
    return n % 2 == 0
}

fn double(x: int) -> int {
    return x * 2
}

fn add_one(x: int) -> int {
    return x + 1
}

fn square(x: int) -> int {
    return x * x
}

@test(output = "42 is even")
fn test_lambda_with_function_type_param() {
    // Lambda with function type parameter
    let handler = (callback: fn(int) -> bool) => {
        return callback(42)
    }

    // Use the handler
    let result = handler(is_even)
    print(if result { "42 is even" } else { "42 is odd" })
}

@test(output = "12")
fn test_lambda_with_multiple_function_type_params() {
    // Lambda with multiple function type parameters
    let combiner = (f: fn(int) -> int, g: fn(int) -> int, x: int) => {
        return f(g(x))
    }

    // (5 + 1) * 2 = 12
    print(combiner(double, add_one, 5))
}

@test(output = "15\n30")
fn test_lambda_returning_function() {
    // Lambda that returns a function
    let make_adder = (n: int) => {
        return (x: int) => x + n
    }

    let cases = [(5, 10), (10, 20)]
    for pair in cases {
        let add = make_adder(pair.0)
        print(add(pair.1))
    }
}

@test(output = "18")
fn test_nested_lambda_with_function_types() {
    // Nested lambdas with function types
    let outer = (transform: fn(int) -> int) => {
        return (value: int) => {
            return transform(value) * 2
        }
    }

    let inner = outer(square)
    print(inner(3))  // (3 * 3) * 2 = 18
}
