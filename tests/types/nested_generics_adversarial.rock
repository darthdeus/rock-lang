// Adversarial nested-generics tests. Each should either compile+run or
// fail with a clear type error — not produce bad Lua or panic the compiler.

// --- 1. Self-referential generic (tree) ---

struct Tree<T> {
    value: T,
    children: [Tree<T>],
}

@test(output = "root")
fn test_self_referential_tree() {
    let leaf: Tree<string> = Tree { value: "leaf", children: vec_new() }
    let root: Tree<string> = Tree { value: "root", children: vec_new() }
    root.children.push(leaf)
    print(root.value)
}

// --- 2. Mutual reference between two generic structs ---

struct NodeA<T> {
    val: T,
    bs: [NodeB<T>],
}

struct NodeB<T> {
    val: T,
    as_: [NodeA<T>],
}

@test(output = "a")
fn test_mutual_generic() {
    let a: NodeA<string> = NodeA { val: "a", bs: vec_new() }
    print(a.val)
}

// --- 3. Deeply nullable: Vec<Vec<T>?>? ---

struct Matrix<T> {
    data: [[T]?]?,
}

@test(output = "ok")
fn test_deep_nullable_generic() {
    let m: Matrix<int> = Matrix { data: null }
    print("ok")
}

// --- 4. Tuple element is nested generic ---

struct TupleHolder<K, V> {
    pair: (K, [V]),
}

@test(output = "42")
fn test_tuple_nested_generic() {
    let t: TupleHolder<int, string> = TupleHolder { pair: (42, vec_new()) }
    print(t.pair.0)
}

// --- 5. Generic function argument forces inference through nesting ---

struct Wrapped<T> {
    inner: [T],
}

fn unwrap_one<T>(w: Wrapped<T>) -> T? {
    if w.inner.len() == 0 { return null }
    return w.inner[0]
}

@test(output = "hi")
fn test_generic_fn_infers_through_nested() {
    let w: Wrapped<string> = Wrapped { inner: vec_new() }
    w.inner.push("hi")
    let v = unwrap_one(w)
    if v != null { print(v) } else { print("null") }
}

// --- 6. Generic function returns another generic that uses its params ---

struct Pair<K, V> {
    k: K,
    v: V,
}

fn make_pairs<K, V>() -> [Pair<K, V>] {
    return vec_new()
}

@test(output = "0")
fn test_generic_fn_returns_vec_of_nested() {
    let ps: [Pair<int, string>] = make_pairs()
    print(ps.len())
}

// --- 7. Generic function whose return type embeds a param inside a Vec inside a struct ---

fn build_tree<T>(v: T) -> Tree<T> {
    return Tree { value: v, children: vec_new() }
}

@test(output = "hello")
fn test_generic_fn_builds_self_referential() {
    let t: Tree<string> = build_tree("hello")
    print(t.value)
}

// --- 8. Method-style via UFCS on nested-generic field ---

fn add_child<T>(parent: Tree<T>, child: Tree<T>) {
    parent.children.push(child)
}

@test(output = "2")
fn test_ufcs_on_nested_generic() {
    let root: Tree<int> = build_tree(0)
    root.add_child(build_tree(1))
    root.add_child(build_tree(2))
    print(root.children.len())
}

// --- 9. Nullable generic parameter passed into a nested position ---

struct Maybe<T> {
    values: [T?],
}

@test(output = "2")
fn test_nullable_param_in_nested() {
    let m: Maybe<int> = Maybe { values: vec_new() }
    m.values.push(1)
    m.values.push(null)
    print(m.values.len())
}

// --- 10. Enum variant holding nested generic ---

enum Result2<T, E> {
    Ok(T),
    Err(E),
    Multi([T]),
}

@test(output = "multi:2")
fn test_enum_with_nested_generic_variant() {
    let v: [int] = vec_new()
    v.push(10)
    v.push(20)
    let r: Result2<int, string> = Result2::Multi(v)
    match r {
        Result2::Ok(_) => print("ok"),
        Result2::Err(_) => print("err"),
        Result2::Multi(xs) => print("multi:{xs.len()}"),
    }
}

// --- 11. Same generic param used in two nested positions ---

struct TwoSlots<T> {
    a: [T],
    b: [[T]],
}

@test(output = "1 1")
fn test_same_param_two_nested_positions() {
    let s: TwoSlots<int> = TwoSlots { a: vec_new(), b: vec_new() }
    s.a.push(7)
    let inner: [int] = vec_new()
    inner.push(8)
    s.b.push(inner)
    print("{s.a.len()} {s.b.len()}")
}
