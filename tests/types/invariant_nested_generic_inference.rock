// An invariant container wrapping an under-determined nested generic must drive
// inference INTO the nested type: Holder<Duo<?, ?>> has to unify with the expected
// Holder<Duo<int, string>> and solve the inner K=int, V=string. The invariant
// variance arm only special-cases a BARE type variable; a nested App that
// *contains* unsolved vars (Duo<?, ?>) falls to the "concrete types must be exactly
// equal" branch and errors instead of recursing. Not array-specific (arrays here
// stay covariant) -- struct generics and Map keys are invariant too.
//
// `mk` returns Holder<Duo<K, V>> with K, V undetermined by its (zero) args, so the
// only way to solve them is to push the expected binding type back through the
// invariant Holder into Duo. The empty-array field lets `mk` build the value
// without needing K/V values.

struct Duo<K, V> { k: K, v: V }
struct Holder<T> { items: [T] }

fn mk<K, V>() -> Holder<Duo<K, V>> {
    return Holder { items: vec_new() }
}

@test(output = "ok")
fn test_invariant_nested_generic_infers() {
    let _h: Holder<Duo<int, string>> = mk()
    print("ok")
}
