// Test numeric promotion in generic functions using stdlib min/max

@test
fn test_min_with_int_float() {
    // This should promote both arguments to float
    let result = min(3, 4.0);
    assert_eq(result, 3.0);
}

@test
fn test_max_with_int_float() {
    // This should promote both arguments to float
    let result = max(5.5, 2);
    assert_eq(result, 5.5);
}

@test
fn test_both_ints() {
    // This should stay as int
    let result = min(3, 4);
    assert_eq(result, 3);
}

@test
fn test_both_floats() {
    // This should stay as float
    let result = max(3.5, 4.5);
    assert_eq(result, 4.5);
}