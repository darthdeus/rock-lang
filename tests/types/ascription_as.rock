// `as` conversions and `::` ascriptions that are ordinary identity/compatible
// pairs. The checked semantics of each form live in tests/types/checked_ascription.rock
// and tests/errors/checked_{ascription,cast}.rock.err.

@test(output = "42\n3.14\nhello")
fn test_as_type_ascription() {
    // Test with various types
    let x = 42 as int
    let y = 3.14 as float
    let z = "hello" as string
    
    print(x)
    print(y)
    print(z)
}

@test(output = "100")
fn test_as_in_expression() {
    // Test as operator in complex expression
    let result = (50 + 50) as int
    print(result)
}

@test(output = "true")
fn test_as_with_nullable() {
    // Test with nullable types
    let maybe: int? = 42
    let definitely = maybe as int?
    print(definitely == 42)
}

@test(output = "42")
fn test_mixed_ascription() {
    // Both forms admit an identity pair
    let a = 42 :: int
    let b = a as int
    print(b)
}

@test(output = "1\n2\n3")
fn test_as_with_collections() {
    // Test with vector types
    let nums = [1, 2, 3] as [int]
    for n in nums {
        print(n)
    }
}