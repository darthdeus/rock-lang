// Names that collide or look reserved: runtime marker field neighbours, a
// user `Result` struct shadowing the stdlib one, and a struct sharing its name
// with an enum tuple variant.

// Neighbours of the three runtime marker field names remain legal.
struct RefFields { __inner: int, __pred: int, _fn: int }

value ValueFields { __inner: int, __pred: int, _ty: int }

enum RecordFields { Item { __inner: int, __pred: int, _variant: int } }

@test
fn reserved_field_name_neighbours() {
    let r = RefFields { __inner: 1, __pred: 2, _fn: 3 }
    assert(r.__inner == 1 && r.__pred == 2 && r._fn == 3, "struct fields")
    let v = ValueFields { __inner: 4, __pred: 5, _ty: 6 }
    assert(v.__inner == 4 && v.__pred == 5 && v._ty == 6, "value fields")
    let e = RecordFields::Item { __inner: 7, __pred: 8, _variant: 9 }
    match e {
        RecordFields::Item { __inner, __pred, _variant } => {
            assert(__inner == 7 && __pred == 8 && _variant == 9, "enum fields")
        },
    }
}

struct Result<T, E> {
    ok: T?
    err: E?
}

@test(output = "Ok: 456")
fn test_different_result() {
    let r: Result<int, string> = Result{ ok: 456, err: null };
    if r.ok != null {
        print("Ok: {r.ok}");
    }
}

struct Rect {
    x: float
}

enum Shape {
    Rect(string)
}

@test(output = "5 test")
fn test_struct_and_same_named_tuple_variant() {
    let rect_struct = Rect { x: 5.0 }
    let rect_variant = Shape::Rect("test")
    match rect_variant {
        Shape::Rect(label) => print("{rect_struct.x.floor()} {label}"),
    }
}
