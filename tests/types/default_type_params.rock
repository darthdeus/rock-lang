// Default type params: trailing generics on struct/enum/newtype may carry
// `= T` defaults, filled from the right at use sites. v1 defaults are a
// builtin type or a bare named type; fn generics reject defaults.

struct Marker {
    tag: int,
}

struct Pair<T, U = int> {
    a: T,
    b: U,
}

struct Holder<T = Marker> {
    v: T,
}

enum Opt<T = string> {
    Val(T),
    Nothing,
}

newtype Boxed<T = bool>(T)

fn second(p: Pair<string>) -> int {
    p.b
}

@test(output = "42")
fn test_struct_default_fills_trailing() {
    let p: Pair<string> = Pair { a: "x", b: 42 }
    print(p.b)
}

@test(output = "41")
fn test_fn_param_position_pads() {
    let p: Pair<string> = Pair { a: "y", b: 41 }
    print(second(p))
}

@test(output = "1.5")
fn test_explicit_args_still_work() {
    let p: Pair<string, float> = Pair { a: "x", b: 1.5 }
    print(p.b)
}

@test(output = "7")
fn test_bare_name_when_all_defaulted() {
    let h: Holder = Holder { v: Marker { tag: 7 } }
    print(h.v.tag)
}

@test(output = "9")
fn test_named_default_explicit_still_works() {
    let h: Holder<Marker> = Holder { v: Marker { tag: 9 } }
    print(h.v.tag)
}

@test(output = "hi")
fn test_enum_default() {
    let o: Opt = Opt::Val("hi")
    match o {
        Opt::Val(s) => print(s),
        Opt::Nothing => print("none"),
    }
}

@test(output = "true")
fn test_newtype_default() {
    let b: Boxed = Boxed(true)
    print(b.0)
}

@test(output = "fallback")
fn test_nullable_of_defaulted_app() {
    let p: Pair<string>? = null
    print(p?.a ?? "fallback")
}

// The default-shape restriction does not restrict explicit type arguments.
fn identity_without_default<T>(value: T) -> T { value }

@test(output = "3")
fn test_explicit_array_argument_and_inferred_fn_generic() {
    let p: Pair<string, [int]> = Pair { a: "x", b: [1, 2, 3] }
    let values = identity_without_default(p.b)
    print(values.len)
}

// Numeric defaults keep their numeric semantics.
struct UnsignedHolder<T = uint> { value: T }
enum UnsignedChoice<T = uint> { Value(T), Empty }
newtype UnsignedWrapped<T = uint>(T)

fn read_unsigned(h: UnsignedHolder, c: UnsignedChoice, w: UnsignedWrapped) -> uint {
    let choice = match c {
        UnsignedChoice::Value(v) => v,
        UnsignedChoice::Empty => (0 as uint),
    }
    return h.value + choice + w.0
}

@test
fn uint_defaults_preserve_unsigned_values() {
    let h: UnsignedHolder = UnsignedHolder { value: (2147483648 as uint) }
    let c: UnsignedChoice = UnsignedChoice::Value((1 as uint))
    let w: UnsignedWrapped = UnsignedWrapped((2 as uint))
    assert_eq(read_unsigned(h, c, w), (2147483651 as uint))
}

struct FloatHolder<T = f64> { value: T }
enum FloatChoice<T = f64> { Value(T), Empty }
newtype FloatWrapped<T = f64>(T)

fn read_float_defaults(h: FloatHolder, c: FloatChoice, w: FloatWrapped) -> float {
    let choice = match c {
        FloatChoice::Value(v) => v,
        FloatChoice::Empty => 0.0,
    }
    return h.value + choice + w.0
}

@test
fn f64_defaults_use_float_semantics() {
    let h: FloatHolder = FloatHolder { value: 1.5 }
    let c: FloatChoice = FloatChoice::Value(2.25)
    let w: FloatWrapped = FloatWrapped(0.125)
    assert_eq(read_float_defaults(h, c, w), 3.875)
}

enum Inner<Source> { Empty, From { source: Source, label: string } }

enum Outer { Empty, Wrapped(Inner<string>) }

global DEST: [Outer] = []

@test
fn nested_generic_enum_clone_uses_concrete_source() {
    let source = Outer::Wrapped(Inner::From { source: "origin", label: "label" })
    DEST.push(source.clone_into(DEST.storage))
    assert(DEST.len() == 1, "cloned event stored")
    let copied = match DEST[0] {
        Outer::Wrapped(inner) => match inner {
            Inner::From { source, label } => source == "origin" && label == "label",
            _ => false,
        },
        _ => false,
    }
    assert(copied, "cloned nested record retains both strings")
}

value SpecPoint { x: float, y: float }

@inline
fn generic_second<P, S>(p: P, s: S) -> S {
    return s
}

@inline
fn hold<P, S>(p: P, s: S) -> [S] {
    let out: [S] = []
    out.push(s)
    return out
}

@test
fn a_generic_string_binding_survives_calls_and_storage() {
    let point = SpecPoint { x: 1.0, y: 2.0 }
    assert_eq(generic_second(point, "hi"), "hi")
    assert_eq(hold(point, "hi")[0], "hi")
}


// An invariant container around an under-determined nested generic: `mk`'s
// K and V are fixed only by pushing the expected NestedTypeHolder<Duo<int, string>> back
// through the invariant NestedTypeHolder into Duo, so unification must recurse into a
// nested application that contains unsolved variables.
struct Duo<K, V> { k: K, v: V }
struct NestedTypeHolder<T> { items: [T] }

fn mk<K, V>() -> NestedTypeHolder<Duo<K, V>> {
    return NestedTypeHolder { items: vec_new() }
}

@test(output = "ok")
fn test_invariant_nested_generic_infers() {
    let _h: NestedTypeHolder<Duo<int, string>> = mk()
    print("ok")
}
