// Type system tests - migrated from rock/tests/type_system_tests.rs
// Tests nullable types, generics, global variables, extern functions, and various type system features

// Shared struct definitions
struct FixVec2 { 
    x: int, 
    y: int 
}

struct Image {}

struct My<T> {
    data: [T],
    len: int,
}

struct Thing<T> {
    index: int,
    _marker: T,
}

struct TestArr<T> {
    data: [T],
    len: int,
}

// Helper functions
fn load_image(path: string) -> Image {
    return Image{}
}

fn make_thing<T>(index: int) -> Thing<T> {
    let marker = phantom()
    return Thing { index: index, _marker: marker }
}

fn test_arr_len<T>(vec: TestArr<T>) -> int {
    return vec.len
}

fn test_arr_set<T>(vec: TestArr<T>, index: int, value: T) {
    if index < 0 || index >= vec.len {
        error("Error: Index out of bounds")
        return
    } else {
        vec.data[index] = value
    }
}

fn my_vec_map<T, U>(vec: My<T>, f: (T) -> U) -> My<U> {
    let result_len: int = vec.len
    let result_data: [U] = []
    let result: My<U> = My { data: result_data, len: result_len }
    return result
}

// Global variable declarations
global dt: float = 1.0/60.0  // Floating-point division
global image: Image

// Extern function declaration
extern fn length(v: FixVec2) -> int;

// Math assignment tests
@test(output = "10\n0\n25\n1", type_holes = [[0, "int"], [1, "int"], [2, "int"], [3, "int"]])
fn test_assign_math() {
    let x = 5
    x += 5
    let x1: ? = x  // [0]
    print(x)
    
    let y = 5
    y -= 5
    let y1: ? = y  // [1]
    print(y)
    
    let z = 5
    z *= 5
    let z1: ? = z  // [2]
    print(z)
    
    let w = 5
    w = w ./ 5
    let w1: ? = w  // [3]
    print(w)
}

// Completion and type inference tests
@test(output = "5", type_holes = [[4, "int"]])
fn simple_completion() {
    let v = FixVec2 { x: 5, y: 10 }
    let x_typed: ? = v.x  // [4] - testing the field type
    print(v.x)
}

@test(output = "5", type_holes = [[5, "int"]])
fn completion_span_test() {
    let v = 5
    let v_typed: ? = v  // [5]
    print(v)
}

// Global variable tests
@test(output = "1")
fn let_global() {
    let assets = Image{}
    print(1)  // Just verify it compiles
}

@test(output = "0.0167", type_holes = [[6, "float"]])
fn initialized_global() {
    let dt_typed: ? = dt  // [6]
    print("{dt:.4f}")  // Use fixed precision to avoid platform differences
}

@test(output = "1")
fn global_decl() {
    // Test that global declarations work
    print(1)  // Just verify it compiles with global image: Image declared
}

// Loop test
@test(output = "55")
fn for_loop_twice() {
    let sum = 0
    for i in [1, 2, 3, 4, 5] {
        sum = sum + i
    }

    for i in [6, 7, 8, 9, 10] {
        sum = sum + i
    }

    print(sum)
}

// Nullable type tests
@test(output = "4", type_holes = [[7, "int"]])
fn basic_if_nullable() {
    let x: int? = 3

    if x != null {
        let y = x + 1   // ok: x is `int`
        let x_typed: ? = x  // [7]
        print(y)
    }
}

@test(output = "4", type_holes = [[8, "int"]])
fn if_else_nullable_then() {
    let x: int? = 3
    if x != null {
        let y = x + 1   // x is `int`
        let x_typed: ? = x  // [8]
        print(y)
    } else {
        // Can't actually reach this branch when x = 3
    }
}

@test(output = "4", type_holes = [[9, "int"]])
fn if_else_nullable_else() {
    let x: int? = 3
    if x == null {
        // Won't reach here when x = 3
    } else {
        let y = x + 1   // x is `int`
        let x_typed: ? = x  // [9]
        print(y)
    }
}

// Helper functions for unwrap tests
fn unwrap_simple() -> int {
    let x: int? = 5
    x.unwrap()
}

fn unwrap_with_var() -> int {
    let x: int? = 5
    let y = x.unwrap()
    y
}

fn unwrap_in_if() -> int {
    let x: int? = 5
    if true {
        x.unwrap()
    } else {
        6
    }
}

fn unwrap_in_if_with_var() -> int {
    let x: int? = 5
    if true {
        let z = x.unwrap()
        z
    } else {
        6
    }
}

// Unwrap tests
@test(output = "5", type_holes = [[10, "int"]])
fn unwrap_in_simple_return() {
    let result = unwrap_simple()
    let result_typed: ? = result  // [10]
    print(result)
}

@test(output = "5", type_holes = [[11, "int"]])
fn unwrap_assigned_to_new_var() {
    let result = unwrap_with_var()
    let result_typed: ? = result  // [11]
    print(result)
}

@test(output = "5", type_holes = [[12, "int"]])
fn unwrap_inside_if_without_shadow() {
    let result = unwrap_in_if()
    let result_typed: ? = result  // [12]
    print(result)
}

@test(output = "5", type_holes = [[13, "int"]])
fn unwrap_inside_if_with_shadowing_removed() {
    let result = unwrap_in_if_with_var()
    let result_typed: ? = result  // [13]
    print(result)
}

// Helper functions for shadowing tests
fn shadow_else_outer() -> int {
    let x: int = 5
    if true {
        let x = x
        x
    } else {
        x  // refers to outer
    }
}

fn shadow_in_if_branch() -> int {
    let x: int = 5
    if true {
        let x = x
        x
    } else {
        x
    }
}

fn nested_shadow() -> int {
    let x: int = 5
    if true {
        if true {
            let x = x
            x
        } else {
            x
        }
    } else {
        6
    }
}

// Shadowing tests
@test(output = "5")
fn shadow_and_else_uses_outer() {
    print(shadow_else_outer())
}

@test(output = "5")
fn shadow_in_if() {
    print(shadow_in_if_branch())
}

@test(output = "5")
fn nested_if_shadow() {
    print(nested_shadow())
}

// Generic struct test - verifying compilation works
@test(output = "42")
fn generic_struct_no_fields() {
    // `T` appears only in `make_thing`'s RETURN type, so nothing at the call
    // pins it; annotated because a completely unconstrained type variable is a
    // rejection (plan S 0h) rather than a defaulted one.
    let thing: Thing<int> = make_thing(42)
    print(thing.index)
}

@test(output = "3")
fn generic_arr_len() {
    let arr = TestArr { data: [1, 2, 3], len: 3 }
    print(test_arr_len(arr))
}

// Helper functions for nullable promotion test
fn promote_int(x: int) -> int? { 
    return x 
}

fn promote_string(x: string) -> string? { 
    return x 
}

// Test that we can compile with nullable promotion functions and generics
@test(output = "0")
fn minimal_nullable_promotion_bug() {
    // This should compile fine even with promotion functions defined
    let vec = My { data: [], len: 0 }
    let result = my_vec_map(vec, (x: int) => x * 2)
    print(result.len)
}

