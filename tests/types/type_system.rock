// Type system corners: compound-assignment result types, typed and
// uninitialized struct globals, nullable narrowing in then and else arms,
// unwrap as a block tail, shadowing in nested ifs, a phantom-only generic
// param, and generic maps with nullable-promoting helpers in scope.

@lua_named struct FixVec2 {
    x: int,
    y: int
}

struct Image {}

struct My<T> {
    data: [T],
    len: int,
}

struct Thing<T> {
    index: int,
    _marker: T,
}

struct TestArr<T> {
    data: [T],
    len: int,
}

fn make_thing<T>(index: int) -> Thing<T> {
    let marker = phantom()
    return Thing { index: index, _marker: marker }
}

fn test_arr_len<T>(vec: TestArr<T>) -> int {
    return vec.len
}

fn my_vec_map<T, U>(vec: My<T>, f: (T) -> U) -> My<U> {
    let result_len: int = vec.len
    let result_data: [U] = []
    let result: My<U> = My { data: result_data, len: result_len }
    return result
}

global dt: float = 1.0/60.0
global image: Image

extern(lua) fn length(v: FixVec2) -> int;

@test(output = "10\n0\n25\n1", type_holes = [[0, "int"], [1, "int"], [2, "int"], [3, "int"]])
fn test_assign_math() {
    let x = 5
    x += 5
    let x1: ? = x
    print(x)

    let y = 5
    y -= 5
    let y1: ? = y
    print(y)

    let z = 5
    z *= 5
    let z1: ? = z
    print(z)

    let w = 5
    w = w ./ 5
    let w1: ? = w
    print(w)
}

@test(output = "1")
fn let_global() {
    let assets = Image{}
    print(1)
}

@test(output = "0.0167", type_holes = [[4, "float"]])
fn initialized_global() {
    let dt_typed: ? = dt
    print("{dt:.4f}")
}

@test(output = "4", type_holes = [[5, "int"]])
fn if_else_nullable_then() {
    let x: int? = 3
    if x != null {
        let y = x + 1
        let x_typed: ? = x
        print(y)
    } else {
    }
}

@test(output = "4", type_holes = [[6, "int"]])
fn if_else_nullable_else() {
    let x: int? = 3
    if x == null {
    } else {
        let y = x + 1
        let x_typed: ? = x
        print(y)
    }
}

fn unwrap_in_if() -> int {
    let x: int? = 5
    if true {
        x.unwrap()
    } else {
        6
    }
}

fn unwrap_in_if_with_var() -> int {
    let x: int? = 5
    if true {
        let z = x.unwrap()
        z
    } else {
        6
    }
}

@test(output = "5", type_holes = [[7, "int"]])
fn unwrap_inside_if_without_shadow() {
    let result = unwrap_in_if()
    let result_typed: ? = result
    print(result)
}

@test(output = "5", type_holes = [[8, "int"]])
fn unwrap_inside_if_with_a_binding() {
    let result = unwrap_in_if_with_var()
    let result_typed: ? = result
    print(result)
}

fn shadow_else_outer() -> int {
    let x: int = 5
    if true {
        let x = x
        x
    } else {
        x
    }
}

fn nested_shadow() -> int {
    let x: int = 5
    if true {
        if true {
            let x = x
            x
        } else {
            x
        }
    } else {
        6
    }
}

@test(output = "5")
fn shadow_and_else_uses_outer() {
    print(shadow_else_outer())
}

@test(output = "5")
fn nested_if_shadow() {
    print(nested_shadow())
}

@test(output = "42")
fn generic_struct_no_fields() {
    // `T` appears only in `make_thing`'s RETURN type, so nothing at the call
    // pins it; annotated because a completely unconstrained type variable is a
    // rejection rather than a defaulted one.
    let thing: Thing<int> = make_thing(42)
    print(thing.index)
}

@test(output = "3")
fn generic_arr_len() {
    let arr = TestArr { data: [1, 2, 3], len: 3 }
    print(test_arr_len(arr))
}

fn promote_int(x: int) -> int? {
    return x
}

fn promote_string(x: string) -> string? {
    return x
}

@test(output = "0")
fn generic_map_with_promoting_helpers_in_scope() {
    let vec = My { data: [], len: 0 }
    let result = my_vec_map(vec, (x: int) => x * 2)
    print(result.len)
}
