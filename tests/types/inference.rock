// Local type inference checked through type holes: @test(type_holes =
// [[id, "type"], ...]) asserts the type inferred for each `?` annotation, with
// ids numbered across the whole file in source order. Covers literals,
// operators, structs, generics, nested arrays, nullable coalescing, calls,
// declared return types, if and while bodies and unit-valued calls.

@test(type_holes = [[0, "int"], [1, "string"], [2, "float"]])
fn test_basic_type_inference() {
    let x: ? = 42
    let y: ? = "hello"
    let z: ? = 3.14

    assert_eq(x, 42)
    assert_eq(y, "hello")
    assert_eq(z, 3.14)
}

fn identity<T>(x: T) -> T {
    return x
}

@test(type_holes = [[3, "[int]"], [4, "int"]])
fn test_generic_function_inference() {
    let arr: ? = [1, 2, 3]
    let elem: ? = identity(arr[0])

    assert_eq(elem, 1)
}

struct Point {
    x: int,
    y: int
}

@test(type_holes = [[5, "Point"], [6, "int"], [7, "int"]])
fn test_struct_field_inference() {
    let p: ? = Point { x: 10, y: 20 }
    let x_val: ? = p.x
    let y_val: ? = p.y

    assert_eq(x_val, 10)
    assert_eq(y_val, 20)
}

@test(type_holes = [[8, "[[int]]"], [9, "[int]"], [10, "int"]])
fn test_nested_type_inference() {
    let matrix: ? = [[1, 2], [3, 4]]
    let row: ? = matrix[0]
    let elem: ? = row[1]

    assert_eq(elem, 2)
}

@test(type_holes = [[11, "int"]])
fn test_nullable_type_inference() {
    let maybe_val: int? = 42
    let default_val: ? = maybe_val ?? 0

    assert_eq(default_val, 42)
}

@test(output = "Value: 42", type_holes = [[12, "int"]])
fn test_combined_output_and_types() {
    let x: ? = 42
    print("Value: {x}")
}

@test(type_holes = [[13, "int"], [14, "int"], [15, "bool"]])
fn test_operator_type_inference() {
    let a: ? = 10 + 20
    let b: ? = a * 2
    let c: ? = a > b

    assert_eq(a, 30)
    assert_eq(b, 60)
    assert_eq(c, false)
}

fn greet(name: string) -> string {
    return "Hello, {name}!"
}

fn count_chars(s: string) -> int {
    return 13
}

@test(type_holes = [[16, "string"], [17, "int"]])
fn test_function_return_inference() {
    let greeting: ? = greet("World")
    let length: ? = count_chars(greeting)

    assert_eq(greeting, "Hello, World!")
    assert_eq(length, 13)
}

// A hole in a function with a declared return type.
@test(type_holes = [[18, "Point"]])
fn test_struct_type_hole() -> Point {
    let p: ? = Point { x: 10, y: 20 }
    return p
}

@test(type_holes = [[19, "bool"]])
fn test_bool_literal() {
    let x: ? = true
    assert_eq(x, true)
}

@test(type_holes = [[20, "int"], [21, "int"]])
fn test_variable_assignment() {
    let x = 5
    let y: ? = x
    let z: ? = y
    assert_eq(y, 5)
    assert_eq(z, 5)
}

@test(type_holes = [[22, "bool"]])
fn test_logical_and() {
    let result: ? = true && false
    assert_eq(result, false)
}

@test(type_holes = [[23, "int"]])
fn test_if_expression() {
    let result: ? = if true { 5 } else { 10 }
    assert_eq(result, 5)
}

struct Container<T> { value: T }

@test(type_holes = [[24, "Container<int>"]])
fn test_generic_struct_int() {
    let c: ? = Container { value: 42 }
    assert_eq(c.value, 42)
}

@test(type_holes = [[25, "Container<string>"]])
fn test_generic_struct_string() {
    let c: ? = Container { value: "hello" }
    assert_eq(c.value, "hello")
}

@test(type_holes = [[26, "[string]"]])
fn test_string_array() {
    let arr: ? = ["a", "b", "c"]
    assert_eq(arr[0], "a")
}

fn void_func(x: int) {
    print(x)
}

@test(type_holes = [[27, "()"]])
fn test_void_function_call() {
    let result: ? = void_func(5)
    assert_eq(result, ())
}

@test(type_holes = [[28, "int"]])
fn test_parenthesized_expression() {
    let x = 5
    let y = 6
    let result: ? = (x + y)
    assert_eq(result, 11)
}

@test(type_holes = [[29, "int"], [30, "int"]])
fn test_typed_let_inference() {
    let x: int = 5
    let y: ? = x
    let z: ? = 5
}

@test(output = "0")
fn test_if_no_else_is_unit() {
    // statement position: a no-else if is unit. In value position
    // (`let x = if true { () }`) bone rejects it (missing else).
    if true { () }
    print(0)
}

@test(type_holes = [[31, "int"], [32, "int"]])
fn test_while_loop_inference() {
    let x = 0
    let a: ? = x

    while x < 5 {
        x = x + 1
        let b: ? = x
    }
}
