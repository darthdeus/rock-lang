// Comprehensive generic tests ported from rock/tests/generic_tests.rs
// Tests basic generic functions, structs, type inference, and constraints
// For advanced tests see types/generics_advanced.rock

// Generic function definitions
fn id<T>(x: T) -> T { 
    return x 
}

fn unbox<T>(b: Box<T>) -> T { 
    return b.item 
}

// Generic struct definitions
struct Box<T> { 
    item: T 
}

struct Pair<T, U> { 
    first: T, 
    second: U 
}

struct Holder<T> { 
    value: int 
}

// Generic wrapper function
fn wrap<T>(x: T) -> T { 
    return x 
}

// Helper function for testing
fn foo<T>(x: int) -> int { 
    return x + 1 
}

@test(output = "0")
fn generic_struct_multiple_params() {
    print(0)
}

@test(output = "5")
fn generic_identity_infer_int() {
    print(id(5))
}

@test(output = "2.5")
fn generic_identity_infer_float() {
    print(id(2.5))
}

@test(output = "10")
fn generic_struct_basic() {
    let b = Box { item: 10 }
    print(b.item)
}

@test(output = "7")
fn generic_struct_nested() {
    let b = Box { item: Box { item: 7 } }
    print(b.item.item)
}

@test(output = "42")
fn generic_function_struct_return() {
    let b = Box { item: 42 }
    print(unbox(b))
}

@test(output = "6")
fn generic_infer_from_variable() {
    let x = id(5)
    print(x + 1)
}