// Array literal element types join to their least upper bound: int with
// float gives float, null with T gives T?.

@test
fn test_int_float_promotion() {
    let arr1 = [1, 2.0, 3.0]
    assert_eq(arr1, [1.0, 2.0, 3.0])
    let arr2 = [2.5, 3, 4.0, 5]
    assert_eq(arr2, [2.5, 3.0, 4.0, 5.0])
    // All ints stay an int array.
    let arr3 = [1, 2, 3, 4]
    assert_eq(vec_len(arr3), 4)
    assert_eq(vec_get(arr3, 0).unwrap(), 1)
    assert_eq(vec_get(arr3, 3).unwrap(), 4)
}

@test
fn test_nullable_promotion() {
    let arr1 = [null, 2, 4]
    assert_eq(vec_len(arr1), 3)
    assert(vec_get(arr1, 0).is_null())
    let expected_int1: int? = 2
    assert_eq(vec_get(arr1, 1).unwrap(), expected_int1)
    let expected_int2: int? = 4
    assert_eq(vec_get(arr1, 2).unwrap(), expected_int2)

    let arr2 = [null, 2.5, 4.5]
    assert_eq(vec_len(arr2), 3)
    assert(vec_get(arr2, 0).is_null())
    let expected_float1: float? = 2.5
    assert_eq(vec_get(arr2, 1).unwrap(), expected_float1)
    let expected_float2: float? = 4.5
    assert_eq(vec_get(arr2, 2).unwrap(), expected_float2)

    // null, int and float join to float?; the int element is promoted.
    let arr3 = [null, 2, 4.5]
    assert_eq(vec_len(arr3), 3)
    assert(vec_get(arr3, 0).is_null())
    let expected_float3: float? = 2.0
    assert_eq(vec_get(arr3, 1).unwrap(), expected_float3)
    let expected_float4: float? = 4.5
    assert_eq(vec_get(arr3, 2).unwrap(), expected_float4)
}

@test
fn test_nullable_with_non_null() {
    let x: int? = 5
    let arr = [x, 10, null]
    assert_eq(vec_len(arr), 3)
    let expected_val0: int? = 5
    assert_eq(vec_get(arr, 0), expected_val0)
    let expected_val1: int? = 10
    assert_eq(vec_get(arr, 1), expected_val1)
    assert(vec_get(arr, 2).is_null())
}

@test
fn test_complex_promotion() {
    // int?, int and float join to float?. Index directly: `arr[i]` is the
    // element type `float?` on both backends (`vec_get` would add a layer that
    // bone collapses, since Lua has one `nil`).
    let x: int? = 3
    let arr = [x, 5, 7.5]
    assert_eq(vec_len(arr), 3)
    assert_eq(arr[0] ?? -1.0, 3.0)
    assert_eq(arr[1] ?? -1.0, 5.0)
    assert_eq(arr[2] ?? -1.0, 7.5)
}
