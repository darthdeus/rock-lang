// Example of type hole testing in Rock
// Note: Type hole IDs are assigned sequentially across the entire file

@test(type_holes = [[0, "int"]])
fn test_int_inference() {
    let x: ? = 42
    assert_eq(x, 42)
}

@test(type_holes = [[1, "string"]])
fn test_string_inference() {
    let msg: ? = "Hello, Rock!"
    assert_eq(msg, "Hello, Rock!")
}

@test(type_holes = [[2, "[int]"], [3, "int"]])
fn test_array_inference() {
    let nums: ? = [1, 2, 3, 4, 5]
    let first: ? = nums[0]
    assert_eq(first, 1)
}

struct Person { 
    name: string, 
    age: int 
}

@test(type_holes = [[4, "Person"], [5, "string"], [6, "int"]])
fn test_struct_inference() {
    let p: ? = Person { name: "Alice", age: 30 }
    let n: ? = p.name
    let a: ? = p.age
    assert_eq(n, "Alice")
    assert_eq(a, 30)
}

@test(output = "int: 100\nfloat: 3.14", type_holes = [[7, "int"], [8, "float"]])
fn test_combined_output_and_types() {
    let i: ? = 100
    let f: ? = 3.14
    print("int: {i}")
    print("float: {f}")
}