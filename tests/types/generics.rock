// Generic functions and structs: explicit and inferred type arguments,
// nullable generics, nested generic structs and generic call chains.

fn id<T>(x: T) -> T { 
    return x 
}

fn create<T>() -> T? {
    return null
}

fn maybe_id<T>(x: T?) -> T? {
    return x
}

fn first<T>(arr: [T]) -> T? {
    if vec_len(arr) > 0 {
        return arr[0]
    } else {
        return null
    }
}

struct Box<T> { 
    item: T 
}

fn unbox<T>(b: Box<T>) -> T { 
    return b.item 
}

@test(output = "5", type_holes = [[0, "int"]])
fn test_generic_id_int() {
    let res: ? = id(5)
    print(res)
}

@test(output = "5")
fn test_generic_id_any() {
    let val: any = 5
    print(id(val))
}

@test(type_holes = [[1, "int?"]])
fn test_generic_create_infer_int() {
    let n: ? = create()
    let typed_n: int? = n
}

@test(output = "0")
fn test_generic_create_infer_string() {
    let s: string? = create()
    print(0)
}

@test(output = "5")
fn test_maybe_id_int() {
    let res = maybe_id(5)
    print(res)
}

@test(output = "10", type_holes = [[2, "int"]])
fn test_generic_struct_type_inference() {
    let b = Box { item: 10 }
    let item: ? = b.item
    print(item)
}

@test(output = "42", type_holes = [[3, "int"]])
fn test_generic_function_with_struct() {
    let b = Box { item: 42 }
    let result: ? = unbox(b)
    print(result)
}

@test(output = "6", type_holes = [[4, "int"]])
fn test_generic_inference_from_variable() {
    let x: ? = id(5)
    print(x + 1)
}

@test(output = "0")
fn test_first_with_typed_empty_array() {
    let empty_bools: [bool] = []
    let res = first(empty_bools)
    print(0)
}

@test(output = "0")
fn test_complex_generic_inference_scenario() {
    // This tests the most complex inference patterns
    // that the compiler should handle correctly
    
    // Multi-level generic inference
    let nested_box = Box { item: Box { item: "test" } }
    let inner_content = unbox(unbox(nested_box))
    
    // Generic function chaining
    let value = id(id(id(42)))
    
    // Mixed generic and concrete types
    let maybe_value = maybe_id(id("hello"))
    
    print(0)
}

@test(output = "2.5\n7")
fn generic_float_and_nested_struct() {
    print(id(2.5))
    let b = Box { item: Box { item: 7 } }
    print(b.item.item)
}
