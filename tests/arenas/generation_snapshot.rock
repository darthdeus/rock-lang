struct SnapshotRow { value: int }

fn snapshot_history_sum(snapshot: ArenaGenerationSnapshot) -> int {
    let total = snapshot.next_generation
    for generation in snapshot.generations { total += generation }
    for slot in snapshot.free_indices { total += slot }
    return total
}

@test
fn arena_generation_snapshot_tracks_reuse_and_retirement() {
    let arena: Arena<SnapshotRow> = arena_new()
    let first = arena.insert(SnapshotRow { value: 1 })
    let second = arena.insert(SnapshotRow { value: 2 })
    let _ = arena.remove(first)
    let before = arena_generation_snapshot(arena)
    assert(before.generations.len() == 2
        && before.generations[0] == first._generation
        && before.generations[1] == second._generation
        && before.free_indices.len() == 1
        && before.free_indices[0] == first._slot
        && before.next_generation == second._generation + 1,
        "snapshot includes vacant generation and free-list order")
    let reused = arena.insert(SnapshotRow { value: 3 })
    let after = arena_generation_snapshot(arena)
    assert(reused._slot == first._slot
        && after.generations[0] == reused._generation
        && after.free_indices.len() == 0
        && after.next_generation == reused._generation + 1,
        "snapshot advances after slot reuse")
    let _ = arena_destroy(arena)
    let retired = arena_generation_snapshot(arena)
    assert(retired.generations.len() == 0
        && retired.free_indices.len() == 0
        && retired.next_generation == 0,
        "retired arena has an empty history")
}

@test
fn arena_generation_snapshot_can_flow_to_a_reader() {
    let arena: Arena<SnapshotRow> = arena_new()
    let first = arena.insert(SnapshotRow { value: 1 })
    let _ = arena.remove(first)
    assert(snapshot_history_sum(arena_generation_snapshot(arena)) == 1,
        "an ephemeral snapshot can be read by a helper")
    let _ = arena_destroy(arena)
}
