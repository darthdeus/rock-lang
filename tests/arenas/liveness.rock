// A handle resolves only while its row is live: these hold for every read
// path that shares the liveness test (`Entity.get`, `Arena.get/contains/
// borrow/remove`, the weak cache), across remove, slot reuse, clear, destroy
// and a foreign owner.
struct LiveRow { value: int }

fn absent(arena: Arena<LiveRow>, entity: Entity<LiveRow>) -> bool {
    return entity.get() == null && arena.get(entity) == null
        && !arena.contains(entity) && arena.borrow(entity) == null
}

@test(output = "true true\ntrue true 2")
fn a_removed_handle_stays_absent_through_slot_reuse() {
    let arena: Arena<LiveRow> = arena_new()
    let first = arena.insert(LiveRow { value: 1 })
    let _ = arena.insert(LiveRow { value: 9 })
    let _ = arena.remove(first)
    print("{absent(arena, first)} {arena.remove(first) == null}")

    let reused = arena.insert(LiveRow { value: 2 })
    print("{reused._slot == first._slot && reused._generation != first._generation} {absent(arena, first)} {reused.get().unwrap().value}")
}

@test(output = "true\ntrue 3")
fn a_retained_slot_reuse_leaves_the_old_handle_absent() {
    let arena: Arena<LiveRow> = arena_new()
    let old = arena.insert(LiveRow { value: 3 })
    old.remove()
    print("{absent(arena, old)}")
    let fresh = arena.reuse_retained_entity().unwrap()
    print("{absent(arena, old)} {fresh.get().unwrap().value}")
}

@test(output = "true\ntrue")
fn clear_and_destroy_leave_handles_absent() {
    let arena: Arena<LiveRow> = arena_new()
    let before_clear = arena.insert(LiveRow { value: 4 })
    arena.clear()
    let after_clear = arena.insert(LiveRow { value: 5 })
    print("{absent(arena, before_clear)}")
    let _ = arena_destroy(arena)
    print("{absent(arena, after_clear)}")
}

@test(output = "true false")
fn a_handle_naming_another_scene_is_absent() {
    let arena: Arena<LiveRow> = arena_new()
    let live = arena.insert(LiveRow { value: 6 })
    let foreign: Entity<LiveRow> = Entity {
        _scene_id: live._scene_id + 1, _arena_id: live._arena_id,
        _slot: live._slot, _generation: live._generation,
    }
    print("{foreign.get() == null} {live.get() == null}")
}

@test(output = "7 true")
fn the_weak_cache_drops_a_removed_owner() {
    let arena: Arena<LiveRow> = arena_new()
    let owner = arena.insert(LiveRow { value: 7 })
    weak_cache_put("arena_liveness", owner, 7)
    let cached: int? = weak_cache_get("arena_liveness", owner)
    owner.remove()
    let stale: int? = weak_cache_get("arena_liveness", owner)
    print("{cached.unwrap()} {stale == null}")
}

// Every Arena read answers "not there" for a handle whose slot lies outside
// the occupancy column. The Lua getter has no explicit range check (ledger
// B2a): an out-of-range slot must read as absent, never as some other row.

struct Tag { v: int }

fn report(arena: Arena<Tag>, entity: Entity<Tag>) {
    print("{entity.get() == null} {arena.get(entity) == null} {!arena.contains(entity)} {arena.borrow(entity) == null} {arena.remove(entity) == null}")
}

@test(output = "true true true true true\ntrue true true true true\n1")
fn a_slot_past_the_columns_is_absent() {
    let a: Arena<Tag> = arena_new()
    let only = a.insert(Tag { v: 1 })
    // One past the end, and far past it, with the live generation.
    report(a, entity_new(a, 1, only._generation))
    report(a, entity_new(a, 1000, only._generation))
    print(only.get().unwrap().v)
}

@test(output = "true true true true true\n7")
fn a_handle_from_before_clear_is_absent_beyond_the_new_columns() {
    let a: Arena<Tag> = arena_new()
    let last = a.insert(Tag { v: 0 })
    for i in 1..8 { last = a.insert(Tag { v: i }) }
    a.clear()
    let fresh = a.insert(Tag { v: 7 })
    report(a, last)
    print(fresh.get().unwrap().v)
}

@test(output = "true true true true true")
fn a_negative_slot_is_absent() {
    let a: Arena<Tag> = arena_new()
    let only = a.insert(Tag { v: 1 })
    let forged: Entity<Tag> = Entity {
        _scene_id: only._scene_id,
        _arena_id: only._arena_id,
        _slot: -1,
        _generation: only._generation,
    }
    report(a, forged)
}
