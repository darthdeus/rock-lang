// A handle resolves only while its row is live, on every read path that shares
// the liveness test (`Entity.get`, `Arena.get/contains/borrow/remove`), across
// remove, slot reuse, clear, destroy, a foreign owner and an out-of-range slot.
// Clear keeps the arena incarnation; destroy retires it and its id for good.

struct LiveRow { value: int }

fn absent(arena: Arena<LiveRow>, entity: Entity<LiveRow>) -> bool {
    return entity.get() == null && arena.get(entity) == null
        && !arena.contains(entity) && arena.borrow(entity) == null
}

@test(output = "true true\ntrue true 2")
fn a_removed_handle_stays_absent_through_slot_reuse() {
    let arena: Arena<LiveRow> = arena_new()
    let first = arena.insert(LiveRow { value: 1 })
    let _ = arena.insert(LiveRow { value: 9 })
    let _ = arena.remove(first)
    print("{absent(arena, first)} {arena.remove(first) == null}")

    let reused = arena.insert(LiveRow { value: 2 })
    print("{reused._slot == first._slot && reused._generation != first._generation} {absent(arena, first)} {reused.get().unwrap().value}")
}

@test(output = "true\ntrue 3")
fn a_retained_slot_reuse_leaves_the_old_handle_absent() {
    let arena: Arena<LiveRow> = arena_new()
    let old = arena.insert(LiveRow { value: 3 })
    old.remove()
    print("{absent(arena, old)}")
    let fresh = arena.reuse_retained_entity().unwrap()
    print("{absent(arena, old)} {fresh.get().unwrap().value}")
}

@test(output = "true\ntrue")
fn clear_and_destroy_leave_handles_absent() {
    let arena: Arena<LiveRow> = arena_new()
    let before_clear = arena.insert(LiveRow { value: 4 })
    arena.clear()
    let after_clear = arena.insert(LiveRow { value: 5 })
    print("{absent(arena, before_clear)}")
    let _ = arena_destroy(arena)
    print("{absent(arena, after_clear)}")
}

@test(output = "true false")
fn a_handle_naming_another_scene_is_absent() {
    let arena: Arena<LiveRow> = arena_new()
    let live = arena.insert(LiveRow { value: 6 })
    let foreign: Entity<LiveRow> = Entity {
        _scene_id: live._scene_id + 1, _arena_id: live._arena_id,
        _slot: live._slot, _generation: live._generation,
    }
    print("{foreign.get() == null} {live.get() == null}")
}

// The Lua getter has no explicit range check: a slot outside the occupancy
// column must read as absent, never as some other row.

struct Tag { v: int }

fn report(arena: Arena<Tag>, entity: Entity<Tag>) {
    print("{entity.get() == null} {arena.get(entity) == null} {!arena.contains(entity)} {arena.borrow(entity) == null} {arena.remove(entity) == null}")
}

@test(output = "true true true true true\ntrue true true true true\n1")
fn a_slot_past_the_columns_is_absent() {
    let a: Arena<Tag> = arena_new()
    let only = a.insert(Tag { v: 1 })
    // One past the end, and far past it, with the live generation.
    report(a, entity_new(a, 1, only._generation))
    report(a, entity_new(a, 1000, only._generation))
    print(only.get().unwrap().v)
}

@test(output = "true true true true true\n7")
fn a_handle_from_before_clear_is_absent_beyond_the_new_columns() {
    let a: Arena<Tag> = arena_new()
    let last = a.insert(Tag { v: 0 })
    for i in 1..8 { last = a.insert(Tag { v: i }) }
    a.clear()
    let fresh = a.insert(Tag { v: 7 })
    report(a, last)
    print(fresh.get().unwrap().v)
}

@test(output = "true true true true true")
fn a_negative_slot_is_absent() {
    let a: Arena<Tag> = arena_new()
    let only = a.insert(Tag { v: 1 })
    let forged: Entity<Tag> = Entity {
        _scene_id: only._scene_id,
        _arena_id: only._arena_id,
        _slot: -1,
        _generation: only._generation,
    }
    report(a, forged)
}

@test
fn clear_preserves_incarnation_and_retires_rows() {
    let a: Arena<Tag> = arena_new()
    let id = a._arena_id
    let before = a.insert(Tag { v: 1 })
    for i in 0..4 { a.insert(Tag { v: i }) }
    a.clear()
    assert_eq(a.len(), 0)
    let seen = 0
    for (_e, _v) in a { seen += 1 }
    assert_eq(seen, 0)
    let after = a.insert(Tag { v: 2 })
    assert_eq(a.len(), 1)
    assert_eq(before._slot, 0)
    assert_eq(after._slot, 0)
    assert(after._generation > before._generation)
    assert_eq(a._arena_id, id)
    assert_eq(before._arena_id, after._arena_id)
}

@test(output = "1")
fn clear_does_not_churn_arena_ids() {
    let a: Arena<Tag> = arena_new()
    let id = a._arena_id
    for _i in 0..10 { a.clear() }
    let b: Arena<Tag> = arena_new()
    print(b._arena_id - id)
}

@nomangle inline(lua) fn raises(f: fn()) -> bool = """
    local ok, err = pcall(f)
    return not ok
"""

@nomangle inline(js) fn raises(f: fn()) -> bool = """
    try { __rock_call(f); return false; } catch (e) { return true; }
"""

@test
fn destroy_retires_one_incarnation() {
    let dead: Arena<Tag> = arena_new()
    let live: Arena<Tag> = arena_new()
    let stale = dead.insert(Tag { v: 5 })
    dead.insert(Tag { v: 6 })
    let kept = live.insert(Tag { v: 9 })
    let id = dead._arena_id
    assert(arena_destroy(dead))
    assert(!arena_destroy(dead))
    assert(dead.get(stale) == null)
    assert(!dead.contains(stale))
    assert(stale.get() == null)
    assert(stale.remove() == null)
    assert_eq(dead.len(), 0)
    let seen = 0
    for (_e, _v) in dead { seen += 1 }
    assert_eq(seen, 0)
    assert(raises(() => { let _e = dead.insert(Tag { v: 1 }) }))
    assert(raises(() => { dead.clear() }))
    assert_eq(live.get(kept).unwrap().v, 9)
    assert_eq(live.len(), 1)
    assert(live.get(stale) == null)
    let fresh: Arena<Tag> = arena_new()
    let e = fresh.insert(Tag { v: 7 })
    assert(fresh._arena_id > id)
    assert(fresh.get(stale) == null)
    assert(!fresh.contains(stale))
    assert_eq(fresh.get(e).unwrap().v, 7)
}

@test(output = "true\ntrue\ntrue\ntrue")
fn retired_arena_storage_is_bounded_and_ids_stay_unique() {
    let anchor: Arena<Tag> = arena_new()
    let anchor_entity = anchor.insert(Tag { v: 99 })
    let storage_limit = arena_registry_storage_bound()
    let previous_id = -1
    let ids_stay_monotonic = true
    let stale_handles_stay_dead = true
    let anchor_stays_live = true
    for i in 0..4096 {
        let retired: Arena<Tag> = arena_new()
        let stale = retired.insert(Tag { v: i })
        if retired._arena_id <= previous_id { ids_stay_monotonic = false }
        previous_id = retired._arena_id
        arena_destroy(retired)

        let replacement: Arena<Tag> = arena_new()
        let fresh = replacement.insert(Tag { v: i + 1 })
        if !is_null(replacement.get(stale)) { stale_handles_stay_dead = false }
        if replacement.get(fresh).unwrap().v != i + 1 {
            stale_handles_stay_dead = false
        }
        if anchor.get(anchor_entity).unwrap().v != 99 { anchor_stays_live = false }
        arena_destroy(replacement)
    }
    print(arena_registry_storage_bound() <= storage_limit + 33)
    print(ids_stay_monotonic)
    print(stale_handles_stay_dead)
    print(anchor_stays_live)
    arena_destroy(anchor)
}

struct ReusedSlot { x: int, y: int }

@test(output = "true 7 9")
fn arena_reuse_reactivates_the_retained_payload() {
    let a: Arena<ReusedSlot> = arena_new()
    assert(a.reuse_retained() == null, "an empty free list reuses nothing")
    a.insert(ReusedSlot { x: 1, y: 2 }).remove()

    let payload = a.reuse_retained().unwrap()
    payload.x = 7
    payload.y = 9

    let got_x = 0
    let got_y = 0
    for (_, got) in a {
        got_x = got.x
        got_y = got.y
    }
    print("{a.len() == 1} {got_x} {got_y}")
}

@test(output = "true true 11 13")
fn arena_reuse_entity_issues_a_fresh_handle_for_the_retained_payload() {
    let a: Arena<ReusedSlot> = arena_new()
    let old = a.insert(ReusedSlot { x: 1, y: 2 })
    old.remove()

    let reused = a.reuse_retained_entity().unwrap()
    let payload = reused.get().unwrap()
    payload.x = 11
    payload.y = 13
    print("{old.get() == null} {a.contains(reused)} {payload.x} {payload.y}")
}
