// Arena and container storage: the typed arena store's issuance and occupancy
// counters, `ref` borrows of value and struct rows, and the vec and map storage
// helpers at column, boxed and scalar elements. Only the column/boxed pair is
// evidence: a column-only test would still pass with the boxed path broken.

struct MetadataRow { value: int }

value MetadataStamp { arena_id: int, issued: int, count: int }

fn metadata_issued_ref(store: ref ArenaStore<MetadataRow>) -> int {
    return store.next_generation
}

fn metadata_stamp(arena: Arena<MetadataRow>) -> MetadataStamp? {
    let store = __arena_store(arena) ?? return null
    return MetadataStamp {
        arena_id: arena._arena_id,
        issued: store.next_generation,
        count: store.occupied_count,
    }
}

@test
fn typed_arena_store_metadata_tracks_issuance_and_occupancy() {
    let rows: Arena<MetadataRow> = arena_new()
    let first = rows.insert(MetadataRow { value: 1 })
    let stamp = metadata_stamp(rows).unwrap()
    assert(stamp.arena_id == rows._arena_id && stamp.issued == 1 && stamp.count == 1)
    let _ = rows.remove(first)
    let removed = metadata_stamp(rows).unwrap()
    assert(removed.issued == 1 && removed.count == 0)
    let second = rows.insert(MetadataRow { value: 2 })
    let reused = metadata_stamp(rows).unwrap()
    assert(second._slot == first._slot && reused.issued == 2 && reused.count == 1)
    rows.clear()
    let cleared = metadata_stamp(rows).unwrap()
    assert(cleared.issued == 2 && cleared.count == 0)
    let _ = arena_destroy(rows)
    assert(metadata_stamp(rows) == null)
}

@test
fn typed_arena_store_metadata_is_a_live_view_until_registry_retirement() {
    let rows: Arena<MetadataRow> = arena_new()
    let store = __arena_store(rows).unwrap()
    assert(store._owner_scene_id == rows._scene_id)
    let _ = rows.insert(MetadataRow { value: 3 })
    assert(store.next_generation == 1 && store.occupied_count == 1)
    let _ = arena_destroy(rows)
    assert(__arena_store(rows) == null)
    assert(store.next_generation == 1 && store.occupied_count == 1)
}

@test
fn typed_arena_store_metadata_reads_through_a_frame_reference() {
    let rows: Arena<MetadataRow> = arena_new()
    let _ = rows.insert(MetadataRow { value: 1 })
    let store = __arena_store(rows).unwrap()
    assert(metadata_issued_ref(store) == 1)
    let _ = arena_destroy(rows)
}

// A `value` row is stored flat, so its borrow travels as the data column and a
// slot; a `struct` row's borrow is the row itself.
value BorrowCell { n: int }
struct BorrowRow { n: int }

@test(output = "11\n11")
fn a_value_row_borrow_writes_through() {
    let a: Arena<BorrowCell> = arena_new()
    let h = a.insert(BorrowCell { n: 10 })
    let cell: ref BorrowCell = a.borrow(h).unwrap()
    cell.n = 11
    print(cell.n)
    print(h.get().unwrap().n)
}

@test(output = "10\n20")
fn a_value_row_borrow_leaves_a_sibling_row_alone() {
    let a: Arena<BorrowCell> = arena_new()
    let h = a.insert(BorrowCell { n: 10 })
    let cell: ref BorrowCell = a.borrow(h).unwrap()
    let other = a.insert(BorrowCell { n: 20 })
    print(cell.n)
    print(other.get().unwrap().n)
}

// `clear` replaces the columns, so a borrow from before it addresses the
// retired column, not the row inserted after.
@test(output = "20\ntrue")
fn a_value_row_borrow_from_before_clear_does_not_reach_a_new_row() {
    let a: Arena<BorrowCell> = arena_new()
    let h = a.insert(BorrowCell { n: 10 })
    let cell: ref BorrowCell = a.borrow(h).unwrap()
    a.clear()
    let fresh = a.insert(BorrowCell { n: 20 })
    cell.n = 11
    print(fresh.get().unwrap().n)
    print(h.get() == null)
}

@test(output = "20\ntrue")
fn a_struct_row_borrow_does_not_reach_the_row_that_reuses_its_slot() {
    let a: Arena<BorrowRow> = arena_new()
    let h = a.insert(BorrowRow { n: 10 })
    let row: ref BorrowRow = a.borrow(h).unwrap()
    a.remove(h)
    let fresh = a.insert(BorrowRow { n: 20 })
    row.n = 11
    print(fresh.get().unwrap().n)
    print(h.get() == null)
}

value SH { a: int, b: int }
value SHBoxed { s: string }

@test fn vec_helpers_at_a_column_element() {
    let xs: [SH] = []
    xs.push(SH { a: 1, b: 2 })
    xs.push(SH { a: 3, b: 4 })
    assert_eq(xs.get(0).unwrap().a, 1)
    xs[1] = SH { a: 9, b: 9 }
    assert_eq(xs[1].a, 9)
    assert_eq(xs.len, 2)
    let popped = xs.pop()
    assert(popped != null)
    assert_eq(xs.len, 1)
}

@test fn vec_helpers_at_a_boxed_element() {
    let xs: [SHBoxed] = []
    xs.push(SHBoxed { s: "a" })
    xs.push(SHBoxed { s: "b" })
    assert_eq(xs.get(0).unwrap().s, "a")
    xs[1] = SHBoxed { s: "z" }
    assert_eq(xs[1].s, "z")
    let popped = xs.pop()
    assert(popped != null)
    assert_eq(xs.len, 1)
}

@test fn vec_helpers_at_a_scalar_element() {
    let ns: [int] = []
    ns.push(5)
    ns.push(6)
    assert_eq(ns.get(1).unwrap(), 6)
    ns[0] = 7
    assert_eq(ns[0], 7)
    assert_eq(ns.pop().unwrap(), 6)
}

@test fn table_unset_at_a_column_value() {
    let m: Map<string, SH> = map_new()
    m["a"] = SH { a: 1, b: 2 }
    m["b"] = SH { a: 3, b: 4 }
    m.remove("a")
    assert(m.get("a") == null)
    assert_eq(m["b"].a, 3)
    m.clear()
    assert_eq(m.len(), 0)
}

@test fn table_unset_at_a_boxed_value() {
    let m: Map<string, SHBoxed> = map_new()
    m["a"] = SHBoxed { s: "x" }
    m["b"] = SHBoxed { s: "y" }
    m.remove("a")
    assert(m.get("a") == null)
    assert_eq(m["b"].s, "y")
    m.clear()
    assert_eq(m.len(), 0)
}
