// Rebuildable values beside handle-owned rows, outside saved/replay state:
// hits and misses, owner and cache-name keys, clones, stale handles and slot
// reuse, eviction on clear/destroy/scene close, and transfer of borrowed
// nested values into the cache.

struct WeakCacheOwner { tag: int }
struct WeakCacheValue { tag: int }

const WC_BASIC: string = "test.weak_cache.basic"
const WC_OWNERS: string = "test.weak_cache.owners"
const WC_LEFT: string = "test.weak_cache.left"
const WC_RIGHT: string = "test.weak_cache.right"
const WC_GC: string = "test.weak_cache.gc"

@test
fn weak_cache_misses_hits_counts_and_invalidates() {
    let rows: Arena<WeakCacheOwner> = arena_new()
    let owner = rows.insert(WeakCacheOwner { tag: 1 })
    let cold: WeakCacheValue? = weak_cache_get(WC_BASIC, owner)
    assert(cold == null, "a cache with no entry for this owner misses")

    let builds = weak_cache_builds(WC_BASIC)
    weak_cache_put(WC_BASIC, owner, WeakCacheValue { tag: 10 })
    assert_eq(weak_cache_builds(WC_BASIC), builds + 1, "a store counts one build")

    let warm: WeakCacheValue? = weak_cache_get(WC_BASIC, owner)
    assert(warm != null, "a stored owner hits")
    assert_eq(warm.unwrap().tag, 10, "the hit is the value that was stored")

    for _ in 0..16 {
        let repeat: WeakCacheValue? = weak_cache_get(WC_BASIC, owner)
        assert(repeat != null, "the entry stays warm across reads")
    }
    assert_eq(weak_cache_builds(WC_BASIC), builds + 1, "reads do not build")

    weak_cache_drop(WC_BASIC, owner)
    let dropped: WeakCacheValue? = weak_cache_get(WC_BASIC, owner)
    assert(dropped == null, "invalidation removes the entry")
    assert_eq(weak_cache_builds(WC_BASIC), builds + 1, "invalidation does not build")
}

@test
fn weak_cache_keeps_two_live_owners_independent() {
    let rows: Arena<WeakCacheOwner> = arena_new()
    let a = rows.insert(WeakCacheOwner { tag: 1 })
    let b = rows.insert(WeakCacheOwner { tag: 2 })
    weak_cache_put(WC_OWNERS, a, WeakCacheValue { tag: 100 })
    weak_cache_put(WC_OWNERS, b, WeakCacheValue { tag: 200 })

    let got_a: WeakCacheValue? = weak_cache_get(WC_OWNERS, a)
    let got_b: WeakCacheValue? = weak_cache_get(WC_OWNERS, b)
    assert_eq(got_a.unwrap().tag, 100, "the first owner keeps its own value")
    assert_eq(got_b.unwrap().tag, 200, "the second owner keeps its own value")

    weak_cache_drop(WC_OWNERS, a)
    let after_a: WeakCacheValue? = weak_cache_get(WC_OWNERS, a)
    let after_b: WeakCacheValue? = weak_cache_get(WC_OWNERS, b)
    assert(after_a == null, "invalidating one owner clears that owner")
    assert_eq(after_b.unwrap().tag, 200, "invalidating one owner leaves the other alone")
    assert_eq(weak_cache_live(WC_OWNERS), 1, "one entry remains")
}

@test
fn weak_cache_keeps_two_caches_over_one_owner_independent() {
    let rows: Arena<WeakCacheOwner> = arena_new()
    let owner = rows.insert(WeakCacheOwner { tag: 1 })
    weak_cache_put(WC_LEFT, owner, WeakCacheValue { tag: 11 })
    weak_cache_put(WC_RIGHT, owner, WeakCacheValue { tag: 22 })

    let left: WeakCacheValue? = weak_cache_get(WC_LEFT, owner)
    let right: WeakCacheValue? = weak_cache_get(WC_RIGHT, owner)
    assert_eq(left.unwrap().tag, 11, "each named cache answers with its own value")
    assert_eq(right.unwrap().tag, 22, "each named cache answers with its own value")
    assert_eq(weak_cache_builds(WC_LEFT), 1, "each named cache counts its own builds")
    assert_eq(weak_cache_builds(WC_RIGHT), 1, "each named cache counts its own builds")

    weak_cache_drop(WC_LEFT, owner)
    let cleared: WeakCacheValue? = weak_cache_get(WC_LEFT, owner)
    let kept: WeakCacheValue? = weak_cache_get(WC_RIGHT, owner)
    assert(cleared == null, "invalidating one cache clears that cache")
    assert_eq(kept.unwrap().tag, 22, "invalidating one cache leaves the other alone")
}

@test
fn weak_cache_releases_a_retired_owner() {
    let rows: Arena<WeakCacheOwner> = arena_new()
    let kept = rows.insert(WeakCacheOwner { tag: 1 })
    let retired = rows.insert(WeakCacheOwner { tag: 99 })
    weak_cache_put(WC_GC, kept, WeakCacheValue { tag: 1 })
    weak_cache_put(WC_GC, retired, WeakCacheValue { tag: 99 })
    assert_eq(weak_cache_live(WC_GC), 2, "both owners hold an entry")
    let _ = retired.remove()
    assert_eq(weak_cache_live(WC_GC), 1, "retirement evicts the entry without GC")
    let survivor: WeakCacheValue? = weak_cache_get(WC_GC, kept)
    assert_eq(survivor.unwrap().tag, 1, "the live owner keeps its entry")
    assert_eq(weak_cache_builds(WC_GC), 2, "retirement preserves the build count")
    let _ = arena_destroy(rows)
}

struct CacheOwnerPair { left: CacheOwner, right: CacheOwner }

inline(lua) fn weak_cache_collect() = """
    collectgarbage("collect")
    collectgarbage("collect")
"""

fn weak_cache_unretained_record(name: string) {
    weak_cache_put(name, CacheOwner {}, WeakCacheValue { tag: 5 })
}

@test
fn weak_cache_record_copies_start_cold_and_retire_independently() {
    let name = "test.weak_cache.record"
    let owner = CacheOwner {}
    weak_cache_put(name, owner, WeakCacheValue { tag: 7 })
    let pair = deepcopy(CacheOwnerPair { left: owner, right: owner })
    assert(same_ref(pair.left, pair.right), "copies preserve owner aliases")
    let cold: WeakCacheValue? = weak_cache_get(name, pair.left)
    assert(cold == null, "a copied owner starts cold")
    weak_cache_put(name, pair.left, WeakCacheValue { tag: 9 })
    let original: WeakCacheValue = weak_cache_get(name, owner).unwrap()
    assert_eq(original.tag, 7)
    assert_eq(weak_cache_live(name), 2)
    assert(cache_owner_retire(pair.left))
    assert(!cache_owner_retire(pair.right))
    assert_eq(weak_cache_live(name), 1, "retirement evicts while aliases remain reachable")
    assert(cache_owner_retire(owner))
    let retired: WeakCacheValue? = weak_cache_get(name, owner)
    assert(retired == null)
    assert(weak_cache_raises(() => { weak_cache_put(name, owner, WeakCacheValue { tag: 0 }) }))
    let boolean_owner = CacheOwner {}
    weak_cache_put(name, boolean_owner, false)
    let boolean_value: bool? = weak_cache_get(name, boolean_owner)
    assert(boolean_value != null && !boolean_value)
    weak_cache_drop(name, boolean_owner)
    assert_eq(weak_cache_live(name), 0)
}

// Forcing a collection is a LuaJIT facility: a JS run cannot collect an
// object that is still reachable from the current job.
@test(backends = "lua")
fn weak_cache_record_owner_is_collected_when_unretained() {
    let name = "test.weak_cache.record_gc"
    weak_cache_unretained_record(name)
    weak_cache_collect()
    assert_eq(weak_cache_live(name), 0, "an unretained owner is collected")
}

inline(lua) fn weak_cache_raises(f: fn()) -> bool = """
    local ok = pcall(function() __rock_call(f) end)
    return not ok
"""

inline(js) fn weak_cache_raises(f: fn()) -> bool = """
    try { __rock_call(f); return false; } catch (e) { return true; }
"""

struct CWeakCacheOwner { tag: int }
struct CWeakCacheSceneOwner { rows: Arena<CWeakCacheOwner> }

global C_WEAK_CACHE_CLONE_STORAGE: [int] = []

fn c_weak_cache_store(name: string, owner: Entity<CWeakCacheOwner>, n: int) {
    weak_cache_put(name, owner, n)
}

fn c_weak_cache_read(name: string, owner: Entity<CWeakCacheOwner>) -> int? {
    let cached: int? = weak_cache_get(name, owner)
    return cached
}

@test
fn c_weak_cache_owner_handle_put_replace_drop() {
    let rows: Arena<CWeakCacheOwner> = arena_new()
    let entity = rows.insert(CWeakCacheOwner { tag: 1 })
    let owner = entity
    let name = "test.c-weak-cache.replace"
    assert(c_weak_cache_read(name, owner) == null)
    let builds = weak_cache_builds(name)
    c_weak_cache_store(name, owner, 10)
    assert_eq(c_weak_cache_read(name, owner).unwrap(), 10)
    c_weak_cache_store(name, owner, 20)
    assert_eq(c_weak_cache_read(name, owner).unwrap(), 20)
    assert_eq(weak_cache_live(name), 1)
    assert_eq(weak_cache_builds(name), builds + 2)
    weak_cache_drop(name, owner)
    assert(c_weak_cache_read(name, owner) == null)
    assert_eq(weak_cache_live(name), 0)
    weak_cache_drop(name, owner)
    assert_eq(weak_cache_builds(name), builds + 2)
    let _ = arena_destroy(rows)
    let _ = __arena_drain_retired()
}

@test
fn c_weak_cache_distinguishes_owners_and_cache_names() {
    let rows: Arena<CWeakCacheOwner> = arena_new()
    let a = rows.insert(CWeakCacheOwner { tag: 1 })
    let b = rows.insert(CWeakCacheOwner { tag: 1 })
    let left = "test.c-weak-cache.left"
    let right = "test.c-weak-cache.right"
    c_weak_cache_store(left, a, 11)
    c_weak_cache_store(left, b, 22)
    c_weak_cache_store(right, a, 33)
    assert_eq(c_weak_cache_read(left, a).unwrap(), 11)
    assert_eq(c_weak_cache_read(left, b).unwrap(), 22)
    assert_eq(c_weak_cache_read(right, a).unwrap(), 33)
    weak_cache_drop(left, a)
    assert(c_weak_cache_read(left, a) == null)
    assert_eq(c_weak_cache_read(left, b).unwrap(), 22)
    assert_eq(c_weak_cache_read(right, a).unwrap(), 33)
    weak_cache_drop(left, b)
    weak_cache_drop(right, a)
    let _ = arena_destroy(rows)
    let _ = __arena_drain_retired()
}

@test
fn c_weak_cache_clone_misses() {
    let rows: Arena<CWeakCacheOwner> = arena_new()
    let owner = rows.insert(CWeakCacheOwner { tag: 7 })
    let name = "test.c-weak-cache.clone"
    c_weak_cache_store(name, owner, 70)
    let copied = rows.insert(owner.get().unwrap().clone_into(C_WEAK_CACHE_CLONE_STORAGE.storage))
    assert_eq(copied.get().unwrap().tag, owner.get().unwrap().tag)
    assert(c_weak_cache_read(name, copied) == null)
    assert_eq(c_weak_cache_read(name, owner).unwrap(), 70)
    weak_cache_drop(name, owner)
}

@test
fn c_weak_cache_stale_handle_and_slot_reuse() {
    let rows: Arena<CWeakCacheOwner> = arena_new()
    let old = rows.insert(CWeakCacheOwner { tag: 1 })
    let name = "test.c-weak-cache.stale"
    c_weak_cache_store(name, old, 10)
    let _ = old.remove()
    assert_eq(weak_cache_live(name), 0)
    assert(c_weak_cache_read(name, old) == null)
    let fresh = rows.insert(CWeakCacheOwner { tag: 2 })
    assert_eq(fresh._slot, old._slot)
    assert(fresh._generation != old._generation)
    assert(c_weak_cache_read(name, fresh) == null)
    c_weak_cache_store(name, fresh, 20)
    weak_cache_drop(name, old)
    assert_eq(c_weak_cache_read(name, fresh).unwrap(), 20)
    assert_eq(weak_cache_live(name), 1)
    let _ = arena_destroy(rows)
    assert_eq(weak_cache_live(name), 0)
}

@test
fn c_weak_cache_clear_and_destroy_evict_all_names() {
    let rows: Arena<CWeakCacheOwner> = arena_new()
    let a = rows.insert(CWeakCacheOwner { tag: 1 })
    let b = rows.insert(CWeakCacheOwner { tag: 2 })
    let left = "test.c-weak-cache.retire-left"
    let right = "test.c-weak-cache.retire-right"
    c_weak_cache_store(left, a, 11)
    c_weak_cache_store(left, b, 22)
    c_weak_cache_store(right, a, 33)
    rows.clear()
    assert_eq(weak_cache_live(left), 0)
    assert_eq(weak_cache_live(right), 0)
    assert(c_weak_cache_read(left, a) == null)
    let fresh = rows.insert(CWeakCacheOwner { tag: 3 })
    assert(c_weak_cache_read(left, fresh) == null)
    c_weak_cache_store(left, fresh, 44)
    let _ = arena_destroy(rows)
    assert_eq(weak_cache_live(left), 0)
    assert_eq(weak_cache_builds(left), 3)
    let _ = __arena_drain_retired()
}

@test
fn c_weak_cache_scene_close_and_discard_evict() {
    let scene: Scene<CWeakCacheSceneOwner> = scene_create((b) => {
        let rows: Arena<CWeakCacheOwner> = b.arena()
        return CWeakCacheSceneOwner { rows }
    }).unwrap()
    let row = scene.get().unwrap().rows.insert(CWeakCacheOwner { tag: 1 })
    let other: Scene<CWeakCacheOwner> = scene_create((b) => CWeakCacheOwner { tag: 2 }).unwrap()
    let name = "test.c-weak-cache.scenes"
    weak_cache_put(name, scene, 10)
    weak_cache_put(name, other, 20)
    let got: int? = weak_cache_get(name, scene)
    assert_eq(got.unwrap(), 10)
    c_weak_cache_store(name, row, 30)
    assert_eq(weak_cache_live(name), 3)
    weak_cache_drop(name, scene)
    let dropped: int? = weak_cache_get(name, scene)
    assert(dropped == null)
    assert_eq(c_weak_cache_read(name, row).unwrap(), 30)
    assert_eq(weak_cache_live(name), 2)
    weak_cache_put(name, scene, 11)
    weak_cache_drop(name, row)
    let replaced: int? = weak_cache_get(name, scene)
    assert_eq(replaced.unwrap(), 11)
    assert_eq(weak_cache_live(name), 2)
    c_weak_cache_store(name, row, 40)
    let _ = scene_close(scene)
    let closed: int? = weak_cache_get(name, scene)
    assert(closed == null)
    let _ = __scene_drain_closed()
    assert_eq(weak_cache_live(name), 1)
    assert(c_weak_cache_read(name, row) == null)
    let kept: int? = weak_cache_get(name, other)
    assert_eq(kept.unwrap(), 20)
    let _ = scene_discard(other)
    let _ = __scene_drain_closed()
    assert_eq(weak_cache_live(name), 0)
    assert_eq(weak_cache_builds(name), 5)
}

struct TransferOwner { n: int }
struct TransferIndex { cells: Map<int, Map<int, int>> }
struct TransferMemo { numbers: [int], weights: [float], slots: Map<int, int>, scratch: NativeBuffer<int> }
struct TransferPair { left: TransferMemo, right: TransferMemo, revision: int }
value TransferTile { x: int, y: int, id: int }
value TransferTiles { tiles: [TransferTile], revision: int }

fn transfer_index_store(owner: Entity<TransferOwner>, index: TransferIndex) {
    weak_cache_put("transfer.index", owner, index)
}
fn transfer_memo_store(owner: Entity<TransferOwner>, memo: TransferMemo) {
    weak_cache_put("transfer.memo", owner, memo)
}
fn transfer_tiles_store(owner: Entity<TransferOwner>, tiles: [TransferTile]) {
    weak_cache_put("transfer.tiles", owner, TransferTiles { tiles, revision: 7 })
}
fn transfer_memo_new() -> TransferMemo {
    return TransferMemo { numbers: [10], weights: [1.5], slots: map_new(), scratch: native_buffer_int(2) }
}
fn transfer_pair_new(memo: TransferMemo) -> TransferPair {
    return TransferPair { left: memo, right: memo, revision: 1 }
}
fn transfer_value_store(owner: Entity<TransferOwner>, value: TransferTiles) {
    weak_cache_put("transfer.value", owner, value)
}
fn transfer_pair_store(owner: Entity<TransferOwner>, pair: TransferPair) {
    weak_cache_put("transfer.pair", owner, pair)
}
fn transfer_index_rebuild() -> TransferIndex {
    let index = TransferIndex { cells: map_new() }
    let column: Map<int, int> = map_new()
    column.insert(2, 30)
    index.cells.insert(1, column)
    return index
}

@test
fn weak_cache_transfers_borrowed_nested_maps() {
    let rows: Arena<TransferOwner> = arena_new()
    let owner = rows.insert(TransferOwner { n: 1 })
    let index = transfer_index_rebuild()
    transfer_index_store(owner, index)
    let hit: TransferIndex = weak_cache_get("transfer.index", owner).unwrap()
    assert(same_ref(hit, index))
    index.cells.get(1).unwrap().insert(2, 40)
    assert_eq(hit.cells.get(1).unwrap().get(2).unwrap(), 40)
    weak_cache_drop("transfer.index", owner)
    arena_destroy(rows)
}

@test
fn weak_cache_transfers_borrowed_navigation_and_memo_arrays() {
    let builds = weak_cache_builds("transfer.memo")
    let rows: Arena<TransferOwner> = arena_new()
    let owner = rows.insert(TransferOwner { n: 1 })
    let memo = transfer_memo_new()
    transfer_memo_store(owner, memo)
    let hit: TransferMemo = weak_cache_get("transfer.memo", owner).unwrap()
    assert(same_ref(hit, memo))
    memo.numbers.push(20)
    hit.weights.push(2.5)
    hit.slots.insert(3, 4)
    assert_eq(hit.numbers[1], 20)
    assert_eq(memo.weights[1], 2.5)
    assert_eq(memo.slots.get(3).unwrap(), 4)
    hit.scratch[1] = 17
    assert_eq(memo.scratch[1], 17)
    transfer_memo_store(owner, hit)
    assert_eq(weak_cache_builds("transfer.memo"), builds + 2)
    weak_cache_drop("transfer.memo", owner)
    arena_destroy(rows)
}

@test
fn weak_cache_transfers_nested_identity_pair() {
    let rows: Arena<TransferOwner> = arena_new()
    let owner = rows.insert(TransferOwner { n: 1 })
    let memo = transfer_memo_new()
    transfer_memo_store(owner, memo)
    let hit: TransferMemo = weak_cache_get("transfer.memo", owner).unwrap()
    let pair = transfer_pair_new(hit)
    transfer_pair_store(owner, pair)
    weak_cache_drop("transfer.memo", owner)
    let saved: TransferPair = weak_cache_get("transfer.pair", owner).unwrap()
    assert(same_ref(saved, pair))
    assert(same_ref(saved.left.numbers, memo.numbers))
    saved.revision = 2
    assert_eq(pair.revision, 2)
    saved.right.numbers.push(30)
    assert_eq(saved.left.numbers[1], 30)
    weak_cache_drop("transfer.pair", owner)
    arena_destroy(rows)
}

@test
fn weak_cache_transfers_tagged_tile_value_wrapper() {
    let rows: Arena<TransferOwner> = arena_new()
    let owner = rows.insert(TransferOwner { n: 1 })
    let tiles = [TransferTile { x: 2, y: 3, id: 4 }]
    transfer_tiles_store(owner, tiles)
    let hit: TransferTiles = weak_cache_get("transfer.tiles", owner).unwrap()
    assert_eq(hit.revision, 7)
    assert_eq(hit.tiles[0].x, 2)
    assert_eq(hit.tiles[0].y, 3)
    assert_eq(hit.tiles[0].id, 4)
    weak_cache_drop("transfer.tiles", owner)
    arena_destroy(rows)
}

struct TransferMob { n: int }
struct TransferSpatial { cells: Map<int, Map<int, [Entity<TransferMob>]>> }
fn transfer_spatial_new(column: Map<int, [Entity<TransferMob>]>) -> TransferSpatial {
    let spatial = TransferSpatial { cells: map_new() }
    spatial.cells.insert(1, column)
    return spatial
}
fn transfer_spatial_store(owner: Entity<TransferOwner>, spatial: TransferSpatial) {
    weak_cache_put("transfer.spatial", owner, spatial)
}

@test
fn weak_cache_transfers_spatial_entity_buckets() {
    let rows: Arena<TransferOwner> = arena_new()
    let mobs: Arena<TransferMob> = arena_new()
    let owner = rows.insert(TransferOwner { n: 1 })
    let mob = mobs.insert(TransferMob { n: 10 })
    let bucket = [mob]
    let column: Map<int, [Entity<TransferMob>]> = map_new()
    column.insert(2, bucket)
    let spatial = transfer_spatial_new(column)
    transfer_spatial_store(owner, spatial)
    let hit: TransferSpatial = weak_cache_get("transfer.spatial", owner).unwrap()
    assert(same_ref(hit, spatial))
    assert_eq(hit.cells.get(1).unwrap().get(2).unwrap()[0], mob)
    weak_cache_drop("transfer.spatial", owner)
    arena_destroy(mobs)
    arena_destroy(rows)
}

@test
fn weak_cache_transfers_value_copy_and_shared_collection_handle() {
    let rows: Arena<TransferOwner> = arena_new()
    let owner = rows.insert(TransferOwner { n: 1 })
    let tiles = [TransferTile { x: 2, y: 3, id: 4 }]
    let value = TransferTiles { tiles, revision: 7 }
    transfer_value_store(owner, value)
    value = TransferTiles { tiles, revision: 9 }
    assert_eq(value.revision, 9)
    tiles.push(TransferTile { x: 5, y: 6, id: 7 })
    let hit: TransferTiles = weak_cache_get("transfer.value", owner).unwrap()
    assert_eq(hit.revision, 7)
    assert_eq(hit.tiles.len(), 2)
    assert_eq(hit.tiles[1].id, 7)
    weak_cache_drop("transfer.value", owner)
    arena_destroy(rows)
}

@test
fn weak_cache_transfers_later_nested_collection_insertions() {
    let builds = weak_cache_builds("transfer.index")
    let rows: Arena<TransferOwner> = arena_new()
    let owner = rows.insert(TransferOwner { n: 1 })
    let index = transfer_index_rebuild()
    transfer_index_store(owner, index)
    let hit: TransferIndex = weak_cache_get("transfer.index", owner).unwrap()
    let column: Map<int, int> = map_new()
    column.insert(4, 50)
    hit.cells.insert(3, column)
    assert_eq(weak_cache_builds("transfer.index"), builds + 1)
    assert_eq(hit.cells.get(3).unwrap().get(4).unwrap(), 50)
    weak_cache_drop("transfer.index", owner)
    arena_destroy(rows)
}
