// `for` over an Arena: pair destructuring `for (e, v) in a`, single binding
// `for item in a` read through `.0`/`.1` or tuple_first/tuple_second, skipping
// removed slots, reused slots and a cleared arena, `continue` and `break` in the
// body, global arenas, and struct payloads with nested fields.

fn count_items(a: Arena<int>) -> int {
    let count = 0
    for (_, item) in a {
        count = count + 1
    }
    return count
}

@test(output = "count: 0\nvalues: 10,20,30\ncount: 3\nsum: 60")
fn arena_iteration_values() {
    let a: Arena<int> = arena_new()
    print("count: {count_items(a)}")
    a.insert(10)
    a.insert(20)
    a.insert(30)

    let values = vec_new()
    for (_, item) in a {
        vec_push(values, item)
    }
    print("values: {values[0]},{values[1]},{values[2]}")
    print("count: {vec_len(values)}")

    let total = 0
    for (e, v) in a {
        total = total + v
    }
    print("sum: {total}")
}

@test(output = "after remove bar: 2\nafter remove foo: 1\nafter remove baz: 0")
fn arena_iteration_with_removals() {
    let a: Arena<string> = arena_new()
    let e1 = a.insert("foo")
    let e2 = a.insert("bar")
    let e3 = a.insert("baz")

    a.remove(e2)
    let count1 = 0
    for (_, item) in a {
        count1 = count1 + 1
    }
    print("after remove bar: {count1}")

    a.remove(e1)
    let count2 = 0
    for (_, item) in a {
        count2 = count2 + 1
    }
    print("after remove foo: {count2}")

    a.remove(e3)
    let count3 = 0
    for (_, item) in a {
        count3 = count3 + 1
    }
    print("after remove baz: {count3}")
}

@test(output = "initial count: 2\nafter reinsertion count: 2\nbefore clear: 2\nafter clear: 0")
fn arena_iteration_after_reinsertion_and_clear() {
    let a: Arena<int> = arena_new()
    let e1 = a.insert(1)
    a.insert(2)
    print("initial count: {count_items(a)}")

    a.remove(e1)
    a.insert(3)
    print("after reinsertion count: {count_items(a)}")

    let b: Arena<int> = arena_new()
    b.insert(100)
    b.insert(200)
    print("before clear: {count_items(b)}")
    b.clear()
    print("after clear: {count_items(b)}")
}

@test(output = "2 11")
fn test_arena_continue_and_single_binding() {
    let a: Arena<int> = arena_new()
    a.insert(5)
    a.insert(100)
    a.insert(7)
    let kept = 0
    for (e, v) in a {
        if v > 50 {
            continue
        }
        kept = kept + 1
    }

    let b: Arena<int> = arena_new()
    b.insert(4)
    b.insert(7)
    let s = 0
    for item in b {
        s = s + item.1
    }
    print("{kept} {s}")
}

global arena1: Arena<int> = arena_new()
global arena2: Arena<string> = arena_new()
global arena3: Arena<float> = arena_new()

// Global arenas, read through each binding form; `break` leaves after the
// first row.
@test(output = "42\ntrue\nhello\ntrue\n3.14\ntrue")
fn test_global_arena_binding_forms() {
    insert(arena1, 42)
    for item in arena1 {
        let entity = tuple_first(item)
        let value = tuple_second(item)
        print(value)
        print(!is_null(entity))
        break
    }

    insert(arena2, "hello")
    for (entity, value) in arena2 {
        print(value)
        print(!is_null(entity))
        break
    }

    insert(arena3, 3.14)
    for item in arena3 {
        let entity = item.0
        let value = item.1
        print(value)
        print(!is_null(entity))
        break
    }
}

global arena5: Arena<int> = arena_new()

@test
fn test_arena_iteration_equivalence() {
    insert(arena5, 100)
    insert(arena5, 200)
    insert(arena5, 300)

    let entities1: [Entity<int>] = vec_new()
    let values1: [int] = vec_new()
    for item in arena5 {
        vec_push(entities1, tuple_first(item))
        vec_push(values1, tuple_second(item))
    }

    let entities2: [Entity<int>] = vec_new()
    let values2: [int] = vec_new()
    for item in arena5 {
        vec_push(entities2, item.0)
        vec_push(values2, item.1)
    }

    let entities3: [Entity<int>] = vec_new()
    let values3: [int] = vec_new()
    for (entity, value) in arena5 {
        vec_push(entities3, entity)
        vec_push(values3, value)
    }

    assert_eq(vec_len(values1), 3)
    assert(values1 == values2 && values2 == values3, "values agree across binding forms")
    assert(entities1 == entities2 && entities2 == entities3, "entities agree across binding forms")
}

struct Prefab {
    name: string,
    sprite: SpriteInfo,
}

struct SpriteInfo {
    source: string,
}

@test
fn test_arena_iteration_like_game() {
    let arena: Arena<Prefab> = arena_new()
    arena.insert(Prefab {
        name: "test_prefab",
        sprite: SpriteInfo { source: "test.png" }
    })

    let count = 0
    for (e, p) in arena {
        assert(e._slot >= 0, "Entity should have valid index")
        assert_eq(p.name, "test_prefab", "Prefab name should match")
        assert_eq(p.sprite.source, "test.png", "Sprite source should match")
        count += 1
    }

    assert_eq(count, 1, "Should have iterated over 1 item")
}
