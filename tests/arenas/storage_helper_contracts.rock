// The four storage helpers whose receivers used to be spelled `any`
// `__vec_data_get`/`_set`/`_unset` and
// `table_unset`. An `any` receiver claims no representation, so 2.4 could not
// protect them -- with a column route removed the call fell through to the
// boxed body and died at runtime on `_data`. Typed, the same mutation rejects
// at compile time, which is the acceptance contract's "a missing sibling
// rejects as a missing contract, never a fallback to the opaque body".
//
// These are the POPULATIONS that must keep working either way: every helper at
// a column element and at a boxed one. Only the pair is evidence -- a
// column-only test would pass just as well if the boxed path had broken.

value SH { a: int, b: int }
value SHBoxed { s: string }

@test fn vec_helpers_at_a_column_element() {
    let xs: [SH] = []
    xs.push(SH { a: 1, b: 2 })
    xs.push(SH { a: 3, b: 4 })
    assert_eq(xs.get(0).unwrap().a, 1)
    xs[1] = SH { a: 9, b: 9 }
    assert_eq(xs[1].a, 9)
    assert_eq(xs.len, 2)
    let popped = xs.pop()
    assert(popped != null)
    assert_eq(xs.len, 1)
}

@test fn vec_helpers_at_a_boxed_element() {
    let xs: [SHBoxed] = []
    xs.push(SHBoxed { s: "a" })
    xs.push(SHBoxed { s: "b" })
    assert_eq(xs.get(0).unwrap().s, "a")
    xs[1] = SHBoxed { s: "z" }
    assert_eq(xs[1].s, "z")
    let popped = xs.pop()
    assert(popped != null)
    assert_eq(xs.len, 1)
}

@test fn vec_helpers_at_a_scalar_element() {
    let ns: [int] = []
    ns.push(5)
    ns.push(6)
    assert_eq(ns.get(1).unwrap(), 6)
    ns[0] = 7
    assert_eq(ns[0], 7)
    assert_eq(ns.pop().unwrap(), 6)
}

@test fn table_unset_at_a_column_value() {
    let m: Map<string, SH> = map_new()
    m["a"] = SH { a: 1, b: 2 }
    m["b"] = SH { a: 3, b: 4 }
    m.remove("a")
    assert(m.get("a") == null)
    assert_eq(m["b"].a, 3)
    m.clear()
    assert_eq(m.len(), 0)
}

@test fn table_unset_at_a_boxed_value() {
    let m: Map<string, SHBoxed> = map_new()
    m["a"] = SHBoxed { s: "x" }
    m["b"] = SHBoxed { s: "y" }
    m.remove("a")
    assert(m.get("a") == null)
    assert_eq(m["b"].s, "y")
    m.clear()
    assert_eq(m.len(), 0)
}
