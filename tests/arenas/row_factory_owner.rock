value FactoryRecord { values: [int] }
struct FactoryRoot { records: [FactoryRecord] = [] }

fn factory_root_new() -> FactoryRoot {
    let arena: Arena<FactoryRoot> = arena_new()
    return arena.insert(FactoryRoot {}).get().unwrap()
}

fn factory_root_forward() -> FactoryRoot {
    return factory_root_new()
}

@test(output = "7")
fn helper_local_arena_row_keeps_its_allocations() {
    let root = factory_root_forward()
    root.records.push(FactoryRecord { values: [7] })
    print(root.records[0].values[0])
}
