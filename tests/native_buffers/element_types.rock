// Typed native buffers on every element type: length, indexed and direct
// stores, `get` hits and misses, and integer stores that wrap to the
// element width.

fn nb_len_float() -> int { return native_buffer_float(3).len }
fn nb_len_int() -> int { return native_buffer_int(5).len }
fn nb_len_u8() -> int { return native_buffer_u8(7).len }
fn nb_len_i8() -> int { return native_buffer_i8(2).len }
fn nb_len_u16() -> int { return native_buffer_u16(4).len }
fn nb_len_i16() -> int { return native_buffer_i16(6).len }
fn nb_len_u32() -> int { return native_buffer_u32(8).len }
fn nb_sugar_float() -> float {
    let b = native_buffer_float(2)
    b[0] = 1.5
    b[1] = 2.5
    return b[0] + b[1]
}
fn nb_sugar_int() -> int {
    let b = native_buffer_int(2)
    b[0] = 10
    b[1] = 32
    return b[0] + b[1]
}
fn nb_direct_float() -> float { let b = native_buffer_float(1); nb_set(b, 0, 2.5); return nb_get(b, 0) }
fn nb_direct_int() -> int { let b = native_buffer_int(1); nb_set(b, 0, 42); return nb_get(b, 0) }
fn nb_direct_u8() -> int { let b = native_buffer_u8(1); nb_set(b, 0, 300); return nb_get(b, 0) }
fn nb_direct_i8() -> int { let b = native_buffer_i8(1); nb_set(b, 0, 129); return nb_get(b, 0) }
fn nb_direct_u16() -> int { let b = native_buffer_u16(1); nb_set(b, 0, 60000); return nb_get(b, 0) }
fn nb_direct_i16() -> int { let b = native_buffer_i16(1); nb_set(b, 0, -300); return nb_get(b, 0) }
fn nb_direct_u32() -> int { let b = native_buffer_u32(1); nb_set(b, 0, 4000000000); return nb_get(b, 0) }
fn nb_get_hit_float() -> float? { let b = native_buffer_float(2); b[1] = 4.5; return b.get(b.len - 1) }
fn nb_get_hit_index0() -> float? { let b = native_buffer_float(2); b[0] = 3.25; return b.get(0) }
fn nb_get_miss_low_float() -> float? { let b = native_buffer_float(1); return b.get(-1) }
fn nb_get_miss_high_float() -> float? { let b = native_buffer_float(1); return b.get(b.len) }
fn nb_get_hit_int() -> int? { let b = native_buffer_int(3); b[2] = 77; return b.get(2) }
fn nb_get_miss_int() -> int? { let b = native_buffer_int(3); return b.get(3) }
fn nb_get_hit_u8() -> int? { let b = native_buffer_u8(2); b[1] = 12; return b.get(1) }
fn nb_get_miss_u8() -> int? { let b = native_buffer_u8(2); return b.get(2) }
fn nb_get_hit_i8() -> int? { let b = native_buffer_i8(2); b[1] = 13; return b.get(1) }
fn nb_get_miss_i8() -> int? { let b = native_buffer_i8(2); return b.get(-1) }
fn nb_get_hit_u16() -> int? { let b = native_buffer_u16(2); b[1] = 14; return b.get(1) }
fn nb_get_miss_u16() -> int? { let b = native_buffer_u16(2); return b.get(2) }
fn nb_get_hit_i16() -> int? { let b = native_buffer_i16(2); b[1] = 15; return b.get(1) }
fn nb_get_miss_i16() -> int? { let b = native_buffer_i16(2); return b.get(-1) }
fn nb_get_hit_u32() -> int? { let b = native_buffer_u32(2); b[1] = 16; return b.get(1) }
fn nb_get_miss_u32() -> int? { let b = native_buffer_u32(2); return b.get(2) }
fn nb_wrap_u8_256() -> int { let b = native_buffer_u8(1); b[0] = 256; return b[0] }
fn nb_wrap_u8_300() -> int { let b = native_buffer_u8(1); b[0] = 300; return b[0] }
fn nb_wrap_u8_neg1() -> int { let b = native_buffer_u8(1); b[0] = -1; return b[0] }
fn nb_wrap_i8_128() -> int { let b = native_buffer_i8(1); b[0] = 128; return b[0] }
fn nb_wrap_i8_neg129() -> int { let b = native_buffer_i8(1); b[0] = -129; return b[0] }
fn nb_wrap_u16_65536() -> int { let b = native_buffer_u16(1); b[0] = 65536; return b[0] }
fn nb_wrap_u16_neg1() -> int { let b = native_buffer_u16(1); b[0] = -1; return b[0] }
fn nb_wrap_i16_32768() -> int { let b = native_buffer_i16(1); b[0] = 32768; return b[0] }
fn nb_wrap_u32_2p32() -> int { let b = native_buffer_u32(1); b[0] = 4294967296; return b[0] }
fn nb_wrap_u32_2p32p5() -> int { let b = native_buffer_u32(1); b[0] = 4294967301; return b[0] }
fn nb_wrap_u32_neg1() -> int { let b = native_buffer_u32(1); b[0] = -1; return b[0] }
fn nb_wrap_int_2p31() -> int { let b = native_buffer_int(1); b[0] = 2147483648; return b[0] }
fn nb_wrap_int_2p31p5() -> int { let b = native_buffer_int(1); b[0] = 2147483653; return b[0] }
fn nb_wrap_int_neg() -> int { let b = native_buffer_int(1); b[0] = -2147483654; return b[0] }

@test
fn native_buffer_lengths() {
    assert_eq(nb_len_float(), 3, "nb_len_float")
    assert_eq(nb_len_int(), 5, "nb_len_int")
    assert_eq(nb_len_u8(), 7, "nb_len_u8")
    assert_eq(nb_len_i8(), 2, "nb_len_i8")
    assert_eq(nb_len_u16(), 4, "nb_len_u16")
    assert_eq(nb_len_i16(), 6, "nb_len_i16")
    assert_eq(nb_len_u32(), 8, "nb_len_u32")
}

@test
fn indexed_stores_and_reads() {
    assert_eq(nb_sugar_float(), 4, "nb_sugar_float")
    assert_eq(nb_sugar_int(), 42, "nb_sugar_int")
}

@test
fn direct_stores_wrap_to_the_element_width() {
    assert_eq(nb_direct_float(), 2.5, "nb_direct_float")
    assert_eq(nb_direct_int(), 42, "nb_direct_int")
    assert_eq(nb_direct_u8(), 44, "nb_direct_u8")
    assert_eq(nb_direct_i8(), -127, "nb_direct_i8")
    assert_eq(nb_direct_u16(), 60000, "nb_direct_u16")
    assert_eq(nb_direct_i16(), -300, "nb_direct_i16")
    assert_eq(nb_direct_u32(), 4000000000, "nb_direct_u32")
}

@test
fn get_returns_null_outside_the_buffer() {
    assert_eq(nb_get_hit_float(), 4.5, "nb_get_hit_float")
    assert_eq(nb_get_hit_index0(), 3.25, "nb_get_hit_index0")
    assert(nb_get_miss_low_float() == null, "nb_get_miss_low_float")
    assert(nb_get_miss_high_float() == null, "nb_get_miss_high_float")
    assert_eq(nb_get_hit_int(), 77, "nb_get_hit_int")
    assert(nb_get_miss_int() == null, "nb_get_miss_int")
    assert_eq(nb_get_hit_u8(), 12, "nb_get_hit_u8")
    assert(nb_get_miss_u8() == null, "nb_get_miss_u8")
    assert_eq(nb_get_hit_i8(), 13, "nb_get_hit_i8")
    assert(nb_get_miss_i8() == null, "nb_get_miss_i8")
    assert_eq(nb_get_hit_u16(), 14, "nb_get_hit_u16")
    assert(nb_get_miss_u16() == null, "nb_get_miss_u16")
    assert_eq(nb_get_hit_i16(), 15, "nb_get_hit_i16")
    assert(nb_get_miss_i16() == null, "nb_get_miss_i16")
    assert_eq(nb_get_hit_u32(), 16, "nb_get_hit_u32")
    assert(nb_get_miss_u32() == null, "nb_get_miss_u32")
}

@test
fn indexed_stores_wrap_to_the_element_width() {
    assert_eq(nb_wrap_u8_256(), 0, "nb_wrap_u8_256")
    assert_eq(nb_wrap_u8_300(), 44, "nb_wrap_u8_300")
    assert_eq(nb_wrap_u8_neg1(), 255, "nb_wrap_u8_neg1")
    assert_eq(nb_wrap_i8_128(), -128, "nb_wrap_i8_128")
    assert_eq(nb_wrap_i8_neg129(), 127, "nb_wrap_i8_neg129")
    assert_eq(nb_wrap_u16_65536(), 0, "nb_wrap_u16_65536")
    assert_eq(nb_wrap_u16_neg1(), 65535, "nb_wrap_u16_neg1")
    assert_eq(nb_wrap_i16_32768(), -32768, "nb_wrap_i16_32768")
    assert_eq(nb_wrap_u32_2p32(), 0, "nb_wrap_u32_2p32")
    assert_eq(nb_wrap_u32_2p32p5(), 5, "nb_wrap_u32_2p32p5")
    assert_eq(nb_wrap_u32_neg1(), 4294967295, "nb_wrap_u32_neg1")
    assert_eq(nb_wrap_int_2p31(), -2147483648, "nb_wrap_int_2p31")
    assert_eq(nb_wrap_int_2p31p5(), -2147483643, "nb_wrap_int_2p31p5")
    assert_eq(nb_wrap_int_neg(), 2147483642, "nb_wrap_int_neg")
}
