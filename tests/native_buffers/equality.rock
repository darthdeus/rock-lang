// Scalar pointer indexing returns a Lua number, but equality still compares
// the underlying element bytes and must respect the element width.

@test
fn int_native_buffer_equality() {
    let a = native_buffer_int(2)
    let b = native_buffer_int(2)
    nb_set(a, 0, 7)
    nb_set(a, 1, -9)
    nb_set(b, 0, 7)
    nb_set(b, 1, -9)
    assert_eq(a == b, true)
    nb_set(b, 1, -8)
    assert_eq(a == b, false)
}

@test
fn float_native_buffer_equality() {
    let a = native_buffer_float(2)
    let b = native_buffer_float(2)
    nb_set(a, 0, 1.5)
    nb_set(a, 1, -2.25)
    nb_set(b, 0, 1.5)
    nb_set(b, 1, -2.25)
    assert_eq(a == b, true)
    nb_set(b, 1, -2.5)
    assert_eq(a == b, false)
}

@test
fn scalar_flat_vec_equality() {
    let a: FlatVec<float> = flat_vec_new(2)
    let b: FlatVec<float> = flat_vec_new(8)
    a.push(1.5)
    b.push(1.5)
    assert_eq(a == b, true)
    b.push(3.0)
    assert_eq(a == b, false)
}

@test
fn empty_scalar_native_buffers_are_equal() {
    assert_eq(native_buffer_int(0) == native_buffer_int(0), true)
    let a: FlatVec<int> = flat_vec_new(1)
    let b: FlatVec<int> = flat_vec_new(4)
    assert_eq(a == b, true)
}

value Empty {}
value Mixed { flag: bool, tag: int, x: f32, y: float }

@test
fn zero_sized_elements_are_equal() {
    let a: NativeBuffer<Empty> = native_buffer_alloc(2)
    let b: NativeBuffer<Empty> = native_buffer_alloc(2)
    assert_eq(a == b, true)
}

// A mixed-width element compares every leaf at its own width: the last digit
// of `y` only survives as a double.
@test
fn mixed_element_native_buffer_equality() {
    let a: NativeBuffer<Mixed> = native_buffer_alloc(2)
    let b: NativeBuffer<Mixed> = native_buffer_alloc(2)
    a[1] = Mixed { flag: true, tag: -7, x: 1.5, y: 1.0000000001 }
    b[1] = Mixed { flag: true, tag: -7, x: 1.5, y: 1.0000000001 }
    assert_eq(a == b, true)
    b[1] = Mixed { flag: true, tag: -7, x: 1.5, y: 1.0000000002 }
    assert_eq(a == b, false)
    let empty: NativeBuffer<Mixed> = native_buffer_alloc(0)
    assert_eq(a == empty, false)
}

@test
fn mixed_element_flat_vec_equality() {
    let a: FlatVec<Mixed> = flat_vec_new(1)
    let b: FlatVec<Mixed> = flat_vec_new(8)
    a.push(Mixed { flag: true, tag: -7, x: 1.5, y: 1.0000000001 })
    b.push(Mixed { flag: true, tag: -7, x: 1.5, y: 1.0000000001 })
    assert_eq(a == b, true)
    b[0] = Mixed { flag: false, tag: -7, x: 1.5, y: 1.0000000001 }
    assert_eq(a == b, false)
}
