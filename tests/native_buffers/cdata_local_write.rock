// Roadmap §2.4 Issue 2 regression: writing a value-struct local to a
// NativeBuffer slot should NOT field-disassemble+reassemble the cdata.
// Pre-fix the codegen emitted
//   __nb_checked_set(buf, i, __rock_create_c_struct_V2(v.x, v.y))
// for `buf[i] = v` where v is already a cdata Vertex. Post-fix it emits
//   __nb_checked_set(buf, i, v)
// directly — one cdata struct copy, no extra allocation.

value V2 {
    x: float,
    y: float,
}

@nomangle inline(lua) fn __nb_alloc_V2(n: int) -> Ptr<V2> = 'return ffi.new("V2[?]", n)'

fn native_buffer_v2(n: int) -> NativeBuffer<V2> {
    return NativeBuffer { ptr: __nb_alloc_V2(n), len: n }
}

fn make_v2(a: float, b: float) -> V2 {
    return V2 { x: a, y: b }
}

@test(output = "3\n7\n3\n7")
fn test_native_buffer_cdata_local_write() {
    let buf = native_buffer_v2(2)
    let v = make_v2(3.0, 7.0)

    // Both writes should emit the bare cdata local without re-packing.
    buf[0] = v
    buf[1] = v

    let a = buf[0]
    print("{a.x.floor()}")
    print("{a.y.floor()}")

    let b = buf[1]
    print("{b.x.floor()}")
    print("{b.y.floor()}")
}
