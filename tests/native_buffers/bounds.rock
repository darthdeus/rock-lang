// Bounds checks on NativeBuffer<T>[i]: out-of-bounds reads/writes error via
// the __nb_checked_get / __nb_checked_set helpers, unconditionally.

@intrinsic @nomangle inline(lua) fn try_call(f: fn()) -> bool = """
    local ok, err = pcall(f)
    return not ok
"""

@test
fn in_bounds_works() {
    let buf = native_buffer_float(3)
    buf[0] = 1.5
    buf[1] = 2.5
    buf[2] = 3.5
    assert(buf[0] == 1.5)
    assert(buf[1] == 2.5)
    assert(buf[2] == 3.5)
}

@test
fn out_of_bounds_access_errors() {
    let buf = native_buffer_float(3)
    buf[0] = 10.0
    assert(try_call(() => { let _x = buf[5] }), "read past the end")
    assert(try_call(() => { buf[10] = 99.0 }), "write past the end")

    let ints = native_buffer_int(5)
    assert(try_call(() => { let _x = ints[-1] }), "negative read")

    // len-1 is valid; len is out of bounds (half-open).
    let edge = native_buffer_int(4)
    edge[3] = 42
    assert(edge[3] == 42)
    assert(try_call(() => { let _x = edge[4] }), "read at len")
}
