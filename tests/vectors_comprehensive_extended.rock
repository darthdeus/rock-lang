// Extended vector tests - migrated from rock/tests/vec_tests.rs (tests 15-38)
// Tests advanced vector operations, iteration patterns, and edge cases
// Note: Now using stdlib unwrap() function

// Test that was marked as ignored due to infinite loop
@test(output = "v[0]: hi\nv[1]: bye\npopped: bye\nlen after pop: 1\nremaining v[0]: hi\nafter push new: new\nfinal len: 2")
fn vec_comprehensive_operations() {
    let v = vec_new()
    vec_push(v, "hi")
    vec_push(v, "bye")

    // Test direct access
    print("v[0]: {v[0]}")
    print("v[1]: {v[1]}")

    // Test pop
    let popped = pop(v)
    print("popped: {unwrap(popped)}")
    print("len after pop: {vec_len(v)}")

    // Test remaining element access
    print("remaining v[0]: {v[0]}")

    // Test push after pop
    vec_push(v, "new")
    print("after push new: {v[1]}")
    print("final len: {vec_len(v)}")
}

@test(output = "empty len: 0\nis empty: true\npop from empty: nil\nafter push len: 1\nafter clear len: 0\nafter clear is empty: true")
fn vec_empty_operations() {
    let v = vec_new()
    print("empty len: {vec_len(v)}")
    print("is empty: {is_empty(v)}")

    // Pop from empty should return null
    let popped = pop(v)
    print("pop from empty: {popped}")

    // Add element then clear
    vec_push(v, "test")
    print("after push len: {vec_len(v)}")
    clear(v)
    print("after clear len: {vec_len(v)}")
    print("after clear is empty: {is_empty(v)}")
}

@test(output = "v type: table\nv._data type: table\nv.len: 0\nafter push - v._data type: table\nafter push - v.len: 1\nv is already array-like...\nv type: table")
fn debug_vec_structure() {
    let v = vec_new()
    print("v type: {typeof(v)}")
    print("v._data type: {typeof(v._data)}")
    print("v.len: {v.len}")

    vec_push(v, "test")
    print("after push - v._data type: {typeof(v._data)}")
    print("after push - v.len: {v.len}")

    print("v is already array-like...")
    print("v type: {typeof(v)}")
}

@test(output = "60 60 3")
fn vec_iter_basic() {
    let v = [10, 20, 30]
    let sum = 0
    let sum2 = 0
    let isum = 0

    for item in v {
        sum = sum + item
    }

    for (i, item) in enumerate(v) {
        isum = isum + i
        sum2 = sum2 + item
    }

    assert_eq(sum, 60)
    assert_eq(sum2, 60)
    assert_eq(isum, 3) // 0 + 1 + 2

    print("{sum} {sum2} {isum}")
}

@test(output = "0:a\n1:b\n2:c")
fn vec_enumerate_basic() {
    let v = ["a", "b", "c"]

    for (i, item) in enumerate(v) {
