@test(output = "3\n1\n2\n3")
fn vec_structure_and_operations() {
    let vec = vec_new()
    vec_push(vec, 1)
    vec_push(vec, 2)
    vec_push(vec, 3)

    // Test that the vector has correct length
    print(vec_len(vec))

    // Test that individual elements are correct via vec_get
    print(unwrap(vec_get(vec, 0)))
    print(unwrap(vec_get(vec, 1)))
    print(unwrap(vec_get(vec, 2)))
}

@test(output = "100\n100\n4")
fn vec_modern_iteration_patterns() {
    let numbers = [10, 20, 30, 40]

    // Test pattern
    let sum_iter = 0
    for num in numbers {
        sum_iter = sum_iter + num
    }
    print(sum_iter)

    // Test enumerate() pattern
    let sum_enum = 0
    let index_count = 0
    for (i, num) in enumerate(numbers) {
        sum_enum = sum_enum + num
        index_count = index_count + 1
    }
    print(sum_enum)
    print(index_count)
}

@test(output = "3\n10\n20\n30\n30\n2")
fn vec_core_operations_part1() {
    let v = vec_new()

    // Test push and length
    vec_push(v, 10)
    vec_push(v, 20)
    vec_push(v, 30)
    print(vec_len(v))

    // Test get
    print(unwrap(vec_get(v, 0)))
    print(unwrap(vec_get(v, 1)))
    print(unwrap(vec_get(v, 2)))

    // Test pop
    print(unwrap(pop(v)))
    print(vec_len(v))
}

