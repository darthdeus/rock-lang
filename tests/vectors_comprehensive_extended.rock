@test(output = "True values: 2\nSum of even-indexed items: 9")
fn vec_iterate_different_types() {
    let bools = [true, false, true]
    let bool_count = 0

    for b in bools {
        if b {
            bool_count = bool_count + 1
        }
    }

    print("True values: {bool_count}")

    let nums = [1, 2, 3, 4, 5]
    let sum = 0
    for (idx, num) in enumerate(nums) {
        if idx % 2 == 0 {  // Even indices
            sum = sum + num
        }
    }

    print("Sum of even-indexed items: {sum}")
}

fn get_direct_return() -> [string] {
    return ["a", "b", "c"]
}

fn get_with_variable() -> [string] {
    let arr = ["a", "b", "c"]
    return arr
}

@test(output = "Direct: a,b,c\nVariable: a,b,c")
fn vec_direct_array_literal_return() {
    let direct = get_direct_return()
    print("Direct: {direct[0]},{direct[1]},{direct[2]}")

    let variable = get_with_variable()
    print("Variable: {variable[0]},{variable[1]},{variable[2]}")
}

@test(output = "index_sum: 3\nvalue_sum: 60\n3\n60")
fn vec_tuple_iteration_now_works() {
    let arr = [10, 20, 30]
    let index_sum = 0
    let value_sum = 0

    for (i, x) in enumerate(arr) {
        index_sum = index_sum + i
        value_sum = value_sum + x
    }

    // Indices should be 0, 1, 2 (0-based)
    print("index_sum: {index_sum}")
    print("value_sum: {value_sum}")
    print(index_sum)
    print(value_sum)
}

