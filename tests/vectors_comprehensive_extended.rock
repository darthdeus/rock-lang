}

@test(output = "60\n60\n3")
fn vec_array_tuple_tests_part2() {
    let vec1 = [10, 20, 30]
    let vec2 = [10, 20, 30]

    // Single binding iteration
    let sum1 = 0
    for x in vec1 {
        sum1 = sum1 + x
    }

    // Tuple destructuring iteration
    let sum2 = 0
    let idx_sum = 0
    for (i, x) in enumerate(vec2) {
        sum2 = sum2 + x
        idx_sum = idx_sum + i
    }

    print(sum1)
    print(sum2)
    print(idx_sum)
}

@test(output = "=== Single binding ===\n1:one\n2:two\n3:three\n=== Tuple destructuring ===\nidx=0, num=1, word=one\nidx=1, num=2, word=two\nidx=2, num=3, word=three\n=== Explicit  ===\n1:one\n2:two\n3:three\n=== Explicit enumerate() ===\nidx=0, num=1, word=one\nidx=1, num=2, word=two\nidx=2, num=3, word=three\n=== Direct tuple destructuring ===\nnum=1, word=\"one\"\nnum=2, word=\"two\"\nnum=3, word=\"three\"")
fn vec_of_tuples_comprehensive() {
    // Create a Vec of tuples
    let pairs = [(1, "one"), (2, "two"), (3, "three")]

    // Test 1: Single binding iteration - should give us the tuples
    print("=== Single binding ===")
    for pair in pairs {
        let num = tuple_first(pair)
        let word = tuple_second(pair)
        print("{num}:{word}")
    }

    // Test 2: Enumeration - should give (index, tuple) with explicit enumerate()
    print("=== Tuple destructuring ===")
    for (i, pair) in enumerate(pairs) {
        let num = tuple_first(pair)
        let word = tuple_second(pair)
        print("idx={i}, num={num}, word={word}")
    }

    // Test 3: Using explicitly
    print("=== Explicit  ===")
    for pair in pairs {
        let num = tuple_first(pair)
        let word = tuple_second(pair)
        print("{num}:{word}")
    }

    // Test 4: Using enumerate() explicitly
    print("=== Explicit enumerate() ===")
    for (i, pair) in enumerate(pairs) {
        let num = tuple_first(pair)
        let word = tuple_second(pair)
        print("idx={i}, num={num}, word={word}")
    }

    // Test 5: Direct tuple destructuring (new behavior)
    print("=== Direct tuple destructuring ===")
    for (num, word) in pairs {
        print("num={num}, word=\"{word}\"")
    }
}

@test(output = "=== Nested tuples - single binding ===\n(1,2),(3,4)\n(5,6),(7,8)\n=== Nested tuples - tuple destructuring ===\nidx=0: left=(1,2)\nidx=1: left=(5,6)\n=== Single element ===\ni=0, elem=(42,answer)\nEmpty vec iteration count: 0")
fn vec_of_tuples_edge_cases() {
    // Test with nested tuples
    let nested = [((1, 2), (3, 4)), ((5, 6), (7, 8))]

    print("=== Nested tuples - single binding ===")
    for item in nested {
        let left = tuple_first(item)
        let right = tuple_second(item)
        let a = tuple_first(left)
        let b = tuple_second(left)
        let c = tuple_first(right)
        let d = tuple_second(right)
        print("({a},{b}),({c},{d})")
    }

    print("=== Nested tuples - tuple destructuring ===")
    for (idx, item) in enumerate(nested) {
        let left = tuple_first(item)
        let right = tuple_second(item)
        print("idx={idx}: left=({tuple_first(left)},{tuple_second(left)})")
    }

    // Test with single element tuple vec
    let single = [(42, "answer")]
    print("=== Single element ===")
    for (i, elem) in enumerate(single) {
        print("i={i}, elem=({tuple_first(elem)},{tuple_second(elem)})")
    }

    // Test empty vec of tuples
    let empty: [(int, string)] = []
    let count = 0
    for _ in empty {
        count = count + 1
    }
    print("Empty vec iteration count: {count}")
}