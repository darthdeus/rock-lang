}

@test(output = "index 0 = 100\nindex 1 = 200\nindex 2 = 300")
fn vec_enumerate_with_modifications() {
    let v = [100, 200]
    vec_push(v, 300)

    for (i, item) in enumerate(v) {
        print("index {i} = {item}")
    }
}

@test(output = "Using :\n  5\n  10\n  15\nUsing enumerate():\n  [0] = 5\n  [1] = 10\n  [2] = 15")
fn vec_iter_vs_enumerate() {
    let numbers = [5, 10, 15]

    print("Using :")
    for num in numbers {
        print("  {num}")
    }

    print("Using enumerate():")
    for (i, num) in enumerate(numbers) {
        print("  [{i}] = {num}")
    }
}

