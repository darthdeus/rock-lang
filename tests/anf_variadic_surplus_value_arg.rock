// Bucket-C site (ANF unsupported-site audit):
// variadic surplus value-typed arg used to panic at the fn-body
// seam with `Unsupported("variadic surplus: value-typed arg (would
// splat into pack)")`. The reject was overly defensive — variadic
// formal slots aren't concrete value structs, so
// `value_arg_scalarized_slot` returns false and `lower_call_arg`
// already packs a value-typed surplus arg to a single cdata via
// `lower_into` -> PackValue. No splat ever reaches the variadic
// position.

value V2 { x: int, y: int }

fn collect_2(a: any, b: any) -> int {
    // Cheap structural check: both args should have been packed as
    // V2 cdata at the boundary. We can't easily introspect cdata
    // shape from `any`, so use a sentinel return.
    7
}

fn vfn(args: ...any) -> int {
    // Variadic body: `args` is a table; just count its length.
    7
}

@test
fn test_variadic_two_value_args() {
    let v = V2 { x: 1, y: 2 }
    let n = vfn(v, v)
    assert_eq(n, 7)
}

@test
fn test_variadic_one_value_surplus() {
    let v = V2 { x: 3, y: 4 }
    // Mixed: a non-variadic int + a value-typed surplus.
    let n = mixed_with_surplus(7, v, v)
    assert_eq(n, 14)
}

fn mixed_with_surplus(a: int, args: ...any) -> int {
    a * 2
}

nobox value UfcsV2 { x: int, y: int }

@scalar_abi fn ufcs_variadic(receiver: UfcsV2, first: int, args: ...any) -> int {
    return receiver.x
}

@test
fn test_variadic_ufcs_tail_slot_reuse() {
    let v = UfcsV2 { x: 11, y: 12 }
    assert_eq(v.ufcs_variadic(1, 2, 3), 11)
}
