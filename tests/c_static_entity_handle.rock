struct StaticEntityPayload { n: int }
global STATIC_ENTITY_ROWS: Arena<StaticEntityPayload> = arena_new()

fn static_owned_entity() -> Entity<StaticEntityPayload> {
    static handle = STATIC_ENTITY_ROWS.insert(StaticEntityPayload { n: 7 })
    return handle
}

@test
fn c_static_entity_handle_preserves_owned_identity() {
    let earlier = static_owned_entity()
    let later = static_owned_entity()
    assert(earlier == later)
    earlier.get().unwrap().n = 23
    assert_eq(later.get().unwrap().n, 23)
    let _ = earlier.remove()
    assert(static_owned_entity().get() == null)
}
