// `deco init` registration: decorated functions are collected at init into a
// registry, undecorated ones are not, and `target.name` captures the decorated
// function name whatever its parameter list.

global PARAM_NAMES: [string] = []

deco init capture_params {
    vec_push(PARAM_NAMES, target.name)
}

@capture_params
fn no_params() {
    print("no params")
}

@capture_params
fn one_param(x: int) {
    print("x = {x}")
}

@capture_params
fn two_params(name: string, age: int) {
    print("{name} is {age}")
}

@capture_params
fn many_params(a: int, b: int, c: int, d: int) {
    print("{a} {b} {c} {d}")
}

fn not_registered() {
    print("not registered")
}

@test
fn test_function_names_captured() {
    // Init decorators run at module load time, before any test.
    assert_eq(PARAM_NAMES.len, 4, "only the four decorated functions register")
    assert(PARAM_NAMES.any(_ == "no_params"), "no_params should be registered")
    assert(PARAM_NAMES.any(_ == "one_param"), "one_param should be registered")
    assert(PARAM_NAMES.any(_ == "two_params"), "two_params should be registered")
    assert(PARAM_NAMES.any(_ == "many_params"), "many_params should be registered")
}
