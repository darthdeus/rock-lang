// Compiler expanders over a value's layout, replaced at the call site:
// `@struct_expand` yields (field_name, Variant(u.field)) pairs in declaration
// order with the variant chosen by payload type (boxed and cdata enums),
// `@vertex_expand` yields a FlatVec element's stride and per-attribute
// component counts, `pack_uniform_block` writes std140 offsets, and
// `uniform_values` yields one canonical leaf per uniform scalar with a
// layout fingerprint. The struct_expand enums are local, not the engine's
// UniformValue.
//
// The vertex layouts differ on purpose: an expander hardcoded to its one known
// consumer's layout must fail here. `Vec2f`/`Vec3f`/`Vec4f` are the stdlib
// ones because `attr_kind` recognizes vector attributes by nominal name.

value V2 { x: float, y: float }

// Boxed enum (the Vv(V2) payload disqualifies the cdata representation), so a
// value here is the `{__variant}` box -- the UniformValue shape.
enum U {
    F(float),
    I(int),
    Vv(V2),
}

value AU { alpha: float, count: int, pos: V2 }
value BU { flag: int, f2: float }
value DU { a: float = 7.0, b: int = 3 }

@struct_expand inline(lua) fn upairs<T>(u: T) -> [(string, U)] = """
    error("upairs must be compiler-expanded")
"""

fn describe(p: (string, U)) -> string {
    let v = match p.1 {
        U::F(f) => "F:{f.floor()}",
        U::I(i) => "I:{i}",
        U::Vv(vv) => "V:{vv.x.floor()},{vv.y.floor()}",
    }
    return "{p.0}={v}"
}

// Declaration-order pairs, a nested-value (V2) field, an int field, and two
// instantiations of the generic at different structs.
@test(output = "alpha=F:2\ncount=I:4\npos=V:2,3\nflag=I:9\nf2=F:5")
fn test_struct_expand_order_and_instantiations() {
    let a = upairs(AU { alpha: 2.0, count: 4, pos: V2 { x: 2.0, y: 3.0 } })
    for p in a { print(describe(p)) }
    let b = upairs(BU { flag: 9, f2: 5.0 })
    for p in b { print(describe(p)) }
}

// A literal omitting defaulted fields still expands ALL fields.
@test(output = "a=F:7\nb=I:3")
fn test_struct_expand_defaults() {
    let ps = upairs(DU {})
    for p in ps { print(describe(p)) }
}

global BUMPS: int = 0

fn bumped() -> float {
    BUMPS = BUMPS + 1
    return 2.0
}

// A side-effecting field initializer runs exactly once (the arg is lowered a
// single time to a value group; field reads project the group, never re-eval).
@test(output = "1")
fn test_struct_expand_no_double_eval() {
    let ps = upairs(AU { alpha: bumped(), count: 4, pos: V2 { x: 2.0, y: 3.0 } })
    if ps.len() != 3 { print("BADLEN:{ps.len()}") }
    print("{BUMPS}")
}

// A cdata-eligible enum (shared-slot scalar payloads) must also expand -- its
// values use the `<Enum>_ct` cdata representation, not the boxed `{__variant}`
// table. `One(int)`/`Both(int, int)` share slot `_0: int`, so the enum is cdata;
// only the single-payload `One` matches an int field.
enum M {
    One(int),
    Both(int, int),
}

value MU { n: int }

@struct_expand inline(lua) fn mpairs<T>(u: T) -> [(string, M)] = """
    error("mpairs must be compiler-expanded")
"""

@test(output = "n=One:8")
fn test_struct_expand_cdata_enum() {
    let ps = mpairs(MU { n: 8 })
    for p in ps {
        let v = match p.1 {
            M::One(a) => "One:{a}",
            M::Both(a, b) => "Both:{a},{b}",
        }
        print("{p.0}={v}")
    }
}

value VA { pos: Vec2f, rot: f32 }
value VB { rot: f32, pos: Vec2f, scale: f32 }
value VC { a: Vec4f, b: Vec3f, c: f32 }

@vertex_expand inline(lua) fn vstride<T>(buf: FlatVec<T>) -> int = """
    error("vstride must be compiler-expanded")
"""

@vertex_expand inline(lua) fn vsizes<T>(buf: FlatVec<T>) -> [int] = """
    error("vsizes must be compiler-expanded")
"""

fn join(xs: [int]) -> string {
    let s = ""
    for n in xs { s = "{s}{n}," }
    return s
}

// VB is VA reordered plus a field: same components in a different order, which
// a component-count-only model would get right and an offset model must too.
@test(output = "VA 3 2,1,\nVB 4 1,2,1,\nVC 8 4,3,1,")
fn test_vertex_expand_derives_the_element_layout() {
    let a: FlatVec<VA> = flat_vec_new()
    print("VA {vstride(a)} {join(vsizes(a))}")

    let b: FlatVec<VB> = flat_vec_new()
    print("VB {vstride(b)} {join(vsizes(b))}")

    let c: FlatVec<VC> = flat_vec_new()
    print("VC {vstride(c)} {join(vsizes(c))}")
}

value BloomBlurU { radius: float, direction: Vec2, resolution: float }

fn pack_into<T>(fbuf: NativeBuffer<float>, ibuf: NativeBuffer<int>, u: T) {
    pack_uniform_block(fbuf.ptr, ibuf.ptr, u)
}

@test
fn generic_fn_packs_at_std140_offsets() {
    let f = native_buffer_float(8)
    let i = native_buffer_int(8)
    let u = BloomBlurU { radius: 1.5, direction: v(2.5, 3.5), resolution: 4.5 }

    pack_into(f, i, u)

    // std140 puts `direction` at byte 8, not byte 4: element 1 is the hole the
    // lone leading float opens, and it must still hold its initial zero.
    assert(f[0] == 1.5, "radius at element 0")
    assert(f[1] == 0.0, "element 1 is std140's hole, never written")
    assert(f[2] == 2.5, "direction.x at element 2")
    assert(f[3] == 3.5, "direction.y at element 3")
    assert(f[4] == 4.5, "resolution at element 4")
}

value Flags { scale: float, on: bool, count: int }

@test
fn int_and_bool_members_land_in_the_int_view() {
    let f = native_buffer_float(8)
    let i = native_buffer_int(8)

    pack_into(f, i, Flags { scale: 9.5, on: true, count: 7 })

    assert(f[0] == 9.5, "the float rides the float view")
    // A block bool is 32 bits on the wire, so it stores as an int beside
    // `count` rather than as a byte.
    assert(i[1] == 1, "bool -> 1 through the int view at element 1")
    assert(i[2] == 7, "count through the int view at element 2")
}

value UvGroup {
    radius: float,
    direction: Vec2,
    enabled: bool,
    count: int,
    packed: uint,
}

value UvOther { radius: float, count: int }

fn uv_generic<T>(u: T) -> SemanticUniformBlock {
    return uniform_values(u)
}

fn uv_leaf_text(leaf: CanonicalUniformLeaf) -> string {
    return match leaf {
        CanonicalUniformLeaf::Float(x) => "f{x}",
        CanonicalUniformLeaf::Int(x) => "i{x}",
        CanonicalUniformLeaf::Uint(x) => "u{x}",
        CanonicalUniformLeaf::Bool(x) => "b{x}",
    }
}

fn uv_text(packet: SemanticUniformBlock) -> string {
    let out = ""
    for leaf in packet.leaves {
        out = "{out}{uv_leaf_text(leaf)} "
    }
    return out
}

@test
fn uv_leaves_follow_the_declared_fields() {
    let u = UvGroup {
        radius: 1.5,
        direction: v(2.0, 3.0),
        enabled: true,
        count: 7,
        packed: 9,
    }
    let direct = uniform_values(u)
    let wrapped = uv_generic(u)
    assert_eq(direct.leaves.len(), 6, "one leaf per scalar")
    assert_eq(uv_text(direct), "f1.5 f2 f3 btrue i7 u9 ", "leaf order and kinds")
    assert_eq(uv_text(wrapped), uv_text(direct), "generic wrapper expands alike")
    assert_eq(wrapped.fingerprint, direct.fingerprint, "same layout, same fingerprint")
    let other = uv_generic(UvOther { radius: 1.5, count: 7 })
    assert_eq(uv_text(other), "f1.5 i7 ", "other group leaves")
    assert(other.fingerprint != direct.fingerprint, "different layouts differ")
}
