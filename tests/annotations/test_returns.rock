// `@test(returns = <literal>)` compares the returned value host-side on every
// backend, alone or together with an `output` expectation.

@test(returns = 42)
fn returns_an_int() -> int { return 42 }

@test(returns = -1.5)
fn returns_a_float() -> float { return -1.5 }

@test(returns = true)
fn returns_a_bool() -> bool { return true }

@test(returns = 6, output = "hi")
fn returns_a_value_after_printing() -> int {
    print("hi")
    return 6
}
