// `deco init` decorators: decorated functions register at init and undecorated
// ones do not, `target.name` captures the name whatever the parameter list, and
// decorator arguments may be required, defaulted or optional by call shape.
// Engine-style systems capture `target.func` through `transmute` and run in
// registration or stage order.

global PARAM_NAMES: [string] = []

deco init capture_params {
    vec_push(PARAM_NAMES, target.name)
}

@capture_params
fn no_params() {
    print("no params")
}

@capture_params
fn one_param(x: int) {
    print("x = {x}")
}

@capture_params
fn two_params(name: string, age: int) {
    print("{name} is {age}")
}

@capture_params
fn many_params(a: int, b: int, c: int, d: int) {
    print("{a} {b} {c} {d}")
}

fn not_registered() {
    print("not registered")
}

@test
fn test_function_names_captured() {
    // Init decorators run at module load time, before any test.
    assert_eq(PARAM_NAMES.len, 4, "only the four decorated functions register")
    assert(PARAM_NAMES.any(_ == "no_params"), "no_params should be registered")
    assert(PARAM_NAMES.any(_ == "one_param"), "one_param should be registered")
    assert(PARAM_NAMES.any(_ == "two_params"), "two_params should be registered")
    assert(PARAM_NAMES.any(_ == "many_params"), "many_params should be registered")
}

global REGISTRATIONS: [string] = []

deco init register(priority: int = 100) {
    vec_push(REGISTRATIONS, "priority({priority}): {target.name}")
}

@register
fn system_default() {
    print("default priority system")
}

@register(priority = 10)
fn system_low_priority() {
    print("low priority system")
}

@register(priority = 50)
fn system_mid_priority() {
    print("mid priority system")
}

@test
fn test_default_args_work() {
    assert_eq(REGISTRATIONS.len, 3, "Expected 3 registrations")
    assert(REGISTRATIONS.any(_ == "priority(100): system_default"), "system_default should use default priority 100")
    assert(REGISTRATIONS.any(_ == "priority(10): system_low_priority"), "system_low_priority should have priority 10")
    assert(REGISTRATIONS.any(_ == "priority(50): system_mid_priority"), "system_mid_priority should have priority 50")
}

global opt_registered: [string] = []

deco init register_opt(priority: int = -1, tag: string = "") {
    if priority == -1 && tag == "" {
        vec_push(opt_registered, "default: {target.name}")
    } else if tag == "" {
        vec_push(opt_registered, "priority({priority}): {target.name}")
    } else {
        vec_push(opt_registered, "priority({priority}), tag({tag}): {target.name}")
    }
}

@register_opt
fn opt_system_default() {
    print("default system")
}

@register_opt(priority = 10)
fn opt_system_priority() {
    print("priority system")
}

@register_opt(priority = 5, tag = "physics")
fn opt_system_tagged() {
    print("tagged system")
}

@test
fn test_overload_selection() {
    assert_eq(opt_registered.len, 3, "Expected 3 registrations")
    assert(opt_registered.any(_ == "default: opt_system_default"), "Default should be selected for @register_opt")
    assert(opt_registered.any(_ == "priority(10): opt_system_priority"), "Priority should be selected for @register_opt(priority=10)")
    assert(opt_registered.any(_ == "priority(5), tag(physics): opt_system_tagged"), "Tagged should be selected for @register_opt(priority=5, tag=\"physics\")")
}

global TAGGED: [string] = []

deco init register_tagged(tag: string) {
    vec_push(TAGGED, "registered({tag}): {target.name}")
}

@register_tagged(tag = "physics")
fn physics_system() {
    print("physics_system executed")
}

@register_tagged(tag = "render")
fn render_system() {
    print("render_system executed")
}

@test
fn test_required_arg_registration() {
    assert_eq(TAGGED.len, 2, "Expected 2 registrations")
    assert(TAGGED.any(_ == "registered(physics): physics_system"), "physics_system should be registered with tag")
    assert(TAGGED.any(_ == "registered(render): render_system"), "render_system should be registered with tag")
}

// Decorated functions stay callable.
@test(output="no params\nx = 1\nAda is 36\n1 2 3 4\nnot registered\ndefault priority system\nlow priority system\nmid priority system\ndefault system\npriority system\ntagged system\nphysics_system executed\nrender_system executed")
fn test_decorated_functions_work() {
    no_params()
    one_param(1)
    two_params("Ada", 36)
    many_params(1, 2, 3, 4)
    not_registered()
    system_default()
    system_low_priority()
    system_mid_priority()
    opt_system_default()
    opt_system_priority()
    opt_system_tagged()
    physics_system()
    render_system()
}

struct InitSystem {
    func: fn() -> (),
    name: string,
}

struct UpdateSystem {
    func: fn() -> (),
    name: string,
    stage: int,
}

struct ResetSystem {
    func: fn() -> (),
    name: string,
}

global INIT_SYSTEMS: [InitSystem] = []
global UPDATE_SYSTEMS: [UpdateSystem] = []
global RESET_SYSTEMS: [ResetSystem] = []

deco init init {
    INIT_SYSTEMS.push(InitSystem {
        func: transmute(target.func),
        name: transmute(target.name),
    })
}

deco init update(stage: int = 100) {
    UPDATE_SYSTEMS.push(UpdateSystem {
        func: transmute(target.func),
        name: transmute(target.name),
        stage: stage,
    })
}

deco init reset {
    RESET_SYSTEMS.push(ResetSystem {
        func: transmute(target.func),
        name: transmute(target.name),
    })
}

fn run_init_systems() {
    for system in INIT_SYSTEMS {
        system.func()
    }
}

fn run_update_systems() {
    sort(UPDATE_SYSTEMS, (s) => s.stage)
    for system in UPDATE_SYSTEMS {
        system.func()
    }
}

fn run_reset_systems() {
    for system in RESET_SYSTEMS {
        system.func()
    }
}

global INIT_LOG: [string] = []
global UPDATE_LOG: [string] = []
global RESET_LOG: [string] = []

@init
fn init_physics() {
    INIT_LOG.push("physics")
}

@init
fn init_graphics() {
    INIT_LOG.push("graphics")
}

@update(stage = 0)
fn update_input() {
    UPDATE_LOG.push("input")
}

@update(stage = 10)
fn update_physics() {
    UPDATE_LOG.push("physics")
}

@update(stage = 20)
fn update_ai() {
    UPDATE_LOG.push("ai")
}

@update
fn update_render() {
    UPDATE_LOG.push("render")
}

@reset
fn reset_physics() {
    RESET_LOG.push("physics")
}

@reset
fn reset_world() {
    RESET_LOG.push("world")
}

@test
fn test_systems_registered() {
    assert_eq(vec_len(INIT_SYSTEMS), 2)
    assert_eq(vec_len(UPDATE_SYSTEMS), 4)
    assert_eq(vec_len(RESET_SYSTEMS), 2)
}

@test
fn test_init_and_reset_systems_run() {
    clear(INIT_LOG)
    run_init_systems()
    assert_eq(vec_len(INIT_LOG), 2)
    clear(RESET_LOG)
    run_reset_systems()
    assert_eq(vec_len(RESET_LOG), 2)
}

@test
fn test_update_systems_run_in_stage_order() {
    clear(UPDATE_LOG)
    run_update_systems()

    assert_eq(vec_len(UPDATE_LOG), 4)
    assert_eq(UPDATE_LOG[0], "input")
    assert_eq(UPDATE_LOG[1], "physics")
    assert_eq(UPDATE_LOG[2], "ai")
    assert_eq(UPDATE_LOG[3], "render")
}
