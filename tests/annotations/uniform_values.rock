// `uniform_values(u)` expands at its call into a packet of one canonical leaf
// per logical uniform leaf, in declaration order, with Vec2 split into its
// components. A generic wrapper expands for the concrete type that reaches it,
// and two groups with different layouts carry different fingerprints.

value UvGroup {
    radius: float,
    direction: Vec2,
    enabled: bool,
    count: int,
    packed: uint,
}

value UvOther { radius: float, count: int }

fn uv_generic<T>(u: T) -> SemanticUniformBlock {
    return uniform_values(u)
}

fn uv_leaf_text(leaf: CanonicalUniformLeaf) -> string {
    return match leaf {
        CanonicalUniformLeaf::Float(x) => "f{x}",
        CanonicalUniformLeaf::Int(x) => "i{x}",
        CanonicalUniformLeaf::Uint(x) => "u{x}",
        CanonicalUniformLeaf::Bool(x) => "b{x}",
    }
}

fn uv_text(packet: SemanticUniformBlock) -> string {
    let out = ""
    for leaf in packet.leaves {
        out = "{out}{uv_leaf_text(leaf)} "
    }
    return out
}

@test
fn uv_leaves_follow_the_declared_fields() {
    let u = UvGroup {
        radius: 1.5,
        direction: v(2.0, 3.0),
        enabled: true,
        count: 7,
        packed: 9,
    }
    let direct = uniform_values(u)
    let wrapped = uv_generic(u)
    assert_eq(direct.leaves.len(), 6, "one leaf per scalar")
    assert_eq(uv_text(direct), "f1.5 f2 f3 btrue i7 u9 ", "leaf order and kinds")
    assert_eq(uv_text(wrapped), uv_text(direct), "generic wrapper expands alike")
    assert_eq(wrapped.fingerprint, direct.fingerprint, "same layout, same fingerprint")
    let other = uv_generic(UvOther { radius: 1.5, count: 7 })
    assert_eq(uv_text(other), "f1.5 i7 ", "other group leaves")
    assert(other.fingerprint != direct.fingerprint, "different layouts differ")
}
