// Test decorator with optional parameters
// This verifies deco init with multiple optional params selects correct behavior

global registered: [string] = []

// Single decorator with optional parameters covers multiple call shapes
deco init register(priority: int = -1, tag: string = "") {
    if priority == -1 && tag == "" {
        vec_push(registered, "default: {target.name}")
    } else if tag == "" {
        vec_push(registered, "priority({priority}): {target.name}")
    } else {
        vec_push(registered, "priority({priority}), tag({tag}): {target.name}")
    }
}

// Use no args (all defaults)
@register
fn system_default() {
    print("default system")
}

// Use one arg
@register(priority = 10)
fn system_priority() {
    print("priority system")
}

// Use two args
@register(priority = 5, tag = "physics")
fn system_tagged() {
    print("tagged system")
}

@test
fn test_overload_selection() {
    // Check that correct behavior was selected based on provided args
    assert(vec_len(registered) == 3, "Expected 3 registrations")

    // Find each registration
    let found_default = false
    let found_priority = false
    let found_tagged = false

    for entry in registered {
        if entry.contains("default: system_default") {
            found_default = true
        }
        if entry.contains("priority(10): system_priority") {
            found_priority = true
        }
        if entry.contains("priority(5), tag(physics): system_tagged") {
            found_tagged = true
        }
    }

    assert(found_default, "Default should be selected for @register")
    assert(found_priority, "Priority should be selected for @register(priority=10)")
    assert(found_tagged, "Tagged should be selected for @register(priority=5, tag=\"physics\")")
}

@test(output="default system\npriority system\ntagged system")
fn test_functions_still_work() {
    // Verify the decorated functions still work
    system_default()
    system_priority()
    system_tagged()
}
