// Test that tuple spread properly validates all element types

fn test_homogeneous_tuple_spread() {
    // This should work - all elements are the same type
    let nums = (1, 2, 3)
    let array: [int] = [...nums, 4]
    
    assert_eq(vec_len(array), 4)
    assert_eq(vec_get(array, 0).unwrap(), 1)
    assert_eq(vec_get(array, 3).unwrap(), 4)
}

