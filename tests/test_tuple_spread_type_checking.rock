// fn test_heterogeneous_tuple_spread() {
//     let mixed = (1, "hello", 3.14)
//     let array = [...mixed]  // Should error: inconsistent tuple element types
// }

// This should also fail if type checking is correct
// fn test_type_mismatch() {
//     let floats = (1.0, 2.0, 3.0)
//     let array: [int] = [...floats, 4]  // Should error: float vs int
// }

@test
fn main() {
    test_homogeneous_tuple_spread()
    print("Tuple spread type checking test passed!")
}