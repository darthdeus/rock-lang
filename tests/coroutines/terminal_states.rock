// Terminal states: completed, killed and errored.
//
// ---- completed() ----
//
// The natural-finish terminal (-3) is distinct from killed (-1)
// and errored (-2). It is the only state where `result()` is trustworthy --
// the combinator layer (`take_result` in stone) keys on it to refuse
// fabricating a nil-typed-as-R for killed/errored children.

global CP_LOG: [string] = []

co fn cp_done() -> Coroutine<int, string> {
    yield 1
    return "done"
}

co fn cp_unit() -> Coroutine<int> {
    yield 1
    yield 2
}

co fn cp_boom() -> Coroutine<int> {
    yield 1
    error("boom-completed-probe")
}

@test(output = "pre:false done:true status:dead killed:false errored:false")
fn test_completed_distinguishes_terminals() {
    let c = cp_done()
    resume(c)
    let pre = completed(c)
    resume(c)
    let done = completed(c)
    let s = status(c)

    let k = cp_unit()
    resume(k)
    kill(k)
    let killed = completed(k)

    let e = cp_boom()
    resume(e)
    resume(e)
    let errored = completed(e)
    print("pre:{pre} done:{done} status:{s} killed:{killed} errored:{errored}")
}

co fn cp_falloff() -> Coroutine<int> {
    yield 1
}

@test(output = "falloff:true kill-after:true")
fn test_unit_falloff_is_completed_and_kill_is_noop() {
    let c = cp_falloff()
    resume(c)
    resume(c)
    let f = completed(c)
    kill(c)
    print("falloff:{f} kill-after:{completed(c)}")
}

// ---- Errored state ----
//
// A step-fn raise during resume puts the
// coroutine into a new "errored" terminal state, distinct from "dead".
// resume returns null thereafter, status() reports "errored", and
// last_error() returns the raised message.
//
// last_error() returns whatever Lua's `error()` builtin captured -- by
// default Lua prepends "<chunk>:<line>:" to the user's message. We
// substring-match in the test rather than asserting the full string.

co fn bad() -> Coroutine<int> {
    yield 1
    error("BAD_MARKER")
    yield 2
}

@test(output = "1\nnull\nerrored\ncaptured\nnull\nerrored")
fn test_errored_state_basic() {
    let c = bad()
    let v1 = c.resume()
    print(v1 ?? -1)                // 1
    let v2 = c.resume()
    if v2 == null { print("null") } else { print(v2) }  // "null"
    print(c.status())              // errored
    let msg = c.last_error() ?? ""
    if msg.contains("BAD_MARKER") {
        print("captured")
    } else {
        print("missing:{msg}")
    }
    // Subsequent resumes are no-ops; status / last_error remain.
    let v3 = c.resume()
    if v3 == null { print("null") } else { print(v3) }  // "null"
    print(c.status())              // errored (terminal, idempotent)
}

co fn clean() -> Coroutine<int> {
    yield 1
    yield 2
}

@test(output = "1\n2\nnull\ndead\nno_error\ndead")
fn test_no_error_clean_path() {
    let c = clean()
    print(c.resume() ?? -1)        // 1
    print(c.resume() ?? -1)        // 2
    let v = c.resume()             // null (body fall-off transitions __state < 0)
    if v == null { print("null") } else { print(v) }
    print(c.status())              // "dead" (fall-off terminal)
    print(c.last_error() ?? "no_error")  // "no_error" -- clean path didn't raise
    let v2 = c.resume()
    if v2 == null { /* dead */ }
    print(c.status())              // "dead" (idempotent)
}

global ERR_KILL_LOG: [string] = []

co fn bad_with_hook() -> Coroutine<int> {
    on_killed {
        ERR_KILL_LOG.push("hook_fired")
    }
    yield 1
    error("body_raised")
}

// D6b: on_killed fires when the body raises -- the body's resources
// need cleanup whether termination came from outside (kill) or inside
// (raise). Idempotent: a follow-up explicit kill() does not re-fire.
@test(output = "1\nhook_fired\nerrored\ncaptured\n1")
fn test_errored_fires_on_killed() {
    ERR_KILL_LOG = []
    let c = bad_with_hook()
    let v = c.resume()
    print(v ?? -1)                 // 1
    let v2 = c.resume()
    if v2 == null { /* errored */ }
    for label in ERR_KILL_LOG {
        print(label)              // "hook_fired"
    }
    print(c.status())              // errored
    let msg = c.last_error() ?? ""
    if msg.contains("body_raised") {
        print("captured")
    } else {
        print("missing:{msg}")
    }
    c.kill()
    print(ERR_KILL_LOG.len())     // still 1 -- kill on errored coroutine no-ops
}

// D6b await propagation: when inner errors during delegation, outer
// must also become errored. Without explicit propagation, inner's
// resume returns null (caught by inner's pcall) and outer's pump
// would silently continue past the `await` -- the error vanishes.
// The fix: after inner.resume() returns null, the pump checks
// inner.last_error(); if non-null, re-raise it so outer's pcall
// catches it and transitions outer to errored too.

co fn inner_bad() -> Coroutine<int> {
    yield 10
    error("INNER_BOOM")
}

co fn outer_delegating() -> Coroutine<int> {
    yield 1
    await inner_bad()
    yield 99   // never reached
}

@test(output = "1\n10\nnull\nerrored\ncaptured")
fn test_yield_star_propagates_inner_error() {
    let c = outer_delegating()
    print(c.resume() ?? -1)        // 1 (outer's first yield)
    print(c.resume() ?? -1)        // 10 (inner's yield, forwarded)
    let v = c.resume()             // inner errors -> outer also errored
    if v == null { print("null") } else { print(v) }
    print(c.status())              // errored
    let msg = c.last_error() ?? ""
    if msg.contains("INNER_BOOM") {
        print("captured")
    } else {
        print("missing:{msg}")
    }
}

// ---- Killing its own handle ----
//
// A co fn that kills its OWN handle mid-body and then reaches a `yield` must
// STAY killed: the yield stamp is guarded on `state >= 0` (same guard as the
// completion stamp), so status() stays "dead", the post-yield body never runs,
// and a resume after the kill is a no-op. The defer fires exactly once, at the
// kill. Sibling coverage: tests/coroutines/defer_terminal.rock (external kill).

global K_SELF: Coroutine<int>? = null
global K_LOG: int = 0
global K_DEFER: int = 0

co fn ksuicide() -> Coroutine<int> {
    defer { K_DEFER = K_DEFER + 1 }
    yield 1
    if let s = K_SELF { kill(s) }
    yield 2
    K_LOG = 999
}

@test(output = "status=dead log=0 defer=1")
fn test_self_kill_then_yield_stays_dead() {
    K_SELF = ksuicide()
    if let c = K_SELF {
        let _ = resume(c)   // -> yield 1
        let _ = resume(c)   // -> kill(self); reaches `yield 2`, must stay dead
        let st = status(c)
        let _ = resume(c)   // no-op on a dead coroutine
        print("status={st} log={K_LOG} defer={K_DEFER}")
    }
}

// Same edge through the flat-enum yield CHANNEL (`__y*` frame slots +
// `__advance` done-bool) -- a distinct transform/emit path from the scalar
// boxed yield above. The string payload keeps KSig off the cdata path so it
// takes the mixed/boxed flat-enum shape (like Wait).
enum KSig { Ping(int), Note(string) }

global KC_SELF: Coroutine<KSig>? = null
global KC_LOG: int = 0
global KC_DEFER: int = 0

co fn kcsuicide() -> Coroutine<KSig> {
    defer { KC_DEFER = KC_DEFER + 1 }
    yield KSig::Ping(1)
    if let s = KC_SELF { kill(s) }
    yield KSig::Ping(2)
    KC_LOG = 999
}

@test(output = "status=dead log=0 defer=1")
fn test_self_kill_then_yield_stays_dead_flat_enum_channel() {
    KC_SELF = kcsuicide()
    if let c = KC_SELF {
        let _ = resume(c)
        let _ = resume(c)
        let st = status(c)
        let _ = resume(c)
        print("status={st} log={KC_LOG} defer={KC_DEFER}")
    }
}

// A hook with an empty body has no body site of its own; it takes its
// identity from the registration lambda.
co fn empty_hook() -> Coroutine<int> {
    on_killed {
    }
    yield 1
    yield 2
}

@test(output = "first=1 status=dead")
fn test_empty_on_killed_hook_kills_cleanly() {
    let c = empty_hook()
    let first = resume(c)
    kill(c)
    let st = status(c)
    print("first={first} status={st}")
}
