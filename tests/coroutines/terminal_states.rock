// Terminal states: completed and killed.
//
// ---- completed() ----
//
// The natural-finish terminal (-3) is distinct from killed (-1). It is the
// only state where `result()` is trustworthy -- the combinator layer
// (`take_result` in stone) keys on it to refuse fabricating a nil-typed-as-R
// for a coroutine that did not finish normally.

@intrinsic @nomangle inline(lua) fn try_call(f: fn()) -> bool = """
    local ok = pcall(f)
    return not ok
"""

global CP_LOG: [string] = []

co fn cp_done() -> Coroutine<int, string> {
    yield 1
    return "done"
}

co fn cp_unit() -> Coroutine<int> {
    yield 1
    yield 2
}

co fn cp_boom() -> Coroutine<int> {
    yield 1
    error("boom-completed-probe")
}

@test(output = "pre:false done:true status:dead killed:false raised:true raised-status:dead complete:false later-null:true")
fn test_completed_distinguishes_terminals() {
    let c = cp_done()
    resume(c)
    let pre = completed(c)
    resume(c)
    let done = completed(c)
    let s = status(c)

    let k = cp_unit()
    resume(k)
    kill(k)
    let killed = completed(k)

    let e = cp_boom()
    resume(e)
    let raised = try_call(() => { let _ = resume(e) })
    let raised_status = status(e)
    let complete = completed(e)
    let later_null = e.resume() == null
    print("pre:{pre} done:{done} status:{s} killed:{killed} raised:{raised} raised-status:{raised_status} complete:{complete} later-null:{later_null}")
}

co fn cp_falloff() -> Coroutine<int> {
    yield 1
}

@test(output = "falloff:true kill-after:true")
fn test_unit_falloff_is_completed_and_kill_is_noop() {
    let c = cp_falloff()
    resume(c)
    resume(c)
    let f = completed(c)
    kill(c)
    print("falloff:{f} kill-after:{completed(c)}")
}

co fn clean() -> Coroutine<int> {
    yield 1
    yield 2
}

@test(output = "1\n2\nnull\ndead\ntrue\ndead")
fn test_no_error_clean_path() {
    let c = clean()
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    let v = c.resume()
    if v == null { print("null") } else { print(v) }
    print(c.status())
    print(c.completed())
    let v2 = c.resume()
    if v2 == null { /* dead */ }
    print(c.status())
}

global ERR_KILL_LOG: [string] = []

co fn bad_with_hook() -> Coroutine<int> {
    defer {
        ERR_KILL_LOG.push("defer_fired")
    }
    on_killed {
        ERR_KILL_LOG.push("hook_fired")
    }
    yield 1
    error("body_raised")
}

// A body raise runs pending defers and on_killed exactly once before it
// reaches the caller. A later kill on the dead handle does nothing.
@test(output = "1\ntrue\ndead\ntrue\nnull\ndefer_fired,hook_fired\n2")
fn test_resume_error_runs_cleanup_once() {
    ERR_KILL_LOG = []
    let c = bad_with_hook()
    let v = c.resume()
    print(v ?? -1)
    print(try_call(() => { let _ = c.resume() }))
    print(c.status())
    print(!completed(c))
    if c.resume() == null { print("null") }
    print(ERR_KILL_LOG.join(","))
    c.kill()
    print(ERR_KILL_LOG.len())
}

global ON_RESUME_CALLS: int = 0

co fn bad_on_resume() -> Coroutine<int> {
    defer { ERR_KILL_LOG.push("resume-defer") }
    on_killed { ERR_KILL_LOG.push("resume-killed") }
    on_resume(() => {
        ON_RESUME_CALLS += 1
        if ON_RESUME_CALLS == 2 { error("on-resume-raised") }
    })
    yield 1
    yield 2
}

@test(output = "1\ntrue\ndead\ntrue\nnull\nresume-defer,resume-killed\n2")
fn test_on_resume_error_runs_cleanup_once() {
    ERR_KILL_LOG = []
    ON_RESUME_CALLS = 0
    let c = bad_on_resume()
    print(c.resume() ?? -1)
    print(try_call(() => { let _ = c.resume() }))
    print(c.status())
    print(!c.completed())
    if c.resume() == null { print("null") }
    print(ERR_KILL_LOG.join(","))
    c.kill()
    print(ERR_KILL_LOG.len())
}

// ---- Killing its own handle ----
//
// A co fn that kills its OWN handle mid-body and then reaches a `yield` must
// STAY killed: the yield stamp is guarded on `state >= 0` (same guard as the
// completion stamp), so status() stays "dead", the post-yield body never runs,
// and a resume after the kill is a no-op. The defer fires exactly once, at the
// kill. Sibling coverage: tests/coroutines/defer_terminal.rock (external kill).

global K_SELF: Coroutine<int>? = null
global K_LOG: int = 0
global K_DEFER: int = 0

co fn ksuicide() -> Coroutine<int> {
    defer { K_DEFER = K_DEFER + 1 }
    yield 1
    if let s = K_SELF { kill(s) }
    yield 2
    K_LOG = 999
}

@test(output = "status=dead log=0 defer=1")
fn test_self_kill_then_yield_stays_dead() {
    K_SELF = ksuicide()
    if let c = K_SELF {
        let _ = resume(c)
        let _ = resume(c)   // -> kill(self); reaches `yield 2`, must stay dead
        let st = status(c)
        let _ = resume(c)
        print("status={st} log={K_LOG} defer={K_DEFER}")
    }
}

// Same edge through the flat-enum yield CHANNEL (`__y*` frame slots +
// `__advance` done-bool) -- a distinct transform/emit path from the scalar
// boxed yield above. The string payload keeps KSig off the cdata path so it
// takes the mixed/boxed flat-enum shape (like Wait).
enum KSig { Ping(int), Note(string) }

global KC_SELF: Coroutine<KSig>? = null
global KC_LOG: int = 0
global KC_DEFER: int = 0

co fn kcsuicide() -> Coroutine<KSig> {
    defer { KC_DEFER = KC_DEFER + 1 }
    yield KSig::Ping(1)
    if let s = KC_SELF { kill(s) }
    yield KSig::Ping(2)
    KC_LOG = 999
}

@test(output = "status=dead log=0 defer=1")
fn test_self_kill_then_yield_stays_dead_flat_enum_channel() {
    KC_SELF = kcsuicide()
    if let c = KC_SELF {
        let _ = resume(c)
        let _ = resume(c)
        let st = status(c)
        let _ = resume(c)
        print("status={st} log={KC_LOG} defer={KC_DEFER}")
    }
}

// A hook with an empty body has no body site of its own; it takes its
// identity from the registration lambda.
co fn empty_hook() -> Coroutine<int> {
    on_killed {
    }
    yield 1
    yield 2
}

@test(output = "first=1 status=dead")
fn test_empty_on_killed_hook_kills_cleanly() {
    let c = empty_hook()
    let first = resume(c)
    kill(c)
    let st = status(c)
    print("first={first} status={st}")
}
