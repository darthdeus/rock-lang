// PR-δ step 4: kill propagation through await chains.
//
// Calling `.kill()` on the outer handle of a `await` chain must walk
// each `s.__inner_*` slot and call `.kill()` on it, firing each
// level's `on_killed` hook bottom-up. Idempotent.

global KILL_LOG: [string] = []

co fn ks_innermost() -> Coroutine<int> {
    on_killed {
        KILL_LOG.push("innermost")
    }
    yield 1
    yield 2
    yield 3
}

co fn ks_middle() -> Coroutine<int> {
    on_killed {
        KILL_LOG.push("middle")
    }
    yield 10
    await ks_innermost()
    yield 20
}

co fn ks_outer() -> Coroutine<int> {
    on_killed {
        KILL_LOG.push("outer")
    }
    yield 100
    await ks_middle()
    yield 200
}

@test(output = "100\n10\n1\n2\nkilled\ninnermost\nmiddle\nouter\nstatus=dead")
fn test_yield_star_kill_propagates_two_deep() {
    KILL_LOG = []
    let c = ks_outer()
    print(c.resume() ?? -1)  // 100 — outer's first yield
    print(c.resume() ?? -1)  // 10  — middle's first yield
    print(c.resume() ?? -1)  // 1   — innermost yield 1
    print(c.resume() ?? -1)  // 2   — innermost yield 2
    // While suspended at innermost's `yield 2`, kill the outermost.
    // Expected: bottom-up fire of on_killed (innermost, middle, outer).
    c.kill()
    print("killed")
    for label in KILL_LOG {
        print(label)
    }
    print("status={c.status()}")
}

// Idempotent: a second .kill() must not refire any hook.
@test(output = "kill1=3\nkill2=3")
fn test_yield_star_kill_is_idempotent() {
    KILL_LOG = []
    let c = ks_outer()
    let v1 = c.resume()
    if v1 == null { print("v1=null") }  // silence unused warning
    c.resume()  // descend
    c.resume()  // into innermost
    c.kill()
    print("kill1={KILL_LOG.len()}")
    c.kill()
    print("kill2={KILL_LOG.len()}")
}
