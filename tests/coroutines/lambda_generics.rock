// Calls made from a lambda inside a `co fn` reach their definitions.

// The step runs under the resume pcall, so a missing specialization would
// surface as a wrong answer rather than a crash.
global LAMBDA_LOG: [string] = []

co fn lambda_worker() -> Coroutine<int> {
    let add = () => { LAMBDA_LOG.push("lam") }
    add()
    yield 1
}

@test(output = "1 lam")
fn a_generic_call_from_a_coroutine_lambda() {
    let c = lambda_worker()
    let _ = c.resume()
    print("{LAMBDA_LOG.len()} {LAMBDA_LOG[0]}")
}

// A specialized generic coroutine's capturing lambda collapses to a capture of
// the frame cell exactly as in the shared body.
nobox value LP { x: float, y: float }

co fn walk_capturing<T>(v: [T]) -> Coroutine<int, int, ()> {
    let n = v.len
    let bump = () => n + 10
    let k = bump()
    yield k
    return n
}

@test(output = "12")
fn a_specialized_coroutine_with_a_capturing_lambda() {
    let ps: [LP] = [LP { x: 1.0, y: 0.0 }, LP { x: 2.0, y: 0.0 }]
    let c = walk_capturing(ps)
    let t = 0
    for v in c { t = v }
    print("{t}")
}
