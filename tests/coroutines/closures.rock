// Closures in co fn bodies. A closure that captures a frame local sees its
// mutations, even when created in one state arm and called after a yield.
// A closure created inside a defer or hook block captures that block's
// locals boxed when written and by value when only read, never through the
// frame, because the scope-exit splice and the detached cleanup copy share
// one hoisted body per lambda site.

co fn mutable_closure() -> Coroutine<int> {
    let count = 0
    let bump = () => { count = count + 10 }
    yield count
    bump()
    yield count
    bump()
    bump()
    yield count
}

@test(output = "0\n10\n30")
fn test_closure_mutates_captured_scalar() {
    let c = mutable_closure()
    print(c.resume() ?? -99)
    print(c.resume() ?? -99)
    print(c.resume() ?? -99)
}

// ---- Multiple closures sharing captured scalar ----
// Two closures capture the same hoisted local. Mutations via one are
// visible via the other. This is the canonical "counter + reader"
// pattern seen in practice.
co fn shared_capture() -> Coroutine<int> {
    let n = 100
    let reader = () => n
    let bumper = () => { n = n + 1 }

    yield reader()
    bumper()
    yield reader()
    bumper()
    bumper()
    yield reader()
}

@test(output = "100\n101\n103")
fn test_multiple_closures_share_state() {
    let c = shared_capture()
    print(c.resume() ?? -99)
    print(c.resume() ?? -99)
    print(c.resume() ?? -99)
}

// ---- Closure invoked across MULTIPLE yield boundaries ----
// Stress test: a single closure captures a scalar, and is invoked
// repeatedly across many state transitions. Must see the latest value
// each time.
co fn long_lived_closure() -> Coroutine<int> {
    let x = 0
    let snapshot = () => x

    x = 1
    yield snapshot()
    x = 2
    yield snapshot()
    x = 10
    yield snapshot()
    x = x * 5
    yield snapshot()
}

@test(output = "1\n2\n10\n50")
fn test_closure_across_many_yields() {
    let c = long_lived_closure()
    print(c.resume() ?? -99)
    print(c.resume() ?? -99)
    print(c.resume() ?? -99)
    print(c.resume() ?? -99)
}

fn apply_to(f: fn(int) -> int, x: int) -> int { return f(x) }

// A named nested fn inside a co fn keeps its own hoisted lambda.
co fn nested_fn_lambda(k: int) -> Coroutine<int> {
    fn scaled(x: int) -> int {
        return apply_to((v) => v * 10, x)
    }
    yield scaled(k)
    yield scaled(k + 1)
}

@test(output = "30\n40")
fn test_nested_fn_lambda_in_co_fn() {
    let c = nested_fn_lambda(3)
    print(c.resume() ?? -99)
    print(c.resume() ?? -99)
}

co fn defer_mixed_capture() -> Coroutine<int> {
    let base = 100
    defer {
        let n = 5
        let bump = () => { n = n + base; base = base + 1 }
        bump()
        bump()
        print(n)
        print(base)
    }
    yield base
    base = base + 10
    yield base
}

@test(output = "100\n110\n226\n112\n100\n206\n102")
fn test_defer_closure_mixed_capture() {
    let c = defer_mixed_capture()
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    c.resume()

    let c = defer_mixed_capture()
    print(c.resume() ?? -1)
    c.kill()
}

// ---- Defer in an inner scope, with a yield after the splice ----
co fn inner_scope_defer() -> Coroutine<int> {
    let keep = () => 0
    {
        defer {
            let n = 3
            keep = () => { n = n + 1; n }
            print(keep())
        }
        yield 1
    }
    yield 2
    yield keep()
}

@test(output = "1\n4\n2\n5")
fn test_inner_scope_defer_closure_survives_yield() {
    let c = inner_scope_defer()
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}

// ---- Early return splices the defer a second time ----
co fn early_return_defer(stop: bool) -> Coroutine<int> {
    defer {
        let n = 20
        let bump = () => { n = n + 1 }
        bump()
        print(n)
    }
    yield 1
    if stop {
        return
    }
    yield 2
}

@test(output = "1\n21\n1\n2\n21")
fn test_early_return_defer_closure() {
    let a = early_return_defer(true)
    print(a.resume() ?? -1)
    a.resume()
    let b = early_return_defer(false)
    print(b.resume() ?? -1)
    print(b.resume() ?? -1)
    b.resume()
}

// ---- on_killed hook with a closure over a hook-local ----
co fn hook_local() -> Coroutine<int> {
    let base = 40
    on_killed {
        let n = 1
        let bump = () => { n = n + base }
        bump()
        print(n)
    }
    yield 1
    yield 2
}

@test(output = "1\n41")
fn test_on_killed_closure_mutates_hook_local() {
    let c = hook_local()
    print(c.resume() ?? -1)
    c.kill()
}

// ---- Two defers whose locals share a name ----
co fn two_defers() -> Coroutine<int> {
    defer {
        let n = 1
        let f = () => { n = n * 3 }
        f()
        print(n)
    }
    defer {
        let n = 2
        let f = () => n
        print(f())
    }
    yield 1
}

@test(output = "1\n2\n3\n1\n2\n3")
fn test_two_defers_closures() {
    let c = two_defers()
    print(c.resume() ?? -1)
    c.resume()

    let c = two_defers()
    print(c.resume() ?? -1)
    c.kill()
}

// ---- Closure in a loop inside a defer: the box spans several blocks ----
co fn gen3() -> Coroutine<int> {
    yield 1
    yield 2
    yield 3
}

co fn loop_in_defer() -> Coroutine<int> {
    defer {
        let total = 0
        for v in 1..4 {
            let add = () => { total = total + v }
            add()
        }
        for v in gen3() {
            let add = () => { total = total + v * 10 }
            add()
        }
        print(total)
    }
    yield 1
}

@test(output = "1\n66\n1\n66")
fn test_loop_in_defer_closure() {
    let c = loop_in_defer()
    print(c.resume() ?? -1)
    c.resume()

    let c = loop_in_defer()
    print(c.resume() ?? -1)
    c.kill()
}

// ---- Defer registered in a loop body ----
co fn defer_in_loop_body() -> Coroutine<int> {
    for i in 0..2 {
        defer {
            let n = i
            let f = () => { n = n + 10 }
            f()
            print(n)
        }
        yield i
    }
}

@test(output = "0\n10\n1\n11")
fn test_defer_in_loop_body_closure() {
    let c = defer_in_loop_body()
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    c.resume()
}

// ---- A lambda's own defer inside a co fn's defer ----
co fn lambda_defer_in_defer() -> Coroutine<int> {
    defer {
        let n = 1
        let run = () => {
            defer { n = n + 100 }
            n = n + 1
        }
        run()
        print(n)
    }
    yield 1
}

@test(output = "1\n102\n1\n102")
fn test_lambda_defer_in_defer() {
    let c = lambda_defer_in_defer()
    print(c.resume() ?? -1)
    c.resume()

    let c = lambda_defer_in_defer()
    print(c.resume() ?? -1)
    c.kill()
}

// ---- Nested defers inside a defer ----
co fn nested_defer() -> Coroutine<int> {
    defer {
        let n = 1
        defer {
            let m = 10
            let bump = () => { m = m + n }
            bump()
            print(m)
        }
        let inc = () => { n = n + 1 }
        inc()
        print(n)
    }
    yield 1
}

@test(output = "1\n2\n12\n1\n2\n12")
fn test_nested_defer_closures() {
    let c = nested_defer()
    print(c.resume() ?? -1)
    c.resume()

    let c = nested_defer()
    print(c.resume() ?? -1)
    c.kill()
}

// ---- A defer nested in an on_killed hook ----
co fn hook_with_defer() -> Coroutine<int> {
    on_killed {
        let n = 1
        defer {
            let bump = () => { n = n + 10 }
            bump()
            print(n)
        }
        n = n + 1
    }
    yield 1
}

@test(output = "1\n12")
fn test_hook_nested_defer_closure() {
    let c = hook_with_defer()
    print(c.resume() ?? -1)
    c.kill()
}

// ---- Generic co fn ----
co fn generic_defer<T>(x: T) -> Coroutine<T> {
    defer {
        let n = 5
        let bump = () => { n = n + 1 }
        bump()
        print(n)
    }
    yield x
}

@test(output = "a\n6\n6")
fn test_generic_defer_closure() {
    let c = generic_defer("a")
    print(c.resume() ?? "?")
    c.resume()
    let d = generic_defer(3)
    d.resume()
    d.kill()
}
