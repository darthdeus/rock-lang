// Resume values: `let x = yield V` binds the value passed to the next
// `c.resume(val)`, typed by the coroutine's N parameter. The first resume's
// argument is discarded since the body has not yielded yet.

co fn echo_back() -> Coroutine<int, (), int> {
    //                          ^Y    ^R    ^N -- non-unit N enables
    //                                             let-bound yield form
    let x = yield 1
    print(x)
    let y = yield 2
    print(y)
    let z = yield 3
    print(z)
}

@test(output = "1\n42\n2\n7\n3\n0\n-1\n-1\nnull")
fn test_resume_with_value_basic() {
    let c = echo_back()
    print(c.resume(0) ?? -1)
    print(c.resume(42) ?? -1)
    print(c.resume(7) ?? -1)
    print(c.resume(0) ?? -1)
    print(c.resume(0) ?? -1)
    let last = c.resume(0)
    if last == null { print("null") } else { print(last) }
}

// ---- Per-yield feedback in a loop: every resume binds its value ----

co fn accumulator() -> Coroutine<int, int, int> {
    //                          ^Y   ^R   ^N
    let total: int = 0
    let i: int = 0
    while i < 3 {
        let v = yield i
        total = total + v
        i = i + 1
    }
    return total
}

@test(output = "0\n1\n2\nfinal=60")
fn test_resume_with_value_loop() {
    let c = accumulator()
    print(c.resume(0) ?? -1)
    print(c.resume(10) ?? -1)
    print(c.resume(20) ?? -1)
    let last = c.resume(30)
    if last != null { print("unexpected={last}") }
    let r = c.result()
    if r != null { print("final={r}") } else { print("final=null") }
}
