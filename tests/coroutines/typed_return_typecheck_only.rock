// PR-γ phase 1 RED: a co fn declared with `R != ()` should accept
// `return expr` where `expr: R`. Today the body's expected return is
// hard-forced to () (function_calls/defs.rs:275-279), so this would
// error with "Type mismatch: found string, expected ()".
//
// PR-γ.

co fn produce() -> Coroutine<int, string> {
    yield 1
    return "done"
}

@test(output = "ok")
fn test_typed_return_typechecks() {
    // Codegen for the runtime-side `.resume()` returning a typed
    // result lands in PR-γ phase 2; this test only proves the body
    // typechecks with a non-unit R.
    let _c = produce()
    print("ok")
}
