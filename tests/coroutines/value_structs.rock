// Value-typed locals and parameters in co fn bodies. A value such as Vec2
// is passed and accessed as per-field scalars, so it is hoisted into the
// coroutine frame as one slot per field.

value V2 {
    x: int,
    y: int,
}

// Value-typed parameter, read across yield.
co fn co_val_param(p: V2) -> Coroutine<int> {
    yield p.x
    yield p.y
    yield p.x + p.y
}

@test(output = "3\n4\n7")
fn test_value_param() {
    let c = co_val_param(V2 { x: 3, y: 4 })
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}

// Value-typed local, re-bound between yields.
co fn co_val_local() -> Coroutine<int> {
    let v = V2 { x: 1, y: 10 }
    yield v.x
    yield v.y
    let v2 = V2 { x: 100, y: 1000 }
    yield v2.x + v2.y
}

@test(output = "1\n10\n1100")
fn test_value_local() {
    let c = co_val_local()
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}

// Multiple value params plus mixed with primitives.
co fn co_multi(a: V2, n: int, b: V2) -> Coroutine<int> {
    yield a.x + b.x
    yield n
    yield a.y * b.y
}

@test(output = "4\n7\n60")
fn test_value_multi_params() {
    let c = co_multi(V2 { x: 1, y: 2 }, 7, V2 { x: 3, y: 30 })
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}

// Value param read across loop iterations (exercises hoist + writeback path).
co fn co_loop(v: V2) -> Coroutine<int> {
    let i = 0
    while i < 3 {
        yield v.x + i
        i = i + 1
    }
}

@test(output = "10\n11\n12")
fn test_value_param_in_loop() {
    let c = co_loop(V2 { x: 10, y: 99 })
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}

// Value param referenced inside an if-branch that also yields.
co fn co_branch(v: V2, pick: bool) -> Coroutine<int> {
    if pick {
        yield v.x
    } else {
        yield v.y
    }
    yield v.x + v.y
}

@test(output = "1\n3\n2\n3")
fn test_value_param_in_branch() {
    let c1 = co_branch(V2 { x: 1, y: 2 }, true)
    print(c1.resume() ?? -1)
    print(c1.resume() ?? -1)
    let c2 = co_branch(V2 { x: 1, y: 2 }, false)
    print(c2.resume() ?? -1)
    print(c2.resume() ?? -1)
}

// ---- Bare references to a value-typed parameter ----
// `let q = p` / `yield p` / `foo(p)` for
// a value-typed `p` must resolve per-field scalars through `s.p__x`,
// `s.p__y` -- not bare `p__x`, `p__y` (which are nil globals because the
// coroutine frame only has `s` as a local).

fn v2_sum(v: V2) -> int {
    return v.x + v.y
}

// Bare param forwarded through a let binding, then field-accessed.
co fn co_alias(p: V2) -> Coroutine<int> {
    let q = p
    yield q.x
    yield q.y
}

@test(output = "10\n20")
fn test_value_param_let_alias() {
    let c = co_alias(V2 { x: 10, y: 20 })
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}

// Bare param passed as arg across yield.
co fn co_arg(p: V2) -> Coroutine<int> {
    let a = v2_sum(p)
    yield a
    yield v2_sum(p) * 2
}

@test(output = "7\n14")
fn test_value_param_as_arg() {
    let c = co_arg(V2 { x: 3, y: 4 })
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}
