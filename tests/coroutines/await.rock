// `await` delegates to an inner coroutine: outer.Y == inner.Y, and the
// expression value is inner's R. The outer yields whatever the inner
// yields, one value per resume, until the inner completes; then the outer
// advances. A bare `inner()` statement in a co fn is a compile error.

co fn inner_vals() -> Coroutine<int, int, ()> {
    yield 1
    yield 2
    return 42
}

co fn outer_awaits() -> Coroutine<int, int, ()> {
    yield 0
    let r = await inner_vals()
    print("inner-returned={r}")
    yield 99
    return r
}

@test(output = "0\n1\n2\ninner-returned=42\n99")
fn test_await_delegation() {
    let c = outer_awaits()
    print(c.resume() ?? -1)  // 0
    print(c.resume() ?? -1)  // 1
    print(c.resume() ?? -1)  // 2
    print(c.resume() ?? -1)  // inner-returned=42, then 99
}

// ---- Composition ----

co fn inner_abc() -> Coroutine<int> {
    yield 1
    yield 2
    yield 3
}

co fn outer_delegates() -> Coroutine<int> {
    yield 0
    await inner_abc()
    yield 99
}

@test(output = "0\n1\n2\n3\n99\nnull")
fn test_composition_basic() {
    let c = outer_delegates()
    print(c.resume() ?? -99)  // 0 (outer)
    print(c.resume() ?? -99)  // 1 (from inner)
    print(c.resume() ?? -99)  // 2 (from inner)
    print(c.resume() ?? -99)  // 3 (from inner)
    print(c.resume() ?? -99)  // 99 (back in outer)
    let r = c.resume()
    if r == null { print("null") } else { print(r) }
}

// ---- Two sequential delegations ----
co fn yield_one() -> Coroutine<int> { yield 1 }
co fn yield_two() -> Coroutine<int> { yield 2 }

co fn two_delegations() -> Coroutine<int> {
    await yield_one()
    await yield_two()
}

@test(output = "1\n2\nnull")
fn test_composition_sequential() {
    let c = two_delegations()
    print(c.resume() ?? -99)
    print(c.resume() ?? -99)
    let r = c.resume()
    if r == null { print("null") } else { print(r) }
}

// ---- Delegation to a coroutine that yields zero values ----
co fn inner_silent() -> Coroutine<int> {
    // Body runs, yields nothing.
}

co fn outer_over_silent() -> Coroutine<int> {
    yield 10
    await inner_silent()
    yield 20
}

@test(output = "10\n20\nnull")
fn test_composition_silent_inner() {
    let c = outer_over_silent()
    print(c.resume() ?? -99)
    // Second resume enters delegation, inner completes immediately,
    // outer advances to the next yield -- all in one resume.
    print(c.resume() ?? -99)
    let r = c.resume()
    if r == null { print("null") } else { print(r) }
}

// ---- Return value capture: `let r = await inner()` ----

co fn ys_ret_inner() -> Coroutine<int, string> {
    yield 1
    yield 2
    return "done"
}

co fn ys_ret_outer() -> Coroutine<int, string> {
    yield 0
    let r = await ys_ret_inner()
    yield 99
    return r
}

@test(output = "0\n1\n2\n99\n-99\nfinal=done")
fn test_yield_star_return_capture() {
    let c = ys_ret_outer()
    print(c.resume() ?? -99)  // 0
    print(c.resume() ?? -99)  // 1 (from inner)
    print(c.resume() ?? -99)  // 2 (from inner)
    print(c.resume() ?? -99)  // 99 (back in outer)
    print(c.resume() ?? -99)  // null sentinel; resume() returns int? -- just print -99
    let r = c.result()
    if r != null {
        print("final=" + r)
    } else {
        print("final=null")
    }
}

// ---- Nested delegation, three levels deep ----
// Yields forward through every level and return values propagate up.

co fn ns_inner() -> Coroutine<int, string> {
    yield 1
    yield 2
    return "innermost"
}

co fn ns_middle() -> Coroutine<int, string> {
    yield 10
    let r = await ns_inner()
    yield 20
    return r  // bubble inner's R up unchanged
}

co fn ns_outer() -> Coroutine<int, string> {
    yield 100
    let r = await ns_middle()
    yield 200
    return r  // bubble middle's R (which is inner's R) up
}

@test(output = "100\n10\n1\n2\n20\n200\nnull\nresult=innermost")
fn test_yield_star_three_deep_forwarding_and_return() {
    let c = ns_outer()
    print(c.resume() ?? -1)  // 100 (outer)
    print(c.resume() ?? -1)  // 10  (middle)
    print(c.resume() ?? -1)  // 1   (inner)
    print(c.resume() ?? -1)  // 2   (inner)
    print(c.resume() ?? -1)  // 20  (middle, after await completes)
    print(c.resume() ?? -1)  // 200 (outer, after await completes)
    let last = c.resume()
    if last == null { print("null") } else { print(last) }
    let r = c.result()
    if r != null {
        print("result={r}")
    } else {
        print("result=null")
    }
}

// ---- Awaiting a stored handle ----
// The delegation pump resumes the inner handle however it reached the slot,
// so a coroutine can be spawned first and delegated to later.

co fn inner_simple() -> Coroutine<int> {
    yield 1
    yield 2
    yield 3
}

@test(output = "100\n1\n2\n3\n200")
fn test_yield_star_stored_handle_statement_form() {
    // Stored-handle pattern: build h inside the outer co fn body, delegate
    // to it via `await h`. Pre-this-commit the second form was rejected.
    let c = outer_with_stored()
    print(c.resume() ?? -1)        // 100 (outer's first yield)
    print(c.resume() ?? -1)        // 1   (inner via delegation)
    print(c.resume() ?? -1)        // 2
    print(c.resume() ?? -1)        // 3
    print(c.resume() ?? -1)        // 200
}

co fn outer_with_stored() -> Coroutine<int> {
    let h = inner_simple()
    yield 100
    await h
    yield 200
}

co fn inner_with_return() -> Coroutine<int, string> {
    yield 7
    return "from-inner"
}

@test(output = "1\n7\n-1\nresult=ok")
fn test_yield_star_stored_handle_let_binding_form() {
    let c = outer_capturing()
    print(c.resume() ?? -1)        // 1   outer's yield
    print(c.resume() ?? -1)        // 7   delegated (inner's only yield)
    print(c.resume() ?? -1)        // -1  inner returns "from-inner"; outer
                                    //     binds `r`, then `return r` puts
                                    //     outer in terminal -- resume null
    let r = c.result()
    if r == "from-inner" {
        print("result=ok")
    } else {
        print("result=bad:{r ?? \"null\"}")
    }
}

co fn outer_capturing() -> Coroutine<int, string> {
    let h = inner_with_return()
    yield 1
    let r = await h
    return r
}

// ---- Resume values flow through to the inner coroutine ----
// Inner's `let x = yield V` reads the value passed to the outer's resume();
// after the inner terminates, resume values bind in the outer body again.

co fn inner_echo() -> Coroutine<int, (), int> {
    let a = yield 1
    print("inner-a={a}")
    let b = yield 2
    print("inner-b={b}")
}

co fn outer_delegates_resume_arg() -> Coroutine<int, (), int> {
    let pre = yield 0
    print("outer-pre={pre}")
    await inner_echo()
    let post = yield 99
    print("outer-post={post}")
}

@test(output = "0\nouter-pre=10\n1\ninner-a=20\n2\ninner-b=30\n99\nouter-post=40\n-1")
fn test_yield_star_resume_arg_flow() {
    let c = outer_delegates_resume_arg()
    print(c.resume(0) ?? -1)   // 0 (outer first yield); arg=0 discarded
    print(c.resume(10) ?? -1)  // outer-pre=10, then yields 1 (inner first yield)
    print(c.resume(20) ?? -1)  // inner-a=20, then yields 2 (inner second yield)
    print(c.resume(30) ?? -1)  // inner-b=30, inner falls off, outer yields 99
    print(c.resume(40) ?? -1)  // outer-post=40, body falls off; resume returns -1
}

// ---- Kill propagation ----
// kill() on the outer handle kills every inner level, firing each level's
// on_killed hook bottom-up. Idempotent.

global KILL_LOG: [string] = []

co fn ks_innermost() -> Coroutine<int> {
    on_killed {
        KILL_LOG.push("innermost")
    }
    yield 1
    yield 2
    yield 3
}

co fn ks_middle() -> Coroutine<int> {
    on_killed {
        KILL_LOG.push("middle")
    }
    yield 10
    await ks_innermost()
    yield 20
}

co fn ks_outer() -> Coroutine<int> {
    on_killed {
        KILL_LOG.push("outer")
    }
    yield 100
    await ks_middle()
    yield 200
}

@test(output = "100\n10\n1\n2\nkilled\ninnermost\nmiddle\nouter\nstatus=dead")
fn test_yield_star_kill_propagates_two_deep() {
    KILL_LOG = []
    let c = ks_outer()
    print(c.resume() ?? -1)  // 100 -- outer's first yield
    print(c.resume() ?? -1)  // 10  -- middle's first yield
    print(c.resume() ?? -1)  // 1   -- innermost yield 1
    print(c.resume() ?? -1)  // 2   -- innermost yield 2
    // While suspended at innermost's `yield 2`, kill the outermost.
    // Expected: bottom-up fire of on_killed (innermost, middle, outer).
    c.kill()
    print("killed")
    for label in KILL_LOG {
        print(label)
    }
    print("status={c.status()}")
}

// Idempotent: a second .kill() must not refire any hook.
@test(output = "kill1=3\nkill2=3")
fn test_yield_star_kill_is_idempotent() {
    KILL_LOG = []
    let c = ks_outer()
    let v1 = c.resume()
    if v1 == null { print("v1=null") }  // silence unused warning
    c.resume()  // descend
    c.resume()  // into innermost
    c.kill()
    print("kill1={KILL_LOG.len()}")
    c.kill()
    print("kill2={KILL_LOG.len()}")
}

// ---- Error propagation ----
//
// An inner coroutine's raise crosses the delegation
// boundary (`yield_delegate_exit` re-raises the inner's last_error into the
// outer), so the OUTER ends "errored" carrying the inner's message. Pinned for
// BOTH delegate paths -- the flat-enum frame-slot channel and the boxed/scalar
// path. A stamp-killed INNER must take the whole chain down loudly,
// not read as a silent normal completion.

enum Ev {
    Tick(int),
    Act(() -> ()),
}

co fn inner_flat() -> Coroutine<Ev> {
    yield Ev::Tick(1)
    error("boom-flat")
}

co fn outer_flat() -> Coroutine<Ev> {
    yield Ev::Tick(0)
    await inner_flat()
    yield Ev::Tick(9)
}

fn show(e: Ev?) -> string {
    if e == null {
        return "nil"
    }
    return match e {
        Ev::Tick(x) => "Tick({x})"
        Ev::Act(_) => "Act"
    }
}

@test(output = "Tick(0)\nTick(1)\nnil\nerrored\ntrue")
fn test_yield_star_flat_inner_error_propagates() {
    let c = outer_flat()
    print(show(resume(c)))
    print(show(resume(c)))
    print(show(resume(c)))
    print(status(c))
    let err = last_error(c)
    print(err != null && err.contains("boom-flat"))
}

co fn inner_scalar() -> Coroutine<int> {
    yield 1
    error("boom-scalar")
}

co fn outer_scalar() -> Coroutine<int> {
    yield 0
    await inner_scalar()
    yield 9
}

fn show_int(v: int?) -> string {
    if v == null {
        return "nil"
    }
    return "{v}"
}

@test(output = "0\n1\nnil\nerrored\ntrue")
fn test_yield_star_scalar_inner_error_propagates() {
    let c = outer_scalar()
    print(show_int(resume(c)))
    print(show_int(resume(c)))
    print(show_int(resume(c)))
    print(status(c))
    let err = last_error(c)
    print(err != null && err.contains("boom-scalar"))
}
