// Coroutines combined with nullable and structured yield types.
//
// resume() returns T? for Coroutine<T>, so when T is already nullable a
// yielded null reads the same as exhaustion.

struct Player {
    name: string,
    health: int,
}

struct Being {
    name: string,
    health: int,
}

co fn nullable_ints() -> Coroutine<int?> {
    yield 1
    yield null
    yield 3
}

@test(output = "1\n-1\n3")
fn test_nullable_yield() {
    let c = nullable_ints()
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
}

co fn make_players() -> Coroutine<Player> {
    yield Player { name: "Alice", health: 100 }
    yield Player { name: "Bob", health: 80 }
}

@test(output = "Alice: 100hp Bob")
fn test_coroutine_struct_yield_narrowing() {
    let c = make_players()
    let a = c.resume()
    let b = c.resume()
    let out = ""
    if a != null { out = "{a.name}: {a.health}hp" }
    if b != null { out = out + " " + b.name }
    print(out)
}

@test(output = "Alice\nBob\nnobody")
fn test_coroutine_resume_safenav() {
    let c = make_players()
    print(c.resume()?.name ?? "nobody")
    print(c.resume()?.name ?? "nobody")
    print(c.resume()?.name ?? "nobody")
}

co fn pairs() -> Coroutine<(int, string)> {
    yield (1, "one")
    yield (2, "two")
}

@test(output = "1: one")
fn test_coroutine_tuple_yield() {
    let c = pairs()
    let p = c.resume()
    if p != null {
        let (num, name) = p
        print("{num}: {name}")
    }
}

fn first_player_name(c: Coroutine<Player>) -> string {
    let p = c.resume()
    if p == null { return "none" }
    return p.name
}

@test(output = "Alice")
fn test_coroutine_guard_return() {
    let c = make_players()
    print(first_player_name(c))
}

co fn make_entities() -> Coroutine<Being> {
    yield Being { name: "Hero", health: 100 }
    yield Being { name: "Guard", health: 50 }
}

@test(output = "Alice Hero Bob Guard")
fn test_interleaved_coroutines() {
    let a = make_players()
    let b = make_entities()
    let a1 = a.resume()?.name ?? "?"
    let b1 = b.resume()?.name ?? "?"
    let a2 = a.resume()?.name ?? "?"
    let b2 = b.resume()?.name ?? "?"
    print("{a1} {b1} {a2} {b2}")
}

co fn count_to(n: int) -> Coroutine<int> {
    let i = 0
    while i < n {
        yield i
        i = i + 1
    }
}

@test(output = "0 1 2 -1")
fn test_coroutine_coalesce() {
    let c = count_to(3)
    let a = c.resume() ?? -1
    let b = c.resume() ?? -1
    let d = c.resume() ?? -1
    let e = c.resume() ?? -1
    print("{a} {b} {d} {e}")
}

co fn fibonacci() -> Coroutine<int> {
    let a = 0
    let b = 1
    loop {
        yield a
        let tmp = b
        b = a + b
        a = tmp
    }
}

@test(output = "0 1 1 2 3 5 8")
fn test_fibonacci_coroutine() {
    let fib = fibonacci()
    let out = ""
    for i in 0..7 {
        if i > 0 { out = out + " " }
        out = out + "{fib.resume() ?? -1}"
    }
    print(out)
}
