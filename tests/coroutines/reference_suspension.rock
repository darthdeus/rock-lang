// Persist copied values and handles across suspension, and resolve a fresh
// reference in each resume segment.

value SuspensionCell { hp: int }
value SuspensionWrapper { cell: SuspensionCell }
struct SuspensionPlayer { hp: int }

co fn deferred_value_read(cell: ref SuspensionCell) -> Coroutine<int> {
    yield cell.hp
}

co fn deferred_identity_read(player: ref SuspensionPlayer) -> Coroutine<int> {
    yield player.hp
}

fn deferred_value_read(n: int) -> int { n }
fn deferred_value_read(cell: any) -> int { 23 }
fn deferred_identity_read(n: int) -> int { n }

@test
fn call_spread_selects_a_value_overload() {
    let wrapper = SuspensionWrapper { cell: SuspensionCell { hp: 1 } }
    assert_eq(deferred_value_read(..wrapper), 23)
}

@test
fn retained_explicit_value_ref_observes_write_before_first_resume() {
    let cell = SuspensionCell { hp: 1 }
    let borrowed: ref SuspensionCell = cell
    let task = deferred_value_read(borrowed)
    cell.hp = 19
    assert_eq(task.resume() ?? -1, 19)
    assert_eq(task.resume(), null)
}

@test
fn retained_direct_value_place_observes_write_before_first_resume() {
    let cell = SuspensionCell { hp: 1 }
    let task = deferred_value_read(cell)
    cell.hp = 19
    assert_eq(task.resume() ?? -1, 19)
    assert_eq(task.resume(), null)
}

@test
fn retained_explicit_identity_ref_observes_write_before_first_resume() {
    let player = SuspensionPlayer { hp: 1 }
    let borrowed: ref SuspensionPlayer = player
    let task = deferred_identity_read(borrowed)
    player.hp = 19
    assert_eq(task.resume() ?? -1, 19)
    assert_eq(task.resume(), null)
}

@test
fn retained_direct_identity_place_observes_write_before_first_resume() {
    let player = SuspensionPlayer { hp: 1 }
    let task = deferred_identity_read(player)
    player.hp = 19
    assert_eq(task.resume() ?? -1, 19)
    assert_eq(task.resume(), null)
}

co fn copied_value_survives() -> Coroutine<int> {
    let cell = SuspensionCell { hp: 1 }
    let borrowed: ref SuspensionCell = cell
    borrowed.hp = 7
    let snapshot = borrowed.hp
    yield snapshot
    yield snapshot
}

@test
fn value_copied_from_ref_survives_suspension() {
    let task = copied_value_survives()
    assert_eq(task.resume() ?? -1, 7)
    assert_eq(task.resume() ?? -1, 7)
    assert_eq(task.resume(), null)
}

co fn fresh_ref_each_iteration() -> Coroutine<int> {
    let cell = SuspensionCell { hp: 1 }
    for i in 0..3 {
        let borrowed: ref SuspensionCell = cell
        borrowed.hp += 1
        yield borrowed.hp
    }
}

@test
fn fresh_ref_writes_through_each_resume() {
    let task = fresh_ref_each_iteration()
    assert_eq(task.resume() ?? -1, 2)
    assert_eq(task.resume() ?? -1, 3)
    assert_eq(task.resume() ?? -1, 4)
    assert_eq(task.resume(), null)
}

co fn resolve_each_resume(entity: Entity<SuspensionPlayer>) -> Coroutine<int> {
    let before = entity.borrow().unwrap()
    before.hp = 7
    yield before.hp
    let after = entity.borrow().unwrap()
    yield after.hp
}

@test
fn fresh_entity_borrow_observes_mutation_between_resumes() {
    let players: Arena<SuspensionPlayer> = arena_new()
    let entity = players.insert(SuspensionPlayer { hp: 1 })
    let task = resolve_each_resume(entity)
    assert_eq(task.resume() ?? -1, 7)
    let player = entity.borrow().unwrap()
    player.hp = 19
    assert_eq(task.resume() ?? -1, 19)
    assert_eq(task.resume(), null)
}

co fn resolve_if_present(entity: Entity<SuspensionPlayer>) -> Coroutine<int> {
    let before = entity.borrow().unwrap()
    yield before.hp
    if let after = entity.borrow() {
        yield after.hp
    } else {
        yield -1
    }
}

@test
fn fresh_entity_borrow_observes_removal_between_resumes() {
    let players: Arena<SuspensionPlayer> = arena_new()
    let entity = players.insert(SuspensionPlayer { hp: 5 })
    let task = resolve_if_present(entity)
    assert_eq(task.resume() ?? -1, 5)
    entity.remove()
    assert_eq(task.resume() ?? -2, -1)
    assert_eq(task.resume(), null)
}

value FramePair { x: int, y: int }

fn pair_sum(p: FramePair) -> int { p.x + p.y }

co fn value_fields_across_suspension(a: FramePair, middle: int, b: FramePair) -> Coroutine<int> {
    let local = FramePair { x: 1, y: 10 }
    yield local.x
    yield local.y
    let local = FramePair { x: 100, y: 1000 }
    yield local.x + local.y
    yield a.x + b.x
    yield middle
    yield a.y * b.y
    let alias = a
    yield alias.x
    yield alias.y
    yield pair_sum(b)
    yield pair_sum(b) * 2
    for i in 0..3 { yield b.x + i }
}

@test
fn value_fields_survive_multiple_resumes() {
    let c = value_fields_across_suspension(FramePair { x: 1, y: 2 }, 7, FramePair { x: 3, y: 30 })
    for expected in [1, 10, 1100, 4, 7, 60, 1, 2, 33, 66, 3, 4, 5] {
        assert_eq(c.resume() ?? -1, expected)
    }
}
