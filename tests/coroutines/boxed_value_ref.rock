value CoroutineRefCell { w: int }
struct CoroutineRefHolder { cell: CoroutineRefCell }

co fn coroutine_ref_bump(c: ref CoroutineRefCell) -> Coroutine<int> {
    c.w += 1
    yield c.w
}

@test
fn a_coroutine_can_receive_a_boxed_value_field_ref() {
    let holder = CoroutineRefHolder { cell: CoroutineRefCell { w: 7 } }
    let c = coroutine_ref_bump(holder.cell)
    resume(c)
    assert_eq(holder.cell.w, 8)
}
