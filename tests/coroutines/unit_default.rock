// One unit type: the coroutine default R/N is the builtin `()`, spellable
// in any type position. `Coroutine<Y>` == `Coroutine<Y, ()>` ==
// `Coroutine<Y, (), ()>`, and a struct default `= ()` threads into a
// coroutine-typed field -- the generic `Task<R = ()>` shape in miniature

co fn falls_off() -> Coroutine<int> {
    yield 1
    yield 2
}

co fn explicit_all() -> Coroutine<int, (), ()> {
    yield 7
}

co fn count_to(n: int) -> Coroutine<int, string> {
    let i = 0
    while i < n {
        yield i
        i = i + 1
    }
    return "done"
}

@test
fn bare_and_explicit_unit_slots_unify() {
    let a: Coroutine<int, ()> = falls_off()
    let b: Coroutine<int> = explicit_all()
    assert(a.resume() == 1)
    assert(b.resume() == 7)
}

struct Box<R = ()> {
    c: Coroutine<int, R>
}

@test
fn default_param_threads_into_coroutine_field() {
    let b: Box<string> = Box { c: count_to(2) }
    while status(b.c) == "suspended" {
        b.c.resume()
    }
    assert(b.c.result() == "done")

    let u: Box = Box { c: falls_off() }
    assert(u.c.resume() == 1)
}

@test
fn fall_off_generator_iterates() {
    let sum = 0
    for v in falls_off() {
        sum = sum + v
    }
    assert(sum == 3)
}
