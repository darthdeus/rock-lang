// PR-B: `let x = yield V` typechecks against the enclosing co fn's N
// and binds `x` to the value passed via `c.resume(val)`.
//
// First-resume arg is discarded (D5a) — the body hasn't yielded yet,
// so there's nowhere to bind. Subsequent resumes thread the arg
// through to the body's let-bound yield site.

co fn echo_back() -> Coroutine<int, (), int> {
    //                          ^Y    ^R    ^N — non-unit N enables
    //                                             let-bound yield form
    let x = yield 1
    print(x)
    let y = yield 2
    print(y)
    let z = yield 3
    print(z)
}

@test(output = "1\n42\n2\n7\n3\n0\n-1\n-1\nnull")
fn test_resume_with_value_basic() {
    let c = echo_back()
    print(c.resume(0) ?? -1)   // 1 — pre-first-yield resume; arg=0 discarded
    print(c.resume(42) ?? -1)  // 42 (body prints), yields 2
    print(c.resume(7) ?? -1)   // 7  (body prints), yields 3
    print(c.resume(0) ?? -1)   // 0  (body prints), body falls off
    print(c.resume(0) ?? -1)   // -1 — body already terminated; resume returns null
    let last = c.resume(0)     // null — body still terminated
    if last == null { print("null") } else { print(last.unwrap()) }
}
