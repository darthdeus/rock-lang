// Adversarial tests: coroutines. `.resume()` returns T? since the coroutine
// may be exhausted.

co fn count_three(start: int) -> Coroutine<int> {
    yield start
    yield start + 1
    yield start + 2
}

@test(output = "10 11 12\n1 100 2 101")
fn test_basic_and_independent_instances() {
    let c = count_three(10)
    let a = c.resume() ?? -1
    let b = c.resume() ?? -1
    let d = c.resume() ?? -1
    print("{a} {b} {d}")

    let x = count_three(1)
    let y = count_three(100)
    let r1 = x.resume() ?? -1
    let r2 = y.resume() ?? -1
    let r3 = x.resume() ?? -1
    let r4 = y.resume() ?? -1
    print("{r1} {r2} {r3} {r4}")
}

co fn naturals() -> Coroutine<int> {
    let n = 0
    loop {
        yield n
        n = n + 1
    }
}

co fn evens_up_to(limit: int) -> Coroutine<int> {
    let i = 0
    while i < limit {
        if i % 2 == 0 {
            yield i
        }
        i = i + 1
    }
}

co fn running_sum() -> Coroutine<int> {
    let sum = 0
    let i = 1
    loop {
        sum = sum + i
        yield sum
        i = i + 1
    }
}

fn take(c: Coroutine<int>, n: int) -> string {
    let out = ""
    for i in 0..n {
        if i > 0 { out = out + " " }
        out = out + "{c.resume() ?? -1}"
    }
    return out
}

@test(output = "0 1 2 3 4\n0 2 4 -1\n1 3 6 10 15")
fn test_loop_generators() {
    print(take(naturals(), 5))
    print(take(evens_up_to(6), 4))
    print(take(running_sum(), 5))
}

co fn greetings() -> Coroutine<string> {
    yield "hello"
    yield "world"
    yield "!"
}

@test(output = "hello world !")
fn test_string_coroutine() {
    let g = greetings()
    print("{g.resume() ?? "?"} {g.resume() ?? "?"} {g.resume() ?? "?"}")
}

co fn bool_seq() -> Coroutine<bool> {
    yield true
    yield false
    yield true
}

co fn single_bool() -> Coroutine<bool> {
    yield false
}

// A yielded false must stay distinct from the exhausted null.
@test(output = "true false true\nfalse null")
fn test_bool_coroutine_and_exhaustion() {
    let b = bool_seq()
    print("{b.resume() ?? false} {b.resume() ?? true} {b.resume() ?? false}")

    let c = single_bool()
    let first = c.resume()
    let second = c.resume()
    let first_str = "null"
    if first != null { first_str = "{first}" }
    let second_str = "null"
    if second != null { second_str = "{second}" }
    print("{first_str} {second_str}")
}

co fn two_items() -> Coroutine<int> {
    yield 1
    yield 2
}

@test(output = "1 2 null null null")
fn test_resume_after_exhaustion() {
    let c = two_items()
    let out = ""
    for i in 0..5 {
        if i > 0 { out = out + " " }
        let v = c.resume()
        if v == null { out = out + "null" } else { out = out + "{v}" }
    }
    print(out)
}
