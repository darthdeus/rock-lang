// Yields inside `if`/`else` branches, including nested ifs.

fn drain(c: Coroutine<int>) {
    loop {
        let r = c.resume()
        if r == null {
            return
        }
        print(r)
    }
}

co fn yield_in_if_only(flag: bool) -> Coroutine<int> {
    if flag {
        yield 1
    }
    yield 2
}

@test(output = "1\n2\n2")
fn test_yield_in_if_only() {
    drain(yield_in_if_only(true))
    drain(yield_in_if_only(false))
}

co fn yield_in_both(flag: bool) -> Coroutine<int> {
    if flag {
        yield 100
    } else {
        yield 200
    }
    yield 999
}

@test(output = "100\n999\n200\n999")
fn test_yield_both_arms() {
    drain(yield_in_both(true))
    drain(yield_in_both(false))
}

co fn multi_yield_per_arm(flag: bool) -> Coroutine<int> {
    if flag {
        yield 1
        yield 2
    } else {
        yield 10
        yield 20
    }
}

@test(output = "1\n2\n10\n20")
fn test_multi_yield_per_arm() {
    drain(multi_yield_per_arm(true))
    drain(multi_yield_per_arm(false))
}

co fn nested_if(a: int, b: int) -> Coroutine<int> {
    if a > 0 {
        yield 1
        if b > 0 {
            yield 2
        } else {
            yield 3
        }
        yield 4
    }
    yield 5
}

@test(output = "1\n2\n4\n5\n1\n3\n4\n5\n5")
fn test_nested_if() {
    drain(nested_if(1, 1))
    drain(nested_if(1, 0))
    drain(nested_if(0, 0))
}
