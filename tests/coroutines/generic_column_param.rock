// A generic `co fn` over a column-stored container must run against that
// instantiation's own representation: a shared erased body reads a `_data`
// the column vec does not have and silently iterates zero times. Each generic
// fn below has its own instantiations so the cells stay independent; the
// non-generic, non-coroutine and boxed-element cells bound the defect.

nobox value P { x: float, y: float }
nobox value Q { a: float }
value Unmarked { x: float, y: float }

co fn walk_column<T>(v: [T]) -> Coroutine<int, int, ()> {
    let n = 0
    for _e in v { n = n + 1; yield n }
    return n
}

@test(output = "2")
fn a_generic_coroutine_over_a_column_vec_iterates_its_elements() {
    let xs: [P] = [P { x: 1.0, y: 0.0 }, P { x: 2.0, y: 0.0 }]
    let c = walk_column(xs)
    let total = 0
    for v in c { total = v }
    print("{total}")
}

co fn walk_unmarked<T>(v: [T]) -> Coroutine<int, int, ()> {
    let n = 0
    for _e in v { n = n + 1; yield n }
    return n
}

@test(output = "2")
fn a_generic_coroutine_over_an_unmarked_value_column_iterates_identically() {
    let xs: [Unmarked] = [Unmarked { x: 1.0, y: 0.0 }, Unmarked { x: 2.0, y: 0.0 }]
    let c = walk_unmarked(xs)
    let total = 0
    for v in c { total = v }
    print("{total}")
}

co fn walk_concrete(v: [P]) -> Coroutine<int, int, ()> {
    let n = 0
    for _e in v { n = n + 1; yield n }
    return n
}

@test(output = "2")
fn a_non_generic_coroutine_over_the_same_column_vec_is_correct() {
    let xs: [P] = [P { x: 1.0, y: 0.0 }, P { x: 2.0, y: 0.0 }]
    let c = walk_concrete(xs)
    let total = 0
    for v in c { total = v }
    print("{total}")
}

fn count_plain<T>(v: [T]) -> int {
    let n = 0
    for _e in v { n = n + 1 }
    return n
}

@test(output = "2")
fn a_generic_non_coroutine_over_the_same_column_vec_is_correct() {
    let xs: [P] = [P { x: 1.0, y: 0.0 }, P { x: 2.0, y: 0.0 }]
    print("{count_plain(xs)}")
}

co fn walk_boxed<T>(v: [T]) -> Coroutine<int, int, ()> {
    let n = 0
    for _e in v { n = n + 1; yield n }
    return n
}

@test(output = "2")
fn a_generic_coroutine_over_a_boxed_element_is_correct() {
    let xs: [int] = [10, 20]
    let c = walk_boxed(xs)
    let total = 0
    for v in c { total = v }
    print("{total}")
}

co fn walk_two<T>(v: [T]) -> Coroutine<int, int, ()> {
    let n = 0
    for _e in v { n = n + 1; yield n }
    return n
}

@test(output = "2 3")
fn two_column_instantiations_of_one_generic_coroutine_each_answer_their_own_length() {
    let ps: [P] = [P { x: 1.0, y: 0.0 }, P { x: 2.0, y: 0.0 }]
    let qs: [Q] = [Q { a: 1.0 }, Q { a: 2.0 }, Q { a: 3.0 }]
    let cp = walk_two(ps)
    let tp = 0
    for v in cp { tp = v }
    let cq = walk_two(qs)
    let tq = 0
    for v in cq { tq = v }
    print("{tp} {tq}")
}

value Handle { a: int, b: int, c: int, d: int }

fn make_handle() -> Handle {
    return Handle { a: 1, b: 2, c: 3, d: 4 }
}

fn first(h: Handle) -> int { return h.a + h.b }
fn all_fields(h: Handle) -> int { return h.a + h.b + h.c + h.d }
fn optional_all(h: Handle?) -> int { return all_fields(h.unwrap()) }

co fn keep_handle() -> Coroutine<int, int, ()> {
    let h = make_handle()
    let initial = first(h)
    let retained = optional_all(h)
    yield initial
    yield retained
    return retained
}

@test(output = "3\n10")
fn a_coroutine_keeps_a_multi_return_used_after_its_first_call() {
    for n in keep_handle() { print(n) }
}
