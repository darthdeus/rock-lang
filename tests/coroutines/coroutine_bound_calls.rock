// The old bounded-call rejection used an invalid `-> int` annotation.
// With a Coroutine result and an explicit resume, the chain runs normally.
co fn bounded_worker(xs: [int]) -> Coroutine<int, int> {
    let evens = xs.iter().filter(x => x % 2 == 0).collect()
    return evens.len
}

@test(output = "2")
fn bounded_chain_in_coroutine() {
    let c = bounded_worker([1, 2, 3, 4])
    resume(c)
    print(result(c) ?? -1)
}
