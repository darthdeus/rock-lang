// Yields inside loop/while with break and continue, nested loops and zero
// iterations.

fn drain(c: Coroutine<int>) {
    loop {
        let r = c.resume()
        if r == null {
            print("null")
            return
        }
        print(r)
    }
}

co fn yield_in_loop(limit: int) -> Coroutine<int> {
    let i = 0
    loop {
        if i >= limit { break }
        yield i
        i = i + 1
    }
}

@test(output = "0\n1\n2\nnull\nnull")
fn test_loop_with_break() {
    drain(yield_in_loop(3))
    drain(yield_in_loop(0))
}

co fn yield_in_while(limit: int) -> Coroutine<int> {
    let i = 0
    while i < limit {
        yield i
        i = i + 1
    }
}

@test(output = "0\n1\n2\nnull")
fn test_yield_in_while() {
    drain(yield_in_while(3))
}

co fn nested_loops(rows: int, cols: int) -> Coroutine<int> {
    let r = 0
    while r < rows {
        let c = 0
        while c < cols {
            yield r * 10 + c
            c = c + 1
        }
        r = r + 1
    }
}

@test(output = "0\n1\n10\n11\nnull")
fn test_nested_loops_yield() {
    drain(nested_loops(2, 2))
}

co fn yield_with_continue(n: int) -> Coroutine<int> {
    let i = 0
    while i < n {
        i = i + 1
        if i == 2 { continue }
        yield i
    }
}

@test(output = "1\n3\n4\nnull")
fn test_yield_with_continue() {
    drain(yield_with_continue(4))
}
