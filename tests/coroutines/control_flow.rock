// Yields inside if, loops and between loop steps.

fn drain(c: Coroutine<int>) {
    loop {
        let r = c.resume()
        if r == null {
            return
        }
        print(r)
    }
}

co fn nested_if(a: int, b: int) -> Coroutine<int> {
    if a > 0 {
        yield 1
        if b > 0 {
            yield 2
        } else {
            yield 3
        }
        yield 4
    }
    yield 5
}

@test(output = "1\n2\n4\n5\n1\n3\n4\n5\n5")
fn test_nested_if() {
    drain(nested_if(1, 1))
    drain(nested_if(1, 0))
    drain(nested_if(0, 0))
}

fn drain_null(c: Coroutine<int>) {
    loop {
        let r = c.resume()
        if r == null {
            print("null")
            return
        }
        print(r)
    }
}

co fn yield_in_loop(limit: int) -> Coroutine<int> {
    let i = 0
    loop {
        if i >= limit { break }
        yield i
        i = i + 1
    }
}

@test(output = "0\n1\n2\nnull\nnull")
fn test_loop_with_break() {
    drain_null(yield_in_loop(3))
    drain_null(yield_in_loop(0))
}

co fn nested_loops(rows: int, cols: int) -> Coroutine<int> {
    let r = 0
    while r < rows {
        let c = 0
        while c < cols {
            yield r * 10 + c
            c = c + 1
        }
        r = r + 1
    }
}

@test(output = "0\n1\n10\n11\nnull")
fn test_nested_loops_yield() {
    drain_null(nested_loops(2, 2))
}

co fn between_yields(n: int) -> Coroutine<int> {
    let s = 0
    let i = 0
    while i < n {
        i = i + 1
        if i % 3 != 0 {
            if i % 5 == 0 { continue }
            if i > 40 { break }
        }
        s = s + i
    }
    yield s
    let k = 0
    loop {
        k = k + 1
        if k * k > s { break }
    }
    yield k
}

@test(output = "685\n27\nnull")
fn test_loops_between_yields() {
    let c = between_yields(100)
    print(c.resume() ?? -1)
    print(c.resume() ?? -1)
    let r = c.resume()
    if r == null { print("null") } else { print(r) }
}

// The resume after a conditional yield lands mid-iteration.
co fn yield_mid_iteration(n: int) -> Coroutine<int> {
    let s = 0
    let i = 0
    while i < n {
        i = i + 1
        if i % 3 == 0 { continue }
        s = s + i
        if i % 4 == 0 { yield s }
        if s > 60 { break }
        s = s + 1
    }
    yield -s
}

@test(output = "9\n32\n-69")
fn test_yield_mid_iteration() {
    let c = yield_mid_iteration(100)
    let v: int? = c.resume()
    while v != null {
        print(v)
        v = c.resume()
    }
}

// An outer `continue` from an inner loop that yields.
co fn outer_continue(rows: int) -> Coroutine<int> {
    let r = 0
    while r < rows {
        r = r + 1
        let c = 0
        while c < 4 {
            c = c + 1
            if c == r { continue }
            if c > r {
                yield r * 10 + c
                continue
            }
            if (r + c) % 3 == 0 { break }
        }
    }
}

@test(output = "12\n13\n14\n34")
fn test_outer_continue_with_yield() {
    let c = outer_continue(4)
    let v: int? = c.resume()
    while v != null {
        print(v)
        v = c.resume()
    }
}
