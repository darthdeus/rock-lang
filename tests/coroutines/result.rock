// Coroutine return values: a co fn with R != () can `return expr`, and the
// caller reads it with `.result()` once the coroutine has finished.
// `.resume()` still returns Y? whatever R is.

co fn produce() -> Coroutine<int, string> {
    yield 1
    yield 2
    return "done"
}

@test(output = "1 2 done")
fn test_return_value_observable() {
    let c = produce()
    let a = c.resume()
    let b = c.resume()
    let _drain = c.resume() // drives terminal; returns null
    let r = c.result()
    let pa = if a != null { "{a}" } else { "null" }
    let pb = if b != null { "{b}" } else { "null" }
    let pr = if r != null { "{r}" } else { "null" }
    print("{pa} {pb} {pr}")
}

// Sanity: a coroutine that bare-returns without a value sees null
// from `.result()`. This guards the unit-elision path.
co fn bare_return() -> Coroutine<int> {
    yield 1
    return
}

@test(output = "1 null")
fn test_bare_return_result_is_null() {
    let c = bare_return()
    let v = c.resume()
    let _drain = c.resume()
    let r = c.result()
    let pv = if v != null { "{v}" } else { "null" }
    let pr = if r != null { "stashed" } else { "null" }
    print("{pv} {pr}")
}

// ---- Edge cases for `.result()` ----

// ----- Case 1: result() before terminal (still suspended) -----
//
// While the coroutine is mid-yield, no terminal `return expr` has
// fired, so `__return` is unset and `.result()` returns null.

co fn two_steps() -> Coroutine<int, string> {
    yield 1
    yield 2
    return "done"
}

@test(output = "null null done")
fn test_result_progression() {
    let c = two_steps()
    let _y1 = c.resume()
    let r_after_first = c.result()
    let _y2 = c.resume()
    let r_after_second = c.result()
    let _drain = c.resume() // drives terminal
    let r_after_term = c.result()
    let p1 = if r_after_first != null { "{r_after_first}" } else { "null" }
    let p2 = if r_after_second != null { "{r_after_second}" } else { "null" }
    let p3 = if r_after_term != null { "{r_after_term}" } else { "null" }
    print("{p1} {p2} {p3}")
}

// ----- Case 2: kill mid-yield -> result() stays null -----
//
// Kill is not completion. A killed coroutine has __state == -1 but no
// __return write, so `.result()` returns null. This sentinel
// guards against any future change that conflates kill and return.

co fn produces_after_yield() -> Coroutine<int, string> {
    yield 1
    return "would-have-returned"
}

@test(output = "null")
fn test_kill_does_not_set_result() {
    let c = produces_after_yield()
    let _y = c.resume()
    c.kill()
    let r = c.result()
    if r != null { print("{r}") } else { print("null") }
}

// ----- Case 3: unit-R coroutine - result() always null -----
//
// For R = () (today's universe), there's no observation channel.
// `.result()` exists on every Coroutine handle but always returns
// null since no `return expr` can fire (bare-return / fall-off
// don't write __return).

co fn plain_unit() -> Coroutine<int> {
    yield 1
    yield 2
}

@test(output = "null")
fn test_unit_coroutine_result_is_null() {
    let c = plain_unit()
    let _drain1 = c.resume()
    let _drain2 = c.resume()
    let _drain3 = c.resume()
    let r = c.result()
    if r != null { print("stashed") } else { print("null") }
}

// ----- Case 4: explicit Coroutine<int, ()> + return value -----
//
// User explicitly opted into R = () but wrote `return` (bare).
// Same as fall-off: __return stays unset, .result() returns null.
// Guards against the unit-elision check in the type checker
// shifting unintentionally.

co fn explicit_unit() -> Coroutine<int, ()> {
    yield 1
    return
}

@test(output = "null")
fn test_explicit_unit_bare_return() {
    let c = explicit_unit()
    let _y = c.resume()
    let _drain = c.resume()
    let r = c.result()
    if r != null { print("stashed") } else { print("null") }
}

// ---- Multi-field return values ----
// Tuple and value-struct returns box as a single value in the return slot,
// so both fields read back through `.result()` on every backend.

co fn two_out() -> Coroutine<int, (int, int)> {
    yield 1
    return (42, 99)
}

@test(output = "42 99")
fn test_multivalue_tuple_co_return() {
    let c = two_out()
    let _y = c.resume()
    let _drain = c.resume()
    let r = c.result()
    if r != null {
        let (a, b) = r
        print("{a} {b}")
    } else {
        print("null")
    }
}

value Pair { a: int, b: int }

co fn make_pair() -> Coroutine<int, Pair> {
    yield 1
    return Pair { a: 42, b: 99 }
}

@test(output = "42 99")
fn test_value_struct_co_return() {
    let c = make_pair()
    let _y = c.resume()
    let _drain = c.resume()
    let r = c.result()
    if r != null {
        print("{r.a} {r.b}")
    } else {
        print("null")
    }
}
