// Generic calls from coroutine lambdas and detached regions, and generic result falloff.

// The step runs under the resume pcall, so a missing specialization would
// surface as a wrong answer rather than a crash.
global LAMBDA_LOG: [string] = []

co fn lambda_worker() -> Coroutine<int> {
    let add = () => { LAMBDA_LOG.push("lam") }
    add()
    yield 1
}

@test(output = "1 lam")
fn a_generic_call_from_a_coroutine_lambda() {
    let c = lambda_worker()
    let _ = c.resume()
    print("{LAMBDA_LOG.len()} {LAMBDA_LOG[0]}")
}

// A specialized generic coroutine's capturing lambda collapses to a capture of
// the frame cell exactly as in the shared body.
nobox value LP { x: float, y: float }

co fn walk_capturing<T>(v: [T]) -> Coroutine<int, int, ()> {
    let n = v.len
    let bump = () => n + 10
    let k = bump()
    yield k
    return n
}

@test(output = "12")
fn a_specialized_coroutine_with_a_capturing_lambda() {
    let ps: [LP] = [LP { x: 1.0, y: 0.0 }, LP { x: 2.0, y: 0.0 }]
    let c = walk_capturing(ps)
    let t = 0
    for v in c { t = v }
    print("{t}")
}

global HOOK_LOG: [string] = []

co fn hook_worker() -> Coroutine<int> {
    on_killed {
        HOOK_LOG.push("killed")
    }
    yield 1
    yield 2
}

@test(output = "1 killed")
fn a_generic_call_from_a_kill_hook() {
    let c = hook_worker()
    let _ = c.resume()
    c.kill()
    print("{HOOK_LOG.len()} {HOOK_LOG[0]}")
}

global DEFER_LOG: [int] = []

co fn defer_worker() -> Coroutine<int> {
    defer {
        DEFER_LOG.push(7)
    }
    yield 1
    yield 2
}

@test(output = "1 7")
fn a_generic_call_from_a_defer() {
    let c = defer_worker()
    let _ = c.resume()
    c.kill()
    print("{DEFER_LOG.len()} {DEFER_LOG[0]}")
}

global HOOK_CALLS: int = 0

fn bump_hook_calls() { HOOK_CALLS = HOOK_CALLS + 1 }

co fn plain_hook_worker() -> Coroutine<int> {
    on_killed { bump_hook_calls() }
    yield 1
    yield 2
}

@test(output = "1")
fn a_non_generic_call_from_a_kill_hook() {
    let c = plain_hook_worker()
    let _ = c.resume()
    c.kill()
    print("{HOOK_CALLS}")
}

co fn gfall<R>(x: R) -> Coroutine<int, R> {
    yield 1
}

co fn gret<R>(x: R) -> Coroutine<int, R> {
    yield 1
    return x
}

@test(output = "completed:true nil:true")
fn test_generic_falloff_at_nullable_completes_with_nil() {
    let n: int? = 4
    let c = gfall(n)
    resume(c)
    resume(c)
    print("completed:{completed(c)} nil:{result(c) == null}")
}

@test(output = "completed:true")
fn test_generic_falloff_at_unit_completes() {
    let c = gfall(())
    resume(c)
    resume(c)
    print("completed:{completed(c)}")
}

co fn outer_awaits_nullable() -> Coroutine<int, string> {
    let s: string? = "x"
    let r = await gfall(s)
    return if r == null { "nil" } else { "value" }
}

@test(output = "nil")
fn test_await_of_generic_falloff_at_nullable_yields_nil() {
    let c = outer_awaits_nullable()
    resume(c)
    resume(c)
    print(result(c) ?? "missing")
}

@test(output = "7 hi")
fn test_generic_return_at_concrete_results() {
    let a = gret(7)
    resume(a)
    resume(a)
    let b = gret("hi")
    resume(b)
    resume(b)
    print("{result(a) ?? -1} {result(b) ?? "missing"}")
}
