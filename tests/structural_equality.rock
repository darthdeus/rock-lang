// `==`/`!=` on aggregate types is STRUCTURAL (deep), not reference equality.
// rock previously miscompiled these to native Lua `==` (table identity) because
// the codegen's `eq_needs_structural` (rock-codegen/src/anf/storage_ctx.rs) only
// routed enum/newtype/struct/typevar operands through `__op_eq`, missing the
// aggregate ctors (Vec `[T]` = App{ArrayCtor}, tuples, Map, native arrays).
// skull always routed them structurally; this pins both backends to the deep
// semantics.

@test(output = "true false")
fn vec_structural_eq() {
    let a = [1, 2, 3]
    let b = [1, 2, 3]
    let c = [1, 2, 4]
    print("{a == b} {a == c}")
}

@test(output = "true false")
fn vec_nested_structural_eq() {
    let a = [[1, 2], [3]]
    let b = [[1, 2], [3]]
    let c = [[1, 2], [4]]
    print("{a == b} {a == c}")
}

@test(output = "true false")
fn tuple_structural_eq() {
    let a = (1, 2)
    let b = (1, 2)
    let c = (1, 3)
    print("{a == b} {a == c}")
}

@test(output = "false true")
fn vec_structural_ne() {
    let a = [1, 2, 3]
    let b = [1, 2, 3]
    let c = [9]
    print("{a != b} {a != c}")
}
