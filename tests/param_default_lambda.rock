// A lambda as a parameter default, followed by another parameter. The
// lambda's own parameter binding is allocated while the function's
// parameters are being collected and must not land inside their range (that
// rejected `x` as an unannotated parameter of `apply_mid`).

fn apply_mid(v: int, f: fn(int) -> int = x => x * 10, k: int = 1) -> int {
    return f(v) + k
}

fn apply_last(v: int, k: int = 1, f: fn(int) -> int = x => x * 10) -> int {
    return f(v) + k
}

fn apply_two(v: int, f: fn(int) -> int = a => a + 1, g: fn(int) -> int = b => b * 2, k: int = 0) -> int {
    return g(f(v)) + k
}

@test
fn test_lambda_default_before_another_param() {
    assert_eq(apply_mid(2), 21)
    assert_eq(apply_mid(2, x => x + 1, 5), 8)
}

@test
fn test_lambda_default_last() {
    assert_eq(apply_last(2), 21)
    assert_eq(apply_last(2, 5, x => x + 1), 8)
}

@test
fn test_two_lambda_defaults() {
    assert_eq(apply_two(3), 8)
    assert_eq(apply_two(3, a => a, b => b, 1), 4)
}
