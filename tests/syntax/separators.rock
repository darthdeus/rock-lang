// Enum and struct separators: commas or newlines separate enum variants and
// struct fields, and the closing `}` needs no trailing separator. Bare spaces
// (`enum Foo { A B }`) are rejected. These are the accepted shapes from real
// code, pinned so the parser is not tightened too far.

// --- Enum: newline-separated variants ---

enum NewlineEnum {
    X
    Y
    Z
}

@test(output = "X")
fn test_newline_separated_enum_compiles() {
    let v = NewlineEnum::X
    let s = match v {
        NewlineEnum::X => "X",
        NewlineEnum::Y => "Y",
        NewlineEnum::Z => "Z",
    }
    print(s)
}

// --- Match arms: trailing comma optional after the final arm ---

enum Color { Red, Green, Blue }

@test(output = "red")
fn test_match_arms_without_commas() {
    let c = Color::Red
    let name = match c {
        Color::Red => "red"
        Color::Green => "green"
        Color::Blue => "blue"
    }
    print(name)
}

// --- Fn params: commas required (control case) ---

fn add(x: int, y: int) -> int { x + y }

@test(output = "3")
fn test_fn_params_require_commas() {
    print(add(1, 2))
}

// --- Tuple types: commas required (control case) ---

fn swap(pair: (int, string)) -> (string, int) {
    (pair.1, pair.0)
}

@test(output = "hello 42")
fn test_tuple_type_commas_required() {
    let result = swap((42, "hello"))
    print("{result.0} {result.1}")
}

// --- Enum: comments between variants ---

enum BlendMode {
    Alpha,    // Normal alpha blending
    // This is a comment between variants
    Additive, // Additive blending for effects
    /* Block comment */
    Multiply, // Multiply blending
}

enum TestEnum {
    First,
    // Comment at the end
    Second
}

@test
fn test_enum_with_comments() {
    let mode = BlendMode::Alpha
    let test = TestEnum::First
    // Basic test that enums with comments parse correctly
}
