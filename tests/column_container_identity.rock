@test
fn column_entity_arrays_compare_backing_identity() {
    let first: [Entity<int>] = []
    let alias = first
    let other: [Entity<int>] = []
    assert(same_ref(first, alias))
    assert(!same_ref(first, other))
    first.push(Entity { _scene_id: 1, _arena_id: 2, _slot: 3, _generation: 4 })
    assert_eq(alias.len(), 1)
    assert(same_ref(first, alias))
    assert(!same_ref(first, other))
}
