// Test spreading tuple variables (not just literals)

fn test_basic_tuple_var_spread() {
    let x = (1, 2, 3)
    let array = [0, ...x, 4]

    assert_eq(vec_len(array), 5)
    assert_eq(vec_get(array, 0).unwrap(), 0)
    assert_eq(vec_get(array, 1).unwrap(), 1)
    assert_eq(vec_get(array, 2).unwrap(), 2)
    assert_eq(vec_get(array, 3).unwrap(), 3)
    assert_eq(vec_get(array, 4).unwrap(), 4)
}

fn test_multiple_tuple_vars() {
    let a = (10, 20)
    let b = (30, 40)
    let array = [...a, ...b, 50]

    assert_eq(vec_len(array), 5)
    assert_eq(vec_get(array, 0).unwrap(), 10)
    assert_eq(vec_get(array, 1).unwrap(), 20)
    assert_eq(vec_get(array, 2).unwrap(), 30)
    assert_eq(vec_get(array, 3).unwrap(), 40)
    assert_eq(vec_get(array, 4).unwrap(), 50)
}

fn test_mixed_var_and_literal() {
    let t = (1.0, 2.0, 3.0)
    let array = [0.0, ...t, ...(4.0, 5.0), 6.0]

    assert_eq(vec_len(array), 7)
    assert_eq(vec_get(array, 0).unwrap(), 0.0)
    assert_eq(vec_get(array, 1).unwrap(), 1.0)
    assert_eq(vec_get(array, 2).unwrap(), 2.0)
    assert_eq(vec_get(array, 3).unwrap(), 3.0)
    assert_eq(vec_get(array, 4).unwrap(), 4.0)
    assert_eq(vec_get(array, 5).unwrap(), 5.0)
    assert_eq(vec_get(array, 6).unwrap(), 6.0)
}

fn make_tuple() -> (int, int, int) {
    (100, 200, 300)
}

fn test_function_return_tuple() {
    let array = [...make_tuple(), 400]

    assert_eq(vec_len(array), 4)
    assert_eq(vec_get(array, 0).unwrap(), 100)
    assert_eq(vec_get(array, 1).unwrap(), 200)
    assert_eq(vec_get(array, 2).unwrap(), 300)
    assert_eq(vec_get(array, 3).unwrap(), 400)
}

@test
fn main() {
    test_basic_tuple_var_spread()
    test_multiple_tuple_vars()
    test_mixed_var_and_literal()
    test_function_return_tuple()

    print("All tuple variable spread tests passed!")
}
