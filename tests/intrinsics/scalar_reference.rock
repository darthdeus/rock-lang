fn v_vec3_div_vec3() -> float {
    return (v(4.0, 9.0, 16.0) / v(2.0, 3.0, 4.0)).y
}

@test(returns = 2.0)
fn v_vec4_div_vec4() -> float {
    return (v(2.0, 4.0, 6.0, 8.0) / v(1.0, 2.0, 3.0, 4.0)).w
}


@test(returns = false)
fn v_isnan_finite() -> bool {
    return isnan(1.5)
}

@test(returns = false)
fn v_isinf_finite() -> bool {
    return isinf(1.5)
}

// GLSL drivers can fold division by zero to a finite constant.
@test(backends = "lua,js")
fn ieee_predicates_distinguish_nan_and_infinity() {
    let nan = 0.0 / 0.0
    assert(isnan(nan))
    assert(!isinf(nan))
    for inf in [1.0 / 0.0, -1.0 / 0.0] {
        assert(isinf(inf))
        assert(!isnan(inf))
    }
}

// Bvec3 component reads must have Bool type.
@test(returns = true)
fn v_bvec_field_or() -> bool {
    let b = bvec3(false, true, false)
    return b.x || b.y || b.z
}

@test(returns = false)
fn v_any_all_false() -> bool {
    return any(bvec3(false, false, false))
}

@test(returns = true)
fn v_any_one_true() -> bool {
    return any(bvec3(false, true, false))
}

@test(returns = true)
fn v_greater_than_reduces() -> bool {
    return any(greater_than(v(1.0, 2.0, 3.0), v(0.0, 9.0, 9.0)))
}

@test(returns = false)
fn v_greater_than_none() -> bool {
    return any(greater_than(v(1.0, 2.0, 3.0), v(9.0, 9.0, 9.0)))
}

@test(returns = 1.0)
fn v_to_vec3_true_channel() -> float {
    return to_vec3(bvec3(true, false, false)).x
}

@test(returns = 0.0)
fn v_to_vec3_false_channel() -> float {
    return to_vec3(bvec3(true, false, false)).z
}

fn near(a: float, b: float) -> bool {
    return abs(a - b) < 0.000000001
}

@test fn tan_matches_sin_over_cos() {
    assert(near(tan(0.7), sin(0.7) / cos(0.7)), "tan(0.7)")
    assert(near(tan(-1.3), sin(-1.3) / cos(-1.3)), "tan(-1.3)")
}

@test fn log_is_the_natural_log() {
    assert(near(log(exp(1.0)), 1.0), "log(e) == 1")
    assert(near(log(1.0), 0.0), "log(1) == 0")
    assert(near(log(8.0), 2.0794415416798357), "log(8)")
}

@test fn log2_is_base_two() {
    assert(near(log2(8.0), 3.0), "log2(8) == 3")
    assert(near(log2(1024.0), 10.0), "log2(1024) == 10")
    assert(near(log2(0.25), -2.0), "log2(0.25) == -2")
    assert_eq(log2(0.0), -1.0 / 0.0)
    assert(is_nan(log2(-1.0)))
}

@test(output = "1 2")
fn test_tuple_projections() {
    let t = (1, 2)
    print("{tuple_first(t)} {tuple_second(t)}")
}

@test(returns = 7)
fn test_tuple_first_literal() -> int {
    tuple_first((7, 99))
}

@test(returns = 10)
fn test_range_collect_sum() -> int {
    let r = (0..5).collect()
    let s = 0
    for x in r { s = s + x }
    s
}

@test(returns = 3)
fn test_range_len() -> int {
    let r = (2..5).collect()
    r.len
}

// Native templates belong to stdlib declarations, not user functions with the same name.
fn abs(b: bool) -> int {
    if b { 5 } else { 7 }
}

@test(returns = 57)
fn test_user_fn_shadowing_an_intrinsic_name() -> int {
    abs(true) * 10 + abs(false)
}
