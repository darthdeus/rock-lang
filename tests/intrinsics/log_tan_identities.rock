// `tan`, `log` and `log2` are `@intrinsic` with an `inline(lua)` body and no
// portable Rock fallback, so a missing JS row is a hard emit rejection rather
// than a slow path.
//
// Runs on BOTH backends: luajit's `math.*` is the oracle, so a divergence here
// is the JS mapping being wrong rather than the intrinsic being wrong.
//
// Assertions are on identities that pin the BASE (log2's 0.693.. divisor makes
// a natural-log mapping agree with a base-2 one at x=1, so a case at 1 is a
// control, not coverage). Tolerance is 1e-9 -- wide enough for the two hosts'
// libm to disagree in the last bits, far tighter than a wrong base.

fn near(a: float, b: float) -> bool {
    return abs(a - b) < 0.000000001
}

@test fn tan_matches_sin_over_cos() {
    assert(near(tan(0.7), sin(0.7) / cos(0.7)), "tan(0.7)")
    assert(near(tan(-1.3), sin(-1.3) / cos(-1.3)), "tan(-1.3)")
}

@test fn log_is_the_natural_log() {
    // exp(1) rather than a literal: pins the base against the host's own exp.
    assert(near(log(exp(1.0)), 1.0), "log(e) == 1")
    assert(near(log(1.0), 0.0), "log(1) == 0")
    // A base-10 mapping would answer 0.9030.. here; a base-2 one 3.0.
    assert(near(log(8.0), 2.0794415416798357), "log(8)")
}

@test fn log2_is_base_two() {
    // 8 and 1024 are exact powers of two, so a correct base-2 mapping lands on
    // a whole number and a natural-log one does not.
    assert(near(log2(8.0), 3.0), "log2(8) == 3")
    assert(near(log2(1024.0), 10.0), "log2(1024) == 10")
    assert(near(log2(0.25), -2.0), "log2(0.25) == -2")
}
