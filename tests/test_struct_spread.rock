// Test struct spread functionality

struct FixVec2 {
    x: float,
    y: float,
}

struct Color {
    r: float,
    g: float,
    b: float,
    a: float,
}

fn test_homogeneous_struct_spread() {
    // Test FixVec2 spread
    let pos = FixVec2 { x: 10.0, y: 20.0 }
    let coords = [...pos, 0.0]  // Should expand to [pos.x, pos.y, 0.0]
    
    assert_eq(vec_len(coords), 3)
    assert_eq(vec_get(coords, 0).unwrap(), 10.0)
    assert_eq(vec_get(coords, 1).unwrap(), 20.0) 
    assert_eq(vec_get(coords, 2).unwrap(), 0.0)
    
    // Test Color spread
    let color = Color { r: 1.0, g: 0.5, b: 0.0, a: 1.0 }
    let rgba = [...color]  // Should expand to [color.r, color.g, color.b, color.a]
    
    assert_eq(vec_len(rgba), 4)
    assert_eq(vec_get(rgba, 0).unwrap(), 1.0)
    assert_eq(vec_get(rgba, 1).unwrap(), 0.5)
    assert_eq(vec_get(rgba, 2).unwrap(), 0.0)
    assert_eq(vec_get(rgba, 3).unwrap(), 1.0)
}

fn test_mixed_struct_and_literal_spread() {
    let pos = FixVec2 { x: 5.0, y: 15.0 }
    
    // Mix struct spread with regular elements
    let vertex = [0.0, ...pos, 25.0, 1.0]
    
    assert_eq(vec_len(vertex), 5)
    assert_eq(vec_get(vertex, 0).unwrap(), 0.0)   // literal
    assert_eq(vec_get(vertex, 1).unwrap(), 5.0)   // pos.x
    assert_eq(vec_get(vertex, 2).unwrap(), 15.0)  // pos.y
    assert_eq(vec_get(vertex, 3).unwrap(), 25.0)  // literal
    assert_eq(vec_get(vertex, 4).unwrap(), 1.0)   // literal
}

@test
fn main() {
    test_homogeneous_struct_spread()
    test_mixed_struct_and_literal_spread()
    print("Struct spread tests passed!")
}