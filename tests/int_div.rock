// `./` integer floor division.

@test
fn test_idiv_basic() {
    assert_eq(3 ./ 4, 0)
}

@test
fn test_idiv_floor_negative() {
    // floor, NOT truncation: rounds toward -inf
    assert_eq(-7 ./ 2, -4)
}

@test
fn test_idiv_truncation_positive() {
    assert_eq(7 ./ 2, 3)
}

@test
fn test_idiv_precedence_add() {
    // `./` binds tighter than `+`: 6 ./ 4 == 1, then 1 + 1 == 2
    assert_eq(1 + 6 ./ 4, 2)
}

@test
fn test_idiv_left_assoc_same_tier_as_mul() {
    // same tier as `*`, left assoc: (2 * 3) ./ 2 == 6 ./ 2 == 3
    assert_eq(2 * 3 ./ 2, 3)
}
