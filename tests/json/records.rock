// JSON records: wire names, presence, declared defaults and omission,
// diagnostics, native arrays, adapters, flat enums and malformed fields.

@test
fn json_record_context_only_keeps_maps_used_by_the_walk() {
    let codec = JsonRecordCodec { reject_unknown_fields: true }
    let encoding = __json_record_context(codec, false)
    let decoding = __json_record_context(codec, true)
    assert(encoding.adapters == null && encoding.field_names == null)
    assert(decoding.adapters == null && decoding.field_names != null)

    let adapter = JsonRecordAdapter { name: "test", encode: _ => json_null(), decode: _ => null }
    codec.adapters.push(adapter)
    let adapted = __json_record_context(codec, false)
    assert_eq(adapted.adapters.unwrap().get(adapter.name).unwrap().name, adapter.name)
}

struct JsonNamedRecord {
    @json_name("wire_name")
    name: string,
}

@test
fn json_record_uses_declared_wire_names_in_both_directions() {
    let codec = JsonRecordCodec { reject_unknown_fields: true }
    let value = JsonNamedRecord { name: "example" }
    let wire = json_record_encode(codec, value)
    assert_eq(json_as_str(json_field(wire, "wire_name").unwrap()).unwrap(), "example")
    assert(json_field(wire, "name") == null)
    assert_eq(json_record_decode(codec, wire, value).unwrap().name, "example")
    let errors: [JsonRecordError] = []
    codec.on_error = error => errors.push(error)
    assert(json_record_decode(codec, json_decode("{{\"wire_name\":false}}").unwrap(), value) == null)
    assert_eq(errors[0].path, "/wire_name")
    assert_eq(errors[0].actual, "Bool")
}

struct JsonEscapedNameRecord {
    @json_name("a/b~c\"\\\n")
    value: int,
}

@test
fn json_record_wire_names_escape_source_and_error_paths() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { reject_unknown_fields: true, on_error: error => errors.push(error) }
    let value = JsonEscapedNameRecord { value: 7 }
    let wire = json_record_encode(codec, value)
    assert_eq(json_as_int(json_field(wire, "a/b~c\"\\\n").unwrap()).unwrap(), 7)
    assert_eq(json_record_decode(codec, json_decode(json_encode(wire)).unwrap(), value).unwrap().value, 7)
    assert(json_record_decode(codec, json_object(map_new()), value) == null)
    assert_eq(errors[0].path, "/a~1b~0c\"\\\n")
}

struct JsonPresenceEdit {
    title: JsonField<string?>,
    count: JsonField<int>,
    items: JsonField<[int]>,
}

@test
fn json_record_presence_distinguishes_omitted_null_and_value() {
    let codec = JsonRecordCodec { reject_unknown_fields: true }
    let absent = json_record_decode<JsonPresenceEdit>(codec, json_decode("{{}}").unwrap()).unwrap()
    assert(!absent.title.present && !absent.count.present && !absent.items.present)
    assert_eq(json_encode(json_record_encode(codec, absent)), "{{}}")
    let cleared = json_record_decode<JsonPresenceEdit>(codec, json_decode("{{\"title\":null}}").unwrap()).unwrap()
    assert(cleared.title.present && cleared.title.value == null)
    assert_eq(json_encode(json_record_encode(codec, cleared)), "{{\"title\":null}}")
    let changed = json_record_decode<JsonPresenceEdit>(codec,
        json_decode("{{\"title\":\"new\",\"count\":0,\"items\":[]}}").unwrap()).unwrap()
    assert(changed.title.present && changed.title.value.unwrap() == "new")
    assert(changed.count.present && changed.count.value.unwrap() == 0)
    assert(changed.items.present && changed.items.value.unwrap().len() == 0)
    let copy = json_record_decode<JsonPresenceEdit>(codec, json_record_encode(codec, changed)).unwrap()
    assert_eq(copy, changed)
}

@test
fn json_record_presence_rejects_invalid_supplied_values_with_paths() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { reject_unknown_fields: true, on_error: error => errors.push(error) }
    for (bad, path) in [
        ("{{\"count\":null}}", "/count"), ("{{\"count\":1.5}}", "/count"),
        ("{{\"count\":false}}", "/count"), ("{{\"items\":[1,false]}}", "/items/1"),
        ("{{\"extra\":0}}", "/extra"),
    ] {
        errors.clear()
        assert(json_record_decode<JsonPresenceEdit>(codec, json_decode(bad).unwrap()) == null, bad)
        assert_eq(errors[errors.len() - 1].path, path, bad)
    }
}

nobox value JsonPresencePoint { x: int, y: int }

struct JsonPresenceNative { point: JsonField<JsonPresencePoint?> }

@test
fn json_record_presence_preserves_native_payloads() {
    let codec = JsonRecordCodec {}
    let edit = json_record_decode<JsonPresenceNative>(codec,
        json_decode("{{\"point\":{{\"x\":2,\"y\":3}}}}").unwrap()).unwrap()
    assert(edit.point.present)
    assert_eq(edit.point.value.unwrap().x, 2)
    assert_eq(edit.point.value.unwrap().y, 3)
    let copy = json_record_decode<JsonPresenceNative>(codec, json_record_encode(codec, edit)).unwrap()
    assert_eq(copy, edit)
}

struct JsonPresenceFlag {
    @json_name("enabled")
    flag: JsonField<bool>,
}

@test
fn json_booleans_share_boxes_across_construction_and_storage() {
    let codec = JsonRecordCodec {}
    let items = json_as_array(json_decode("[true,false,null,true,false]").unwrap()).unwrap()
    let fields = json_as_object(json_decode("{{\"on\":true,\"off\":false}}").unwrap()).unwrap()
    for (flag, key, index) in [(true, "on", 0), (false, "off", 1)] {
        let node = json_bool(flag)
        let record = JsonPresenceFlag { flag: JsonField { present: true, value: flag } }
        let encoded = json_record_encode(codec, record)
        assert(same_ref(node, items[index]))
        assert(same_ref(node, items[index + 3]))
        assert(same_ref(node, fields[key]))
        assert(same_ref(node, json_field(encoded, "enabled").unwrap()))
        assert_eq(json_record_decode(codec, encoded, record).unwrap().flag.value.unwrap(), flag)
        items[index] = json_null()
        fields[key] = json_null()
        assert_eq(json_as_bool(items[index + 3]).unwrap(), flag)
        assert_eq(json_as_bool(node).unwrap(), flag)
    }
}

@test
fn json_record_boolean_variants_keep_their_wire_format() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { on_error: error => errors.push(error) }
    for (flag, text) in [(true, "[\"Bool\",true]"), (false, "[\"Bool\",false]")] {
        let node = json_bool(flag)
        assert_eq(json_encode(json_record_encode(codec, node)), text)
        let decoded = json_record_decode<JsonValue>(codec, json_decode(text).unwrap()).unwrap()
        assert_eq(json_as_bool(decoded).unwrap(), flag)
        assert(same_ref(decoded, node))
    }
    for text in ["[\"Bool\"]", "[\"True\"]", "[\"False\"]", "[\"Bool\",1]"] {
        assert(json_record_decode<JsonValue>(codec, json_decode(text).unwrap()) == null)
    }
    assert_eq(errors[3].path, "/1")
    assert_eq(errors[3].expected, "bool")
    assert_eq(errors[3].actual, "Int")
}

struct JsonPresenceNested {
    edit: JsonField<JsonPresenceEdit>,
    labels: JsonField<Map<string, string>>,
}

@test
fn json_record_presence_composes_with_wire_names_nested_records_and_maps() {
    let codec = JsonRecordCodec { reject_unknown_fields: true }
    let flag = json_record_decode<JsonPresenceFlag>(codec, json_decode("{{\"enabled\":false}}").unwrap()).unwrap()
    assert(flag.flag.present && !flag.flag.value.unwrap())
    assert_eq(json_encode(json_record_encode(codec, flag)), "{{\"enabled\":false}}")
    let wire = json_decode("{{\"edit\":{{\"title\":null}},\"labels\":{{\"keep\":\"yes\"}}}}").unwrap()
    let edit = json_record_decode<JsonPresenceNested>(codec, wire).unwrap()
    assert(edit.edit.present && edit.edit.value.unwrap().title.present)
    assert(edit.edit.value.unwrap().title.value == null)
    assert(edit.labels.present && edit.labels.value.unwrap().contains("keep"))
    assert_eq(json_encode(json_record_encode(codec, edit)), json_encode(wire))
}

struct JsonDiagnosticRow { count: int }

struct JsonDiagnosticRoot { rows: [JsonDiagnosticRow] }

@test
fn json_record_reports_nested_failure() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { on_error: error => errors.push(error) }
    let value = json_decode("{{\"rows\":[{{\"count\":\"wrong\"}}]}}").unwrap()
    assert(json_record_decode(codec, value, JsonDiagnosticRoot { rows: [] }) == null)
    assert_eq(errors.len(), 1)
    assert_eq(errors[0].path, "/rows/0/count")
    assert_eq(errors[0].expected, "int")
    assert_eq(errors[0].actual, "Str")
}

struct JsonDiagnosticMap { values: Map<string, JsonDiagnosticRow> }

@test
fn json_record_reports_missing_fields_and_escaped_map_keys() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { on_error: error => errors.push(error) }
    let value = json_decode("{{\"values\":{{\"a/b~c\":{{}}}}}}").unwrap()
    assert(json_record_decode(codec, value, JsonDiagnosticMap { values: map_new() }) == null)
    assert_eq(errors.len(), 1)
    assert_eq(errors[0].path, "/values/a~1b~0c/count")
    assert_eq(errors[0].actual, "missing")
    assert_eq(errors[0].expected, "int")
    errors.clear()
    let valid = json_decode("{{\"values\":{{\"a\":{{\"count\":4}}}}}}").unwrap()
    let decoded = json_record_decode(codec, valid, JsonDiagnosticMap { values: map_new() }).unwrap()
    assert_eq(decoded.values.get("a").unwrap().count, 4)
    assert_eq(errors.len(), 0)
    assert_eq(json_encode(json_record_encode(codec, decoded)), json_encode(valid))
    assert(json_record_decode(JsonRecordCodec {}, value, JsonDiagnosticMap { values: map_new() }) == null)
}

enum JsonDiagnosticChoice { Count(int), Empty }

struct JsonDiagnosticEnum { choice: JsonDiagnosticChoice }

@test
fn json_record_reports_enum_payload_and_root_failures() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { on_error: error => errors.push(error) }
    let value = json_decode("{{\"choice\":[\"Count\",false]}}").unwrap()
    assert(json_record_decode(codec, value, JsonDiagnosticEnum { choice: JsonDiagnosticChoice::Empty }) == null)
    assert_eq(errors[0].path, "/choice/1")
    assert_eq(errors[0].expected, "int")
    errors.clear()
    assert(json_record_decode(codec, json_null(), JsonDiagnosticRoot { rows: [] }) == null)
    assert_eq(errors.len(), 1)
    assert_eq(errors[0].path, "")
    assert_eq(errors[0].actual, "Null")
}

@test
fn json_record_can_reject_unknown_fields_without_a_second_schema() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { reject_unknown_fields: true, on_error: error => errors.push(error) }
    let value = json_decode("{{\"rows\":[{{\"count\":4,\"cout\":5}}]}}").unwrap()
    assert(json_record_decode(codec, value, JsonDiagnosticRoot { rows: [] }) == null)
    assert_eq(errors[0].path, "/rows/0/cout")
    assert_eq(errors[0].actual, "unknown field")
    assert(json_record_decode(JsonRecordCodec {}, value, JsonDiagnosticRoot { rows: [] }) != null)
}

struct JsonNativeRows { points: [Vec2] }

@test
fn json_record_native_array_uses_the_compiler_container_layout() {
    let codec = JsonRecordCodec {}
    let source = JsonNativeRows { points: [v(1.0, 2.0), v(3.0, 4.0)] }
    let encoded = json_record_encode(codec, source)
    let result = json_record_decode(codec, encoded, source).unwrap()
    assert_eq(result.points.len(), 2)
    assert_eq(result.points[1].x, 3.0)
    result.points.push(v(5.0, 6.0))
    assert_eq(result.points[2].y, 6.0)
    let empty = json_record_decode(codec, json_decode("{{\"points\":[]}}").unwrap(), source).unwrap()
    empty.points.push(v(7.0, 8.0))
    assert_eq(empty.points[0].x, 7.0)
}

nobox value JsonNativeBounds { min: Vec2, max: Vec2 }

struct JsonNestedNativeRows { bounds: [JsonNativeBounds] }

@test
fn json_record_native_root_owns_its_wire_materialization() {
    let source = JsonNativeBounds { min: v(1.0, 2.0), max: v(3.0, 4.0) }
    let wire = json_record_encode(JsonRecordCodec {}, source)
    assert_eq(json_as_float(json_field(json_field(wire, "max").unwrap(), "y").unwrap()).unwrap(), 4.0)
    let result = json_record_decode<JsonNativeBounds>(JsonRecordCodec {}, wire).unwrap()
    assert_eq(result.min.x, 1.0)
    assert_eq(result.max.y, 4.0)
}

@test
fn json_record_nested_native_array_keeps_all_leaf_paths() {
    let source = JsonNestedNativeRows { bounds: [JsonNativeBounds { min: v(1.0, 2.0), max: v(3.0, 4.0) }] }
    let codec = JsonRecordCodec {}
    let result = json_record_decode<JsonNestedNativeRows>(codec, json_record_encode(codec, source)).unwrap()
    assert_eq(result.bounds[0].max.y, 4.0)
    result.bounds.push(JsonNativeBounds { min: v(5.0, 6.0), max: v(7.0, 8.0) })
    assert_eq(result.bounds[1].min.x, 5.0)
}

@test
fn json_record_native_array_respects_element_wire_adapters() {
    let codec = JsonRecordCodec { adapters: [json_record_adapter(v(0.0, 0.0),
        point => json_array([json_float(point.x), json_float(point.y)]),
        value => {
            let parts = json_as_array(value) ?? return null
            if parts.len() != 2 { return null }
            return v(json_record_finite_float(parts[0]) ?? return null,
                json_record_finite_float(parts[1]) ?? return null)
        })] }
    let source = JsonNativeRows { points: [v(1.0, 2.0)] }
    let wire = json_record_encode(codec, source)
    let point = json_as_array(json_as_array(json_field(wire, "points").unwrap()).unwrap()[0]).unwrap()
    assert_eq(point.len(), 2)
    let result = json_record_decode<JsonNativeRows>(codec, wire).unwrap()
    assert_eq(result.points[0].x, 1.0)
}

struct JsonDefaultCache { values: [int] = [] }
struct JsonDeclaredDefaults {
    required: int,
    @json_default
    label: string? = "fresh",
    @json_default
    children: [JsonDefaultCache] = [JsonDefaultCache {}],
    @json_skip
    cache: JsonDefaultCache = JsonDefaultCache {},
}

@test
fn json_record_declared_defaults_are_fresh_and_do_not_weaken_supplied_values() {
    let codec = JsonRecordCodec { reject_unknown_fields: true }
    let sample = JsonDeclaredDefaults { required: 0 }
    let input = json_decode("{{\"required\":7}}").unwrap()
    let first = json_record_decode<JsonDeclaredDefaults>(codec, input).unwrap()
    let second = json_record_decode(codec, input, sample).unwrap()
    first.children[0].values.push(1)
    first.cache.values.push(2)
    assert_eq(second.children[0].values.len(), 0)
    assert_eq(second.cache.values.len(), 0)
    assert_eq(first.label.unwrap(), "fresh")
    let explicit_null = json_decode("{{\"required\":7,\"label\":null}}").unwrap()
    assert(json_record_decode(codec, explicit_null, sample).unwrap().label == null)
    for bad in ["{{}}", "{{\"required\":7,\"children\":false}}", "{{\"required\":7,\"cache\":{{}}}}"] {
        assert(json_record_decode(codec, json_decode(bad).unwrap(), sample) == null)
    }
    let encoded = json_record_encode(codec, first)
    assert(json_field(encoded, "cache") == null)
    assert_eq(json_record_decode(codec, encoded, sample).unwrap().cache.values.len(), 0)
}

global JSON_DEFAULT_CALLS: int = 0
fn json_declared_default_call() -> int {
    JSON_DEFAULT_CALLS += 1
    return JSON_DEFAULT_CALLS
}
struct JsonCalledDefault {
    @json_default
    number: int = json_declared_default_call(),
    @json_skip
    callback: fn() -> int = () => 42,
}

@test
fn json_record_only_evaluates_absent_defaults() {
    let original = JSON_DEFAULT_CALLS
    defer { JSON_DEFAULT_CALLS = original }
    let sample = JsonCalledDefault { number: 0 }
    let codec = JsonRecordCodec {}
    let first = json_record_decode(codec, json_decode("{{}}").unwrap(), sample).unwrap()
    assert_eq(first.number, original + 1)
    assert_eq(first.callback(), 42)
    let supplied = json_decode("{{\"number\":9}}").unwrap()
    let second = json_record_decode(codec, supplied, sample).unwrap()
    assert_eq(second.number, 9)
    json_record_encode(codec, second)
    assert_eq(JSON_DEFAULT_CALLS, original + 1)
}

value JsonDefaultValue { x: int, y: int }
struct JsonNativeDefault {
    @json_default
    point: JsonDefaultValue = JsonDefaultValue { x: 3, y: 4 },
}

@test
fn json_record_declared_defaults_preserve_native_value_representation() {
    let result = json_record_decode(JsonRecordCodec {}, json_decode("{{}}").unwrap(), JsonNativeDefault {}).unwrap()
    assert_eq(result.point.x, 3)
    assert_eq(result.point.y, 4)
}

fn json_empty_text(text: string) -> bool { return text == "" }
fn json_zero_number(number: int) -> bool { return number == 0 }
struct JsonOmittedDefaults {
    @json_omit_if(json_empty_text)
    text: string = "",
    @json_omit_if(json_zero_number)
    count: int = 0,
}

@test
fn json_record_omits_fields_using_typed_predicates() {
    let codec = JsonRecordCodec { reject_unknown_fields: true }
    let empty = JsonOmittedDefaults {}
    assert_eq(json_encode(json_record_encode(codec, empty)), "{{}}")
    let decoded = json_record_decode(codec, json_decode("{{}}").unwrap(), empty).unwrap()
    assert_eq(decoded.text, "")
    assert_eq(decoded.count, 0)
    let filled = JsonOmittedDefaults { text: "keep", count: 7 }
    let wire = json_record_encode(codec, filled)
    assert_eq(json_as_str(json_field(wire, "text").unwrap()).unwrap(), "keep")
    assert_eq(json_as_int(json_field(wire, "count").unwrap()).unwrap(), 7)
}

nobox value JsonOptionalTile { x: int, y: int }
fn json_absent_value<T>(value: T?) -> bool { return value == null }
struct JsonOptionalTileContext {
    @json_omit_if(json_absent_value)
    tile: JsonOptionalTile? = null,
}

fn json_optional_tile_context(tile: JsonOptionalTile?) -> JsonOptionalTileContext {
    return JsonOptionalTileContext { tile }
}

@test
fn json_record_omission_predicate_accepts_nullable_native_values() {
    let codec = JsonRecordCodec {}
    let empty = json_optional_tile_context(null)
    assert_eq(json_encode(json_record_encode(codec, empty)), "{{}}")
    let present = JsonOptionalTileContext { tile: JsonOptionalTile { x: 2, y: 3 } }
    let decoded = json_record_decode<JsonOptionalTileContext>(codec, json_record_encode(codec, present)).unwrap()
    assert_eq(decoded.tile.unwrap().x, 2)
}

enum Kind { First, Second }

nobox value Tint { red: float, visible: bool }

nobox value Point { x: int, y: int }

nobox value Marker { point: Point, tint: Tint }

value Key { namespace: string, name: string }

nobox value Label { name: string, marker: Marker?, key: Key }

struct Packet { kind: Kind, tint: Tint, spare: Tint?, marker: Marker, backup: Marker?, rows: [Label] }

fn marker_encode(value: Marker) -> JsonValue {
    return json_array([json_int(value.point.x), json_int(value.point.y),
        json_float(value.tint.red), json_bool(value.tint.visible)])
}

fn marker_decode(value: JsonValue) -> Marker? {
    let fields = json_as_array(value) ?? return null
    if fields.len() != 4 { return null }
    return Marker { point: Point { x: json_as_int(fields[0]) ?? return null,
        y: json_as_int(fields[1]) ?? return null },
        tint: Tint { red: json_as_float(fields[2]) ?? return null,
            visible: json_as_bool(fields[3]) ?? return null } }
}

fn kind_encode(value: Kind) -> JsonValue { return json_str(if value == Kind::First { "a" } else { "b" }) }

fn kind_decode(value: JsonValue) -> Kind? {
    let key = json_as_str(value) ?? return null
    if key == "a" { return Kind::First }
    if key == "b" { return Kind::Second }
    return null
}

@test(output = "ok")
fn typed_json_uses_declared_scalar_enum_adapters_and_embedded_values() {
    let key = Key { namespace: "sample", name: "record" }
    let marker = Marker { point: Point { x: 7, y: -3 }, tint: Tint { red: 0.25, visible: false } }
    let codec = JsonRecordCodec { adapters: [json_record_adapter(Kind::First, kind_encode, kind_decode),
        json_record_adapter(marker, marker_encode, marker_decode)] }
    let source = Packet { kind: Kind::Second, tint: Tint { red: 0.5, visible: false }, spare: null, marker, backup: marker,
        rows: [Label { name: "first", marker, key }, Label { name: "empty", marker: null, key }] }
    let wire = json_record_encode(codec, source)
    assert(json_as_str(json_field(wire, "kind").unwrap()).unwrap() == "b")
    let copy = json_record_decode(codec, wire, source).unwrap()
    assert(copy == source)
    assert(json_encode(json_field(wire, "marker").unwrap()) == "[7,-3,0.25,false]")
    assert(copy.backup.unwrap().point.y == -3 && !copy.backup.unwrap().tint.visible)
    assert(copy.rows.len() == 2 && copy.rows[0].marker.unwrap().point.x == 7)
    assert(copy.rows[1].marker == null && copy.rows[1].key == key)
    copy.rows.push(Label { name: "added", marker, key })
    copy.rows[0] = Label { name: "changed", marker: null, key }
    assert(source.rows.len() == 2 && source.rows[0].name == "first")
    assert(copy.rows[2].marker.unwrap().tint.red == 0.25)
    json_as_object(wire).unwrap()["backup"] = json_null()
    assert(json_record_decode(codec, wire, source).unwrap().backup == null)
    json_as_object(wire).unwrap()["marker"] = json_str("invalid")
    assert(json_record_decode(codec, wire, source) == null)
    json_as_object(wire).unwrap()["marker"] = marker_encode(marker)
    json_as_object(wire).unwrap()["kind"] = json_str("unknown")
    assert(json_record_decode(codec, wire, source) == null)
    print("ok")
}

enum Event { Empty, Text(string), Colored(string, Tint), Pair(string, int) }

enum Wrapper { Wrapped(Event), Other(string) }

struct Record { event: Event, envelope: Wrapper, optional: Event? }

@test(output = "ok")
fn typed_json_flat_enum_fields_and_widened_payloads() {
    let codec = JsonRecordCodec {}
    for event in [Event::Empty, Event::Text("hello"), Event::Colored("red", Tint { red: 0.5, visible: false }), Event::Pair("count", 7)] {
        let source = Record { event, envelope: Wrapper::Wrapped(event), optional: if event == Event::Empty { null } else { event } }
        let wire = json_record_encode(codec, source)
        let copy = json_record_decode(codec, json_decode(json_encode(wire)).unwrap(), source).unwrap()
        assert(copy == source)
        assert(json_encode(json_record_encode(codec, copy)) == json_encode(wire))
        if let Event::Colored(label, tint) = copy.event {
            assert(label == "red" && tint.red == 0.5 && !tint.visible)
        }
    }
    print("ok")
}

enum ChangeEvent { Empty, Text(string), Pair(int, float), Names([string]) }

value ValueTint { red: float, visible: bool }

value Change { event: ChangeEvent, count: int }

struct ChangeLog {
    rows: [Change],
    title: string?,
    weights: Map<string, float>,
    tint: ValueTint,
}

@test(output = "ok")
fn typed_json_records_roundtrip_and_reject_malformed_fields() {
    let codec = JsonRecordCodec {}
    let weights: Map<string, float> = map_new()
    weights["alpha"] = 1.25
    let source = ChangeLog { rows: [Change { event: ChangeEvent::Empty, count: 1 },
        Change { event: ChangeEvent::Pair(5, 2.5), count: 2 },
        Change { event: ChangeEvent::Names(["a", "b"]), count: 3 }],
        title: null, weights, tint: ValueTint { red: 0.75, visible: false } }
    let wire = json_record_encode(codec, source)
    let copy = json_record_decode(codec, json_decode(json_encode(wire)).unwrap(), source).unwrap()
    assert(copy == source)
    assert(!same_ref(copy, source))
    copy.rows[0] = Change { event: ChangeEvent::Text("changed"), count: 8 }
    assert(source.rows[0].count == 1)
    let fields = json_as_object(wire).unwrap()
    fields["rows"] = json_str("wrong")
    assert(json_record_decode(codec, wire, source) == null)
    fields["rows"] = json_array([json_object(map_new())])
    assert(json_record_decode(codec, wire, source) == null)
    fields["rows"] = json_array([])
    fields["weights"] = json_str("wrong")
    assert(json_record_decode(codec, wire, source) == null)
    fields["weights"] = json_object(map_new())
    fields["title"] = json_int(4)
    assert(json_record_decode(codec, wire, source) == null)
    print("ok")
}

struct TypedIntRow { values: [int] }
struct TypedFloatRow { values: [float] }

inline(lua) fn row_tag_before_promotion(items: [JsonValue]) -> string? = """
    local tag = items._data[1]
    if type(tag) == "string" then return tag end
"""

@test(backends = "lua")
fn decode_json_rows_without_losing_callback_identity() {
    let node = json_decode("{{\"values\":[7]}}").unwrap()
    let items = json_as_array(json_field(node, "values").unwrap()).unwrap()
    let plain = json_record_decode<TypedIntRow>(JsonRecordCodec {}, node).unwrap()
    assert_eq(plain.values[0], 7)
    assert_eq(row_tag_before_promotion(items), "Int")

    let stored: [any] = []
    let codec = JsonRecordCodec { decode_float: value => {
        stored.push(value)
        json_as_float(value)
    } }
    let custom = json_record_decode<TypedFloatRow>(codec, node).unwrap()
    assert_eq(custom.values[0], 7.0)
    assert(same_ref(stored[0], items[0]))
}

// Decoding source text through a reader must agree with decoding its
// JsonValue: same result, same diagnostic. The text is also read nested
// inside another object, so offsets other than the root are exercised.
fn json_record_read_agrees<T>(codec: JsonRecordCodec, text: string) {
    let errors: [JsonRecordError] = []
    let on_error = codec.on_error
    codec.on_error = error => errors.push(error)
    let direct = json_record_decode<T>(codec, json_decode(text).unwrap())
    let read = json_record_read<T>(codec, json_reader_decode(text).unwrap())
    let wrapper = json_reader_decode("{{\"before\": [1, {{\"x\": \"]\"}}], \"wrap\":\n {text} }}").unwrap()
    let nested = json_record_read<T>(codec, json_reader_field(wrapper, "wrap").unwrap())
    codec.on_error = on_error
    assert_eq(direct == null, read == null, text)
    assert_eq(direct == null, nested == null, text)
    if let value = direct {
        let expected = json_encode(json_record_encode(codec, value))
        assert_eq(json_record_write(codec, value), expected, text)
        assert_eq(json_encode(json_record_encode(codec, read.unwrap())), expected, text)
        assert_eq(json_encode(json_record_encode(codec, nested.unwrap())), expected, text)
        assert_eq(errors.len(), 0, text)
        return
    }
    assert_eq(errors.len(), 3, text)
    for i in 1..3 {
        assert_eq(errors[i].path, errors[0].path, text)
        assert_eq(errors[i].expected, errors[0].expected, text)
        assert_eq(errors[i].actual, errors[0].actual, text)
    }
}

@test
fn json_record_read_matches_value_decoding() {
    let plain = JsonRecordCodec {}
    let strict = JsonRecordCodec { reject_unknown_fields: true }
    for text in ["{{}}", "{{\"title\":null}}", " {{ \"title\" : \"n\\u00e9w\\n\\\"\" , \"count\" : 0 , \"items\" : [ ] }} ",
        "{{\"count\":null}}", "{{\"count\":1.5}}", "{{\"count\":1.0}}", "{{\"count\":-0}}", "{{\"count\":2e3}}",
        "{{\"count\":false}}", "{{\"items\":[1,false]}}", "{{\"items\":[1, 2 ,3]}}", "{{\"extra\":0}}",
        "{{\"title\":\"a\",\"title\":\"b\"}}", "[]", "\"text\"", "null"] {
        json_record_read_agrees<JsonPresenceEdit>(strict, text)
    }
    for text in ["{{\"point\":{{\"x\":2,\"y\":3}}}}", "{{\"point\":null}}", "{{}}"] {
        json_record_read_agrees<JsonPresenceNative>(plain, text)
    }
    for text in ["{{\"edit\":{{\"title\":null}},\"labels\":{{\"k\\\"ey\":\"y\\\\es\",\"a/b\":\"\\ud83d\\ude00\"}}}}",
        "{{\"labels\":{{\"x\":1}}}}"] {
        json_record_read_agrees<JsonPresenceNested>(strict, text)
    }
    for text in ["[\"Bool\",true]", "[\"Bool\"]", "[\"True\"]", "[\"Bool\",1]", "[\"Int\",-12]", "[\"Float\",2.5e-3]",
        "[\"Array\",[[\"Str\",\"x\"],[\"Null\"]]]", "[\"Object\",{{\"a\":[\"Int\",1]}}]", "[\"Nope\"]", "[]", "[1]"] {
        json_record_read_agrees<JsonValue>(plain, text)
    }
    for text in ["{{\"rows\":[{{\"count\":\"wrong\"}}]}}", "{{\"rows\":[{{\"count\":4,\"cout\":5}}]}}", "{{\"rows\":{{}}}}"] {
        json_record_read_agrees<JsonDiagnosticRoot>(plain, text)
        json_record_read_agrees<JsonDiagnosticRoot>(strict, text)
    }
    for text in ["{{\"values\":{{\"a/b~c\":{{}}}}}}", "{{\"values\":{{\"a\":{{\"count\":4}},\"b\":{{\"count\":5}}}}}}"] {
        json_record_read_agrees<JsonDiagnosticMap>(plain, text)
    }
    for text in ["{{\"choice\":[\"Count\",false]}}", "{{\"choice\":[\"Count\",3]}}", "{{\"choice\":[\"Empty\"]}}",
        "{{\"choice\":[\"Nope\"]}}", "{{\"choice\":[]}}", "{{\"choice\":[1]}}", "{{\"choice\":[\"Empty\",1]}}"] {
        json_record_read_agrees<JsonDiagnosticEnum>(plain, text)
    }
    for text in ["{{\"points\":[{{\"x\":1,\"y\":2.5}},{{\"x\":3e0,\"y\":-4}}]}}", "{{\"points\":[]}}", "{{\"points\":[{{\"x\":1}}]}}"] {
        json_record_read_agrees<JsonNativeRows>(plain, text)
        json_record_read_agrees<JsonNativeRows>(JsonRecordCodec { decode_float: value => json_as_float(value) }, text)
    }
    json_record_read_agrees<JsonNestedNativeRows>(plain, "{{\"bounds\":[{{\"min\":{{\"x\":1,\"y\":2}},\"max\":{{\"x\":3,\"y\":4}}}}]}}")
    for text in ["{{\"required\":7}}", "{{\"required\":7,\"label\":null}}", "{{}}", "{{\"required\":7,\"children\":false}}",
        "{{\"required\":7,\"cache\":{{}}}}", "{{\"required\":7,\"children\":[{{\"values\":[1]}}]}}"] {
        json_record_read_agrees<JsonDeclaredDefaults>(strict, text)
    }
    json_record_read_agrees<JsonNativeDefault>(plain, "{{}}")
    for text in ["{{}}", "{{\"tile\":{{\"x\":2,\"y\":3}}}}"] { json_record_read_agrees<JsonOptionalTileContext>(plain, text) }
    for text in ["{{\"wire_name\":\"x\"}}", "{{\"wire_name\":false}}", "{{\"name\":\"x\"}}"] {
        json_record_read_agrees<JsonNamedRecord>(strict, text)
    }
    json_record_read_agrees<JsonEscapedNameRecord>(strict, json_encode(json_record_encode(plain, JsonEscapedNameRecord { value: 7 })))

    let key = Key { namespace: "sample", name: "record" }
    let marker = Marker { point: Point { x: 7, y: -3 }, tint: Tint { red: 0.25, visible: false } }
    let adapted = JsonRecordCodec { adapters: [json_record_adapter(Kind::First, kind_encode, kind_decode),
        json_record_adapter(marker, marker_encode, marker_decode)] }
    let packet = json_record_encode(adapted, Packet { kind: Kind::Second, tint: Tint { red: 0.5, visible: false }, spare: null,
        marker, backup: marker, rows: [Label { name: "first", marker, key }, Label { name: "empty", marker: null, key }] })
    json_record_read_agrees<Packet>(adapted, json_encode(packet))
    json_as_object(packet).unwrap()["marker"] = json_str("invalid")
    json_record_read_agrees<Packet>(adapted, json_encode(packet))

    for event in [Event::Empty, Event::Text("hello"), Event::Colored("red", Tint { red: 0.5, visible: false }), Event::Pair("count", 7)] {
        let source = Record { event, envelope: Wrapper::Wrapped(event), optional: if event == Event::Empty { null } else { event } }
        json_record_read_agrees<Record>(plain, json_encode(json_record_encode(plain, source)))
    }
    let weights: Map<string, float> = map_new()
    weights["alpha"] = 1.25
    let log = json_record_encode(plain, ChangeLog { rows: [Change { event: ChangeEvent::Empty, count: 1 },
        Change { event: ChangeEvent::Pair(5, 2.5), count: 2 }, Change { event: ChangeEvent::Names(["a", "b"]), count: 3 }],
        title: null, weights, tint: ValueTint { red: 0.75, visible: false } })
    json_record_read_agrees<ChangeLog>(plain, json_encode(log))
    json_record_read_agrees<ChangeLog>(plain, json_encode_pretty(log))
    json_as_object(log).unwrap()["title"] = json_int(4)
    json_record_read_agrees<ChangeLog>(plain, json_encode(log))
}

fn json_record_write_agrees<T>(codec: JsonRecordCodec, value: T) {
    assert_eq(json_record_write(codec, value), json_encode(json_record_encode(codec, value)))
}

struct JsonWriteShapes {
    @json_name("z\"last") last: int,
    first: float,
    big: int,
    flag: bool,
    note: string?,
    @json_omit_if(json_write_zero) skipped: int = 0,
    edit: JsonField<string?>,
    names: Map<string, [int]>,
    values: [JsonValue],
    record: Record,
}

fn json_write_zero(value: int) -> bool { return value == 0 }

@test
fn json_record_write_matches_encoding_the_tree() {
    let plain = JsonRecordCodec {}
    let names: Map<string, [int]> = map_new()
    names["b\n"] = [2, 3]
    names["a"] = []
    names["\u{00e9}"] = [-1]
    let event = Event::Colored("red", Tint { red: 0.5, visible: true })
    let shapes = JsonWriteShapes { last: -4, first: 0.1, big: 123456789012345678, flag: false, note: null,
        edit: JsonField { present: true, value: "x\ty" }, names,
        values: [json_int(1), json_str("s"), json_null(), json_bool(true), json_float(2.5),
            json_array([json_object(map_new())])],
        record: Record { event, envelope: Wrapper::Wrapped(event), optional: null } }
    json_record_write_agrees(plain, shapes)
    shapes.skipped = 3
    shapes.edit = JsonField { present: false }
    shapes.note = "n"
    json_record_write_agrees(plain, shapes)
    let fixed = JsonRecordCodec { encode_float: f => json_str("{f:.2}") }
    json_record_write_agrees(fixed, shapes)
    json_record_write_agrees(plain, JsonNativeRows { points: [v(1.0, 2.0), v(3.5, -4.0)] })
    json_record_write_agrees(plain, JsonNestedNativeRows { bounds: [JsonNativeBounds { min: v(1.0, 2.0), max: v(3.0, 4.0) }] })
    json_record_write_agrees(plain, JsonNativeBounds { min: v(1.0, 2.0), max: v(3.0, 4.0) })
    let key = Key { namespace: "sample", name: "record" }
    let marker = Marker { point: Point { x: 7, y: -3 }, tint: Tint { red: 0.25, visible: false } }
    let adapted = JsonRecordCodec { adapters: [json_record_adapter(Kind::First, kind_encode, kind_decode),
        json_record_adapter(marker, marker_encode, marker_decode)] }
    let packet = Packet { kind: Kind::Second, tint: Tint { red: 0.5, visible: false }, spare: null, marker, backup: marker,
        rows: [Label { name: "first", marker, key }, Label { name: "empty", marker: null, key }] }
    json_record_write_agrees(adapted, packet)
    json_record_write_agrees(plain, packet)
    let weights: Map<string, float> = map_new()
    weights["alpha"] = 1.25
    json_record_write_agrees(plain, ChangeLog { rows: [Change { event: ChangeEvent::Empty, count: 1 },
        Change { event: ChangeEvent::Pair(5, 2.5), count: 2 }, Change { event: ChangeEvent::Names(["a", "b"]), count: 3 }],
        title: null, weights, tint: ValueTint { red: 0.75, visible: false } })
}

@test
fn json_raw_places_written_records_into_a_document() {
    let codec = JsonRecordCodec {}
    let record = Record { event: Event::Pair("count", 7), envelope: Wrapper::Other("o"), optional: null }
    let tree: Map<string, JsonValue> = map_new()
    let raw: Map<string, JsonValue> = map_new()
    tree["record"] = json_record_encode(codec, record)
    raw["record"] = json_raw(json_record_write(codec, record))
    for document in [tree, raw] { document["after"] = json_int(1) }
    assert_eq(json_encode(json_object(raw)), json_encode(json_object(tree)))
    assert_eq(json_encode(json_array([json_raw("[1,2]"), json_null()])), "[[1,2],null]")
    assert_eq(json_encode_pretty(json_object(raw)), "{{\"after\":1,\"record\":" + json_record_write(codec, record) + "}}")
    assert(json_raw("1") == json_raw("1") && json_raw("1") != json_int(1))
    assert(json_as_object(json_raw("{{}}")) == null)
    let holder = json_record_decode<JsonRawHolder>(codec, json_object(raw)).unwrap()
    assert(holder.record == record && holder.after == 1)
    assert(json_record_decode<Record>(codec, json_raw(json_record_write(codec, record))).unwrap() == record)
    let rows = json_record_decode<JsonRawRows>(codec, json_decode("{{\"rows\":[]}}").unwrap()).unwrap()
    assert(rows.rows.len() == 0)
    let listed = json_record_decode<JsonRawRows>(codec, json_object({
        let fields: Map<string, JsonValue> = map_new()
        fields["rows"] = json_array([json_raw(json_record_write(codec, record))])
        fields
    })).unwrap()
    assert(listed.rows[0] == record)
    raw["record"] = json_raw("[\"Pair\"")
    assert(json_record_decode<JsonRawHolder>(codec, json_object(raw)) == null)
}

struct JsonRawHolder { record: Record, after: int }
struct JsonRawRows { rows: [Record] }

@test
fn json_record_reused_codec_follows_adapter_changes() {
    let codec = JsonRecordCodec { adapters: [json_record_adapter(Kind::First, k => json_str("one"), w => Kind::First)] }
    let doc = JsonKindHolder { kind: Kind::Second, marker: v(1.0, 2.0) }
    assert_eq(json_record_write(codec, doc), json_encode(json_record_encode(codec, doc)))
    assert(json_encode(json_record_encode(codec, doc)).contains("\"one\""))
    codec.adapters[0] = json_record_adapter(Kind::First, k => json_str("two"), w => Kind::Second)
    assert(json_record_write(codec, doc).contains("\"two\""))
    assert(json_encode(json_record_encode(codec, doc)).contains("\"two\""))
    assert(json_record_decode<JsonKindHolder>(codec, json_record_encode(codec, doc)).unwrap().kind == Kind::Second)
    codec.adapters.push(json_record_adapter(v(0.0, 0.0), p => json_int(7), w => v(0.0, 0.0)))
    assert_eq(json_record_write(codec, doc), "{{\"kind\":\"two\",\"marker\":7}}")
    let _ = codec.adapters.pop()
    assert_eq(json_record_write(codec, doc), json_encode(json_record_encode(codec, doc)))
    assert(!json_record_write(codec, doc).contains("7"))

    let shared = JsonRecordCodec {}
    shared.adapters.push(json_record_adapter(Kind::First,
        k => json_raw(json_record_write(shared, Tint { red: 1.0, visible: k == Kind::Second })), w => Kind::First))
    let nested = "{{\"kind\":{{\"red\":1,\"visible\":true}},\"marker\":{{\"x\":1,\"y\":2}}}}"
    assert_eq(json_record_write(shared, doc), nested)
    assert_eq(json_encode(json_record_encode(shared, doc)), nested)
    assert_eq(json_record_write(shared, doc), nested)
}

struct JsonKindHolder { kind: Kind, marker: Vec2 }

value JsonKept { a: int, b: string }
value JsonKeptRow { kept: JsonKept, n: int }
struct JsonKeptRows { rows: [JsonKeptRow], single: JsonKeptRow }

@test
fn json_record_adapters_keep_the_values_they_receive() {
    let kept: [JsonKept] = []
    let codec = JsonRecordCodec { adapters: [json_record_adapter(JsonKept { a: 0, b: "" }, value => {
        kept.push(value)
        return json_int(value.a)
    }, value => JsonKept { a: json_as_int(value) ?? return null, b: "" })] }
    let source = JsonKeptRows { rows: [JsonKeptRow { kept: JsonKept { a: 1, b: "2" }, n: 3 },
        JsonKeptRow { kept: JsonKept { a: 4, b: "5" }, n: 6 }], single: JsonKeptRow { kept: JsonKept { a: 7, b: "8" }, n: 9 } }
    let text = json_record_write(codec, source)
    let _ = json_record_encode(codec, source)
    assert(text == "{{\"rows\":[{{\"kept\":1,\"n\":3}},{{\"kept\":4,\"n\":6}}],\"single\":{{\"kept\":7,\"n\":9}}}}", text)
    assert(kept.len() == 6)
    for i in 0..3 {
        assert(kept[i] == kept[i + 3])
    }
    assert(kept[0] == JsonKept { a: 1, b: "2" } && kept[1] == JsonKept { a: 4, b: "5" } && kept[2] == JsonKept { a: 7, b: "8" })
}

nobox value JsonGridPoint { x: int, y: int }
value JsonBoxedPoint { x: int, y: int }
enum JsonStep { Wait, Turn(int), Slide { dx: float, dy: float } }
enum JsonHit { Struck { damage: int, at: JsonGridPoint, from: JsonBoxedPoint, echo: JsonGridPoint? }, Missed, Named(string) }
struct JsonShapes {
    steps: Vec<JsonStep>,
    step: JsonStep,
    hits: Vec<JsonHit>,
    hit: JsonHit,
    points: Map<string, JsonGridPoint>,
    step_names: Map<string, JsonStep>,
}

fn json_shapes_round_trip(codec: JsonRecordCodec, value: JsonShapes, text: string) -> JsonShapes {
    assert_eq(json_record_write(codec, value), text)
    assert_eq(json_encode(json_record_encode(codec, value)), text)
    let back = json_record_decode(codec, json_decode(text).unwrap(), value).unwrap()
    assert_eq(json_record_write(codec, back), text)
    let read: JsonShapes = json_record_read(codec, json_reader_decode(text).unwrap()).unwrap()
    assert_eq(json_record_write(codec, read), text)
    return back
}

@test
fn json_record_native_enums_value_maps_and_record_payloads() {
    let points: Map<string, JsonGridPoint> = map_new()
    points["a"] = JsonGridPoint { x: 1, y: 2 }
    points["gone"] = JsonGridPoint { x: 0, y: 0 }
    points["b"] = JsonGridPoint { x: 3, y: 4 }
    points.remove("gone")
    let step_names: Map<string, JsonStep> = map_new()
    step_names["t"] = JsonStep::Turn(2)
    let struck = JsonHit::Struck { damage: 5, at: JsonGridPoint { x: 6, y: 7 }, from: JsonBoxedPoint { x: 8, y: 9 }, echo: JsonGridPoint { x: 1, y: 1 } }
    let value = JsonShapes {
        steps: [JsonStep::Wait, JsonStep::Turn(3), JsonStep::Slide { dx: 1.5, dy: -2.0 }],
        step: JsonStep::Slide { dx: 0.5, dy: 1.0 },
        hits: [JsonHit::Struck { damage: 1, at: JsonGridPoint { x: 2, y: 3 }, from: JsonBoxedPoint { x: 4, y: 5 }, echo: null },
            JsonHit::Missed, JsonHit::Named("n")],
        hit: struck,
        points,
        step_names,
    }
    let text = "{{\"hit\":[\"Struck\",{{\"at\":{{\"x\":6,\"y\":7}},\"damage\":5,\"echo\":{{\"x\":1,\"y\":1}},\"from\":{{\"x\":8,\"y\":9}}}}],"
        + "\"hits\":[[\"Struck\",{{\"at\":{{\"x\":2,\"y\":3}},\"damage\":1,\"echo\":null,\"from\":{{\"x\":4,\"y\":5}}}}],[\"Missed\"],[\"Named\",\"n\"]],"
        + "\"points\":{{\"a\":{{\"x\":1,\"y\":2}},\"b\":{{\"x\":3,\"y\":4}}}},"
        + "\"step\":[\"Slide\",{{\"dx\":0.5,\"dy\":1}}],"
        + "\"step_names\":{{\"t\":[\"Turn\",2]}},"
        + "\"steps\":[[\"Wait\"],[\"Turn\",3],[\"Slide\",{{\"dx\":1.5,\"dy\":-2}}]]}}"
    let back = json_shapes_round_trip(JsonRecordCodec {}, value, text)
    assert(back.hit == struck)
    assert(back.steps[2] == JsonStep::Slide { dx: 1.5, dy: -2.0 })
    back.points["c"] = JsonGridPoint { x: 5, y: 6 }
    back.points.remove("a")
    assert(back.points.len() == 2 && back.points["b"] == JsonGridPoint { x: 3, y: 4 } && back.points["c"] == JsonGridPoint { x: 5, y: 6 })

    let strict = JsonRecordCodec { reject_unknown_fields: true }
    let unknown = "{{\"dx\":1,\"dy\":2,\"dz\":3}}"
    assert(json_record_decode(strict, json_decode("[\"Slide\",{unknown}]").unwrap(), value.step) == null)
    assert(json_record_decode(JsonRecordCodec {}, json_decode("[\"Slide\",{{\"dx\":1}}]").unwrap(), value.step) == null)
    assert(json_record_decode(JsonRecordCodec {}, json_decode("[\"Struck\",{{\"damage\":1}}]").unwrap(), struck) == null)
}
