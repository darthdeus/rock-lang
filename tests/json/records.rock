// JSON records: wire names, presence, diagnostics and native arrays.

struct JsonNamedRecord {
    @json_name("wire_name")
    name: string,
}

@test
fn json_record_uses_declared_wire_names_in_both_directions() {
    let codec = JsonRecordCodec { reject_unknown_fields: true }
    let value = JsonNamedRecord { name: "example" }
    let wire = json_record_encode(codec, value)
    assert_eq(json_as_str(json_field(wire, "wire_name").unwrap()).unwrap(), "example")
    assert(json_field(wire, "name") == null)
    assert_eq(json_record_decode(codec, wire, value).unwrap().name, "example")
    let errors: [JsonRecordError] = []
    codec.on_error = error => errors.push(error)
    assert(json_record_decode(codec, json_decode("{{\"wire_name\":false}}").unwrap(), value) == null)
    assert_eq(errors[0].path, "/wire_name")
}

struct JsonEscapedNameRecord {
    @json_name("a/b~c\"\\\n")
    value: int,
}

@test
fn json_record_wire_names_escape_source_and_error_paths() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { reject_unknown_fields: true, on_error: error => errors.push(error) }
    let value = JsonEscapedNameRecord { value: 7 }
    let wire = json_record_encode(codec, value)
    assert_eq(json_as_int(json_field(wire, "a/b~c\"\\\n").unwrap()).unwrap(), 7)
    assert_eq(json_record_decode(codec, json_decode(json_encode(wire)).unwrap(), value).unwrap().value, 7)
    assert(json_record_decode(codec, json_object(map_new()), value) == null)
    assert_eq(errors[0].path, "/a~1b~0c\"\\\n")
}

struct JsonPresenceEdit {
    title: JsonField<string?>,
    count: JsonField<int>,
    items: JsonField<[int]>,
}

@test
fn json_record_presence_distinguishes_omitted_null_and_value() {
    let codec = JsonRecordCodec { reject_unknown_fields: true }
    let absent = json_record_decode<JsonPresenceEdit>(codec, json_decode("{{}}").unwrap()).unwrap()
    assert(!absent.title.present && !absent.count.present && !absent.items.present)
    assert_eq(json_encode(json_record_encode(codec, absent)), "{{}}")
    let cleared = json_record_decode<JsonPresenceEdit>(codec, json_decode("{{\"title\":null}}").unwrap()).unwrap()
    assert(cleared.title.present && cleared.title.value == null)
    assert_eq(json_encode(json_record_encode(codec, cleared)), "{{\"title\":null}}")
    let changed = json_record_decode<JsonPresenceEdit>(codec,
        json_decode("{{\"title\":\"new\",\"count\":0,\"items\":[]}}").unwrap()).unwrap()
    assert(changed.title.present && changed.title.value.unwrap() == "new")
    assert(changed.count.present && changed.count.value.unwrap() == 0)
    assert(changed.items.present && changed.items.value.unwrap().len() == 0)
    let copy = json_record_decode<JsonPresenceEdit>(codec, json_record_encode(codec, changed)).unwrap()
    assert_eq(copy, changed)
}

@test
fn json_record_presence_rejects_invalid_supplied_values_with_paths() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { reject_unknown_fields: true, on_error: error => errors.push(error) }
    for bad in ["{{\"count\":null}}", "{{\"count\":1.5}}", "{{\"count\":false}}"] {
        assert(json_record_decode<JsonPresenceEdit>(codec, json_decode(bad).unwrap()) == null)
        assert_eq(errors[errors.len() - 1].path, "/count")
    }
    assert(json_record_decode<JsonPresenceEdit>(codec, json_decode("{{\"items\":[1,false]}}").unwrap()) == null)
    assert_eq(errors[errors.len() - 1].path, "/items/1")
    assert(json_record_decode<JsonPresenceEdit>(codec, json_decode("{{\"extra\":0}}").unwrap()) == null)
    assert_eq(errors[errors.len() - 1].path, "/extra")
}

nobox value JsonPresencePoint { x: int, y: int }

struct JsonPresenceNative { point: JsonField<JsonPresencePoint?> }

@test
fn json_record_presence_preserves_native_payloads() {
    let codec = JsonRecordCodec {}
    let edit = json_record_decode<JsonPresenceNative>(codec,
        json_decode("{{\"point\":{{\"x\":2,\"y\":3}}}}").unwrap()).unwrap()
    assert(edit.point.present)
    assert_eq(edit.point.value.unwrap().x, 2)
    assert_eq(edit.point.value.unwrap().y, 3)
    let copy = json_record_decode<JsonPresenceNative>(codec, json_record_encode(codec, edit)).unwrap()
    assert_eq(copy, edit)
}

struct JsonPresenceFlag {
    @json_name("enabled")
    flag: JsonField<bool>,
}

struct JsonPresenceNested {
    edit: JsonField<JsonPresenceEdit>,
    labels: JsonField<Map<string, string>>,
}

@test
fn json_record_presence_composes_with_wire_names_nested_records_and_maps() {
    let codec = JsonRecordCodec { reject_unknown_fields: true }
    let flag = json_record_decode<JsonPresenceFlag>(codec, json_decode("{{\"enabled\":false}}").unwrap()).unwrap()
    assert(flag.flag.present && !flag.flag.value.unwrap())
    assert_eq(json_encode(json_record_encode(codec, flag)), "{{\"enabled\":false}}")
    let wire = json_decode("{{\"edit\":{{\"title\":null}},\"labels\":{{\"keep\":\"yes\"}}}}").unwrap()
    let edit = json_record_decode<JsonPresenceNested>(codec, wire).unwrap()
    assert(edit.edit.present && edit.edit.value.unwrap().title.present)
    assert(edit.edit.value.unwrap().title.value == null)
    assert(edit.labels.present && edit.labels.value.unwrap().contains("keep"))
    assert_eq(json_encode(json_record_encode(codec, edit)), json_encode(wire))
}

struct JsonDiagnosticRow { count: int }

struct JsonDiagnosticRoot { rows: [JsonDiagnosticRow] }

@test
fn json_record_reports_nested_failure() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { on_error: error => errors.push(error) }
    let value = json_decode("{{\"rows\":[{{\"count\":\"wrong\"}}]}}").unwrap()
    assert(json_record_decode(codec, value, JsonDiagnosticRoot { rows: [] }) == null)
    assert_eq(errors.len(), 1)
    assert_eq(errors[0].path, "/rows/0/count")
    assert_eq(errors[0].expected, "int")
    assert_eq(errors[0].actual, "Str")
}

struct JsonDiagnosticMap { values: Map<string, JsonDiagnosticRow> }

@test
fn json_record_reports_missing_fields_and_escaped_map_keys() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { on_error: error => errors.push(error) }
    let value = json_decode("{{\"values\":{{\"a/b~c\":{{}}}}}}").unwrap()
    assert(json_record_decode(codec, value, JsonDiagnosticMap { values: map_new() }) == null)
    assert_eq(errors.len(), 1)
    assert_eq(errors[0].path, "/values/a~1b~0c/count")
    assert_eq(errors[0].actual, "missing")
    assert_eq(errors[0].expected, "int")
    errors.clear()
    let valid = json_decode("{{\"values\":{{\"a\":{{\"count\":4}}}}}}").unwrap()
    let decoded = json_record_decode(codec, valid, JsonDiagnosticMap { values: map_new() }).unwrap()
    assert_eq(decoded.values.get("a").unwrap().count, 4)
    assert_eq(errors.len(), 0)
    assert_eq(json_encode(json_record_encode(codec, decoded)), json_encode(valid))
    assert(json_record_decode(JsonRecordCodec {}, value, JsonDiagnosticMap { values: map_new() }) == null)
}

enum JsonDiagnosticChoice { Count(int), Empty }

struct JsonDiagnosticEnum { choice: JsonDiagnosticChoice }

@test
fn json_record_reports_enum_payload_and_root_failures() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { on_error: error => errors.push(error) }
    let value = json_decode("{{\"choice\":[\"Count\",false]}}").unwrap()
    assert(json_record_decode(codec, value, JsonDiagnosticEnum { choice: JsonDiagnosticChoice::Empty }) == null)
    assert_eq(errors[0].path, "/choice/1")
    assert_eq(errors[0].expected, "int")
    errors.clear()
    assert(json_record_decode(codec, json_null(), JsonDiagnosticRoot { rows: [] }) == null)
    assert_eq(errors.len(), 1)
    assert_eq(errors[0].path, "")
    assert_eq(errors[0].actual, "Null")
}

@test
fn json_record_can_reject_unknown_fields_without_a_second_schema() {
    let errors: [JsonRecordError] = []
    let codec = JsonRecordCodec { reject_unknown_fields: true, on_error: error => errors.push(error) }
    let value = json_decode("{{\"rows\":[{{\"count\":4,\"cout\":5}}]}}").unwrap()
    assert(json_record_decode(codec, value, JsonDiagnosticRoot { rows: [] }) == null)
    assert_eq(errors[0].path, "/rows/0/cout")
    assert_eq(errors[0].actual, "unknown field")
    assert(json_record_decode(JsonRecordCodec {}, value, JsonDiagnosticRoot { rows: [] }) != null)
}

struct JsonNativeRows { points: [Vec2] }

@test
fn json_record_native_array_uses_the_compiler_container_layout() {
    let codec = JsonRecordCodec {}
    let source = JsonNativeRows { points: [v(1.0, 2.0), v(3.0, 4.0)] }
    let encoded = json_record_encode(codec, source)
    let result = json_record_decode(codec, encoded, source).unwrap()
    assert_eq(result.points.len(), 2)
    assert_eq(result.points[1].x, 3.0)
    result.points.push(v(5.0, 6.0))
    assert_eq(result.points[2].y, 6.0)
    let empty = json_record_decode(codec, json_decode("{{\"points\":[]}}").unwrap(), source).unwrap()
    empty.points.push(v(7.0, 8.0))
    assert_eq(empty.points[0].x, 7.0)
}

nobox value JsonNativeBounds { min: Vec2, max: Vec2 }

struct JsonNestedNativeRows { bounds: [JsonNativeBounds] }

@test
fn json_record_native_root_owns_its_wire_materialization() {
    let source = JsonNativeBounds { min: v(1.0, 2.0), max: v(3.0, 4.0) }
    let wire = json_record_encode(JsonRecordCodec {}, source)
    assert_eq(json_as_float(json_field(json_field(wire, "max").unwrap(), "y").unwrap()).unwrap(), 4.0)
    let result = json_record_decode<JsonNativeBounds>(JsonRecordCodec {}, wire).unwrap()
    assert_eq(result.min.x, 1.0)
    assert_eq(result.max.y, 4.0)
}

@test
fn json_record_nested_native_array_keeps_all_leaf_paths() {
    let source = JsonNestedNativeRows { bounds: [JsonNativeBounds { min: v(1.0, 2.0), max: v(3.0, 4.0) }] }
    let codec = JsonRecordCodec {}
    let result = json_record_decode<JsonNestedNativeRows>(codec, json_record_encode(codec, source)).unwrap()
    assert_eq(result.bounds[0].max.y, 4.0)
    result.bounds.push(JsonNativeBounds { min: v(5.0, 6.0), max: v(7.0, 8.0) })
    assert_eq(result.bounds[1].min.x, 5.0)
}

@test
fn json_record_native_array_respects_element_wire_adapters() {
    let codec = JsonRecordCodec { adapters: [json_record_adapter(v(0.0, 0.0),
        point => json_array([json_float(point.x), json_float(point.y)]),
        value => {
            let parts = json_as_array(value) ?? return null
            if parts.len() != 2 { return null }
            return v(json_record_finite_float(parts[0]) ?? return null,
                json_record_finite_float(parts[1]) ?? return null)
        })] }
    let source = JsonNativeRows { points: [v(1.0, 2.0)] }
    let wire = json_record_encode(codec, source)
    let point = json_as_array(json_as_array(json_field(wire, "points").unwrap()).unwrap()[0]).unwrap()
    assert_eq(point.len(), 2)
    let result = json_record_decode<JsonNativeRows>(codec, wire).unwrap()
    assert_eq(result.points[0].x, 1.0)
}
