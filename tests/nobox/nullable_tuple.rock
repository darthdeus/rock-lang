// A nullable TUPLE whose element is a `nobox` value -- `(NV, int)?`.
//
// The wire is a presence bool leading one slot per element, and a `let` binds
// that wire cell-wise (`tuple_binds`) instead of packing it. Packing is what
// used to happen, and it failed twice over: it boxed the `nobox` element, and a
// packed tuple is structurally never nil, so `t == null` answered `false` on the
// absent arm.
//
// `?.` is NOT the discriminant. A safe-nav yielding a tuple and a plain call
// declared `-> (NV, int)?` reached the same missing `let` arm; the safe-nav case
// only additionally needed its JOIN to mint a presence tag, since no callee puts
// one on that wire.
//
// The whole-tuple ESCAPE stays a rejection by design -- `print("{t}")` packs,
// which is exactly how the guarantee stays honest. Pinned in
// `tests/errors/nobox_container_gaps.rock.err`.

nobox value NV { x: int, y: int }

value BV { x: int, y: int }

struct Holder { v: NV, n: int }

fn Holder.wire2(h) -> (NV, int) { return (h.v, h.n) }

fn Holder.maybe2(h) -> (NV, int)? {
    if h.n > 0 { return (h.v, h.n) }
    return null
}

fn pick(b: bool) -> Holder? {
    if b { return Holder { v: NV { x: 3, y: 6 }, n: 7 } }
    return null
}

fn maybe(b: bool) -> (NV, int)? {
    if b { return (NV { x: 3, y: 6 }, 1) }
    return null
}

// --- a declared `-> (..)?` bound by `let` ---

@test(returns = 1)
fn declared_nullable_tuple_binds_present() -> int {
    let t = maybe(true)
    if t == null { return -1 }
    return 1
}

@test(returns = 1)
fn declared_nullable_tuple_binds_absent() -> int {
    let t = maybe(false)
    if t == null { return 1 }
    return -1
}

@test(returns = 10)
fn a_bound_nullable_tuple_projects_its_slots() -> int {
    let t = maybe(true)
    if t == null { return -1 }
    return t.0.x + t.0.y + t.1
}

// --- `?.` yielding a tuple ---

@test(returns = 1)
fn safe_nav_tuple_present() -> int {
    let t = pick(true)?.wire2()
    if t == null { return -1 }
    return 1
}

@test(returns = 1)
fn safe_nav_tuple_absent_receiver() -> int {
    let t = pick(false)?.wire2()
    if t == null { return 1 }
    return -1
}

@test(returns = 16)
fn safe_nav_tuple_projects_its_slots() -> int {
    let t = pick(true)?.wire2()
    if t == null { return -1 }
    return t.0.x + t.0.y + t.1
}

// Both links are absence: the receiver is present but the method returns null,
// so the join forwards the CALLEE's presence tag rather than minting `true`.
@test(returns = 1)
fn safe_nav_forwards_the_callees_own_absence() -> int {
    let h: Holder? = Holder { v: NV { x: 3, y: 6 }, n: 0 }
    let t = h?.maybe2()
    if t == null { return 1 }
    return -1
}

// --- forwarding a nullable tuple straight out of a `-> (..)?` fn ---

fn fwd(b: bool) -> (NV, int)? { return maybe(b) }

@test(returns = 1)
fn forwarding_preserves_absence() -> int {
    if fwd(true) == null { return -1 }
    if fwd(false) == null { return 1 }
    return -1
}

fn fwd_bound(b: bool) -> (NV, int)? {
    let t = maybe(b)
    return t
}

@test(returns = 1)
fn forwarding_a_bound_wire_preserves_absence() -> int {
    if fwd_bound(true) == null { return -1 }
    if fwd_bound(false) == null { return 1 }
    return -1
}

// --- `if let` ---

@test(returns = 9)
fn if_let_binds_a_present_nullable_tuple() -> int {
    if let t = maybe(true) { return t.0.x + t.0.y } else { return -1 }
}

@test(returns = 1)
fn if_let_misses_an_absent_nullable_tuple() -> int {
    if let t = pick(false)?.wire2() { return t.1 } else { return 1 }
}

// A DESTRUCTURING pattern is the same wire, and it used to miss the presence
// slot entirely: only `Pattern::Bind` took the wire-aware path, so `(v, n)` fell
// through to the boxed one, where the nil test is against a `MakeTuple` that is
// never nil -- always-present, else arm deleted, absent arm reading nil leaves.
// A hole is names-only too, and still consumes its slots.

@test(returns = 10)
fn if_let_destructures_a_present_nullable_tuple() -> int {
    if let (v, n) = maybe(true) { return v.x + v.y + n } else { return -1 }
}

@test(returns = 1)
fn if_let_destructuring_misses_an_absent_one() -> int {
    if let (v, n) = maybe(false) { return v.x + n } else { return 1 }
}

@test(returns = 3)
fn a_hole_consumes_its_slots() -> int {
    if let (v, _) = maybe(true) { return v.x } else { return -1 }
}

@test(returns = 1)
fn a_hole_does_not_make_an_absent_tuple_present() -> int {
    if let (v, _) = maybe(false) { return v.x } else { return 1 }
}

// --- `??` ---
//
// The lhs presence SLOT is the branch condition. Going through the boxed path
// instead const-folded the test away (a `MakeTuple` is never nil), deleted the
// rhs arm, and yielded the ABSENT wire's nil leaves.

@test(returns = 27)
fn coalesce_takes_the_default_when_absent() -> int {
    let t = maybe(false) ?? (NV { x: 9, y: 9 }, 9)
    return t.0.x + t.0.y + t.1
}

@test(returns = 10)
fn coalesce_keeps_the_value_when_present() -> int {
    let t = maybe(true) ?? (NV { x: 9, y: 9 }, 9)
    return t.0.x + t.0.y + t.1
}

// --- reassignment ---
//
// A rebind writes the slot cells, presence included -- the tuple twin of the
// scalarized-value binding, which has always had this path.

@test(returns = 1)
fn reassigning_a_bound_wire_updates_its_presence() -> int {
    let t = maybe(true)
    t = maybe(false)
    if t == null { return 1 }
    return -1
}

@test(returns = 10)
fn reassigning_a_bound_wire_updates_its_slots() -> int {
    let t = maybe(false)
    t = maybe(true)
    if t == null { return -1 }
    return t.0.x + t.0.y + t.1
}

// --- controls ---
//
// An UNMARKED value and a plain primitive tuple take the same path and must
// answer identically: the mark changes whether a box is legal, not what the
// program computes.

fn maybe_bv(b: bool) -> (BV, int)? {
    if b { return (BV { x: 3, y: 6 }, 1) }
    return null
}

@test(returns = 1)
fn unmarked_value_element_answers_the_same() -> int {
    let t = maybe_bv(true)
    let u = maybe_bv(false)
    if t == null { return -1 }
    if u != null { return -1 }
    return 1
}

fn maybe_ints(b: bool) -> (int, int)? {
    if b { return (3, 6) }
    return null
}

@test(returns = 1)
fn primitive_tuple_answers_the_same() -> int {
    let t = maybe_ints(true)
    let u = maybe_ints(false)
    if t == null { return -1 }
    if u != null { return -1 }
    return 1
}

// `materialize` of a nullable tuple is an escape, so an absent value boxes to
// `nil`, never to a statically non-nil tuple (the
// `materialize(line_intersects_circle(..))` null-check shape).
@test(returns = 1)
fn materialize_keeps_an_absent_nullable_tuple_absent() -> int {
    if materialize(maybe(false)) == null { return 1 }
    return 0
}

@test(returns = 4)
fn materialize_boxes_a_present_nullable_tuple() -> int {
    let t = materialize(maybe(true)) ?? return 0
    return t.0.x + t.1
}

// ======== As a RETURN ========
//
// A NULLABLE tuple return whose element is a `nobox` value: `-> (NV2, float)?`.
// The plain tuple form is covered by `tests/nobox/tuple.rock`; the `?` is
// a separate wire, because a multi-value boundary must carry the null
// discriminant alongside the splatted slots rather than boxing the whole tuple.
// It leads: `present, <slots...>`, absent as `false, nil, ...` -- the same
// convention `ValueShape::nullable` uses one level down.
//
// Live shape: `stone/engine/systems/shapes.rock`'s `line_intersects_circle` /
// `line_intersects_rect`, both `-> (Vec2, float)?` consumed as
// `if let hit_info = ...`.

nobox value NV2 { x: float, y: float }

value BV2 { x: float, y: float }

fn hit(a: float) -> (NV2, float)? {
    if a < 0.0 { return null }
    return (NV2 { x: a, y: a * 2.0 }, a * 10.0)
}

// Nobox element SECOND, so presence and the leaves are not adjacent in the
// trivial way.
fn hit_tail(a: float) -> (float, NV2)? {
    if a < 0.0 { return null }
    return (a * 10.0, NV2 { x: a, y: a * 2.0 })
}

fn hit_boxed(a: float) -> (BV2, float)? {
    if a < 0.0 { return null }
    return (BV2 { x: a, y: a * 2.0 }, a * 10.0)
}

@test(returns = 13)
fn present_binds_leaves() -> int {
    if let t = hit(1.0) {
        return (t.0.x + t.0.y + t.1) as int
    }
    return -1
}

@test(returns = 1)
fn absent_is_null() -> int {
    if hit(-1.0) == null { return 1 }
    return -2
}

@test(returns = 1)
fn present_is_not_null() -> int {
    if hit(1.0) != null { return 1 }
    return -2
}

@test(returns = 13)
fn present_binds_leaves_in_tail_position() -> int {
    if let t = hit_tail(1.0) {
        return (t.0 + t.1.x + t.1.y) as int
    }
    return -1
}

@test(returns = 1)
fn absent_is_null_in_tail_position() -> int {
    if hit_tail(-1.0) == null { return 1 }
    return -2
}

// The asymmetry guard: an UNMARKED value keeps the single boxed tuple, so the
// same source still round-trips both ways and the wire above stays off.
@test(returns = 13)
fn unmarked_element_still_round_trips() -> int {
    if let t = hit_boxed(1.0) {
        return (t.0.x + t.0.y + t.1) as int
    }
    return -1
}

@test(returns = 1)
fn unmarked_absent_is_null() -> int {
    if hit_boxed(-1.0) == null { return 1 }
    return -2
}

// ======== At a fn PARAM ========
//
// A NULLABLE tuple carrying a `nobox` value at a fn PARAM.
//
// Was `nullable_tuple_of_a_nobox_at_a_PARAM_Generic` in
// `nobox_container_gaps.rock.err`. The RETURN side already put a presence bool
// ahead of the slots (the let and return sections above); the param side spelled
// the same wire but `tuple_param_slot` only admitted a bare `TypeExpr::Tuple`,
// so a `(PNV, int)?` param fell to `Opaque` and the argument packed to fill it.
//
// The presence rides the param list exactly as it rides the return: one leading
// slot, then the element slots, absent being `false` plus nils.

nobox value PNV { x: float, y: float }

value UNV { x: float, y: float }

fn param_maybe(b: bool) -> (PNV, float)? {
    if b { return (PNV { x: 1.0, y: 3.0 }, 10.0) }
    return null
}

fn describe(t: (PNV, float)?) -> float {
    if t == null { return -1.0 }
    return t.0.y + t.1
}

@test(returns = 13.0)
fn a_present_nullable_tuple_crosses_a_direct_call() -> float {
    return describe(param_maybe(true))
}

@test(returns = -1.0)
fn an_absent_one_arrives_absent() -> float {
    return describe(param_maybe(false))
}

@test(returns = -1.0)
fn a_bare_null_literal_fills_the_wire() -> float {
    return describe(null)
}

@test(returns = 13.0)
fn a_tuple_literal_is_present_without_a_callee() -> float {
    return describe((PNV { x: 1.0, y: 3.0 }, 10.0))
}

@test(returns = 13.0)
fn the_argument_bound_to_a_local_first() -> float {
    let t = param_maybe(true)
    return describe(t)
}

// `if let` inside the callee reads the presence the param carried, rather than
// re-deriving it from a box that is not there.
fn via_if_let(t: (PNV, float)?) -> float {
    if let (v, n) = t { return v.x + n }
    return -1.0
}

@test(returns = 11.0)
fn the_callee_can_if_let_its_own_param() -> float {
    return via_if_let(param_maybe(true))
}

@test(returns = -1.0)
fn the_same_if_let_on_an_absent_param() -> float {
    return via_if_let(param_maybe(false))
}

// Forwarding: the param's own cells feed the next call's slots, with no box in
// between.
fn forward(t: (PNV, float)?) -> float { return describe(t) }

@test(returns = 13.0)
fn a_param_forwards_to_another_param() -> float {
    return forward(param_maybe(true))
}

@test(returns = -1.0)
fn an_absent_param_forwards_absent() -> float {
    return forward(param_maybe(false))
}

// A `??` in the callee consumes the presence dynamically.
fn coalesced(t: (PNV, float)?) -> float {
    let s = t ?? (PNV { x: 7.0, y: 8.0 }, 100.0)
    return s.0.x + s.1
}

@test(returns = 107.0)
fn the_callee_coalesces_an_absent_param() -> float {
    return coalesced(param_maybe(false))
}

@test(returns = 11.0)
fn the_callee_coalesces_a_present_param() -> float {
    return coalesced(param_maybe(true))
}

// NAMED args place a splatting param by slot, so the nil-fill width has to be
// the slot's -- presence included.
fn keyed(k: float, t: (PNV, float)?) -> float { return describe(t) + k }

@test(returns = 113.0)
fn a_nullable_tuple_param_places_by_name() -> float {
    return keyed(t: param_maybe(true), k: 100.0)
}

@test(returns = 99.0)
fn an_absent_one_places_by_name_too() -> float {
    return keyed(t: param_maybe(false), k: 100.0)
}

// The three definition forms share `bind_param_slot`, so all three bind the
// presence cell.
@test(returns = 13.0)
fn a_nested_fn_binds_the_presence_cell() -> float {
    fn inner(t: (PNV, float)?) -> float {
        if t == null { return -1.0 }
        return t.0.y + t.1
    }
    return inner(param_maybe(true))
}

@test(returns = -1.0)
fn the_nested_fn_on_an_absent_argument() -> float {
    fn inner(t: (PNV, float)?) -> float {
        if t == null { return -1.0 }
        return t.0.y + t.1
    }
    return inner(param_maybe(false))
}

fn apply(g: ((PNV, float)?) -> float, t: (PNV, float)?) -> float { return g(t) }

@test(returns = 13.0)
fn the_wire_survives_a_fn_VALUE_param() -> float {
    return apply(describe, param_maybe(true))
}

@test(returns = -1.0)
fn the_absent_wire_survives_a_fn_VALUE_param() -> float {
    return apply(describe, param_maybe(false))
}

@test(returns = 13.0)
fn the_same_through_a_lambda() -> float {
    return apply(t => if t == null { -1.0 } else { t.0.y + t.1 }, param_maybe(true))
}

@test(returns = -1.0)
fn the_absent_wire_through_a_lambda() -> float {
    return apply(t => if t == null { -1.0 } else { t.0.y + t.1 }, param_maybe(false))
}

// The control that scopes the mechanism: the UNMARKED twin always compiled and
// must keep its single boxed slot -- only a `nobox` element splats, so this
// asserts the ABI did NOT move underneath it.
fn u_maybe(b: bool) -> (UNV, float)? {
    if b { return (UNV { x: 1.0, y: 3.0 }, 10.0) }
    return null
}

fn u_describe(t: (UNV, float)?) -> float {
    if t == null { return -1.0 }
    return t.0.y + t.1
}

@test(returns = 13.0)
fn an_unmarked_nullable_tuple_param_still_works() -> float {
    return u_describe(u_maybe(true))
}

@test(returns = -1.0)
fn the_unmarked_absent_one_still_works() -> float {
    return u_describe(u_maybe(false))
}
