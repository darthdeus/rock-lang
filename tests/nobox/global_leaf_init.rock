// Nobox globals initialize their leaf storage through the multi-value ABI.

nobox value P { x: int, y: int }

fn mk(a: int, b: int) -> P { return P { x: a, y: b } }

global G_CALL: P = mk(5, 7)
global G_WIDE: Q = Q { a: 1, b: 2, c: 3, d: 4 }

nobox value Q { a: int, b: int, c: int, d: int }

@test fn nobox_global_initialized_from_a_call() {
    assert_eq(G_CALL.x, 5)
    assert_eq(G_CALL.y, 7)
}

@test fn nobox_global_wider_than_the_first_bank_slot() {
    assert_eq(G_WIDE.a, 1)
    assert_eq(G_WIDE.b, 2)
    assert_eq(G_WIDE.c, 3)
    assert_eq(G_WIDE.d, 4)
}

// Initialization dependencies must resolve leaf reads back to their owner.
global DERIVED: P = BASE
global BASE: P = P { x: 3, y: 4 }

@test fn nobox_global_initialized_from_a_LATER_nobox_global() {
    assert_eq(DERIVED.x, 3)
    assert_eq(DERIVED.y, 4)
}

// The same dependency can be reached through a call.
fn later_sum() -> int { return LATER.x + LATER.y }

global VIA_CALL: int = later_sum()
global LATER: P = P { x: 5, y: 6 }

@test fn init_reading_nobox_leaves_through_a_call_runs_after_their_global() {
    assert_eq(VIA_CALL, 11)
}

@test fn nobox_global_reassigned_after_init() {
    G_CALL = mk(11, 13)
    assert_eq(G_CALL.x, 11)
    assert_eq(G_CALL.y, 13)
    G_CALL = mk(5, 7)
}

nobox value TrustV2 { x: float, y: float }

@lua_named struct TrustHolder { p: TrustV2, tag: int }

global TRUST_HOLDER: TrustHolder = TrustHolder { p: TrustV2 { x: 1.0, y: 1.0 }, tag: 1 }

@nomangle inline(lua) fn trust_poke_field_and_sibling() = """
    TRUST_HOLDER.p = TrustV2_ct(9.0, 9.0)
    TRUST_HOLDER.tag = 99
"""

// The opaque write misses the flattened leaves. Keep both sides visible:
// the neighboring scalar updates, and the value field keeps its old value.
@test(backends = "lua")
fn opaque_nobox_write_misses_the_leaves() {
    trust_poke_field_and_sibling()
    assert_eq(TRUST_HOLDER.p.x, 1.0)
    assert_eq(TRUST_HOLDER.tag, 99)
}
