// Presence of nullable nobox values: merges, phi returns, absent tags, tuple
// options, inline child projections, the concrete-shape operations (null test,
// refined field read, fn-value crossing) and `== null` results consumed as
// booleans in every position.

nobox value P { x: int, y: int }

fn merged(present: bool) -> P? {
    let v: P? = if present { P { x: 5, y: 6 } } else { null }
    return v
}

@test
fn merge_reports_presence() {
    assert(merged(false) == null)
    assert(merged(true) != null)
}

@test(returns = 56)
fn present_merge_carries_its_leaves() -> int {
    let p = merged(true)
    if p == null { return -1 }
    return p.x * 10 + p.y
}

// The merge as the returned EXPRESSION, with no local to land in.
fn merged_no_local(present: bool) -> P? {
    return if present { P { x: 7, y: 8 } } else { null }
}

@test
fn merge_without_a_local() {
    assert(merged_no_local(false) == null)
    let p = merged_no_local(true)
    if p == null { assert(false) } else { assert_eq(p.x * 10 + p.y, 78) }
}

// A merge whose present arm is COMPUTED rather than a literal: the leaves reach
// the join from a call, not from constants the emitter could fold.
fn make(a: int) -> P { return P { x: a, y: a + 1 } }

fn merged_computed(present: bool, a: int) -> P? {
    let v: P? = if present { make(a) } else { null }
    return v
}

@test
fn merge_of_a_computed_arm() {
    let p = merged_computed(true, 3)
    if p == null { assert(false) } else { assert_eq(p.x * 10 + p.y, 34) }
    assert(merged_computed(false, 3) == null)
}

// Safe navigation off the merged value, which reads presence and a leaf in one
// expression rather than through a refinement.
@test
fn safe_nav_off_a_merge() {
    assert_eq(merged(true)?.x ?? -1, 5)
    assert_eq(merged(false)?.x ?? -1, -1)
}

// `materialize` of the merged value is a passenger: presence and leaves survive it.
fn merged_materialized(present: bool) -> P? {
    let v: P? = if present { P { x: 5, y: 6 } } else { null }
    return materialize(v)
}

@test
fn merge_through_materialize() {
    assert(merged_materialized(false) == null)
    let p = merged_materialized(true)
    if p == null { assert(false) } else { assert_eq(p.x * 10 + p.y, 56) }
    assert_eq(merged_materialized(true)?.x ?? -1, 5)
}

fn materialized_non_nullable() -> P { return materialize(P { x: 5, y: 6 }) }

@test(output = "5 6")
fn materialize_on_a_non_nullable_nobox_value_is_correct() {
    let p = materialized_non_nullable()
    print("{p.x} {p.y}")
}

nobox value NV2 { x: float, y: float }

fn absent() -> NV2? { return null }

// Leaf-table storage: every field is scalarizable.
value Opt { pos: NV2?, a: float }

global G: Opt = Opt { pos: null, a: 3.0 }

global H: Opt = Opt { pos: NV2 { x: 1.0, y: 2.0 }, a: 3.0 }

@test fn null_literal_and_null_assignment_store_the_same_tag() {
    H.pos = null
    assert(G == H)
    assert(H.pos == null)
}

@test fn an_absent_operand_stores_the_literal_tag() {
    let none: NV2? = absent()
    let a = Opt { pos: none, a: 3.0 }
    let b = Opt { pos: absent(), a: 3.0 }
    assert(a == G)
    assert(b == G)
    assert(a == b)
}

// A map stores its value's leaves in columns as they arrive, so the read-back
// tags keep their spelling and the comparison has to agree on absence.
@test fn map_column_reads_compare_equal_across_spellings() {
    let m: Map<string, Opt> = map_new()
    m.insert("call", Opt { pos: absent(), a: 3.0 })
    m.insert("global", G)
    assert(m.get("call") == m.get("global"))
    assert(m.get("call") == G)
}

// GC-table storage: an opaque field keeps the box from flattening.
value Named { pos: NV2?, name: string }

global NG: Named = Named { pos: null, name: "n" }

global NH: Named = Named { pos: NV2 { x: 1.0, y: 2.0 }, name: "n" }

@test fn gc_table_null_literal_and_null_assignment_store_the_same_tag() {
    NH.pos = null
    assert(NG == NH)
    assert(NH.pos == null)
}

@test fn gc_table_absent_operand_stores_the_literal_tag() {
    let none: NV2? = absent()
    let a = Named { pos: none, name: "n" }
    let b = Named { pos: absent(), name: "n" }
    assert(a == NG)
    assert(b == NG)
}

nobox value NP { x: float, y: float }

value CV { x: float, y: float }

struct Holder<T> { items: [T] }

fn Holder<T>.pick(h) -> (int, T)? {
    if vec_len(h.items) == 0 { return null }
    return (0, h.items[0])
}

@test(output = "false")
fn a_null_tuple_option_at_a_nobox_element_reads_as_null() {
    let empty: Holder<NP> = Holder { items: [] }
    print("{empty.pick() != null}")
}

@test(output = "true 0 7 9")
fn a_present_tuple_option_at_a_nobox_element_still_reads_its_values() {
    let h: Holder<NP> = Holder { items: [NP { x: 7.0, y: 9.0 }] }
    let ok = h.pick() != null
    if let t = h.pick() {
        print("{ok} {t.0} {t.1.x} {t.1.y}")
    } else {
        print("MISS")
    }
}

@test(output = "false")
fn a_null_tuple_option_at_an_unmarked_column_element_reads_as_null() {
    let empty: Holder<CV> = Holder { items: [] }
    print("{empty.pick() != null}")
}

fn pick_non_generic(flag: bool) -> (int, NP)? {
    if !flag { return null }
    return (1, NP { x: 3.0, y: 4.0 })
}

@test(output = "false")
fn a_null_tuple_option_from_a_non_generic_fn_reads_as_null() {
    print("{pick_non_generic(false) != null}")
}

nobox value Point { x: int, y: int }

nobox value Inner { point: Point, tag: int }

nobox value SnapshotEnvelope { inner: Inner, flag: int }

struct Owner { envelope: SnapshotEnvelope? }

fn child(owner: Owner) -> Inner? { return owner.envelope?.inner }

@test(output = "2 3 7 true")
fn optional_inline_child_projection_keeps_constructor_folding() {
    let owner = Owner { envelope: SnapshotEnvelope {
        inner: Inner { point: Point { x: 2, y: 3 }, tag: 7 }, flag: 11 } }
    let before = child(owner)
    owner.envelope = null
    let value = before.unwrap()
    print("{value.point.x} {value.point.y} {value.tag} {child(owner) == null}")
}

// -- The operations a nullable `nobox` value supports when its shape is
// CONCRETE: a null test reads presence, a refined field read reads a leaf, and
// a merge stores per cell. Each control below removes one of the conjuncts a
// value-position merge needs (the merge, the nullability, the mark). --

nobox value CP { x: float, y: float }

value CQ { x: float, y: float }

// An unused element costs nothing and still type-checks.

fn ignores(p: CP?) -> int { return 42 }

@test(returns = 84)
fn unused_nullable_param() -> int {
    return ignores(CP { x: 1.0, y: 2.0 }) + ignores(null)
}

// A null test reads presence.

fn is_absent(p: CP?) -> bool { return p == null }

@test(returns = 1)
fn null_test_reads_presence() -> int {
    let present_says_absent = is_absent(CP { x: 1.0, y: 2.0 })
    let absent_says_absent = is_absent(null)
    return if !present_says_absent && absent_says_absent { 1 } else { 0 }
}

// A refined field read reads the leaf.

fn get_x(p: CP?) -> float {
    if p != null { return p.x }
    return -1.0
}

@test(returns = 6)
fn refined_field_read_reads_the_leaf() -> int {
    return (get_x(CP { x: 7.0, y: 2.0 }) + get_x(null)) as int
}

// A nullable nobox value crosses a fn-value boundary.

fn apply(f: (CP?) -> bool, p: CP?) -> bool { return f(p) }

@test(returns = 1)
fn nullable_crosses_a_fn_value_param() -> int {
    let g = (p: CP?) => p == null
    return if !apply(g, CP { x: 1.0, y: 2.0 }) && apply(g, null) { 1 } else { 0 }
}

// A lambda RETURNED as a fn value at a nullable nobox return, with no merge in
// its body (the merging form is in fn_values.rock).
fn identity_maker() -> (CP?) -> CP? { return (p: CP?) => p }

@test(returns = 8)
fn returned_lambda_without_a_merge_keeps_its_arity() -> int {
    let g = identity_maker()
    let got = g(CP { x: 7.0, y: 2.0 })?.x ?? -1.0
    return (got + if g(null) == null { 1.0 } else { 0.0 }) as int
}

fn absent_without_merge() -> CP? {
    let v: CP? = null
    return v
}

@test(returns = 1)
fn no_merge_is_correct() -> int {
    return if absent_without_merge() == null { 1 } else { 0 }
}

fn pick_by_return(present: bool) -> CP? {
    if present { return CP { x: 5.0, y: 6.0 } }
    return null
}

@test(returns = 1)
fn statement_position_returns_do_not_merge() -> int {
    return if pick_by_return(true) != null && pick_by_return(false) == null { 1 } else { 0 }
}

fn pick_present(a: bool) -> CP {
    let v: CP = if a { CP { x: 5.0, y: 6.0 } } else { CP { x: 1.0, y: 2.0 } }
    return v
}

@test(returns = 6)
fn merge_of_two_present_arms() -> int {
    return (pick_present(true).x + pick_present(false).x) as int
}

fn pick_unmarked(present: bool) -> CQ? {
    let v: CQ? = if present { CQ { x: 5.0, y: 6.0 } } else { null }
    return v
}

@test(returns = 1)
fn unmarked_nullable_merge() -> int {
    return if pick_unmarked(true) != null && pick_unmarked(false) == null { 1 } else { 0 }
}


nobox value PresenceId { scene: int, arena: int, slot: int, generation: int }
value BoxedPresenceId { scene: int, arena: int, slot: int, generation: int }
struct PresenceState { id: PresenceId? = null }
struct BoxedPresenceState { id: BoxedPresenceId? = null }
struct PresenceRow { present: bool = false }

fn check_presence(value: bool, expected: bool) { assert_eq(value, expected) }
fn presence_return(state: PresenceState) -> bool { return state.id != null }
fn absence_return(state: PresenceState) -> bool { return state.id == null }
fn present_state() -> PresenceState {
    return PresenceState { id: PresenceId { scene: 0, arena: 1, slot: 1, generation: 0 } }
}
fn presence_tuple(present: bool) -> (PresenceId, int)? {
    if present { return (PresenceId { scene: 0, arena: 1, slot: 1, generation: 0 }, 7) }
    return null
}


@test
fn nobox_presence_field() {
    let a = PresenceState {}
    let p = present_state()
    let a_present = PresenceRow { present: a.id != null }
    let a_absent = PresenceRow { present: a.id == null }
    let p_present = PresenceRow { present: p.id != null }
    let p_absent = PresenceRow { present: p.id == null }
    assert_eq(a_present.present, false)
    assert_eq(a_absent.present, true)
    assert_eq(p_present.present, true)
    assert_eq(p_absent.present, false)
}

@test
fn nobox_presence_local() {
    let a = PresenceState {}
    let p = present_state()
    let a_present: bool = a.id != null
    let a_absent: bool = a.id == null
    let p_present: bool = p.id != null
    let p_absent: bool = p.id == null
    assert_eq(a_present, false)
    assert_eq(a_absent, true)
    assert_eq(p_present, true)
    assert_eq(p_absent, false)
}

@test
fn nobox_presence_parameter() {
    let a = PresenceState {}
    let p = present_state()
    check_presence(a.id != null, false)
    check_presence(a.id == null, true)
    check_presence(p.id != null, true)
    check_presence(p.id == null, false)
}

@test
fn nobox_presence_return() {
    let a = PresenceState {}
    let p = present_state()
    assert_eq(presence_return(a), false)
    assert_eq(absence_return(a), true)
    assert_eq(presence_return(p), true)
    assert_eq(absence_return(p), false)
}

@test
fn nobox_presence_equality() {
    let a = PresenceState {}
    let p = present_state()
    assert_eq((a.id != null) == false, true)
    assert_eq((null != a.id) == false, true)
    assert_eq((a.id == null) == true, true)
    assert_eq((null == a.id) == true, true)
    assert_eq((p.id != null) == true, true)
    assert_eq((null != p.id) == true, true)
    assert_eq((p.id == null) == false, true)
    assert_eq((null == p.id) == false, true)
}

@test
fn nobox_short_circuit_values() {
    let a = PresenceState {}
    let p = present_state()
    assert_eq(true && a.id != null, false)
    assert_eq(false || a.id != null, false)
    assert_eq(true && p.id != null, true)
    assert_eq(false || p.id != null, true)
}

@test
fn tuple_presence_values() {
    let absent = presence_tuple(false)
    check_presence(absent != null, false)
    check_presence(absent == null, true)
    let present = presence_tuple(true)
    check_presence(present != null, true)
    check_presence(present == null, false)
}

@test
fn nobox_direct_conditions() {
    let state = PresenceState {}
    if state.id != null { error("absent presence condition") }
    if state.id == null {} else { error("absent absence condition") }
    if state.id != null || state.id != null { error("absent disjunction") }
    let live = present_state()
    if live.id != null && true {} else { error("present conjunction") }
    while live.id != null { live.id = null }
    assert_eq(live.id == null, true)
}

@test
fn boxed_absent_presence_control() {
    let state = BoxedPresenceState {}
    let row = PresenceRow { present: state.id != null }
    assert_eq(row.present, false)
    check_presence(state.id == null, true)
}

nobox value Waypoint { x: int, y: int }
value WaypointRow { position: Waypoint }
struct OptionalWaypoint { p: Waypoint? = null }

@test
fn field_read_sets_nullable_presence_after_the_first_turn() {
    let points = [
        WaypointRow { position: Waypoint { x: 3, y: 4 } },
        WaypointRow { position: Waypoint { x: 4, y: 7 } },
        WaypointRow { position: Waypoint { x: 1, y: 2 } },
    ]
    let prev: Waypoint? = null
    let turns = 0
    let diff = 0
    for point in points {
        if let p = prev {
            turns += 1
            diff += point.position.x - p.x
        }
        prev = point.position
    }
    assert_eq((turns, diff, prev.unwrap().y), (2, -2, 2))

    let empty = OptionalWaypoint {}
    let full = OptionalWaypoint { p: points[0].position }
    assert(empty.p == null)
    assert_eq(full.p.unwrap().y, 4)
}
