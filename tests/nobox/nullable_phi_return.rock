// A nobox option whose value comes from a phi of a present arm and `null`
// widens its shape from the arms, so the absent path carries a real presence
// slot (with or without `materialize`). The no-phi local, statement `return
// null` and non-nullable `materialize` are controls.

nobox value P { x: int, y: int }

fn phi_materialized(present: bool) -> P? {
    let v: P? = if present { P { x: 5, y: 6 } } else { null }
    return materialize(v)
}

fn phi_plain(present: bool) -> P? {
    let v: P? = if present { P { x: 5, y: 6 } } else { null }
    return v
}

@test(output = "absent=true")
fn an_absent_nobox_option_from_a_phi_reports_absent_through_materialize() {
    print("absent={phi_materialized(false) == null}")
}

@test(output = "absent=true")
fn an_absent_nobox_option_from_a_phi_reports_absent_without_materialize() {
    print("absent={phi_plain(false) == null}")
}

@test(output = "present=5")
fn the_present_path_of_the_same_phi_is_correct() {
    print("present={phi_materialized(true)?.x ?? -1}")
}

fn materialized_non_nullable() -> P { return materialize(P { x: 5, y: 6 }) }

@test(output = "5 6")
fn materialize_on_a_non_nullable_nobox_value_is_correct() {
    let p = materialized_non_nullable()
    print("{p.x} {p.y}")
}

fn null_local() -> P? {
    let v: P? = null
    return v
}

@test(output = "absent=true")
fn a_nullable_nobox_local_with_no_phi_reports_absent() {
    print("absent={null_local() == null}")
}

fn early_return_null(present: bool) -> P? {
    if !present { return null }
    return P { x: 5, y: 6 }
}

@test(output = "absent=true\npresent=5")
fn a_statement_position_return_null_reports_absent() {
    print("absent={early_return_null(false) == null}")
    print("present={early_return_null(true)?.x ?? -1}")
}
