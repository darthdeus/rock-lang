// `?.` producing a `nobox` value. All three safe-nav forms joined their nil and
// value arms through ONE result cell, and a `nobox` value is leaves plus a
// presence tag, which does not fit one cell -- so it packed to a box and tripped
// the materialization rejection.
//
// The join itself was never the problem: `if`/`match` as VALUES already store
// per-slot (`repr_join_slot` + `store_repr_and_join`). Safe-nav simply was not
// dispatched through it -- `lower_expr_repr` had no `SafeNav*` arm at all, so
// every form fell through to the packed `Scalar` default.
//
// Not a JS gap: it rejected identically on luajit.
//
// CHAINING a second `?.` straight onto the result was a second, separate defect
// on the same surface -- covered at the bottom of this file.

nobox value NV { x: int, y: int }

value BV { x: int, y: int }

struct Holder { v: NV, n: int }

fn Holder.wire(h) -> NV { return h.v }

// --- the three forms ---

@test(returns = 9)
fn safe_nav_field_yields_a_nobox_value() -> int {
    let h: Holder? = Holder { v: NV { x: 3, y: 6 }, n: 1 }
    let a = h?.v
    return (a?.x ?? -1) + (a?.y ?? -1)
}

@test(returns = 9)
fn safe_nav_call_yields_a_nobox_value() -> int {
    let h: Holder? = Holder { v: NV { x: 3, y: 6 }, n: 1 }
    let a = h?.wire()
    return (a?.x ?? -1) + (a?.y ?? -1)
}

@test(returns = 9)
fn safe_nav_let_yields_a_nobox_value() -> int {
    let h: Holder? = Holder { v: NV { x: 3, y: 6 }, n: 1 }
    let a = h?.let { h.v }
    return (a?.x ?? -1) + (a?.y ?? -1)
}

// --- the ABSENT arm, which is what a single result cell got wrong ---

fn none() -> Holder? { return null }

@test(returns = 1)
fn safe_nav_field_on_null_is_absent() -> int {
    let a = none()?.v
    return if a == null { 1 } else { 0 }
}

@test(returns = 1)
fn safe_nav_call_on_null_is_absent() -> int {
    let a = none()?.wire()
    return if a == null { 1 } else { 0 }
}

@test(returns = 1)
fn safe_nav_let_on_null_is_absent() -> int {
    let n = none()
    let a = n?.let { n.v }
    return if a == null { 1 } else { 0 }
}

// Both arms reached from ONE call site, so a join that only ever saw the present
// arm cannot pass: the two answers must differ.
fn pick(present: bool) -> Holder? {
    if present { return Holder { v: NV { x: 4, y: 7 }, n: 1 } }
    return null
}

@test(returns = 11)
fn both_arms_of_one_join() -> int {
    let hit = pick(true)?.v
    let miss = pick(false)?.v
    return (hit?.x ?? 0) + (hit?.y ?? 0) + (miss?.x ?? 0) + (miss?.y ?? 0)
}

// --- controls: the discriminant is `nobox` x `?.`, nothing else ---

struct BHolder { v: BV }

@test(returns = 9)
fn an_unmarked_value_through_safe_nav_still_works() -> int {
    let h: BHolder? = BHolder { v: BV { x: 3, y: 6 } }
    let a = h?.v
    return (a?.x ?? -1) + (a?.y ?? -1)
}

// A DECLARED nullable return has always worked -- it is the shape safe-nav
// synthesizes, reached the other way.
fn maybe(present: bool) -> NV? {
    if present { return NV { x: 3, y: 6 } }
    return null
}

@test(returns = 10)
fn a_declared_nullable_nobox_return_still_works() -> int {
    return (maybe(true)?.x ?? -1) + (maybe(true)?.y ?? -1) + (if maybe(false) == null { 1 } else { 0 })
}

@test(returns = 3)
fn safe_nav_to_a_plain_field_still_works() -> int {
    let h: Holder? = Holder { v: NV { x: 3, y: 6 }, n: 3 }
    return h?.n ?? -1
}

// The control that scoped the chained-`?.` gap while it was open, and still
// bounds a fix to `nobox`: the same chain on an UNMARKED value.
@test(returns = 3)
fn an_unmarked_value_chains_through_two_safe_navs() -> int {
    let h: BHolder? = BHolder { v: BV { x: 3, y: 6 } }
    return h?.v?.x ?? -1
}

// The nobox two-step, stated as the chain's counterpart rather than as one more
// producing form: identical types and identical projection, differing only in
// whether the result is bound before the second `?.`.
@test(returns = 3)
fn a_nobox_value_projects_after_binding() -> int {
    let h: Holder? = Holder { v: NV { x: 3, y: 6 }, n: 1 }
    let a = h?.v
    return a?.x ?? -1
}

// --- chaining a second `?.` straight onto a nobox result ---
//
// Was `tests/errors/nobox/safenav_chain.rock.err`. The outer `?.` asked
// `repr_join_slot` about ITS OWN type -- `int?`, no leaves -- and rightly
// declined the per-slot join, but that decision is about the RESULT while the
// materialization was the BASE's: `lower_expr` on the base took the scalar arm,
// whose embed read rebuilt the box. Asking the BASE the same question routes it
// through the per-slot join, and its presence tag replaces the `== nil` test --
// once the value is leaves there is no box to compare.
//
// The producing form does not matter, which is why one fix closed all three.

@test(returns = 3)
fn a_nobox_value_chains_through_two_safe_navs() -> int {
    let h: Holder? = Holder { v: NV { x: 3, y: 6 }, n: 1 }
    return h?.v?.x ?? -1
}

@test(returns = 6)
fn the_chain_reads_the_SECOND_field_too() -> int {
    let h: Holder? = Holder { v: NV { x: 3, y: 6 }, n: 1 }
    return h?.v?.y ?? -1
}

// The absent arm: the fallback must fire rather than the chain reading leaves
// off a row that is not there.
@test(returns = -1)
fn the_chain_takes_the_absent_arm_when_the_base_is_null() -> int {
    let h: Holder? = null
    return h?.v?.x ?? -1
}

@test(returns = 3)
fn the_chain_works_through_a_method() -> int {
    let h: Holder? = Holder { v: NV { x: 3, y: 6 }, n: 1 }
    return h?.wire()?.x ?? -1
}

@test(returns = 3)
fn the_chain_works_through_a_let() -> int {
    let h: Holder? = Holder { v: NV { x: 3, y: 6 }, n: 1 }
    return h?.let { h.v }?.x ?? -1
}

// `?.` yielding a nobox whose own field is nobox. Safe-nav was never the
// variable here: the same shape rejected with no `?.` anywhere, because a
// reference struct field splices its nobox child's leaves and the nested value
// was falling to one boxed leaf. Storage coverage: `tests/nobox/nested_ctor.rock`.
nobox value SNN { x: int, y: int }
nobox value SNMid { v: SNN }
struct SNOuter { m: SNMid }

fn mk_sn_outer(k: int) -> SNOuter? {
    if k < 0 { return null }
    return SNOuter { m: SNMid { v: SNN { x: k, y: k * 2 } } }
}

@test(output = "6 -1")
fn safe_nav_yields_a_nested_nobox_value() {
    let hit = mk_sn_outer(3)
    let miss = mk_sn_outer(-1)
    let r = hit?.m
    print("{r?.v?.y ?? -1} {miss?.m?.v?.y ?? -1}")
}
