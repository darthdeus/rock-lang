// A lambda returned as a fn value whose return type is a nullable nobox value
// must emit its presence slot, so `f(true)?.x` reads `x` and not the next
// leaf. A lambda in return position records the type of the hole it fills, not
// its own narrower inferred type, at every return position (tail, `return`,
// via a declared local); the named-fn, param and typed-local forms are
// controls.

nobox value P { x: int, y: int }

fn mk_tail() -> (bool) -> P? { present => if present { P { x: 5, y: 6 } } else { null } }

@test(output = "5 6 -1")
fn a_returned_lambda_at_a_nullable_nobox_return_reads_the_right_field() {
    let f = mk_tail()
    print("{f(true)?.x ?? -1} {f(true)?.y ?? -1} {f(false)?.x ?? -1}")
}

fn mk_explicit() -> (bool) -> P? { return present => if present { P { x: 5, y: 6 } } else { null } }

@test(output = "5 -1")
fn an_explicitly_returned_lambda_reads_the_right_field() {
    let f = mk_explicit()
    print("{f(true)?.x ?? -1} {f(false)?.x ?? -1}")
}

fn mk_via_local() -> (bool) -> P? {
    let g: (bool) -> P? = present => if present { P { x: 5, y: 6 } } else { null }
    return g
}

@test(output = "5")
fn a_lambda_returned_through_a_declared_local_is_correct() {
    let f = mk_via_local()
    print("{f(true)?.x ?? -1}")
}

fn mk_non_null() -> (bool) -> P { present => P { x: 5, y: 6 } }

@test(output = "5 6")
fn a_returned_lambda_at_a_non_nullable_nobox_return_is_correct() {
    let f = mk_non_null()
    let p = f(true)
    print("{p.x} {p.y}")
}

fn maybe(present: bool) -> P? { if present { P { x: 5, y: 6 } } else { null } }

@test(output = "5")
fn a_named_fn_bound_as_that_fn_value_is_correct() {
    let f: (bool) -> P? = maybe
    print("{f(true)?.x ?? -1}")
}

fn use_it(f: (bool) -> P?) -> int { f(true)?.x ?? -1 }

@test(output = "5")
fn a_named_fn_passed_as_a_fn_value_param_is_correct() {
    print("{use_it(maybe)}")
}

@test(output = "5")
fn the_same_lambda_bound_to_a_typed_local_is_correct() {
    let f: (bool) -> P? = present => if present { P { x: 5, y: 6 } } else { null }
    print("{f(true)?.x ?? -1}")
}
