nobox value PresenceId { scene: int, arena: int, slot: int, generation: int }
value BoxedPresenceId { scene: int, arena: int, slot: int, generation: int }
struct PresenceState { id: PresenceId? = null }
struct BoxedPresenceState { id: BoxedPresenceId? = null }
struct PresenceRow { present: bool = false }

fn check_presence(value: bool, expected: bool) { assert_eq(value, expected) }
fn presence_return(state: PresenceState) -> bool { return state.id != null }
fn absence_return(state: PresenceState) -> bool { return state.id == null }
fn present_state() -> PresenceState {
    return PresenceState { id: PresenceId { scene: 0, arena: 1, slot: 1, generation: 0 } }
}
fn presence_tuple(present: bool) -> (PresenceId, int)? {
    if present { return (PresenceId { scene: 0, arena: 1, slot: 1, generation: 0 }, 7) }
    return null
}

// Each position is checked for an absent state `a` and a present state `p`.

@test
fn nobox_presence_field() {
    let a = PresenceState {}
    let p = present_state()
    let a_present = PresenceRow { present: a.id != null }
    let a_absent = PresenceRow { present: a.id == null }
    let p_present = PresenceRow { present: p.id != null }
    let p_absent = PresenceRow { present: p.id == null }
    assert_eq(a_present.present, false)
    assert_eq(a_absent.present, true)
    assert_eq(p_present.present, true)
    assert_eq(p_absent.present, false)
}

@test
fn nobox_presence_local() {
    let a = PresenceState {}
    let p = present_state()
    let a_present: bool = a.id != null
    let a_absent: bool = a.id == null
    let p_present: bool = p.id != null
    let p_absent: bool = p.id == null
    assert_eq(a_present, false)
    assert_eq(a_absent, true)
    assert_eq(p_present, true)
    assert_eq(p_absent, false)
}

@test
fn nobox_presence_parameter() {
    let a = PresenceState {}
    let p = present_state()
    check_presence(a.id != null, false)
    check_presence(a.id == null, true)
    check_presence(p.id != null, true)
    check_presence(p.id == null, false)
}

@test
fn nobox_presence_return() {
    let a = PresenceState {}
    let p = present_state()
    assert_eq(presence_return(a), false)
    assert_eq(absence_return(a), true)
    assert_eq(presence_return(p), true)
    assert_eq(absence_return(p), false)
}

@test
fn nobox_presence_equality() {
    let a = PresenceState {}
    let p = present_state()
    assert_eq((a.id != null) == false, true)
    assert_eq((null != a.id) == false, true)
    assert_eq((a.id == null) == true, true)
    assert_eq((null == a.id) == true, true)
    assert_eq((p.id != null) == true, true)
    assert_eq((null != p.id) == true, true)
    assert_eq((p.id == null) == false, true)
    assert_eq((null == p.id) == false, true)
}

@test
fn nobox_short_circuit_values() {
    let a = PresenceState {}
    let p = present_state()
    assert_eq(true && a.id != null, false)
    assert_eq(false || a.id != null, false)
    assert_eq(true && p.id != null, true)
    assert_eq(false || p.id != null, true)
}

@test
fn tuple_presence_values() {
    let absent = presence_tuple(false)
    check_presence(absent != null, false)
    check_presence(absent == null, true)
    let present = presence_tuple(true)
    check_presence(present != null, true)
    check_presence(present == null, false)
}

@test
fn nobox_direct_conditions() {
    let state = PresenceState {}
    if state.id != null { error("absent presence condition") }
    if state.id == null {} else { error("absent absence condition") }
    if state.id != null || state.id != null { error("absent disjunction") }
    let live = present_state()
    if live.id != null && true {} else { error("present conjunction") }
    while live.id != null { live.id = null }
    assert_eq(live.id == null, true)
}

@test
fn boxed_absent_presence_control() {
    let state = BoxedPresenceState {}
    let row = PresenceRow { present: state.id != null }
    assert_eq(row.present, false)
    check_presence(state.id == null, true)
}
