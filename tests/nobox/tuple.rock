// Tuples whose elements are `nobox` values: as a return, at a fn param, and
// stored inside a container. The nullable forms are in nullable_tuple.rock.

// ======== As a RETURN ========
//
// Cross-backend execution of the nobox tuple-return ABI: a tuple return whose
// element is a `nobox` value carries that element's LEAVES, not one box.
// Emission-shape assertions (no `NV2_ct(`) live in
// `crates/skull/tests/nobox_values.rs`; these pin that the wire still computes
// the right answer on every backend that can run them.

nobox value NV2 { x: float, y: float }

value BV2 { x: float, y: float }

fn split(v: NV2) -> (bool, NV2) {
    return (true, v)
}

fn maybe(present: bool, v: NV2) -> (bool, NV2?) {
    if present { return (true, v) }
    return (false, null)
}

fn split_boxed(v: BV2) -> (bool, BV2) {
    return (true, v)
}

@test(returns = 4)
fn tuple_return_binds_leaves() -> int {
    let (ok, w) = split(NV2 { x: 1.0, y: 3.0 })
    if !ok { return -1 }
    return (w.x + w.y) as int
}

@test(returns = 7)
fn nullable_element_threads_presence() -> int {
    let (ok, w) = maybe(true, NV2 { x: 3.0, y: 4.0 })
    if !ok { return -1 }
    if let q = w { return (q.x + q.y) as int }
    return -2
}

@test(returns = 1)
fn absent_nullable_element_stays_null() -> int {
    let (ok, w) = maybe(false, NV2 { x: 3.0, y: 4.0 })
    if ok { return -1 }
    if w == null { return 1 }
    return -2
}

// The asymmetry guard: an UNMARKED value keeps its single boxed slot, so the
// same source still round-trips.
@test(returns = 9)
fn unmarked_value_element_still_round_trips() -> int {
    let (ok, w) = split_boxed(BV2 { x: 4.0, y: 5.0 })
    if !ok { return -1 }
    return (w.x + w.y) as int
}

@test(returns = 10)
fn loop_element_binds_leaves() -> int {
    let ps: [NV2] = [NV2 { x: 1.0, y: 2.0 }, NV2 { x: 3.0, y: 4.0 }]
    let total = 0.0
    for p in ps { total = total + p.x + p.y }
    return total as int
}

// `enumerate` makes `next` return `(bool, (int, NV2))` -- the nested-tuple slot.
@test(returns = 14)
fn enumerated_element_binds_leaves() -> int {
    let ps: [NV2] = [NV2 { x: 1.0, y: 2.0 }, NV2 { x: 3.0, y: 4.0 }]
    let total = 0.0
    for (i, p) in enumerate(ps) { total = total + i as float * 10.0 + p.x }
    return total as int
}

// ======== At a fn PARAM ========
//
// A TUPLE of `nobox` values at a fn PARAM. Params carry the same `RetSlot`
// shape returns do, so one nobox in the tuple is enough to need the slot.

nobox value TV { x: float, y: float }

value UTV { x: float, y: float }

fn pair_sum(pq: (TV, TV)) -> float { return pq.0.y + pq.1.x }

// ONE nobox in the tuple is enough to need the slot.
fn mixed(pq: (TV, float)) -> float { return pq.0.y + pq.1 }

fn nested(t: ((TV, TV), float)) -> float { return t.0.0.y + t.0.1.x + t.1 }

fn with_nullable(pq: (TV?, TV)) -> float { return (pq.0?.y ?? -1.0) + pq.1.x }

@test(returns = 5.0)
fn a_tuple_of_nobox_crosses_a_direct_call() -> float {
    return pair_sum((TV { x: 1.0, y: 3.0 }, TV { x: 2.0, y: 4.0 }))
}

@test(returns = 5.0)
fn the_same_tuple_bound_to_a_local_first() -> float {
    let t = (TV { x: 1.0, y: 3.0 }, TV { x: 2.0, y: 4.0 })
    return pair_sum(t)
}

@test(returns = 12.0)
fn one_nobox_element_is_enough() -> float {
    return mixed((TV { x: 1.0, y: 3.0 }, 9.0))
}

@test(returns = 14.0)
fn the_slot_nests() -> float {
    return nested(((TV { x: 1.0, y: 3.0 }, TV { x: 2.0, y: 4.0 }), 9.0))
}

// A nullable element carries its presence leaf inside the tuple slot, so the
// absent arm has somewhere to say so.
@test
fn a_nullable_element_keeps_its_presence_leaf() {
    assert_eq(with_nullable((null, TV { x: 2.0, y: 4.0 })), 1.0)
    assert_eq(with_nullable((TV { x: 0.0, y: 5.0 }, TV { x: 2.0, y: 4.0 })), 7.0)
}

// NAMED args place a splatting param by slot, so the nil-fill width has to be
// the slot's, not one.
fn keyed(k: int, pq: (TV, TV)) -> float { return pq.0.y + pq.1.x + (k as float) }

@test(returns = 105.0)
fn a_tuple_param_places_by_name() -> float {
    let t = (TV { x: 1.0, y: 3.0 }, TV { x: 2.0, y: 4.0 })
    return keyed(pq: t, k: 100)
}

// --- the fn-VALUE boundary ---

fn apply_pair(g: ((TV, TV)) -> float, pq: (TV, TV)) -> float { return g(pq) }

@test(returns = 5.0)
fn a_tuple_of_nobox_crosses_a_fn_VALUE_param() -> float {
    let t = (TV { x: 1.0, y: 3.0 }, TV { x: 2.0, y: 4.0 })
    return apply_pair(pair_sum, t)
}

@test(returns = 5.0)
fn the_same_through_a_lambda() -> float {
    let t = (TV { x: 1.0, y: 3.0 }, TV { x: 2.0, y: 4.0 })
    return apply_pair(pq => pq.0.y + pq.1.x, t)
}

// The headline shape: `zip(..).reduce(..)`, which is what real combinator code
// hits.
@test(returns = 10.0)
fn zip_reduce_over_a_column_carries_the_pair() -> float {
    let a: [TV] = [TV { x: 1.0, y: 3.0 }, TV { x: 2.0, y: 4.0 }]
    return a.zip(a).reduce(0.0, (acc, pq) => acc + pq.0.y + pq.1.x)
}

// A nested `fn` is the third definition form, and shares `bind_param_slot` with
// the other two.
@test(returns = 5.0)
fn a_nested_fn_binds_a_tuple_param() -> float {
    fn inner(pq: (TV, TV)) -> float { return pq.0.y + pq.1.x }
    return inner((TV { x: 1.0, y: 3.0 }, TV { x: 2.0, y: 4.0 }))
}

// The control that scoped the gap: the UNMARKED twin always compiled, and must
// keep its single boxed slot -- only a `nobox` element splats.
@test(returns = 5.0)
fn an_unmarked_value_tuple_param_still_works() -> float {
    fn u(pq: (UTV, UTV)) -> float { return pq.0.y + pq.1.x }
    return u((UTV { x: 1.0, y: 3.0 }, UTV { x: 2.0, y: 4.0 }))
}

// ======== Inside a container ========
//
// A `nobox` value inside a TUPLE inside a container -- matrix row 13, the
// `[(Vec2, IRect)]` push shape.
//
// The tuple box stores the nobox part's LEAVES splat, so no `Vec2` is ever
// materialized. Layout comes from the declared tuple type via the same
// `TupleRetShape` slot list the multi-return wire uses, so producer and reader
// derive it independently and cannot disagree.
//
// The containers are globals so the vec escapes: a local one is scalarized away
// and the push never reaches the element repr at all.

value IR4 { x: int, y: int, w: int, h: int }

global PAIRS: [(Vec2, int)] = []
global TILES: [(Vec2, IR4)] = []
global NESTED: [((Vec2, int), int)] = []

fn add_pair(v: Vec2, n: int) {
    PAIRS.push((v, n))
}

fn add_tile(p: Vec2, s: IR4) {
    TILES.push((p, s))
}

@test
fn a_nobox_part_rides_the_tuple_box_as_leaves() {
    add_pair(Vec2 { x: 1.0, y: 2.0 }, 7)
    let (p, n) = PAIRS[0]
    assert_eq(p.x, 1.0)
    assert_eq(p.y, 2.0)
    assert_eq(n, 7)
}

// Both parts value-shaped, and 6 leaves total -- over MAX_COLUMN_LEAVES, so this
// is genuinely the boxed path and not columns in disguise.
@test
fn two_value_parts_round_trip() {
    add_tile(Vec2 { x: 3.0, y: 4.0 }, IR4 { x: 5, y: 6, w: 7, h: 8 })
    let (p, s) = TILES[0]
    assert_eq(p.x, 3.0)
    assert_eq(s.w, 7)
    assert_eq(s.h, 8)
}

// Slot PROJECTION, not just destructure -- the other read site.
@test
fn slot_projection_reads_the_widened_box() {
    add_tile(Vec2 { x: 9.0, y: 10.0 }, IR4 { x: 1, y: 2, w: 3, h: 4 })
    let t = TILES[TILES.len - 1]
    assert_eq(t.0.y, 10.0)
    assert_eq(t.1.x, 1)
}

// A nested tuple: the inner slot list has to compose into the outer one.
@test
fn a_nested_tuple_composes_its_slots() {
    NESTED.push(((Vec2 { x: 11.0, y: 12.0 }, 13), 14))
    let (inner, outer) = NESTED[0]
    let (v, n) = inner
    assert_eq(v.x, 11.0)
    assert_eq(n, 13)
    assert_eq(outer, 14)
}

// The element survives a rewrite in place, so the widened layout is not
// write-once.
@test
fn a_stored_element_can_be_overwritten() {
    PAIRS.push((Vec2 { x: 20.0, y: 21.0 }, 22))
    let last = PAIRS.len - 1
    PAIRS.set(last, (Vec2 { x: 30.0, y: 31.0 }, 32))
    let (p, n) = PAIRS[last]
    assert_eq(p.x, 30.0)
    assert_eq(n, 32)
}

// A plain loop destructures every element from the same boxes.
@test
fn tuple_pattern_iteration_reads_every_part() {
    TILES.clear()
    add_tile(Vec2 { x: 3.0, y: 4.0 }, IR4 { x: 5, y: 6, w: 7, h: 8 })
    add_tile(Vec2 { x: 1.0, y: 2.0 }, IR4 { x: 1, y: 2, w: 3, h: 4 })
    let seen = 0.0
    for (p, s) in TILES {
        seen = seen + p.x + p.y + s.w + s.h
    }
    assert_eq(seen, 32.0)
}

// An enumerated element destructures into the same boxes.
@test
fn enumerated_iteration_agrees_with_indexing() {
    TILES.clear()
    add_tile(Vec2 { x: 3.0, y: 4.0 }, IR4 { x: 5, y: 6, w: 7, h: 8 })
    add_tile(Vec2 { x: 1.0, y: 2.0 }, IR4 { x: 1, y: 2, w: 3, h: 4 })
    let seen = 0.0
    let last = -1
    for (i, (p, s)) in enumerate(TILES) {
        seen = seen + p.x + p.y + s.w + s.h
        last = i
    }
    assert_eq(seen, 32.0)
    assert_eq(last, 1)
}

// ======== Stored in a STRUCT FIELD / RECORD VARIANT / NEWTYPE ========
//
// A field (or wrapped value, or record-variant field) holding a splatting
// tuple stores the same flat box every other position does; the pattern and
// repr readers rebuild the parts by SLOT off the field's declared type. A
// generic enum's payload answers from the scrutinee's own instance type.

nobox value FNV { x: float, y: float }

struct Carrier {
    t: (FNV, float),
    n: int,
}

@test(output = "1 10 5\n1 2 10")
fn struct_field_splatting_tuple() {
    let c = Carrier { t: (FNV { x: 1.0, y: 2.0 }, 10.0), n: 5 }
    let (v, f) = c.t
    print("{v.x as int} {f as int} {c.n}")
    let Carrier { t: (w, g), .. } = c
    print("{w.x as int} {w.y as int} {g as int}")
}

fn carry(c: Carrier) -> string {
    let (v, f) = c.t
    return "{v.x as int} {f as int} {c.n}"
}

@test(output = "1 10 5")
fn struct_field_through_a_param() {
    print(carry(Carrier { t: (FNV { x: 1.0, y: 2.0 }, 10.0), n: 5 }))
}

enum Rec {
    Stop,
    Node { t: (FNV, float), tag: int },
}

@test(output = "1 10 7")
fn record_variant_field_splatting_tuple() {
    let r = Rec::Node { t: (FNV { x: 1.0, y: 2.0 }, 10.0), tag: 7 }
    match r {
        Rec::Node { t: (v, f), tag } => print("{v.x as int} {f as int} {tag}"),
        Rec::Stop => print("stop"),
    }
}

newtype WrapT((FNV, float))

@test(output = "1 10\n3 30")
fn newtype_wrapping_splatting_tuple() {
    let w = WrapT((FNV { x: 1.0, y: 2.0 }, 10.0))
    let WrapT((v, f)) = w
    print("{v.x as int} {f as int}")
    let xs: [WrapT] = [WrapT((FNV { x: 3.0, y: 4.0 }, 30.0))]
    if let WrapT((a, b)) = xs.get(0) {
        print("{a.x as int} {b as int}")
    }
}

enum MyOpt<T> {
    Nope,
    Got(T),
}

@test(output = "1 10\nnope")
fn generic_enum_instantiated_at_splatting_tuple() {
    let o: MyOpt<(FNV, float)> = MyOpt::Got((FNV { x: 1.0, y: 2.0 }, 10.0))
    match o {
        MyOpt::Got((v, f)) => print("{v.x as int} {f as int}"),
        MyOpt::Nope => print("nope"),
    }
    let n: MyOpt<(FNV, float)> = MyOpt::Nope
    match n {
        MyOpt::Got((v, f)) => print("{v.x as int} {f as int}"),
        MyOpt::Nope => print("nope"),
    }
}

struct NullableCarrier {
    t: ((int, FNV), float)?,
}

@test(output = "2 1 20\ntrue")
fn nullable_nested_splatting_field() {
    let h = NullableCarrier { t: ((2, FNV { x: 1.0, y: 0.0 }), 20.0) }
    if let ((n, v), f) = h.t {
        print("{n} {v.x as int} {f as int}")
    } else {
        print("none")
    }
    let e = NullableCarrier { t: null }
    print(e.t == null)
}

// ======== Through LOCALS, RETURNS and NESTED generic enums ========
//
// A splatting tuple reaches storage from a call result or a tuple-bound local
// as well as from a literal, and all three store the same flat box. A nested
// pattern reads each position by its own concrete type, so a generic enum
// inside a generic enum rebuilds its payload like the outer one does.

nobox value LP { x: float, y: float }

struct LHold<T> { t: T }

fn lmake(k: float) -> (LP, int) { return (LP { x: k, y: 0.0 }, k as int * 10) }

fn lfirst(xs: [(LP, int)]) -> (LP, int) { return xs[0] }

fn lwrap(k: float) -> MyOpt<(LP, int)> { return MyOpt::Got(lmake(k)) }

@test(output = "1 10\n2 20\n3 30\n4 40")
fn call_results_and_locals_store_flat() {
    let h = LHold { t: lmake(1.0) }
    let (a, n) = h.t
    print("{a.x as int} {n}")
    let t = lmake(2.0)
    let xs = [t]
    let (b, m) = lfirst(xs)
    print("{b.x as int} {m}")
    h.t = lmake(3.0)
    print("{h.t.0.x as int} {h.t.1}")
    xs.set(0, lmake(4.0))
    let u = if xs.len > 0 { xs[0] } else { t }
    print("{u.0.x as int} {u.1}")
}

@test(output = "5 50\n6 60\n7 70\n8 80")
fn nested_generic_payloads_rebuild_per_level() {
    match lwrap(5.0) {
        MyOpt::Got((v, n)) => print("{v.x as int} {n}"),
        MyOpt::Nope => print("nope"),
    }
    let oo: MyOpt<MyOpt<(LP, int)>> = MyOpt::Got(lwrap(6.0))
    if let MyOpt::Got(MyOpt::Got((v, n))) = oo { print("{v.x as int} {n}") }
    let ho: LHold<MyOpt<(LP, int)>> = LHold { t: lwrap(7.0) }
    match ho.t {
        MyOpt::Got((v, n)) => print("{v.x as int} {n}"),
        MyOpt::Nope => print("nope"),
    }
    let oh: MyOpt<LHold<(LP, int)>> = MyOpt::Got(LHold { t: lmake(8.0) })
    if let MyOpt::Got(LHold { t: (v, n) }) = oh { print("{v.x as int} {n}") }
}

// ======== Whole-tuple BINDINGS, defaults and sorting ========

// A name bound to a whole boxed tuple holds its slots, whatever produced the
// box: an index read, a loop element or pair, a coroutine's resume, a payload.
@test(output = "1 10\n1 10\n0 1\n7 2\n3 30\n4 40")
fn a_name_binds_a_boxed_tuple() {
    let xs = [lmake(1.0)]
    match xs[0] {
        t => print("{t.0.x as int} {t.1}"),
    }
    for t in xs {
        let show = () => "{t.0.x as int} {t.1}"
        print(show())
    }
    for pair in enumerate(xs) { print("{pair.0} {pair.1.0.x as int}") }
    let m = map_new<int, (LP, int)>()
    m.insert(7, lmake(2.0))
    for entry in m { print("{entry.0} {entry.1.0.x as int}") }
    let c = lyield(3.0)
    if let t = c.resume() { print("{t.0.x as int} {t.1}") }
    match MyOpt::Got(lmake(4.0)) {
        MyOpt::Got(t) => print("{t.0.x as int} {t.1}"),
        MyOpt::Nope => print("nope"),
    }
}

co fn lyield(k: float) -> Coroutine<(LP, int)> { yield lmake(k) }

// The same holds for a nested tuple, whichever source it comes from.
@test(output = "1 10 5\n2 20 5\n3 30 5\n4 40")
fn every_source_binds_a_whole_nested_tuple() {
    match (lmake(1.0), 5) {
        w => print("{w.0.0.x as int} {w.0.1} {w.1}"),
    }
    let h = LHold { t: (lmake(2.0), 5) }
    match h.t {
        w => print("{w.0.0.x as int} {w.0.1} {w.1}"),
    }
    let ws = [(lmake(3.0), 5)]
    match ws[0] {
        w => print("{w.0.0.x as int} {w.0.1} {w.1}"),
    }
    let g = LHold { t: lmake(4.0) }
    for t in [g.t] { print("{t.0.x as int} {t.1}") }
}

fn ldefault(t: (LP, int) = (LP { x: 1.0, y: 0.0 }, 10)) -> string {
    return "{t.0.x as int} {t.1}"
}

@test(output = "1 10\n5 50")
fn a_defaulted_tuple_param() {
    print(ldefault())
    print(ldefault(lmake(5.0)))
}

@test(output = "1 10\n2 20\n3 30")
fn sorting_by_a_scalar_key() {
    let xs = [lmake(3.0), lmake(1.0), lmake(2.0)]
    xs.sort(t => t.1)
    for (v, n) in xs { print("{v.x as int} {n}") }
}

// ======== materialize ========
//
// Inside Rock code `materialize` of a tuple is the tuple itself: it is stored,
// passed and matched like any other. A body the compiler cannot see into is
// handed the tuple as the user wrote it, one boxed value per element, and an
// implicit splatting tuple is rejected there (tests/errors/nobox.rock.err).

fn lid<T>(v: T) -> T { return v }

fn lmaybe(present: bool) -> (LP, int)? {
    if present { return materialize(lmake(4.0)) }
    return materialize(null)
}

@test(output = "1 10\n2 20\n3 30\n4 40\nnull")
fn materialize_is_the_tuple_itself() {
    let xs: [(LP, int)] = []
    xs.push(materialize(lmake(1.0)))
    let (a, n) = xs[0]
    print("{a.x as int} {n}")
    let (b, m) = lid(materialize(lmake(2.0)))
    print("{b.x as int} {m}")
    match MyOpt::Got(materialize(lmake(3.0))) {
        MyOpt::Got(t) => print("{t.0.x as int} {t.1}"),
        MyOpt::Nope => print("nope"),
    }
    if let t = lmaybe(true) { print("{t.0.x as int} {t.1}") }
    if lmaybe(false) == null { print("null") }
}

inline(lua) fn opaque_count(v: any) -> int = """ if v == nil then return -1 end return #v """
inline(js) fn opaque_count(v: any) -> int = """ return v == null ? -1 : v.length """
inline(lua) fn opaque_first_x(v: any) -> float = """ return v[1].x """
inline(js) fn opaque_first_x(v: any) -> float = """ return v[0].x """

@test(output = "2\n2\n-1\n6")
fn an_opaque_body_gets_one_box_per_element() {
    print(opaque_count(materialize(lmake(1.0))))
    let xs = [lmake(1.0)]
    print(opaque_count(materialize(xs[0])))
    print(opaque_count(materialize(lmaybe(false))))
    print(opaque_first_x(materialize(lmake(6.0))) as int)
}

@test
fn inspect_renders_a_materialized_tuple_as_written() {
    let t = lmake(2.0)
    assert_eq("{materialize(t)}", "{(materialize(t.0), t.1)}")
    assert_eq(inspect(materialize(t)), "{(materialize(t.0), t.1)}")
}
