// The lazy combinator pipeline and terminals over COLUMN-stored `[Vec2]` and
// nullable `[Vec2?]` (`nobox value`). A nullable element is split into
// {presence cell, leaf cells}, so it crosses the placeholder splice without
// being repacked into a box. Values, not statuses: each test returns the
// computed answer.

value BV2 { x: float, y: float }

@test(returns = 1)
fn filter_over_a_column_vec() -> int {
    let a: [Vec2] = [Vec2 { x: 1.0, y: 1.0 }, Vec2 { x: 2.0, y: 2.0 }]
    return a.filter(_.x > 1.0).count()
}

@test(returns = 206)
fn collect_from_a_column_vec() -> int {
    let a: [Vec2] = [Vec2 { x: 1.0, y: 1.0 }, Vec2 { x: 2.0, y: 5.0 }, Vec2 { x: -3.0, y: 9.0 }]
    let b = a.filter(_.x > 0.0).collect()
    // len in the hundreds digit, the surviving element's y in the units:
    // a collect that dropped or duplicated a row moves the first, one that
    // rebuilt the element off the wrong column moves the second.
    return b.len * 100 + (b[0].y + b[1].y) as int
}

@test(returns = 3)
fn reduce_over_a_column_vec() -> int {
    let a: [Vec2] = [Vec2 { x: 1.0, y: 1.0 }, Vec2 { x: 2.0, y: 2.0 }]
    return a.map(_.x).reduce(0.0, (acc, v) => acc + v) as int
}

// No fn value anywhere in the chain: `skip` exercises the combinator wrapper
// alone, without the lambda that map/filter carry.
@test(returns = 9)
fn skip_over_a_column_vec() -> int {
    let a: [Vec2] = [Vec2 { x: 1.0, y: 1.0 }, Vec2 { x: 2.0, y: 5.0 }, Vec2 { x: 7.0, y: 9.0 }]
    let total = 0.0
    for v in a.skip(1) { total = total + v.x }
    return total as int
}

// A chain, so the element crosses two wrapper `next`s before the terminal.
@test(returns = 8)
fn chained_combinators_over_a_column_vec() -> int {
    let a: [Vec2] = [Vec2 { x: 1.0, y: 1.0 }, Vec2 { x: 2.0, y: 2.0 }, Vec2 { x: 6.0, y: 6.0 }]
    return a.filter(_.x > 1.0).map(_.y).sum_f() as int
}

// The element must survive the pipeline WHOLE, not just as a projected field.
fn swap(v: Vec2) -> Vec2 { return Vec2 { x: v.y, y: v.x } }

@test(returns = 8)
fn element_survives_a_map_to_itself() -> int {
    let a: [Vec2] = [Vec2 { x: 1.0, y: 3.0 }, Vec2 { x: 2.0, y: 2.0 }]
    let b = a.map(swap).collect()
    return (b[0].x * 2.0 + b[1].y) as int
}

// `zip`'s element is a TUPLE of two `nobox` values, which the placeholder
// splice has to rebuild whole.
@test(returns = 2)
fn zip_over_a_column_vec_counts() -> int {
    let a: [Vec2] = [Vec2 { x: 1.0, y: 1.0 }, Vec2 { x: 2.0, y: 2.0 }]
    return a.zip(a).count()
}

// A wrapper BEHIND the zip, so the pair element crosses the placeholder splice
// inside `SkipIter.next` and is then read whole. Each side contributes a
// different field, so a swapped or duplicated leaf moves the answer.
@test(returns = 24)
fn zip_over_a_column_vec_carries_both_elements() -> int {
    let a: [Vec2] = [Vec2 { x: 1.0, y: 3.0 }, Vec2 { x: 2.0, y: 4.0 }]
    let b: [Vec2] = [Vec2 { x: 10.0, y: 5.0 }, Vec2 { x: 20.0, y: 6.0 }]
    let t = 0.0
    for (p, q) in a.zip(b).skip(1) { t = t + p.y + q.x }
    return t as int
}

// `enumerate` in a CHAIN also carries a tuple element -- the same rebuild.
@test(returns = 13)
fn enumerate_chain_over_a_column_vec() -> int {
    let a: [Vec2] = [Vec2 { x: 1.0, y: 1.0 }, Vec2 { x: 2.0, y: 2.0 }]
    let t = 0.0
    for (i, v) in a.iter().enumerate() { t = t + i as float * 10.0 + v.x }
    return t as int
}

// The rest of the combinator surface, enumerated rather than assumed.
fn pair_of(v: Vec2) -> VecIter<Vec2> { return [v, v].iter() }

@test(returns = 2226663)
fn the_remaining_combinators_over_a_column_vec() -> int {
    let a: [Vec2] = [Vec2 { x: 1.0, y: 1.0 }, Vec2 { x: 2.0, y: 2.0 }, Vec2 { x: 3.0, y: 3.0 }]
    let n = a.take_while(_.x < 3.0).count()
    n = n * 10 + a.take(2).count()
    n = n * 10 + a.step_by(2).count()
    n = n * 10 + a.chain(a.iter()).count()
    n = n * 10 + a.flat_map(pair_of).count()
    n = n * 10 + a.map(_.x).sum_f() as int
    return n * 10 + (a.max_by(_.x)?.y ?? 0.0) as int
}

// The unmarked twin: the same pipeline over a boxed `value` keeps working.
@test(returns = 3)
fn unmarked_value_pipeline_still_works() -> int {
    let a: [BV2] = [BV2 { x: 1.0, y: 1.0 }, BV2 { x: 2.0, y: 2.0 }]
    return a.map(_.x).sum_f() as int
}

// 0 + 1.0 (index 0, y=1.0) + 1 + 4.0 (index 1, y=4.0)
@test(returns = 6.0)
fn bare_enumerate_on_a_column_vec_reads_its_element() -> float {
    let a: [Vec2] = [Vec2 { x: 1.0, y: 1.0 }, Vec2 { x: 2.0, y: 4.0 }]
    return a.enumerate().reduce(0.0, (acc, p) => acc + (p.0 as float) + p.1.y)
}

// -- Nullable column `[Vec2?]` --

fn px(v: Vec2?) -> float {
    if v != null { return v.x }
    return 0.0
}

fn py(v: Vec2?) -> float {
    if v != null { return v.y }
    return 0.0
}

fn present(v: Vec2?) -> bool { return v != null }

// --- shared terminal results ---

@test
fn nullable_column_terminal_results() {
    let a: [Vec2?] = [Vec2 { x: 1.0, y: 1.0 }, null, Vec2 { x: 2.0, y: 2.0 }]
    assert_eq(a.count(), 3)
    assert_eq(a.skip(1).count(), 2)

    // A hit on the absent row and a miss are both `null` at `T = Vec2?`;
    // count the absent rows to keep that case observable.
    assert_eq(a.filter(v => v == null).count(), 1)
    let some_absent = a.any(v => v == null)
    let all_present = a.all(present)
    let presence_result = if some_absent && !all_present { 1 } else { 0 }
    assert_eq(presence_result, 1)

    assert_eq(a.map(px).sum_f() as int, 3)
    assert_eq(a.map(px).reduce(0.0, (acc, v) => acc + v) as int, 3)

    let b: [int] = [10, 20, 30]
    assert_eq(a.zip(b).count(), 3)
}

fn keep_absent_or_first_payload(v: Vec2?) -> bool {
    if v == null { return true }
    return v.x == 11.0
}

@test(returns = 310)
fn indirect_nullable_argument_preserves_presence_and_payload() -> int {
    let a: [Vec2?] = [Vec2 { x: 11.0, y: 23.0 }, null, Vec2 { x: 33.0, y: 45.0 }]
    let b = a.filter(keep_absent_or_first_payload).collect()
    let second = if b.len > 1 { px(b[1]) } else { 0.0 }
    return b.len * 100 + (px(b[0]) * 10.0 + second) as int
}

// A chain, so the element crosses two wrapper `next`s before the terminal.
@test(returns = 8)
fn chained_combinators_over_a_nullable_column() -> int {
    let a: [Vec2?] = [Vec2 { x: 1.0, y: 1.0 }, null, Vec2 { x: 2.0, y: 6.0 }, Vec2 { x: 6.0, y: 2.0 }]
    return a.filter(v => px(v) > 1.0).map(py).sum_f() as int
}

// --- the element must survive the pipeline WHOLE, presence and all ---

@test(returns = 207)
fn collect_preserves_presence() -> int {
    let a: [Vec2?] = [Vec2 { x: 1.0, y: 3.0 }, null, Vec2 { x: 2.0, y: 4.0 }]
    let b = a.filter(present).collect()
    // len in the hundreds digit, the surviving y's in the units: a collect that
    // dropped or duplicated a row moves the first, one that rebuilt the element
    // off the wrong column moves the second.
    return b.len * 100 + (py(b[0]) + py(b[1])) as int
}

// A top-level fn here; the lambda spelling follows below.
fn swap_opt(v: Vec2?) -> Vec2? {
    if v != null { return Vec2 { x: v.y, y: v.x } }
    return null
}

@test(returns = 35)
fn nullable_element_survives_a_map_to_itself() -> int {
    let a: [Vec2?] = [Vec2 { x: 1.0, y: 3.0 }, null, Vec2 { x: 2.0, y: 5.0 }]
    let b = a.map(swap_opt).collect()
    // x of the swapped first (3) in the tens, the middle still absent (0), the
    // swapped third's x (5) in the units -- a lost presence bit would make the
    // middle a struct of nils and fault, a swapped leaf would move a digit.
    return (px(b[0]) * 10.0 + px(b[1]) + px(b[2])) as int
}

// The same map through a LAMBDA returning the nullable nobox value.
@test(returns = 35)
fn element_survives_a_lambda_map_to_itself() -> int {
    let a: [Vec2?] = [Vec2 { x: 1.0, y: 3.0 }, null, Vec2 { x: 2.0, y: 5.0 }]
    let b = a.map((v: Vec2?) => if v != null { Vec2 { x: v.y, y: v.x } } else { null }).collect()
    return (px(b[0]) * 10.0 + px(b[1]) + px(b[2])) as int
}

// --- tuple elements: the pair carries a presence leaf on one side ---

// A wrapper BEHIND the zip, so the pair element crosses the placeholder splice
// inside `SkipIter.next` and is then read whole. Each side contributes a
// different value, so a swapped or dropped leaf moves the answer.
@test(returns = 54)
fn zip_carries_a_nullable_element_whole() -> int {
    let a: [Vec2?] = [Vec2 { x: 1.0, y: 3.0 }, null, Vec2 { x: 2.0, y: 4.0 }]
    let b: [int] = [10, 20, 30]
    let t = 0
    // rows 1 and 2: (null, 20) contributes 0 + 20, (y=4, 30) contributes 4 + 30.
    for (p, q) in a.zip(b).skip(1) { t = t + py(p) as int + q }
    return t
}

// The pair the other way round, so the presence leaf is the SECOND slot rather
// than the first -- a rebuild that pairs leaves positionally from the left
// cannot get both orders right by accident.
@test(returns = 54)
fn zip_with_the_nullable_side_second() -> int {
    let a: [Vec2?] = [Vec2 { x: 1.0, y: 3.0 }, null, Vec2 { x: 2.0, y: 4.0 }]
    let b: [int] = [10, 20, 30]
    let t = 0
    for (q, p) in b.iter().zip(a).skip(1) { t = t + py(p) as int + q }
    return t
}

@test(returns = 15)
fn enumerate_chain_over_a_nullable_column() -> int {
    let a: [Vec2?] = [Vec2 { x: 1.0, y: 1.0 }, null]
    let t = 0.0
    for (i, v) in a.iter().enumerate() { t = t + i as float * 10.0 + px(v) + 2.0 }
    return t as int
}

// --- the rest of the surface, enumerated rather than assumed ---

fn pair_of_opt(v: Vec2?) -> VecIter<Vec2?> { return [v, v].iter() }

@test(returns = 1226643)
fn the_remaining_combinators_over_a_nullable_column() -> int {
    let a: [Vec2?] = [Vec2 { x: 1.0, y: 1.0 }, null, Vec2 { x: 3.0, y: 3.0 }]
    let n = a.take_while(present).count()
    n = n * 10 + a.take(2).count()
    n = n * 10 + a.step_by(2).count()
    n = n * 10 + a.chain(a.iter()).count()
    n = n * 10 + a.flat_map(pair_of_opt).count()
    n = n * 10 + a.map(px).sum_f() as int
    return n * 10 + (py(a.max_by(px)) + py(a.min_by(px))) as int
}
