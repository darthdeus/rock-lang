// A multi-leaf value as an enum PAYLOAD. A flat enum threads as `[tag, _0..]`,
// one slot per payload position, widened to the payload's leaf count so a
// scalarizable value's leaves ARE the slots; width is keyed on the declared
// payload type, so every variant agrees on the layout. Covers positions after
// a widened one, payloads of different shapes and widths sharing a position,
// enums as fields of a nobox value, nullable enums, and enum elements of
// containers. `nobox` additionally forbids an escaping materialization.

nobox value P { x: float, y: float }

value BP { x: float, y: float }

enum U { V2(P), F(float) }

enum Mixed { V2(P), Arr([float]), Unit }

@test(returns = 7)
fn a_sibling_scalar_variant_still_works() -> int {
    let u = U::F(7.0)
    match u {
        U::V2(p) => { return -1 }
        U::F(f) => { return f as int }
    }
}

@test(returns = 3)
fn the_payload_survives_a_call_boundary() -> int {
    return consume(U::V2(P { x: 1.0, y: 2.0 }))
}

fn consume(u: U) -> int {
    match u {
        U::V2(p) => { return (p.x + p.y) as int }
        U::F(f) => { return -1 }
    }
}

@test(returns = 3)
fn a_mixed_enum_keeps_its_other_variants() -> int {
    let m = Mixed::V2(P { x: 1.0, y: 2.0 })
    match m {
        Mixed::V2(p) => { return (p.x + p.y) as int }
        Mixed::Arr(a) => { return a.len }
        Mixed::Unit => { return -1 }
    }
}

// Control: an UNMARKED value payload uses the same scalar enum representation.
// The mark decides whether a later genuine escape may materialize a box.
enum BU { V2(BP), F(float) }

@test(returns = 3)
fn unmarked_value_payload_answers_the_same() -> int {
    let u = BU::V2(BP { x: 1.0, y: 2.0 })
    match u {
        BU::V2(p) => { return (p.x + p.y) as int }
        BU::F(f) => { return -1 }
    }
}

// A sibling variant whose payload sits AFTER a widened position: `V2(P)` spans
// two slots, so `Pair`'s second element starts at slot 2, not at its position
// index.
enum Multi { V2(P), Pair(int, int) }

@test(returns = 9)
fn a_later_position_reads_past_a_widened_one() -> int {
    let m = Multi::Pair(4, 5)
    match m {
        Multi::V2(p) => { return -1 }
        Multi::Pair(a, b) => { return a + b }
    }
}

@test(returns = 3)
fn the_widened_position_still_reads_in_the_same_enum() -> int {
    let m = Multi::V2(P { x: 1.0, y: 2.0 })
    match m {
        Multi::V2(p) => { return (p.x + p.y) as int }
        Multi::Pair(a, b) => { return -1 }
    }
}

// Enums as FIELDS of a nobox value cross the wire and materialize only at an
// escape.
enum Payload { Damage(float), Text(string) }
enum Subject { None, Mob(int) }
enum Source { Player, Named(string) }

nobox value Event {
    payload: Payload,
    subject: Subject,
    source: Source,
    label: string,
}

fn make_event(n: int) -> Event {
    return Event {
        payload: Payload::Damage(n as float),
        subject: Subject::Mob(n),
        source: Source::Named("player"),
        label: "hit",
    }
}

fn consume_event(event: Event) -> int {
    let amount = match event.payload {
        Payload::Damage(value) => value as int,
        Payload::Text(text) => text.len(),
    }
    let subject = match event.subject {
        Subject::None => 0,
        Subject::Mob(id) => id,
    }
    let source = match event.source {
        Source::Player => 0,
        Source::Named(name) => name.len(),
    }
    return amount + subject + source + event.label.len()
}

fn retain_payload(event: Event) -> [Payload] { return [event.payload] }

@test fn nested_enums_round_trip_across_the_nobox_wire() {
    assert_eq(consume_event(make_event(4)), 17)
}

@test fn nested_enum_materializes_at_a_vector_escape() {
    let retained = retain_payload(make_event(8))
    assert_eq(match retained[0] {
        Payload::Damage(value) => value as int,
        Payload::Text(text) => text.len(),
    }, 8)
}

// A NULLABLE enum whose variant carries a nobox payload: absence, the widened
// variant and the scalar sibling all come back through one `E?` return. The
// unmarked twin answers the same.
fn maybe_u(k: int) -> U? {
    if k < 0 { return null }
    if k == 0 { return U::F(5.0) }
    return U::V2(P { x: k as float, y: (k * 2) as float })
}

fn read_maybe_u(u: U?) -> int {
    if u == null { return -1 }
    match u {
        U::V2(p) => { return (p.x * 10.0 + p.y) as int }
        U::F(f) => { return f as int }
    }
}

fn maybe_bu(k: int) -> BU? {
    if k < 0 { return null }
    if k == 0 { return BU::F(5.0) }
    return BU::V2(BP { x: k as float, y: (k * 2) as float })
}

fn read_maybe_bu(u: BU?) -> int {
    if u == null { return -1 }
    match u {
        BU::V2(p) => { return (p.x * 10.0 + p.y) as int }
        BU::F(f) => { return f as int }
    }
}

@test(output = "36 5 -1 / 36 5 -1")
fn a_nullable_enum_with_a_nobox_payload_keeps_absence() {
    let a = read_maybe_u(maybe_u(3))
    let b = read_maybe_u(maybe_u(0))
    let c = read_maybe_u(maybe_u(-1))
    let d = read_maybe_bu(maybe_bu(3))
    let e = read_maybe_bu(maybe_bu(0))
    let f = read_maybe_bu(maybe_bu(-1))
    print("{a} {b} {c} / {d} {e} {f}")
}

// -- Payloads of different shapes and widths at one position --

nobox value P2 { x: float, y: float }
nobox value P4 { x: float, y: float, z: float, w: float }

enum Slot {
    Two(P2),
    Four(P4),
    Count(int),
    None,
}

fn render(s: Slot) -> string {
    match s {
        Slot::Two(p) => return "two({p.x},{p.y})",
        Slot::Four(p) => return "four({p.x},{p.y},{p.z},{p.w})",
        Slot::Count(n) => return "count({n})",
        Slot::None => return "none",
    }
}

// The sibling with an ORDINARY payload at the same position must still find it
// in the first slot -- it may not read the widened value's leaves.
@test(output = "two(1,2)\nfour(1,2,3,4)\ncount(9)\nnone")
fn every_variant_at_a_widened_position() {
    print("{render(Slot::Two(P2 { x: 1, y: 2 }))}")
    print("{render(Slot::Four(P4 { x: 1, y: 2, z: 3, w: 4 }))}")
    print("{render(Slot::Count(9))}")
    print("{render(Slot::None)}")
}

// Round-trip through a struct field, which is where the flat encoding is the
// whole point: the payload lives in the parent's dotted slots.
struct Holder { id: int, slot: Slot }

@test(output = "5 two(6,7) 8 four(1,2,3,4)")
fn flat_field_round_trips_both_widths() {
    let a = Holder { id: 5, slot: Slot::Two(P2 { x: 6, y: 7 }) }
    let b = Holder { id: 8, slot: Slot::Four(P4 { x: 1, y: 2, z: 3, w: 4 }) }
    print("{a.id} {render(a.slot)} {b.id} {render(b.slot)}")
}

// A reassignment from the wide variant to the narrow one must clear the slots
// the wide one filled, else the narrow arm reads a stale leaf.
@test(output = "four(1,2,3,4) two(6,7)")
fn a_narrow_write_clears_the_wide_slots() {
    let h = Holder { id: 0, slot: Slot::Four(P4 { x: 1, y: 2, z: 3, w: 4 }) }
    let before = render(h.slot)
    h.slot = Slot::Two(P2 { x: 6, y: 7 })
    print("{before} {render(h.slot)}")
}

// Two DISTINCT `nobox` shapes of the SAME width at one position share one
// positional layout.

nobox value Uv { u: float, v: float }

enum Pair {
    Point(P2),
    Texel(Uv),
}

fn render_pair(p: Pair) -> string {
    match p {
        Pair::Point(q) => return "point({q.x},{q.y})",
        Pair::Texel(t) => return "texel({t.u},{t.v})",
    }
}

@test(output = "point(1,2) texel(3,4)")
fn same_width_shapes_share_one_position() {
    print("{render_pair(Pair::Point(P2 { x: 1, y: 2 }))} {render_pair(Pair::Texel(Uv { u: 3, v: 4 }))}")
}

// A widened position must not shift a LATER position's slot: the sibling's
// trailing payload has to survive the widest variant's width.
enum Tagged {
    Wide(P4, int),
    Narrow(P2, int),
    Plain(int, int),
}

fn render_tagged(t: Tagged) -> string {
    match t {
        Tagged::Wide(p, n) => return "wide({p.x},{p.w},{n})",
        Tagged::Narrow(p, n) => return "narrow({p.x},{p.y},{n})",
        Tagged::Plain(a, n) => return "plain({a},{n})",
    }
}

@test(output = "wide(1,4,10) narrow(5,6,11) plain(7,12)")
fn a_trailing_position_survives_the_widening() {
    let w = render_tagged(Tagged::Wide(P4 { x: 1, y: 2, z: 3, w: 4 }, 10))
    let n = render_tagged(Tagged::Narrow(P2 { x: 5, y: 6 }, 11))
    print("{w} {n} {render_tagged(Tagged::Plain(7, 12))}")
}

// The trailing position is itself a `nobox` value, so its LEAVES start at the
// widened position's offset rather than at its position index. `Tagged` above
// only ever puts an ordinary payload after the widening, which reads through a
// different consumer than the leaf-binding one.
enum Trailer {
    WideThen(P4, P2),
    NarrowThen(P2, P2),
    PlainThen(int, P2),
}

fn render_trailer(t: Trailer) -> string {
    match t {
        Trailer::WideThen(a, b) => return "wide({a.x},{a.w},{b.x},{b.y})",
        Trailer::NarrowThen(a, b) => return "narrow({a.x},{a.y},{b.x},{b.y})",
        Trailer::PlainThen(a, b) => return "plain({a},{b.x},{b.y})",
    }
}

@test(output = "wide(1,4,20,21) narrow(5,6,30,31) plain(7,40,41)")
fn a_trailing_nobox_position_reads_its_own_leaves() {
    let w = render_trailer(Trailer::WideThen(P4 { x: 1, y: 2, z: 3, w: 4 }, P2 { x: 20, y: 21 }))
    let n = render_trailer(Trailer::NarrowThen(P2 { x: 5, y: 6 }, P2 { x: 30, y: 31 }))
    print("{w} {n} {render_trailer(Trailer::PlainThen(7, P2 { x: 40, y: 41 }))}")
}

// -- An enum ELEMENT of a container stores its payload splat
// (`{__variant, x, y}`), as it does inside a tuple element. The containers are
// globals so the vec escapes; a local one is scalarized away. --

enum ElementPayload {
    V2(Vec2),
    FloatArray([float]),
}

global BOXED: [ElementPayload] = []
global PAIRS: [(string, ElementPayload)] = []

fn push_v2(v: Vec2) {
    BOXED.push(ElementPayload::V2(v))
}

fn push_pair(k: string, v: Vec2) {
    PAIRS.push((k, ElementPayload::V2(v)))
}

@test
fn a_bare_enum_element_stores_its_payload_splat() {
    push_v2(Vec2 { x: 3.0, y: 4.0 })
    match BOXED[0] {
        ElementPayload::V2(v) => {
            assert_eq(v.x, 3.0)
            assert_eq(v.y, 4.0)
        },
        ElementPayload::FloatArray(a) => assert_eq(a.len, -1),
    }
}

@test
fn an_enum_inside_a_tuple_element_agrees_with_the_bare_one() {
    push_pair("k", Vec2 { x: 5.0, y: 6.0 })
    let (k, p) = PAIRS[0]
    assert_eq(k, "k")
    match p {
        ElementPayload::V2(v) => {
            assert_eq(v.x, 5.0)
            assert_eq(v.y, 6.0)
        },
        ElementPayload::FloatArray(a) => assert_eq(a.len, -1),
    }
}

// An inline ctor in the push takes the same route as a param-fed value.
@test
fn an_inline_ctor_in_the_push_takes_the_same_route() {
    BOXED.push(ElementPayload::V2(Vec2 { x: 7.0, y: 8.0 }))
    match BOXED[BOXED.len - 1] {
        ElementPayload::V2(v) => assert_eq(v.x + v.y, 15.0),
        ElementPayload::FloatArray(a) => assert_eq(a.len, -1),
    }
}
