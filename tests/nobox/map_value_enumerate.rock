// `enumerate` over a flat `Map<K, P>` walks the hash spine and reads each value
// leaf-wise from the columns, exactly like the plain `for (k, v) in m` loop.

@test fn map_nobox_enumerate_reads_values() {
    let m: Map<string, Vec2> = map_new()
    m["a"] = Vec2 { x: 1.0, y: 2.0 }
    m["b"] = Vec2 { x: 3.0, y: 4.0 }
    let n = 0
    let sum = 0.0
    let index_sum = 0
    for (i, (k, v)) in enumerate(m) {
        n += 1
        index_sum += i
        sum += v.x + v.y
    }
    assert_eq(n, 2)
    assert_eq(index_sum, 1)
    assert_eq(sum, 10.0)
}

@test fn map_nobox_enumerate_visits_each_key_once() {
    let m: Map<string, Vec2> = map_new()
    m["a"] = Vec2 { x: 1.0, y: 2.0 }
    m["b"] = Vec2 { x: 3.0, y: 4.0 }
    let keys = 0
    for (i, (k, _)) in enumerate(m) {
        if k == "a" || k == "b" {
            keys += 1
        }
    }
    assert_eq(keys, 2)
}
