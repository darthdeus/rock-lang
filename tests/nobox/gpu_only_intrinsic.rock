// Only the GPU call boundary authorizes materialization; the body is still checked.

nobox value NV2 { x: float, y: float }

@intrinsic @gpu_only inline(lua) fn sample_nv2(s: Sampler2D, uv: NV2) -> Vec4 = """
    error("sample_nv2() is GPU-only (shader fns are not CPU-callable)")
"""

@shader(fragment)
fn nobox_sampler_frag(uTexture: Sampler2D, tc: NV2) -> Vec4 {
    return sample_nv2(uTexture, tc)
}

@test(output = "ok")
fn gpu_shaders_in_this_file_emit() {
    print("ok")
}

@shader(fragment)
fn mapped_intrinsic_frag(uTexture: Sampler2D, tc: Vec2) -> Vec4 {
    return texture(uTexture, tc)
}

@shader(fragment)
fn reassigned_sample_frag(uTexture: Sampler2D, tc: Vec2) -> Vec4 {
    let color = texture(uTexture, tc)
    if color.w < 0.5 {
        color = Vec4 { x: color.x * 0.5, y: color.y, z: 0.0, w: 1.0 }
    }
    return color
}

@shader(fragment)
fn separate_color_frag(uTexture: Sampler2D, tc: Vec2) -> Vec4 {
    let sampled = texture(uTexture, tc)
    let rgb = Vec3 { x: sampled.x, y: sampled.y, z: sampled.z }
    if sampled.w < 0.5 {
        rgb = Vec3 { x: sampled.x * 0.5, y: sampled.y, z: 0.0 }
    }
    return Vec4 { x: rgb.x, y: rgb.y, z: rgb.z, w: sampled.w }
}

