// Controls for the opaque generic-return rejection of a nobox field: a boxed
// struct field and an unmarked value field are not flattened, so they still
// read correctly through the generic `field_get` primitive.

struct Pt { x: int, y: int }
struct Holder { p: Pt, tag: int }

fn read_struct_field(h: Holder, f: ReadFieldRef<Holder, Pt>) -> int {
    return field_get(h, f).x
}

@test(output = "7")
fn a_boxed_struct_field_reads_correctly_through_the_same_primitive() {
    let h = Holder { p: Pt { x: 7, y: 0 }, tag: 1 }
    print("{read_struct_field(h, .p)}")
}

value VPt { x: int, y: int }
struct VHolder { p: VPt, tag: int }

fn read_value_field(h: VHolder, f: ReadFieldRef<VHolder, VPt>) -> int {
    return field_get(h, f).x
}

@test(output = "9")
fn an_unmarked_value_field_reads_correctly_through_the_same_primitive() {
    let h = VHolder { p: VPt { x: 9, y: 0 }, tag: 1 }
    print("{read_value_field(h, .p)}")
}
