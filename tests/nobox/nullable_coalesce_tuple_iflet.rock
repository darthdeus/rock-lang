// Regression witnesses for a nullable tuple destructure feeding a nobox value
// join, both as a coalesce RHS and as a plain let value.

nobox value Place { x: int, y: int }

fn maybe_pair(present: bool) -> (int, int)? {
    if present { return (4, 6) }
    return null
}

fn maybe_place(present: bool) -> Place? {
    if present { return Place { x: 1, y: 2 } }
    return null
}

@test(output = "4 6")
fn tuple_iflet_rhs_of_coalesce() {
    let place: Place? = maybe_place(false) ?? if let (a, b) = maybe_pair(true) {
        Place { x: a, y: b }
    } else {
        null
    }
    if place == null { print("missing") } else { print("{place.x} {place.y}") }
}

@test(output = "null")
fn tuple_iflet_plain_let_keeps_else() {
    let place = if let (a, b) = maybe_pair(false) {
        Place { x: a, y: b }
    } else {
        null
    }
    if place == null { print("null") } else { print("{place.x} {place.y}") }
}
