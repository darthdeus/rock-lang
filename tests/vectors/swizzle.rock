// Swizzle reads on Vec2/3/4: xyzw/rgba
// alphabets, len 2-4 (rgba also len 1), repetition, no mixing, read-only.

@test
fn swizzle_vec2_basic() {
    let p = v(1.0, 2.0)
    let q = p.yx
    assert_eq(q.x, 2.0)
    assert_eq(q.y, 1.0)
}

@test
fn swizzle_vec2_identity_and_repeat() {
    let p = v(3.0, 4.0)
    assert_eq(p.xy.x, 3.0)
    assert_eq(p.xx.y, 3.0)
    assert_eq(p.yy.x, 4.0)
}

@test
fn swizzle_vec3_reads() {
    let p = v(1.0, 2.0, 3.0)
    let zyx = p.zyx
    assert_eq(zyx.x, 3.0)
    assert_eq(zyx.y, 2.0)
    assert_eq(zyx.z, 1.0)
    let xy = p.xy
    assert_eq(xy.x, 1.0)
    assert_eq(xy.y, 2.0)
}

@test
fn swizzle_vec4_reads() {
    let c = v(0.1, 0.2, 0.3, 0.4)
    let rgb = c.xyz
    assert_eq(rgb.z, 0.3)
    let wzyx = c.wzyx
    assert_eq(wzyx.x, 0.4)
    assert_eq(wzyx.w, 0.1)
}

@test
fn swizzle_rgba_alphabet() {
    let c = v(0.5, 0.6, 0.7, 0.8)
    assert_eq(c.r, 0.5)
    assert_eq(c.a, 0.8)
    let bgr = c.bgr
    assert_eq(bgr.x, 0.7)
    assert_eq(bgr.z, 0.5)
    let rg = c.rg
    assert_eq(rg.y, 0.6)
}

@test
fn swizzle_widen_vec2_to_vec4() {
    let p = v(1.0, 2.0)
    let q = p.xxyy
    assert_eq(q.x, 1.0)
    assert_eq(q.z, 2.0)
    assert_eq(q.w, 2.0)
}

@test
fn swizzle_of_expression_result() {
    let a = v(1.0, 2.0)
    let b = v(10.0, 20.0)
    let s = (a + b).yx
    assert_eq(s.x, 22.0)
    assert_eq(s.y, 11.0)
}

fn take_vec2(p: Vec2) -> float { return p.x + p.y }

@test
fn swizzle_as_call_arg() {
    let c = v(1.0, 2.0, 3.0, 4.0)
    assert_eq(take_vec2(c.zw), 7.0)
}
