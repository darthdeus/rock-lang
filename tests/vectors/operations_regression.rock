// Overloaded constructors and a struct-by-int operator used inside nested range
// loops, the shape that was investigated during the Arena iteration bug fix.

struct FixVec2 {
    x: float,
    y: float,
}

fn fixv() -> FixVec2 {
    return FixVec2 { x: 0.0, y: 0.0 }
}

fn fixv(x: float) -> FixVec2 {
    return FixVec2 { x: x, y: x }
}

fn fixv(x: float, y: float) -> FixVec2 {
    return FixVec2 { x: x, y: y }
}

operator *(v: FixVec2, scale: int) -> FixVec2 {
    let s = float(scale)
    return FixVec2 { x: v.x * s, y: v.y * s }
}

@test(output = "0 0\n5 5\n10 20")
fn test_v_function_overloads() {
    let vec0 = fixv()
    let vec1 = fixv(5.0)
    let vec2 = fixv(10.0, 20.0)
    print("{int(vec0.x)} {int(vec0.y)}")
    print("{int(vec1.x)} {int(vec1.y)}")
    print("{int(vec2.x)} {int(vec2.y)}")
}

@test(output = "56 56\n-84 -84\n6 6\n3 6")
fn test_vec2_multiplication_operator() {
    let scaled = fixv(2.0, 2.0) * 28
    let negated = fixv(3.0, 3.0) * (-28)
    let chained = fixv(1.0, 1.0) * 2 * 3
    let neg = fixv(-1.0, -2.0) * (-3)
    print("{int(scaled.x)} {int(scaled.y)}")
    print("{int(negated.x)} {int(negated.y)}")
    print("{int(chained.x)} {int(chained.y)}")
    print("{int(neg.x)} {int(neg.y)}")
}

@test(output = "-84\n-28\n-84\n0\n-84\n28\n84\n-28\n84\n0\n84\n28")
fn test_loop_with_vec_operations() {
    let bg_size = 28
    let span = 3

    for x in (-span)..(span + 1) {
        if x == -3 || x == 3 {
            for y in (-1)..2 {
                let result = fixv(float(x), float(y)) * bg_size
                print(int(result.x))
                print(int(result.y))
            }
        }
    }
}

@test(output = "1\na\n2\nb\n3\nc")
fn test_tuple_access_in_vectors() {
    let items = [(1, "a"), (2, "b"), (3, "c")]
    for i in 0..3 {
        if let item = vec_get(items, i) {
            print(tuple_first(item))
            print(tuple_second(item))
        }
    }
}
