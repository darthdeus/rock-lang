// Pin the `d()`/inspect __rock_get_type consumer on the converged,
// metatable-free Vec shape.
// `inspect` identifies a Vec via `__rock_get_type`, which now reads the direct
// `__ty = "Vec"` tag rather than the (removed) metatable `__rock_type`.
//
// Structural Vec `==` is pinned separately in tests/structural_equality.rock.

@test(output = "Vec {{ 1, 2, 3 }}")
fn vec_inspect_repr() {
    let xs = [1, 2, 3]
    print(inspect(xs, true, 6))
}
