// Vec2/Vec3/Vec4 algebra from the stdlib (stdlib/vec.rock): construction and
// pure algebra resolve in a bare program with no engine. Vec3 matches Vec2
// where sensible and Vec4 carries the shader-facing algebra.

@test
fn vec2_stdlib_arithmetic() {
    let a = Vec2 { x: 3.0, y: 4.0 }
    let b = Vec2 { x: 1.0, y: 2.0 }

    let sum = a + b
    assert(sum.x == 4.0)
    assert(sum.y == 6.0)

    assert(a.dot(b) == 11.0)
    assert(a.length() == 5.0)
}

@test
fn vec3_vec4_construct_in_stdlib() {
    let c = Vec3 { x: 1.0, y: 2.0, z: 3.0 }
    let d = Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 4.0 }

    assert(c.z == 3.0)
    assert(d.w == 4.0)
}

@test
fn vec3_componentwise_mul() {
    let a = Vec3 { x: 2.0, y: 3.0, z: 4.0 }
    let b = Vec3 { x: 5.0, y: 6.0, z: 7.0 }
    let c = a * b
    assert(c.x == 10.0)
    assert(c.y == 18.0)
    assert(c.z == 28.0)
}

@test
fn vec3_add_scalar() {
    let a = Vec3 { x: 1.0, y: 2.0, z: 3.0 }
    let c = a + 10.0
    assert(c.x == 11.0)
    assert(c.y == 12.0)
    assert(c.z == 13.0)
}

@test
fn vec3_neg() {
    let a = Vec3 { x: 1.0, y: -2.0, z: 3.0 }
    let n = a.neg()
    assert(n.x == -1.0)
    assert(n.y == 2.0)
    assert(n.z == -3.0)
}

@test
fn vec3_abs_sign() {
    let a = Vec3 { x: -3.0, y: 2.0, z: 5.0 }
    let ab = a.abs()
    assert(ab.x == 3.0 && ab.y == 2.0 && ab.z == 5.0)
    let s = a.sign()
    assert(s.x == -1.0 && s.z == 1.0)
}

@test
fn vec4_ctor_and_ops() {
    let a = v(1.0, 2.0, 3.0, 4.0)
    assert(a.x == 1.0 && a.w == 4.0)

    let b = v(5.0, 6.0, 7.0, 8.0)
    let sum = a + b
    assert(sum.x == 6.0 && sum.w == 12.0)

    let diff = b - a
    assert(diff.x == 4.0 && diff.w == 4.0)

    let scaled = a * 2.0
    assert(scaled.x == 2.0 && scaled.w == 8.0)

    let scaled2 = 2.0 * a
    assert(scaled2.z == 6.0)

    let divd = b / 2.0
    assert(divd.x == 2.5)

    let cw = a * b
    assert(cw.x == 5.0 && cw.w == 32.0)
}

@test
fn vec4_add_scalar() {
    let a = v(1.0, 2.0, 3.0, 4.0)
    let c = a + 1.0
    assert(c.x == 2.0 && c.w == 5.0)
}

@test
fn vec4_dot_length_normalize_lerp() {
    let a = v(1.0, 2.0, 3.0, 4.0)
    let b = v(5.0, 6.0, 7.0, 8.0)
    assert(a.dot(b) == 70.0)

    let u = v(0.0, 0.0, 0.0, 2.0)
    assert(u.length() == 2.0)

    let n = u.normalize()
    assert(n.w == 1.0 && n.x == 0.0)

    let z = v(0.0, 0.0, 0.0, 0.0)
    let zn = z.normalize()
    assert(zn.x == 0.0 && zn.w == 0.0)

    let l = a.lerp(b, 0.5)
    assert(l.x == 3.0 && l.w == 6.0)
}
