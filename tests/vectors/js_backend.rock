// Vec sort and drain equality on the JS backend. LuaJIT's table.sort is
// unstable and JS's is stable, so sort tests check only the key order, never a
// tie order.

fn show_ints(xs: [int]) -> string {
    let parts: [string] = []
    for x in xs { parts.push(tostring(x)) }
    return join(parts, " ")
}

@test(output = "1 2 3 5 8")
fn test_sort_ascending() {
    let xs = [5, 3, 8, 1, 2]
    xs.sort((x: int) => float(x))
    print(show_ints(xs))
}

// A derived key (negation) sorts descending.
@test(output = "8 5 3 2 1")
fn test_sort_descending() {
    let xs = [5, 3, 8, 1, 2]
    xs.sort((x: int) => float(-x))
    print(show_ints(xs))
}

@test(output = "a bb ccc dddd")
fn test_sort_by_length() {
    let xs = ["ccc", "a", "dddd", "bb"]
    xs.sort((s: string) => float(s.len()))
    print(join(xs, " "))
}

// Duplicate keys: the KEY SEQUENCE is non-decreasing after sort regardless of
// tie order (order-invariant, so both backends agree).
@test(returns = 1)
fn test_sort_dup_keys_nondecreasing() -> int {
    let xs = [3, 1, 3, 2, 1, 2]
    xs.sort((x: int) => float(x))
    let ok = 1
    for i in 0..(xs.len - 1) {
        if xs[i] > xs[i + 1] { ok = 0 }
    }
    ok
}

@test(output = "true true true true false")
fn drained_vec_equals_fresh_literal() {
    let popped = [1, 2, 3]
    let _ = popped.pop()
    let cleared = [1, 2, 3]
    cleared.clear()
    let empty: [int] = []
    let removed = [1, 2, 3, 4]
    let _ = removed.remove_at(1)
    let swapped = [1, 2, 3, 4]
    let _ = swapped.swap_remove(1)
    print("{popped == [1, 2]} {cleared == empty} {removed == [1, 3, 4]} {swapped == [1, 4, 3]} {popped == [1, 9]}")
}
