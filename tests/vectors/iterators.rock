// Iterator adapters over vecs: `.iter()` over `[T?]` yields every element
// including nulls (a nil-sentinel iteration would truncate at the first null),
// and `.map(_.N)` projects tuple fields. Arena pair projections with a filter
// are in tests/arenas/iteration.rock.

struct Bag { v: int }

@test(output = "1\n0\n3")
fn map_yields_for_null_elements() {
    let xs: [Bag?] = [Bag { v: 1 }, null, Bag { v: 3 }]
    let ys = xs.iter().map(b => if b != null { b.v } else { 0 }).collect()
    for y in ys { print(y) }
}

@test(output = "2")
fn filter_inspects_null_elements() {
    let xs: [Bag?] = [Bag { v: 1 }, null, Bag { v: 3 }]
    // Predicate gets to see all three; filter should keep the 2 non-nulls.
    let kept = xs.iter().filter(b => b != null).collect()
    print(kept.len())
}

// A plain for loop over `[T?]` also visits the null element.
@test(output = "1\nnull\n3")
fn for_over_nullable() {
    let xs: [Bag?] = [Bag { v: 1 }, null, Bag { v: 3 }]
    for x in xs {
        if x != null { print(x.v) } else { print("null") }
    }
}

struct Mob { name: string, health: int }

@test(output = "Goblin\nOrc")
fn vec_dot1_from_arena_map() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Goblin", health: 30 })
    mobs.insert(Mob { name: "Orc", health: 100 })

    // A tuple-valued map keeps the entity paired; .map(_.1) projects it out.
    let names = mobs.pairs().map(p => (p.0, p.1.name)).map(_.1).collect()
    for name in names {
        print(name)
    }
}

@test(output = "0")
fn vec_dot0_empty() {
    let pairs: [(int, string)] = []
    let firsts = pairs.iter().map(_.0).collect()
    print(vec_len(firsts))
}
