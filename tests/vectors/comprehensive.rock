// Comprehensive vector tests ported from rock/tests/vec_tests.rs
// Tests basic array operations, indexing, iteration, and vector functions

// Helper function for vector operations
fn sum_vec(arr: [int]) -> int {
    let total = 0
    for x in arr {
        total = total + x
    }
    return total
}

@test(output = "10\n20\n30")
fn vec_basic_creation_and_access() {
    // Test basic Vec creation with array literals
    let v = [10, 20, 30]
    print(v[0])
    print(v[1])
    print(v[2])
}

@test(output = "10\n25\n30")
fn vec_indexing_write() {
    // Test Vec write indexing
    let v = [10, 20, 30]
    v[1] = 25
    print(v[0])
    print(v[1])
    print(v[2])
}

@test(output = "3\n1\n3\n3\n2")
fn vec_basic_operations() {
    // Test basic Vec operations
    let v = vec_new()
    vec_push(v, 1)
    vec_push(v, 2)
    vec_push(v, 3)

    print(vec_len(v))
    print(vec_get(v, 0))
    print(vec_get(v, 2))

    let popped = pop(v)
    print(popped)
    print(vec_len(v))
}

@test(output = "15")
fn vec_iteration_simple() {
    // Test simple Vec iteration
    let v = [1, 2, 3, 4, 5]
    let sum = 0

    for x in v {
        sum = sum + x
    }

    print(sum)
}

@test(output = "0:10\n1:20\n2:30")
fn vec_iteration_with_manual_indexing() {
    // Test Vec iteration with manual counter (workaround for tuple destructuring)
    let v = [10, 20, 30]
    let i = 0

    for x in v {
        print("{i}:{x}")
        i = i + 1
    }
}

@test(output = "15")
fn vec_as_function_parameter() {
    // Test passing Vec to functions
    let nums = [1, 2, 3, 4, 5]
    print(sum_vec(nums))
}

@test(output = "hello\nworld\ntrue\ntrue")
fn vec_with_different_types() {
    // Test Vec with different element types
    let strings = ["hello", "world"]
    print(strings[0])
    print(strings[1])

    let bools = [true, false, true]
    print(bools[0])
    print(bools[2])
}

@test(output = "10\n20\n10")
fn vec_compound_assignment() {
    // Test compound assignment with Vec elements
    let v = [5, 10, 15]
    v[0] += 5
    v[1] *= 2
    v[2] -= 5

    print(v[0])
    print(v[1])
    print(v[2])
}

@test(output = "0\n1\n42")
fn vec_empty_array() {
    // Test empty array creation
    let empty: [int] = []
    print(vec_len(empty))

    vec_push(empty, 42)
    print(vec_len(empty))
    print(empty[0])
}

@test(output = "false\n3\ntrue\n0")
fn vec_clear_and_is_empty() {
    // Test Vec clear and is_empty operations
    let v = [1, 2, 3]
    print(is_empty(v))
    print(vec_len(v))

    clear(v)
    print(is_empty(v))
    print(vec_len(v))
}

@test(output = "20\n4")
fn vec_direct_indexing_of_literals() {
    // Test direct indexing of array literals
    print([10, 20, 30][1])
    print([1, 2, 3, 4][3])
}

@test(output = "1\n2\n3\n4")
fn vec_nested_operations() {
    // Test more complex nested operations
    let matrix = [[1, 2], [3, 4]]
    print(matrix[0][0])
    print(matrix[0][1])
    print(matrix[1][0])
    print(matrix[1][1])
}

@test(output = "30\n40\n50\n99")
fn vec_with_expressions() {
    // Test Vec indexing with complex expressions
    let v = [10, 20, 30, 40, 50]
    let i = 2

    print(v[i])
    print(v[i + 1])
    print(v[i * 2])

    v[i + 1] = 99
    print(v[3])
}

@test(output = "5\n3\n4\n1\n2\n4\n5")
fn vec_remove_operations() {
    // Test Vec remove operations
    let v = [1, 2, 3, 4, 5]
    print(vec_len(v))

    let removed = remove_at(v, 2)
    print(removed)
    print(vec_len(v))

    // Check remaining elements
    for x in v {
        print(x)
    }
}