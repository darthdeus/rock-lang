// Vec.sort corpus for the `--backend js` ratchet (T8d). The stdlib inline(lua)
// `table.sort(_data, |a,b| key(a) < key(b))` maps to the `__vec_sort` runtime:
// sort the logical `1..len` slice in place (index 0 is the layout hole),
// key_fn invoked through `__rock_call`. luajit's table.sort is unstable and JS's
// is stable, so tie-break order can differ between backends -- these tests
// assert only order-invariant properties (the sorted key sequence), never a
// specific tie order. Pins crates/skull-codegen-js/tests/sort.rs.

fn show_ints(xs: [int]) -> string {
    let parts: [string] = []
    for x in xs { parts.push(tostring(x)) }
    return join(parts, " ")
}

@test(output = "1 2 3 5 8")
fn test_sort_ascending() {
    let xs = [5, 3, 8, 1, 2]
    xs.sort((x: int) => float(x))
    print(show_ints(xs))
}

// A derived key (negation) sorts descending.
@test(output = "8 5 3 2 1")
fn test_sort_descending() {
    let xs = [5, 3, 8, 1, 2]
    xs.sort((x: int) => float(-x))
    print(show_ints(xs))
}

@test(output = "a bb ccc dddd")
fn test_sort_by_length() {
    let xs = ["ccc", "a", "dddd", "bb"]
    xs.sort((s: string) => float(s.len()))
    print(join(xs, " "))
}

// Sorting an empty Vec is a no-op.
@test(output = "")
fn test_sort_empty() {
    let xs: [int] = []
    xs.sort((x: int) => float(x))
    print(show_ints(xs))
}

@test(output = "42")
fn test_sort_single() {
    let xs = [42]
    xs.sort((x: int) => float(x))
    print(show_ints(xs))
}

// Duplicate keys: the KEY SEQUENCE is non-decreasing after sort regardless of
// tie order (order-invariant, so both backends agree).
@test(returns = 1)
fn test_sort_dup_keys_nondecreasing() -> int {
    let xs = [3, 1, 3, 2, 1, 2]
    xs.sort((x: int) => float(x))
    let ok = 1
    for i in 0..(xs.len - 1) {
        if xs[i] > xs[i + 1] { ok = 0 }
    }
    ok
}
