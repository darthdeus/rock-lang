nobox value Point { x: int, y: int }
nobox value Row { point: Point?, id: int }
nobox value Positioned { point: Point, id: int }

fn __op_add(point: Point, amount: int) -> Point {
    return Point { x: point.x + amount, y: point.y }
}
struct Calls { order: int = 0 }

fn mark(c: Calls, digit: int, result: int) -> int {
    c.order = 10 * c.order + digit
    return result
}

@test
fn guarded_write_to_nullable_column_element() {
    let xs: [Point?] = [Point { x: 1, y: 2 }, null]
    let calls = Calls {}
    for i in 0..2 {
        xs[mark(calls, 1, i)]?.x = mark(calls, 2, 7)
        xs[mark(calls, 3, i)]?.x += mark(calls, 4, 5)
    }
    assert_eq(calls.order, 123413)
    assert_eq(xs[0]?.x ?? -1, 12)
    assert_eq(xs[0]?.y ?? -1, 2)
    assert(xs[1] == null)
}

@test
fn guarded_write_to_nested_columns() {
    let xs: [Row?] = [
        Row { point: Point { x: 1, y: 2 }, id: 3 },
        Row { point: null, id: 4 },
        null,
    ]
    for i in 0..3 { xs[i]?.point?.x += 7 }
    assert_eq(xs[0]?.point?.x ?? -1, 8)
    assert_eq(xs[0]?.point?.y ?? -1, 2)
    assert(xs[1]?.point == null && xs[2] == null)
    for i in 0..3 { xs[i]?.point = Point { x: 9, y: 10 } }
    assert_eq(xs[0]?.point?.x ?? -1, 9)
    assert_eq(xs[1]?.point?.y ?? -1, 10)
    assert_eq(xs[1]?.id ?? -1, 4)
    assert(xs[2] == null)
    xs[1]?.point = null
    assert(xs[1]?.point == null)

    let positions: [Positioned?] = [Positioned { point: Point { x: 1, y: 2 }, id: 3 }, null]
    for i in 0..2 { positions[i]?.point += 7 }
    assert_eq(positions[0]?.point?.x ?? -1, 8)
    assert_eq(positions[0]?.point?.y ?? -1, 2)
    assert_eq(positions[0]?.id ?? -1, 3)
    assert(positions[1] == null)
}

@test
fn guarded_write_to_map_value_columns() {
    let rows: Map<string, Row?> = map_new()
    rows["present"] = Row { point: Point { x: 1, y: 2 }, id: 3 }
    rows["absent"] = Row { point: null, id: 4 }
    for key in ["present", "absent"] { rows[key]?.point?.x += 7 }
    assert_eq(rows["present"]?.point?.x ?? -1, 8)
    assert(rows["absent"]?.point == null)
}

@test
fn guarded_write_to_arena_borrow() {
    let rows: Arena<Row> = arena_new()
    let h = rows.insert(Row { point: Point { x: 1, y: 2 }, id: 3 })
    let borrowed = rows.borrow(h)
    borrowed?.id += 7
    rows.borrow(h)?.point?.x = 9
    assert_eq(h.get()?.id ?? -1, 10)
    assert_eq(h.get()?.point?.x ?? -1, 9)
    let _ = rows.remove(h)
    let calls = Calls {}
    rows.borrow(h)?.id = mark(calls, 1, 10)
    assert_eq(calls.order, 0)
}

struct Counter { n: int }
nobox value CounterRow { counter: Counter? }

@test
fn guarded_write_through_reference_columns() {
    let counter = Counter { n: 5 }
    let optional: [CounterRow?] = [CounterRow { counter: counter }, CounterRow { counter: null }, null]
    for i in 0..3 { optional[i]?.counter?.n += 2 }
    assert_eq(counter.n, 7)

    let required: [CounterRow] = [CounterRow { counter: counter }, CounterRow { counter: null }]
    for i in 0..2 { required[i].counter?.n += 3 }
    assert_eq(counter.n, 10)
}

nobox value Wide { point: Point?, a: int, b: int, c: int }

@test
fn guarded_write_to_strided_row() {
    let xs = [
        Wide { point: Point { x: 1, y: 2 }, a: 3, b: 4, c: 5 },
        Wide { point: null, a: 6, b: 7, c: 8 },
    ]
    for i in 0..2 { xs[i].point?.x += 7 }
    assert_eq(xs[0].point?.x ?? -1, 8)
    assert_eq(xs[0].point?.y ?? -1, 2)
    assert(xs[1].point == null)
}
