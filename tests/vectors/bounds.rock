// Vec element bounds: `xs[i]` reads and stores raise on an index outside the
// live length, `.get(i)` returns null and `.set(i, v)` raises. A `false`
// element of `[bool]` reads as `false`, and record and nested-vector element
// reads raise out of bounds whether or not their loop proves the index.

@intrinsic @nomangle inline(lua) fn try_call(f: fn()) -> bool = """
    local ok, err = pcall(f)
    return not ok
"""

@test
fn in_bounds_read_store() {
    let xs = [10, 20, 30]
    xs[0] = 11
    xs[2] = 33
    xs[1] += 10
    assert(xs[0] == 11)
    assert(xs[1] == 30)
    assert(xs[2] == 33)
}

@test
fn oob_read_errors() {
    let xs = [1, 2, 3]
    assert(try_call(() => { let _ = xs[3] }))
    assert(try_call(() => { let _ = xs[-1] }))
}

@test
fn oob_store_errors() {
    let xs = [1, 2, 3]
    assert(try_call(() => { xs[3] = 9 }))
    assert(try_call(() => { xs[-1] = 9 }))
}

@test
fn get_returns_null_oob() {
    let xs = [1, 2, 3]
    assert(xs.get(3) == null)
    assert(xs.get(-1) == null)
    assert((xs.get(2) ?? -1) == 3)
}

@test
fn set_oob_errors() {
    let xs = [1, 2, 3]
    assert(try_call(() => xs.set(3, 9)))
    xs.set(1, 22)
    assert(xs[1] == 22)
}

@nomangle inline(lua) fn read_error(f: fn()) -> string = """
    local ok, err = pcall(f)
    if ok then return "ok" end
    return (tostring(err):gsub("^.-: ", ""))
"""

@nomangle inline(js) fn read_error(f: fn()) -> string = """
    try { __rock_call(f); return "ok"; }
    catch (e) { return (e instanceof Error) ? e.message : String(e); }
"""

struct Mote { x: int, life: int }
struct Bank { live: [bool], motes: [Mote] }

fn flags(n: int) -> [bool] {
    let out: [bool] = []
    for i in 0..n { out.push(i % 4 == 1) }
    return out
}

fn bank(n: int) -> Bank {
    let motes: [Mote] = []
    for i in 0..n { motes.push(Mote { x: i, life: i % 3 }) }
    return Bank { live: flags(n), motes: motes }
}

@test(output = "3 3 10")
fn false_elements_read_as_false() {
    let xs = flags(10)
    let indexed = 0
    for i in 0..xs.len() { if xs[i] { indexed += 1 } }
    let walked = 0
    for x in xs { if x { walked += 1 } }
    let agree = 0
    for (i, x) in enumerate(xs) { if x == (i % 4 == 1) { agree += 1 } }
    print("{indexed} {walked} {agree}")
}

@test(output = "15 4")
fn bool_column_selects_record_rows() {
    let b = bank(10)
    let t = 0
    let n = 0
    for i in 0..b.live.len() {
        if b.live[i] { t += b.motes[i].x }
        if b.motes[i].life == 0 { n += 1 }
    }
    print("{t} {n}")
}

@test(output = "15 6")
fn record_and_nested_vector_elements_read_in_loops() {
    let b = bank(6)
    let t = 0
    for m in b.motes { t += m.x }
    let rows: [[int]] = [[1, 2], [], [3]]
    let s = 0
    for row in rows { for x in row { s += x } }
    print("{t} {s}")
}

@test(output = "Vec index out of bounds: index 3 is outside [0, 3) | Vec index out of bounds: index -1 is outside [0, 3) | Vec index out of bounds: index 3 is outside [0, 3)")
fn out_of_bounds_reads_raise() {
    let xs = [false, false, false]
    let ms = [Mote { x: 1, life: 1 }, Mote { x: 2, life: 2 }, Mote { x: 3, life: 3 }]
    let i = xs.len()
    let past = read_error(() => { if xs[i] { print("read") } })
    let j = -1
    let before = read_error(() => { if xs[j] { print("read") } })
    let record = read_error(() => { print(ms[i].x) })
    print("{past} | {before} | {record}")
}

@test(output = "0,0, Vec index out of bounds: index 2 is outside [0, 2) | 1,2, Vec index out of bounds: index 2 is outside [0, 2)")
fn popped_slots_raise_in_loops() {
    let xs = [false, false, false, false]
    let out = ""
    let err = read_error(() => {
        for x in xs {
            if out == "" {
                xs.pop()
                xs.pop()
            }
            out = out + (if x { "1," } else { "0," })
        }
    })
    let ms = [Mote { x: 1, life: 0 }, Mote { x: 2, life: 0 }, Mote { x: 3, life: 0 }, Mote { x: 4, life: 0 }]
    let seen = ""
    let merr = read_error(() => {
        for m in ms {
            if m.x == 1 {
                ms.pop()
                ms.pop()
            }
            seen = seen + "{m.x},"
        }
    })
    print("{out} {err} | {seen} {merr}")
}

@test(output = "4 20 4")
fn arena_walks_skip_removed_slots() {
    let us: Arena<Mote> = arena_new()
    let drop: [Entity<Mote>] = []
    for i in 0..8 {
        let e = us.insert(Mote { x: i, life: i % 3 })
        if i % 2 == 0 { drop.push(e) }
    }
    for e in drop { us.remove(e) }
    let n = 0
    for (_, _) in us { n += 1 }
    let t = 0
    for (e, m) in us { t += m.x + e._slot % 2 }
    let k = 0
    for item in us { if item.1.life >= 0 { k += 1 } }
    print("{n} {t} {k}")
}
