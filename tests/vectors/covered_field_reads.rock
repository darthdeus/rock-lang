value Layer { volume: float, speed: float, offset: float, name: string }
@lua_named struct Step { layers: Vec<Layer> }
global marks: int = 0
fn mark() -> int { marks += 1; return 1 }
@nomangle fn name_total(step: Step) -> int {
    let n = 0
    for layer in step.layers { n += layer.name.len() }
    return n
}
@nomangle fn read_after_call(step: Step) -> int {
    let n = 0
    for layer in step.layers {
        let copy = layer
        n += mark()
        n += copy.name.len()
    }
    return n
}
@test(output = "5 7 2")
fn copied_layer_keeps_its_name_after_call() {
    let step = Step { layers: [
        Layer { volume: 1.0, speed: 2.0, offset: 3.0, name: "ab" },
        Layer { volume: 4.0, speed: 5.0, offset: 6.0, name: "cde" },
    ] }
    print("{name_total(step)} {read_after_call(step)} {marks}")
}

inline(lua) fn read_with_poisoned_siblings() -> int = """
    local function make(name)
        return setmetatable({name = name}, {
            __index = function(_, key) error("unused field was read: " .. key) end,
        })
    end
    return name_total({layers = {[0] = 2, make("ab"), make("cde")}})
"""

@test(backends = "lua")
fn name_reads_leave_sibling_fields_unobserved() { assert(read_with_poisoned_siblings() == 5) }
