// `==` after a drain: luajit's __op_eq walks `_data` with pairs, so a drained
// tail nil is invisible, while JS compared `_data` as a dense array and a
// popped or cleared Vec did not equal a fresh literal of the same contents.
// The last case guards against a len-only compare that ignores contents.

@test(output = "true true true true false")
fn drained_vec_equals_fresh_literal() {
    let popped = [1, 2, 3]
    let _ = popped.pop()
    let cleared = [1, 2, 3]
    cleared.clear()
    let empty: [int] = []
    let removed = [1, 2, 3, 4]
    let _ = removed.remove_at(1)
    let swapped = [1, 2, 3, 4]
    let _ = swapped.swap_remove(1)
    print("{popped == [1, 2]} {cleared == empty} {removed == [1, 3, 4]} {swapped == [1, 4, 3]} {popped == [1, 9]}")
}
