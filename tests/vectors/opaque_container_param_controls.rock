// Controls for rejecting a column-stored vec at an opaque `inline(lua)`
// container param (the rejections live in skull's
// inline_lua_column_container_param_sentinel.rs): a boxed element keeps
// `_data` and passes through the same bodies, an `any` param still admits a
// column vec, and a generic param bound to a scalar names no container.

nobox value P { x: float, y: float }

@nomangle inline(lua) fn probe_len<T>(v: [T]) -> int = """
    if v._data == nil then return -1 end
    return #v._data
"""

@test(output = "3", backends = "lua")
fn a_boxed_element_through_the_same_body_is_correct() {
    let xs: [int] = [1, 2, 3]
    print("{probe_len(xs)}")
}

@nomangle inline(lua) fn header_repr(v: any) -> string = """
    return v["@vec"].repr
"""

@test(output = "columns", backends = "lua")
fn an_any_param_still_admits_a_column_vec() {
    let xs: [P] = [P { x: 1.0, y: 2.0 }]
    print("{header_repr(xs)}")
}

@nomangle inline(lua) fn opaque_t<T>(v: T) -> int = """
    if v._data == nil then return -1 end
    return #v._data
"""

@test(output = "3", backends = "lua")
fn a_generic_param_bound_to_a_boxed_vec_is_correct() {
    let xs: [int] = [1, 2, 3]
    print("{opaque_t(xs)}")
}

// The type guard leads because indexing a number throws in Lua before the body
// could answer, which would read as the rule firing.
@nomangle inline(lua) fn opaque_scalar_t<T>(v: T) -> int = """
    if type(v) ~= "table" then return -1 end
    if v._data == nil then return -2 end
    return #v._data
"""

@test(output = "-1", backends = "lua")
fn a_generic_param_bound_to_a_scalar_is_admitted() {
    print("{opaque_scalar_t(7)}")
}
