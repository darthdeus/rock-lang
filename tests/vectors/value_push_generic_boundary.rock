// Pushing or setting a value struct into a `[T]` from a context the inliner
// never splices (a closure body, a nested fn) must store the whole struct, not
// its first scalarized leaf. The direct push is the inlined baseline.

fn run(f: () -> ()) { f() }

@test(output = "7 9")
fn value_push_in_closure_stores_whole_struct() {
    let xs: [Vec2] = []
    run(() => { xs.push(v(7.0, 9.0)) })
    print("{xs[0].x} {xs[0].y}")
}

@test(output = "3 4")
fn value_push_in_nested_fn_stores_whole_struct() {
    let xs: [Vec2] = []
    fn fill(ys: [Vec2]) { ys.push(v(3.0, 4.0)) }
    fill(xs)
    print("{xs[0].x} {xs[0].y}")
}

@test(output = "7 9")
fn value_push_direct_stores_whole_struct() {
    let xs: [Vec2] = []
    xs.push(v(7.0, 9.0))
    print("{xs[0].x} {xs[0].y}")
}

// A value argument at a non-first parameter of an `@inline` generic.
@test(output = "33 44")
fn value_set_in_closure_stores_whole_struct() {
    let xs: [Vec2] = [v(0.0, 0.0)]
    run(() => { xs.set(0, v(33.0, 44.0)) })
    print("{xs[0].x} {xs[0].y}")
}
