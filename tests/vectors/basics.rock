// Vector basics: literals, indexing and index writes, the free-function and
// method surface, vectors as parameters, fields, payloads and return values,
// nested vectors, and for-in / enumerate iteration over scalars and tuples.
// First and last elements are read everywhere so an off-by-one in a `_data`
// accessor shows as a wrong value.

fn sum_vec(arr: [int]) -> int {
    let total = 0
    for x in arr {
        total = total + x
    }
    return total
}

@test(output = "10 25 30\n10 20 10\n30 40 50 99\n20 4\n1 2 3 4\n5 25\nhello world true true\n11 44")
fn vec_index_reads_and_writes() {
    let v = [10, 20, 30]
    v[1] = 25
    print("{v[0]} {v[1]} {v[2]}")

    let c = [5, 10, 15]
    c[0] += 5
    c[1] *= 2
    c[2] -= 5
    print("{c[0]} {c[1]} {c[2]}")

    let e = [10, 20, 30, 40, 50]
    let i = 2
    let before = e[i + 1]
    e[i + 1] = 99
    print("{e[i]} {before} {e[i * 2]} {e[3]}")

    print("{[10, 20, 30][1]} {[1, 2, 3, 4][3]}")

    let matrix = [[1, 2], [3, 4]]
    print("{matrix[0][0]} {matrix[0][1]} {matrix[1][0]} {matrix[1][1]}")
    let row = [[1, 2], [3, 4], [5, 6]][2]
    print("{row[0]} {row[0] * row[0]}")

    let strings = ["hello", "world"]
    let bools = [true, false, true]
    print("{strings[0]} {strings[1]} {bools[0]} {bools[2]}")

    let s = [10, 20, 30, 40]
    s.set(0, 11)
    s.set(3, 44)
    print("{s[0]} {s[3]}")
}

@test(output = "3\n1\n3\n3\n2\n5\n3\n4\n1 2 4 5\n0\n1\n42")
fn vec_free_function_surface() {
    let v = vec_new()
    vec_push(v, 1)
    vec_push(v, 2)
    vec_push(v, 3)
    print(vec_len(v))
    print(vec_get(v, 0))
    print(vec_get(v, 2))
    print(pop(v))
    print(vec_len(v))

    let r = [1, 2, 3, 4, 5]
    print(vec_len(r))
    print(remove_at(r, 2))
    print(vec_len(r))
    print("{r[0]} {r[1]} {r[2]} {r[3]}")

    let empty: [int] = []
    print(vec_len(empty))
    vec_push(empty, 42)
    print(vec_len(empty))
    print(empty[0])
}

@test(output = "v[0]: hi\nv[1]: bye\npopped: bye\nlen after pop: 1\nremaining v[0]: hi\nafter push new: new\nfinal len: 2")
fn vec_push_after_pop() {
    let v = vec_new()
    vec_push(v, "hi")
    vec_push(v, "bye")
    print("v[0]: {v[0]}")
    print("v[1]: {v[1]}")
    let popped = pop(v)
    print("popped: {unwrap(popped)}")
    print("len after pop: {vec_len(v)}")
    print("remaining v[0]: {v[0]}")
    vec_push(v, "new")
    print("after push new: {v[1]}")
    print("final len: {vec_len(v)}")
}

@test(output = "empty len: 0\nis empty: true\npop from empty: nil\nafter push len: 1\nafter clear len: 0\nafter clear is empty: true\nfalse 3 true 0\n0 true 2")
fn vec_empty_clear_and_capacity() {
    let v = vec_new()
    print("empty len: {vec_len(v)}")
    print("is empty: {is_empty(v)}")
    let popped = pop(v)
    print("pop from empty: {popped}")
    vec_push(v, "test")
    print("after push len: {vec_len(v)}")
    clear(v)
    print("after clear len: {vec_len(v)}")
    print("after clear is empty: {is_empty(v)}")

    let full = [1, 2, 3]
    let was_empty = is_empty(full)
    let len = vec_len(full)
    clear(full)
    print("{was_empty} {len} {is_empty(full)} {vec_len(full)}")

    let reserved = vec_new_with_capacity(10)
    let initial = vec_len(reserved)
    let roomy = capacity(reserved) >= 10
    vec_push(reserved, 1)
    vec_push(reserved, 2)
    print("{initial} {roomy} {vec_len(reserved)}")
}

@test(output = "3 1 3\n3 10 40\n20 3 40 30\n10 40 4")
fn vec_method_surface() {
    let p = [1, 2]
    p.push(3)
    let n = p.len()
    let last = p.pop() ?? -1
    print("{n} {p[0]} {last}")

    let r = [10, 20, 30, 40]
    let _ = r.remove_at(1) ?? -1
    print("{r.len()} {r[0]} {r[2]}")

    let s = [10, 20, 30, 40]
    let removed = s.swap_remove(1) ?? -1
    print("{removed} {s.len()} {s[1]} {s[2]}")

    let xs = [10, 20, 30, 40]
    let ys = deepcopy(xs)
    ys.set(0, 99)
    print("{xs[0]} {xs[3]} {ys.len()}")
}

@test(output = "v type: table\nv._data type: table\nv.len: 0\nafter push - v._data type: table\nafter push - v.len: 1")
fn debug_vec_structure() {
    let v = vec_new()
    print("v type: {typeof(v)}")
    print("v._data type: {typeof(v._data)}")
    print("v.len: {v.len}")
    vec_push(v, "test")
    print("after push - v._data type: {typeof(v._data)}")
    print("after push - v.len: {v.len}")
}

@test(output = "0:10\n1:20\n2:30\n60 60 3\ncounted 0 0\nsingle 0: only\n2 9")
fn vec_for_and_enumerate() {
    let v = [10, 20, 30]
    let sum = 0
    for item in v {
        sum = sum + item
    }
    let sum2 = 0
    let isum = 0
    for (i, item) in enumerate(v) {
        print("{i}:{item}")
        isum = isum + i
        sum2 = sum2 + item
    }
    print("{sum} {sum2} {isum}")

    let empty: [int] = []
    let enumerated: [int] = vec_new()
    let iterated = 0
    let counted = 0
    for item in empty {
        iterated = iterated + 1
    }
    for (i, item) in enumerate(enumerated) {
        counted = counted + 1
    }
    print("counted {iterated} {counted}")

    for (i, item) in enumerate(["only"]) {
        print("single {i}: {item}")
    }

    let bools = [true, false, true]
    let true_count = 0
    for b in bools {
        if b {
            true_count = true_count + 1
        }
    }
    let even_sum = 0
    for (idx, num) in enumerate([1, 2, 3, 4, 5]) {
        if idx % 2 == 0 {
            even_sum = even_sum + num
        }
    }
    print("{true_count} {even_sum}")
}

fn get_direct_return() -> [string] {
    return ["a", "b", "c"]
}

fn get_with_variable() -> [string] {
    let arr = ["a", "b", "c"]
    return arr
}

enum Payload {
    Nums([int]),
}

struct Holder {
    items: [int],
}

@test(output = "15\nDirect: a,b,c\nVariable: a,b,c\n10 40\n10 40\nVec {{ 10, 20, 30 }}")
fn vec_through_params_returns_and_fields() {
    print(sum_vec([1, 2, 3, 4, 5]))

    let direct = get_direct_return()
    print("Direct: {direct[0]},{direct[1]},{direct[2]}")
    let variable = get_with_variable()
    print("Variable: {variable[0]},{variable[1]},{variable[2]}")

    match Payload::Nums([10, 20, 30, 40]) {
        Payload::Nums(xs) => print("{xs[0]} {xs[3]}"),
    }
    let h = Holder { items: [10, 20, 30, 40] }
    print("{h.items[0]} {h.items[3]}")

    print(inspect([10, 20, 30]))
}

global items: [bool] = []

@test(output = "2 false\n3\n2 1 true")
fn vec_global_any_and_nullable_elements() {
    items = [true, false]
    print("{vec_len(items)} {items[1]}")

    let mixed: [any] = []
    vec_push(mixed, (1 : any))
    vec_push(mixed, ("two" : any))
    vec_push(mixed, (true : any))
    print(vec_len(mixed))

    let nullable_ints: [int?] = []
    let present: int? = 1
    let absent: int? = null
    vec_push(nullable_ints, present)
    vec_push(nullable_ints, absent)
    print("{vec_len(nullable_ints)} {nullable_ints[0] ?? -1} {nullable_ints[1] == null}")
}

@test(output = "=== Single binding ===\n1:one\n2:two\n3:three\n=== Enumerate ===\nidx=0, num=1, word=one\nidx=1, num=2, word=two\nidx=2, num=3, word=three\n=== Direct tuple destructuring ===\nnum=1, word=\"one\"\nnum=2, word=\"two\"\nnum=3, word=\"three\"")
fn vec_of_tuples() {
    let pairs = [(1, "one"), (2, "two"), (3, "three")]

    print("=== Single binding ===")
    for pair in pairs {
        let num = tuple_first(pair)
        let word = tuple_second(pair)
        print("{num}:{word}")
    }

    print("=== Enumerate ===")
    for (i, pair) in enumerate(pairs) {
        let num = tuple_first(pair)
        let word = tuple_second(pair)
        print("idx={i}, num={num}, word={word}")
    }

    print("=== Direct tuple destructuring ===")
    for (num, word) in pairs {
        print("num={num}, word=\"{word}\"")
    }
}

@test(output = "=== Nested tuples - single binding ===\n(1,2),(3,4)\n(5,6),(7,8)\n=== Nested tuples - tuple destructuring ===\nidx=0: left=(1,2)\nidx=1: left=(5,6)\n=== Single element ===\ni=0, elem=(42,answer)\nEmpty vec iteration count: 0")
fn vec_of_tuples_edge_cases() {
    let nested = [((1, 2), (3, 4)), ((5, 6), (7, 8))]

    print("=== Nested tuples - single binding ===")
    for item in nested {
        let left = tuple_first(item)
        let right = tuple_second(item)
        let a = tuple_first(left)
        let b = tuple_second(left)
        let c = tuple_first(right)
        let d = tuple_second(right)
        print("({a},{b}),({c},{d})")
    }

    print("=== Nested tuples - tuple destructuring ===")
    for (idx, item) in enumerate(nested) {
        let left = tuple_first(item)
        print("idx={idx}: left=({tuple_first(left)},{tuple_second(left)})")
    }

    let single = [(42, "answer")]
    print("=== Single element ===")
    for (i, elem) in enumerate(single) {
        print("i={i}, elem=({tuple_first(elem)},{tuple_second(elem)})")
    }

    let empty: [(int, string)] = []
    let count = 0
    for _ in empty {
        count = count + 1
    }
    print("Empty vec iteration count: {count}")
}

// Clearing drains every slot; a push afterwards reuses the array from index 0.
@test(returns = 68)
fn test_vec_clear_then_push() -> int {
    let xs = [1, 2, 3]
    xs.clear()
    xs.push(7)
    xs[0] * 10 + xs.len - 3
}
