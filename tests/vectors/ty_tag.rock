// A Vec carries no type tag: `__rock_get_type` (used by `==` on `any`,
// `inspect` and `d()`) recognizes one by its `len` field and its `_data` array
// or `@vec` header, so a Vec built by a stdlib helper or raw Lua behaves the same
// as a literal.

@nomangle inline(lua) fn __test_ty_no_mt(v: any) -> string = """
    setmetatable(v, nil)
    return __rock_get_type(v) or "<nil>"
"""

@test(output = "Vec", backends = "lua")
fn vec_identifiable_without_metatable() {
    let v: [int] = vec_new()
    print(__test_ty_no_mt(v))
}

@test(output = "Vec {{ 1, 2, 3 }}")
fn vec_inspect_repr() {
    let xs = [1, 2, 3]
    print(inspect(xs, true, 6))
}

@test(output = "true true\nVec {{ 0, 1, 2 }}")
fn range_vec_is_a_vec() {
    let r = 0..3
    let v = [0, 1, 2]
    print("{r == v} {v == r}")
    print(inspect(r, true, 6))
}
