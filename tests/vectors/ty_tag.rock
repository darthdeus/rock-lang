@nomangle inline(lua) fn __test_ty_no_mt(v: any) -> string = """
    setmetatable(v, nil)
    return __rock_get_type(v) or "<nil>"
"""

@test(output = "Vec", backends = "lua")
fn column_vec_identifiable_without_metatable() {
    let rows: [Vec2?] = [null]
    print(__test_ty_no_mt(rows))
}

@test(output = "Vec {{ 1, 2, 3 }}")
fn vec_inspect_repr() {
    let xs = [1, 2, 3]
    print(inspect(xs, true, 6))
}

@test(output = "true true\nVec {{ 0, 1, 2 }}")
fn range_vec_is_a_vec() {
    let r = 0..3
    let v = [0, 1, 2]
    print("{r == v} {v == r}")
    print(inspect(r, true, 6))
}

@test(output = "<nil>", backends = "lua")
fn an_array_with_a_zero_key_is_not_a_vec() {
    let map: Map<int, int> = map_new()
    map[0] = 1
    print(__test_ty_no_mt(map))
}
