// Adversarial: a value-struct field's *default value* is an expression
// with a side effect, and the literal omits the field. Pass-2 (defaults)
// should evaluate the default; the question is whether multiple
// omitted-field defaults run in declaration order, and whether their
// side effects interact correctly with pass-1 source-order RHS.

@intrinsic @inline inline(lua) fn put(s: string) = "io.write(s)"

global COUNTER: int = 0

fn next_id() -> int {
    COUNTER = COUNTER + 1
    return COUNTER
}

value Tagged {
    a: int,
    b: int = next_id(),
    c: int = next_id(),
}

@nomangle inline(lua) fn __nb_alloc_Tagged(n: int) -> Ptr<Tagged> = 'return ffi.new("Tagged[?]", n)'

fn nb_tagged(n: int) -> NativeBuffer<Tagged> {
    return NativeBuffer { ptr: __nb_alloc_Tagged(n), len: n }
}

@test(output = "a=42\nb=1\nc=2")
fn test_default_side_effect() {
    let buf = nb_tagged(1)
    buf[0] = Tagged { a: 42 }
    let v = buf[0]
    put("a=")
    put("{v.a}")
    put("\n")
    put("b=")
    put("{v.b}")
    put("\n")
    put("c=")
    put("{v.c}")
    put("\n")
}
