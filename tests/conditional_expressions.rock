// Conditional expression tests migrated from rock/tests/type_system_tests.rs conditions module
// Tests if/else expressions, variable assignment in conditionals, scoping, and shadowing
// Covers simple if expressions, nested conditionals, variable assignment patterns, and unwrap operations

// ============================================
// Basic Conditional Expression Tests
// ============================================

@test(output = "5")
fn test_simple_if_else() {
    let result = if true { 5 } else { 6 }
    print(result)
}

@test(output = "2")
fn test_else_if_chain() {
    if false { 
        print(1) 
    } else if true { 
        print(2) 
    } else { 
        print(3) 
    }
}

// ============================================
// Unwrap and Nullable Operations in Conditionals
// ============================================

@test(output = "5")
fn test_simple_unwrap_in_function() {
    let x: int? = 5
    let result = x.unwrap()
    print(result)
}

// ============================================
// Variable Shadowing in Conditionals
// ============================================

@test(output = "5\\n5")
fn test_shadow_variable_in_if() {
    let x: int = 5
    let result = if true {
        let x = x  // Shadow outer x with same value
        print(x)   // Print shadowed x
        x
    } else {
        print(x)   // Print outer x
        x
    }
    print(result)
}

// ============================================
// Nested Conditionals with Complex Logic
// ============================================

@test(output = "5\\n5")
fn test_nested_if_with_unwrap() {
    let x: int? = 5
    let result = if true {
        let y = x.unwrap()
        print(y)
        5
    } else {
        6
    }
    print(result)
}

@test(output = "5\\n5")
fn test_nested_if_with_shadowing() {
    let x: int? = 5
    let result = if true {
        let x = x.unwrap()  // Shadow with unwrapped value
        print(x)
        5
    } else {
        6
    }
    print(result)
}

// ============================================
// Conditional Assignment Tests
// ============================================

// ============================================
// Assignment Within Conditional Blocks
// ============================================

@test(output = "50")
fn test_assignment_inside_conditional_blocks() {
    let y = 0
    
    if false {
        y = 20
    } else {
        y = 50
    }
    
    print(y)
}

@test(output = "10")
fn test_let_inside_if_blocks() {
    let outer = 0
    
    if false {
        let x = 5
        outer = x
    } else {
        let x = 10
        outer = x
    }
    
    print(outer)
}

// ============================================
// Complex Conditional Patterns
// ============================================

@test(output = "assignment complete")
fn test_conditional_with_null_value() {
    let x = 5
    let y = 0
    
    // Test conditional that returns null with type annotation
    let result: any? = if x > 5 {
        y = 20
        null
    } else {
        y = 50
        null
    }
    
    // Check that assignments happened
    if y == 50 {
        print("assignment complete")
    }
}

// ============================================
// Edge Cases and Complex Scenarios
// ============================================

@test(output = "nested scoping works")
fn test_complex_nested_scoping() {
    let value = 10
    
    if true {
        let inner = value * 2
        if inner > 15 {
            let deeper = inner + 5
            if deeper == 25 {
                print("nested scoping works")
            }
        }
    }
}

@test(output = "conditional unwrap success")
fn test_conditional_unwrap_patterns() {
    let maybe_val: int? = 42
    
    if maybe_val != null {
        let unwrapped = maybe_val.unwrap()
        if unwrapped > 40 {
            print("conditional unwrap success")
        }
    }
}

// ============================================
// Multiple Conditional Branches
// ============================================

@test(output = "middle")
fn test_multiple_conditional_branches() {
    let value = 15
    
    let category = if value < 10 {
        "small"
    } else if value < 20 {
        "middle"
    } else if value < 30 {
        "large"
    } else {
        "huge"
    }
    
    print(category)
}

// ============================================
// Documentation of Error Cases
// ============================================

// The following demonstrate compile-time error cases for conditional expressions.
// Since Rock's @test system focuses on runtime validation,
// these are documented as examples that should NOT compile.

// EXAMPLE 1: Type mismatch in conditional branches
// let x = if true { 5 } else { "string" }  // ERROR: Inconsistent return types

// EXAMPLE 2: Using uninitialized variable in conditional
// let x: int
// if true { x = 5 }
// print(x)  // ERROR: x might not be initialized

// EXAMPLE 3: Accessing out-of-scope variable
// if true {
//     let inner = 5
// }
// print(inner)  // ERROR: inner is out of scope

// EXAMPLE 4: Type error in conditional condition
// if 5 { print("bad") }  // ERROR: Condition must be bool, not int

// EXAMPLE 5: Unwrapping null value
// let x: int? = null
// let y = x.unwrap()  // ERROR: Runtime panic when unwrapping null