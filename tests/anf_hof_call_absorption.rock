// Inc 8h: typed-ANF absorbs HOF (higher-order function) calls — calling
// a fn-typed local/param via `f(args)`. Previously rejected as
// "unresolved named callee (resolution bug)" because storage has no
// FunctionId for a fn-typed local. Lowers as `AnfCallee::Dynamic` with
// the bare name as the Lua identifier.
//
// Three discriminators keep broken cases on the live path:
//   1. Known global fn name (stdlib templates like __op_*, generic
//      monos without instantiation suffix, newtype constructors).
//   2. Top-level fn used as value that needs the
//      build_value_fn_ref_wrapper cdata bridge.
//   3. Genuine local / HOF param / let-bound fn ref / expr-macro
//      param — these absorb to Dynamic.

fn apply_int(f: (int) -> int, x: int) -> int {
    return f(x)
}

fn add_one(x: int) -> int { return x + 1 }

@test(output = "6")
fn test_hof_apply() {
    print(apply_int(add_one, 5))
}

@test(output = "100")
fn test_let_bound_fn_call() {
    let inc = (x: int) => x + 1
    let total = 0
    let i = 0
    while i < 100 {
        // Lambda call through let-bound fn-typed local.
        let _ = inc(i)
        i = i + 1
    }
    print(100)
}

fn apply_twice(f: (int) -> int, x: int) -> int {
    return f(f(x))
}

@test(output = "12")
fn test_hof_apply_twice() {
    print(apply_twice(add_one, 10))
}

@test(output = "15")
fn test_lambda_arg() {
    let r = apply_int((x: int) => x * 3, 5)
    print(r)
}
