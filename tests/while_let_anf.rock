// Inc 8g: `while let v = E { body }` — Rock's nullable-binding loop.
// Desugared by ANF into `AnfStmt::While` with the cond block yielding
// `t != nil` and the body prepended by `let v = t`. Live emits
// `while true do; local __t = E; if __t == nil then break end;
// local v = __t; <body>; ::continue::; end`. Behavioral oracle gates
// output equality between backends.

global counter: int = 0

fn next_or_null() -> int? {
    counter = counter + 1
    if counter <= 3 { counter } else { null }
}

@test(output = "1 2 3")
fn test_while_let_iter() {
    counter = 0
    let out = ""
    let first = true
    while let v = next_or_null() {
        if !first { out = out + " " }
        first = false
        out = out + "{v}"
    }
    print(out)
}

global counter2: int = 0

fn next2() -> int? {
    counter2 = counter2 + 1
    if counter2 <= 5 { counter2 } else { null }
}

@test(output = "stopped at 2")
fn test_while_let_break_inside() {
    counter2 = 0
    let last = 0
    while let v = next2() {
        last = v
        if v == 2 { break }
    }
    print("stopped at {last}")
}
