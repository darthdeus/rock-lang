// Bucket-C site (ANF unsupported-site audit):
// safenav UFCS with a value-typed receiver was a reachable panic in
// the ANF fn-body seam. `v?.sum()` where `v: V2?` and `sum(self: V2)`
// uses the scalar ABI now lowers via `lower_safenav_receiver` →
// registry-aware pack (when v is scalarized) or `Var(name)` (when
// v is a single nullable Lua local). The receiver atom is the
// cdata-or-nil; the null check tests *that* atom; the else branch
// splats into the scalar-ABI first param.

value V2 { x: int, y: int }

fn sum(self: V2) -> int {
    self.x + self.y
}

@test
fn test_safenav_ufcs_value_receiver_some() {
    let v: V2? = V2 { x: 7, y: 9 }
    let s = v?.sum() ?? -1
    assert_eq(s, 16)
}

@test
fn test_safenav_ufcs_value_receiver_none() {
    let v: V2? = null
    let s = v?.sum() ?? -1
    assert_eq(s, -1)
}
