@test
fn test_map_tuple_destructuring() {
    let m: Map<string, int> = map_new()
    insert(m, "a", 1)
    insert(m, "b", 2)

    let item_count = 0
    for item in m {
        item_count = item_count + 1
    }
    assert_eq(item_count, 2)

    let pair_count = 0
    let found_a = false
    let found_b = false
    for (k, v) in m {
        pair_count = pair_count + 1
        if k == "a" {
            assert_eq(v, 1)
            found_a = true
        } else if k == "b" {
            assert_eq(v, 2)
            found_b = true
        }
    }
    assert_eq(pair_count, 2)
    assert(found_a)
    assert(found_b)
}
