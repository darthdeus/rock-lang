// Adversarial coverage for string-interpolation format specifiers.
// Exercises the codegen rewrite in
// rock/src/backend/lua/incremental.rs::apply_format_specifier — every
// case below should render without crashing and match the expected
// string byte-for-byte.

// ---------------------------------------------------------------------
// Baseline: no spec (must preserve smart-float behavior from
// tests/float_interpolation.rock)
// ---------------------------------------------------------------------

@test
fn test_no_spec_smart_float() {
    let pi = 3.14159265358979
    let whole = 5.0
    let negative = -42.5
    let tiny = 0.000000001
    assert_eq("{pi}", "3.1416")
    assert_eq("{whole}", "5")
    assert_eq("{negative}", "-42.5")
    assert_eq("{tiny}", "1e-09")
}

@test
fn test_no_spec_non_float() {
    let x = 42
    let s = "hello"
    let b = true
    assert_eq("{x}", "42")
    assert_eq("{s}", "hello")
    assert_eq("{b}", "true")
}

// ---------------------------------------------------------------------
// Float formatting: precision, width, zero-pad, sign
// ---------------------------------------------------------------------

@test
fn test_float_precision() {
    let pi = 3.14159265
    assert_eq("{pi:.2f}", "3.14")
    assert_eq("{pi:.0f}", "3")
    assert_eq("{pi:.6f}", "3.141593")
}

@test
fn test_float_width_precision() {
    let v = 1.5
    assert_eq("{v:8.2f}", "    1.50")
    assert_eq("{v:4.1f}", " 1.5")
    // Value wider than width: width ignored (never truncates).
    assert_eq("{v:2.3f}", "1.500")
}

@test
fn test_float_zero_pad() {
    let v = 3.14
    assert_eq("{v:08.2f}", "00003.14")
    // Zero-pad on negatives: sign stays leftmost, zeros fill between
    // sign and digits. Regression against naive post-pad approach.
    let neg = -1.5
    assert_eq("{neg:08.2f}", "-0001.50")
}

@test
fn test_float_explicit_sign() {
    let v = 3.14
    let neg = -3.14
    assert_eq("{v:+.2f}", "+3.14")
    assert_eq("{neg:+.2f}", "-3.14")
}

@test
fn test_float_precision_no_type() {
    // Precision without explicit `f` should assume float.
    let v = 3.14159
    assert_eq("{v:.3}", "3.142")
}

// ---------------------------------------------------------------------
// Integer formatting
// ---------------------------------------------------------------------

@test
fn test_int_width() {
    let n = 42
    assert_eq("{n:5d}", "   42")
    assert_eq("{n:1d}", "42")
}

@test
fn test_int_zero_pad() {
    let n = 42
    assert_eq("{n:05d}", "00042")
    let neg = -42
    assert_eq("{neg:05d}", "-0042")
}

@test
fn test_int_hex_octal() {
    let n = 255
    assert_eq("{n:x}", "ff")
    assert_eq("{n:X}", "FF")
    assert_eq("{n:#x}", "0xff")
    assert_eq("{n:#X}", "0XFF")
    assert_eq("{n:o}", "377")
    assert_eq("{n:#o}", "0377")
}

@test
fn test_int_hex_zero_pad() {
    let n = 15
    assert_eq("{n:04x}", "000f")
    assert_eq("{n:#06x}", "0x000f")
}

// ---------------------------------------------------------------------
// String formatting
// ---------------------------------------------------------------------

@test
fn test_string_right_align() {
    let s = "hi"
    assert_eq("[{s:10s}]", "[        hi]")
    assert_eq("[{s:>10s}]", "[        hi]")
    // String with width but no type letter — must not crash with
    // math.floor (the old codegen bug this rewrite fixes).
    assert_eq("[{s:>10}]", "[        hi]")
}

@test
fn test_string_left_align() {
    let s = "hi"
    // The headline regression: `<` alignment was parsed but ignored.
    assert_eq("[{s:<10}]", "[hi        ]")
    assert_eq("[{s:<10s}]", "[hi        ]")
}

@test
fn test_string_center_align() {
    let s = "hi"
    assert_eq("[{s:^10}]", "[    hi    ]")
    assert_eq("[{s:^11}]", "[    hi     ]")  // odd pad: extra goes right
    assert_eq("[{s:^2}]", "[hi]")             // exact fit
    assert_eq("[{s:^1}]", "[hi]")             // width < len → unchanged
}

@test
fn test_string_precision_truncates() {
    let s = "hello world"
    assert_eq("{s:.5s}", "hello")
    assert_eq("{s:10.5s}", "     hello")
    assert_eq("{s:<10.5s}", "hello     ")
}

@test
fn test_string_custom_fill() {
    let s = "x"
    assert_eq("[{s:*<5}]", "[x****]")
    assert_eq("[{s:*>5}]", "[****x]")
    assert_eq("[{s:*^5}]", "[**x**]")
}

// ---------------------------------------------------------------------
// Non-string values with alignment
// ---------------------------------------------------------------------

@test
fn test_int_left_align() {
    let n = 42
    assert_eq("[{n:<5}]", "[42   ]")
    assert_eq("[{n:<5d}]", "[42   ]")
}

@test
fn test_int_center_align() {
    let n = 42
    assert_eq("[{n:^6}]", "[  42  ]")
}

@test
fn test_float_left_align() {
    let v = 1.5
    assert_eq("[{v:<8.2f}]", "[1.50    ]")
}

@test
fn test_float_center_align() {
    let v = 1.5
    assert_eq("[{v:^8.2f}]", "[  1.50  ]")
}

@test
fn test_float_custom_fill() {
    let v = 1.5
    assert_eq("[{v:0<8.2f}]", "[1.500000]")
    assert_eq("[{v:-^8.2f}]", "[--1.50--]")
}

// ---------------------------------------------------------------------
// Bool formatting
// ---------------------------------------------------------------------

@test
fn test_bool_padding() {
    let b = true
    let f = false
    assert_eq("[{b:<8}]", "[true    ]")
    assert_eq("[{f:>8}]", "[   false]")
    assert_eq("[{b:^7}]", "[ true  ]")
}

// ---------------------------------------------------------------------
// Special format types
// ---------------------------------------------------------------------

@test
fn test_binary() {
    let n = 10
    assert_eq("{n:b}", "1010")
    assert_eq("{0:b}", "0")
    let neg = -5
    assert_eq("{neg:b}", "-101")
}

@test
fn test_binary_width() {
    let n = 5
    assert_eq("[{n:8b}]", "[     101]")
    assert_eq("[{n:<8b}]", "[101     ]")
}

@test
fn test_char() {
    let code = 65
    assert_eq("{code:c}", "A")
    let lower = 97
    assert_eq("{lower:c}", "a")
}

@test
fn test_scientific() {
    let v = 1234567.89
    assert_eq("{v:.2e}", "1.23e+06")
    assert_eq("{v:.2E}", "1.23E+06")
}

// ---------------------------------------------------------------------
// Edge cases: empty string, zero, width mismatch
// ---------------------------------------------------------------------

@test
fn test_empty_string() {
    let s = ""
    assert_eq("[{s:5s}]", "[     ]")
    assert_eq("[{s:<5s}]", "[     ]")
    assert_eq("[{s:^5}]", "[     ]")
}

@test
fn test_zero_values() {
    let n = 0
    assert_eq("{n:5d}", "    0")
    assert_eq("{n:05d}", "00000")
    assert_eq("{n:b}", "0")
    let v = 0.0
    assert_eq("{v:.2f}", "0.00")
}

@test
fn test_width_smaller_than_value() {
    // Width is a *minimum*; never truncates (except via string precision).
    let n = 123456
    assert_eq("{n:3d}", "123456")
    let s = "hello"
    assert_eq("{s:2s}", "hello")
    assert_eq("{s:<2}", "hello")
}

// ---------------------------------------------------------------------
// Composite (struct / array) precision — must still use inspect_formatted
// ---------------------------------------------------------------------

struct FixVec2 { x: float, y: float }

@test
fn test_struct_precision_preserved() {
    let v = FixVec2 { x: 1.2345, y: 6.7890 }
    let s = "{v:.2}"
    assert(s.contains("1.23"))
    assert(s.contains("6.79"))
    assert(!s.contains("1.2345"))
}

@test
fn test_struct_field_precision_still_works() {
    let v = FixVec2 { x: 3.14159, y: 2.71828 }
    assert_eq("{v.x:.2f}", "3.14")
    assert_eq("{v.y:.3f}", "2.718")
}

// ---------------------------------------------------------------------
// Composite width / alignment / fill — a struct is exactly the thing you
// want to pad into a debug column, so the pad path takes the structural
// rendering the same way it takes a printf conversion.
// ---------------------------------------------------------------------

struct Pair { a: int, b: int }
enum Hue { Red, Green }

@test
fn test_struct_width_and_alignment() {
    let p = Pair { a: 1, b: 2 }
    let rendered = "{p}"
    // Width is a minimum and never truncates, so the padded forms are the
    // rendering plus fill -- expressed against `rendered` so the test does
    // not re-encode inspect's spacing.
    assert_eq("[{p:>40}]", "[{rendered.pad_left(40)}]")
    assert_eq("[{p:<40}]", "[{rendered.pad_right(40)}]")
    assert_eq("[{p:>2}]", "[{rendered}]")
}

@test
fn test_struct_center_and_fill() {
    let p = Pair { a: 1, b: 2 }
    let rendered = "{p}"
    let width = len(rendered) + 4
    assert_eq(len("{p:^{width}}"), width)
    assert_eq(len("{p:*>{width}}"), width)
    // Fill reaches the composite rendering, not just scalars.
    assert(("{p:*>{width}}").starts_with("**"))
}

@test
fn test_enum_and_array_width() {
    let h = Hue::Green
    assert_eq("[{h:>14}]", "[    Hue::Green]")
    assert_eq("[{h:<14}]", "[Hue::Green    ]")
    // Width below the rendering never truncates.
    assert_eq("[{h:>4}]", "[Hue::Green]")
    let xs = [1, 2]
    assert_eq(len("[{xs:>20}]"), 22)
}

@test
fn test_struct_precision_with_width() {
    // Precision and width compose: render at precision, then pad.
    let v = FixVec2 { x: 1.2345, y: 6.7890 }
    let rendered = "{v:.2}"
    assert_eq("[{v:>40.2}]", "[{rendered.pad_left(40)}]")
    assert(("{v:>40.2}").contains("1.23"))
}

// ---------------------------------------------------------------------
// Combined flags — the interactions between sign, zero-pad, width,
// precision, alignment, and fill are where bugs hide.
// ---------------------------------------------------------------------

@test
fn test_float_sign_zero_pad_precision() {
    let v = 3.14
    assert_eq("{v:+010.2f}", "+000003.14")
    let neg = -3.14
    assert_eq("{neg:+010.2f}", "-000003.14")
}

@test
fn test_hex_alternate_zero_pad() {
    let n = 255
    assert_eq("{n:#010x}", "0x000000ff")
    assert_eq("{n:#010X}", "0X000000FF")
}

@test
fn test_center_with_custom_fill_and_format() {
    let v = 1.5
    // Format then center-pad with '*'
    assert_eq("[{v:*^10.2f}]", "[***1.50***]")
}

@test
fn test_odd_pad_center() {
    let s = "ab"
    // Padding 5 - 2 = 3. Left gets floor(3/2)=1, right gets 2.
    assert_eq("[{s:^5}]", "[ ab  ]")
    let s2 = "abc"
    assert_eq("[{s2:^6}]", "[ abc  ]")
}

// ---------------------------------------------------------------------
// Edge cases: width 0, precision 0, huge width
// ---------------------------------------------------------------------

@test
fn test_width_zero() {
    let v = 3.14
    // Width 0 is a no-op on the pad side.
    assert_eq("{v:.2f}", "3.14")
}

@test
fn test_precision_zero_string() {
    let s = "hello"
    // Precision on a string truncates to that many chars; 0 -> empty.
    assert_eq("[{s:.0s}]", "[]")
    assert_eq("[{s:5.0s}]", "[     ]")
}

// ---------------------------------------------------------------------
// Cross-type formatting: explicit type differs from value type
// ---------------------------------------------------------------------

@test
fn test_float_as_int() {
    // Explicit `d` on a float: truncates (via math.floor).
    let v = 3.75
    assert_eq("{v:d}", "3")
    let neg = -3.75
    // math.floor of negative rounds toward -inf: -4.
    assert_eq("{neg:d}", "-4")
}

@test
fn test_int_as_float() {
    // Explicit `f` on an int: `%f` is fine with integer values.
    let n = 42
    assert_eq("{n:.2f}", "42.00")
    assert_eq("{n:8.2f}", "   42.00")
}

// ---------------------------------------------------------------------
// Fill char hazards: characters that could escape the generated literal
// ---------------------------------------------------------------------

@test
fn test_fill_quote() {
    let s = "x"
    // Fill char `"` must not break the generated Lua string literal.
    assert_eq("[{s:\"^5}]", "[\"\"x\"\"]")
}

@test
fn test_fill_backslash() {
    let s = "x"
    // Fill char `\` must be escaped in the generated literal.
    assert_eq("[{s:\\<5}]", "[x\\\\\\\\]")
}

// ---------------------------------------------------------------------
// Multi-part interpolation: padding one slot doesn't affect adjacent.
// ---------------------------------------------------------------------

@test
fn test_multiple_slots_in_one_string() {
    let a = "foo"
    let b = 42
    let c = 3.14
    assert_eq(
        "[{a:<5}][{b:>5d}][{c:06.2f}]",
        "[foo  ][   42][003.14]"
    )
}

// ---------------------------------------------------------------------
// Percent type: `{v:.Pf%}` emits `v*100` with P decimals + literal `%`.
// A previous bug emitted `%%` (two percents) because the codegen used
// Lua's format-string-only escape outside string.format.
// ---------------------------------------------------------------------

@test
fn test_percent_type() {
    let v = 0.25
    assert_eq("{v:.1%}", "25.0%")
    let v2 = 0.5
    assert_eq("{v2:.0%}", "50%")
    let v3 = 0.0
    assert_eq("{v3:.2%}", "0.00%")
}

// ---------------------------------------------------------------------
// Character-code formatting
// ---------------------------------------------------------------------

@test
fn test_char_alignment() {
    let code = 65
    assert_eq("[{code:^5c}]", "[  A  ]")
    assert_eq("[{code:<5c}]", "[A    ]")
}

// ---------------------------------------------------------------------
// Space-sign flag: ` ` before the number pads positives with a space so
// positive and negative columns line up. Python/C printf support this.
// ---------------------------------------------------------------------

@test
fn test_space_sign_flag() {
    let pos = 42
    let neg = -42
    assert_eq("[{pos: d}]", "[ 42]")
    assert_eq("[{neg: d}]", "[-42]")
    let v = 3.14
    assert_eq("[{v: .2f}]", "[ 3.14]")
    let nv = -3.14
    assert_eq("[{nv: .2f}]", "[-3.14]")
}

// ---------------------------------------------------------------------
// Doubled-brace escape (`{{` / `}}`): the Python convention for
// emitting a literal `{` or `}` inside a string literal. Fired across
// two layers — the tokenizer (so the string literal terminator is
// found correctly) and the interpolation parser (so the escape is
// collapsed into literal chars before inspection).
// ---------------------------------------------------------------------

// Expected values are built through `string_char` so they carry no brace
// literal of their own. Writing the escape on BOTH sides would pass under
// any consistent rule -- escaping or not -- and prove nothing.
fn lbrace() -> string { return string_char(123) }
fn rbrace() -> string { return string_char(125) }

@test
fn test_doubled_brace_literal() {
    let x = 42
    let l = lbrace()
    let r = rbrace()
    assert_eq("{{literal}}", "{l}literal{r}")
    assert_eq("{{{x}}}", "{l}42{r}")
    assert_eq("{{x}} and {x}", "{l}x{r} and 42")
    assert_eq("}}close{{", "{r}close{l}")
    // The escape collapses a pair to one char; a bare pass-through would
    // leave 11.
    assert_eq(len("{{literal}}"), 9)
}

@test
fn test_doubled_brace_json_like() {
    let name = "alice"
    let age = 30
    let s = "{{\"name\":\"{name}\",\"age\":{age}}}"
    let expected = "{lbrace()}\"name\":\"alice\",\"age\":30{rbrace()}"
    assert_eq(s, expected)
}

@test
fn test_doubled_brace_triple_quoted() {
    let x = 1
    let s = """
{{literal}} {x}
"""
    // Triple-quoted preserves the leading newline.
    assert_eq(s, "\n{lbrace()}literal{rbrace()} 1\n")
}

@test
fn test_consecutive_aligned_columns() {
    // Simulates the perf table: each row uses the same widths.
    let names = ["frame_draw", "world_draw", "draw_game"]
    let vals = [4.29, 3.52, 2.20]
    let out = "{names[0]:<12}{vals[0]:7.2f}\n{names[1]:<12}{vals[1]:7.2f}\n{names[2]:<12}{vals[2]:7.2f}"
    let expected = "frame_draw     4.29\nworld_draw     3.52\ndraw_game      2.20"
    assert_eq(out, expected)
}
