// Scalarized value local widened to `Nullable(V)` at a call-arg slot.
//
// Shape:
//   let v = make_v2(...)        // Vec2-returning call -> Inc 4 LetMulti
//                               // scalarizes to `v__x, v__y` locals;
//                               // value_layout["v"] populated; no `v` local.
//   consume(..., v, ...)        // consume's param is `V2? = null` so the
//                               // type checker widens v's static type
//                               // from V2 to Nullable(V2) at this site.
//
// Pre-fix (eca638b24): `lower_nullable_value_obj`'s Ident arm returned
// a bare `Var("v")` referencing a nonexistent local; consumer received
// nil and fell back to its default. Manifested in mag as 2x character
// sprites (dest_size: Vec2? was nil) and in bitgun as a sprite-source
// snapshot drift (source: IRect? was nil).
//
// Fix consults `value_layout` and packs via `V_ct(v__x, v__y)` at this
// boundary. This test pins the runtime: the widened-Nullable arg must
// receive the real packed value, not nil.

value V2 { x: int, y: int }

fn make_v2(x: int, y: int) -> V2 {
    return V2 { x: x, y: y }
}

// `dest: V2? = null`: the cdata-ABI nullable slot that triggered the
// widening at the call site. Sum the components to distinguish from
// the default-arg path (which would receive nil -> 0).
fn consume_or_default(dest: V2? = null) -> int {
    if dest == null {
        return -1
    }
    let d = dest.unwrap()
    return d.x + d.y
}

@test(output = "30")
fn scalarized_value_at_nullable_arg() {
    let v = make_v2(10, 20)
    // Without the pack-at-boundary fix this would receive nil ->
    // returns -1 instead of 30.
    let got = consume_or_default(v)
    print(got)
}

// Variant: the same local consumed at TWO sites — one Vec2 slot
// (passes through fine pre- and post-fix), one Vec2? slot (broken
// pre-fix). Both must observe the same value.
fn consume_nonnull(d: V2) -> int { return d.x * 100 + d.y }

@test(output = "1020\n30")
fn scalarized_value_at_both_arg_shapes() {
    let v = make_v2(10, 20)
    print(consume_nonnull(v))     // scalar-ABI splat path
    print(consume_or_default(v))  // nullable cdata-ABI pack path
}
