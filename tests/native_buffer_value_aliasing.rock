// Adversarial: NativeBuffer slot-store lowering (Issue 4) writes leaf-
// by-leaf, not pack-then-copy. If the RHS reads from the same slot
// being written, the new path observes partial-write state where the
// old path observed the original value. Document & test the divergence.

@intrinsic @inline inline(lua) fn put(s: string) = "io.write(s)"

value V2 {
    x: float,
    y: float,
}

@nomangle inline(lua) fn __nb_alloc_V2(n: int) -> Ptr<V2> = 'return ffi.new("V2[?]", n)'

fn nb_v2(n: int) -> NativeBuffer<V2> {
    return NativeBuffer { ptr: __nb_alloc_V2(n), len: n }
}

@test(output = "x=7\ny=3")
fn test_aliasing_swap() {
    let buf = nb_v2(1)
    buf[0] = V2 { x: 3.0, y: 7.0 }

    // Swap x and y by reading from the slot we're writing to.
    // Pack-then-copy semantics: result is { x: 7, y: 3 }.
    // Leaf-by-leaf semantics: x first reads buf[0].y = 7 → buf[0].x = 7.
    //                         y then reads buf[0].x = 7 → buf[0].y = 7.
    // Result under new path: { x: 7, y: 7 }.
    buf[0] = V2 { x: buf[0].y, y: buf[0].x }

    let v = buf[0]
    put("x=")
    put("{v.x}")
    put("\n")
    put("y=")
    put("{v.y}")
    put("\n")
}
