// Regression: `+=` on a user-defined type with `__op_add` overload must
// dispatch to the overload, not emit raw Lua `+`.
// Was broken since commit 7e2e2c6f (June 2025) when desugar switched to
// the compound_op field; codegen never learned to dispatch overloads
// through that path.

struct V2 {
    x: float,
    y: float,
}

fn __op_add(a: V2, b: V2) -> V2 {
    return V2 { x: a.x + b.x, y: a.y + b.y }
}

fn __op_sub(a: V2, b: V2) -> V2 {
    return V2 { x: a.x - b.x, y: a.y - b.y }
}

fn __op_mul(a: V2, s: float) -> V2 {
    return V2 { x: a.x * s, y: a.y * s }
}

fn __op_div(a: V2, s: float) -> V2 {
    return V2 { x: a.x / s, y: a.y / s }
}

// ---------- Plain `+=` on simple ident ----------
@test(output = "3	7")
fn test_compound_add_overload_ident() {
    let p = V2 { x: 1.0, y: 2.0 }
    p += V2 { x: 2.0, y: 5.0 }
    print(int(p.x), int(p.y))
}

// ---------- `+=` on a field with multiplied RHS (the bitgun case) ----------
struct Holder { pos: V2 }

@test(output = "5	11")
fn test_compound_add_overload_field() {
    let h = Holder { pos: V2 { x: 1.0, y: 1.0 } }
    h.pos += V2 { x: 2.0, y: 5.0 } * 2.0
    print(int(h.pos.x), int(h.pos.y))
}

// ---------- `-=` on a field ----------
@test(output = "8	6")
fn test_compound_sub_overload_field() {
    let h = Holder { pos: V2 { x: 10.0, y: 10.0 } }
    h.pos -= V2 { x: 2.0, y: 4.0 }
    print(int(h.pos.x), int(h.pos.y))
}

// ---------- `*=` struct * float (mixed-type overload) ----------
@test(output = "6	10")
fn test_compound_mul_overload_mixed() {
    let p = V2 { x: 3.0, y: 5.0 }
    p *= 2.0
    print(int(p.x), int(p.y))
}

// ---------- `/=` struct / float ----------
@test(output = "5	4")
fn test_compound_div_overload_mixed() {
    let p = V2 { x: 10.0, y: 8.0 }
    p /= 2.0
    print(int(p.x), int(p.y))
}

// ---------- Safe-nav target with overload: must skip cleanly when null ----------
struct Inner { vec: V2 }
struct Outer { inner: Inner? }

@test(output = "12	22")
fn test_compound_safenav_overload_present() {
    let o = Outer { inner: Inner { vec: V2 { x: 10.0, y: 20.0 } } }
    o.inner?.vec += V2 { x: 2.0, y: 2.0 }
    if o.inner != null {
        print(int(o.inner.vec.x), int(o.inner.vec.y))
    }
}

@test(output = "ok")
fn test_compound_safenav_overload_null_skips() {
    let o = Outer { inner: null }
    o.inner?.vec += V2 { x: 99.0, y: 99.0 }
    // No crash; o.inner stays null.
    if o.inner == null {
        print("ok")
    }
}

// ---------- `+=` on a struct stored inside a Vec element ----------
@test(output = "7	11")
fn test_compound_add_overload_in_vec_index() {
    let xs: [V2] = [V2 { x: 1.0, y: 2.0 }, V2 { x: 5.0, y: 9.0 }]
    xs[1] += V2 { x: 2.0, y: 2.0 }
    print(int(xs[1].x), int(xs[1].y))
}

// ---------- String `+=` (Lua needs `..`, not `+`) ----------
@test(output = "hello world")
fn test_compound_add_string() {
    let s = "hello"
    s += " world"
    print(s)
}

// ---------- Sanity: primitive `+=` still works (regression guard) ----------
@test(output = "8\n11")
fn test_compound_add_int_primitive() {
    let n = 3
    n += 5
    print(n)

    let m = 5
    m += 6
    print(m)
}

@test(output = "12")
fn test_compound_mul_int_primitive() {
    let n = 3
    n *= 4
    print(n)
}

// ---------- int `./` floors (integer division) ----------
@test(output = "3")
fn test_compound_div_int_primitive_floors() {
    let n = 7
    n = n ./ 2
    print(n)
}

// ---------- Deep safe-nav chain with overload at the leaf ----------
struct Lvl1 { vec: V2 }
struct Lvl2 { l1: Lvl1? }
struct Lvl3 { l2: Lvl2? }

@test(output = "11	22")
fn test_compound_deep_safenav_overload() {
    let root: Lvl3? = Lvl3 { l2: Lvl2 { l1: Lvl1 { vec: V2 { x: 10.0, y: 20.0 } } } }
    root?.l2?.l1?.vec += V2 { x: 1.0, y: 2.0 }
    if root != null && root.l2 != null && root.l2.l1 != null {
        print(int(root.l2.l1.vec.x), int(root.l2.l1.vec.y))
    }
}

@test(output = "ok")
fn test_compound_deep_safenav_overload_null_skips() {
    let root: Lvl3? = Lvl3 { l2: null }
    root?.l2?.l1?.vec += V2 { x: 99.0, y: 99.0 }
    if root != null && root.l2 == null {
        print("ok")
    }
}

// ---------- Newtype `+=` (must unwrap, op, rewrap) ----------
newtype Money(int)

@test(output = "150")
fn test_compound_add_newtype() {
    let m = Money(100)
    m += Money(50)
    print(m.0)
}

// ---------- Vec<int> indexed `+=` (primitive, not struct) ----------
@test(output = "12")
fn test_compound_add_int_in_vec_index() {
    let xs: [int] = [10, 20, 30]
    xs[0] += 2
    print(xs[0])
}
