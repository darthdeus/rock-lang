@test(output="6")
fn test_block() {
    let a = 5

    {
        let b = 1
        a = a + b
    }

    print(a)
}

@test(output="8")
fn test_block_scoping() {
    let x = 5

    {
        let y = 3
        x = x + y
    }

    print(x)
}

@test(output="10")
fn test_nested_blocks() {
    let x = 5
    {
        let y = 3
        x = x + y
        {
            let z = 2
            x = x + z
        }
    }
    print(x)
}

@test(output="1\n2\n3")
fn test_block_values() {
    let a = {
        print(1)
        print(2)
        3
    }

    print(a)
}

@test(output="42")
fn test_block_with_nested_and_assignment() {
    let result = 0

    {
        let x = 10
        result = x + 32

        {
            result = result + 0  // nested assignment
        }
    }

    print(result)
}

// Tests for defer functionality in blocks
// NOTE: These currently fail due to defer execution order issues
// Defers should execute at block exit, but currently execute immediately

@test(output="before\nafter")
fn test_simple_defer_in_block() {
    {
        defer { print("after") }
        print("before")
    }
}

@test(output="1\n2\n3\n4")
fn test_defer_execution_order() {
    {
        defer { print("4") }

        print("1")
        {
            defer { print("3") }

            print("2")
        }
    }
}

@test(output="setup\nwork\ncleanup\ncleanup")
fn test_defer_variable_modification() {
    let status = "init"
    defer { print(status) }

    {
        defer {
            status = "cleanup"
            print(status)
        }

        status = "setup"
        print(status)

        status = "work"
        print(status)
    }
}

@test(output="before\nafter")
fn test_defer_outside_blocks_works() {
    defer {
        print("after")
    }
    print("before")
}

@test(output="1\n3\n4")
fn test_defer_order_in_function() {
    defer {
        print("4")
    }
    print("1")
    defer {
        print("3")
    }
}
