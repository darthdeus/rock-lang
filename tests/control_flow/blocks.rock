// Blocks `{ ... }` as scopes and as expressions: scoping, nested blocks,
// block values in expression position, defers at block exit, and a
// `return` escaping a value-position block.

@test(output="6")
fn test_block() {
    let a = 5

    {
        let b = 1
        a = a + b
    }

    print(a)
}

@test(output="8")
fn test_block_scoping() {
    let x = 5

    {
        let y = 3
        x = x + y
    }

    print(x)
}

@test(output="10")
fn test_nested_blocks() {
    let x = 5
    {
        let y = 3
        x = x + y
        {
            let z = 2
            x = x + z
        }
    }
    print(x)
}

@test(output="1\n2\n3")
fn test_block_values() {
    let a = {
        print(1)
        print(2)
        3
    }

    print(a)
}

@test(output="42")
fn test_block_with_nested_and_assignment() {
    let result = 0

    {
        let x = 10
        result = x + 32

        {
            result = result + 0  // nested assignment
        }
    }

    print(result)
}

// Defers run at block exit, innermost block first

@test(output="before\nafter")
fn test_simple_defer_in_block() {
    {
        defer { print("after") }
        print("before")
    }
}

@test(output="1\n2\n3\n4")
fn test_defer_execution_order() {
    {
        defer { print("4") }

        print("1")
        {
            defer { print("3") }

            print("2")
        }
    }
}

@test(output="setup\nwork\ncleanup\ncleanup")
fn test_defer_variable_modification() {
    let status = "init"
    defer { print(status) }

    {
        defer {
            status = "cleanup"
            print(status)
        }

        status = "setup"
        print(status)

        status = "work"
        print(status)
    }
}

@test(output="before\nafter")
fn test_defer_outside_blocks_works() {
    defer {
        print("after")
    }
    print("before")
}

@test(output="1\n3\n4")
fn test_defer_order_in_function() {
    defer {
        print("4")
    }
    print("1")
    defer {
        print("3")
    }
}

// Block expressions in value position

@test(output = "42")
fn test_basic_block_simple() {
    print({ 42 })
}

@test(output = "10")
fn test_basic_block_with_calculation() {
    print({ let x = 5; x * 2 })
}

@test(output = "30\n42")
fn test_basic_block_multiple_statements() {
    print({ let a = 10; let b = 20; a + b })
    print({ let a = 20; let b = 22; a + b })
}

@test(output = "8")
fn test_block_expr_assignment_simple() {
    let x = { 5 + 3 }
    print(x)
}

@test(output = "20")
fn test_block_expr_assignment_complex() {
    let result = { let temp = 10; temp * 2 }
    print(result)
}

@test(output = "15")
fn test_block_expr_multiple_assignments() {
    let x = { 1 + 2 }
    let y = { 3 * 4 }
    print(x + y)
}

@test(output = "6")
fn test_nested_block_expressions_simple() {
    print({ let x = { 5 }; x + 1 })
}

@test(output = "30")
fn test_nested_block_expressions_deep() {
    print({ let a = { let b = { 10 }; b + 5 }; a * 2 })
}

@test(output = "hello")
fn test_block_expr_as_argument() {
    print({ let msg = "hello"; msg })
}

@test(output = "17")
fn test_block_expr_multiple_arguments() {
    print(max({ 10 + 5 }, { 20 - 3 }))
}

@test(output = "30")
fn test_block_expr_in_binary_operations_simple() {
    print({ 10 } + { 20 })
}

@test(output = "14")
fn test_block_expr_in_binary_operations_complex() {
    print({ let x = 5; x * 2 } + { let y = 3; y + 1 })
}

@test(output = "10")
fn test_block_expr_with_conditionals_inside() {
    print({ let x = 10; if x > 5 { x } else { 0 } })
}

@test(output = "go")
fn test_block_expr_as_condition() {
    print(if { let ready = true; ready } { "go" } else { "wait" })
}

@test(output = "42")
fn test_block_expr_scoping() {
    let outer = { let inner = 42; inner }
    let test = outer
    print(test)
}

@test(output = "3")
fn test_block_expr_return_values_simple() {
    let value = { let a = 1; let b = 2; 3 }
    print(value)
}

@test(output = "computing\n42")
fn test_block_expr_return_values_mixed() {
    let result = { print("computing"); 42 }
    print(result)
}

@test(output = "nil")
fn test_empty_block_expression_print() {
    print({ })
}

@test(output = "nil")
fn test_empty_block_expression_assignment() {
    let unit_val = { }
    print(unit_val)
}

// A `return` inside a value-position block leaves the enclosing function:
// f(5) returns 100 from inside the block; f(-1) yields 5 from the block and
// returns 5 + 1.

@test(output = "100\n6")
fn test_escaping_return_to_block() {
    print(f(5))
    print(f(-1))
}

fn f(x: int) -> int {
    let y = {
        if x > 0 { return 100 }
        let v = 5
        v
    } + 1
    y
}
