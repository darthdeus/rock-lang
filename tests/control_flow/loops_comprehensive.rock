@test(output = "6")
fn vec_iteration_basic() {
    let vec = vec_new()
    vec_push(vec, 1)
    vec_push(vec, 2)
    vec_push(vec, 3)

    let sum = 0

    for x in vec {
        sum += x
    }

    print(sum)
}

@test(output = "60")
fn arena_tuple_iteration() {
    let arena = arena_new()
    insert(arena, 10)
    insert(arena, 20)
    insert(arena, 30)

    let sum = 0

    for (entity, value) in arena {
        sum += value  // Back to original working code
    }

    print(sum)
}

@test(output = "6")
fn map_tuple_iteration() {
    let map = map_new()
    insert(map, "a", 1)
    insert(map, "b", 2)
    insert(map, "c", 3)

    let sum = 0

    for (key, value) in map {
        sum += value
    }

    print(sum)
}

// ============================================
// Type Assertion Tests for Collections
// ============================================

@test(output = "6", type_holes = [[0, "int"]])
fn vec_iteration_type_check() {
    let vec = vec_new()
    vec_push(vec, 1)
    vec_push(vec, 2)
    vec_push(vec, 3)

    let sum = 0

    for x in vec {
        let x_typed: ? = x  // [0] - Should be int
        sum += x
    }

    print(sum)
}

