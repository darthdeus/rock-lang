@test(output = "6", type_holes = [[0, "int"]])
fn map_iteration_type_check() {
    let map = map_new()
    insert(map, "a", 1)
    insert(map, "b", 2)
    insert(map, "c", 3)

    let sum = 0

    for (key, value) in map {
        let value_typed: ? = value  // [0] - Should be int
        sum += value
    }

    print(sum)
}

@test(output = "6", type_holes = [[0, "int"]])
fn array_iteration_type_check() {
    let arr = [1, 2, 3]

    let sum = 0

    for x in arr {
        let x_typed: ? = x  // [0] - Should be int
        sum += x
    }

    print(sum)
}

// ============================================
// Additional Advanced Loop Tests
// ============================================

@test(output = "18")
fn nested_loops_with_continue_complex() {
    let outer = 0
    let result = 0

    loop {
        outer = outer + 1
        if outer >= 3 {
            break
        }

        let inner = 0
        loop {
            inner = inner + 1
            if inner == 2 {
                continue  // inner continue
            }
            result = result + inner
            if inner >= 3 {
                break
            }
        }

        if outer == 1 {
            continue  // outer continue
        }
        result = result + 10
    }

    print(result)
}

@test(output = "12378")
fn continue_with_complex_expression() {
    let result = 0
    let i = 0

    loop {
        i = i + 1

        if i > 3 && i < 7 {
            continue
        }

        result = result * 10 + i

        if i >= 8 {
            break
        }
    }

    print(result)
}