// Tests for if let: single binding, chains (&&), value expressions, and scope.
//
//   if let x = expr { body }
//   if let x = expr && let y = x.field { body }
//   if let x = expr && x.value > 0 { body }
//   if cond && let x = expr { body }
//   if let _ = expr { body }

struct Item { value: int }
struct Container { item: Item? }
struct Outer { inner: Container? }

fn get_item(v: int) -> Item? { return Item { value: v } }
fn get_null_item() -> Item? { return null }
fn get_container(v: int) -> Container? { return Container { item: Item { value: v } } }
fn get_null_container() -> Container? { return null }

// ==============================
// Single binding
// ==============================

@test(output = "5")
fn basic_nonnull() {
    if let x = get_item(5) {
        print(x.value)
    }
}

@test(output = "missing")
fn basic_null_else() {
    if let x = get_null_item() {
        print(x.value)
    } else {
        print("missing")
    }
}

// Wildcard _ is a liveness-only check — value is not bound
@test(output = "exists")
fn discard_binding() {
    if let _ = get_item(99) { print("exists") }
}

@test(output = "")
fn discard_binding_null() {
    if let _ = get_null_item() { print("exists") }
}

// ==============================
// Value expression context
// Distinct from statement use: the if let produces a value.
// ==============================

@test
fn value_expr_nonnull() {
    let x: int? = 42
    let result = if let y = x { y + 1 } else { 0 }
    assert_eq(result, 43)
}

@test
fn value_expr_null() {
    let x: int? = null
    let result = if let y = x { y + 1 } else { 0 }
    assert_eq(result, 0)
}

@test
fn value_expr_nested() {
    let x: int? = 5
    let y: int? = 10
    let result = if let a = x {
        if let b = y { a + b } else { a }
    } else {
        0
    }
    assert_eq(result, 15)
}

// ==============================
// Scope and shadowing
// ==============================

// Inner binding shadows outer; outer is unaffected after block
@test(output = "99\n42")
fn shadows_outer() {
    let x: Item? = Item { value: 42 }
    if let x = get_item(99) {
        print(x.value)
    }
    print(x?.value ?? -1)
}

// Binding does not leak out of the if let block
@test(output = "42\n42")
fn binding_not_in_scope_after() {
    let x: Item? = Item { value: 42 }
    if let item = x { print(item.value) }
    print(x?.value ?? -1)
}

// ==============================
// Nested if let
// ==============================

@test(output = "1\n2")
fn nested_both_nonnull() {
    let a: Item? = Item { value: 1 }
    let b: Item? = Item { value: 2 }
    if let x = a {
        print(x.value)
        if let y = b { print(y.value) }
    }
}

@test(output = "1")
fn nested_inner_null() {
    let a: Item? = Item { value: 1 }
    let b: Item? = null
    if let x = a {
        print(x.value)
        if let y = b { print(y.value) }
    }
}

// ==============================
// Safe navigation in value expr
// ==============================

@test(output = "7")
fn with_safe_nav() {
    let o: Outer? = Outer { inner: Container { item: Item { value: 7 } } }
    if let c = o?.inner {
        print(c.item?.value ?? -1)
    }
}

@test(output = "")
fn with_safe_nav_null() {
    let o: Outer? = Outer { inner: null }
    if let c = o?.inner {
        print(c.item?.value ?? -1)
    }
}

// ==============================
// Chain: two bindings
// First-null and second-null are distinct: first exits before evaluating second.
// ==============================

@test(output = "42")
fn chain_both_nonnull() {
    if let c = get_container(42) && let item = c.item {
        print(item.value)
    }
}

@test(output = "nope")
fn chain_first_null() {
    if let c = get_null_container() && let item = c.item {
        print(item.value)
    } else {
        print("nope")
    }
}

@test(output = "nope")
fn chain_second_null() {
    let c: Container? = Container { item: null }
    if let container = c && let item = container.item {
        print(item.value)
    } else {
        print("nope")
    }
}

// Both bindings visible in the body
@test(output = "42 42")
fn chain_both_in_scope() {
    let c: Container? = Container { item: Item { value: 42 } }
    if let container = c && let item = container.item {
        print("{container.item?.value ?? -1} {item.value}")
    }
}

// ==============================
// Chain: binding + condition
// ==============================

@test(output = "42")
fn chain_condition_passes() {
    if let x = get_item(42) && x.value > 0 {
        print(x.value)
    }
}

@test(output = "nope")
fn chain_condition_fails() {
    if let x = get_item(-1) && x.value > 0 {
        print(x.value)
    } else {
        print("nope")
    }
}

// ==============================
// Chain: condition before binding
// ==============================

@test(output = "42")
fn chain_cond_then_binding() {
    let flag = true
    if flag && let x = get_item(42) {
        print(x.value)
    }
}

@test(output = "nope")
fn chain_cond_false_skips() {
    let flag = false
    if flag && let x = get_item(42) {
        print(x.value)
    } else {
        print("nope")
    }
}

// ==============================
// Three-clause chain
// ==============================

@test(output = "42")
fn three_clause_all_pass() {
    if let c = get_container(42) && let item = c.item && item.value > 0 {
        print(item.value)
    }
}

@test(output = "")
fn three_clause_condition_fails() {
    if let c = get_container(-5) && let item = c.item && item.value > 0 {
        print(item.value)
    }
}

@test(output = "42")
fn three_clause_cond_first() {
    let flag = true
    if flag && let c = get_container(42) && let item = c.item {
        print(item.value)
    }
}

// ==============================
// Literal pattern in a chain
// ==============================

fn maybe_seven(b: bool) -> int? {
    if b { return 7 }
    return null
}

// A literal clause holds only for that exact value, never for null.
@test(output = "7\nno\nno")
fn chain_literal_pattern() {
    if let 7 = maybe_seven(true) && let c = maybe_seven(true) { print(c) } else { print("no") }
    if let 8 = maybe_seven(true) && let c = maybe_seven(true) { print(c) } else { print("no") }
    if let 7 = maybe_seven(false) && let c = maybe_seven(true) { print(c) } else { print("no") }
}

// ==============================
// Value position with a call as the value
// ==============================

fn maybe(have: bool, v: int) -> int? {
    if have { v } else { null }
}

@test(output = "42")
fn test_iflet_some_binds() {
    let r = if let v = maybe(true, 42) { v } else { 0 }
    print(r)
}

@test(output = "0")
fn test_iflet_none_else() {
    let r = if let v = maybe(false, 42) { v } else { 0 }
    print(r)
}

@test(output = "100")
fn test_iflet_wildcard() {
    let r = if let _ = maybe(true, 5) { 100 } else { 0 }
    print(r)
}

// ==============================
// Value-position chains: each clause short-circuits to the else branch
// ==============================

@test(output = "7")
fn test_iflet_chain_all_some() {
    let r = if let x = maybe(true, 3) && let y = maybe(true, 4) {
        x + y
    } else {
        -1
    }
    print(r)
}

@test(output = "-1")
fn test_iflet_chain_first_none() {
    let r = if let x = maybe(false, 3) && let y = maybe(true, 4) {
        x + y
    } else {
        -1
    }
    print(r)
}

@test(output = "-1")
fn test_iflet_chain_second_none() {
    let r = if let x = maybe(true, 3) && let y = maybe(false, 4) {
        x + y
    } else {
        -1
    }
    print(r)
}

@test(output = "9")
fn test_iflet_chain_with_cond_pass() {
    let r = if let x = maybe(true, 4) && x > 2 {
        x + 5
    } else {
        -1
    }
    print(r)
}

@test(output = "-1")
fn test_iflet_chain_with_cond_fail() {
    let r = if let x = maybe(true, 1) && x > 2 {
        x + 5
    } else {
        -1
    }
    print(r)
}

// ==============================
// if let as a function's result. Regressions: an implicit-return if let
// compiled to a bare expression statement, and explicit returns in its
// branches were rejected as a type mismatch.
// ==============================

fn lookup_in_map(m: Map<int, string>, key: int) -> string? {
    let val = m.get(key)
    if let v = val {
        v
    } else {
        null
    }
}

fn lookup_in_map_explicit(m: Map<int, string>, key: int) -> string? {
    let val = m.get(key)
    if let v = val {
        return v
    } else {
        return null
    }
}

@test
fn test_if_let_implicit_return() {
    let m: Map<int, string> = map_new()
    insert(m, 42, "hello")

    let result = lookup_in_map(m, 42)
    assert(result != null, "Expected non-null result")
    assert_eq(result.unwrap(), "hello")

    let missing = lookup_in_map(m, 99)
    assert(missing == null, "Expected null for missing key")

    print("if-let implicit return works")
}

@test
fn test_if_let_explicit_return() {
    let m: Map<int, string> = map_new()
    insert(m, 42, "hello")

    let result = lookup_in_map_explicit(m, 42)
    assert(result != null, "Expected non-null result")
    assert_eq(result.unwrap(), "hello")

    let missing = lookup_in_map_explicit(m, 99)
    assert(missing == null, "Expected null for missing key")

    print("if-let explicit return works")
}

// `if let x = <control-flow expr>`: the bound value is itself an if, match
// or block expression. Regression: it was spliced into an invalid Lua
// rvalue and failed at load.
fn rb_pick(i: int) -> int? {
    if i >= 0 { return 7 }
    return null
}

@test
fn test_if_let_value_is_if_expr() {
    let idx = 1
    if let e = if idx >= 0 { rb_pick(idx) } else { null } {
        assert_eq(e.unwrap(), 7)
    } else {
        assert(false, "if-expr value should have bound")
    }
    // and the null path
    let neg = -1
    let hit = if let e = if neg >= 0 { rb_pick(neg) } else { null } {
        e.unwrap()
    } else {
        -99
    }
    assert_eq(hit, -99)
}

@test
fn test_if_let_value_is_match_expr() {
    let k = 1
    if let v = match k { 1 => rb_pick(0), _ => null } {
        assert_eq(v.unwrap(), 7)
    } else {
        assert(false, "match-expr value should have bound")
    }
}

@test
fn test_if_let_value_is_block_expr() {
    if let v = { let t = rb_pick(5); t } {
        assert_eq(v.unwrap(), 7)
    } else {
        assert(false, "block-expr value should have bound")
    }
}
