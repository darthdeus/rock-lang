// break, continue and return in while, for, loop and match-arm bodies: each
// binds to the right enclosing loop through nesting and sibling loops, the
// combinations in one body, top-level placement in the loop body, and a
// lambda return that does not escape the enclosing fn.

@test
fn test_continue_with_complex_conditions() {
    let results = vec_new()
    let i = 0
    while i < 20 {
        i = i + 1

        // Multiple conditions with continue
        if i % 2 == 0 {
            if i % 4 == 0 {
                continue
            }
            vec_push(results, i)
        } else {
            if i % 3 == 0 {
                continue
            }
            vec_push(results, i)
        }
    }

    assert_eq(results, [1, 2, 5, 6, 7, 10, 11, 13, 14, 17, 18, 19])
}

@test
fn test_continue_with_break() {
    let results = vec_new()
    let i = 0
    while i < 20 {
        i = i + 1
        if i > 15 {
            break
        }
        if i % 3 == 0 {
            continue
        }
        vec_push(results, i)
        if vec_len(results) >= 8 {
            break
        }
    }

    assert_eq(results, [1, 2, 4, 5, 7, 8, 10, 11])
}

@test
fn test_deeply_nested_continue() {
    let results = vec_new()
    let i = 0
    while i < 3 {
        i = i + 1
        let j = 0
        while j < 3 {
            j = j + 1
            let k = 0
            while k < 3 {
                k = k + 1
                if k == 2 {
                    continue
                }
                if j == 2 && k == 1 {
                    continue
                }
                vec_push(results, i * 100 + j * 10 + k)
            }
        }
    }

    assert_eq(results, [111, 113, 123, 131, 133, 211, 213, 223, 231, 233, 311, 313, 323, 331, 333])
}

// === continue and break in for loops ===

@test
fn test_nested_for_loops_continue_and_break() {
    let results = vec_new()
    let outer_arr = [1, 2, 3, 4, 5]
    let inner_arr = [1, 2, 3, 4, 5, 6, 7, 8]

    for i in outer_arr {
        if i == 4 {
            continue
        }
        for j in inner_arr {
            if j % 2 == 0 {
                continue
            }
            if j > 5 {
                break
            }
            vec_push(results, i * 10 + j)
        }
        if vec_len(results) >= 12 {
            break
        }
    }

    // i=1: j=1,3,5 -> [11, 13, 15]
    // i=2: j=1,3,5 -> [21, 23, 25]
    // i=3: j=1,3,5 -> [31, 33, 35]
    // i=4: skipped (continue)
    // i=5: j=1,3,5 -> [51, 53, 55] but break after 12 total
    assert_eq(results, [11, 13, 15, 21, 23, 25, 31, 33, 35, 51, 53, 55])
}

@test
fn test_mixed_loop_types_with_continue() {
    let results = vec_new()
    let arr = [1, 2, 3, 4, 5]
    let i = 0

    // Outer while loop
    while i < 3 {
        i = i + 1
        if i == 2 {
            continue
        }

        // Inner for loop
        for x in arr {
            if x % 2 == 0 {
                continue
            }
            vec_push(results, i * 10 + x)
        }
    }

    assert_eq(results, [11, 13, 15, 31, 33, 35])
}

@test
fn test_deeply_nested_mixed_continue_break() {
    let results = vec_new()
    let outer_arr = [1, 2, 3, 4]
    let middle_arr = [10, 20, 30]
    let inner_arr = [100, 200, 300, 400]

    for i in outer_arr {
        if i == 4 {
            break
        }

        for j in middle_arr {
            if i == 1 && j == 20 {
                continue
            }

            for k in inner_arr {
                if k == 200 {
                    continue
                }
                if k > 300 {
                    break
                }
                if i == 2 && j == 30 && k == 300 {
                    continue
                }
                vec_push(results, i * 10000 + j * 100 + k)
            }
        }
    }

    assert_eq(results, [
        11100, 11300, 13100, 13300,
        21100, 21300, 22100, 22300, 23100,
        31100, 31300, 32100, 32300, 33100, 33300,
    ])
}

// === break/continue/return at the top level of a loop body ===
// Not nested in an if: Lua requires break/return to end a block, so the
// continue label must not follow them directly.

@test
fn test_break_toplevel_in_range_loop() {
    let sum = 0
    for i in 0..10 {
        sum = sum + i
        break
    }
    assert(sum == 0, "break at toplevel should exit after first iteration, got {sum}")
}

@test
fn test_continue_toplevel_in_range_loop() {
    let sum = 0
    for i in 0..5 {
        sum = sum + 1
        continue
    }
    assert(sum == 5, "continue at toplevel should not skip, got {sum}")
}

@test
fn test_return_inside_loop() {
    let result = helper_return_from_loop()
    assert(result == 42, "expected 42 from early return, got {result}")
}

fn helper_return_from_loop() -> int {
    for i in 0..10 {
        let x = 42
        return x
    }
    return -1
}

@test
fn test_break_in_array_loop() {
    let arr = [10, 20, 30, 40, 50]
    let first = -1
    for x in arr {
        first = x
        break
    }
    assert(first == 10, "expected first element 10, got {first}")
}

// === continue and return in the same for loop ===

@test(output = "yes 3")
fn continue_then_ifelse_then_return() {
    print(find_with_ifelse(true))
}

fn find_with_ifelse(flag: bool) -> string {
    for i in 0..5 {
        if i <= 2 { continue }

        let result = ""
        if flag {
            result = "yes"
        } else {
            result = "no"
        }

        return "{result} {i}"
    }
    return "not found"
}

global SIDE_EFFECT: int = 0

@test(output = "42")
fn continue_then_bare_return_in_void_fn() {
    do_stuff()
    print(SIDE_EFFECT)
}

fn do_stuff() {
    for i in 0..5 {
        if i <= 2 { continue }

        if i == 3 {
            SIDE_EFFECT = 42
        } else {
            SIDE_EFFECT = 0
        }

        return
    }
}

// === continue with return/break in while loops ===

@test(output = "3")
fn while_continue_then_return() {
    print(while_cr())
}

fn while_cr() -> int {
    let i = 0
    while i < 10 {
        i = i + 1
        if i < 3 { continue }
        return i
    }
    return -1
}

// === break + continue (break first in source, continue later) ===

@test(output = "5")
fn break_and_continue_in_branches() {
    let sum = 0
    for i in 0..10 {
        if i >= 4 { break }
        if i == 1 { continue }
        sum = sum + i
    }
    // 0 + skip 1 + 2 + 3 = 5
    print(sum)
}

// === nested loops with mixed control flow ===

@test(output = "2-1")
fn nested_continue_break_return() {
    print(nested_loop_test())
}

fn nested_loop_test() -> string {
    for i in 0..5 {
        if i < 2 { continue }

        for j in 0..5 {
            if j < 1 { continue }
            return "{i}-{j}"
        }
    }
    return "none"
}

@test(output = "18")
fn nested_continue_outer_break() {
    let sum = 0
    for i in 0..10 {
        if i >= 4 { break }

        for j in 0..5 {
            if j < 2 { continue }
            sum = sum + i
        }
        // inner loop adds i three times (j=2,3,4)
    }
    // i=0: +0, i=1: +3, i=2: +6, i=3: +9 = 18
    print(sum)
}

// === return inside nested if inside loop with continue ===

@test(output = "found 4")
fn continue_nested_if_return() {
    print(nested_if_return())
}

fn nested_if_return() -> string {
    for i in 0..10 {
        if i < 2 { continue }

        if i > 3 {
            if i < 6 {
                return "found {i}"
            }
        }
    }
    return "none"
}

@test(output = "6")
fn inner_continue_scope() {
    let sum = 0
    for i in 0..3 {
        for j in 0..3 {
            if j == 1 { continue }
            sum = sum + 1
        }
    }
    print(sum)
}

@test(output = "3")
fn inner_break_scope() {
    let outer_iters = 0
    for i in 0..3 {
        outer_iters = outer_iters + 1
        for j in 0..3 {
            if j == 1 { break }
        }
    }
    print(outer_iters)
}

fn inner_return_escapes() -> int {
    for i in 0..3 {
        for j in 0..3 {
            if i == 2 && j == 1 { return 7 }
        }
    }
    return -1
}

@test
fn call_inner_return() {
    assert(inner_return_escapes() == 7)
}

@test(output = "sib 4")
fn sibling_loops_share_label_scope() {
    let sum = 0
    for i in 0..3 {
        if i == 1 { continue }
        sum = sum + i
    }
    for i in 0..3 {
        if i == 1 { continue }
        sum = sum + i
    }
    print("sib {sum}")
}

// === break / continue / return inside if and else branches ===

@test(output = "4")
fn break_inside_else() {
    let c = 0
    for i in 0..10 {
        if i < 4 {
            c = c + 1
        } else {
            break
        }
    }
    print(c)
}

@test(output = "3")
fn continue_inside_else() {
    let c = 0
    for i in 0..10 {
        if i >= 5 { break }
        if i % 2 == 0 {
            c = c + 1
        } else {
            continue
        }
    }
    print(c)
}

// === Naked return in void fn nested inside two loops ===

global HIT: int = 0

@test(output = "9")
fn naked_return_in_nested_void() {
    HIT = 0
    naked_return_void_inner()
    print(HIT)
}

fn naked_return_void_inner() {
    for i in 0..3 {
        for j in 0..3 {
            HIT = HIT + 1
            if HIT == 9 { return }
        }
    }
}

// continue as the final body statement -- the `::continue::` label must
// sit between the loop body and the closing `end`.
@test(output = "done")
fn continue_as_final_stmt() {
    for i in 0..3 {
        if i == 0 { continue }
    }
    print("done")
}

// === while-loop break / continue / return ===

@test(output = "wq 5")
fn while_break_continue_return() {
    let n = 0
    while n < 10 {
        n = n + 1
        if n == 3 { continue }
        if n == 5 { break }
    }
    print("wq {n}")
}

// === for over vec with break / continue ===

@test(output = "v 4")
fn for_vec_break_continue() {
    let v: [int] = [1, 2, 3, 4, 5]
    let sum = 0
    for x in v {
        if x == 2 { continue }
        if x == 4 { break }
        sum = sum + x
    }
    print("v {sum}")
}

// === lambda return must NOT escape enclosing fn ===

@test(output = "lam 6")
fn return_in_lambda_stays_local() {
    let list: [int] = [1, 2, 3, 4, 5]
    let count = 0
    let found = list.iter().filter(x => {
        if x == 3 { return true }
        false
    }).collect()
    for _ in found {
        count = count + 1
    }
    for _ in list {
        count = count + 1
    }
    print("lam {count}")
}

// === match-arm body with {} wrap -- break / continue / return all legal ===

@test
fn match_arm_block_continue_and_break() {
    let c = 0
    for i in 0..5 {
        match i {
            2 => { continue }
            _ => { c = c + 1 }
        }
    }
    assert(c == 4)
    let d = 0
    for i in 0..10 {
        match i {
            3 => { break }
            _ => { d = d + 1 }
        }
    }
    assert(d == 3)
}

fn match_arm_block_return() -> int {
    for i in 0..10 {
        match i {
            5 => { return i }
            _ => {}
        }
    }
    return -1
}

@test
fn call_match_arm_block_return() {
    assert(match_arm_block_return() == 5)
}

// === match-arm body -- raw (no block wrap) break / continue / return ===

@test
fn match_arm_raw_continue_and_break() {
    let c = 0
    for i in 0..5 {
        match i {
            2 => continue,
            _ => { c = c + 1 }
        }
    }
    assert(c == 4)
    let d = 0
    for i in 0..10 {
        match i {
            3 => break,
            _ => { d = d + 1 }
        }
    }
    assert(d == 3)
}

fn match_arm_raw_return() -> int {
    for i in 0..10 {
        match i {
            5 => return i,
            _ => {}
        }
    }
    return -1
}

@test
fn call_match_arm_raw_return() {
    assert(match_arm_raw_return() == 5)
}
