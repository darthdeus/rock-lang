// === multiple continues before return/break ===

@test(output = "3")
fn multiple_continues_then_return() {
    print(multi_continue())
}

fn multi_continue() -> int {
    for i in 0..10 {
        if i < 3 { continue }
        if i == 4 { continue }
        if i == 5 { continue }
        return i
    }
    return -1
}

@test(output = "3")
fn multiple_continues_then_break() {
    let result = -1
    for i in 0..10 {
        if i < 3 { continue }
        if i == 4 { continue }
        if i == 5 { continue }
        result = i
        break
    }
    print(result)
}

// === return inside nested if inside loop with continue ===

@test(output = "found 4")
fn continue_nested_if_return() {
    print(nested_if_return())
}

fn nested_if_return() -> string {
    for i in 0..10 {
        if i < 2 { continue }

        if i > 3 {
            if i < 6 {
                return "found {i}"
            }
        }
    }
    return "none"
}
