// Control flow on the JS backend: shared tails and trampoline fallback.

// Shared-branch-tail structuring corpus for the `--backend js` ratchet (T8c).
// One @test per CFG-shape class the single `unstructured control flow (shared
// branch tail)` reject used to conflate. Each test runs on both backends.
//
// Class A -- a loop INSIDE a lambda body (structure::analyze now roots at lambda
// entries). The closure captures the outer accumulator by reference and owns its
// own loop counter, which loop_capture_plan must NOT mis-flag as a per-iteration
// capture.
@test(returns = 15)
fn shared_tail_lambda_body_loop() -> int {
    let sum = 0
    let run = () => {
        let i = 1
        while i <= 5 {
            sum = sum + i
            i = i + 1
        }
    }
    run()
    sum
}

// Class B -- an inlined iterator combinator TERMINAL chain. Post-inline the
// `next()` skip-loop nests inside the for-loop, and a body block `continue`s the
// OUTER loop: a multi-level jump the labeled-loop path structures.
@test(returns = 10)
fn shared_tail_combinator_chain() -> int {
    let v = [1, 2, 3]
    v.map(_ * 2).filter(_ > 2).reduce(0, (a, b) => a + b)
}

// Class C.1 -- multiple `continue` paths converging on a shared latch tail (the
// T8a-regressed shape). A nested if/else where BOTH arms fall through to the same
// accumulate block, which is NOT the branch's ipdom (the continue arms diverge to
// the latch) -- so it is a doubly-reached forward tail, not a loop.
@test(returns = 14)
fn shared_tail_multiple_continues() -> int {
    let v = [1, 2, 3, 4, 5, 6]
    let sum = 0
    for x in v {
        if x % 2 == 0 {
            if x % 4 == 0 { continue }
        } else {
            if x % 3 == 0 { continue }
        }
        sum = sum + x
    }
    sum
}

// Class C.2 -- an or-pattern success arm reached from N alternatives (a forward
// shared tail with 2+ Goto predecessors).
@test(returns = 42)
fn shared_tail_or_pattern() -> int {
    let x = 2
    return match x {
        1 | 2 | 3 => 42,
        _ => 0,
    }
}

// A shared or-pattern arm containing a nested loop.
fn nested_loop_tail(sel: int) -> int {
    let out = match sel {
        1 | 2 | 3 => {
            let acc = 0
            let i = 0
            while i < 5 {
                acc = acc + i
                i = i + 1
            }
            acc
        }
        _ => 100
    }
    return out + sel
}

@test(output = "12")
fn test_nested_loop_tail() {
    print(nested_loop_tail(2))
}

@test(output = "107")
fn test_nested_loop_tail_default() {
    print(nested_loop_tail(7))
}

// A shared arm larger than the former tail-duplication limit.
fn over_cap_tail(sel: int) -> int {
    let out = match sel {
        1 | 2 | 3 => {
            let v0 = sel + 1
            let v1 = v0 + 2
            let v2 = v1 + 3
            let v3 = v2 + 4
            let v4 = v3 + 5
            let v5 = v4 + 6
            let v6 = v5 + 7
            let v7 = v6 + 1
            let v8 = v7 + 2
            let v9 = v8 + 3
            let v10 = v9 + 4
            let v11 = v10 + 5
            let v12 = v11 + 6
            let v13 = v12 + 7
            let v14 = v13 + 1
            let v15 = v14 + 2
            v15
        }
        _ => 0
    }
    return out
}

@test(output = "61")
fn test_over_cap_tail() {
    print(over_cap_tail(2))
}

@test(output = "0")
fn test_over_cap_tail_default() {
    print(over_cap_tail(9))
}

// A tuple return after a shared arm with a nested loop.
fn unstructurable_pair(sel: int) -> (int, int) {
    let s = match sel {
        1 | 2 | 3 => {
            let acc = 0
            let i = 0
            while i < 4 {
                acc = acc + i
                i = i + 1
            }
            acc
        }
        _ => 0
    }
    return (s, s + 1)
}

@test(output = "6 7")
fn test_tuple_return_through_fallback() {
    let (a, b) = unstructurable_pair(2)
    print("{a} {b}")
}

@test(output = "0 1")
fn test_tuple_return_default() {
    let (a, b) = unstructurable_pair(9)
    print("{a} {b}")
}
