// Branches: presence, constant enum payloads, inactive value payloads and if sub-expressions.

struct Trace { code: int }

struct Switch { enabled: bool, trace: Trace }

operator !(s: Switch) -> bool {
    s.trace.code += 1
    s.enabled
}

nobox value Id { n: int }

struct State { id: Id? }

fn nullable(flag: bool?) -> int {
    if flag != null && !flag { return 1 }
    if flag == null || flag { return 2 }
    3
}

fn nullable_loop(flag: bool?) -> int {
    let n = 0
    while flag != null && flag {
        n += 1
        flag = null
    }
    n
}

fn guarded(flag: bool?) -> int {
    match 0 {
        _ if flag != null && !flag => 1,
        _ if flag == null || flag => 2,
        _ => 3,
    }
}

fn guarded_statement(flag: bool?, t: Trace) {
    match 0 {
        _ if flag != null && !flag => { t.code = 1 },
        _ if flag == null || flag => { t.code = 2 },
        _ => { t.code = 3 },
    }
}

fn overloaded(s: Switch) -> int { if !s && !s { 1 } else { 0 } }

fn present(s: State) -> int {
    if !(s.id == null) && s.id.n == 7 { return 1 }
    if s.id == null || s.id.n == 9 { return 2 }
    3
}

@test(output = "2\n1\n2\n2\n1\n2\n2\n1\n2\n0\n1\n1\n2\n2\n1\n2\n3\n0\n0\n1")
fn branch_conditions_preserve_nullable_presence_guards_and_not_overloads() {
    print(nullable(null))
    print(nullable(false))
    print(nullable(true))
    print(guarded(null))
    print(guarded(false))
    print(guarded(true))
    let t = Trace { code: 0 }
    guarded_statement(null, t)
    print(t.code)
    guarded_statement(false, t)
    print(t.code)
    guarded_statement(true, t)
    print(t.code)
    t.code = 0
    print(overloaded(Switch { enabled: false, trace: t }))
    print(t.code)
    t.code = 0
    print(overloaded(Switch { enabled: true, trace: t }))
    print(t.code)
    print(present(State { id: null }))
    print(present(State { id: Id { n: 7 } }))
    print(present(State { id: Id { n: 9 } }))
    print(present(State { id: Id { n: 8 } }))
    print(nullable_loop(null))
    print(nullable_loop(false))
    print(nullable_loop(true))
}

enum MixedPayload { Number(int), Text(string) }

@test(output = "text")
fn constant_enum_match_prunes_other_payload_types() {
    match MixedPayload::Text("text") {
        Number(n) => print(n + 1),
        Text(s) => print(s),
    }
}

co fn constant_enum_stream() -> Coroutine<int> {
    match MixedPayload::Text("text") {
        Number(n) => { if n + 1 == 2 { yield n } },
        Text(s) => print(s),
    }
    yield 0
}

@test(output = "text")
fn constant_enum_match_in_coroutine() {
    let c = constant_enum_stream()
    c.resume()
    c.resume()
}

@test(output = "42")
fn constant_enum_match_keeps_selected_payload() {
    match MixedPayload::Number(41) {
        Number(n) => print(n + 1),
        Text(s) => print(s),
    }
}

nobox value PairPayload { x: int, y: int }

enum WideMixedPayload { Pair(PairPayload), Text(string) }

@test(output = "text")
fn constant_enum_match_with_widened_payload() {
    match WideMixedPayload::Text("text") {
        Pair(p) => print(p.x + p.y),
        Text(s) => print(s),
    }
}

// https://github.com/darthdeus/rock-lang/issues/403
value BoxedPayload { x: int }

nobox value FlatPayload { x: int }

enum ValuePayload { Flat(FlatPayload), Maybe(BoxedPayload?) }

@test(output = "1")
fn inactive_value_payload_keeps_constructor_type() {
    match ValuePayload::Maybe(BoxedPayload { x: 1 }) {
        Flat(n) => print(n.x),
        Maybe(v) => print(v?.x ?? 0),
    }
}

struct PayloadSlot<T> { item: T }

fn saved_payload<T>(x: T, flag: bool) -> T {
    let saved: PayloadSlot<T> = PayloadSlot { item: x }
    if flag { return saved.item }
    return saved.item
}

@test(output = "2")
fn inactive_value_payload_as_generic_argument() {
    match ValuePayload::Maybe(BoxedPayload { x: 2 }) {
        Flat(n) => print(saved_payload<int>(n.x, true)),
        Maybe(v) => print(v?.x ?? 0),
    }
}

@test(output = "3")
fn selected_flat_payload_as_generic_argument() {
    match ValuePayload::Flat(FlatPayload { x: 3 }) {
        Flat(n) => print(saved_payload<int>(n.x, false)),
        Maybe(v) => print(v?.x ?? 0),
    }
}

@test
fn continue_before_destructure() {
    let sum = 0
    for i in 0..4 {
        if i > 1 { continue }
        let (x, y) = (1, if i > 0 { i } else { 0 })
        sum = sum + x + y
    }
    assert(sum == 3)
}

@test
fn break_before_destructure() {
    let sum = 0
    for i in 0..4 {
        if i > 1 { break }
        let (x, y) = (1, if i > 0 { i } else { 0 })
        sum = sum + x + y
    }
    assert(sum == 3)
}

fn destructure_after_return(early: bool) -> int {
    if early { return 7 }
    let (x, y) = (1, if early { 0 } else { 41 })
    x + y
}

@test
fn return_before_destructure() {
    assert(destructure_after_return(true) == 7)
    assert(destructure_after_return(false) == 42)
}

// The same closed statement if is legal with an enclosing loop.
@test
fn closed_if_continue_in_loop() {
    let visited = 0
    for i in 0..4 {
        if i > 1 { continue } else { 42 }
        visited = visited + 1
    }
    assert(visited == 2)
}

@test
fn closed_if_break_in_loop() {
    let visited = 0
    for i in 0..4 {
        if i > 1 { break } else { 42 }
        visited = visited + 1
    }
    assert(visited == 2)
}
