// Returns: naked, implicit and result destinations.

fn test_naked_return_helper5() {
    print("before return")
    return
    print("after return")
}

@test(output = "before return")
fn test_naked_return_in_void_function() {
    test_naked_return_helper5()
}

fn test_naked_return_helper6(x: int) -> int {
    if x < 0 {
        return -1
    }
    if x == 0 {
        return 0
    }
    return x
}

@test(output = "5\n0\n-1")
fn test_multiple_returns_with_newlines() {
    print(test_naked_return_helper6(5))
    print(test_naked_return_helper6(0))
    print(test_naked_return_helper6(-5))
}

fn lookup_free(m: Map<int, string>, key: int) -> string? {
    get(m, key)
}

fn lookup_ufcs(m: Map<int, string>, key: int) -> string? {
    m.get(key)
}

fn lookup_with_early_return(m: Map<int, string>, key: int) -> string? {
    if key < 0 { return null }
    // Implicit return after early return guard
    m.get(key)
}

struct Wrapper {
    value: int,
}

fn lookup_arena_style(a: Arena<Wrapper>, key: int) -> Wrapper? {
    // Simulates the actual pattern: arena entity lookup
    let e = a.pairs().find(_.1.value == key)
    if e == null { return null }
    e.1
}

@test
fn test_implicit_return_of_a_call() {
    let m: Map<int, string> = map_new()
    insert(m, 1, "hello")
    assert_eq(lookup_free(m, 1).unwrap(), "hello")
    assert_eq(lookup_ufcs(m, 1).unwrap(), "hello")
    assert_eq(lookup_with_early_return(m, 1).unwrap(), "hello")
    assert_eq(lookup_with_trailing_comments(m, 1).unwrap(), "hello")
}

@test
fn test_implicit_return_arena_style() {
    let a: Arena<Wrapper> = arena_new()
    a.insert(Wrapper { value: 42 })

    let result = lookup_arena_style(a, 42)
    assert(result != null, "Expected non-null from arena lookup")
    assert_eq(result.unwrap().value, 42)
    print("arena-style implicit return works")
}

// Trailing comments after the tail expression

fn lookup_with_trailing_comments(m: Map<int, string>, key: int) -> string? {
    if key < 0 { return null }

    m.get(key)

    // some old code
    // that was commented out
    // return null
}

struct Trace { n: int }

nobox value Pair { x: int, y: int }

fn tick(t: Trace, n: int) -> int { t.n = t.n * 10 + n; n }

fn pick(t: Trace, flag: bool) -> (int, int) {
    return if flag {
        let first = tick(t, 1)
        (first, tick(t, 2))
    } else {
        if t.n == 0 { return (tick(t, 3), tick(t, 4)) }
        (tick(t, 5), tick(t, 6))
    }
}

fn cleanup(t: Trace, flag: bool) -> int {
    defer { t.n = t.n * 10 + 9 }
    if flag { t.n } else { 7 }
}

fn inner_cleanup(t: Trace) -> int {
    return { defer { t.n = t.n * 10 + 8 }; t.n }
}

fn maybe(flag: bool) -> int? { if flag { null } else { 3 } }

fn truth(flag: bool) -> bool { if flag { false } else { true } }

fn tuple_option(flag: bool) -> (int, Pair)? {
    if flag { (7, Pair { x: 8, y: 9 }) } else { null }
}

@test(output = "1\n2\n12\n3\n4\n34\n34\n349\n349\n3498\ntrue\n3\nfalse\ntrue\ntrue\n7\n8\n9")
fn destination_returns_keep_effect_order_and_defer_snapshots() {
    let t = Trace { n: 0 }
    let (a, b) = pick(t, true)
    print(a); print(b); print(t.n)
    t.n = 0
    let (c, d) = pick(t, false)
    print(c); print(d); print(t.n)
    print(cleanup(t, true)); print(t.n)
    print(inner_cleanup(t)); print(t.n)
    print(maybe(true) == null); print(maybe(false) ?? 0)
    print(truth(true)); print(truth(false))
    print(tuple_option(false) == null)
    if let value = tuple_option(true) {
        print(value.0); print(value.1.x); print(value.1.y)
    }
}

fn exit_from_ordering_left(n: float) -> int {
    let _ = { return 23 } < n
    return 41
}

fn exit_from_ordering_right(n: int) -> int {
    let _ = n < { return 17 }
    return 31
}

@test fn ordering_operands_can_exit_the_function() {
    assert_eq(exit_from_ordering_left(2.5), 23)
    assert_eq(exit_from_ordering_right(3), 17)
}
