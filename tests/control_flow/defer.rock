// Defer statement tests - execution order, scoping, and edge cases
// Tests that defer statements execute in LIFO order at scope exit

// Helper functions for defer tests
fn cleanup() {
    print("cleanup called")
}

fn cleanup1() {
    print("cleanup1")
}

fn cleanup2() {
    print("cleanup2")
}

fn level3() {
    defer { print("level3 defer") }
    print("level3 work")
}

fn level2() {
    defer { print("level2 defer") }
    print("level2 start")
    level3()
    print("level2 end")
}

fn level1() {
    defer { print("level1 defer") }
    print("level1 start")
    level2()
    print("level1 end")
}

fn inner() {
    defer { print("inner defer") }
    print("inner work")
}

fn test_defer_mixed_syntax_nested_cleanup() { 
    print("func cleanup") 
}

// Test: Basic defer executes in LIFO order
@test(output = "start\nmiddle\nend\ndefer 2\ndefer 1")
fn test_basic_defer() {
    print("start");

    defer {
        print("defer 1")
    }

    print("middle");

    defer {
        print("defer 2")
    }

    print("end")
}

// Test: Defer executes even with early return
@test(output = "before return\ndefer executed")
fn test_defer_with_return() {
    print("before return");

    defer {
        print("defer executed")
    }

    return;
    print("unreachable")
}

// Test: Multiple defers execute in reverse order
@test(output = "third\nsecond\nfirst")
fn test_multiple_defers() {
    defer { print("first") }
    defer { print("second") }
    defer { print("third") }
}

// Test: Defer with early return and cleanup
@test(output = "work\ncleanup")
fn test_defer_with_error_handling() {
    defer { print("cleanup") }

    print("work");
    return;
}

// Test: Simple defer statement
@test(output = "defer")
fn test_simple_defer() {
    defer {
        print("defer")
    }
}

// Test: Defer with surrounding code
@test(output = "start\nend\ndefer\nstart\nend\ndefer executed")
fn test_defer_with_print() {
    {
        print("start");

        defer {
            print("defer")
        }

        print("end")
    }

    {
        print("start");

        defer {
            print("defer executed")
        }

        print("end")
    }
}

// Test: Defer expression syntax (function call)
@test(output = "work done\ncleanup called")
fn test_defer_expression_syntax() {
    defer(cleanup())
    print("work done")
}

// Test: Defer scoping in nested function calls
@test(output = "before inner\ninner work\ninner defer\nafter inner\nouter defer")
fn test_defer_multiple_scopes() {
    defer { print("outer defer") }

    print("before inner")
    inner()
    print("after inner")
}

// Test: Mixed defer syntax
@test(output = "work\ncleanup2\ncleanup1")
fn test_defer_mixed_syntax() {
    defer(cleanup1())
    defer { print("cleanup2") }

    print("work")
}

// Test: Defer in conditional blocks
@test(output = "in if block\nif defer\nafter if\nfunction defer")
fn test_defer_with_if_else_blocks() {
    defer { print("function defer") }

    if true {
        defer { print("if defer") }
        print("in if block")
    } else {
        defer { print("else defer") }
        print("in else block")
    }

    print("after if")
}

// Test: Nested if blocks with defer
@test(output = "inner if\ninner if defer\nouter if\nouter if defer\nafter all\nouter defer")
fn test_defer_with_nested_if_blocks() {
    defer { print("outer defer") }

    if true {
        defer { print("outer if defer") }

        if true {
            defer { print("inner if defer") }
            print("inner if")
        }

        print("outer if")
    }

    print("after all")
}

// Test: Deep function call nesting with defers
@test(output = "level1 start\nlevel2 start\nlevel3 work\nlevel3 defer\nlevel2 end\nlevel2 defer\nlevel1 end\nlevel1 defer")
fn test_defer_with_nested_function_calls() {
    level1()
}

// Test: Defer expression in nested blocks
@test(output = "work done\ncleanup2\nfunction end\ncleanup1")
fn test_defer_expression_in_nested_blocks() {
    defer(cleanup1())

    if true {
        defer(cleanup2())
        print("work done")
    }

    print("function end")
}

// Test: Mixed defer types in nested scopes
@test(output = "in block\nblock cleanup\nafter block\nfunc cleanup")
fn test_defer_mixed_syntax_nested() {
    defer(test_defer_mixed_syntax_nested_cleanup())

    if true {
        defer { print("block cleanup") }
        print("in block")
    }

    print("after block")
}

// ============================================
// Defer and lambdas. A lambda lowered
// while an enclosing `defer` is pending must NOT splice that defer into its
// own body: the lambda is a separate fn scope whose `return` runs only the
// lambda's own defers. Pre-fix the shared `defers` stack leaked the enclosing
// defer into every lambda call (miscompile) and, when the defer body created
// the lambda, recursed forever during lowering (compiler stack overflow).
// Co-fn variants live in closures/capture_semantics_cofn.rock.
// ============================================

global R1: int = 0

fn defer_then_lambda() -> int {
    defer { R1 = R1 + 1 }
    let f = () => 42
    let a = f()
    let b = f()
    return a + b
}

// Pre-fix: each `f()` ran the spliced enclosing defer, so R1 == 3 (two calls
// + the real defer). The lambda is capture-free; its own return is 42.
@test(output = "x=84 R=1")
fn test_defer_then_lambda_runs_defer_once() {
    let x = defer_then_lambda()
    print("x={x} R={R1}")
}

global R2: int = 0

// The compiler-stack-overflow shape: the lambda lives INSIDE the defer body.
// Pre-fix, lowering the lambda re-ran the still-pending defer's splice ->
// infinite recursion. Now the defer runs once at fn exit.
fn lambda_in_defer_body() {
    defer {
        let f = () => 7
        R2 = R2 + f()
    }
}

@test(output = "R=7")
fn test_lambda_in_defer_body_no_crash() {
    lambda_in_defer_body()
    print("R={R2}")
}

global R3: int = 0

// A lambda created BEFORE the defer was always correct (no pending defer at
// lambda-lowering time) -- guards that the fix doesn't perturb it.
fn lambda_before_defer() -> int {
    let f = () => 42
    defer { R3 = R3 + 1 }
    let a = f()
    let b = f()
    return a + b
}

@test(output = "x=84 R=1")
fn test_lambda_before_defer_unaffected() {
    let x = lambda_before_defer()
    print("x={x} R={R3}")
}

global R4: int = 0

// A defer INSIDE a lambda body is the lambda's OWN scope: it must still run at
// each lambda exit (once per call), which the isolation preserves.
fn defer_inside_lambda() -> int {
    let f = () => {
        defer { R4 = R4 + 1 }
        return 5
    }
    let a = f()
    let b = f()
    return a + b
}

@test(output = "x=10 R=2")
fn test_defer_inside_lambda_runs_per_call() {
    let x = defer_inside_lambda()
    print("x={x} R={R4}")
}

global R5: int = 0

// Multiple pending enclosing defers + a lambda with an early return. Each of
// the lambda's two returns runs only the lambda's (empty) defers; the two
// enclosing defers run once at the enclosing fn's return (R5 += 11 per call).
fn multi_defer_lambda(cond: bool) -> int {
    defer { R5 = R5 + 1 }
    defer { R5 = R5 + 10 }
    let f = (n: int) => {
        if n > 0 { return n }
        return -1
    }
    if cond {
        return f(3)
    }
    return f(-2)
}

@test(output = "a=3 b=-1 R=22")
fn test_multi_defer_lambda_early_return() {
    let a = multi_defer_lambda(true)
    let b = multi_defer_lambda(false)
    print("a={a} b={b} R={R5}")
}

// ============================================
// Defer and locals. A defer body reads its locals when it RUNS, at scope
// exit, not when it is registered; it sees the binding in scope at the
// `defer`, not a later shadow; a loop body's defer runs once per iteration,
// on `continue` and `break` too; and a `return` value is computed before
// the defers run.
// ============================================

global DL: string = ""

fn dl(s: string) { DL = DL + s }

fn defer_reads_the_exit_value() {
    let x = 1
    defer { dl("{x}") }
    x = 2
}

fn defer_ignores_a_later_shadow() {
    let x = 1
    defer { dl("{x}") }
    let x = 5
    dl("{x}")
}

fn defer_per_loop_iteration() {
    for i in 0..4 {
        defer { dl("d{i}") }
        if i == 1 { continue }
        if i == 2 { break }
        dl("b{i}")
    }
}

fn defer_after_return_value() -> int {
    let x = 1
    defer { x = 10 }
    return x
}

fn defer_in_a_block_sees_its_local() {
    let x = 1
    {
        let y = x + 1
        defer { dl("y{y}") }
        y = 7
    }
    dl("x{x}")
}

@test fn test_defer_reads_the_exit_value() { DL = ""; defer_reads_the_exit_value(); assert_eq(DL, "2") }
@test fn test_defer_ignores_a_later_shadow() { DL = ""; defer_ignores_a_later_shadow(); assert_eq(DL, "51") }
@test fn test_defer_per_loop_iteration() { DL = ""; defer_per_loop_iteration(); assert_eq(DL, "b0d0d1d2") }
@test fn test_defer_after_return_value() { assert_eq(defer_after_return_value(), 1) }
@test fn test_defer_in_a_block_sees_its_local() { DL = ""; defer_in_a_block_sees_its_local(); assert_eq(DL, "y7x1") }
