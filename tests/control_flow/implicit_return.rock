// A function's trailing expression is its return value, whether it is a
// free call, a UFCS call, follows an early-return guard, or is followed by
// comments. Regression: UFCS calls in tail position lost their value.

fn lookup_free(m: Map<int, string>, key: int) -> string? {
    get(m, key)
}

fn lookup_ufcs(m: Map<int, string>, key: int) -> string? {
    m.get(key)
}

fn lookup_with_early_return(m: Map<int, string>, key: int) -> string? {
    if key < 0 { return null }
    // Implicit return after early return guard
    m.get(key)
}

struct Wrapper {
    value: int,
}

fn lookup_arena_style(a: Arena<Wrapper>, key: int) -> Wrapper? {
    // Simulates the actual pattern: arena entity lookup
    let e = a.pairs().find(_.1.value == key)
    if e == null { return null }
    e.1
}

@test
fn test_implicit_return_of_a_call() {
    let m: Map<int, string> = map_new()
    insert(m, 1, "hello")
    assert_eq(lookup_free(m, 1).unwrap(), "hello")
    assert_eq(lookup_ufcs(m, 1).unwrap(), "hello")
    assert_eq(lookup_with_early_return(m, 1).unwrap(), "hello")
    assert_eq(lookup_with_trailing_comments(m, 1).unwrap(), "hello")
}

@test
fn test_implicit_return_arena_style() {
    let a: Arena<Wrapper> = arena_new()
    a.insert(Wrapper { value: 42 })

    let result = lookup_arena_style(a, 42)
    assert(result != null, "Expected non-null from arena lookup")
    assert_eq(result.unwrap().value, 42)
    print("arena-style implicit return works")
}

// Trailing comments after the tail expression

fn lookup_with_trailing_comments(m: Map<int, string>, key: int) -> string? {
    if key < 0 { return null }

    m.get(key)

    // some old code
    // that was commented out
    // return null
}
