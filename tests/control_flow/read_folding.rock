struct P { x: int, y: int }
fn twice(n: int) -> int { return n * 2 }
fn sum(p: P) -> int { return p.x + p.y }
fn scaled(p: P) -> int { return twice(p.x) + 1 }
@test(output = "7 7")
fn single_use_reads_and_calls() {
    let p = P { x: 3, y: 4 }
    print("{sum(p)} {scaled(p)}")
}

global bump_marks: int = 0
fn bump_twice() -> int { bump_marks += 1; return bump_marks }
@inline inline(lua) fn checked(x: int) -> int = "x + 1"
fn run(n: int) {
    bump_twice()
    checked(n)
    bump_twice()
}
@test(backends = "lua", output = "2")
fn unused_call_results_run() {
    run(1)
    print("{bump_marks}")
}

global marks: int = 1
struct Row { value: int }
@nomangle fn bump() -> int { marks = 2; return 7 }
@nomangle fn probe(row: Row) -> int { marks = 1; return row.value + marks }
@nomangle fn via_map(values: Map<string, int>) -> int { marks = 1; return values["value"] + marks }
@nomangle fn via_vec(values: [int?]) -> (int?, int) { marks = 1; return (values[0], marks) }
@nomangle fn control() -> int { marks = 1; return bump() + marks }
inline(lua) fn host_probe() -> bool = """
local row = setmetatable({}, { __index = function() return bump() end })
local values = setmetatable({}, { __index = function() return bump() end })
local xs = setmetatable({ [0] = 1 }, getmetatable(values))
local value, snapshot = via_vec(xs)
return probe(row) == 9 and via_map(values) == 9 and value + snapshot == 9 and control() == 9
"""

@test(backends = "lua")
fn folded_calls_keep_the_order_of_foreign_reads() {
    assert(host_probe())
}

global branch_marks: int = 0
fn bump_once(n: int) -> int { branch_marks += 1; return n }
fn maybe(n: int) -> int? { branch_marks += 10; return n }
fn global_after_call() -> int {
    branch_marks = 0
    let r = bump_once(5) + 1
    return r * 100 + branch_marks
}
fn call_in_dropped_branch() -> int {
    branch_marks = 0
    let unused = maybe(1) ?? -1
    return branch_marks
}
@test(output = "601 10")
fn folded_calls_respect_effects() {
    print("{global_after_call()} {call_in_dropped_branch()}")
}

fn pick(a: int, b: int) -> int {
    let m = a
    if b > a {
        m = b * 2
    }
    let n = m
    if n > 10 {
        return n - 10
    }
    return n * n + n
}
fn stepper(k: int) -> int {
    let x = k
    let total = 0
    while x > 0 {
        let y = x
        x = x - 3
        total = total + y * y
    }
    return total
}
@test(output = "20 12 8 66")
fn copied_cell_preserves_reads_across_branch_and_loop() {
    print("{pick(1, 2)} {pick(3, 1)} {pick(1, 9)} {stepper(7)}")
}

fn choose_cell(a: int, b: int) -> int {
    let m = 0
    let t = a * 3
    if t > b {
        m = t
    } else {
        m = b - t
    }
    return m * 2
}
fn clampish(a: int, lo: int) -> int {
    let m = 0
    let t = a * 3
    if t < lo {
        m = lo - 1
    } else {
        m = t
    }
    return m + t
}
fn swapper(a: int, b: int) -> int {
    let x = a
    let y = b
    let i = 0
    while i < 3 {
        let t = x + 1
        x = y
        y = t
        i = i + 1
    }
    return x * 100 + y
}
@test(output = "4 24 7 24 303")
fn assignment_preserves_live_values() {
    print("{choose_cell(1, 5)} {choose_cell(4, 5)} {clampish(1, 5)} {clampish(4, 5)} {swapper(1, 2)}")
}

fn use_dying_cell(n: int) -> int {
    let u = n * 2
    let t = 0
    let i = 0
    while i < n {
        t = t + u
        u = u - 1
        i = i + 1
    }
    let s = t
    let k = 0
    while k < n {
        s = s + k
        k = k + 1
    }
    return s
}
@test(output = "18")
fn copy_from_a_dying_cell_keeps_its_value() {
    print("{use_dying_cell(3)}")
}

fn f(x: int) -> int {
    print("f{x}")
    return x + 1
}
fn call_via_underscore(n: int) {
    let _ = f(n)
    let _ = f(n * 2)
}
@test(output = "f3\nf6")
fn calls_bound_to_underscore_still_run() {
    call_via_underscore(3)
}

fn discard_indirect(cb: fn() -> int, n: int) {
    let i = 0
    while i < n {
        cb()
        i = i + 1
    }
}
@test(output = "t1\nt2")
fn discarded_indirect_calls_still_run() {
    let t = 0
    discard_indirect(() => {
        t = t + 1
        print("t{t}")
        return t
    }, 2)
}
