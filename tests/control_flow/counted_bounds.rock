@test
fn local_bound() {
    let n = 5
    let i = 0
    let count = 0
    while i < n {
        if i == 0 { n = 2 } else { count += 1 }
        i += 1
    }
    assert_eq(count, 1)
}

@test
fn vec_bound() {
    let items = [0]
    let i = 0
    let count = 0
    while i < items.len() {
        if i < 3 { vec_push(items, i) } else { count += 1 }
        i += 1
    }
    assert_eq(count, 1)
}

struct Bound { n: int }

@test
fn field_bound() {
    let bound = Bound { n: 5 }
    let alias = bound
    let i = 0
    let count = 0
    while i < bound.n {
        if i == 0 { alias.n = 2 } else { count += 1 }
        i += 1
    }
    assert_eq(count, 1)
}

global LOOP_BOUND: int = 5

fn shorten_bound() {
    LOOP_BOUND = 2
}

@test
fn global_bound() {
    LOOP_BOUND = 5
    let i = 0
    let count = 0
    while i < LOOP_BOUND {
        if i == 0 { shorten_bound() } else { count += 1 }
        i += 1
    }
    assert_eq(count, 1)
}

@test
fn closure_bound() {
    let n = 5
    let shorten = () => { n = 2 }
    let i = 0
    let count = 0
    while i < n {
        if i == 0 { shorten() } else { count += 1 }
        i += 1
    }
    assert_eq(count, 1)
}

@test
fn mutable_step() {
    let step = 1
    let i = 0
    let sum = 0
    while i < 5 {
        sum += i
        step += 1
        i += step
    }
    assert_eq(sum, 2)
}

@test
fn assigned_counter() {
    let sum = 0
    for i in 0..5 {
        sum += i
        if i == 0 { i = 3 }
    }
    assert_eq(sum, 4)
}

fn invariant_bound(n: int) -> int {
    let i = 0
    let count = 0
    while i < n {
        if i % 2 == 0 { count += i } else { count -= 1 }
        i += 1
    }
    count
}

fn range_snapshot(n: int, stop: int) -> int {
    let bound = n
    let sum = 0
    for i in 0..bound {
        bound = 1
        if i == 1 { continue }
        if i == stop { break }
        sum += i
    }
    sum + bound
}

@test
fn bounds_in_nested_loops() {
    let n = 5
    let total = 0
    for row in 0..3 {
        let col = 0
        while col < n {
            if col == 0 { n -= 1 } else { total += row + col }
            col += 1
        }
    }
    assert_eq(total, 14)
    assert_eq(invariant_bound(5), 4)
    assert_eq(invariant_bound(0), 0)
    assert_eq(range_snapshot(5, 3), 3)
    assert_eq(range_snapshot(5, 8), 10)
}

struct BoundIter { i: int, bound: Bound }

@inline
fn iter(bound: Bound) -> BoundIter { BoundIter { i: 0, bound: bound } }

@inline
fn next(it: BoundIter) -> (bool, int) {
    if it.i >= it.bound.n { return (false, 0) }
    let i = it.i
    it.i += 1
    (true, i)
}

fn shorten_field(bound: Bound) {
    bound.n = 2
}

fn iter_field_bound(bound: Bound) -> int {
    let count = 0
    for i in bound {
        if i == 0 { shorten_field(bound) }
        count += 1
    }
    count
}

@test
fn iterator_reads_aliased_bound_each_turn() {
    assert_eq(iter_field_bound(Bound { n: 5 }), 2)
}

fn assigned_parameter(i: int, n: int) -> int {
    let count = 0
    while i < n {
        if i == 0 { i = 3 } else { count += 1 }
        i += 1
    }
    count
}

@test
fn parameter_counter_assignment_affects_the_next_test() {
    assert_eq(assigned_parameter(0, 5), 1)
}

@test
fn iterator_reads_vec_length_each_turn() {
    let xs = [0]
    let count = 0
    for x in xs.iter().map(x => x) {
        if x < 3 { vec_push(xs, x + 1) }
        count += 1
    }
    assert_eq(count, 4)
}

fn fused_latch(n: int, stop: int) -> int {
    let i = 0
    let sum = 0
    while i < n {
        if i == stop { break }
        if i % 2 == 0 { sum += i } else { sum -= 1 }
        sum += 1
        i += 1
    }
    sum
}

fn straight_latch() -> int {
    let i = 0
    let sum = 0
    while i < 5 {
        sum += i
        i += 1
    }
    sum
}

fn continue_skips_latch(n: int) -> int {
    let i = 0
    let sum = 0
    while i < n {
        if i == 0 {
            i += 2
            continue
        }
        sum += i
        i += 1
    }
    sum
}

@test
fn invariant_bound_with_work_in_the_latch() {
    assert_eq(fused_latch(5, 8), 9)
    assert_eq(fused_latch(5, 3), 4)
    assert_eq(fused_latch(0, 8), 0)
    assert_eq(straight_latch(), 10)
    assert_eq(continue_skips_latch(5), 9)
}

co fn indices(xs: [int]) -> Coroutine<int> {
    let i = 0
    while i < xs.len() {
        yield i
        i += 1
    }
}

@test
fn resumed_test_reads_the_current_bound() {
    let xs = [0]
    let c = indices(xs)
    assert_eq(c.resume(), 0)
    vec_push(xs, 1)
    assert_eq(c.resume(), 1)
    assert(c.resume() == null)
}

fn reentered_counter(n: int, reset: bool) -> int {
    let col = 0
    let sum = 0
    for row in 0..3 {
        if reset { col = 0 }
        while col < n {
            sum += row * 10 + col
            col += 1
        }
    }
    sum
}

fn reentered_unreset_counter(n: int) -> int {
    let col = 0
    let sum = 0
    for row in 0..3 {
        while col < n {
            sum += row * 10 + col
            col += 1
        }
    }
    sum
}

fn reentered_reset_counter(n: int) -> int {
    let col = 0
    let sum = 0
    for row in 0..3 {
        col = 0
        while col < n {
            sum += row * 10 + col
            col += 1
        }
    }
    sum
}

fn locally_reset_counter(n: int) -> int {
    let sum = 0
    for row in 0..3 {
        let col = 0
        while col < n {
            sum += row * 10 + col
            col += 1
        }
    }
    sum
}

@test
fn reentered_counters_keep_or_reset_their_value() {
    assert_eq(reentered_counter(3, true), 99)
    assert_eq(reentered_counter(3, false), 3)
    assert_eq(reentered_unreset_counter(3), 3)
    assert_eq(reentered_reset_counter(3), 99)
    assert_eq(locally_reset_counter(3), 99)
    assert_eq(reentered_unreset_counter(2), 1)
    assert_eq(reentered_reset_counter(2), 63)
}

fn increment_only(n: int, bound: Bound) -> int {
    let from_param = 0
    let from_field = 0
    let backwards = n
    while from_param < n { from_param = from_param + 1 }
    while from_field < bound.n { from_field += 1 }
    while backwards > 0 { backwards = backwards - 1 }
    from_param + from_field + backwards
}

@test
fn increment_only_loops_advance_the_counter() {
    assert_eq(increment_only(4, Bound { n: 6 }), 10)
    assert_eq(increment_only(0, Bound { n: 0 }), 0)
}

fn computed_bound(w: int, h: int, stop: int) -> int {
    let i = 0
    let total = 0
    while i < w * h + 1 {
        if i == stop { break }
        total += i
        i += 1
    }
    total
}

fn mutable_computed_bound(w: int, h: int) -> int {
    let i = 0
    let total = 0
    while i < w * h {
        total += i
        w -= 1
        i += 1
    }
    total
}

@test
fn computed_bounds_track_mutations_and_zero_trips() {
    assert_eq(computed_bound(3, 4, 99), 78)
    assert_eq(computed_bound(3, 4, 4), 6)
    assert_eq(computed_bound(3, -4, 99), 0)
    assert_eq(mutable_computed_bound(5, 2), 6)
}

fn computed_bound_edge(start: int, w: int, h: int, stop: int) -> int {
    let i = start
    let count = 0
    while i < w * h {
        if i == stop { return 7 }
        if w == h { count += 1 } else { count += 2 }
        i += 1
    }
    count
}

@test
fn computed_exclusive_bound_preserves_exact_integer_edge() {
    let edge = -9007199254740992
    assert_eq(computed_bound_edge(edge, -4503599627370496, 2, edge), 0)
}

@test(type_holes = [[0, "int"]])
fn vec_iteration_keeps_the_inferred_element_type() {
    let sum = 0
    for element in [1, 2, 3] { let inferred: ? = element; sum += element }
    assert_eq(sum, 6)
}

@test(type_holes = [[1, "int"]])
fn map_iteration_keeps_the_inferred_value_type() {
    let values = map_new()
    insert(values, "a", 1)
    insert(values, "b", 2)
    insert(values, "c", 3)
    let sum = 0
    for (key, value) in values { let inferred: ? = value; sum += value }
    assert_eq(sum, 6)
}

@test(type_holes = [[2, "int"]])
fn arena_iteration_keeps_the_inferred_row_type() {
    let rows = arena_new()
    for value in [10, 20, 30] { insert(rows, value) }
    let sum = 0
    for (entity, row) in rows { let inferred: ? = row; sum += row }
    assert_eq(sum, 60)
}

struct LoopProbe { count: int = 0, checks: int = 0 }

fn still_below(probe: LoopProbe, budget: int) -> bool {
    probe.checks += 1
    return probe.count < budget
}

fn scan_twice(probe: LoopProbe, capacity: int, budget: int) {
    for _ in 0..2 {
        let slot = 0
        while slot < capacity && still_below(probe, budget) {
            probe.count += 1
            slot += 1
        }
    }
}

@test
fn compound_while_conditions_short_circuit_on_each_iteration() {
    let probe = LoopProbe {}
    scan_twice(probe, 0, 9)
    assert_eq(probe.count, 0)
    assert_eq(probe.checks, 0)
    scan_twice(probe, 4, 2)
    assert_eq(probe.count, 2)
    assert_eq(probe.checks, 4)
    let slot = 0
    while slot < 3 || still_below(probe, 6) {
        probe.count += 1
        slot += 1
    }
    assert_eq(probe.count, 6)
    assert_eq(probe.checks, 6)
}

fn run_loop_callback(draw: fn() -> ()) { draw() }

@test
fn nested_loops_in_callbacks_keep_each_index_and_skip_only_the_inner_body() {
    let sum = 0
    let grid = [[0, 0, 0], [0, 0, 0], [0, 0, 0]]
    run_loop_callback(() => {
        for y in 0..3 {
            for x in 0..3 {
                grid[y][x] = y * 3 + x
                if x == 1 { continue }
                for n in 0..2 { sum += grid[y][x] + n }
            }
        }
    })
    assert_eq(grid[1][1], 4)
    assert_eq(grid[2][2], 8)
    assert_eq(sum, 54)
}
