@test
fn local_bound() {
    let n = 5
    let i = 0
    let count = 0
    while i < n {
        if i == 0 { n = 2 } else { count += 1 }
        i += 1
    }
    assert_eq(count, 1)
}

@test
fn vec_bound() {
    let items = [0]
    let i = 0
    let count = 0
    while i < items.len() {
        if i < 3 { vec_push(items, i) } else { count += 1 }
        i += 1
    }
    assert_eq(count, 1)
}

struct Bound { n: int }

@test
fn field_bound() {
    let bound = Bound { n: 5 }
    let alias = bound
    let i = 0
    let count = 0
    while i < bound.n {
        if i == 0 { alias.n = 2 } else { count += 1 }
        i += 1
    }
    assert_eq(count, 1)
}

global LOOP_BOUND: int = 5

fn shorten_bound() {
    LOOP_BOUND = 2
}

@test
fn global_bound() {
    LOOP_BOUND = 5
    let i = 0
    let count = 0
    while i < LOOP_BOUND {
        if i == 0 { shorten_bound() } else { count += 1 }
        i += 1
    }
    assert_eq(count, 1)
}

@test
fn closure_bound() {
    let n = 5
    let shorten = () => { n = 2 }
    let i = 0
    let count = 0
    while i < n {
        if i == 0 { shorten() } else { count += 1 }
        i += 1
    }
    assert_eq(count, 1)
}

@test
fn mutable_step() {
    let step = 1
    let i = 0
    let sum = 0
    while i < 5 {
        sum += i
        step += 1
        i += step
    }
    assert_eq(sum, 2)
}

@test
fn assigned_counter() {
    let sum = 0
    for i in 0..5 {
        sum += i
        if i == 0 { i = 3 }
    }
    assert_eq(sum, 4)
}

fn invariant_bound(n: int) -> int {
    let i = 0
    let count = 0
    while i < n {
        if i % 2 == 0 { count += i } else { count -= 1 }
        i += 1
    }
    count
}

fn range_snapshot(n: int, stop: int) -> int {
    let bound = n
    let sum = 0
    for i in 0..bound {
        bound = 1
        if i == 1 { continue }
        if i == stop { break }
        sum += i
    }
    sum + bound
}

@test
fn bounds_in_nested_loops() {
    let n = 5
    let total = 0
    for row in 0..3 {
        let col = 0
        while col < n {
            if col == 0 { n -= 1 } else { total += row + col }
            col += 1
        }
    }
    assert_eq(total, 14)
    assert_eq(invariant_bound(5), 4)
    assert_eq(invariant_bound(0), 0)
    assert_eq(range_snapshot(5, 3), 3)
    assert_eq(range_snapshot(5, 8), 10)
}

struct BoundIter { i: int, bound: Bound }

@inline
fn iter(bound: Bound) -> BoundIter { BoundIter { i: 0, bound: bound } }

@inline
fn next(it: BoundIter) -> (bool, int) {
    if it.i >= it.bound.n { return (false, 0) }
    let i = it.i
    it.i += 1
    (true, i)
}

fn shorten_field(bound: Bound) {
    bound.n = 2
}

fn iter_field_bound(bound: Bound) -> int {
    let count = 0
    for i in bound {
        if i == 0 { shorten_field(bound) }
        count += 1
    }
    count
}

@test
fn iterator_reads_aliased_bound_each_turn() {
    assert_eq(iter_field_bound(Bound { n: 5 }), 2)
}

fn assigned_parameter(i: int, n: int) -> int {
    let count = 0
    while i < n {
        if i == 0 { i = 3 } else { count += 1 }
        i += 1
    }
    count
}

@test
fn parameter_counter_assignment_affects_the_next_test() {
    assert_eq(assigned_parameter(0, 5), 1)
}

@test
fn iterator_reads_vec_length_each_turn() {
    let xs = [0]
    let count = 0
    for x in xs.iter().map(x => x) {
        if x < 3 { vec_push(xs, x + 1) }
        count += 1
    }
    assert_eq(count, 4)
}
