// loop, while and for-in loops: break, continue, nesting, iteration over
// vectors, maps, arrays and arenas, and the element types they bind. Type
// hole ids are numbered across the whole file.

@test(output = "3")
fn loop_basic_break() {
    let i = 0

    loop {
        i = i + 1
        if i == 3 {
            break
        }
    }

    print(i)
}

@test(output = "9")
fn loop_continue_and_sum() {
    let i = 0
    let sum = 0

    loop {
        i = i + 1
        if i % 2 != 0 {
            sum = sum + i
            if i >= 5 {
                break
            }
        }
    }

    print(sum)
}

@test(output = "3\n2")
fn loop_nested() {
    let outer = 0
    let inner = 0

    loop {
        outer = outer + 1
        inner = 0

        loop {
            inner = inner + 1
            if inner == 2 {
                break
            }
        }

        if outer == 3 {
            break
        }
    }

    print(outer)
    print(inner)
}

// ============================================
// Additional Continue Statement Tests
// ============================================

@test(output = "9\n5")
fn continue_after_statements() {
    let sum = 0
    let count = 0
    let i = 0

    loop {
        i = i + 1
        count = count + 1

        if i % 2 == 0 {
            continue
        }

        sum = sum + i

        if i >= 5 {
            break
        }
    }

    print(sum)
    print(count)
}

// ============================================
// Additional For Loop Tests
// ============================================

@test(output = "6")
fn vec_iteration_basic() {
    let vec = vec_new()
    vec_push(vec, 1)
    vec_push(vec, 2)
    vec_push(vec, 3)

    let sum = 0

    for x in vec {
        sum += x
    }

    print(sum)
}

@test(output = "6")
fn map_tuple_iteration() {
    let map = map_new()
    insert(map, "a", 1)
    insert(map, "b", 2)
    insert(map, "c", 3)

    let sum = 0

    for (key, value) in map {
        sum += value
    }

    print(sum)
}

// ============================================
// Type Assertion Tests for Collections
// ============================================

@test(output = "6", type_holes = [[0, "int"]])
fn vec_iteration_type_check() {
    let vec = vec_new()
    vec_push(vec, 1)
    vec_push(vec, 2)
    vec_push(vec, 3)

    let sum = 0

    for x in vec {
        let x_typed: ? = x  // [0] - Should be int
        sum += x
    }

    print(sum)
}

@test(output = "6", type_holes = [[1, "int"]])
fn map_iteration_type_check() {
    let map = map_new()
    insert(map, "a", 1)
    insert(map, "b", 2)
    insert(map, "c", 3)

    let sum = 0

    for (key, value) in map {
        let value_typed: ? = value  // [1] - Should be int
        sum += value
    }

    print(sum)
}

@test(output = "6", type_holes = [[2, "int"]])
fn array_iteration_type_check() {
    let arr = [1, 2, 3]

    let sum = 0

    for x in arr {
        let x_typed: ? = x  // [2] - Should be int
        sum += x
    }

    print(sum)
}

// ============================================
// Additional Advanced Loop Tests
// ============================================

@test(output = "18")
fn nested_loops_with_continue_complex() {
    let outer = 0
    let result = 0

    loop {
        outer = outer + 1
        if outer >= 3 {
            break
        }

        let inner = 0
        loop {
            inner = inner + 1
            if inner == 2 {
                continue  // inner continue
            }
            result = result + inner
            if inner >= 3 {
                break
            }
        }

        if outer == 1 {
            continue  // outer continue
        }
        result = result + 10
    }

    print(result)
}

// ============================================
// More iteration cases
// ============================================

@test(output = "1\nadd\n2\nadd\n3\nskip 3\n4\nadd\n5\nskip 5\n6\nskip 3\n7\nadd\n8\nadd\n9\nskip 3\n10\n22")
fn debug_continue_multiple() {
    let sum = 0
    let i = 0

    loop {
        i = i + 1
        print(i)

        if i >= 10 {
            break
        }

        if i % 3 == 0 {
            print("skip 3")
            continue
        }

        if i % 5 == 0 {
            print("skip 5")
            continue
        }

        print("add")
        sum = sum + i
    }

    print(sum)
}

@test(output = "18")
fn continue_preserves_loop_variables() {
    let sum = 0
    let arr = [1, 2, 3, 4, 5, 6]

    // Manual indexing with a counter (1-based to match expected output)
    let index = 1
    for value in arr {
        if value % 2 == 0 {
            index = index + 1
            continue
        }
        sum = sum + index + value
        index = index + 1
    }

    print(sum)
}

@test(output = "6\n3")
fn test_vec_tuple_iteration_with_indices() {
    let vec = vec_new()
    vec_push(vec, 1)
    vec_push(vec, 2)
    vec_push(vec, 3)

    let sum = 0
    let index_sum = 0

    // Tuple iteration over [T] with enumerate yields (int, T) with 0-based indices
    for (i, x) in enumerate(vec) {
        sum += x
        index_sum += i
    }

    print(sum)
    print(index_sum)
}

@test(output = "60", type_holes = [[3, "int"]])
fn test_arena_tuple_iteration_type_check() {
    let arena = arena_new()
    insert(arena, 10)
    insert(arena, 20)
    insert(arena, 30)

    let sum = 0

    for (entity, value) in arena {
        let value_typed: ? = value    // [3] - Should be int
        sum += value
    }

    print(sum)
}
