// Loops: break and continue, compound while, nested loops in blocks, loop value model and exhausted for.

@test(output = "3\n2")
fn loop_nested() {
    let outer = 0
    let inner = 0

    loop {
        outer = outer + 1
        inner = 0

        loop {
            inner = inner + 1
            if inner == 2 {
                break
            }
        }

        if outer == 3 {
            break
        }
    }

    print(outer)
    print(inner)
}

@test(output = "6", type_holes = [[0, "int"]])
fn vec_iteration_type_check() {
    let vec = vec_new()
    vec_push(vec, 1)
    vec_push(vec, 2)
    vec_push(vec, 3)

    let sum = 0

    for x in vec {
        let x_typed: ? = x
        sum += x
    }

    print(sum)
}

@test(output = "6", type_holes = [[1, "int"]])
fn map_iteration_type_check() {
    let map = map_new()
    insert(map, "a", 1)
    insert(map, "b", 2)
    insert(map, "c", 3)

    let sum = 0

    for (key, value) in map {
        let value_typed: ? = value
        sum += value
    }

    print(sum)
}

@test(output = "18")
fn nested_loops_with_continue_complex() {
    let outer = 0
    let result = 0

    loop {
        outer = outer + 1
        if outer >= 3 {
            break
        }

        let inner = 0
        loop {
            inner = inner + 1
            if inner == 2 {
                continue
            }
            result = result + inner
            if inner >= 3 {
                break
            }
        }

        if outer == 1 {
            continue
        }
        result = result + 10
    }

    print(result)
}

@test(output = "1\nadd\n2\nadd\n3\nskip 3\n4\nadd\n5\nskip 5\n6\nskip 3\n7\nadd\n8\nadd\n9\nskip 3\n10\n22")
fn debug_continue_multiple() {
    let sum = 0
    let i = 0

    loop {
        i = i + 1
        print(i)

        if i >= 10 {
            break
        }

        if i % 3 == 0 {
            print("skip 3")
            continue
        }

        if i % 5 == 0 {
            print("skip 5")
            continue
        }

        print("add")
        sum = sum + i
    }

    print(sum)
}

@test(output = "60", type_holes = [[2, "int"]])
fn test_arena_tuple_iteration_type_check() {
    let arena = arena_new()
    insert(arena, 10)
    insert(arena, 20)
    insert(arena, 30)

    let sum = 0

    for (entity, value) in arena {
        let value_typed: ? = value
        sum += value
    }

    print(sum)
}

struct Selection { count: int }

fn select(c: Selection, capacity: int, budget: int) -> int {
    let slot = 0
    while slot < capacity && c.count < budget {
        if slot % 2 == 0 { c.count += 1 }
        slot += 1
    }
    return c.count
}

@test(output = "2\n2\n0\n0")
fn compound_while_loop_carried_field_loads_and_runs() {
    print("{select(Selection { count: 0 }, 8, 2)}")
    print("{select(Selection { count: 0 }, 3, 9)}")
    print("{select(Selection { count: 0 }, 0, 9)}")
    print("{select(Selection { count: 0 }, 8, 0)}")
}

struct Probe { count: int, checks: int }

fn below(p: Probe, budget: int) -> bool {
    p.checks += 1
    return p.count < budget
}

fn scan(p: Probe, capacity: int, budget: int) {
    for round in 0..2 {
        let slot = 0
        while slot < capacity && below(p, budget) {
            p.count += 1
            slot += 1
        }
    }
}

fn either(p: Probe, capacity: int, budget: int) {
    let slot = 0
    while slot < capacity || below(p, budget) {
        p.count += 1
        slot += 1
    }
}

@test(output = "0 0\n2 4\n6 6")
fn compound_while_preserves_short_circuit_effects_inside_for() {
    let p = Probe { count: 0, checks: 0 }
    scan(p, 0, 9)
    print("{p.count} {p.checks}")
    scan(p, 4, 2)
    print("{p.count} {p.checks}")
    either(p, 3, 6)
    print("{p.count} {p.checks}")
}

fn with_callback(callback: () -> ()) {
    callback()
}

@test
fn test_triple_nested_for_loops() {
    let sum = 0

    with_callback(() => {
        for i in 0..2 {
            for j in 0..2 {
                for k in 0..2 {
                    sum = sum + (i * 4 + j * 2 + k)
                }
            }
        }
    })

    assert(sum == 28, "Triple nested loops sum should be 28")
}

@test
fn test_nested_loops_with_continue() {
    let count = 0

    with_callback(() => {
        for i in 0..3 {
            for j in 0..3 {
                if j == 1 {
                    continue
                }
                count = count + 1
            }
        }
    })

    assert(count == 6, "Should skip j==1 each time")
}

@test
fn test_nested_loops_with_assignments() {
    let grid = [[0, 0, 0], [0, 0, 0], [0, 0, 0]]

    with_callback(() => {
        for y in 0..3 {
            for x in 0..3 {
                grid[y][x] = y * 3 + x
            }
        }
    })

    assert(grid[0][0] == 0, "grid[0][0] should be 0")
    assert(grid[1][1] == 4, "grid[1][1] should be 4")
    assert(grid[2][2] == 8, "grid[2][2] should be 8")
}

fn sum_while(n: int) -> int {
    let acc = 0
    let i = 0
    while i < n {
        acc = acc + i
        i = i + 1
    }
    return acc
}

fn sum_for(n: int) -> int {
    let acc = 0
    for i in 0..n {
        acc = acc + i
    }
    return acc
}

fn first_ge(n: int, target: int) -> int {
    let found = -1
    for i in 0..n {
        if i == target {
            found = i
            break
        }
    }
    return found
}

fn while_call_cond(n: int) -> int {
    let acc = 0
    let i = 0
    while i < abs(n) {
        acc = acc + i
        i = i + 1
    }
    return acc
}

@test(returns = 10)
fn t_sum_while() -> int { return sum_while(5) }

@test(returns = 10)
fn t_sum_for() -> int { return sum_for(5) }

@test(returns = 3)
fn t_first_ge() -> int { return first_ge(10, 3) }

@test(returns = 6)
fn t_while_call_cond() -> int { return while_call_cond(-4) }

fn scan_exhausted_for(xs: [int], limit: int) -> bool {
    let ok = true
    for i in 0..xs.len() {
        if xs[i] >= limit { ok = false; break }
    }
    ok
}

@test(output = "true false")
fn a_for_loop_that_runs_out_skips_the_code_its_break_runs() { print("{scan_exhausted_for([1, 2, 3], 10)} {scan_exhausted_for([1, 20, 3], 10)}") }
