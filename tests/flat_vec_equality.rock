// `==` over FlatVec<T> compares the first `len` elements by value. Without a
// FlatVec case, __op_eq's generic walk reached the NativeBuffer's cdata
// pointer and compared ADDRESSES, so two FlatVecs with equal contents were
// never equal (mag's UI bake cache could never hit and rebaked every frame).

value P2 { x: float, y: float }

fn pair(a: float, b: float, c: float, d: float, cap: int = 4) -> FlatVec<P2> {
    let fv: FlatVec<P2> = flat_vec_new(cap)
    fv.push(P2 { x: a, y: b })
    fv.push(P2 { x: c, y: d })
    return fv
}

@test
fn flat_vec_equal_contents_compare_equal() {
    assert_eq(pair(1.0, 2.0, 3.0, 4.0) == pair(1.0, 2.0, 3.0, 4.0), true)
}

@test
fn flat_vec_same_instance_is_equal() {
    let fv = pair(1.0, 2.0, 3.0, 4.0)
    assert_eq(fv == fv, true)
}

@test
fn flat_vec_different_element_is_unequal() {
    assert_eq(pair(1.0, 2.0, 3.0, 4.0) == pair(1.0, 2.0, 3.0, 5.0), false)
}

@test
fn flat_vec_different_len_is_unequal() {
    let longer = pair(1.0, 2.0, 3.0, 4.0)
    longer.push(P2 { x: 0.0, y: 0.0 })
    assert_eq(pair(1.0, 2.0, 3.0, 4.0) == longer, false)
}

@test
fn flat_vec_equality_ignores_capacity() {
    assert_eq(pair(1.0, 2.0, 3.0, 4.0, cap: 4) == pair(1.0, 2.0, 3.0, 4.0, cap: 32), true)
}

@test
fn flat_vec_equality_reads_only_live_elements() {
    let reused: FlatVec<P2> = flat_vec_new(4)
    reused.push(P2 { x: 9.0, y: 9.0 })
    reused.push(P2 { x: 9.0, y: 9.0 })
    reused.push(P2 { x: 9.0, y: 9.0 })
    reused.clear()
    reused.push(P2 { x: 1.0, y: 2.0 })
    reused.push(P2 { x: 3.0, y: 4.0 })
    assert_eq(reused == pair(1.0, 2.0, 3.0, 4.0), true)
}

@test
fn flat_vec_empty_vectors_are_equal() {
    let a: FlatVec<P2> = flat_vec_new(2)
    let b: FlatVec<P2> = flat_vec_new(8)
    assert_eq(a == b, true)
}
