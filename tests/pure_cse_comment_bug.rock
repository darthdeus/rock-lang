// A multi-line `//` comment between sibling pure-call statements
// silently broke PureCse — entries.len reset between calls. Verify
// this is fixed (or document the regression).

value V2 {
    x: float,
    y: float,
}

@nomangle inline(lua) fn __nb_alloc_V2(n: int) -> Ptr<V2> = 'return ffi.new("V2[?]", n)'

fn native_buffer_v2(n: int) -> NativeBuffer<V2> {
    return NativeBuffer { ptr: __nb_alloc_V2(n), len: n }
}

@pure fn make_v2(a: float) -> V2 {
    return V2 { x: a, y: a }
}

@test(output = "1\n1\n2\n2\n1\n1")
fn test_cse_with_comment_between() {
    let buf = native_buffer_v2(3)
    buf[0] = make_v2(1.0)
    // multi-line
    // comment
    // here
    buf[1] = make_v2(2.0)
    buf[2] = make_v2(1.0)

    let a = buf[0]; print("{a.x.floor()}"); print("{a.y.floor()}")
    let b = buf[1]; print("{b.x.floor()}"); print("{b.y.floor()}")
    let c = buf[2]; print("{c.x.floor()}"); print("{c.y.floor()}")
}
