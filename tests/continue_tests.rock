@test
fn test_simple_continue() {
    let results = vec_new()
    let i = 0
    while i < 10 {
        i = i + 1
        if i == 3 || i == 7 {
            continue
        }
        vec_push(results, i)
    }

    // Should have [1, 2, 4, 5, 6, 8, 9, 10]
    assert(vec_len(results) == 8, "Expected 8 elements after continue")
    assert(vec_get(results, 0) == 1, "First element should be 1")
    assert(vec_get(results, 1) == 2, "Second element should be 2")
    assert(vec_get(results, 2) == 4, "Third element should be 4 (skipped 3)")
    assert(vec_get(results, 3) == 5, "Fourth element should be 5")
    assert(vec_get(results, 4) == 6, "Fifth element should be 6")
    assert(vec_get(results, 5) == 8, "Sixth element should be 8 (skipped 7)")
    assert(vec_get(results, 6) == 9, "Seventh element should be 9")
    assert(vec_get(results, 7) == 10, "Eighth element should be 10")
}

@test
fn test_nested_loops_continue() {
    let results = vec_new()
    let i = 0
    while i < 3 {
        i = i + 1
        let j = 0
        while j < 3 {
            j = j + 1
            if j == 2 {
                continue  // Should only skip inner loop iteration
            }
            vec_push(results, i * 10 + j)
        }
    }

    // Should have [11, 13, 21, 23, 31, 33] (skipping j=2 cases)
    assert(vec_len(results) == 6, "Expected 6 elements")
    assert(vec_get(results, 0) == 11, "First element should be 11")
    assert(vec_get(results, 1) == 13, "Second element should be 13 (skipped 12)")
    assert(vec_get(results, 2) == 21, "Third element should be 21")
    assert(vec_get(results, 3) == 23, "Fourth element should be 23 (skipped 22)")
    assert(vec_get(results, 4) == 31, "Fifth element should be 31")
    assert(vec_get(results, 5) == 33, "Sixth element should be 33 (skipped 32)")
}

@test
fn test_continue_with_complex_conditions() {
    let results = vec_new()
    let i = 0
    while i < 20 {
        i = i + 1

        // Multiple conditions with continue
        if i % 2 == 0 {
            if i % 4 == 0 {
                continue  // Skip multiples of 4
            }
            vec_push(results, i)  // Keep multiples of 2 but not 4
        } else {
            if i % 3 == 0 {
                continue  // Skip multiples of 3 (odd)
            }
            vec_push(results, i)  // Keep odd numbers not divisible by 3
        }
    }

    // Expected: 1, 2, 5, 6, 7, 10, 11, 13, 14, 17, 18, 19
    assert(vec_len(results) == 12, "Expected 12 elements")
    assert(vec_get(results, 0) == 1, "Should include 1")
    assert(vec_get(results, 1) == 2, "Should include 2")
    assert(vec_get(results, 2) == 5, "Should include 5")
    assert(vec_get(results, 3) == 6, "Should include 6")
    assert(vec_get(results, 4) == 7, "Should include 7")
    assert(vec_get(results, 5) == 10, "Should include 10")
    assert(vec_get(results, 6) == 11, "Should include 11")
    assert(vec_get(results, 7) == 13, "Should include 13")
    assert(vec_get(results, 8) == 14, "Should include 14")
    assert(vec_get(results, 9) == 17, "Should include 17")
    assert(vec_get(results, 10) == 18, "Should include 18")
    assert(vec_get(results, 11) == 19, "Should include 19")
}

@test
fn test_continue_in_if_else() {
    let results = vec_new()
    let i = 0
    while i < 10 {
        i = i + 1

        if i <= 5 {
            if i % 2 == 0 {
                continue
            }
            vec_push(results, i)
        } else {
            if i % 2 == 1 {
                continue
            }
            vec_push(results, i)
        }
    }

    // Should have [1, 3, 5, 6, 8, 10] - odds <=5, evens >5
    assert(vec_len(results) == 6, "Expected 6 elements")
    assert(vec_get(results, 0) == 1, "Should include 1")
    assert(vec_get(results, 1) == 3, "Should include 3")
    assert(vec_get(results, 2) == 5, "Should include 5")
    assert(vec_get(results, 3) == 6, "Should include 6")
    assert(vec_get(results, 4) == 8, "Should include 8")
    assert(vec_get(results, 5) == 10, "Should include 10")
}

@test
fn test_continue_with_early_return() {
    let results = vec_new()
    let i = 0
    let limit = 20
    while i < limit {
        i = i + 1
        if i > 15 {
            break  // Instead of early return, use break
        }
        if i % 5 == 0 {
            continue  // Skip multiples of 5
        }
        vec_push(results, i)
    }
    // Should have [1, 2, 3, 4, 6, 7, 8, 9, 11, 12, 13, 14] (stops at 15)
    assert(vec_len(results) == 12, "Expected 12 elements")
    assert(vec_get(results, 0) == 1, "Should include 1")
    assert(vec_get(results, 3) == 4, "Should include 4")
    assert(vec_get(results, 4) == 6, "Should include 6 (skipped 5)")
    assert(vec_get(results, 8) == 11, "Should include 11 (skipped 10)")
    assert(vec_get(results, 11) == 14, "Should include 14")
}

@test
fn test_continue_with_break() {
    let results = vec_new()
    let i = 0
    while i < 20 {
        i = i + 1
        if i > 15 {
            break  // Exit loop completely
        }
        if i % 3 == 0 {
            continue  // Skip multiples of 3
        }
        vec_push(results, i)
        if vec_len(results) >= 8 {
            break  // Exit after collecting 8 items
        }
    }

    // Should have [1, 2, 4, 5, 7, 8, 10, 11] (first 8 non-multiples of 3)
    assert(vec_len(results) == 8, "Expected exactly 8 elements")
    assert(vec_get(results, 0) == 1, "Should include 1")
    assert(vec_get(results, 1) == 2, "Should include 2")
    assert(vec_get(results, 2) == 4, "Should include 4 (skipped 3)")
    assert(vec_get(results, 3) == 5, "Should include 5")
    assert(vec_get(results, 4) == 7, "Should include 7 (skipped 6)")
    assert(vec_get(results, 5) == 8, "Should include 8")
    assert(vec_get(results, 6) == 10, "Should include 10 (skipped 9)")
    assert(vec_get(results, 7) == 11, "Should include 11")
}

@test
fn test_deeply_nested_continue() {
    let results = vec_new()
    let i = 0
    while i < 3 {
        i = i + 1
        let j = 0
        while j < 3 {
            j = j + 1
            let k = 0
            while k < 3 {
                k = k + 1
                if k == 2 {
                    continue  // Only affects innermost loop
                }
                if j == 2 && k == 1 {
                    continue  // Skip specific case
                }
                vec_push(results, i * 100 + j * 10 + k)
            }
        }
    }

    // Should skip all k=2 cases and the j=2,k=1 cases
    assert(vec_len(results) == 15, "Expected 15 elements (18 total - 3 skipped for k=2,k=1)")
    assert(vec_get(results, 0) == 111, "Should include 111")
    assert(vec_get(results, 1) == 113, "Should include 113 (skipped 112)")
    // Verify a few key values to ensure correct skipping pattern
    let found_121 = false
    let found_221 = false
    let found_321 = false
    let i_check = 0
    while i_check < vec_len(results) {
        let val = vec_get(results, i_check)
        if val == 121 { found_121 = true }
        if val == 221 { found_221 = true }
        if val == 321 { found_321 = true }
        i_check = i_check + 1
    }
    assert(!found_121, "Should skip 121 (j=2, k=1)")
    assert(!found_221, "Should skip 221 (j=2, k=1)")
    assert(!found_321, "Should skip 321 (j=2, k=1)")
}

fn should_skip(n: int) -> bool {
    return n % 4 == 0 || n % 7 == 0
}

@test
fn test_continue_with_function_calls() {
    let results = vec_new()
    let i = 0
    while i < 20 {
        i = i + 1
        if should_skip(i) {
            continue
        }
        vec_push(results, i)
    }

    // Should skip 4, 7, 8, 12, 14, 16, 20
    assert(vec_len(results) == 13, "Expected 13 elements")

    // Verify some skipped values are not present
    let found_4 = false
    let found_7 = false
    let found_8 = false
    let found_14 = false
    let i_check = 0
    while i_check < vec_len(results) {
        let val = vec_get(results, i_check)
        if val == 4 { found_4 = true }
        if val == 7 { found_7 = true }
        if val == 8 { found_8 = true }
        if val == 14 { found_14 = true }
        i_check = i_check + 1
    }
    assert(!found_4, "Should skip 4")
    assert(!found_7, "Should skip 7")
    assert(!found_8, "Should skip 8")
    assert(!found_14, "Should skip 14")
}
