// `recv.f()` through a fn-typed field when exactly one free function `f` is
// also visible. The call is an indirect call through the field; the free
// function's resolvable name must not make lowering look for a direct callee.

global FIELD_CALL_HITS: int = 0

fn field_call_bump() {
    FIELD_CALL_HITS += 1
}

struct FieldCallButton {
    press: () -> (),
}

fn press(x: int, delay: float = 0) -> int {
    return x
}

fn field_call_buttons() -> [FieldCallButton] {
    return [FieldCallButton { press: field_call_bump }, FieldCallButton { press: field_call_bump }]
}

@test
fn an_indexed_unit_fn_field_call_runs_the_field() {
    FIELD_CALL_HITS = 0
    let buttons = field_call_buttons()
    for i in 0..buttons.len {
        buttons[i].press()
    }
    assert(FIELD_CALL_HITS == 2, "each button's field ran once")
    assert(press(7) == 7, "the free function is still callable")
}

@test
fn a_unit_fn_field_statement_call_runs_the_field() {
    FIELD_CALL_HITS = 0
    let button = FieldCallButton { press: field_call_bump }
    button.press()
    assert(FIELD_CALL_HITS == 1, "the field ran")
}
