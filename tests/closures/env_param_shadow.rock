// A capturing lambda's environment parameter must not shadow a user global
// named `e` read inside its body, directly or through a nested capture. A
// captured local named `e` still reads its own value.

global e: int = 5

fn make_direct(x: int) -> fn() -> int { return () => x + e }

@test(output = "6")
fn global_e_read_in_capturing_lambda() {
    let f = make_direct(1)
    print("{f()}")
}

fn make_nested(x: int) -> fn() -> fn() -> int {
    return () => {
        return () => x + e
    }
}

@test(output = "7")
fn global_e_read_in_nested_capture_body() {
    let f = make_nested(2)
    let g = f()
    print("{g()}")
}

fn make_local(x: int) -> fn() -> int {
    let e = x
    return () => e
}

@test(output = "3")
fn local_e_captured_normally() {
    let f = make_local(3)
    print("{f()}")
}
