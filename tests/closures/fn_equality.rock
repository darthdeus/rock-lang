// Equality and fn values.
//
// --- Null checks on optional fn values ---
//
// `==`/`!=` between fn values is a compile error (fn identity is not
// meaningful -- tests/errors/fn_identity_compare.rock.err), but comparing an
// OPTIONAL fn against the null literal is refinement and must keep working,
// including calling through the refined value.

fn add_one(x: int) -> int { return x + 1 }

@test(output = "yes\n6")
fn test_optional_fn_null_check_refines() {
    let f: (fn(int) -> int)? = add_one
    if f != null {
        print("yes")
        print("{f(5)}")
    }
}

@test(output = "none")
fn test_optional_fn_eq_null() {
    let f: (fn(int) -> int)? = null
    if f == null {
        print("none")
    }
}

// --- Structs with fn-typed fields ---
//
// `==` on a struct with a fn-typed field stays legal, but a closure env record
// compares as an opaque LEAF by IDENTITY (rawequal) -- never by walking its
// capture fields. A record is a callable value, not a data table, so it is the
// one leaf class that compares by identity (same correction step 8 made for
// inspect + serialization). Regular struct/enum/vec structural eq is unchanged.

struct CbHolder { cb: fn(int) -> int, tag: int }

fn make(n: int) -> CbHolder { return CbHolder { cb: (x) => x + n, tag: 1 } }

// 1. Same closure instance stored twice compares equal (identity leaf: the same
//    record IS the same record).
@test(output = "true")
fn test_same_instance_equal() {
    let h = make(5)
    let a = CbHolder { cb: h.cb, tag: 7 }
    let b = CbHolder { cb: h.cb, tag: 7 }
    print(a == b)
}

// 2. Separate creations with equal captures are NOT equal -- distinct closure
//    instances, compared by identity.
@test(output = "false")
fn test_separate_creations_not_equal() {
    print(make(5) == make(5))
}

// 3. Boxed mutable capture, separate creations -> not equal (distinct boxes,
//    distinct records; identity leaf never walks into the box).
struct Counter { bump: fn() -> int, tag: int }
fn make_counter() -> Counter {
    let n = 0
    return Counter { bump: () => { n = n + 1; return n }, tag: 1 }
}
@test(output = "false")
fn test_boxed_capture_not_equal() {
    print(make_counter() == make_counter())
}

// 4. Record nested deeper (struct -> vec -> struct -> fn field): the identity
//    leaf rule still applies through the structural walk.
struct Inner { cb: fn(int) -> int }
struct Outer { rows: [Inner], tag: int }
fn make_outer(n: int) -> Outer {
    return Outer { rows: [Inner { cb: (x) => x + n }], tag: 1 }
}
@test(output = "false")
fn test_nested_record_not_equal() {
    print(make_outer(5) == make_outer(5))
}
@test(output = "true")
fn test_nested_same_instance_equal() {
    let o = make_outer(5)
    let a = Outer { rows: o.rows, tag: 9 }
    let b = Outer { rows: o.rows, tag: 9 }
    print(a == b)
}

// 5. A capture-free lambda field from the SAME creation site compares equal:
//    P3 shares one hoisted fn value per site, so two references to it are the
//    same value. This is decided P3 semantics, not a bug.
struct CfHolder { cb: fn() -> int, tag: int }
fn make_capfree() -> CfHolder { return CfHolder { cb: () => 42, tag: 1 } }
@test(output = "true")
fn test_capfree_same_site_equal() {
    print(make_capfree() == make_capfree())
}

// --- Generic `==` wrappers ---
// Comparing fn values through a generic wrapper is a compile error
// (tests/errors/fn_identity_generic.rock.err). The same wrapper over non-fn
// types still compiles and runs: the call-site check fires only when a
// `==`-compared type param resolves to a fn type.

fn same<T>(a: T, b: T) -> bool { return a == b }

struct P { x: int }
value V { n: int }

@test(output = "true")
fn test_same_int_through_generic() {
    print("{same(1, 1)}")
}

@test(output = "false")
fn test_same_string_through_generic() {
    print("{same(\"a\", \"b\")}")
}

@test(output = "true")
fn test_same_struct_through_generic() {
    // the point is only that the generic compiles for a struct type param;
    // structs compare by identity, so the same binding compared to itself is true.
    let p = P { x: 1 }
    print("{same(p, p)}")
}

@test(output = "true")
fn test_same_value_through_generic() {
    let a = V { n: 3 }
    let b = V { n: 3 }
    print("{same(a, b)}")
}
