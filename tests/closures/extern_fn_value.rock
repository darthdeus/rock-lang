// A bare `extern fn` declares a name that ALREADY EXISTS as a Lua global (see
// `is_root` in skull/src/mir_emit.rs) -- it does not emit an `ffi.cdef`, so a
// libc symbol like `floorf` is nil at every reference site, a direct call
// included. `extern(ffi, "lib") fn` is the other form: it emits a wrapper
// binding `lib.<name>`. Both are reachable as fn values, and the globals below
// are the control that says so -- a global initializer is not a special case.

extern fn rawequal(a: int, b: int) -> bool

extern(ffi, "string") fn rep(s: string, n: int) -> string

value P { x: float, y: float }

fn take_p(p: P) -> float { return p.x + p.y }

inline(lua) fn twice(a: float) -> float = """
    return a * 2.0
"""

struct Holder { f: (string, int) -> string }

global EQ: (int, int) -> bool = rawequal
global REP: (string, int) -> string = rep
global REPS: [(string, int) -> string] = [rep]
global HELD: Holder = Holder { f: rep }
global TAKE_P: (P) -> float = take_p
global TWICE: (float) -> float = twice

fn apply(f: (string, int) -> string, s: string, n: int) -> string { return f(s, n) }

@test(backends = "lua") fn bare_extern_direct() { assert(rawequal(7, 7)) }
@test(backends = "lua") fn bare_extern_in_local() { let g = rawequal; assert(g(7, 7)) }
@test(backends = "lua") fn bare_extern_via_global() { let g = EQ; assert(g(7, 7)) }

@test(backends = "lua") fn ffi_extern_direct() { assert_eq(rep("ab", 2), "abab") }
@test(backends = "lua") fn ffi_extern_in_local() { let g = rep; assert_eq(g("ab", 2), "abab") }
@test(backends = "lua") fn ffi_extern_as_arg() { assert_eq(apply(rep, "ab", 2), "abab") }
@test(backends = "lua") fn ffi_extern_via_global() { let g = REP; assert_eq(g("ab", 2), "abab") }
@test(backends = "lua") fn ffi_extern_via_global_vec() { let g = REPS[0]; assert_eq(g("ab", 2), "abab") }
@test(backends = "lua") fn ffi_extern_via_struct_field() { let g = HELD.f; assert_eq(g("ab", 2), "abab") }

@test fn value_param_fn_via_global() { let g = TAKE_P; assert_eq(g(P { x: 1.0, y: 2.0 }), 3.0) }
@test fn inline_lua_fn_via_global() { let g = TWICE; assert_eq(g(3.0), 6.0) }
