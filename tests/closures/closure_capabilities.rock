// Closure capabilities on both backends: indirect calls through fn-typed
// params, inline arrows, lexical capture by reference, captured-cell
// mutation, re-entrant calls, returned closures and branches in lambda bodies.

fn apply(f: (int) -> int, x: int) -> int { f(x) }
fn twice(f: (int) -> int, x: int) -> int { f(x) + f(x) }
fn adder(n: int) -> (int) -> int { (x: int) => x + n }

@test(output = "6\n17\n25\n13\n20")
fn test_calls_and_captures() {
    print(apply(y => y + 1, 5))

    let n = 7
    let g = (x: int) => x + n
    print(g(10))

    let sq = (x: int) => x * x
    print(sq(3) + sq(4))

    let add10 = adder(10)
    print(add10(3))

    let base = 4
    print(twice(x => x + base, 6))
}

@test(output = "7")
fn test_capture_mutation() {
    let sum = 0
    let add = (x: int) => { sum = sum + x }
    add(3)
    add(4)
    print(sum)
}

@test(output = "1\n-1")
fn test_lambda_branch() {
    let sign = (x: int) => if x >= 0 { 1 } else { 0 - 1 }
    print(sign(42))
    print(sign(-3))
}
