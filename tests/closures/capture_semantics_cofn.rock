// Capture behavior inside coroutine bodies. Non-coroutine sibling:
// closures/capture_semantics.rock.

enum CEv { Tick(int) }

global CFS: [fn() -> int] = []

global R_NAMED_NESTED: int = -1

co fn worker_named_nested() -> Coroutine<CEv> {
    fn answer() -> int { return 42 }
    R_NAMED_NESTED = answer()
    yield CEv::Tick(1)
}

@test(output = "R=42")
fn test_cofn_named_nested_function() {
    let c = worker_named_nested()
    let _ = c.resume()
    print("R={R_NAMED_NESTED}")
}

// Read-only loop captures snapshot each iteration, even when a yield separates
// closure creation. Both closures created in one iteration see the same value.
co fn push_around_yield() -> Coroutine<CEv> {
    for i in 0..3 {
        CFS.push(() => i)
        yield CEv::Tick(i)
        CFS.push(() => i)
    }
}

@test(output = "0\n0\n1\n1\n2\n2")
fn test_cofn_counter_capture_across_yield() {
    let c = push_around_yield()
    let _ = c.resume()
    let _ = c.resume()
    let _ = c.resume()
    let _ = c.resume()
    for f in CFS { print(f()) }
}

// Lambda parameters and locals belong to the lambda; captured coroutine state
// is read through its closure environment.

global R_PARAM_CAP: int = -1

// The parameter is passed as an argument, while counter is captured state.
co fn worker_param_capture() -> Coroutine<CEv> {
    let counter = 100
    let add = (n: int) => n + counter
    R_PARAM_CAP = add(5)
    yield CEv::Tick(1)
}

@test(output = "R=105")
fn test_cofn_param_plus_capture() {
    let c = worker_param_capture()
    let _ = c.resume()
    print("R={R_PARAM_CAP}")
}

global R_OWN_LOCAL: int = -1

// The parameter and lambda-local y are not coroutine state.
co fn worker_own_local() -> Coroutine<CEv> {
    let f = (n: int) => { let y = n * 2; y }
    R_OWN_LOCAL = f(21)
    yield CEv::Tick(1)
}

@test(output = "R=42")
fn test_cofn_lambda_own_local_with_param() {
    let c = worker_own_local()
    let _ = c.resume()
    print("R={R_OWN_LOCAL}")
}

global R_NESTED: int = -1

// The nested lambda captures the outer parameter and coroutine local base.
co fn worker_nested() -> Coroutine<CEv> {
    let base = 10
    let outer = (n: int) => {
        let inner = () => n + base
        inner()
    }
    R_NESTED = outer(5)
    yield CEv::Tick(1)
}

@test(output = "R=15")
fn test_cofn_nested_lambda_captures() {
    let c = worker_nested()
    let _ = c.resume()
    print("R={R_NESTED}")
}

global R_MAP: int = -1

// The top-level helper keeps the iterator chain outside the coroutine body.
fn map_ints(xs: [int], f: fn(int) -> int) -> [int] {
    return xs.iter().map(f).collect()
}

// The placeholder lambda receives each element and doubles it.
co fn worker_map() -> Coroutine<CEv> {
    let xs = [1, 2, 3]
    let ys = map_ints(xs, _ * 2)
    R_MAP = ys[0] + ys[1] + ys[2]
    yield CEv::Tick(1)
}

@test(output = "R=12")
fn test_cofn_placeholder_map() {
    let c = worker_map()
    let _ = c.resume()
    print("R={R_MAP}")
}

// No-parameter lambdas share captured coroutine state. Capture-free lambdas
// need no captured state.

global R_MUT_A: int = -1
global R_MUT_B: int = -1

// A captured mutable local is shared across calls and across a yield.
co fn worker_mutate() -> Coroutine<CEv> {
    let x = 1
    let bump = () => { x = x + 10 }
    bump()
    R_MUT_A = x
    yield CEv::Tick(1)
    bump()
    R_MUT_B = x
    yield CEv::Tick(2)
}

@test(output = "11 21")
fn test_cofn_mutation_through_capture_across_yield() {
    let c = worker_mutate()
    let _ = c.resume()
    let _ = c.resume()
    print("{R_MUT_A} {R_MUT_B}")
}

global R_STORED: int = -1

// A closure created before suspension retains access to coroutine state after
// resume.
co fn worker_stored() -> Coroutine<CEv> {
    let v = 7
    let f = () => v
    yield CEv::Tick(1)
    R_STORED = f()
}

@test(output = "7")
fn test_cofn_lambda_stored_across_yield_called_after_resume() {
    let c = worker_stored()
    let _ = c.resume()
    let _ = c.resume()
    print("{R_STORED}")
}

global R_FREE: int = -1

// A capture-free lambda can be called inside a coroutine body.
co fn worker_free() -> Coroutine<CEv> {
    let f = () => 42
    R_FREE = f()
    yield CEv::Tick(1)
}

@test(output = "42")
fn test_cofn_capture_free_lambda() {
    let c = worker_free()
    let _ = c.resume()
    print("{R_FREE}")
}

global WFS: [fn() -> int] = []

// Closures that write the loop binding share it, so successive calls observe
// each preceding write.
co fn worker_writes_binding() -> Coroutine<CEv> {
    for i in 0..3 {
        WFS.push(() => { i = i + 1; i })
    }
    yield CEv::Tick(1)
}

@test(output = "4\n5\n6")
fn test_cofn_lambda_writes_loop_binding_shares_mutable_binding() {
    let c = worker_writes_binding()
    let _ = c.resume()
    for f in WFS { print(f()) }
}

// Hook and defer behavior.

global HLOG: [string] = []

// The hook body uses a local binding when the coroutine is killed.
co fn hook_local_worker() -> Coroutine<CEv> {
    on_killed {
        let msg = "killed-hook"
        HLOG.push(msg)
    }
    yield CEv::Tick(1)
    yield CEv::Tick(2)
}

// The defer reads coroutine state when the coroutine is killed.
co fn defer_frame_state_worker() -> Coroutine<CEv> {
    let state = 5
    defer { HLOG.push("state={state}") }
    yield CEv::Tick(1)
    yield CEv::Tick(2)
}

@test(output = "killed-hook\nstate=5")
fn test_cofn_hook_local_and_defer_frame_state() {
    HLOG = []
    let c = hook_local_worker()
    let _ = c.resume()
    kill(c)
    let d = defer_frame_state_worker()
    let _ = d.resume()
    kill(d)
    for s in HLOG { print(s) }
}

// A lambda has its own scope; returning from it leaves the coroutine's defer
// pending until coroutine completion. Plain-function sibling:
// control_flow/defer.rock.

global CR_MIS: int = 0
global CR_SUM: int = 0

// Calling the lambda does not run the enclosing defer; it runs once at
// coroutine completion.
co fn cofn_defer_then_lambda() -> Coroutine<CEv> {
    defer { CR_MIS = CR_MIS + 1 }
    let f = () => 42
    CR_SUM = f() + f()
    yield CEv::Tick(1)
}

@test(output = "sum=84 R=1")
fn test_cofn_defer_then_lambda_runs_defer_once() {
    let c = cofn_defer_then_lambda()
    let _ = c.resume()
    let _ = c.resume()
    print("sum={CR_SUM} R={CR_MIS}")
}

global RC_DEFER_LAMBDA: int = -1

// A parameterized lambda can be created and called from a terminal defer.
co fn cofn_lambda_in_defer_body() -> Coroutine<CEv> {
    defer {
        let add = (n: int) => n + 1
        RC_DEFER_LAMBDA = add(41)
    }
    yield CEv::Tick(1)
}

@test(output = "RC=42")
fn test_cofn_lambda_in_defer_body_no_crash() {
    let c = cofn_lambda_in_defer_body()
    let _ = c.resume()
    let _ = c.resume()
    print("RC={RC_DEFER_LAMBDA}")
}
