// P0: runtime semantic contract for
// lambdas inside `co fn` bodies, written BEFORE the frame-lambda hoist (P1)
// so the swap from inline-closure-over-frame-fields to env records is held
// to these outputs. Non-co siblings: closures/capture_semantics.rock.

enum CEv { Tick(int) }

global CFS: [fn() -> int] = []

global R_NAMED_NESTED: int = -1

co fn worker_named_nested() -> Coroutine<CEv> {
    fn answer() -> int { return 42 }
    R_NAMED_NESTED = answer()
    yield CEv::Tick(1)
}

@test(output = "R=42")
fn test_cofn_named_nested_function() {
    let c = worker_named_nested()
    let _ = c.resume()
    print("R={R_NAMED_NESTED}")
}

// Yield-inside-the-loop per-iteration regression guard (D4(b)):
// a captured loop binding snapshots
// per-iteration at record creation -- the counter is a frame field (it
// survives the suspension) but the snapshot is taken eagerly, so the yield
// between the two pushes changes nothing: both pushes of one iteration
// capture that iteration's value. Same rule as the non-co
// test_range_counter_capture_per_iteration; a via-`s` (call-time) capture
// would regress this to the counter's exit value ("3" x6).
co fn push_around_yield() -> Coroutine<CEv> {
    for i in 0..3 {
        CFS.push(() => i)
        yield CEv::Tick(i)
        CFS.push(() => i)
    }
}

@test(output = "0\n0\n1\n1\n2\n2")
fn test_cofn_counter_capture_across_yield_sentinel() {
    let c = push_around_yield()
    let _ = c.resume()
    let _ = c.resume()
    let _ = c.resume()
    let _ = c.resume()
    for f in CFS { print(f()) }
}

// ---- Lambdas WITH params: the param is the argument, never a frame field ----
// A hoisted co-fn lambda's own params/locals are plain locals of its hoisted
// body; only captured co-fn state reads through the frame (via the record's `s`
// capture). Formerly sentinels pinning the nil-param death (the transform swept
// param cells into the frame; __resume's pcall swallowed the error and the -1
// default never updated).

global R_PARAM_CAP: int = -1

// Case 1: param + captured FRAME cell -- `(n) => n + counter` where counter is a
// co-fn local read through `s` at call time.
co fn worker_param_capture() -> Coroutine<CEv> {
    let counter = 100
    let add = (n: int) => n + counter
    R_PARAM_CAP = add(5)
    yield CEv::Tick(1)
}

@test(output = "R=105")
fn test_cofn_param_plus_capture_broken_sentinel() {
    let c = worker_param_capture()
    let _ = c.resume()
    print("R={R_PARAM_CAP}")
}

global R_OWN_LOCAL: int = -1

// Case 2: lambda-own local behind a param -- `(n) => { let y = n * 2; y }`; both
// the param and `y` are locals of the hoisted body, not frame fields.
co fn worker_own_local() -> Coroutine<CEv> {
    let f = (n: int) => { let y = n * 2; y }
    R_OWN_LOCAL = f(21)
    yield CEv::Tick(1)
}

@test(output = "R=42")
fn test_cofn_lambda_own_local_with_param_broken_sentinel() {
    let c = worker_own_local()
    let _ = c.resume()
    print("R={R_OWN_LOCAL}")
}

global R_NESTED: int = -1

// Case 3: nested lambda -- inner captures the OUTER lambda's param `n` (a
// by-value env field) AND the frame cell `base` (via `s`, redirected through the
// outer's env: `__rock_env.c<S>.c<base>`).
co fn worker_nested() -> Coroutine<CEv> {
    let base = 10
    let outer = (n: int) => {
        let inner = () => n + base
        inner()
    }
    R_NESTED = outer(5)
    yield CEv::Tick(1)
}

@test(output = "R=15")
fn test_cofn_nested_lambda_broken_sentinel() {
    let c = worker_nested()
    let _ = c.resume()
    print("R={R_NESTED}")
}

global R_MAP: int = -1

// Iterator chains inside co fn bodies silently drop the co fn from emission
// (skull bug), so the chain lives in this top-level HOF.
fn map_ints(xs: [int], f: fn(int) -> int) -> [int] {
    return xs.iter().map(f).collect()
}

// Case 7: HOF with a placeholder lambda -- `map_ints(xs, _ * 2)`. `_ * 2`
// desugars to a lambda WITH a param (the everyday shape); its param is a plain
// local of the hoisted body, so the HOF's per-element call binds correctly.
co fn worker_map() -> Coroutine<CEv> {
    let xs = [1, 2, 3]
    let ys = map_ints(xs, _ * 2)
    R_MAP = ys[0] + ys[1] + ys[2]
    yield CEv::Tick(1)
}

@test(output = "R=12")
fn test_cofn_placeholder_map_broken_sentinel() {
    let c = worker_map()
    let _ = c.resume()
    print("R={R_MAP}")
}

// ---- CORRECT today: no-param captures and capture-free lambdas ----
// A lambda with no params reads/writes ONLY frame fields, which IS the shared
// coroutine-state semantics, so these already behave. They are the regression
// floor for P1: the hoist must not break them.

global R_MUT_A: int = -1
global R_MUT_B: int = -1

// Case 4: mutation through a no-param capture, observed after the call AND across
// a yield boundary -- frame-field read/write is the shared mechanism.
co fn worker_mutate() -> Coroutine<CEv> {
    let x = 1
    let bump = () => { x = x + 10 }
    bump()
    R_MUT_A = x
    yield CEv::Tick(1)
    bump()
    R_MUT_B = x
    yield CEv::Tick(2)
}

@test(output = "11 21")
fn test_cofn_mutation_through_capture_across_yield() {
    let c = worker_mutate()
    let _ = c.resume()
    let _ = c.resume()
    print("{R_MUT_A} {R_MUT_B}")
}

global R_STORED: int = -1

// Case 5: a capture-only lambda created BEFORE a yield, stored in a co-fn local,
// called AFTER resume -- the record (and its captured frame field) survives
// suspension (the record itself lives in a frame field).
co fn worker_stored() -> Coroutine<CEv> {
    let v = 7
    let f = () => v
    yield CEv::Tick(1)
    R_STORED = f()
}

@test(output = "7")
fn test_cofn_lambda_stored_across_yield_called_after_resume() {
    let c = worker_stored()
    let _ = c.resume()
    let _ = c.resume()
    print("{R_STORED}")
}

global R_FREE: int = -1

// Case 6: a capture-free `() => 42` created and called inside a co fn hoists to
// a bare top-level name (zero alloc, no record).
co fn worker_free() -> Coroutine<CEv> {
    let f = () => 42
    R_FREE = f()
    yield CEv::Tick(1)
}

@test(output = "42")
fn test_cofn_capture_free_lambda() {
    let c = worker_free()
    let _ = c.resume()
    print("{R_FREE}")
}

global WFS: [fn() -> int] = []

// Case 9: the R2 edge under a frame -- a lambda that WRITES the loop binding
// (`() => { i = i + 1; i }`). R2 says a WRITTEN
// loop binding is one shared box, NOT a per-iteration snapshot. Today all three
// closures share the frame's `i` cell (exit value 3), so successive calls read
// 4, 5, 6. This is the TARGET behavior too: under D4(b) a written loop binding
// stays SHARED via `s` (only READ-ONLY loop bindings snapshot per-iteration --
// contrast test_cofn_counter_capture_across_yield_sentinel). Normal regression
// pin, not a sentinel: the value must stay "4\n5\n6" after P1 + D4(b).
co fn worker_writes_binding() -> Coroutine<CEv> {
    for i in 0..3 {
        WFS.push(() => { i = i + 1; i })
    }
    yield CEv::Tick(1)
}

@test(output = "4\n5\n6")
fn test_cofn_lambda_writes_loop_binding_shares_via_s() {
    let c = worker_writes_binding()
    let _ = c.resume()
    for f in WFS { print(f()) }
}

// ---- CORRECT today: hook / defer regression pins (guard D1/D5) ----

global HLOG: [string] = []

// Case 10a: an on_killed hook whose body has its own `let`. Hooks are ALREADY
// hoisted (mechanism 3, emit_coroutine); D5 rationalizes them without reshaping.
// This pins that a hook-local binding still emits/runs correctly.
co fn hook_local_worker() -> Coroutine<CEv> {
    on_killed {
        let msg = "killed-hook"
        HLOG.push(msg)
    }
    yield CEv::Tick(1)
    yield CEv::Tick(2)
}

// Case 10b: a defer touching frame state (`state` is a co-fn local). Terminal
// defers fire on kill(); the interpolation reads the frame field. Guards D1/D5.
co fn defer_frame_state_worker() -> Coroutine<CEv> {
    let state = 5
    defer { HLOG.push("state={state}") }
    yield CEv::Tick(1)
    yield CEv::Tick(2)
}

@test(output = "killed-hook\nstate=5")
fn test_cofn_hook_local_and_defer_frame_state() {
    HLOG = []
    let c = hook_local_worker()
    let _ = c.resume()
    kill(c)
    let d = defer_frame_state_worker()
    let _ = d.resume()
    kill(d)
    for s in HLOG { print(s) }
}

// ---- Defer + lambda in a co fn (the fixed defer-lowering bug) ----
// A lambda body is its own fn scope; its `return` must run only the lambda's
// own defers, never the enclosing co fn's still-pending ones. Pre-fix the
// shared `defers` stack in lower.rs spliced the co-fn defer into the lambda
// (miscompile) and, when the defer body created the lambda, recursed forever
// during lowering (compiler stack overflow). Plain-fn siblings: control_flow/defer_lambda.rock.

global CR_MIS: int = 0
global CR_SUM: int = 0

// Miscompile pin: a lambda created after a `defer` in the co-fn body. Pre-fix
// each `f()` ran the spliced co-fn defer, so CR_MIS == 3 (two calls + terminal);
// now the defer runs once at terminal exit.
co fn cofn_defer_then_lambda() -> Coroutine<CEv> {
    defer { CR_MIS = CR_MIS + 1 }
    let f = () => 42
    CR_SUM = f() + f()
    yield CEv::Tick(1)
}

@test(output = "sum=84 R=1")
fn test_cofn_defer_then_lambda_runs_defer_once() {
    let c = cofn_defer_then_lambda()
    let _ = c.resume()
    let _ = c.resume()
    print("sum={CR_SUM} R={CR_MIS}")
}

global RC_DEFER_LAMBDA: int = -1

// D5's original shape: a PARAM lambda INSIDE a defer body in a co fn -- pre-fix
// a compiler stack overflow. Observed via the -1-default global (P0 pattern):
// the terminal defer fires on the co fn's completion, so a stuck-at-(-1) read
// would mean the defer never ran.
co fn cofn_lambda_in_defer_body() -> Coroutine<CEv> {
    defer {
        let add = (n: int) => n + 1
        RC_DEFER_LAMBDA = add(41)
    }
    yield CEv::Tick(1)
}

@test(output = "RC=42")
fn test_cofn_lambda_in_defer_body_no_crash() {
    let c = cofn_lambda_in_defer_body()
    let _ = c.resume()
    let _ = c.resume()
    print("RC={RC_DEFER_LAMBDA}")
}
