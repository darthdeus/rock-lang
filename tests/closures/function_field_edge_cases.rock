// Test edge cases for function field calls

// Generic struct with function field
struct Container<T> {
    data: T,
    processor: fn(T) -> T,
}

fn double_int(x: int) -> int {
    return x * 2
}

@test fn test_generic_struct_function_field() {
    let container = Container {
        data: 5,
        processor: double_int,
    }
    
    // This should work with generic structs
    assert_eq(container.processor(10), 20)
}

// Nullable struct with function field
struct CallbackHolder {
    callback: fn() -> string,
}

fn get_message() -> string {
    return "hello"
}

@test fn test_nullable_struct_function_field() {
    let holder_value = CallbackHolder {
        callback: get_message
    }
    let holder: CallbackHolder? = holder_value
    
    // This should work with nullable types
    if holder != null {
        assert_eq(holder.unwrap().callback(), "hello")
    }
}

// Nested generic structs
struct Wrapper<T> {
    inner: Container<T>,
}

@test fn test_nested_generic_function_field() {
    let wrapper = Wrapper {
        inner: Container {
            data: 3,
            processor: double_int,
        }
    }
    
    // This should work with nested generic structs
    assert_eq(wrapper.inner.processor(7), 14)
}

// Multiple function fields
struct MultiFunc {
    f1: fn() -> int,
    f2: fn(int) -> int,
    f3: fn(int, int) -> int,
}

fn ret_one() -> int { return 1 }
fn add_one(x: int) -> int { return x + 1 }
fn add_two(x: int, y: int) -> int { return x + y }

@test fn test_multiple_function_fields() {
    let multi = MultiFunc {
        f1: ret_one,
        f2: add_one,
        f3: add_two,
    }
    
    assert_eq(multi.f1(), 1)
    assert_eq(multi.f2(5), 6)
    assert_eq(multi.f3(3, 4), 7)
}

// Function field accessing another field (to ensure we don't break normal field access)
struct DataHolder {
    value: int,
    transformer: fn(int) -> int,
}

fn triple(x: int) -> int {
    return x * 3
}

@test fn test_function_field_with_data_field() {
    let holder = DataHolder {
        value: 7,
        transformer: triple,
    }
    
    // Both field accesses should work
    assert_eq(holder.value, 7)
    assert_eq(holder.transformer(4), 12)
}