// Adversarial tests: functions, lambdas, blocks, tuples

fn factorial(n: int) -> int {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

fn is_even(n: int) -> bool {
    if n == 0 { return true }
    return is_odd(n - 1)
}

fn is_odd(n: int) -> bool {
    if n == 0 { return false }
    return is_even(n - 1)
}

@test(output = "120\ntrue false")
fn test_recursion_and_mutual_recursion() {
    print(factorial(5))
    print("{is_even(10)} {is_even(11)}")
}

fn describe(x: int) -> string {
    return "int: {x}"
}

fn describe(x: string) -> string {
    return "string: {x}"
}

fn describe(x: bool) -> string {
    if x { return "bool: true" }
    return "bool: false"
}

@test(output = "int: 42\nstring: hello\nbool: true")
fn test_overloads() {
    print(describe(42))
    print(describe("hello"))
    print(describe(true))
}

fn greet(name: string, greeting: string = "Hello") -> string {
    return "{greeting}, {name}!"
}

@test(output = "Hello, World!\nHi, World!")
fn test_default_param() {
    print(greet("World"))
    print(greet("World", "Hi"))
}

@test(output = "0 1 2")
fn test_lambda_capture_loop_var() {
    let funcs: [fn() -> int] = []
    let i = 0
    while i < 3 {
        let captured = i
        funcs.push(() => captured)
        i = i + 1
    }
    let out = ""
    let first = true
    for f in funcs {
        if !first { out = out + " " }
        first = false
        out = out + "{f()}"
    }
    print(out)
}

struct Item {
    name: string,
    value: int,
}

@test(output = "2")
fn test_placeholder_lambda() {
    let items = [
        Item { name: "a", value: 10 },
        Item { name: "b", value: 20 },
        Item { name: "c", value: 5 },
    ]
    let big_items = items.iter().filter(_.value > 8).collect()
    print(big_items.len)
}

@test(output = "positive\nnegative\nzero")
fn test_lambda_branching() {
    let classify = (x: int) => {
        if x > 0 { return "positive" }
        if x < 0 { return "negative" }
        return "zero"
    }
    print(classify(5))
    print(classify(-5))
    print(classify(0))
}

@test(output = "10")
fn test_nested_block() {
    let x = {
        let a = {
            let b = 5
            b * 2
        }
        a
    }
    print(x)
}

fn double(x: int) -> int {
    return x * 2
}

@test(output = "10")
fn test_function_as_annotated_value() {
    let f: fn(int) -> int = double
    print(f(5))
}

fn divmod(a: int, b: int) -> (int, int) {
    return (a ./ b, a % b)
}

@test(output = "3 1\n1 2 3")
fn test_tuple_return_and_destructure() {
    let (q, r) = divmod(10, 3)
    print("{q} {r}")
    let t = (1, 2, 3)
    let (a, b, c) = t
    print("{a} {b} {c}")
}
