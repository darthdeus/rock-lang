// A lambda called once where it is created is spliced into its caller. These
// pin that the splice keeps what the closure would have observed.

@test
fn capture_written_after_creation_is_observed_at_the_call() {
    let k = 1
    let read = () => k
    k = 5
    assert_eq(read(), 5)
}

@test
fn loop_binding_capture_reads_its_own_iteration() {
    let seen: [int] = []
    for i in 0..4 {
        let twice = () => i * 2
        vec_push(seen, twice())
    }
    assert_eq(seen, [0, 2, 4, 6])
}

@test
fn closure_from_an_earlier_iteration_keeps_its_snapshot() {
    let first: fn() -> int = () => -1
    let calls: [int] = []
    for i in 0..3 {
        let here = () => i
        if i == 0 { first = here }
        vec_push(calls, first())
    }
    assert_eq(calls, [0, 0, 0])
}

@test
fn early_returns_in_a_multi_block_body() {
    let classify = (x: int) => {
        if x < 0 { return "neg" }
        if x == 0 { return "zero" }
        return "pos"
    }
    assert_eq(classify(-3), "neg")
    let z = (x: int) => {
        if x < 0 { return "neg" }
        if x == 0 { return "zero" }
        return "pos"
    }
    assert_eq(z(0), "zero")
}

@test
fn unit_body_mutates_its_capture() {
    let total = 0
    let add = (x: int) => { total = total + x }
    add(7)
    assert_eq(total, 7)
}

@test
fn tuple_result_reaches_both_destinations() {
    let split = (x: int) => (x + 1, x * 2)
    let (next, double) = split(42)
    assert_eq(next, 43)
    assert_eq(double, 84)
}

@test
fn chain_predicates_capture_loop_state() {
    let xs = [3, 8, 1, 9, 4]
    let hits: [int] = []
    for limit in [2, 5, 10] {
        vec_push(hits, xs.iter().filter(x => x < limit).count())
    }
    assert_eq(hits, [1, 3, 5])
    let owners = [1, 2, 3]
    let id = 2
    assert_true(owners.any(_ == id))
    assert_eq(xs.iter().map(x => x * id).find(x => x > 10), 16)
}
