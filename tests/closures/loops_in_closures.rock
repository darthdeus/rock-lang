// Loops (for/while, continue/break/return, nested, captured vars) inside
// closures execute correctly.

fn with_callback(callback: () -> ()) {
    callback()
}

fn with_callback_returning<T>(callback: () -> T) -> T {
    return callback()
}

@test
fn test_loops_in_closure() {
    let items = [1, 2, 3]
    let empty: [int] = []
    let item_sum = 0
    let range_count = 0
    let while_count = 0
    let executed = false

    with_callback(() => {
        for item in items {
            item_sum = item_sum + item
        }
        for i in 0..5 {
            range_count = range_count + 1
        }
        let i = 0
        while i < 4 {
            while_count = while_count + 1
            i = i + 1
        }
        for i in 0..0 {
            executed = true
        }
        for item in empty {
            executed = true
        }
    })

    assert_eq(item_sum, 6)
    assert_eq(range_count, 5)
    assert_eq(while_count, 4)
    assert_eq(executed, false)
}

@test
fn test_continue_and_break_in_closure() {
    let items = [1, 2, 3, 4, 5]
    let for_continue = 0
    let while_continue = 0
    let for_break = 0
    let while_break = 0

    with_callback(() => {
        for item in items {
            if item == 3 {
                continue
            }
            for_continue = for_continue + item
        }
        let i = 0
        while i < 5 {
            i = i + 1
            if i == 3 {
                continue
            }
            while_continue = while_continue + i
        }
        for item in items {
            if item == 4 {
                break
            }
            for_break = for_break + item
        }
        while true {
            while_break = while_break + 1
            if while_break == 3 {
                break
            }
        }
    })

    assert_eq(for_continue, 12)
    assert_eq(while_continue, 12)
    assert_eq(for_break, 6)
    assert_eq(while_break, 3)
}

@test
fn test_loop_in_nested_closures() {
    let sum = 0

    with_callback(() => {
        with_callback(() => {
            for i in 1..4 {
                sum = sum + i
            }
        })
    })
    assert_eq(sum, 6)

    with_callback(() => {
        with_callback(() => {
            with_callback(() => {
                for i in 1..4 {
                    sum = sum + i
                }
            })
        })
    })
    assert_eq(sum, 12)
}

@test
fn test_nested_loops_in_closure() {
    let for_for = 0
    let for_while = 0

    with_callback(() => {
        for i in 0..3 {
            for j in 0..3 {
                for_for = for_for + 1
            }
        }
        for i in 0..3 {
            let j = 0
            while j < 2 {
                for_while = for_while + 1
                j = j + 1
            }
        }
    })

    assert_eq(for_for, 9)
    assert_eq(for_while, 6)
}

@test
fn test_loop_modifying_outer_array_in_closure() {
    let arr = [0, 0, 0]

    with_callback(() => {
        for i in 0..3 {
            arr[i] = i + 1
        }
    })

    assert_eq(arr, [1, 2, 3])
}

@test
fn test_loop_with_captured_iteration_variable() {
    let results = []

    for i in 0..3 {
        with_callback(() => {
            for j in 0..2 {
                vec_push(results, i * 10 + j)
            }
        })
    }

    assert_eq(results, [0, 1, 10, 11, 20, 21])
}

@test
fn test_loops_in_assigned_closures() {
    let sum = 0
    let closure1 = () => { for i in 1..3 { sum = sum + i } }
    let closure2 = () => { for i in 3..5 { sum = sum + i } }

    closure1()
    assert_eq(sum, 3)

    closure2()
    assert_eq(sum, 10)
}

@test
fn test_loop_with_return_in_closure() {
    let result = with_callback_returning(() => {
        for i in 0..10 {
            if i == 5 {
                return i
            }
        }
        return -1
    })

    assert_eq(result, 5)
}
