// Placeholder lambdas: an expression chain rooted at `_` desugars to
// `x => <expr>` (fields, tuple indexes, operators, calls, safe navigation,
// casts, and repeated `_` meaning the same parameter).

struct FixVec2 { x: float, y: float }
struct Mob { name: string, health: int, pos: FixVec2 }

fn double(x: int) -> int { return x * 2 }

fn orc_arena(x: float) -> Arena<Mob> {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Orc", health: 100, pos: FixVec2 { x: x, y: 2.0 } })
    return mobs
}

@test(output = "true\ntrue\ntrue\nfalse\ntrue")
fn field_predicates() {
    let mobs = orc_arena(5.0)
    print(mobs.values().any(_.health > 50))
    print(mobs.values().any(_.name == "Orc"))
    print(mobs.values().any(_.pos.x > 3.0))
    print(mobs.values().any(_.pos.x > 6.0))
    print(mobs.values().any((_.health) > 50))
}

@test(output = "200\n110\n-100")
fn field_arithmetic() {
    let mobs = orc_arena(1.0)
    for hp in mobs.values().map(_.health * 2).collect() { print(hp) }
    for hp in mobs.values().map(_.health + 10).collect() { print(hp) }
    for hp in mobs.values().map(-_.health).collect() { print(hp) }
}

@test(output = "true\ntrue\n20\n10")
fn unary_not_and_calls() {
    let flags = [true, false, true]
    print(flags.iter().any(!_))
    let nums = [1, 2, 3, 4, 5]
    print(nums.iter().any(_.double() > 8))
    print([5].iter().map(_.double().double()).collect()[0])
    print([5].iter().map(double(_)).collect()[0])
}

// -- Tuple fields via `.0` / `.1`, like explicit lambdas --

@test(output = "1\n2\n3\na\nb\nc\n1\n2\n3")
fn placeholder_tuple_fields() {
    let pairs: [(int, string)] = [(1, "a"), (2, "b"), (3, "c")]
    for n in pairs.iter().map(_.0).collect() { print(n) }
    for s in pairs.iter().map(_.1).collect() { print(s) }
    for n in pairs.iter().map(p => p.0).collect() { print(n) }
}

// -- More chain forms --
// Regression: safe navigation, `as` casts and `~` inside a placeholder chain
// fell through to ordinary name resolution ("Undefined variable '_'").

struct Bag { v: int }
struct Owner { pet: Bag? }

@test(output = "1\n0\n3\n1\n2\n3\n-2\n-3\n-4")
fn placeholder_safe_nav_cast_bitnot() {
    // `_.pet` is nullable, so `?.v` puts SafeNavigation inside the chain.
    let owners: [Owner] = [
        Owner { pet: Bag { v: 1 } },
        Owner { pet: null },
        Owner { pet: Bag { v: 3 } },
    ]
    for y in owners.iter().map(_.pet?.v ?? 0).collect() { print(y) }
    let floats: [float] = [1.5, 2.5, 3.5]
    for y in floats.iter().map(_ as int).collect() { print(y) }
    let ints: [int] = [1, 2, 3]
    for y in ints.iter().map(~_).collect() { print(y) }
}

// Each map mixes FieldAccess / TupleIndex / unary / paren differently in one
// chain rooted at `_`, so recognising only one wrapper kind fails.

struct Pair { a: int, b: int }
struct Holder { t: (int, int) }

@test(output = "10\n20\n5\n6\n-10\n-20\n11\n21")
fn placeholder_mixed_chains() {
    let tuples: [(Pair, int)] = [(Pair { a: 10, b: 0 }, 99), (Pair { a: 20, b: 0 }, 99)]
    for y in tuples.iter().map(_.0.a).collect() { print(y) }
    let holders: [Holder] = [Holder { t: (5, 0) }, Holder { t: (6, 0) }]
    for y in holders.iter().map(_.t.0).collect() { print(y) }
    let pairs: [Pair] = [Pair { a: 10, b: 0 }, Pair { a: 20, b: 0 }]
    for y in pairs.iter().map(-_.a).collect() { print(y) }
    for y in pairs.iter().map((_.a) + 1).collect() { print(y) }
}

// Multiple `_` in one expression all bind to the SAME fresh parameter
// (not Scala-style fresh-per-occurrence). `_.a + _.b` is `x => x.a + x.b`.
@test(output = "12\n34\n13\n35")
fn placeholder_multi_same_param() {
    let xs: [Pair] = [Pair { a: 10, b: 2 }, Pair { a: 30, b: 4 }]
    for y in xs.iter().map(_.a + _.b).collect() { print(y) }
    for y in xs.iter().map(_.a + _.b + (_.b - _.b + 1)).collect() { print(y) }
}
