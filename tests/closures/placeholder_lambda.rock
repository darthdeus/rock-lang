// Placeholder lambdas: an expression chain rooted at `_` desugars to
// `x => <expr>` (fields, tuple indexes, operators, calls, safe navigation,
// casts, and repeated `_` meaning the same parameter).

struct FixVec2 { x: float, y: float }
struct Mob { name: string, health: int, pos: FixVec2 }

fn double(x: int) -> int { return x * 2 }

// -- Basic patterns --

@test(output = "true")
fn field_comparison() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Orc", health: 100, pos: FixVec2 { x: 1.0, y: 2.0 } })
    print(mobs.values().any(_.health > 50))
}

@test(output = "true")
fn string_equality() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Orc", health: 100, pos: FixVec2 { x: 1.0, y: 2.0 } })
    print(mobs.values().any(_.name == "Orc"))
}

// -- Nested field access --

@test(output = "true")
fn nested_field() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Orc", health: 100, pos: FixVec2 { x: 5.0, y: 2.0 } })
    print(mobs.values().any(_.pos.x > 3.0))
}

// -- Arithmetic --

@test(output = "200")
fn field_multiply() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Orc", health: 100, pos: FixVec2 { x: 1.0, y: 2.0 } })
    for hp in mobs.values().map(_.health * 2).collect() { print(hp) }
}

@test(output = "110")
fn field_add() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Orc", health: 100, pos: FixVec2 { x: 1.0, y: 2.0 } })
    for hp in mobs.values().map(_.health + 10).collect() { print(hp) }
}

// -- Unary operators --

@test(output = "-100")
fn unary_minus_field() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Orc", health: 100, pos: FixVec2 { x: 1.0, y: 2.0 } })
    for hp in mobs.values().map(-_.health).collect() { print(hp) }
}

@test(output = "true")
fn unary_not() {
    let flags = [true, false, true]
    print(flags.iter().any(!_))
}

// -- Method calls --

@test(output = "true")
fn method_in_comparison() {
    let nums = [1, 2, 3, 4, 5]
    print(nums.iter().any(_.double() > 8))
}

@test(output = "20")
fn chained_method() {
    let nums = [5]
    let mapped = nums.iter().map(_.double().double()).collect()
    print(mapped[0])
}

// -- _ as function argument --

@test(output = "10")
fn underscore_as_arg() {
    let nums = [5]
    let mapped = nums.iter().map(double(_)).collect()
    print(mapped[0])
}

// -- Parenthesized --

@test(output = "true")
fn parenthesized() {
    let mobs: Arena<Mob> = arena_new()
    mobs.insert(Mob { name: "Orc", health: 100, pos: FixVec2 { x: 1.0, y: 2.0 } })
    print(mobs.values().any((_.health) > 50))
}

// -- Tuple fields via `.0` / `.1`, like explicit lambdas --

@test(output = "1\n2\n3")
fn placeholder_tuple_field_zero() {
    let pairs: [(int, string)] = [(1, "a"), (2, "b"), (3, "c")]
    let nums = pairs.iter().map(_.0).collect()
    for n in nums { print(n) }
}

@test(output = "a\nb\nc")
fn placeholder_tuple_field_one() {
    let pairs: [(int, string)] = [(1, "a"), (2, "b"), (3, "c")]
    let strs = pairs.iter().map(_.1).collect()
    for s in strs { print(s) }
}

// Control: explicit lambda form -- this is the workaround we know works.
@test(output = "1\n2\n3")
fn explicit_lambda_tuple_field_zero_control() {
    let pairs: [(int, string)] = [(1, "a"), (2, "b"), (3, "c")]
    let nums = pairs.iter().map(p => p.0).collect()
    for n in nums { print(n) }
}

// -- More chain forms --
// Regression: safe navigation, `as` casts and `~` inside a placeholder chain
// fell through to ordinary name resolution ("Undefined variable '_'").

struct Bag { v: int }
struct Owner { pet: Bag? }

// `_.pet` is nullable so `?.v` is required -> exercises SafeNavigation
// inside the placeholder chain.
@test(output = "1\n0\n3")
fn placeholder_safe_nav() {
    let xs: [Owner] = [
        Owner { pet: Bag { v: 1 } },
        Owner { pet: null },
        Owner { pet: Bag { v: 3 } },
    ]
    let ys = xs.iter().map(_.pet?.v ?? 0).collect()
    for y in ys { print(y) }
}

@test(output = "1\n2\n3")
fn placeholder_as_cast() {
    let xs: [float] = [1.5, 2.5, 3.5]
    let ys = xs.iter().map(_ as int).collect()
    for y in ys { print(y) }
}

@test(output = "-2\n-3\n-4")
fn placeholder_bitnot() {
    let xs: [int] = [1, 2, 3]
    let ys = xs.iter().map(~_).collect()
    for y in ys { print(y) }
}

// Adversarial chain combinations — each exercises a different mix of
// FieldAccess / TupleIndex / SafeNavigation / unary / paren in one
// chain rooted at `_`. Ensures the unified `chain_rooted_at_underscore`
// predicate doesn't regress to recognising only one wrapper kind.

struct Pair { a: int, b: int }
struct Holder { t: (int, int) }

@test(output = "10\n20")
fn placeholder_tuple_then_field() {
    // `(int, Pair).0` then `.a` — TupleIndex inside FieldAccess.
    let xs: [(Pair, int)] = [(Pair { a: 10, b: 0 }, 99), (Pair { a: 20, b: 0 }, 99)]
    let ys = xs.iter().map(_.0.a).collect()
    for y in ys { print(y) }
}

@test(output = "5\n6")
fn placeholder_field_then_tuple() {
    // `.t` then `.0` — FieldAccess inside TupleIndex.
    let xs: [Holder] = [Holder { t: (5, 0) }, Holder { t: (6, 0) }]
    let ys = xs.iter().map(_.t.0).collect()
    for y in ys { print(y) }
}

@test(output = "-10\n-20")
fn placeholder_neg_chain() {
    // Unary minus over a chain.
    let xs: [Pair] = [Pair { a: 10, b: 0 }, Pair { a: 20, b: 0 }]
    let ys = xs.iter().map(-_.a).collect()
    for y in ys { print(y) }
}

@test(output = "11\n21")
fn placeholder_paren_binop_field() {
    // Paren-wrapped chain stays recognised.
    let xs: [Pair] = [Pair { a: 10, b: 0 }, Pair { a: 20, b: 0 }]
    let ys = xs.iter().map((_.a) + 1).collect()
    for y in ys { print(y) }
}

// Multiple `_` in one expression all bind to the SAME fresh parameter
// (not Scala-style fresh-per-occurrence). `_.a + _.b` ≡ `x => x.a + x.b`.
@test(output = "12\n34")
fn placeholder_multi_same_param() {
    let xs: [Pair] = [Pair { a: 10, b: 2 }, Pair { a: 30, b: 4 }]
    let ys = xs.iter().map(_.a + _.b).collect()
    for y in ys { print(y) }
}

// Three references is fine too.
@test(output = "13\n35")
fn placeholder_multi_three_refs() {
    let xs: [Pair] = [Pair { a: 10, b: 2 }, Pair { a: 30, b: 4 }]
    let ys = xs.iter().map(_.a + _.b + (_.b - _.b + 1)).collect()
    for y in ys { print(y) }
}
