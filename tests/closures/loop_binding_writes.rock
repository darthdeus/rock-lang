// Loop-binding capture is per-iteration BY VALUE only while no lambda WRITES the
// binding; a lambda-written `for` counter/index boxes and is shared, so the write
// steers the live counter (same as a plain in-loop write).

// Range counter written by a lambda: iteration 0 has i=0, the lambda steers it to
// 10, the body sums i (10); the latch then bumps 10 -> 11, the header 11 < 3 is
// false, so the loop exits after one iteration. Pre-arc: 10.
@test(output = "10")
fn test_range_counter_lambda_write_steers_loop() {
    let mut_sum = 0
    for i in 0..3 {
        let f = () => { i = i + 10 }
        f()
        mut_sum = mut_sum + i
    }
    print(mut_sum)
}

// Map `for (k, v)` where the lambda writes the user key binding `k` (a fresh
// per-iteration cell, distinct from the anonymous MapNext cursor -- so the
// iteration is not corrupted). Single entry {1: 100}: k steered 1 -> 11, sum =
// 11 + 100. Pre-arc: 111.
@test(output = "111")
fn test_map_key_lambda_write_boxes() {
    let m = map_new()
    m[1] = 100
    let sum = 0
    for (k, v) in m {
        let f = () => { k = k + 10 }
        f()
        sum = sum + k + v
    }
    print(sum)
}

// Enumerate index written by a lambda: idx IS the loop counter, so steering it
// exits the loop like the range case. idx 0 -> 100, x = xs[0] = 10, sum = 110;
// the latch bumps 100 -> 101, 101 < 3 is false -> exit. Pre-arc: 110.
@test(output = "110")
fn test_enumerate_index_lambda_write_steers_loop() {
    let xs = [10, 20, 30]
    let sum = 0
    for (idx, x) in enumerate(xs) {
        let f = () => { idx = idx + 100 }
        f()
        sum = sum + idx + x
    }
    print(sum)
}
