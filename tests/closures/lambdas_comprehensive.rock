// Lambda expressions, closures and higher-order functions.

struct S { field: int }
struct Point { x: int, y: int }
struct Inner { value: int }
struct Outer { inner: Inner }
struct TestStruct { value: float }
struct Data { value: int, name: string }
struct State { flag: bool, value: int }

fn apply2(f: (int, int) -> int, a: int, b: int) -> int {
    return f(a, b)
}

fn apply2_bool(f: (int, int) -> bool, a: int, b: int) -> bool {
    return f(a, b)
}

fn apply2_string(f: (string, string) -> string, a: string, b: string) -> string {
    return f(a, b)
}

fn apply2_float(f: (float, float) -> float, a: float, b: float) -> float {
    return f(a, b)
}

fn apply1(f: (int) -> int, x: int) -> int {
    return f(x)
}

fn double(s: S) -> int {
    return s.field * 2
}

fn use_fn(f: (int, int) -> int) -> int {
    return f(10, 20)
}

fn map_point(p: Point, f: (int) -> int) -> Point {
    return Point { x: f(p.x), y: f(p.y) }
}

fn process(f: (Data) -> int, d: Data) -> int {
    return f(d)
}

fn call_twice(f: (int) -> int) {
    let _ = f(0)
    let _ = f(0)
}

@test(output = "12\n10\n7\n7\n42\n14\n12\n6")
fn test_lambda_syntax_forms() {
    let add = (a: int, b: int) => { return a + b }
    print(add(5, 7))

    let f = x => x * 2
    print(f(5))

    let s = S { field: 7 }
    let annotated = (x: S) => x.field
    let inferred = x => x.field
    print(annotated(s))
    print(inferred(s))

    let zero = () => 42
    print(zero())

    let add_inferred = (x, y) => x + y
    let twice = x => x * 2
    let composed = x => twice(add_inferred(x, 3))
    print(composed(4))

    print(apply2((x, y) => x * y, 3, 4))

    let trailing = (x: int, ) => x + 1
    print(trailing(5))
}

@test(output = "10\n10\n10\n42\n14\n7\n3")
fn test_lambda_placeholder_forms() {
    let field = _.field
    print(field(S { field: 10 }))

    let plus_one = _ + 1
    print(plus_one(9))

    let method = _.double()
    print(method(S { field: 5 }))

    let chained = _.inner.value
    print(chained(Outer { inner: Inner { value: 42 } }))

    let double = _ * 2
    let subtract_five = _ - 5
    let divide_by_three = _ ./ 3
    print(double(7))
    print(subtract_five(12))
    print(divide_by_three(9))
}

@test(output = "8\n14\n5\n5\n5\n5\n7\n1\n25")
fn test_lambda_bodies_and_inference() {
    let b = 5
    let capture = (a: int) => { return a + b }
    print(capture(3))

    print(apply1((x: int) => { return x * 2 }, 7))

    let infer_expr = (x) => x + 1
    let infer_block = (x) => { return x + 1 }
    print(infer_expr(4))
    print(infer_block(4))

    let from_annotation: (float) -> float = (x) => { return x * 2.0 }
    print(from_annotation(2.5))

    let implicit = (x: int) => { x + 2 }
    print(implicit(3))

    let sub = (a: int, b) => a - b
    print(sub(10, 3))

    let half: (float) -> float = (x) => x / 2.0
    print(half(2.0))

    let p = Point { x: 3, y: 4 }
    let distance_from_origin = (pt: Point) => pt.x * pt.x + pt.y * pt.y
    print(distance_from_origin(p))
}

@test(output = "8\n6\n8\n14")
fn test_lambda_curry_alias_and_block_arg() {
    let add = (x: int) => (y: int) => x + y
    let add_five = add(5)
    print(add_five(3))

    let f1 = x => x + 1
    let f2 = f1
    print(f1(5))
    print(f2(7))

    let result = apply2((x, y) => {
        let sum = x + y
        return sum * 2
    }, 3, 4)
    print(result)
}

global test_global: float = 0

@test(output = "99\n42\n15\n30")
fn test_lambda_assignment_to_captures_and_globals() {
    let obj = TestStruct { value: 10.0 }
    let modifier = (v: float) => {
        obj.value = v
    }
    modifier(99.0)
    print(obj.value)

    test_global = 0
    let setter = (v: float) => {
        test_global = v
    }
    setter(42.0)
    print(test_global)

    let data = Data { value: 10, name: "" }
    let modify_and_return = (new_val: int) => {
        data.value = new_val
        return data.value * 2
    }
    let result = modify_and_return(15)
    print(data.value)
    print(result)
}

@test(output = "true\n42\nfalse\n42")
fn test_lambda_assignment_in_conditional() {
    let state = State { flag: false, value: 0 }

    let conditional_set = (should_set: bool, val: int) => {
        if should_set {
            state.flag = true
            state.value = val
        } else {
            state.flag = false
        }
    }

    conditional_set(true, 42)
    print(state.flag)
    print(state.value)

    conditional_set(false, 99)
    print(state.flag)
    print(state.value)
}

global accumulator: int = 0
global call_count: int = 0

@test(output = "Added 5, total now: 5\nAdded 10, total now: 15\nFinal: 15\n2\n7\n11\n4")
fn test_lambda_side_effects_on_globals() {
    accumulator = 0
    let add_to_accumulator = (value: int) => {
        accumulator = accumulator + value
        print("Added {value}, total now: {accumulator}")
    }
    add_to_accumulator(5)
    add_to_accumulator(10)
    print("Final: {accumulator}")

    call_count = 0
    let counter = (x: int) => {
        call_count = call_count + 1
        return 0
    }
    call_twice(counter)
    print(call_count)

    let logged_add = (a: int, b: int) => {
        call_count = call_count + 1
        return a + b
    }
    print(logged_add(3, 4))
    print(logged_add(5, 6))
    print(call_count)
}

@test(output = "10\n3.14\ntrue\nhello\n42\ntest\n15\n25")
fn test_lambda_captures() {
    let x = 10
    let y = 3.14
    let z = true
    let s = "hello"
    let data = Data { value: 42, name: "test" }

    let capturer = () => {
        print(x)
        print(y)
        print(z)
        print(s)
        print(data.value)
        print(data.name)
    }
    capturer()

    let create_adder = (base: int) => {
        return () => { return base + 5 }
    }
    let add_to_10 = create_adder(10)
    let add_to_20 = create_adder(20)
    print(add_to_10())
    print(add_to_20())
}

@test
fn test_lambda_parameter_inference() {
    assert(apply2((x, y) => x + y, 5, 6) == 11)
    assert(apply2((x, y) => x - y, 10, 3) == 7)
    assert(apply2((x, y) => x * y, 4, 5) == 20)
    assert(apply2_bool((x, y) => x > y, 5, 3))
    assert(!apply2_bool((x, y) => x > y, 3, 5))
    assert(apply2_bool((x, y) => x == y, 5, 5))

    assert(apply1((x) => x + x, 5) == 10)
    assert(apply2_string((x, y) => "{x}{y}", "hello", "world") == "helloworld")
    assert(apply2_float((x: float, y) => x + y, 1.5, 2.5) == 4.0)

    assert(apply2((x: int, y) => x + y, 5, 6) == 11)
    assert(apply2((x, y: int) => x + y, 5, 6) == 11)
    assert(apply2((x: int, y: int) => x + y, 5, 6) == 11)

    assert(apply2((x, y) => x + x + y, 5, 6) == 16)
    assert(apply2((x, y) => x * x + y * y, 3, 4) == 25)
    assert(apply2((x, y) => x, 5, 6) == 5)
    assert(apply2((x, y) => y, 5, 6) == 6)
    assert(apply2((x, y) => if x > y { x } else { y }, 5, 6) == 6)
    assert(apply2((x, y) => if x > y { x } else { y }, 6, 5) == 6)

    let add = (x, y) => x + y
    assert(use_fn(add) == 30)
}

@test
fn test_lambda_with_struct_field_access() {
    let p = Point { x: 10, y: 20 }

    let p1 = map_point(p, (v: int) => v * 2)
    assert(p1.x == 20)
    assert(p1.y == 40)

    let p2 = map_point(p, (v) => v * 3)
    assert(p2.x == 30)
    assert(p2.y == 60)

    let result = process((d) => d.value, Data { value: 42, name: "" })
    assert(result == 42)
}
