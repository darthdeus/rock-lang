// Additional edge case tests for lambda assignments based on fuzzing discoveries

struct TestData {
    value: int,
    array: [int],
    nested: NestedData,
}

struct NestedData {
    flag: bool,
    count: int,
}

// Test 1: Assignment operators in lambdas
@test
fn test_assignment_operators_in_lambdas() {
    let counter = 10
    
    let add_assign = (v: int) => counter += v
    let sub_assign = (v: int) => counter -= v
    let mul_assign = (v: int) => counter *= v
    let div_assign = (v: int) => counter = counter ./ v
    
    add_assign(5)     // 10 + 5 = 15
    assert_eq(counter, 15)
    
    sub_assign(3)     // 15 - 3 = 12
    assert_eq(counter, 12)
    
    mul_assign(2)     // 12 * 2 = 24
    assert_eq(counter, 24)
    
    div_assign(4)     // 24 / 4 = 6
    assert_eq(counter, 6)
}

enum Action {
    Set(value: int),
    Increment(by: int),
    Reset,
}

// Test 2: Assignments in match expressions
@test
fn test_match_expression_assignments() {
    let state = 0
    
    let process = (action: Action) => match action {
        Action::Set(v) => state = v,
        Action::Increment(n) => state += n,
        Action::Reset => state = 0,
    }
    
    process(Action::Set(42))
    assert_eq(state, 42)
    
    process(Action::Increment(8))
    assert_eq(state, 50)
    
    process(Action::Reset)
    assert_eq(state, 0)
}

// Test 3: Conditional assignments in if expressions
@test
fn test_conditional_assignments() {
    let data = TestData {
        value: 0,
        array: [1, 2, 3],
        nested: NestedData { flag: false, count: 0 },
    }
    
    let conditional_assign = (condition: bool, v: int) => 
        if condition { 
            data.value = v 
        } else { 
            data.nested.count = v 
        }
    
    conditional_assign(true, 100)
    assert_eq(data.value, 100)
    assert_eq(data.nested.count, 0)
    
    conditional_assign(false, 200)
    assert_eq(data.value, 100)
    assert_eq(data.nested.count, 200)
}

// Test 4: Assignment to dynamically computed indices
@test
fn test_dynamic_index_assignment() {
    let matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    
    let get_row = (n: int) => n % 3
    let get_col = (n: int) => int(n / 3.0) % 3
    
    let assign_computed = (n: int, val: int) => matrix[get_row(n)][get_col(n)] = val
    
    assign_computed(4, 99)  // n=4: row=1, col=1 -> matrix[1][1] = 99
    assert_eq(matrix[1][1], 99)
    
    assign_computed(8, 88)  // n=8: row=2, col=2 -> matrix[2][2] = 88
    assert_eq(matrix[2][2], 88)
}

// Test 5: Multiple lambdas modifying shared state
@test
fn test_concurrent_lambda_modifications() {
    let shared = TestData {
        value: 0,
        array: [0, 0, 0],
        nested: NestedData { flag: false, count: 0 },
    }
    
    let inc_value = () => shared.value += 1
    let inc_count = () => shared.nested.count += 1
    let inc_array = (idx: int) => shared.array[idx] += 1
    
    // Simulate interleaved execution
    inc_value()
    inc_count()
    inc_array(0)
    inc_value()
    inc_array(1)
    inc_count()
    inc_array(2)
    inc_value()
    
    assert_eq(shared.value, 3)
    assert_eq(shared.nested.count, 2)
    assert_eq(shared.array[0], 1)
    assert_eq(shared.array[1], 1)
    assert_eq(shared.array[2], 1)
}

// Test 6: Assignment with implicit type conversions
@test
fn test_type_conversion_assignments() {
    let int_val = 0
    let float_val = 0.0
    
    // These should handle type conversions properly
    let assign_int_from_float = (f: float) => int_val = int(f)
    let assign_float_from_int = (i: int) => float_val = i as float
    
    assign_int_from_float(3.7)
    assert_eq(int_val, 3)
    
    assign_float_from_int(42)
    assert_eq(float_val, 42.0)
}

// Test 7: Assignment result is unit
@test
fn test_assignment_returns_unit() {
    let x = 0
    
    // Assignment returns unit - we can verify this by checking the type
    let assign = (v: int) => x = v
    
    assign(42)
    assert_eq(x, 42)
    
    // The fact that this compiles proves assignment returns unit
    let unit_result: () = assign(99)
    assert_eq(x, 99)
}

// Test 8: Nested lambda assignments
@test
fn test_nested_lambda_assignments() {
    let outer_val = 0
    let inner_val = 0
    
    let outer = (x: int) => {
        outer_val = x
        let inner = (y: int) => inner_val = y
        return inner
    }
    
    let inner_func = outer(10)
    assert_eq(outer_val, 10)
    assert_eq(inner_val, 0)
    
    inner_func(20)
    assert_eq(inner_val, 20)
}

// Test 9: Assignment in while loop condition (edge case)
@test 
fn test_assignment_in_loop_edge_case() {
    let values = [1, 2, 3, 4, 5]
    let sum = 0
    let idx = 0
    
    // Lambda that assigns and returns whether to continue
    let process_next = () => {
        if idx < values.len() {
            sum += values[idx]
            idx += 1
            return true
        }
        return false
    }
    
    while process_next() {
        // Empty body - work is done in condition
    }
    
    assert_eq(sum, 15)  // 1+2+3+4+5
    assert_eq(idx, 5)
}

struct Builder {
    value: int,
    name: string,
}

// Test 10: Assignment with method chaining
@test
fn test_assignment_with_method_chaining() {
    let builder = Builder { value: 0, name: "" }
    
    let set_value = (v: int) => builder.value = v
    let set_name = (n: string) => builder.name = n
    
    // Can't chain because assignments return unit, but we can sequence
    let build = (v: int, n: string) => {
        set_value(v)
        set_name(n)
    }
    
    build(42, "test")
    assert_eq(builder.value, 42)
    assert_eq(builder.name, "test")
}