// Inc 8 main: cdata-backed value read.
//
// A value-typed local that's NOT scalarized (e.g. bound from a
// regular-struct field or a cdata-ABI call return) lives as a single
// `V2_ct(...)` cdata. Consuming its fields as scalars (or passing it
// to a scalar-ABI callee) needs per-field unpack `cd.x, cd.y`.
//
// The Ident arm in `lower_value` now does the unpack via
// `unpack_cdata_value`. A name-pattern guard
// (`is_scalarized_component_name`) excludes ScalarizePass-introduced
// `<base>__<field>` synthetic locals from the cdata fallback (those
// are scalar locals despite their AST nodes carrying the original
// value-struct type via ID reuse).

value V2 { x: int, y: int }
struct Holder { v: V2 }

fn sum2(v: V2) -> int {
    return v.x + v.y
}

@test(output = "12")
fn test_cdata_subfield_read() {
    let h = Holder { v: V2 { x: 5, y: 7 } }
    // h.v is cdata-backed; h.v.x and h.v.y unpack via the FieldAccess
    // path (already Inc 8b). Verifies behavioral parity.
    print(h.v.x + h.v.y)
}

@test(output = "12")
fn test_cdata_to_scalar_local() {
    let h = Holder { v: V2 { x: 5, y: 7 } }
    let p = h.v
    // `p` is cdata-backed. Reading p.x / p.y must unpack — go through
    // the Inc 8 main Ident-arm path (or the FieldAccess path).
    print(p.x + p.y)
}

@test(output = "12")
fn test_cdata_into_scalar_abi_arg() {
    let h = Holder { v: V2 { x: 5, y: 7 } }
    // Passing h.v into a scalar-ABI callee (sum2 takes V2 as scalar
    // ABI). h.v is cdata, must unpack via the lower_value path.
    print(sum2(h.v))
}
