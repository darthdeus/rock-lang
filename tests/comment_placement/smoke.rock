struct Point { x: int, y: int }
enum Shape { Circle(float), Rect(float, float) }
fn classify(s: Shape) -> string {
    return match s {
        Shape::Circle(r) => "circle"
        Shape::Rect(w, h) => "rect"
    }
}
fn main() {
    let xs: [int] = [1, 2]
    for v in xs { if v > 0 { print(v) } }
    let g = x => x * 2
    print(g(2))
}
