// Comments in every syntactic position the parser must skip.

struct Point {
    // the x coordinate
    x: int,
    /* the y coordinate */
    y: int, // trailing
}

struct Box<T> { value: T }

enum Shape {
    Circle(float /* radius */),
    Rect(float, /* width */ float /* height */),
}

fn add(a: int, // line comment between
       b: int) -> int {
    return a + b
}

fn add_block(a: int, /* the addend */ b: int) -> int {
    return a + b
}

fn add3(a: int, b: int, c: int) -> int { return a + b + c }

fn identity<T /* the type */>(x: T) -> T {
    return x
}

fn make_box() -> Box</* inner type */ int> {
    let b: Box<int> = Box { value: 42 }
    return b
}

fn pair() -> (int, /* second */ int) { return (1, 2) }

fn five() /* returns */ -> int { return 5 }
fn six() -> /* int here */ int { return 6 }

@test(output = "3\n3\n3\n5\n42\n3\n11\nok")
fn declarations() {
    print(add(1, 2))
    print(add_block(1, 2))
    let p = Point { x: 1, y: 2 }
    print(p.x + p.y)
    print(identity(5))
    print(make_box().value)
    let q = pair()
    print(q.0 + q.1)
    print(five() + six())
    let s = Shape::Rect(3.0, 4.0)
    match s {
        Shape::Circle(_) => print("c"),
        Shape::Rect(_, _) => print("ok"),
    }
}

@test(output = "3\n6\n6\n7\n6\none\none")
fn expressions() {
    let p = Point {
        // x field
        x: 1,
        /* y field */ y: 2, // trailing
    }
    print(p.x + p.y)
    let arr: [int] = [
        1, // first
        /* second */ 2,
        3,
    ]
    let sum = 0
    for v in arr { sum = sum + v }
    print(sum)
    let r = add3(
        /* first */ 1,
        2, // second
        /* third */ 3 /* end */
    )
    print(r)
    let x = 1 + /* add two */ 2 + 4
    print(x)
    let f = y => /* double */ y * 2
    print(f(3))
    let n = 1
    let after_arrow = match n {
        1 => /* the one */ "one",
        2 => "two",
        _ => "other",
    }
    print(after_arrow)
    let before_arrow = match n {
        1 /* pattern for 1 */ => "one",
        _ => "other",
    }
    print(before_arrow)
}

@test(/* expected */ output = "3\nyes\n6")
fn statements() {
    // before let
    let a = 1 // first
    /* between */
    let b = 2 // second
    // trailing before expr
    print(a + b) // sum
    let x = 5
    if /* positive? */ x > 0 /* yes it is */ {
        print("yes")
    } else {
        print("no")
    }
    let arr: [int] = [1, 2, 3]
    let sum = 0
    for /* iter var */ v in /* iterable */ arr {
        sum = sum + v
    }
    print(sum)
}
