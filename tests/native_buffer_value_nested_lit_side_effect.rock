// Adversarial: nested struct literal with a side-effecting expr in
// each scalar leaf. Verify the side effect runs exactly once per call
// and in literal-source order.

@intrinsic @inline inline(lua) fn put(s: string) = "io.write(s)"

global SEQ: int = 0

fn next_seq() -> float {
    SEQ = SEQ + 1
    return SEQ + 0.0
}

value V2 {
    x: float,
    y: float,
}

value Pair {
    first: V2,
    second: V2,
}

@nomangle inline(lua) fn __nb_alloc_Pair(n: int) -> Ptr<Pair> = 'return ffi.new("Pair[?]", n)'

fn nb_pair(n: int) -> NativeBuffer<Pair> {
    return NativeBuffer { ptr: __nb_alloc_Pair(n), len: n }
}

@test(output = "f.x=1\nf.y=2\ns.x=3\ns.y=4\ntotal=4")
fn test_nested_literal_side_effect_order() {
    let buf = nb_pair(1)
    buf[0] = Pair {
        first: V2 { x: next_seq(), y: next_seq() },
        second: V2 { x: next_seq(), y: next_seq() },
    }
    let r = buf[0]
    put("f.x=")
    put("{r.first.x}")
    put("\n")
    put("f.y=")
    put("{r.first.y}")
    put("\n")
    put("s.x=")
    put("{r.second.x}")
    put("\n")
    put("s.y=")
    put("{r.second.y}")
    put("\n")
    put("total=")
    put("{SEQ}")
    put("\n")
}
