// Test that global initializers are properly type-checked

// Test 1: Undefined variable in global initializer should fail
// @test expected_error: undefined variable
// global bad_global: int = undefined_variable

// Test 2: Type mismatch in global initializer should fail
// @test expected_error: type mismatch
// global wrong_type: int = "not an int"

// Test 3: Valid global initializer should work
global good_global: int = 42

// Test 4: Typed global with a string initializer
global inferred_global: string = "hello"

// Test 5: Global referencing another global should work
global dependent_global: int = good_global + 10

@test
fn test_globals() {
    assert_eq(good_global, 42)
    assert_eq(inferred_global, "hello")
    assert_eq(dependent_global, 52)
}