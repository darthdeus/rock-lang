//! `Vec { ... }` struct literal and the `[T]`/`Vec<T>` type are the same type.
//! bone maps the `Vec` type name to the Array ctor (lower.rs); the struct-literal
//! path must do the same so a `Vec { ... }` literal unifies with a `[T]` slot.

//- vec_literal_is_array
struct Vec<T> { data: any, len: int }
fn make<T>() -> [T] {
    return Vec { data: 0, len: 0 }
}
fn f() -> int {
    let xs: [int] = make()
    let n = xs.len
      //^ int
    n
}
