//! Unary minus: `-e`. The operand must be numeric (`int` or `float`); the
//! result has the operand's type. Mirrors `Not` (see not_op.rock) but with a
//! numeric constraint instead of bool. Needs `Expr::Neg` HIR + lowering
//! (`ExprKind::UnaryMinus`) + inference (operand must be int/float, yield it).
//!
//! Note: `-5` (a literal) is folded to a negative `Int` by the parser and
//! already lowers; the gap is `-e` for any non-literal operand.

//- neg_int_var
fn f(n: int) -> int {
    let x = -n
      //^ int
    x
}

//- neg_float_var
fn f(n: float) -> float {
    let x = -n
      //^ float
    x
}

// double negation preserves the type
//- neg_double
fn f(n: int) -> int {
    let x = -(-n)
      //^ int
    x
}

// negating a parenthesized expression
//- neg_paren_expr
fn f(a: int, b: int) -> int {
    let x = -(a)
      //^ int
    x
}

// the folded negative literal still works (guard against regression)
//- neg_literal
fn f() -> int {
    let x = -5
    x
  //^ int
}

// negating a bool must fail the numeric constraint
//- neg_bool_fail @fail
fn f(b: bool) -> int {
    let x = -b
    5
}

// negating a string must fail
//- neg_string_fail @fail
fn f(s: string) -> int {
    let x = -s
    5
}
