//! `enumerate(coll)` in a `for` head yields `(int, <element-of-coll>)`. rock
//! special-cases native-array enumerate in codegen (no stdlib overload), so
//! bone intercepts `enumerate(...)` in the `for` type-checker and reuses the
//! same per-collection element rule as plain iteration. Verified vs rock
//! (tests/enumerate_tests.rock, tests/adversarial_native_arrays.rock).
//!
//! (No stdlib in the fixture harness, so this exercises the for-level intercept
//! directly -- `enumerate` is never resolved as a function here.)

//- enumerate_native_array_int
fn f(arr: ![int]) -> int {
    for (i, v) in enumerate(arr) {
        let a = i
          //^ int
        let b = v
          //^ int
    }
    0
}

//- enumerate_native_array_string
fn f(arr: ![string]) -> string {
    for (i, v) in enumerate(arr) {
        let b = v
          //^ string
    }
    ""
}

//- enumerate_vec
fn f(xs: [int]) -> int {
    for (i, x) in enumerate(xs) {
        let b = x
          //^ int
    }
    0
}
