//! A parameter with a default value may be omitted at the call site.
//! `fn g(a: int, b: int = 5)` accepts both g(1) and g(1, 2), but the
//! required params (those without a default) still form an arity floor.

//- default_param_omitted
fn g(a: int, b: int = 5) -> int { a }
fn h() -> int {
    let r = g(1)
      //^ int
    let s = g(1, 2)
      //^ int
    r
}

// Below the required-arg floor: `a` has no default, so g() must be rejected.
//- default_param_below_floor @fail
fn g(a: int, b: int = 5) -> int { a }
fn h() -> int {
    let r = g()
    r
}

// Above the total param count must still be rejected.
//- default_param_too_many @fail
fn g(a: int, b: int = 5) -> int { a }
fn h() -> int {
    let r = g(1, 2, 3)
    r
}
