//! int -> float widening (directional: int <: float, never the reverse). Applies
//! at value->expected sites -- let annotation, call arg -> param, return value,
//! assignment. Comparisons stay strict (comparison.rock). Operator-overload
//! selection that also needs widening lives in numeric_operators.rock.

//- let_int_to_float
fn f() -> float {
    let x: float = 1
    x
  //^ float
}

//- param_int_literal
fn g(x: float) -> float { x }
fn f() -> float {
    let r = g(1)
      //^ float
    r
}

//- param_int_var
fn g(x: float) -> float { x }
fn f() -> float {
    let i: int = 3
    let r = g(i)
      //^ float
    r
}

//- return_int_as_float
fn f() -> float { 1 }
fn use_f() -> float {
    let y = f()
      //^ float
    y
}

//- assign_int_to_float
fn f() -> float {
    let x: float = 0.0
    x = 1
    x
  //^ float
}

// float -> int stays rejected everywhere
//- float_to_int_param_fail @fail
fn g(y: int) -> int { y }
fn f() -> int { g(1.5) }

//- float_to_int_let_fail @fail
fn f() -> int {
    let x: int = 1.5
    x
}

//- float_return_as_int_fail @fail
fn f() -> int { 1.5 }
