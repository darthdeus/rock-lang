//! @no_check
//! Opaque function bodies: `inline(lua)` / extern functions have no Rock body to
//! infer. bone registers the signature (params + return type) and skips body
//! inference, so callers resolve and typecheck against the declared signature.
//! This is a prerequisite for loading the stdlib (almost all of it is inline lua).

// an inline(lua) function is callable; its declared return type flows out.
//- inline_lua_callable
inline(lua) fn myadd(x: int, y: int) -> int = "return x + y"
fn f() -> int {
    let r = myadd(1, 2)
      //^ int
    r
}

// the declared signature is still enforced at the call site.
//- inline_lua_arg_typechecked @fail
inline(lua) fn myadd(x: int, y: int) -> int = "return x + y"
fn f() -> int {
    let r = myadd(1, true)
      //^ int
    r
}

// a unit-returning inline(lua) fn (no `-> T`) is callable as a statement.
//- inline_lua_unit
inline(lua) fn log_it(msg: string) = "print(msg)"
fn f() -> int {
    let u = log_it("hi")
      //^ ()
    5
}
