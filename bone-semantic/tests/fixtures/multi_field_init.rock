//! Multi-field init `Foo { a + b: expr }` -- shorthand for `a: expr, b: expr`
//! with `expr` evaluated once and shared across the named fields. bone already
//! handles the struct-literal arm; these slices also cover the enum
//! record-variant arm. Verified vs rock (tests/struct_init_multi_field.rock).

// Two fields share one value.
//- struct_two_fields
struct Vec2 { x: int, y: int }
fn f() -> Vec2 {
    let v = Vec2 { x + y: 5 }
      //^ Vec2
    v
}

// Three fields in one group.
//- struct_three_fields
struct Triple { a: int, b: int, c: int }
fn f() -> Triple {
    let t = Triple { a + b + c: 7 }
      //^ Triple
    t
}

// Multi-field group alongside an explicit field.
//- struct_mixed_with_explicit
struct Named { a: int, b: int, name: string }
fn f() -> Named {
    let n = Named { a + b: 1, name: "hi" }
      //^ Named
    n
}

// Multi-field with a shared `null` value across (homogeneous) nullable fields.
// The shared node is inferred once (assign_expr_type memoization); both fields
// receive `int?`. (Heterogeneous fields are intentionally rejected -- see
// TODO.md.)
//- struct_nullable_fields_shared_null
struct OptPair { a: int?, b: int? }
fn f() -> OptPair {
    let p = OptPair { a + b: null }
      //^ OptPair
    p
}

// Enum record variant with a multi-field group + explicit field.
//- enum_record_variant
enum Shape { Circle { cx: int, cy: int, radius: int }, Box { x: int, y: int, w: int, h: int } }
fn f() -> Shape {
    let s = Shape::Circle { cx + cy: 5, radius: 10 }
      //^ Shape
    s
}

// Enum record variant with two multi-field groups.
//- enum_record_two_groups
enum Region { Box { x: int, y: int, w: int, h: int } }
fn f() -> Region {
    let s = Region::Box { x + y: 0, w + h: 100 }
      //^ Region
    s
}
