//! int/float widening at JOINS (if-branches, array elements, match arms): the
//! least-upper-bound of int and float is float. Symmetric (neither side is
//! "expected"), unlike the directional value->expected coerce.

//- if_branch_widens
fn f(c: bool) -> float {
    let r = if c { 1.0 } else { 2 }
      //^ float
    r
}

//- if_both_int
fn f(c: bool) -> int {
    let r = if c { 1 } else { 2 }
      //^ int
    r
}

//- array_widens
fn f() -> [float] {
    let xs = [1.0, 2, 3.0]
      //^ [float]
    xs
}
