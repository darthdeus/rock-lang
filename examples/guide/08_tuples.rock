// Tuples group a fixed mix of values. Destructure them with `let`,
// or index from zero with `.0`, `.1` and so on.
fn divmod(a: int, b: int) -> (int, int) {
    return (a ./ b, a % b)
}

fn main() {
    let t = (1, "two", 3.0)
    let (a, b, _) = t
    print(a) // 1
    print(b) // two
    print(t.0) // 1
    print(t.2) // 3
    let (q, r) = divmod(7, 3)
    print(q) // 2
    print(r) // 1
    let nested = ((1, 2), (3, 4))
    print(nested.1.0) // 3
}
