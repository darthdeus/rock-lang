@lua_named struct __DecoTarget {
    name: string,
    params: [string],
    func: any,
}

@lua_named struct ArtifactDefinition<T> {
    catalog: string,
    key: string,
    name: string,
    ordinal: int,
    definition: T,
}

@pure @inline fn int(value: int) -> int { return value }

@pure fn int(value: float) -> int { return floor(value) as int }

fn is_nan(value: float) -> bool {
    return value != value
}

// Out parameters use one-element LuaJIT cdata arrays.

extern(lua, "ffi.new") fn __ffi_new_int_out(ctype: string) -> Ptr<int>
extern(lua, "ffi.new") fn __ffi_new_float_out(ctype: string) -> Ptr<float>

fn ffi_out_int() -> Ptr<int> { return __ffi_new_int_out("int[1]") }
fn ffi_out_float() -> Ptr<float> { return __ffi_new_float_out("float[1]") }

@nowrite inline(lua) fn read(p: Ptr<int>) -> int = "return p[0]"
@nowrite inline(lua) fn read(p: Ptr<float>) -> float = "return p[0]"
@nowrite inline(js) fn read(p: Ptr<int>) -> int = "return p[0];"
@nowrite inline(js) fn read(p: Ptr<float>) -> float = "return p[0];"

// Pointer values share their referent; LuaJIT represents them as raw cdata.

value Ptr<T> { }
value PtrU8  { }
value PtrI8  { }
value PtrU16 { }
value PtrI16 { }
value PtrU32 { }

value Storage { }

// Indexing is 0-based; unchecked accesses past len can read or write garbage.
// Copying the descriptor shares storage. Large allocations live outside the Lua heap.

value NativeBuffer<T> {
    ptr: Ptr<T>,
    len: int,
}

// Expanded by skull at every call site; `T` must be an FFI-clean value struct
// or int/float/bool.
@nowrite inline(lua) fn native_buffer_alloc<T>(n: int) -> NativeBuffer<T> = "error('native_buffer_alloc is a skull compiler intrinsic; a call reached runtime unexpanded')"

@inline fn native_buffer_float(n: int) -> NativeBuffer<float> {
    return native_buffer_alloc(n)
}
@inline fn native_buffer_int(n: int) -> NativeBuffer<int> {
    return native_buffer_alloc(n)
}
@intrinsic @inline fn native_buffer_uint(n: int) -> NativeBuffer<uint> {
    return native_buffer_alloc(n)
}

// Direct pointer access lets LuaJIT fold the field load and index into one trace.
@nowrite @intrinsic @native_required inline(lua) fn nb_get(b: NativeBuffer<float>, i: int) -> float = "return b.ptr[i]"
@writes_elems @intrinsic @native_required inline(lua) fn nb_set(b: NativeBuffer<float>, i: int, v: float) = "b.ptr[i] = v"
@nowrite @intrinsic @native_required inline(lua) fn nb_get(b: NativeBuffer<int>, i: int) -> int = "return b.ptr[i]"
@writes_elems @intrinsic @native_required inline(lua) fn nb_set(b: NativeBuffer<int>, i: int, v: int) = "b.ptr[i] = v"
@nowrite @intrinsic @native_required inline(lua) fn nb_get(b: NativeBuffer<uint>, i: int) -> uint = "return b.ptr[i]"
@writes_elems @intrinsic @native_required inline(lua) fn nb_set(b: NativeBuffer<uint>, i: int, v: uint) = "b.ptr[i] = v"

@nowrite @intrinsic @native_required inline(lua) fn get(b: NativeBuffer<float>, i: int) -> float? = """
    if i < 0 or i >= b.len then return nil end
    return b.ptr[i]
"""
@nowrite @intrinsic @native_required inline(lua) fn get(b: NativeBuffer<int>, i: int) -> int? = """
    if i < 0 or i >= b.len then return nil end
    return b.ptr[i]
"""
@nowrite @intrinsic @native_required inline(lua) fn get(b: NativeBuffer<uint>, i: int) -> uint? = """
    if i < 0 or i >= b.len then return nil end
    return b.ptr[i]
"""

// Metric: `sorted` stays ascending so order statistics are index lookups;
// `ring` is insertion order, giving the oldest sample to evict.

value StatSummary {
    mean: float,
    stddev: float,
    min: float,
    max: float,
    p50: float,
    p90: float,
    p99: float,
    n: int,
}

struct Metric {
    name: string,
    cap: int,
    ring: NativeBuffer<float>,    // insertion order (eviction + raw plot source)
    sorted: NativeBuffer<float>,  // same values, ascending (order stats)
    head: int = 0,
    count: int = 0,
    sum: float = 0.0,
    sum_sq: float = 0.0,
    mean: float = 0.0,
    stddev: float = 0.0,
    min: float = 0.0,
    max: float = 0.0,
    p50: float = 0.0,
    p90: float = 0.0,
    p99: float = 0.0,
}

fn metric_new(name: string, cap: int) -> Metric {
    return Metric {
        name: name,
        cap: cap,
        ring: native_buffer_float(cap),
        sorted: native_buffer_float(cap),
    }
}

// round(p/100 * (n-1)), clamped to n-1. `min` isn't provably @pure, so the
// clamp is spelled out.
@pure
fn metric_percentile_index(p: int, n: int) -> int {
    if n <= 1 { return 0 }
    let idx = (p * (n - 1) + 50) ./ 100
    if idx > n - 1 { return n - 1 }
    return idx
}

// Only called from metric_add after it adds a sample, so count >= 1.
fn metric_recompute(m: Metric) {
    let n = m.count
    let nf = n as float
    let mean = m.sum / nf
    m.mean = mean
    // Clamp guards float cancellation in the sum_sq - mean^2 variance form.
    m.stddev = sqrt(max(0.0, m.sum_sq / nf - mean * mean))
    m.min = nb_get(m.sorted, 0)
    m.max = nb_get(m.sorted, n - 1)
    m.p50 = nb_get(m.sorted, metric_percentile_index(50, n))
    m.p90 = nb_get(m.sorted, metric_percentile_index(90, n))
    m.p99 = nb_get(m.sorted, metric_percentile_index(99, n))
}

// Lower bound of `v` in sorted[0..n). Both loops have a literal bound, so the
// trip count is one constant per metric instead of one side exit per scanned
// index; once lo == hi the remaining steps write nothing. 16 steps cover n up
// to 65536, 64 cover any int-sized n.
fn metric_lower_bound(m: Metric, n: int, v: float, cap: int) -> int {
    let lo = 0
    let hi = n
    if cap <= 65536 {
        for _step in 0..16 {
            if lo < hi {
                let mid = (lo + hi) ./ 2
                if nb_get(m.sorted, mid) < v {
                    lo = mid + 1
                } else {
                    hi = mid
                }
            }
        }
    } else {
        for _step in 0..64 {
            if lo < hi {
                let mid = (lo + hi) ./ 2
                if nb_get(m.sorted, mid) < v {
                    lo = mid + 1
                } else {
                    hi = mid
                }
            }
        }
    }
    return lo
}

// O(cap), zero allocation, uniform cost per call.
fn metric_add(m: Metric, v: float) {
    let evicting = m.count >= m.cap
    let old = 0.0

    if evicting {
        // Both buffers are written through nb_set, so the oldest sample is in
        // `sorted` bit-for-bit and a lower bound lands on a copy of it.
        old = nb_get(m.ring, m.head)
        let oi = metric_lower_bound(m, m.count, old, m.cap)
        let q = metric_lower_bound(m, m.count, v, m.cap)
        let p = if oi < q { q - 1 } else { q }
        let step = if p < oi { 1 } else { -1 }
        let stop = oi + step
        let held = v
        let j = p
        while j != stop {
            let prev = nb_get(m.sorted, j)
            nb_set(m.sorted, j, held)
            held = prev
            j = j + step
        }
    } else {
        let p = metric_lower_bound(m, m.count, v, m.cap)
        let j = m.count
        while j > p {
            nb_set(m.sorted, j, nb_get(m.sorted, j - 1))
            j = j - 1
        }
        nb_set(m.sorted, p, v)
    }

    nb_set(m.ring, m.head, v)
    let stored = nb_get(m.ring, m.head)
    if evicting {
        m.sum -= old
        m.sum_sq -= old * old
    }
    m.sum += stored
    m.sum_sq += stored * stored
    m.head = (m.head + 1) % m.cap
    if !evicting {
        m.count = m.count + 1
    }

    metric_recompute(m)
}

// Keeps the ring/sorted buffers: logically empty at count 0, so a window
// restarts without reallocating.
fn metric_reset(m: Metric) {
    m.head = 0
    m.count = 0
    m.sum = 0.0
    m.sum_sq = 0.0
    m.mean = 0.0
    m.stddev = 0.0
    m.min = 0.0
    m.max = 0.0
    m.p50 = 0.0
    m.p90 = 0.0
    m.p99 = 0.0
}

fn metric_snapshot(m: Metric) -> StatSummary {
    return StatSummary {
        mean: m.mean,
        stddev: m.stddev,
        min: m.min,
        max: m.max,
        p50: m.p50,
        p90: m.p90,
        p99: m.p99,
        n: m.count,
    }
}

// i = 0 is the newest sample. Caller guarantees 0 <= i < m.count.
fn metric_recent(m: Metric, i: int) -> float {
    let idx = ((m.head - 1 - i) % m.cap + m.cap) % m.cap
    return nb_get(m.ring, idx)
}

// NativeBuffer value elements use contiguous C-layout storage. Whole reads copy;
// field access addresses the live slot. FlatVec requires an FFI-clean value type.

@lua_named struct FlatVec<T> { buf: NativeBuffer<T>, len: int }   // buf.len = capacity

@inline fn flat_vec_new<T>(cap: int = 8) -> FlatVec<T> {
    return FlatVec { buf: native_buffer_alloc(cap), len: 0 }
}

// Scalar element copies trace under LuaJIT.
@inline fn FlatVec<T>.grow(fv) {
    let old = fv.buf
    let cap = old.len
    let new_cap = if cap < 2 { 4 } else { cap * 2 }
    let grown: NativeBuffer<T> = native_buffer_alloc(new_cap)
    for i in 0..fv.len {
        grown[i] = old[i]
    }
    fv.buf = grown
}

@inline fn FlatVec<T>.push(fv, v: T) {
    if fv.len == fv.buf.len {
        fv.grow()
    }
    fv.buf[fv.len] = v
    fv.len = fv.len + 1
}

@inline fn FlatVec<T>.get(fv, i: int) -> T {
    if i < 0 || i >= fv.len {
        error("FlatVec.get: index {i} out of range (len {fv.len})")
    }
    return fv.buf[i]
}

@inline fn FlatVec<T>.set(fv, i: int, v: T) {
    if i < 0 || i >= fv.len {
        error("FlatVec.set: index {i} out of range (len {fv.len})")
    }
    fv.buf[i] = v
}

// Keeps the allocated capacity; a later push reuses it.
@inline fn FlatVec<T>.clear(fv) {
    fv.len = 0
}

// The typed staging pointer for the flat FFI upload path (shader_set_vec4_array
// _flat etc.): the first `len` elements are contiguous C-layout.
@inline fn FlatVec<T>.ptr(fv) -> Ptr<T> {
    return fv.buf.ptr
}

// The key fn must be capture-free: a capturing lambda allocates per call.
@inline fn FlatVec<T>.sort(fv, key_fn: (T) -> float) {
    for i in 1..fv.len {
        let x = fv.buf[i]
        let kx = key_fn(x)
        let j = i - 1
        while j >= 0 && key_fn(fv.buf[j]) > kx {
            fv.buf[j + 1] = fv.buf[j]
            j = j - 1
        }
        fv.buf[j + 1] = x
    }
}

// ----------------------------------------------------------------------------
// Sized buffers read as int and retain distinct pointer types for FFI.
macro __sized_native_buffer(Buf: ident, Pointer: ty, New: ident, Allocate: ident) {
    value Buf { ptr: Pointer, len: int }

    @inline fn New(n: int) -> Buf { return Buf { ptr: Allocate(n), len: n } }

    @nowrite @intrinsic @native_required inline(lua) fn nb_get(b: Buf, i: int) -> int = "return b.ptr[i]"
    @writes_elems @intrinsic @native_required inline(lua) fn nb_set(b: Buf, i: int, v: int) = "b.ptr[i] = v"

    @nowrite @intrinsic @native_required inline(lua) fn get(b: Buf, i: int) -> int? = """
    if i < 0 or i >= b.len then return nil end; return b.ptr[i]
"""

    fn enumerate(collection: Buf) -> [(int, int)] {
        let out: [(int, int)] = vec_new()
        for i in 0..collection.len {
            out.push((i, collection[i]))
        }
        return out
    }
}

@intrinsic @native_required @nomangle inline(lua) fn __nb_alloc_u8(n: int)  -> PtrU8  = 'return __rock_nb_alloc("uint8_t", n)'
@intrinsic @native_required @nomangle inline(lua) fn __nb_alloc_i8(n: int)  -> PtrI8  = 'return __rock_nb_alloc("int8_t", n)'
@intrinsic @native_required @nomangle inline(lua) fn __nb_alloc_u16(n: int) -> PtrU16 = 'return __rock_nb_alloc("uint16_t", n)'
@intrinsic @native_required @nomangle inline(lua) fn __nb_alloc_i16(n: int) -> PtrI16 = 'return __rock_nb_alloc("int16_t", n)'
@intrinsic @native_required @nomangle inline(lua) fn __nb_alloc_u32(n: int) -> PtrU32 = 'return __rock_nb_alloc("uint32_t", n)'

// Off-heap storage, which `collectgarbage("count")` does not include.
@nomangle inline(lua) fn native_buffer_offheap_bytes() -> int = "return __ROCK_NB_OFFHEAP_STATS.live_bytes"

__sized_native_buffer(NativeBufferU8, PtrU8, native_buffer_u8, __nb_alloc_u8)
__sized_native_buffer(NativeBufferI8, PtrI8, native_buffer_i8, __nb_alloc_i8)
__sized_native_buffer(NativeBufferU16, PtrU16, native_buffer_u16, __nb_alloc_u16)
__sized_native_buffer(NativeBufferI16, PtrI16, native_buffer_i16, __nb_alloc_i16)
__sized_native_buffer(NativeBufferU32, PtrU32, native_buffer_u32, __nb_alloc_u32)

@nowrite @nomangle inline(lua) fn __nb_checked_get(buf: any, i: int) -> any = """
    if i < 0 or i >= buf.len then
        error("NativeBuffer index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(buf.len) .. ")")
    end
    return buf.ptr[i]
"""

// After reseating buf.ptr in inline Lua, refresh its leaf views: ffi.cast
// does not keep the old allocation alive and the compiler cannot see the write.
@nomangle inline(lua) fn __nb_refresh_views(buf: any) = """
    for field, cast_ty in pairs(_G.__ROCK_LEAF_VIEWS) do
        if buf[field] ~= nil then buf[field] = ffi.cast(cast_ty, buf.ptr) end
    end
"""

// Copies share the descriptor table, so a field write lands on a fresh one
// that keeps the leaf views, reseated when `ptr` changes.
@nomangle inline(lua) fn __descriptor_with(d: any, field: string, v: any) -> any = """
    local out = {}
    for k, x in pairs(d) do out[k] = x end
    out[field] = v
    if field == "ptr" then
        for view, cast_ty in pairs(_G.__ROCK_LEAF_VIEWS) do
            if out[view] ~= nil then out[view] = ffi.cast(cast_ty, v) end
        end
    end
    return setmetatable(out, getmetatable(d))
"""

// Checks once per element, before its K leaf accesses index their views raw.
@nowrite @nomangle inline(lua) fn __nb_checked_index(buf: any, i: int) -> int = """
    if i < 0 or i >= buf.len then
        error("NativeBuffer index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(buf.len) .. ")")
    end
    return i
"""

@writes_elems @nomangle inline(lua) fn __nb_checked_set(buf: any, i: int, v: any) = """
    if i < 0 or i >= buf.len then
        error("NativeBuffer index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(buf.len) .. ")")
    end
    buf.ptr[i] = v
"""

value Arena<T> {
    _scene_id: int,
    _arena_id: int,
}

// The four coordinates identify an Arena row without retaining the store.
value Entity<T> {
    _scene_id: int,
    _arena_id: int,
    _slot: int,
    _generation: int,
}

value Scene<T> {
    _scene_id: int,
}

value SceneBuilder {
    _scene_id: int,
}

@nomangle inline(lua) fn __rock_table_tag(obj: any) -> string? = """
    local own = rawget(obj, "__ty")
    if own ~= nil then return own end
    local mt = getmetatable(obj)
    if type(mt) == "table" then return rawget(mt, "__ty") end
"""

// Flat Vecs reflect by their storage header.
@nomangle inline(lua) fn __rock_get_type(obj: any) -> string? = """
    if type(obj) ~= "table" then
        return nil
    end
    local ty = __rock_table_tag(obj)
    -- Foreign __index can supply a type and run arbitrary Lua.
    if ty == nil then ty = obj.__ty end
    if ty ~= nil then return ty end
    if rawget(obj, "len") ~= nil and type(rawget(obj, "@vec")) == "table" then return "Vec" end
    return nil
"""

// Values must not retain this owner: LuaJIT weak tables are not ephemerons.
@lua_named struct CacheOwner { retired: bool = false }

inline(lua) fn weak_cache_get<V>(name: string, owner: CacheOwner) -> V? = """
    if owner.retired then return nil end
    local owners = _G.__rock_record_caches
    local entries = owners and owners[owner]
    if entries then return entries[name] end
    return nil
"""

inline(lua) fn weak_cache_put<V>(name: string, owner: CacheOwner, value: V) = """
    if owner.retired then error("weak_cache_put requires a live owner") end
    local owners = _G.__rock_record_caches
    if not owners then
        owners = setmetatable({}, {__mode = "k"})
        _G.__rock_record_caches = owners
    end
    local entries = owners[owner]
    if not entries then entries = {}; owners[owner] = entries end
    entries[name] = value
    local counts = _G.__rock_weak_cache_builds
    if not counts then counts = {}; _G.__rock_weak_cache_builds = counts end
    counts[name] = (counts[name] or 0) + 1
"""

inline(lua) fn weak_cache_drop(name: string, owner: CacheOwner) = """
    local owners = _G.__rock_record_caches
    local entries = owners and owners[owner]
    if entries then
        entries[name] = nil
        if next(entries) == nil then owners[owner] = nil end
    end
"""

inline(lua) fn cache_owner_retire(owner: CacheOwner) -> bool = """
    if owner.retired then return false end
    owner.retired = true
    local owners = _G.__rock_record_caches
    if owners then owners[owner] = nil end
    return true
"""

// A read also checks the entry's backing store, so a handle whose owner was
// replaced reads cold rather than another store's value.
@nomangle inline(lua) fn __weak_cache_write(name: string, scene: int, arena: int, slot: int, generation: int, backing: any, value: any) = """
    local owners = _G.__rock_weak_cache_owners
    if not owners then owners = {}; _G.__rock_weak_cache_owners = owners end
    local scenes = owners[scene]
    if not scenes then scenes = {}; owners[scene] = scenes end
    local entries = scenes
    if arena ~= -1 then
        local slots = scenes[arena]
        if not slots then slots = {}; scenes[arena] = slots end
        entries = slots[slot]
        if not entries then entries = {}; slots[slot] = entries end
    end
    entries[name] = { generation = generation, backing = backing, value = value }
    local counts = _G.__rock_weak_cache_builds
    if not counts then counts = {}; _G.__rock_weak_cache_builds = counts end
    counts[name] = (counts[name] or 0) + 1
"""

@nomangle inline(lua) fn __weak_cache_delete(name: string, scene: int, arena: int, slot: int, generation: int) = """
    local owners = _G.__rock_weak_cache_owners
    local scenes = owners and owners[scene]
    local slots = scenes and scenes[arena]
    local entries = arena == -1 and scenes or (slots and slots[slot])
    local entry = entries and entries[name]
    if entry and entry.generation == generation then
        entries[name] = nil
        if arena ~= -1 and next(entries) == nil then
            slots[slot] = nil
            if next(slots) == nil then scenes[arena] = nil end
        end
        if next(scenes) == nil then owners[scene] = nil end
    end
"""

@inline
fn weak_cache_get<T, V>(name: string, owner: Entity<T>) -> V? {
    let value: V? = __weak_cache_entity_get(name, owner._scene_id, owner._arena_id, owner._slot, owner._generation)
    return value
}

// Keep validation and the read in one frame: sibling lookups would otherwise
// consume LuaJIT's cumulative tail-call budget.
inline(lua) fn __weak_cache_entity_get<V>(name: string, scene: int, arena: int, slot: int, generation: int) -> V? = """
    local backing = __arena_store_any(scene, arena)
    if not backing or backing.generations[slot + 1] ~= generation then
        return nil
    end
    local owners = _G.__rock_weak_cache_owners
    local scenes = owners and owners[scene]
    local slots = scenes and scenes[arena]
    local entries = arena == -1 and scenes or (slots and slots[slot])
    local entry = entries and entries[name]
    if entry and entry.generation == generation and entry.backing == backing then
        return entry.value
    end
    return nil
"""

@inline
fn weak_cache_put<T, V>(name: string, owner: Entity<T>, value: V) {
    __weak_cache_entity_put(name, owner._scene_id, owner._arena_id, owner._slot, owner._generation, value)
}

inline(lua) fn __weak_cache_entity_put<V>(name: string, scene: int, arena: int, slot: int, generation: int, value: V) = """
    local backing = __arena_store_any(scene, arena)
    if not backing or backing.generations[slot + 1] ~= generation then
        error("weak_cache_put requires a live owner")
    end
    __weak_cache_write(name, scene, arena, slot, generation, backing, value)
"""

@inline
fn weak_cache_drop<T>(name: string, owner: Entity<T>) {
    __weak_cache_delete(name, owner._scene_id, owner._arena_id, owner._slot, owner._generation)
}

@inline
fn weak_cache_get<T, V>(name: string, owner: Scene<T>) -> V? {
    // The typed getter keeps its oracle guard outside the hot loop.
    let backing = owner.get() ?? return null
    let value: V? = __weak_cache_scene_get(name, owner._scene_id, backing)
    return value
}

inline(lua) fn __weak_cache_scene_get<T, V>(name: string, scene: int, backing: T) -> V? = """
    local owners = _G.__rock_weak_cache_owners
    local scenes = owners and owners[scene]
    local entry = scenes and scenes[name]
    if entry and entry.backing == backing then return entry.value end
    return nil
"""

@inline
fn weak_cache_put<T, V>(name: string, owner: Scene<T>, value: V) {
    __weak_cache_scene_put(name, owner._scene_id, value)
}

inline(lua) fn __weak_cache_scene_put<V>(name: string, scene: int, value: V) = """
    local backing = __scene_root_any(scene)
    if not backing then
        error("weak_cache_put requires a live owner")
    end
    __weak_cache_write(name, scene, -1, -1, 0, backing, value)
"""

@inline
fn weak_cache_drop<T>(name: string, owner: Scene<T>) {
    __weak_cache_delete(name, owner._scene_id, -1, -1, 0)
}

@nomangle inline(lua) fn __weak_cache_retire(scene: int, arena: int, slot: int) = """
    local owners = _G.__rock_weak_cache_owners
    local scenes = owners and owners[scene]
    if not scenes then return end
    if arena == -1 then
        owners[scene] = nil
    else
        local slots = scenes[arena]
        if not slots then return end
        if slot == -1 then scenes[arena] = nil
        else
            slots[slot] = nil
            if next(slots) == nil then scenes[arena] = nil end
        end
        if next(scenes) == nil then owners[scene] = nil end
    end
"""

inline(lua) fn weak_cache_builds(name: string) -> int = """
    local counts = _G.__rock_weak_cache_builds
    return counts and counts[name] or 0
"""

inline(lua) fn weak_cache_live(name: string) -> int = """
    local owners = _G.__rock_weak_cache_owners
    local n = 0
    for _, entries in pairs(_G.__rock_record_caches or {}) do
        if entries[name] ~= nil then n = n + 1 end
    end
    for _, scenes in pairs(owners or {}) do
        if scenes[name] then n = n + 1 end
        for arena, slots in pairs(scenes) do
            if type(arena) == "number" then
                for _, entries in pairs(slots) do
                    if entries[name] then n = n + 1 end
                end
            end
        end
    end
    return n
"""

@nomangle inline(lua) fn __rock_is_fn_record(v: any) -> bool = """
    return _G.__rock_code_ref_kind ~= nil and _G.__rock_code_ref_kind(v) ~= nil
"""

// Register a callback to fire after each hot reload. The function value is a
// CodeRef, so a compatible body overlay refreshes it in place; captures remain
// the same value stored by the registry.
//
// Semantics:
//   - Callbacks fire in FIFO order of registration.
//   - The registry PERSISTS across firings; it is cleared only by
//     `__rock_clear_hot_reload_callbacks()` (which `clear_all_systems()` calls
//     at the start of a FULL reload, before `dofile` re-runs every `@on_reload`
//     deco-init). A body-edit OVERLAY never re-runs those deco-inits, so a fire
//     that consumed the list would leave it empty after the first light reload
//     and never fire again — the registration must survive every reload.
//   - The fire step iterates a COPY, so a callback that registers during the
//     pass lands in the next firing, not this one.
//   - The engine hot-reload pipeline invokes
//     `__rock_fire_hot_reload_callbacks()` after `dofile()` completes.
@nomangle inline(lua) fn on_hot_reload(f: fn() -> ()) = """
    if not _G.__rock_on_hot_reload then
        _G.__rock_on_hot_reload = {}
    end
    _G.__rock_on_hot_reload[#_G.__rock_on_hot_reload + 1] = f
"""

// JS: no hot reload (a browser/node program loads once); registration is a
// no-op so @on_reload-decorated fns compile unchanged.
@nomangle inline(js) fn on_hot_reload(f: fn() -> ()) = ""

@nomangle inline(lua) fn __rock_fire_hot_reload_callbacks() = """
    local src = _G.__rock_on_hot_reload or {}
    local cbs = {}
    for i = 1, #src do cbs[i] = src[i] end
    for i = 1, #cbs do
        cbs[i]()
    end
"""

// Reset the on_hot_reload callback list. Called by engine `clear_all_systems()`
// at the start of a hot reload — mirrors the behavior of clearing
// INIT_SYSTEMS/DRAW_SYSTEMS/etc, so callbacks that were registered via
// mechanisms that re-run during dofile (e.g. the @on_reload decorator)
// don't accumulate duplicates.
@nomangle inline(lua) fn __rock_clear_hot_reload_callbacks() = """
    _G.__rock_on_hot_reload = {}
"""

// @on_reload — a function decorator that registers the decorated function
// as a hot-reload callback. The deco-init body runs on every function
// definition, so after `clear_all_systems()` wipes the list and the engine
// re-runs the script, the decorated function re-registers itself.
//
// Registers the decorated function value. Its CodeRef slot makes compatible
// body edits visible without rebuilding the registry entry.
//
// This is the canonical way to hook into hot reload for global state
// that needs to refresh after reload — top-level `on_hot_reload(f)` calls
// don't work for this purpose because they live in __rock_main, which is
// HOT_RELOAD-guarded and skipped on reload.
//
deco init on_reload {
    on_hot_reload(transmute(target.func))
}

// Program entry wrapper. The assembler emits a single call to this at the
// very end of the compiled output, passing the user's `main` function as an
// argument. Skips under hot reload (the reload path re-runs top-level code
// but must not re-enter main), catches Ctrl+C cleanly, and re-raises other
// errors with their original message so stack traces point at the real fault.
@nomangle inline(lua) fn __rock_main_wrapper(main_fn: any) = """
    if _G.HOT_RELOAD then return end
    local ok, err = pcall(main_fn)
    if not ok then
        if type(err) == "string" and (err == "interrupted!" or err:match("^.+:%d+: interrupted!$")) then
            os.exit(0)
        else
            error(err, 0)
        end
    end
    local errors = _G.__rock_logged_errors
    if errors and errors.finish then
        collectgarbage("collect")
        errors.finish()
    end
"""

@nomangle inline(lua) fn __rock_native_buffer_prefix_eq(x: any, y: any, n: int) -> bool = """
    if n <= 0 then return true end
    if type(x) ~= "table" or type(y) ~= "table" then return false end
    if x.ptr == nil or y.ptr == nil then return x.ptr == y.ptr end
    if x.ptr == y.ptr then return true end
    -- Scalar indexing returns a Lua number, so measure the typed pointer step.
    local esz = ffi.cast("uint8_t*", x.ptr + 1) - ffi.cast("uint8_t*", x.ptr)
    local ysz = ffi.cast("uint8_t*", y.ptr + 1) - ffi.cast("uint8_t*", y.ptr)
    if esz ~= ysz then return false end
    return ffi.string(x.ptr, n * esz) == ffi.string(y.ptr, n * esz)
"""

@nomangle inline(lua) fn __rock_field_selected(obj: any, key: any, mode: string, views: any) -> bool = """
    if mode == "copy" or mode == "census" then return true end
    if mode == "image" then
        return key ~= "__stone_image_storage_shape"
            and not (views and views[key])
    end
    if mode == "equality" then return key ~= "__ty" end
    if mode == "map" then return type(key) == "string" end
    if mode == "json" then
        return type(key) == "string"
            and key ~= "__ty" and key ~= "__variant"
            and not (_G.__ROCK_LEAF_VIEWS and _G.__ROCK_LEAF_VIEWS[key])
    end
    if mode == "inspect" then
        return key ~= "__ty" and key ~= "__variant"
            and not (_G.__ROCK_LEAF_VIEWS and _G.__ROCK_LEAF_VIEWS[key])
            and not (type(key) == "string" and string.find(key, ".", 1, true))
    end
    error("unknown Rock field walk mode: " .. tostring(mode), 0)
"""

@nomangle inline(lua) fn __rock_field_keys(obj: any, mode: string) -> any = """
    local keys = {}
    for key in pairs(obj) do
        if __rock_field_selected(obj, key, mode, nil) then
            keys[#keys + 1] = key
        end
    end
    return keys
"""

@nomangle inline(lua) fn __rock_field_declaration(obj: any) -> any = """
    local name = __rock_table_tag(obj)
    if name == nil then name = obj.__ty end
    local types = _G.__ROCK_TYPE_TABLE
    return type(name) == "string" and types and types[name] or nil
"""

@nomangle inline(lua) fn __rock_field_pairs(obj: any, mode: string) -> any = """
    if mode == "copy" then return pairs(obj) end
    error("unknown unsorted Rock field walk mode: " .. tostring(mode), 0)
"""

@intrinsic @nomangle inline(lua) fn __op_eq(a: any, b: any) -> bool = """
    -- Primitive fast path
    if type(a) ~= "table" or type(b) ~= "table" then
        return a == b
    end

    -- Same reference
    if a == b then return true end

    local type_a = __rock_get_type(a)
    local type_b = __rock_get_type(b)

    -- A capturing-lambda env record is a callable value, not a data table: it
    -- compares as an opaque LEAF by IDENTITY, never by walking its capture
    -- fields (mirrors the inspect/serialize record rule). Two distinct closure
    -- instances with equal captures are NOT equal; the same instance already
    -- returned true above. A record carries no `__ty`, so gate on `not type_a`:
    -- a tagged struct/enum compare skips the getmetatable probe entirely.
    if not type_a and __rock_is_fn_record(a) then
        return rawequal(a, b)
    end

    -- Different Rock types are never equal
    if type_a and type_b and type_a ~= type_b then
        return false
    end

    -- Vec equality is over its live elements, not its backing capacity or
    -- representation metadata. Each element type has one compiler-selected
    -- representation, so unequal representations cannot be values of the same
    -- concrete Vec type.
    if type_a == "Vec" or type_b == "Vec" then
        if type_a ~= "Vec" or type_b ~= "Vec" then
            return false
        end
        local ah, bh = rawget(a, "@vec"), rawget(b, "@vec")
        local ar = type(ah) == "table" and ah.repr or "boxed"
        local br = type(bh) == "table" and bh.repr or "boxed"
        local len = a[0] or a.len
        if ar ~= br or len ~= (b[0] or b.len) then return false end
        if ar == "strided" then
            if ah.elem ~= bh.elem or ah.stride ~= bh.stride then return false end
            for i = 1, len * ah.stride do
                if not __op_eq(a._data[i], b._data[i]) then return false end
            end
            return true
        end
        if ar == "columns" then
            if ah.elem ~= bh.elem then return false end
            for k, col in pairs(a) do
                if k ~= "len" and k ~= "@vec" then
                    local other = b[k]
                    if type(col) ~= "table" or type(other) ~= "table" then return false end
                    for i = 1, len do
                        if not __op_eq(col[i], other[i]) then return false end
                    end
                end
            end
            for k, _ in pairs(b) do
                if k ~= "len" and k ~= "@vec" and a[k] == nil then
                    return false
                end
            end
            return true
        end
        for i = 1, len do
            if not __op_eq(a[i], b[i]) then return false end
        end
        return true
    end

    -- FlatVec / NativeBuffer equality is over the first `len` elements'
    -- BYTES: the elements are FFI-clean value structs (or primitives) living
    -- inline in one C array, so byte equality is their value equality, with
    -- the one caveat that a float compares bitwise here (0.0 ~= -0.0, NaN ==
    -- NaN). Without this case the generic walk reached the NativeBuffer's
    -- cdata pointer, which the primitive fast path compares by ADDRESS, so
    -- two FlatVecs with equal contents were never equal.
    if type_a == "FlatVec" or type_b == "FlatVec" then
        if type_a ~= "FlatVec" or type_b ~= "FlatVec" or a.len ~= b.len then
            return false
        end
        return __rock_native_buffer_prefix_eq(a.buf, b.buf, a.len)
    end
    if type_a == "NativeBuffer" or type_b == "NativeBuffer" then
        if type_a ~= "NativeBuffer" or type_b ~= "NativeBuffer" or a.len ~= b.len then
            return false
        end
        return __rock_native_buffer_prefix_eq(a, b, a.len)
    end

    -- A GC-carrying value struct (table repr) carries a per-type `__eq`
    -- metatable that is the AUTHORITY: scalar/value fields structural, GC-ref
    -- fields BY REFERENCE. The `a == b` reference check above already invoked it
    -- (LuaJIT fires `__eq` on two same-metamethod tables); reaching here means it
    -- returned false, so they are unequal -- do NOT fall through to the generic
    -- structural walk (which would compare a GC-ref field by contents).
    local mt = getmetatable(a)
    if mt and mt.__eq then
        return false
    end

    -- Structural equality: walk fields (skipping the `__ty` tag). Covers
    -- structs, enums, newtypes, tuples, and anonymous Lua tables alike; cdata
    -- `value` structs never reach here (they hit the primitive `==` fast path
    -- above -- a byte-value compare).
    for k, v in pairs(a) do
        if __rock_field_selected(a, k, "equality", nil) and not __op_eq(v, b[k]) then return false end
    end
    for k, v in pairs(b) do
        if __rock_field_selected(b, k, "equality", nil) and a[k] == nil then return false end
    end
    return true
"""

@intrinsic @nomangle inline(lua) fn __op_ne(a: any, b: any) -> bool = """
    return not __op_eq(a, b)
"""

// Equality is structural; reference identity requires a native backend mapping.
@intrinsic @native_required @pure @inline
inline(lua) fn same_ref<A, B>(@repr(opaque) a: A, @repr(opaque) b: B) -> bool = "rawequal(a, b)"

@nomangle inline(lua) fn __rock_create_struct(typeName: string, fields: any) -> any = """
    return setmetatable(fields or {}, __rock_box_mts[typeName])
"""

@intrinsic @nomangle @inline inline(lua) fn __range(start_val: int, end_val: int) -> any = """
    local t = {}
    for i = start_val, end_val - 1 do
        table.insert(t, i)
    end
    t[0] = end_val - start_val
    return setmetatable(t, __rock_box_mts.Vec)
"""

@intrinsic @nomangle @inline inline(lua) fn __range_uint(start_val: uint, end_val: uint) -> any = """
    local t = {}
    for i = start_val, end_val - 1 do
        table.insert(t, i)
    end
    t[0] = end_val - start_val
    return setmetatable(t, __rock_box_mts.Vec)
"""

// Fixed-operator syntax lowers directly. Arithmetic signatures participate in overload resolution.
@pure @inline operator ==(a: int, b: int) -> bool { return a == b }
@pure @inline operator ==(a: uint, b: uint) -> bool { return a == b }
@pure @inline operator ==(a: float, b: float) -> bool { return a == b }
@pure @inline operator ==(a: bool, b: bool) -> bool { return a == b }
@pure @inline operator !=(a: int, b: int) -> bool { return a != b }
@pure @inline operator !=(a: uint, b: uint) -> bool { return a != b }
@pure @inline operator !=(a: float, b: float) -> bool { return a != b }
@pure @inline operator !=(a: bool, b: bool) -> bool { return a != b }

@pure @inline operator +(a: int, b: int) -> int { return a + b }
@pure @inline operator +(a: uint, b: uint) -> uint { return a + b }
@pure @inline operator +(a: float, b: float) -> float { return a + b }
@pure @inline operator -(a: int, b: int) -> int { return a - b }
@pure @inline operator -(a: uint, b: uint) -> uint { return a - b }
@pure @inline operator -(a: float, b: float) -> float { return a - b }
@pure @inline operator *(a: int, b: int) -> int { return a * b }
@pure @inline operator *(a: uint, b: uint) -> uint { return a * b }
@pure @inline operator *(a: float, b: float) -> float { return a * b }
@pure @inline operator /(a: float, b: float) -> float { return a / b }
@pure @inline operator ./(a: int, b: int) -> int { return a ./ b }
@pure @inline operator ./(a: uint, b: uint) -> uint { return a ./ b }
@pure @inline operator %(a: int, b: int) -> int { return a % b }
@pure @inline operator %(a: uint, b: uint) -> uint { return a % b }
@pure @inline operator %(a: float, b: float) -> float { return a % b }

@pure @inline operator <(a: int, b: int) -> bool { return a < b }
@pure @inline operator <(a: uint, b: uint) -> bool { return a < b }
@pure @inline operator <(a: float, b: float) -> bool { return a < b }
@pure @inline operator <=(a: int, b: int) -> bool { return a <= b }
@pure @inline operator <=(a: uint, b: uint) -> bool { return a <= b }
@pure @inline operator <=(a: float, b: float) -> bool { return a <= b }
@pure @inline operator >(a: int, b: int) -> bool { return a > b }
@pure @inline operator >(a: uint, b: uint) -> bool { return a > b }
@pure @inline operator >(a: float, b: float) -> bool { return a > b }
@pure @inline operator >=(a: int, b: int) -> bool { return a >= b }
@pure @inline operator >=(a: uint, b: uint) -> bool { return a >= b }
@pure @inline operator >=(a: float, b: float) -> bool { return a >= b }

@pure @inline operator &&(a: bool, b: bool) -> bool { return a && b }
@pure @inline operator ||(a: bool, b: bool) -> bool { return a || b }

@pure @inline operator -(a: int) -> int { return -a }
@pure @inline operator -(a: float) -> float { return -a }
@pure @inline operator !(a: bool) -> bool { return !a }
@pure @inline operator ~(a: int) -> int { return ~a }

@pure @inline operator +(a: string, b: string) -> string { return a + b }
@pure @inline operator ==(a: string, b: string) -> bool { return a == b }
@pure @inline operator !=(a: string, b: string) -> bool { return a != b }

// Direct calls to the legacy uint overloads expose a signed 32-bit result.
@pure @inline inline(lua) fn __legacy_uint_bits(value: int) -> uint = "return value"
@pure @inline inline(js) fn __legacy_uint_bits(value: int) -> uint = "return value | 0;"

@pure @inline operator &(a: int, b: int) -> int { return a & b }
@pure @inline operator &(a: uint, b: uint) -> uint { return __legacy_uint_bits((a as int) & (b as int)) }
@pure @inline operator |(a: int, b: int) -> int { return a | b }
@pure @inline operator |(a: uint, b: uint) -> uint { return __legacy_uint_bits((a as int) | (b as int)) }
@pure @inline operator ^(a: int, b: int) -> int { return a ^ b }
@pure @inline operator ^(a: uint, b: uint) -> uint { return __legacy_uint_bits((a as int) ^ (b as int)) }
@pure @inline operator <<(a: int, b: int) -> int { return a << b }
@pure @inline operator <<(a: uint, b: uint) -> uint { return __legacy_uint_bits((a as int) << (b as int)) }
@pure @inline operator >>(a: int, b: int) -> int { return a >> b }
@pure @inline operator >>(a: uint, b: uint) -> uint { return __legacy_uint_bits((a as int) >> (b as int)) }

// Foreign values can run mutating __tostring callbacks while being printed.
// Debug-only impurity demotes pure callers with a warning.
@debug_impure
@intrinsic extern(lua) fn print(args: ...any)

@nowrite @intrinsic extern(lua) fn error(message: string)

// A foreign value's __tostring callback can mutate Rock state.
@intrinsic extern(lua) fn tostring(value: any) -> string

fn to_string(value: int) -> string { return tostring(value) }

fn to_string(value: uint) -> string { return tostring(value) }

fn to_string(value: float) -> string {
    let str_value = tostring(value)
    // Mark integral values as floats. Exponent forms ("1e+16") and
    // non-finite values ("inf", "nan") already read as floats; a ".0"
    // suffix would make them unparseable.
    for i in 0..str_value.len() {
        let c = str_value.unit_at(i)
        if (c < 48 || c > 57) && !(i == 0 && c == 45) { return str_value }
    }
    return str_value + ".0"
}

@inline fn to_string(value: string) -> string { return value }

fn to_string(value: bool) -> string { return tostring(value) }

@nomangle inline(lua) fn to_string(value: any) -> string = """
    if value == nil then
        return "nil"
    end
    -- For tables (structs, arrays, etc.), use Rock's inspect for type-aware formatting
    if type(value) == "table" then
        return inspect(value)  -- This calls the Rock stdlib inspect function
    end
    return tostring(value)
"""

fn assert(condition: bool, message: string) {
    if !condition { error(message) }
}

fn assert(condition: bool) {
    if !condition { error("Assertion failed") }
}

fn assert_error_logs(expected: [string], body: fn() -> ()) {
    __rock_assert_error_logs(__rock_vec_to_lua_array(expected), body)
}

inline(lua) fn __rock_assert_error_logs(expected: any, body: fn() -> ()) = """
    local log = assert(_G.__rock_logged_errors,
        "assert_error_logs requires rock test, rock sim or a bounded rock frame")
    local first = #log.scope_records() + 1
    body()
    local records = log.scope_records()
    local actual = {}
    for i = first, #records do actual[#actual + 1] = records[i] end
    local matches = #actual == #expected
    for i, message in ipairs(actual) do
        if message ~= expected[i] then matches = false end
    end
    if not matches then
        error("error log mismatch: expected <" .. table.concat(expected, "\n") ..
            "> got <" .. table.concat(actual, "\n") .. ">", 0)
    end
    for _, record in ipairs(actual) do assert(log.scope_take(record)) end
"""

macro assert_eq(actual: expr, expected: expr, message: expr = "Values should be equal") {
    let __actual = actual
    let __expected = expected
    if !(__actual == __expected) {
        error("Assertion failed: " + tostring(message) + " (expected: " + tostring(__expected) + ", got: " + tostring(__actual) + ")")
    }
}

macro assert_ne(actual: expr, expected: expr, message: expr = "Values should not be equal") {
    let __actual = actual
    let __expected = expected
    if __actual == __expected {
        error("Assertion failed: " + tostring(message) + " (both values are: " + tostring(__actual) + ")")
    }
}

fn assert_true(condition: bool, message: string = "Expected true") {
    if !condition {
        let error_msg = "Assertion failed: " + tostring(message)
        error(error_msg)
    }
}

fn assert_false(condition: bool, message: string = "Expected false") {
    if condition {
        let error_msg = "Assertion failed: " + tostring(message)
        error(error_msg)
    }
}

fn assert_not_null<T>(value: T?, message: string = "Expected non-null value") {
    if value == null {
        let error_msg = "Assertion failed: " + tostring(message)
        error(error_msg)
    }
}

fn assert_null<T>(value: T?, message: string = "Expected null value") {
    if value != null {
        let error_msg = "Assertion failed: " + tostring(message)
        error(error_msg)
    }
}

@nowrite @intrinsic @inline fn vec_new<T>() -> [T] { return [] }

// Column and strided vectors intercept these bridges in lowering.
inline(lua) fn __rock_vec_to_lua_array<T>(vec: [T]) -> any = """
    local out = {}
    for i = 1, vec[0] do out[i] = vec[i] end
    return out
"""

inline(lua) fn __rock_vec_from_lua_array<T>(arr: any, len: int) -> [T] = """
    arr[0] = len
    return setmetatable(arr, __rock_box_mts.Vec)
"""

// The element type drives inference from a push into an empty Vec.
@intrinsic @relocates @inline inline(lua) fn vec_push<T>(vec: [T], @repr(opaque) item: T) = """
    vec[0] = vec[0] + 1
    vec[vec[0]] = item
"""

@inline fn vec_get<T>(vec: [T], index: int) -> T? {
    if index < 0 || index >= vec.len {
        return null
    }
    return cast(__vec_data_get(vec, index))
}

@inline fn Vec<T>.get(vec, index: int) -> T? {
    return vec_get(vec, index)
}

fn vec_set<T>(vec: [T], index: int, value: T) {
    if index < 0 || index >= vec.len {
        error("Vec.set index out of bounds: index {index} is outside [0, {vec.len})")
    }
    __vec_data_set(vec, index, value)
}

@nomangle inline(lua) fn __vec_checked_get(vec: any, i: int) -> any = """
    if i < 0 or i >= vec[0] then
        error("Vec index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(vec[0]) .. ")")
    end
    return vec[i + 1]
"""

@nomangle inline(lua) fn __vec_checked_index(vec: any, i: int) -> int = """
    if i < 0 or i >= vec.len then
        error("Vec index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(vec.len) .. ")")
    end
    return i + 1
"""

@nomangle inline(lua) fn __vec_checked_set(vec: any, i: int, v: any) = """
    if i < 0 or i >= vec[0] then
        error("Vec index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(vec[0]) .. ")")
    end
    vec[i + 1] = v
"""

@pure fn vec_len<T>(vec: [T]) -> int {
    return vec.len
}

@intrinsic @native_required inline(lua) fn __vec_cache_key<T>(vec: [T]) -> int = """
    local keys = _G.__rock_vec_cache_keys
    if keys == nil then
        keys = setmetatable({}, {__mode = "k"})
        _G.__rock_vec_cache_keys = keys
        _G.__rock_vec_cache_next = 0
    end
    local key = keys[vec]
    if key == nil then
        key = _G.__rock_vec_cache_next + 1
        _G.__rock_vec_cache_next = key
        keys[vec] = key
    end
    return key
"""

@intrinsic @relocates @inline inline(lua) fn Vec<T>.push(vec, @repr(opaque) item: T) = """
    vec[0] = vec[0] + 1
    vec[vec[0]] = item
"""
@inline fn Vec<T>.set(vec, index: int, value: T) { vec_set(vec, index, value) }
@pure @inline fn Vec<T>.len(vec) -> int { return vec_len(vec) }


fn Vec<T>.pop(vec) -> T? {
    if vec.len == 0 {
        return null
    }
    let value: T? = cast(__vec_data_get(vec, vec.len - 1))
    __vec_data_unset(vec, vec.len - 1)
    vec.len = vec.len - 1
    return value
}

@pure fn Vec<T>.is_empty(vec) -> bool {
    return vec.len == 0
}

fn Vec<T>.clear(vec) {
    for i in 0..vec.len {
        __vec_data_unset(vec, i)
    }
    vec.len = 0
}

fn Vec<T>.remove_at(vec, index: int) -> T? {
    if index < 0 || index >= vec.len {
        return null
    }
    let value: T? = cast(__vec_data_get(vec, index))
    for i in index..(vec.len - 1) {
        __vec_data_set(vec, i, cast(__vec_data_get(vec, i + 1)))
    }
    __vec_data_unset(vec, vec.len - 1)
    vec.len = vec.len - 1
    return value
}

fn Vec<T>.swap_remove(vec, index: int) -> T? {
    if index < 0 || index >= vec.len {
        return null
    }
    let value: T? = cast(__vec_data_get(vec, index))
    if index + 1 < vec.len {
        __vec_data_set(vec, index, cast(__vec_data_get(vec, vec.len - 1)))
    }
    __vec_data_unset(vec, vec.len - 1)
    vec.len = vec.len - 1
    return value
}

fn Map<K, V>.enumerate(collection) -> [(int, (K, V))] {
    let out: [(int, (K, V))] = []
    let i = 0
    for (k, v) in collection {
        out.push((i, (k, v)))
        i = i + 1
    }
    return out
}

fn enumerate<T>(collection: NativeBuffer<T>) -> [(int, T)] {
    let out: [(int, T)] = vec_new()
    for i in 0..collection.len {
        out.push((i, collection[i]))
    }
    return out
}

fn Vec<T>.rev(collection) -> [T] {
    let out: [T] = []
    let n = collection.len
    for i in 0..n {
        out.push(collection[n - 1 - i])
    }
    return out
}

fn __op_null_coalesce<T>(a: T?, b: T) -> T { return a ?? b }

fn __op_null_coalesce<T>(a: T?, b: T?) -> T? { return a ?? b }

@noalloc @nowrite @intrinsic @nomangle @inline fn is_null(value: any) -> bool { return value == null }

// Out of line, so a failing site is one call. Level 2 is the function that
// unwrapped, for both the error position and the traceback.
@nowrite @intrinsic inline(lua) fn __unwrap_failed(message: string) = """
    error(message .. "\n" .. debug.traceback("", 2), 2)
"""

@noalloc @inline fn unwrap<T>(@unwraps value: T?) -> T {
    if value != null { return value }
    __unwrap_failed("unwrap() called on null value")
    return phantom()
}

fn unwrap_or<T>(@unwraps value: T?, alt: T) -> T {
    return value ?? alt
}

fn expect<T>(@unwraps value: T?, message: string) -> T {
    if value != null { return value }
    __unwrap_failed("expect() failed: " + message)
    return phantom()
}

// Concrete overloads, not generic: an unconstrained `min<T>` shape-matches
// every two-arg call and ties with specialized overloads like `Vec2.min`.
@intrinsic @pure fn max(a: int, b: int) -> int {
    if a > b { return a } else { return b }
}

@intrinsic @pure fn max(a: float, b: float) -> float {
    if a > b { return a } else { return b }
}

@intrinsic @pure fn min(a: int, b: int) -> int {
    if a < b { return a } else { return b }
}

@intrinsic @pure fn min(a: float, b: float) -> float {
    if a < b { return a } else { return b }
}


@intrinsic @pure fn clamp(value: float, min: float, max: float) -> float {
    if value < min {
        return min
    } else if value > max {
        return max
    } else {
        return value
    }
}

@nowrite @inline inline(lua) fn typeof(x: any) -> string = "type(x)"

@intrinsic @pure @inline fn int_to_float(value: int) -> float { return value as float }
@intrinsic @pure @inline fn to_float(value: int) -> float { return value as float }

@nowrite fn float_to_int(value: float) -> int {
    let kind = typeof(value)
    if kind != "number" {
        error("Expected a number, got " + kind)
    }
    return value as int
}

@inline fn to_int(value: float) -> int { return float_to_int(value) }

// The name-keyed registry requires an ffi.istype scan. Cache by CTypeID,
// including misses, and reset the cache whenever registry rows are re-emitted.
@nomangle inline(lua) fn __rock_c_struct_of(x: any) -> any = """
    local reg = _G.__ROCK_C_STRUCT
    if not reg then return nil end
    local memo = _G.__ROCK_C_STRUCT_BY_CTYPE
    if not memo then
        memo = {}
        _G.__ROCK_C_STRUCT_BY_CTYPE = memo
    end
    local id = tonumber(ffi.typeof(x))
    local hit = memo[id]
    if hit ~= nil then return hit or nil end
    hit = false
    for _, info in pairs(reg) do
        if ffi.istype(info.name, x) then
            hit = info
            break
        end
    end
    memo[id] = hit
    return hit or nil
"""

@nomangle inline(lua) fn __rock_enum_unit(ty: string, variant: string) -> any = """
    local units = _G.__ROCK_ENUM_UNITS
    local variants = units and units[ty]
    return variants and variants[variant] or nil
"""

// Record each copy before recursing to preserve aliases and cycles.
// Hoisting avoids a closure allocation; opaque Lua calls this by name.
@intrinsic @nomangle inline(lua) fn __rock_deepcopy_value(obj: any, seen: any) -> any = """
    -- Opaque resource hooks clone ownership; the shared memo preserves aliases.
    if type(obj) == "userdata" then
        if seen[obj] then return seen[obj] end
        local mt = getmetatable(obj)
        local clone = type(mt) == "table" and rawget(mt, "__deepcopy")
        if clone then
            local copy = clone(obj)
            seen[obj] = copy
            return copy
        end
        return obj
    end
    if type(obj) == "cdata" then
        -- Storage first: an off-heap struct buffer is a `T*`, which
        -- `__rock_c_struct_of` would take for one struct.
        local desc, bytes = __rock_nb_storage_of(obj)
        if desc then
            if seen[obj] then return seen[obj] end
            if bytes % desc.elem_size ~= 0 then
                error("deepcopy: described storage has incomplete elements", 0)
            end
            local copy = __rock_nb_alloc(desc.ctype, bytes / desc.elem_size)
            seen[obj] = copy
            ffi.copy(copy, obj, bytes)
            return copy
        end
        local info = __rock_c_struct_of(obj)
        if info then return info.copy(obj) end
        -- Foreign pointers have no owned storage description to copy.
        return obj
    end
    if type(obj) ~= "table" then
        return obj
    end
    -- Slots are published in place; environments still own copied captures.
    if _G.__rock_code_ref_kind and _G.__rock_code_ref_kind(obj) == "slot" then
        return obj
    end
    local variant = rawget(obj, "__variant")
    if variant ~= nil then
        local unit = __rock_enum_unit(__rock_table_tag(obj), variant)
        if unit then return unit end
    end
    if seen[obj] then
        return seen[obj]
    end

    local copy = {}
    seen[obj] = copy
    local storage_views
    for k, v in __rock_field_pairs(obj, "copy") do
        -- copy *both* key and value, in case either is a table.
        local copied_key = __rock_deepcopy_value(k, seen)
        local copied_value = __rock_deepcopy_value(v, seen)
        copy[copied_key] = copied_value
        if type(v) == "cdata" then
            local desc = __rock_nb_storage_of(v)
            if desc and next(desc.views) then
                storage_views = storage_views or {}
                storage_views[#storage_views + 1] = { source = v, target = copied_value, views = desc.views }
            end
        end
    end
    if storage_views then
        for _, shape in ipairs(storage_views) do
            local base = ffi.cast("uintptr_t", shape.source)
            for field, cast_ty in pairs(shape.views) do
                local view = rawget(obj, field)
                if type(view) == "cdata" and ffi.istype(cast_ty, view)
                    and ffi.cast("uintptr_t", view) == base then
                    copy[field] = ffi.cast(cast_ty, shape.target)
                end
            end
        end
    end
    -- Preserve the metatable: a capturing lambda is an env record carrying
    -- `__rock_fn_mt` (its `__call` is what makes it invokable) -- a copy that
    -- drops it is an uncallable table. General, not fn-record-special-cased.
    setmetatable(copy, getmetatable(obj))

    return copy
"""

// Not `@nomangle`: nothing calls this by its bare name. `@nomangle` is what
// creates a bare-name obligation for opaque text to call, and these are reached
// only through ordinary Rock calls and the column intercept, which match the
// Rock name rather than the emitted symbol.
@intrinsic inline(lua) fn deepcopy<T>(obj: T) -> T = """
    return __rock_deepcopy_value(obj, {})
"""

@intrinsic @native_required inline(lua) fn clone_into<T>(value: T, storage: Storage) -> T = """
    return __rock_deepcopy_value(value, {})
"""

@intrinsic @native_required inline(lua) fn map_storage<K, V>(@repr(opaque) map: Map<K, V>) -> Storage = """
    return nil
"""

@materialize @intrinsic @pure fn materialize<T>(value: T) -> T {
    return value
}

// Casts only reshape the Rock type; their runtime representation is unchanged.
@intrinsic @inline inline(lua) fn cast<T>(value: any) -> T = "return value"
@nowrite @intrinsic @inline inline(lua) fn transmute<A, B>(x: A) -> B = "return x"

@intrinsic @pure @inline fn float(value: int) -> float { return value as float }

@intrinsic inline(lua) fn resume<Y, R, N>(c: Coroutine<Y, R, N>) -> Y? = """
    return c.__resume(c)
"""

@intrinsic inline(lua) fn resume<Y, R, N>(c: Coroutine<Y, R, N>, arg: N) -> Y? = """
    return c.__resume(c, arg)
"""

@intrinsic inline(lua) fn result<Y, R, N>(c: Coroutine<Y, R, N>) -> R? = """
    return c.__return
"""

@intrinsic inline(lua) fn status<Y, R, N>(c: Coroutine<Y, R, N>) -> string = """
    if c.__state < 0 then return "dead" else return "suspended" end
"""

// Only natural completion makes result() trustworthy. Cancellation and an
// escaping error leave completed() false, even though status() is "dead".
@intrinsic inline(lua) fn completed<Y, R, N>(c: Coroutine<Y, R, N>) -> bool = """
    return c.__state == -3
"""

// Liveness comes from `status()`, not a null sentinel, so a body that yields
// null still produces real null elements.
fn next<Y, R>(c: Coroutine<Y, R, ()>) -> (bool, Y) {
    let y = resume(c)
    if status(c) == "suspended" {
        return (true, cast(y))
    }
    return (false, phantom())
}

// Kill a coroutine. Fires the on_killed hook (if registered) and
// transitions state to terminal. Further resumes return nil. Idempotent:
// calling kill twice only fires the hook once.
// Run a dying coroutine's still-pending terminal defers, LIFO, each body
// pcall'd so one failing defer is logged and the rest still run. `__defers`
// holds the per-site defer fns BY VALUE (creation-time), so a stale frame
// (hot-reload stamp-kill) runs cleanup matching ITS layout. @nomangle: called
// from __rock_coroutine_kill's inline body and from compiler-emitted ctors.
@nomangle inline(lua) fn __rock_coroutine_run_defers(c: any) = """
    if not c.__defers then return end
    for i = #c.__defers, 1, -1 do
        local ok, err = pcall(c.__defers[i], c)
        if not ok then __rock_log(0, "CO", "coroutine defer failed during cleanup: " .. tostring(err)) end
    end
"""

// Recursive kill core: terminal-mark, chain into the delegated inner
// (`await` stores it at `__inner`), run pending terminal defers, fire the
// on_killed hook. @nomangle: calls ITSELF by name and is called from kill()'s
// inline(lua) body.
@nomangle inline(lua) fn __rock_coroutine_kill(c: any) = """
    if c.__state == -1 or c.__state == -3 then return end
    c.__state = -1
    if c.__inner then __rock_coroutine_kill(c.__inner) end
    __rock_coroutine_run_defers(c)
    if c.__on_killed then c.__on_killed(c) end
"""

@intrinsic inline(lua) fn kill<Y, R, N>(c: Coroutine<Y, R, N>) = """
    __rock_coroutine_kill(c)
"""

@intrinsic inline(lua) fn fire_hot_reload<Y, R, N>(c: Coroutine<Y, R, N>) = """
    __rock_coroutine_fire_hot_reload(c)
"""

// on_resume and on_killed must be called inside a co fn body; the compiler
// relocates the call to constructor time so the hook sees the first resume.
inline(lua) fn on_resume(f: fn() -> ()) = """
    error("on_resume can only be called inside a co fn body")
"""

inline(lua) fn on_killed(f: fn() -> ()) = """
    error("on_killed can only be called inside a co fn body")
"""

@nowrite @intrinsic inline(lua) fn table_new() -> any = """return {}"""

// Trampoline primitives — these are one-line Lua bodies that the JIT
// can't see through when emitted as a function (frame inlining tripped
// `loop unroll limit reached` in per-frame paths like vec_push /
// vec_get). Marked `@inline inline(lua)` so codegen splices the body
// at every call site instead of emitting + calling.
//
@intrinsic @inline inline(lua) fn table_len(tbl: any) -> int = """
    return #tbl
"""

@intrinsic @native_required @inline inline(lua) fn table_get(tbl: any, index: any) -> any = """
    return tbl[index]
"""

@intrinsic @native_required @inline inline(lua) fn table_set(tbl: any, index: any, value: any) = """
    tbl[index] = value
"""

@inline inline(lua) fn field_get<T, V>(o: T, f: ReadFieldRef<T, V>) -> V = """
    local mt = type(o) == "table" and getmetatable(o)
    local slots = type(mt) == "table" and mt.__rock_slots
    return o[slots and slots[f] or f]
"""

@inline inline(lua) fn field_set<T, V>(o: T, f: WriteFieldRef<T, V>, v: V) = """
    local mt = type(o) == "table" and getmetatable(o)
    local slots = type(mt) == "table" and mt.__rock_slots
    o[slots and slots[f] or f] = v
"""

// Both callers unset only present keys.
@intrinsic @relocates @inline inline(lua) fn table_unset<K, V>(tbl: Map<K, V>, index: K) = """
    tbl[index] = nil
"""

// Each backend translates the logical index into its native array base.
@intrinsic @inline inline(lua) fn __vec_data_get<T>(vec: [T], index: int) -> any = "return vec[index + 1]"
@intrinsic @inline inline(lua) fn __vec_data_set<T>(vec: [T], index: int, @repr(opaque) value: T) = "vec[index + 1] = value"
@intrinsic @relocates @inline inline(lua) fn __vec_data_unset<T>(vec: [T], index: int) = "vec[index + 1] = nil"

@intrinsic inline(lua) fn __vec_data_alloc<T>(capacity: int) -> [T] = """
    local vec = __rock_table_new(math.max(capacity, 0), 0)
    for i = 1, capacity do vec[i] = false end
    vec[0] = 0
    return setmetatable(vec, __rock_box_mts.Vec)
"""

@intrinsic inline(lua) fn __vec_data_capacity<T>(vec: [T]) -> int = "return #vec"

@intrinsic @relocates inline(lua) fn __vec_data_insert<T>(vec: [T], lua_index: int, value: T) = """
    table.insert(vec, lua_index, value)
"""

@intrinsic inline(lua) fn __vec_data_clone<T>(vec: [T]) -> [T] = """
    local n = math.max(vec[0], #vec)
    local copy = __rock_table_new(n, 0)
    for i = 0, n do copy[i] = vec[i] end
    return setmetatable(copy, __rock_box_mts.Vec)
"""

@intrinsic @relocates inline(lua) fn __vec_data_sort<T, K>(vec: [T], key_fn: fn(T) -> K) = """
    local outer = __rock_sort_key
    __rock_sort_key = key_fn
    table.sort(vec, __rock_sort_by_key)
    __rock_sort_key = outer
"""

// One shared comparator, so a sort allocates no closure (FNEW also aborts
// traces). A sort inside a key function can raise and be caught before the key
// returns, leaving its own key installed; re-installing ours after each key
// call keeps the rest of this sort on the right key.
@nomangle inline(lua) fn __rock_sort_by_key(a: any, b: any) -> bool = """
    local key = __rock_sort_key
    local ka, kb = key(a), key(b)
    __rock_sort_key = key
    return ka < kb
"""

// `len` is passed in: a nullable field's column holds real nils, and `#` on a
// table with holes is undefined, which would desync sibling columns.
@nomangle inline(lua) fn __rock_col_insert(col: any, lua_index: int, len: int, value: any) = """
    for i = len, lua_index, -1 do col[i + 1] = col[i] end
    col[lua_index] = value
"""

@nomangle inline(lua) fn __rock_col_copy(col: any, len: int) -> any = """
    local copy = {}
    for i = 1, len do copy[i] = col[i] end
    return copy
"""

@nomangle fn __rock_col_capacity(reserved: int, physical: int) -> int {
    if reserved > physical { return reserved }
    return physical
}

// Appends realize the reservation once; clear releases leaves, not backing
// storage.
@nomangle inline(lua) fn __rock_stride_reserve(vec: any, len: int) = """
    local h = rawget(vec, "@vec")
    if h.cap == 0 or h.reserved then return end
    if h.cap > len then
        local data = __rock_table_new(h.cap * h.stride, 0)
        for i = 1, len * h.stride do data[i] = vec._data[i] end
        vec._data = data
    end
    h.reserved = true
"""

@nomangle fn __rock_stride_capacity(
    reserved: int,
    physical: int,
    stride: int
) -> int {
    let populated = physical ./ stride
    if reserved > populated { return reserved }
    return populated
}

@nomangle inline(lua) fn __rock_stride_insert(
    data: any,
    lua_index: int,
    len: int,
    stride: int
) = """
    local start = (lua_index - 1) * stride + 1
    for i = len * stride, start, -1 do data[i + stride] = data[i] end
    for i = start, start + stride - 1 do data[i] = false end
"""

@nomangle inline(lua) fn __rock_stride_copy(data: any, len: int, stride: int) -> any = """
    local copy = {}
    for i = 1, len * stride do copy[i] = data[i] end
    return copy
"""

@nomangle inline(lua) fn __rock_stride_sort(
    vec: any,
    key_fn: any,
    stride: int
) = """
    local n, data = vec.len or 0, vec._data
    local order = {}
    for i = 1, n do order[i] = i end
    local function key_at(row)
        return key_fn(__rock_materialize_strided_element(vec, row))
    end
    table.sort(order, function(a, b) return key_at(a) < key_at(b) end)
    local sorted = {}
    for row = 1, n do
        local source = (order[row] - 1) * stride
        local target = (row - 1) * stride
        for j = 1, stride do sorted[target + j] = data[source + j] end
    end
    for i = 1, n * stride do data[i] = sorted[i] end
"""

// Leaves are copied with explicit bounds because a raw row may hold nil.
@nomangle inline(lua) fn __rock_stride_sort_leaves(vec: any, key_fn: any, stride: int) = """
    local n, data = vec.len or 0, vec._data
    local order = {}
    for i = 1, n do order[i] = i end
    local function key_at(row)
        local base = (row - 1) * stride
        return key_fn(unpack(data, base + 1, base + stride))
    end
    table.sort(order, function(a, b) return key_at(a) < key_at(b) end)
    local sorted = {}
    for row = 1, n do
        local source = (order[row] - 1) * stride
        local target = (row - 1) * stride
        for j = 1, stride do sorted[target + j] = data[source + j] end
    end
    for i = 1, n * stride do data[i] = sorted[i] end
"""

@nomangle inline(lua) fn __rock_is_column_vec(v: any) -> bool = """
    if type(v) ~= "table" then return false end
    local h = rawget(v, "@vec")
    return type(h) == "table" and h.repr == "columns"
"""

@nomangle inline(lua) fn __rock_is_strided_vec(v: any) -> bool = """
    if type(v) ~= "table" then return false end
    local h = rawget(v, "@vec")
    return type(h) == "table" and h.repr == "strided"
"""

@nomangle inline(lua) fn __rock_materialize_strided_element(vec: any, index: int) -> any = """
    local h = rawget(vec, "@vec")
    if type(h) ~= "table" or h.repr ~= "strided" then
        error("expected strided Vec")
    end
    local base = (index - 1) * h.stride
    local tag = vec._data[base + 1]
    local unit = __rock_enum_unit(h.elem, tag)
    if unit then return unit end
    local out = setmetatable({ __variant = tag }, __rock_box_mts[h.elem])
    for j = 2, h.stride do
        local value = vec._data[base + j]
        if value ~= false then out[j - 1] = value end
    end
    return out
"""

@nomangle inline(lua) fn __rock_strided_column_view(vec: any, offsets: any) -> any = """
    local stride, data = rawget(vec, "@vec").stride, vec._data
    return setmetatable({}, {__index = function(_, path)
        local offset = offsets[path]
        if offset == nil then return nil end
        return setmetatable({}, {__index = function(_, index)
            return data[(index - 1) * stride + offset]
        end})
    end})
"""

@nomangle inline(lua) fn __rock_vec_strided_elements(vec: any) -> any = """
    local h = rawget(vec, "@vec")
    local types = _G.__ROCK_TYPE_TABLE
    local decl = types and types[h.elem]
    if not decl then error("missing strided element type: " .. tostring(h.elem), 0) end
    if decl.kind ~= "enum" and decl.kind ~= "c_enum" then
        error("cannot materialize strided nobox struct `" .. h.elem ..
            "`: inspection requires implicit element materialization", 0)
    end
    local out = {}
    for i = 1, vec.len or 0 do out[i] = __rock_materialize_strided_element(vec, i) end
    return out
"""

@nomangle inline(lua) fn __rock_col_paths(vec: any) -> any = """
    local names = {}
    for k, v in pairs(vec) do
        if k ~= "len" and k ~= "@vec" and type(v) == "table" then
            names[#names + 1] = k
        end
    end
    table.sort(names)
    return names
"""

@nomangle inline(lua) fn __rock_materialize_column_type(
    vec: any,
    index: int,
    type_name: string,
    prefix: string
) -> any = """
    local decl = _G.__ROCK_TYPE_TABLE[type_name]
    local ctor = _G[type_name .. "_ct"]
    if not decl or (decl.kind ~= "c_struct" and decl.kind ~= "c_enum") or not ctor then
        error("invalid column element type: " .. tostring(type_name))
    end
    local args = {}
    for i = 1, #decl.fields do
        local field = decl.fields[i]
        local path = prefix == "" and field.name or (prefix .. "." .. field.name)
        local child = _G.__ROCK_TYPE_TABLE[field.type]
        if child and (child.kind == "c_struct" or child.kind == "c_enum") then
            args[i] = __rock_materialize_column_type(vec, index, field.type, path)
        else
            args[i] = vec[path][index]
        end
    end
    return ctor(unpack(args))
"""

@nomangle inline(lua) fn __rock_materialize_column_element(vec: any, index: int) -> any = """
    local h = rawget(vec, "@vec")
    if type(h) ~= "table" or h.repr ~= "columns" then
        error("expected column Vec")
    end
    return __rock_materialize_column_type(vec, index, h.elem, "")
"""

@nomangle inline(lua) fn __rock_vec_column_elements(vec: any) -> any = """
    local out = {}
    for i = 1, vec.len or 0 do
        out[i] = __rock_materialize_column_element(vec, i)
    end
    return out
"""

// The `nobox` counterpart. A fn value taking a `nobox` element takes its LEAVES,
// which are exactly the columns, so the key is applied without an element ever
// existing. `paths` is the ABI leaf order handed down from the lowering -- the
// key fn binds positionally, so a runtime key walk (`__rock_col_paths`, which is
// alphabetical) would silently transpose the arguments.
@nomangle inline(lua) fn __rock_col_sort_leaves(vec: any, key_fn: any, paths: any) = """
    local n = vec.len or 0
    local width = #paths
    local cols = {}
    for j = 1, width do cols[j] = vec[paths[j]] end
    local order, leaves = {}, {}
    for i = 1, n do order[i] = i end
    -- The key is applied per COMPARISON, as both other sorts do; a decorate-sort
    -- would be fewer calls but a different observable for a key fn with effects.
    local function key_at(i)
        for j = 1, width do leaves[j] = cols[j][i] end
        return key_fn(unpack(leaves, 1, width))
    end
    table.sort(order, function(a, b) return key_at(a) < key_at(b) end)
    for j = 1, width do
        local col = cols[j]
        local tmp = {}
        for i = 1, n do tmp[i] = col[order[i]] end
        for i = 1, n do col[i] = tmp[i] end
    end
"""

@nomangle inline(lua) fn __rock_col_sort(vec: any, key_fn: any) = """
    local n = vec.len or 0
    local order = {}
    local elements = {}
    for i = 1, n do
        order[i] = i
        elements[i] = __rock_materialize_column_element(vec, i)
    end
    table.sort(order, function(a, b)
        return key_fn(elements[a]) < key_fn(elements[b])
    end)
    for _, path in ipairs(__rock_col_paths(vec)) do
        local col = vec[path]
        local tmp = {}
        for i = 1, n do tmp[i] = col[order[i]] end
        for i = 1, n do col[i] = tmp[i] end
    end
"""

inline(lua) fn table_copy(tbl: any) -> any = """
    local copy = {}
    for k, v in pairs(tbl) do
        copy[k] = v
    end
    setmetatable(copy, getmetatable(tbl))
    return copy
"""

const PI: float = 3.141592653589793
const TAU: float = 6.283185307179586
const PHI: float = 1.618033988749895
const EPSILON: float = 0.0000001

// Ambiguous flat-enum layouts fall back to positional names to avoid mislabeling.
@nomangle inline(lua) fn __rock_enum_payload_names(keys: any, pos: any) -> any = """
    local types = _G.__ROCK_TYPE_TABLE
    local n = 0
    local numeric = 0
    local seen = {}
    for _, k in ipairs(keys) do
        if type(k) == "number" then
            if k ~= math.floor(k) or k < 1 then return nil end
            numeric = numeric + 1
            if k > n then n = k end
        else
            seen[k] = true
        end
    end
    if numeric ~= n or n == 0 then return nil end
    local names = {}
    local d, c = 1, 1
    while c <= n do
        local fields = nil
        local pd = pos[d]
        if pd and pd.k == "nom" and type(pd.name) == "string" then
            local entry = types and types[pd.name]
            if entry and (entry.kind == "c_struct" or entry.kind == "value_table")
                    and entry.fields and #entry.fields > 0 then
                local flat = true
                for j = 1, #entry.fields do
                    local f = entry.fields[j]
                    if type(f.name) ~= "string" or (type(f.type) == "string" and types[f.type]) then
                        flat = false
                        break
                    end
                end
                if flat then fields = entry.fields end
            end
        end
        if fields then
            for j = 1, #fields do
                if c > n then return nil end
                if seen[fields[j].name] then return nil end
                seen[fields[j].name] = true
                names[c] = fields[j].name
                c = c + 1
            end
        else
            c = c + 1
        end
        d = d + 1
    end
    for k, _ in pairs(pos) do
        if type(k) == "number" and k >= d then return nil end
    end
    if next(names) == nil then return nil end
    return names
"""
// Hoisted recursion avoids per-call closures and LuaJIT FNEW aborts.
// Use declared positions for widened payloads. Presence lanes are storage,
// while a null payload is still a logical field.
@nomangle inline(lua) fn __rock_inline_payload_view(t: any, variant: any) -> (any, any) = """
    local keys, values = {}, {}
    local function add(key, value)
        keys[#keys + 1], values[key] = key, value
    end
    local function payload(key, name, p)
        local slot = p.slot or key
        if not p.leaves then return add(name, t[slot]) end
        if p.k == "opt" then
            if not t[slot] then return add(name, nil) end
            slot = type(slot) == "number" and slot + 1 or slot
        end
        local absent
        for i, path in ipairs(p.leaves) do
            if not absent or path:sub(1, #absent) ~= absent then
                local label = name .. "." .. path
                local value = t[type(slot) == "number" and slot + i - 1 or label]
                absent = nil
                if p.presence and p.presence[i] then
                    if not value then
                        add(label, nil)
                        absent = path .. "."
                    end
                else add(label, value) end
            end
        end
    end
    if variant.pos then
        for i, p in ipairs(variant.pos) do payload(i, "[" .. i .. "]", p) end
    else
        for name, p in pairs(variant.named) do payload(name, name, p) end
    end
    return keys, values
"""

@nomangle inline(lua) fn __rock_inspect_value(v: any, indent: string, path: string, visited: any, precision: int) -> string = """
    local vt = type(v)
    if vt == "cdata" then
        local info = __rock_c_struct_of(v)
        if info then return info.inspect(v, indent, path, visited, precision) end
        return tostring(v)
    elseif vt == "string" then
        return "\"" .. v .. "\""
    elseif vt == "number" then
        if precision >= 0 and v ~= math.floor(v) then
            if v < 1e-100 and v > -1e-100 then v = v * 0 end
            return string.format("%." .. precision .. "f", v)
        end
        return tostring(v)
    elseif vt ~= "table" then
        return tostring(v)
    end

    -- table case
    local t = v
    -- A CodeRef env record is a callable value, not a data table -- render it
    -- as a function leaf, never by walking its capture fields.
    if __rock_is_fn_record(t) then
        return "function: " .. tostring(t.__slot and t.__slot.key or t)
    end
    if visited then
        if visited[t] then
            return "<CYCLE: " .. visited[t] .. ">"
        end
        visited[t] = path
    end

    local type_name = __rock_get_type(t)

    if type_name == "Vec" then
        local elems = t
        if __rock_is_column_vec(t) then
            elems = __rock_vec_column_elements(t)
        elseif __rock_is_strided_vec(t) then
            elems = __rock_vec_strided_elements(t)
        end
        local parts = {}
        for i = 1, t[0] or t.len do
            parts[i] = __rock_inspect_value(elems[i], indent, path .. "[" .. (i-1) .. "]", visited, precision)
        end
        if visited then visited[t] = nil end
        if #parts == 0 then return "Vec { }" end
        return "Vec { " .. table.concat(parts, ", ") .. " }"
    end

    -- Only untyped tables can be sequential arrays.
    local is_array = not type_name
    local max_index = 0
    if is_array then
        local count = 0
        for k in pairs(t) do
            count = count + 1
            if type(k) ~= "number" or k ~= math.floor(k) or k < 1 then
                is_array = false
                break
            end
            max_index = math.max(max_index, k)
        end
        is_array = is_array and count == max_index
    end

    local result
    if is_array then
        if max_index == 0 then
            if visited then visited[t] = nil end
            return "{}"
        end
        local parts = {}
        for i = 1, max_index do
            parts[i] = __rock_inspect_value(t[i], indent, path .. "[" .. (i-1) .. "]", visited, precision)
        end
        result = "{ " .. table.concat(parts, ", ") .. " }"
    else
        -- Collect and sort keys, skipping metadata
        local mt = getmetatable(t)
        local slots = type(mt) == "table" and mt.__rock_slots
        local keys = {}
        if not slots then keys = __rock_field_keys(t, "inspect") end
        local seen = {}
        for _, k in ipairs(keys) do
            seen[k] = true
        end
        -- A null field is an ABSENT key, so `pairs` alone under-reports a
        -- struct's shape. Declared fields come from the type table instead.
        local decl = type_name and __rock_field_declaration(t)
        local embed_vals = nil
        if decl and not t.__variant then
            for i = 1, #decl.fields do
                local f = decl.fields[i]
                if not seen[f.name] then
                    keys[#keys + 1] = f.name
                    seen[f.name] = true
                end
                -- An embedded field's declared name holds either nothing or a
                -- presence flag, so rebuild its logical value from the leaves.
                -- A TABLE there means this is already a rebuilt logical view
                -- (nested embed), whose child sits under the name directly.
                local value = t[slots and slots[f.name] or f.name]
                if f.embed and type(value) ~= "table" then
                    embed_vals = embed_vals or {}
                    embed_vals[f.name] = __rock_embed_view(t, f.name, f.type, f.nullable)
                elseif f.flat and type(value) ~= "table" then
                    embed_vals = embed_vals or {}
                    embed_vals[f.name] = __rock_flat_enum_view(t, f.name, f.type)
                end
            end
        end
        -- A flat-enum box widens value payloads into positional slots; name
        -- the leaves from the variant descriptor when the walk is exact.
        local payload_names, payload_values = nil, nil
        if t.__variant and decl and decl.variant_desc then
            local vd = decl.variant_desc[t.__variant]
            if vd and vd.inline then
                keys, payload_values = __rock_inline_payload_view(t, vd)
            elseif vd and vd.pos then
                payload_names = __rock_enum_payload_names(keys, vd.pos)
            end
        end
        table.sort(keys, __rock_inspect_key_lt)

        local variant = t.__variant

        -- Unit enum variant
        if type_name and variant and #keys == 0 then
            if visited then visited[t] = nil end
            return type_name .. "::" .. variant
        end

        -- Header
        local header
        if type_name and variant then
            header = type_name .. "::" .. variant
        elseif type_name then
            header = type_name
        else
            header = ""
        end

        if #keys <= 2 then
            -- Compact single-line
            local parts = {}
            for i, k in ipairs(keys) do
                local dk = (payload_names and payload_names[k]) or k
                local key_str = type(dk) == "string" and dk or ("[" .. tostring(dk) .. "]")
                local v = t[slots and slots[k] or k]
                if embed_vals and embed_vals[k] ~= nil then v = embed_vals[k] end
                if payload_values then v = payload_values[k] end
                parts[i] = key_str .. " = " .. __rock_inspect_value(v, indent, path .. "." .. tostring(dk), visited, precision)
            end
            if header ~= "" then
                result = header .. " { " .. table.concat(parts, ", ") .. " }"
            else
                result = "{ " .. table.concat(parts, ", ") .. " }"
            end
        else
            -- Multi-line
            local lines = {}
            for _, k in ipairs(keys) do
                local dk = (payload_names and payload_names[k]) or k
                local key_str = type(dk) == "string" and dk or ("[" .. tostring(dk) .. "]")
                local v = t[slots and slots[k] or k]
                if embed_vals and embed_vals[k] ~= nil then v = embed_vals[k] end
                if payload_values then v = payload_values[k] end
                lines[#lines + 1] = indent .. "  " .. key_str .. " = " .. __rock_inspect_value(v, indent .. "  ", path .. "." .. tostring(dk), visited, precision)
            end
            local body = table.concat(lines, ",\n")
            if header ~= "" then
                result = header .. " {\n" .. body .. "\n" .. indent .. "}"
            else
                result = "{\n" .. body .. "\n" .. indent .. "}"
            end
        end
    end

    if visited then visited[t] = nil end
    return result
"""

@nomangle inline(lua) fn __rock_flat_enum_view(t: any, prefix: string, ty: string) -> any = """
    local mt = getmetatable(t)
    local slots = type(mt) == "table" and mt.__rock_slots
    local key = prefix .. ".#"
    local tag = t[slots and slots[key] or key]
    if tag == nil then return nil end
    local flat = _G.__ROCK_ENUM_FLAT_LAYOUT[ty]
    local o = setmetatable({ __variant = tag }, __rock_box_mts[ty])
    for i = 1, flat.tuple_width do
        local key = prefix .. "." .. (i - 1)
        o[i] = t[slots and slots[key] or key]
    end
    for i = 1, #flat.record_fields do
        local key = flat.record_fields[i]
        local path = prefix .. "." .. key
        o[key] = t[slots and slots[path] or path]
    end
    return o
"""

// Returns nil when absent, so an absent embed reads as null rather than as a
// struct assembled from stale leaves.
@nomangle inline(lua) fn __rock_embed_view(t: any, prefix: string, ty: string, nullable: bool) -> any = """
    local mt = getmetatable(t)
    local slots = type(mt) == "table" and mt.__rock_slots
    if nullable and t[slots and slots[prefix] or prefix] == nil then return nil end
    local decl = _G.__ROCK_TYPE_TABLE[ty]
    if not decl then return nil end
    local o = { __ty = ty }
    for i = 1, #decl.fields do
        local f = decl.fields[i]
        local key = prefix .. "." .. f.name
        if f.embed then
            o[f.name] = __rock_embed_view(t, key, f.type, f.nullable)
        elseif f.flat then
            o[f.name] = __rock_flat_enum_view(t, key, f.type)
        else
            o[f.name] = t[slots and slots[key] or key]
        end
    end
    return o
"""

// Module-level so `table.sort` does not allocate a closure per inspect call
// (FNEW abort).
@nomangle inline(lua) fn __rock_inspect_key_lt(a: any, b: any) -> bool = """
    return tostring(a) < tostring(b)
"""

@relocates @nomangle inline(lua) fn __sort_map_keys<K>(keys: [K]) = """
    local data, n = keys, keys[0]
    local width = 8
    for first = 1, n, width do
        for i = first + 1, math.min(first + width - 1, n) do
            local value, j = data[i], i
            local key = tostring(value)
            while j > first and key < tostring(data[j - 1]) do
                data[j] = data[j - 1]
                j = j - 1
            end
            data[j] = value
        end
    end
    if n <= width then return end
    local scratch = __rock_map_sort_scratch
    __rock_map_sort_scratch = nil
    while width < n do
        for first = 1, n - width, 2 * width do
            local mid = first + width - 1
            local last = math.min(mid + width, n)
            if tostring(data[mid + 1]) < tostring(data[mid]) then
                if not scratch then scratch = {} end
                for i = first, mid do scratch[i - first + 1] = data[i] end
                local left, right = 1, mid + 1
                for i = first, last do
                    if left > width then break end
                    if right <= last and tostring(data[right]) < tostring(scratch[left]) then
                        data[i] = data[right]
                        right = right + 1
                    else
                        data[i] = scratch[left]
                        left = left + 1
                    end
                end
            end
        end
        width = 2 * width
    end
    if scratch and n <= 256 then
        __rock_table_clear(scratch)
        __rock_map_sort_scratch = scratch
    end
"""

@intrinsic @nomangle inline(lua) fn inspect(obj: any, cycle_detect: bool = true, precision: int = -1) -> string = """
    if type(obj) == "cdata" then
        if __rock_nb_storage_of(obj) then return tostring(obj) end
        local info = __rock_c_struct_of(obj)
        if info then return info.inspect(obj, "", "root", nil, precision) end
        return tostring(obj)
    end

    -- Primitive fast path — avoids touching the table-case helper at all.
    local obj_type = type(obj)
    if obj_type ~= "table" then
        if obj_type == "string" then
            return "\"" .. obj .. "\""
        elseif obj_type == "number" and precision >= 0 and obj ~= math.floor(obj) then
            if obj < 1e-100 and obj > -1e-100 then obj = obj * 0 end
            return string.format("%." .. precision .. "f", obj)
        else
            return tostring(obj)
        end
    end

    local visited = cycle_detect and {} or nil
    return __rock_inspect_value(obj, "", "root", visited, precision)
"""

@intrinsic @nomangle inline(lua) fn inspect_formatted(obj: any, precision: int) -> string = """
    return inspect(obj, true, precision)
"""

@nowrite @nomangle inline(lua) fn __rock_quote_string(s: string) -> string = """
    local escaped = string.gsub(s, "[%c\"\\]", function(c)
        if c == "\\" then return "\\\\" end
        if c == "\"" then return "\\\"" end
        if c == "\n" then return "\\n" end
        if c == "\t" then return "\\t" end
        if c == "\r" then return "\\r" end
        return string.format("\\u{%X}", string.byte(c))
    end)
    return "\"" .. escaped .. "\""
"""

@nowrite @nomangle inline(js) fn __rock_quote_string(s: string) -> string = """
    var escaped = s.replace(/[\u0000-\u001F\u007F"\\]/g, function(c) {
        if (c === "\\") return "\\\\";
        if (c === "\"") return "\\\"";
        if (c === "\n") return "\\n";
        if (c === "\t") return "\\t";
        if (c === "\r") return "\\r";
        return "\\u{" + c.charCodeAt(0).toString(16).toUpperCase() + "}";
    });
    return "\"" + escaped + "\"";
"""

// Module-level formatting avoids a per-interpolation closure and LuaJIT FNEW abort.
@intrinsic @nomangle inline(lua) fn __rock_format_float(v: float) -> string = """
    local av = math.abs(v)
    if av ~= 0 and (av < 0.0001 or av >= 1000000) then
        local r = string.format("%.2g", v)
        return r
    end
    if v == math.floor(v) then return tostring(v) end
    -- Byte checks instead of gsub, which LuaJIT does not compile.
    local s = string.format("%.4f", v)
    local n = #s
    if string.byte(s, n) ~= 48 then return s end
    if string.byte(s, n - 1) ~= 48 then return string.sub(s, 1, n - 1) end
    if string.byte(s, n - 2) ~= 48 then return string.sub(s, 1, n - 2) end
    if string.byte(s, n - 3) ~= 48 then return string.sub(s, 1, n - 3) end
    return string.sub(s, 1, n - 5)
"""


// A 32-bit draw scaled by 2^-32 gives a double in [0, 1).
extern(lua) fn __rock_rng_next() -> int
extern(lua) fn __rock_rng_seed(seed: int)
extern(lua) fn __rock_rng_state_get() -> int
extern(lua) fn __rock_rng_state_set(state: int)

@intrinsic fn random() -> float { return __rock_rng_next() * (1.0 / 4294967296.0) }
fn random_range(min: float, max: float) -> float { return random() * (max - min) + min }

@intrinsic inline(lua) fn random_int(min: int, max: int) -> int = """
    local r = max - min
    if r <= 0 then return min end
    if r <= 4294967296 then return __rock_rng_next() % r + min end
    local hi = __rock_rng_next()
    local lo = __rock_rng_next()
    return (hi * 2097152 + math.floor(lo / 2048)) % r + min
"""

@intrinsic fn random_seed(seed: int) { __rock_rng_seed(seed) }
@intrinsic fn random_get_state() -> int { return __rock_rng_state_get() }
@intrinsic fn random_set_state(state: int) { __rock_rng_state_set(state) }

extern(lua) fn __rock_presentation_rng_next() -> int
extern(lua) fn __rock_presentation_rng_seed(seed: int)
extern(lua) fn __rock_presentation_rng_state_get() -> int
extern(lua) fn __rock_presentation_rng_state_set(state: int)

@intrinsic fn presentation_random() -> float { return __rock_presentation_rng_next() * (1.0 / 4294967296.0) }
fn presentation_random_range(min: float, max: float) -> float { return presentation_random() * (max - min) + min }

@intrinsic inline(lua) fn presentation_random_int(min: int, max: int) -> int = """
    local r = max - min
    if r <= 0 then return min end
    if r <= 4294967296 then return __rock_presentation_rng_next() % r + min end
    local hi = __rock_presentation_rng_next()
    local lo = __rock_presentation_rng_next()
    return (hi * 2097152 + math.floor(lo / 2048)) % r + min
"""

@intrinsic fn presentation_random_seed(seed: int) { __rock_presentation_rng_seed(seed) }
@intrinsic fn presentation_random_get_state() -> int { return __rock_presentation_rng_state_get() }
@intrinsic fn presentation_random_set_state(state: int) { __rock_presentation_rng_state_set(state) }

@intrinsic @pure @inline inline(lua) fn sin(x: float) -> float = "math.sin(x)"
@intrinsic @pure @inline inline(lua) fn cos(x: float) -> float = "math.cos(x)"
@intrinsic @pure @inline inline(lua) fn tan(x: float) -> float = "math.tan(x)"
@intrinsic @pure @inline inline(lua) fn sqrt(x: float) -> float = "math.sqrt(x)"
@intrinsic @pure @inline inline(lua) fn exp(x: float) -> float = "math.exp(x)"
@intrinsic @pure @inline inline(lua) fn pow(a: float, b: float) -> float = "math.pow(a, b)"
@intrinsic @pure @inline inline(lua) fn log(x: float) -> float = "math.log(x)"
@intrinsic @pure @inline fn log2(x: float) -> float { return log(x) / 0.6931471805599453 }
@intrinsic @pure @inline inline(lua) fn atan2(y: float, x: float) -> float = "math.atan2(y, x)"
@intrinsic @pure fn round(x: float) -> float { return floor(x + 0.5) }
@pure fn round_to_places(x: float, places: int) -> float {
    let mult = pow(10.0, float(places))
    return floor(x * mult + 0.5) / mult
}
@intrinsic @pure @inline inline(lua) fn abs(x: float) -> float = "math.abs(x)"
@intrinsic @pure @inline inline(lua) fn abs(x: int) -> int = "math.abs(x)"

@intrinsic @pure fn sign(x: int) -> int {
    if x > 0 { 1 } else if x < 0 { -1 } else { 0 }
}
@intrinsic @pure fn sign(x: float) -> float {
    if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 }
}
// LuaJIT can narrow a traced floor result to an integer and lose negative zero.
@intrinsic @pure @inline inline(lua) fn floor(x: float) -> float = "(x == 0 and x or math.floor(x))"
@intrinsic @pure @inline inline(lua) fn ceil(x: float) -> float = "math.ceil(x)"

inline(lua) fn get_os() -> string = """
    -- Returns the operating system: "Windows", "Linux", "OSX", or "Other"
    if jit then
        return jit.os
    else
        -- Fallback for non-LuaJIT environments
        if package.config:sub(1,1) == '\\' then
            return "Windows"
        else
            return "Linux"  -- Could be any Unix-like OS
        end
    end
"""

@nowrite @intrinsic @inline inline(lua) fn phantom<T>() -> T = """return nil"""
@intrinsic @inline fn tuple_first<A, B>(tuple: (A, B)) -> A { return tuple.0 }
@intrinsic @inline fn tuple_second<A, B>(tuple: (A, B)) -> B { return tuple.1 }

fn char_to_byte(c: string) -> int { return unit_at(c, 0) }


inline(lua) fn ffi_string(ptr: any, len: int?) -> string = """
    local r
    if len then
        r = ffi.string(ptr, len)
    else
        r = ffi.string(ptr)
    end
    return r
"""

@intrinsic fn map_new<K, V>() -> Map<K, V> {
    transmute(table_new())
}

fn Map<K, V>.insert(map, key: K, value: V) {
    map[key] = value
}

// Not `@nomangle`: reached through ordinary Rock calls and the column
// intercept, both of which match the Rock name rather than the emitted symbol.
// A foreign Map can have an __index metamethod that mutates Rock state.
@intrinsic @inline inline(lua) fn Map<K, V>.get(map, key: K) -> V? = """
    return map[key]
"""

@nomangle fn __map_get_checked(map: any, key: any) -> any {
    let v = table_get(map, key)
    assert(!is_null(v), "Map key not found")
    v
}

// Column maps and arenas reuse free slots before growing. Freed leaves remain
// untouched: nil would create holes in dense columns. `free_indices` is [int].
// The slot helpers are non-generic because synthesized calls lack type arguments.
@nomangle inline(lua) fn __slot_alloc(m: any, hw: any) -> int = """
    local fi = m.free_indices
    local s
    if fi[0] > 0 then
        s = fi[fi[0]]
        fi[fi[0]] = nil
        fi[0] = fi[0] - 1
    elseif hw[0] ~= nil then
        s = hw[0]
        hw[0] = s + 1
    else
        s = hw.len
        hw.len = s + 1
    end
    m.occupied_count = m.occupied_count + 1
    return s
"""

@nomangle inline(lua) fn __slot_release(m: any, slot: int) = """
    local fi = m.free_indices
    fi[0] = fi[0] + 1
    fi[fi[0]] = slot
    m.occupied_count = m.occupied_count - 1
"""

// Allocates a slot on a miss; growth takes `data.len` with it, so the
// caller's column store stays in bounds.
@returns_nonneg @returns_index_below("m.data") @nomangle inline(lua) fn __map_col_slot(m: any, key: any) -> int = """
    local s = m.spine[key]
    if s ~= nil then return s end
    s = __slot_alloc(m, m.data)
    m.spine[key] = s
    return s
"""

// -1 on a miss. Columns are never read at a missing key: the spine is the
// presence.
@returns_index_below("m.data") @nomangle inline(lua) fn __map_col_slot_of(m: any, key: any) -> int = """
    local s = m.spine[key]
    if s == nil then return -1 end
    return s
"""

@returns_nonneg @returns_index_below("m.data") @nomangle inline(lua) fn __map_col_slot_checked(m: any, key: any) -> int = """
    local s = m.spine[key]
    if s == nil then error("Map key not found") end
    return s
"""

@nomangle inline(lua) fn __map_col_free(m: any, key: any) -> int = """
    local s = m.spine[key]
    if s == nil then return -1 end
    m.spine[key] = nil
    __slot_release(m, s)
    return s
"""

// A map key is data and must never collide with a host object name; a Lua
// table inherits nothing, the JS sibling uses a native Map.
@nomangle inline(lua) fn __map_col_new_spine() -> any = """
    return {}
"""

@nomangle inline(lua) fn __map_col_len(m: any) -> int = """
    return m.occupied_count
"""

@nomangle inline(lua) fn __map_col_contains(m: any, key: any) -> bool = """
    return m.spine[key] ~= nil
"""

// Capacity is retained, so a rebuild after `clear` allocates nothing.
@nomangle inline(lua) fn __map_col_clear(m: any) = """
    for k, s in pairs(m.spine) do
        __slot_release(m, s)
        m.spine[k] = nil
    end
    m.occupied_count = 0
"""

// An absent key is not unset: LuaJIT turns a nil store to an absent key into a
// new hash node, and a table with no free node left rehashes on every one.
fn Map<K, V>.remove(map, key: K) -> V? {
    let old = get(map, key)
    if old != null { table_unset(map, key) }
    old
}

fn Map<K, V>.contains(map, key: K) -> bool {
    get(map, key) != null
}

fn Map<K, V>.len(map) -> int {
    let count = 0
    for (k, v) in map {
        count = count + 1
    }
    count
}

fn Map<K, V>.is_empty(map) -> bool {
    for (_, _) in map {
        return false
    }
    return true
}


fn Map<K, V>.clear(map) {
    for (k, v) in map {
        table_unset(map, k)
    }
}

fn Map<K, V>.keys_into(map, result: [K]) -> [K] {
    result.clear()
    if map.is_empty() { return result }
    for (k, v) in map {
        vec_push(result, k)
    }
    __sort_map_keys(result)
    return result
}

fn Map<K, V>.keys(map) -> [K] {
    let keys: [K] = []
    return map.keys_into(keys)
}

fn Map<K, V>.values(map) -> [V] {
    if map.is_empty() { return [] }
    let keys = keys(map)
    let values: [V] = []
    for k in keys {
        vec_push(values, map[k])
    }
    return values
}

fn Map<K, V>.to_array(map) -> [(K, V)] {
    if map.is_empty() { return [] }
    let keys = keys(map)
    let result: [(K, V)] = []
    for k in keys {
        vec_push(result, (k, map[k]))
    }
    return result
}

fn Map<K, V>.get_or_insert(map, key: K, default_value: V) -> V {
    let existing = get(map, key)
    if existing != null {
        return existing
    }
    map[key] = default_value
    default_value
}

fn Map<K, V>.update(map, key: K, value: V) -> V? {
    let old = get(map, key)
    if old != null {
        map[key] = value
    }
    old
}

fn Map<K, V>.upsert(map, key: K, value: V) -> V? {
    let old = get(map, key)
    map[key] = value
    old
}

@nomangle fn __rock_range(min: int, max: int, step: int = 1) -> [int] {
    let result: [int] = []
    if step == 0 { return result }
    if step > 0 {
        let i = min
        while i < max {
            result.push(i)
            i = i + step
        }
    } else {
        let i = min
        while i > max {
            result.push(i)
            i = i + step
        }
    }
    return result
}

// Inclusive on both ends; start + i*step avoids drift over many points.
fn linspace(start: float, end_val: float, count: int) -> [float] {
    let result: [float] = []
    if count <= 0 { return result }
    if count == 1 {
        result.push(start)
        return result
    }
    let step = (end_val - start) / float(count - 1)
    for i in 0..count {
        result.push(start + float(i) * step)
    }
    return result
}

fn float_range(start: float, end_val: float, step: float) -> [float] {
    let result: [float] = []
    if step == 0.0 { return result }
    if step > 0.0 {
        let x = start
        while x < end_val {
            result.push(x)
            x = x + step
        }
    } else {
        let x = start
        while x > end_val {
            result.push(x)
            x = x + step
        }
    }
    return result
}

// Use the explicit length for nullable elements and reserved slots.
@lua_named struct Vec<T> {
    _data: any,
    len: int,
    storage: Storage = phantom(),
}

// skull inlines iter/next and FORL recovery re-emits a numeric `for`; pinned
// by `for_real_vec_loop_is_forl_zero_alloc` in skull-codegen-lua.
@consume struct VecIter<T> {
    vec: [T],
    i: int,
}

@inline
fn Vec<T>.iter(v) -> VecIter<T> {
    return VecIter { vec: v, i: 0 }
}

@inline
fn VecIter<T>.next(it) -> (bool, T) {
    if it.i >= it.vec.len { return (false, phantom()) }
    let v = it.vec[it.i]
    it.i = it.i + 1
    return (true, v)
}

// FORL recovery relies on these shapes: map/enumerate are straight-line,
// filter fetches inside its skip loop, and take_while keeps separate stop edges.
// Bounded combinators inline completely; residual bound calls are errors.

@consume struct MapIter<I, T, U> {
    __inner: I,
    __f: fn(T) -> U,
}

@inline
fn map<I: Iterator<T>, T, U>(it: I, f: fn(T) -> U) -> MapIter<I, T, U> {
    return MapIter { __inner: it, __f: f }
}

@inline
fn MapIter<I: Iterator<T>, T, U>.next(it) -> (bool, U) {
    let (ok, x) = next(it.__inner)
    if !ok { return (false, phantom()) }
    return (true, (it.__f)(x))
}

@consume struct FilterIter<I, T> {
    __inner: I,
    __pred: fn(T) -> bool,
}

@inline
fn filter<I: Iterator<T>, T>(it: I, pred: fn(T) -> bool) -> FilterIter<I, T> {
    return FilterIter { __inner: it, __pred: pred }
}

@inline
fn FilterIter<I: Iterator<T>, T>.next(it) -> (bool, T) {
    loop {
        let (ok, x) = next(it.__inner)
        if !ok { return (false, phantom()) }
        if (it.__pred)(x) { return (true, x) }
    }
    return (false, phantom())
}

@consume struct EnumIter<I, T> {
    __inner: I,
    __i: int,
}

@inline
fn enumerate<I: Iterator<T>, T>(it: I) -> EnumIter<I, T> {
    return EnumIter { __inner: it, __i: -1 }
}

@inline
fn EnumIter<I: Iterator<T>, T>.next(it) -> (bool, (int, T)) {
    let (ok, x) = next(it.__inner)
    if !ok { return (false, phantom()) }
    it.__i = it.__i + 1
    return (true, (it.__i, x))
}

@consume struct ZipIter<I1, I2, A, B> {
    __a: I1,
    __b: I2,
}

@inline
fn zip<I1: Iterator<A>, I2: Iterator<B>, A, B>(a: I1, b: I2) -> ZipIter<I1, I2, A, B> {
    return ZipIter { __a: a, __b: b }
}

@inline
fn ZipIter<I1: Iterator<A>, I2: Iterator<B>, A, B>.next(it) -> (bool, (A, B)) {
    let (ok_a, x) = next(it.__a)
    if !ok_a { return (false, phantom()) }
    let (ok_b, y) = next(it.__b)
    if !ok_b { return (false, phantom()) }
    return (true, (x, y))
}

@consume struct TakeWhileIter<I, T> {
    __inner: I,
    __pred: fn(T) -> bool,
    __done: bool,
}

@inline
fn take_while<I: Iterator<T>, T>(it: I, pred: fn(T) -> bool) -> TakeWhileIter<I, T> {
    return TakeWhileIter { __inner: it, __pred: pred, __done: false }
}

@inline
fn TakeWhileIter<I: Iterator<T>, T>.next(it) -> (bool, T) {
    if it.__done { return (false, phantom()) }
    let (ok, x) = next(it.__inner)
    if !ok {
        it.__done = true
        return (false, phantom())
    }
    if !(it.__pred)(x) {
        it.__done = true
        return (false, phantom())
    }
    return (true, x)
}

@consume struct SkipIter<I, T> {
    __inner: I,
    __n: int,
}

@inline
fn skip<I: Iterator<T>, T>(it: I, n: int) -> SkipIter<I, T> {
    return SkipIter { __inner: it, __n: n }
}

// Same shape as FilterIter (one fetch at the head, a skip edge back to it,
// one return edge), so forl.rs peels it identically.
@inline
fn SkipIter<I: Iterator<T>, T>.next(it) -> (bool, T) {
    loop {
        let (ok, x) = next(it.__inner)
        if !ok { return (false, phantom()) }
        if it.__n <= 0 { return (true, x) }
        it.__n = it.__n - 1
    }
    return (false, phantom())
}

@consume struct StepByIter<I, T> {
    __inner: I,
    __n: int,
    __skip: int,
}

@inline
fn step_by<I: Iterator<T>, T>(it: I, n: int) -> StepByIter<I, T> {
    if n < 1 { error("step_by: n must be >= 1, got {n}") }
    return StepByIter { __inner: it, __n: n, __skip: 0 }
}

// Same peelable shape as SkipIter.
@inline
fn StepByIter<I: Iterator<T>, T>.next(it) -> (bool, T) {
    loop {
        let (ok, x) = next(it.__inner)
        if !ok { return (false, phantom()) }
        if it.__skip <= 0 {
            it.__skip = it.__n - 1
            return (true, x)
        }
        it.__skip = it.__skip - 1
    }
    return (false, phantom())
}

@consume struct TakeIter<I, T> {
    __inner: I,
    __n: int,
}

@inline
fn take<I: Iterator<T>, T>(it: I, n: int) -> TakeIter<I, T> {
    return TakeIter { __inner: it, __n: n }
}

@inline
fn TakeIter<I: Iterator<T>, T>.next(it) -> (bool, T) {
    if it.__n <= 0 { return (false, phantom()) }
    let (ok, x) = next(it.__inner)
    if !ok { return (false, phantom()) }
    it.__n = it.__n - 1
    return (true, x)
}

@consume struct ChainIter<I1, I2, T> {
    __a: I1,
    __b: I2,
    __first: bool,
}

@inline
fn chain<I1: Iterator<T>, I2: Iterator<T>, T>(a: I1, b: I2) -> ChainIter<I1, I2, T> {
    return ChainIter { __a: a, __b: b, __first: true }
}

@inline
fn ChainIter<I1: Iterator<T>, I2: Iterator<T>, T>.next(it) -> (bool, T) {
    if it.__first {
        let (ok, x) = next(it.__a)
        if ok { return (true, x) }
        it.__first = false
    }
    return next(it.__b)
}

// `__cur` is a real field, not II?, so `next(it.__cur)` advances the stored
// cursor rather than a throwaway copy.
@consume struct FlattenIter<IO, II, T> {
    __outer: IO,
    __cur: II,
    __has: bool,
}

@inline
fn flatten<IO: Iterator<II>, II: Iterator<T>, T>(outer: IO) -> FlattenIter<IO, II, T> {
    return FlattenIter { __outer: outer, __cur: phantom(), __has: false }
}

@inline
fn FlattenIter<IO: Iterator<II>, II: Iterator<T>, T>.next(it) -> (bool, T) {
    loop {
        if !it.__has {
            let (ok, inner) = next(it.__outer)
            if !ok { return (false, phantom()) }
            it.__cur = inner
            it.__has = true
        }
        let (ok2, x) = next(it.__cur)
        if ok2 { return (true, x) }
        it.__has = false
    }
    return (false, phantom())
}

@inline
fn flat_map<IO: Iterator<T>, T, II: Iterator<U>, U>(it: IO, f: fn(T) -> II) -> FlattenIter<MapIter<IO, T, II>, II, U> {
    return flatten(map(it, f))
}

@inline
fn collect<I: Iterator<T>, T>(it: I) -> [T] {
    let result: [T] = []
    for x in it {
        vec_push(result, x)
    }
    return result
}

@inline
fn reduce<I: Iterator<T>, T, U>(it: I, initial: U, f: (U, T) -> U) -> U {
    let acc = initial
    for x in it {
        acc = f(acc, x)
    }
    return acc
}

@inline
fn find<I: Iterator<T>, T>(it: I, pred: fn(T) -> bool) -> T? {
    for x in it {
        if pred(x) { return x }
    }
    return null
}

@inline
fn any<I: Iterator<T>, T>(it: I, pred: fn(T) -> bool) -> bool {
    for x in it {
        if pred(x) { return true }
    }
    return false
}

@inline
fn all<I: Iterator<T>, T>(it: I, pred: fn(T) -> bool) -> bool {
    for x in it {
        if !pred(x) { return false }
    }
    return true
}

@inline
fn count<I: Iterator<T>, T>(it: I) -> int {
    let n = 0
    for x in it { n = n + 1 }
    return n
}

// `have` rather than `best == null`: at `T = E?` null is also a legal element.
@inline
fn min_by<I: Iterator<T>, T>(it: I, key: fn(T) -> float) -> T? {
    let best: T? = null
    let have = false
    let best_k = 0.0
    for x in it {
        let k = key(x)
        if !have || k < best_k {
            best = x
            best_k = k
            have = true
        }
    }
    return best
}

// Same sentinel collision as `min_by`.
@inline
fn max_by<I: Iterator<T>, T>(it: I, key: fn(T) -> float) -> T? {
    let best: T? = null
    let have = false
    let best_k = 0.0
    for x in it {
        let k = key(x)
        if !have || k > best_k {
            best = x
            best_k = k
            have = true
        }
    }
    return best
}

@inline
fn sum<I: Iterator<int>>(it: I) -> int {
    let acc = 0
    for x in it { acc = acc + x }
    return acc
}

@inline
fn sum_f<I: Iterator<float>>(it: I) -> float {
    let acc = 0.0
    for x in it { acc = acc + x }
    return acc
}

// `ago(0)` is the last push; iteration runs oldest to newest.
struct RingBuffer<T> {
    data: [T],
    cap: int,
    head: int,
}

fn ring_new<T>(cap: int) -> RingBuffer<T> {
    return RingBuffer { data: [], cap: cap, head: 0 }
}

fn RingBuffer<T>.len(rb) -> int { return rb.data.len }

fn RingBuffer<T>.push(rb, x: T) {
    if rb.data.len < rb.cap {
        rb.data.push(x)
    } else {
        rb.data[rb.head] = x
    }
    rb.head = (rb.head + 1) % rb.cap
}

fn RingBuffer<T>.ago(rb, k: int) -> T {
    let n = rb.data.len
    if k < 0 || k >= n {
        error("RingBuffer.ago out of range: k={k}, len={n}")
    }
    return rb.data[((rb.head - 1 - k) % n + n) % n]
}

fn RingBuffer<T>.clear(rb) {
    rb.data.clear()
    rb.head = 0
}

// Holds the shared `data` descriptor, not the buffer: a mutable identity
// cannot be stored in a field.
@consume struct RingIter<T> {
    data: [T],
    oldest: int,
    cap: int,
    n: int,
    i: int,
}

@inline
fn RingBuffer<T>.iter(rb) -> RingIter<T> {
    let n = rb.data.len
    return RingIter { data: rb.data, oldest: (rb.head + rb.cap - n) % rb.cap, cap: rb.cap, n: n, i: 0 }
}

@inline
fn RingIter<T>.next(it) -> (bool, T) {
    if it.i >= it.n { return (false, phantom()) }
    let idx = (it.oldest + it.i) % it.cap
    it.i = it.i + 1
    return (true, it.data[idx])
}

fn vec_new_with_capacity<T>(capacity: int) -> [T] {
    return __vec_data_alloc(capacity)
}

fn Vec<T>.capacity(vec) -> int { return __vec_data_capacity(vec) }

fn Vec<T>.insert_at(vec, index: int, value: T) {
    if index < 0 || index > vec.len { error("Error: Index out of bounds") }

    let lua_index = index + 1
    __vec_data_insert(vec, lua_index, value)
    vec.len += 1
}

fn Vec<T>.clone(vec) -> [T] {
    return __vec_data_clone(vec)
}

fn Vec<T>.sort<K>(vec, key_fn: fn(T) -> K) {
    if __sort_key_wide(key_fn) {
        __vec_sort_by_key_leaves(vec, key_fn)
    } else {
        __vec_data_sort(vec, key_fn)
    }
}

@sort_key_wide inline(lua) fn __sort_key_wide<T, K>(key_fn: fn(T) -> K) -> bool = """
    error("__sort_key_wide must be compiler-expanded")
"""

@sort_key_lt inline(lua) fn __sort_key_lt<T, K>(key_fn: fn(T) -> K, a: T, b: T) -> bool = """
    error("__sort_key_lt must be compiler-expanded")
"""

// An in-place heap keeps auxiliary space constant for every element storage.
fn __vec_sort_by_key_leaves<T, K>(vec: [T], key_fn: fn(T) -> K) {
    let start = int(vec.len / 2)
    let end = vec.len
    while end > 1 {
        let root = 0
        if start > 0 {
            start -= 1
            root = start
        } else {
            end -= 1
            let row = vec[0]
            vec[0] = vec[end]
            vec[end] = row
        }
        while root * 2 + 1 < end {
            let child = root * 2 + 1
            if child + 1 < end && __sort_key_lt(key_fn, vec[child], vec[child + 1]) { child += 1 }
            if !__sort_key_lt(key_fn, vec[root], vec[child]) { break }
            let row = vec[root]
            vec[root] = vec[child]
            vec[child] = row
            root = child
        }
    }
}

fn Vec<T>.sample(vec) -> T? {
    let len = vec_len(vec)
    if len == 0 { return null }
    let index = random_int(0, len)
    return vec_get(vec, index)
}

fn Vec<T>.presentation_sample(vec) -> T? {
    let len = vec_len(vec)
    if len == 0 { return null }
    let index = presentation_random_int(0, len)
    return vec_get(vec, index)
}

@intrinsic @pure fn lerp(a: float, b: float, t: float) -> float { return a + (b - a) * t }

@intrinsic @pure fn fract(x: float) -> float { return x - floor(x) }

@intrinsic @pure fn smoothstep(edge0: float, edge1: float, x: float) -> float {
    let t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
}


fn ease_in_quad(t: float) -> float { return t * t }

fn ease_out_quad(t: float) -> float {
    let inv = 1 - t
    return 1 - inv * inv
}

fn ease_in_out_quad(t: float) -> float {
    if t < 0.5 {
        return 2.0 * t * t
    } else {
        let x = 2.0 - 2.0 * t
        return 1 - (x * x) / 2.0
    }
}

fn ease_in_cubic(t: float) -> float { return t * t * t }

fn ease_out_cubic(t: float) -> float {
    let inv = 1 - t
    return 1 - inv * inv * inv
}

fn ease_in_out_cubic(t: float) -> float {
    if t < 0.5 {
        return 4.0 * t * t * t
    } else {
        let x = 2.0 - 2.0 * t
        return 1 - (x * x * x) / 2.0
    }
}

fn ease_in_quart(t: float) -> float { return t * t * t * t }

fn ease_out_quart(t: float) -> float {
    let inv = 1 - t
    return 1 - inv * inv * inv * inv
}

fn ease_in_out_quart(t: float) -> float {
    if t < 0.5 {
        return 8.0 * t * t * t * t
    } else {
        let x = 2.0 - 2.0 * t
        return 1 - (x * x * x * x) / 2.0
    }
}

fn ease_in_quint(t: float) -> float { return t * t * t * t * t }

fn ease_out_quint(t: float) -> float {
    let inv = 1 - t
    return 1 - inv * inv * inv * inv * inv
}

fn ease_in_out_quint(t: float) -> float {
    if t < 0.5 {
        return 16.0 * t * t * t * t * t
    } else {
        let x = 2.0 - 2.0 * t
        return 1 - (x * x * x * x * x) / 2.0
    }
}

fn ease_in_sine(t: float) -> float { return 1 - cos(t * PI / 2.0) }

fn ease_out_sine(t: float) -> float { return sin(t * PI / 2.0) }

fn ease_in_out_sine(t: float) -> float { return -1 * (cos(PI * t) - 1) / 2.0 }

fn ease_in_expo(t: float) -> float {
    if t == 0 { return 0.0 } else { return pow(2.0, 10.0 * t - 10.0) }
}

fn ease_out_expo(t: float) -> float {
    if t >= 1 { return 1.0 } else { return 1 - pow(2.0, -10.0 * t) }
}

fn ease_in_out_expo(t: float) -> float {
    if t == 0 {
        return 0.0
    } else {
        if t >= 1 {
            return 1.0
        } else {
            if t < 0.5 {
                return pow(2.0, 20.0 * t - 10.0) / 2.0
            } else {
                return (2.0 - pow(2.0, -20.0 * t + 10.0)) / 2.0
            }
        }
    }
}

fn ease_in_circ(t: float) -> float { return 1.0 - sqrt(1.0 - t * t) }

fn ease_out_circ(t: float) -> float { return sqrt(1.0 - (t - 1.0) * (t - 1.0)) }

fn ease_in_out_circ(t: float) -> float {
    if t < 0.5 {
        return (1.0 - sqrt(1.0 - (2.0 * t) * (2.0 * t))) / 2.0
    } else {
        return (sqrt(1.0 - (2.0 - 2.0 * t) * (2.0 - 2.0 * t)) + 1.0) / 2.0
    }
}

struct Envelope {
    value: float = 0,
    attack: float,
    release: float,
}

fn envelope(attack: float, release: float) -> Envelope {
    return Envelope { value: 0, attack: attack, release: release }
}

fn Envelope.step_by(e, goal: float, step_dt: float) -> float {
    if e.value < goal {
        e.value = min(goal, e.value + step_dt / e.attack)
    } else {
        e.value = max(goal, e.value - step_dt / e.release)
    }
    return e.value
}

@nowrite @intrinsic @inline inline(lua) fn string.len(s) -> int = "string.len(s)"


@nowrite @intrinsic inline(lua) fn string.substring(s, start: int, end_idx: int) -> string = """
    -- Rock uses 0-based indexing, Lua uses 1-based. Bound, then return: a
    -- `return string.sub(..)` tail call into C is a CALLT no root trace can
    -- leave through.
    local r = string.sub(s, start + 1, end_idx)
    return r
"""

@nowrite @intrinsic @inline inline(lua) fn string.upper(s) -> string = "string.upper(s)"

@nowrite @intrinsic @inline inline(lua) fn string.lower(s) -> string = "string.lower(s)"

// 0-based unit index of the first plain-text match at or after `from`, or -1.
@intrinsic @native_required inline(lua) fn string.find(s, substr: string, from: int = 0) -> int = """
    local pos = string.find(s, substr, from + 1, true)
    if pos then
        return pos - 1  -- Convert to 0-based index
    else
        return -1
    end
"""

// For a caller that already validated the grammar (`parse_float` is checked).
// `end_idx` is unused on luajit (strtod stops; strings are NUL-terminated).
// `strtod_l` with a "C" locale keeps LC_NUMERIC from misreading `.`.
// Keep this body free of closures: an UCLO in the hot path cannot be
// recorded, so the locale setup lives in its own function.
@intrinsic @native_required inline(lua) fn string.parse_float_at(s, start: int, end_idx: int) -> float = """
    local f = _G.__rock_parse_float_at or __rock_parse_float_at_setup()
    return f(s, start, end_idx)
"""

@nomangle fn __rock_parse_float_at_setup() -> any {
    let declared = ffi_cdef_once("__rock_parse_float_ffi_defined", embed_string("parse_float.h"), true)
    return __rock_parse_float_at_init(declared)
}

inline(lua) fn __rock_parse_float_at_init(declared: bool) -> any = """
    local f
    local cast = ffi.cast
    -- LC_NUMERIC_MASK is a header constant the ffi cannot read: 16 on Darwin,
    -- 2 on glibc. A wrong value is not silently wrong -- POSIX newlocale takes
    -- every category outside `mask` from "C" when `base` is NULL, so LC_NUMERIC
    -- lands on "C" either way -- but the probe below refuses to install the
    -- fast path if that reasoning ever fails.
    if declared then
        local mask = (ffi.os == "OSX" or ffi.os == "BSD") and 16 or 2
        local got, loc = pcall(function() return ffi.C.newlocale(mask, "C", nil) end)
        if got and loc ~= nil then
            local strtod_l = ffi.C.strtod_l
            local function probe(str) return strtod_l(cast("const char*", str), nil, loc) end
            if probe("1.5") == 1.5 and probe("-3.25e2") == -325 and probe("2.5E-2") == 0.025 then
                f = function(str, a, b) local r = strtod_l(cast("const char*", str) + a, nil, loc); return r end
            end
        end
    end
    if not f then
        -- Correct, just slower: luajit's own scanner does not read the locale.
        -- This is a perf fallback with identical results, not a swallowed
        -- failure, so it reports itself and continues.
        local msg = "parse_float_at: no C-locale strtod_l on " .. tostring(ffi.os) .. "; using the portable path"
        local warn = _G.__rock_log
        if warn then warn(1, "STDLIB", msg) else io.stderr:write("[WARN] " .. msg .. "\\n") end
        f = function(str, a, b) local r = tonumber(string.sub(str, a + 1, b)); return r end
    end
    _G.__rock_parse_float_at = f
    return f
"""

@intrinsic @inline inline(lua) fn string_char(code: int) -> string = "string.char(code)"

@intrinsic inline(lua) fn from_codepoint(cp: int) -> string = """
    if cp < 0 or cp > 0x10FFFF then
        error("from_codepoint: codepoint out of range: " .. tostring(cp))
    end
    if cp >= 0xD800 and cp <= 0xDFFF then
        error("from_codepoint: surrogate is not a code point: " .. tostring(cp))
    end
    if cp < 0x80 then
        return string.char(cp)
    elseif cp < 0x800 then
        return string.char(0xC0 + math.floor(cp / 0x40), 0x80 + (cp % 0x40))
    elseif cp < 0x10000 then
        return string.char(0xE0 + math.floor(cp / 0x1000), 0x80 + (math.floor(cp / 0x40) % 0x40), 0x80 + (cp % 0x40))
    else
        return string.char(0xF0 + math.floor(cp / 0x40000), 0x80 + (math.floor(cp / 0x1000) % 0x40), 0x80 + (math.floor(cp / 0x40) % 0x40), 0x80 + (cp % 0x40))
    end
"""

// One native unit (byte on luajit, UTF-16 unit on JS), or 0 out of bounds.
// Do not do arithmetic on it across backends.
@nowrite @intrinsic inline(lua) fn string.unit_at(s, index: int) -> int = """
    return string.byte(s, index + 1) or 0  -- Convert to 1-based, return 0 if out of bounds
"""

@nowrite @inline inline(lua) fn string.repeat(s, count: int) -> string = "string.rep(s, count)"
@nowrite @inline inline(js) fn string.repeat(s, count: int) -> string = "return count > 0 ? s.repeat(count) : \"\";"

@lua_named struct StringBuilder {}
@intrinsic inline(lua) fn sb_new() -> StringBuilder = """
    local new = _G.__rock_string_buffer_new
    if not new then
        new = require("string.buffer").new
        _G.__rock_string_buffer_new = new
    end
    return new()
"""
@intrinsic inline(lua) fn sb_push(sb: StringBuilder, s: string) = "sb:put(s)"
@intrinsic inline(lua) fn sb_build(sb: StringBuilder) -> string = "return sb:tostring()"

fn lt(a: string, b: string) -> bool { return le(a, b) && a != b }
inline(lua) fn le(a: string, b: string) -> bool = "return a <= b"

@nowrite fn string.pad_right(s, width: int) -> string {
    let n = s.len()
    if n >= width { return s }
    return s + " ".repeat(width - n)
}

@nowrite fn string.pad_left(s, width: int) -> string {
    let n = s.len()
    if n >= width { return s }
    return " ".repeat(width - n) + s
}

@intrinsic inline(lua) fn format_float(v: float, width: int, decimals: int) -> string = """
    -- LuaJIT's %f prints garbage digits below about 1e-152; every valid
    -- precision rounds these magnitudes to a signed zero.
    if v < 1e-100 and v > -1e-100 then v = v * 0 end
    local r = string.format("%" .. tostring(width) .. "." .. tostring(decimals) .. "f", v)
    return r
"""

@nowrite @inline inline(lua) fn string_match(s: string, pattern: string) -> string? = "string.match(s, pattern)"
@nowrite inline(js) fn string_match(s: string, pattern: string) -> string? = """
    var m = s.match(new RegExp(__lua_pattern_to_regex(pattern)));
    if (!m) return null;
    return m.length > 1 ? m[1] : m[0];
"""

@nowrite @inline inline(lua) fn string.gmatch(s, pattern: string) -> fn() -> string? = "string.gmatch(s, pattern)"

@nowrite inline(lua) fn string.gsub(s, pattern: string, replacement: string) -> string = """
    return (string.gsub(s, pattern, replacement))
"""

@nomangle inline(js) fn __lua_pattern_to_regex(pattern: string) -> string = """
    var out = "";
    var i = 0;
    // A quantifier needs a single-character item before it; elsewhere Lua
    // reads the same character as a literal.
    var quantifiable = false;
    while (i < pattern.length) {
        var c = pattern[i];
        var item = true;
        if (c === "%") {
            var n = pattern[i + 1];
            if (n === "w") out += "[A-Za-z0-9]";
            else if (n === "W") out += "[^A-Za-z0-9]";
            else if (n === "d") out += "[0-9]";
            else if (n === "D") out += "[^0-9]";
            else if (n === "s") out += "[ \\t\\n\\r\\v\\f]";
            else if (n === "S") out += "[^ \\t\\n\\r\\v\\f]";
            else if (n === "a") out += "[A-Za-z]";
            else if (n === "A") out += "[^A-Za-z]";
            else if ("^$()%.[]*+-?".indexOf(n) >= 0) out += "\\" + n;
            else throw new Error("lua pattern (js): unsupported escape %" + n + " in: " + pattern);
            i += 2;
        } else if (c === "[") {
            var j = i + 1;
            var cls = "[";
            if (pattern[j] === "^") { cls += "^"; j++; }
            // A `]` right after the opening is a member of the set.
            if (pattern[j] === "]") { cls += "\\]"; j++; }
            while (j < pattern.length && pattern[j] !== "]") {
                if (pattern[j] === "%") {
                    var m = pattern[j + 1];
                    if (m === "w") cls += "A-Za-z0-9";
                    else if (m === "W") cls += "\\x00-/:-@\\[-`{-\\uffff";
                    else if (m === "d") cls += "0-9";
                    else if (m === "D") cls += "\\x00-/:-\\uffff";
                    else if (m === "s") cls += " \\t\\n\\r\\v\\f";
                    else if (m === "S") cls += "\\x00-\\x08\\x0e-\\x1f!-\\uffff";
                    else if (m === "a") cls += "A-Za-z";
                    else if (m === "A") cls += "\\x00-@\\[-`{-\\uffff";
                    else if (/[A-Za-z0-9]/.test(m)) throw new Error("lua pattern (js): unsupported escape %" + m + " in: " + pattern);
                    else cls += "\\" + m;
                    j += 2;
                } else {
                    var ch = pattern[j];
                    cls += ("\\^$.|?*+()[]{}".indexOf(ch) >= 0 ? "\\" + ch : ch);
                    j++;
                }
            }
            if (pattern[j] !== "]") throw new Error("lua pattern (js): unterminated [] set in: " + pattern);
            out += cls + "]";
            i = j + 1;
        } else if ("*+?-".indexOf(c) >= 0 && quantifiable) {
            out += c === "-" ? "*?" : c;
            item = false;
            i++;
        } else if ("*+?-".indexOf(c) >= 0) {
            out += "\\" + c;
            i++;
        } else if ((c === "^" && i === 0) || (c === "$" && i === pattern.length - 1)) {
            out += c;
            item = false;
            i++;
        } else if (c === "^" || c === "$") {
            out += "\\" + c;
            i++;
        } else if (c === "(" && pattern[i + 1] === ")") {
            throw new Error("lua pattern (js): unsupported position capture in: " + pattern);
        } else if (c === "(" || c === ")") {
            out += c;
            item = false;
            i++;
        } else if ("\\|{}".indexOf(c) >= 0) {
            out += "\\" + c;
            i++;
        } else if (c === "." ) {
            out += "[^]";
            i++;
        } else {
            out += c;
            i++;
        }
        quantifiable = item;
    }
    return out;
"""

@nowrite inline(js) fn string.gsub(s, pattern: string, replacement: string) -> string = """
    var rx = new RegExp(__lua_pattern_to_regex(pattern), "g");
    // Lua's %1 names the whole match when the pattern has no captures.
    var captures = new RegExp(rx.source + "|").exec("").length - 1;
    var rep = replacement.replace(/\$/g, "$$$$").replace(/%([0-9%])/g, function (_, d) {
        if (d === "%") return "%";
        return d === "0" || (d === "1" && captures === 0) ? "$&" : "$" + d;
    });
    return s.replace(rx, rep);
"""

fn string.lines(s) -> [string] {
    return s.split("\n")
}

fn string.parse_int(s) -> int? {
    let f = s.parse_float()
    if f == null { return null }
    return int(floor(f))
}

@nowrite @intrinsic @inline inline(lua) fn string.parse_float(s) -> float? = "tonumber(s)"

@intrinsic @inline inline(lua) fn env_var(name: string) -> string? = "os.getenv(name)"

fn get_env_int(var: string, default_val: int) -> int {
    let v = env_var(var)
    if v == null { return default_val }
    return v.parse_int() ?? default_val
}

fn get_env_float(var: string, default_val: float) -> float {
    let v = env_var(var)
    if v == null { return default_val }
    return v.parse_float() ?? default_val
}

@nowrite @inline fn format_float_roundtrip(value: float) -> string { return "{value:.17g}" }

// TODO: format_lua is an escape hatch for printf-style formatting.
// When Rock's string interpolation supports all common format specifiers
// (including %q for Lua-style quoting), this should be removed.
@inline inline(lua) fn format_lua(fmt: string, arg: any) -> string = "string.format(fmt, arg)"

@build_var_expand inline(lua) fn build_var(name: string) -> string = """
    error("build_var is a compile-time intrinsic (expanded at compile time)")
"""

@embed_expand inline(lua) fn embed_string(path: string) -> string = """
    error("embed_string is a compile-time intrinsic (expanded at compile time)")
"""

@intrinsic @native_required inline(lua) fn ffi_cdef_once(key: string, declarations: string, optional: bool = false) -> bool = """
    if not _G[key] then
        if optional then
            if not pcall(ffi.cdef, declarations) then return false end
        else
            ffi.cdef(declarations)
        end
        _G[key] = true
    end
    return true
"""

inline(lua) fn luajit_available() -> bool = "jit ~= nil"
inline(lua) fn luajit_enabled() -> bool = "jit ~= nil and jit.status() == true"

@scalar_abi inline(lua) fn luajit_status() -> (bool, string) = """
    if jit == nil then return false, "" end
    local status = { jit.status() }
    return status[1], table.concat(status, ",", 2)
"""

inline(lua) fn luajit_version() -> string = 'jit and jit.version or ""'
inline(lua) fn luajit_os() -> string = 'jit and jit.os or ""'
inline(lua) fn luajit_arch() -> string = 'jit and jit.arch or ""'

inline(lua) fn luajit_on() = "if jit then jit.on() end"
inline(lua) fn luajit_off() = "if jit then jit.off() end"
inline(lua) fn luajit_flush() = "if jit then jit.flush() end"
