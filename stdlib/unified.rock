// Rock standard library

// The `target` object available inside a `deco init` body. The runtime
// table skull emits (name/params/func) is shaped to match; bone types the
// magic `target` binding as this struct so `target.name`/`target.func`
// type-check.
struct __DecoTarget {
    name: string,
    params: [string],
    func: any,
}

struct ArenaEntry<T> {
    _data: T,
    index: int,
    generation: int,
    is_occupied: bool,
}

@pure @inline inline(lua) fn int(value: int) -> int = "return value"

@pure fn int(value: float) -> int { return floor(value) as int }

fn is_nan(value: float) -> bool {
    // NaN is the only value that is not equal to itself
    return value != value
}

// ============================================================================
// FFI out-parameter buffers
// ============================================================================
//
// Many C APIs take `int*` / `float*` for out-parameters. LuaJIT handles these
// with `ffi.new("int[1]")` single-element arrays. The `ffi_out_*` constructors
// return raw cdata typed as `Ptr<T>` (the same phantom used for
// NativeBuffer<T>.ptr) so externs can declare the exact pointer variant they
// accept — passing `Ptr<int>` where `Ptr<float>` is expected is a compile
// error. There is no wrapper struct; the "FfiOut" name lives only in the
// constructor identifiers.
//
// Usage:
//   let w = ffi_out_int()
//   let h = ffi_out_int()
//   stone_get_image_size(handle, w, h)  // extern takes (int, Ptr<int>, Ptr<int>)
//   return IVec2 { x: w.read(), y: h.read() }

@inline inline(lua) fn __ffi_new_int_1() -> Ptr<int> = 'return ffi.new("int[1]")'
@inline inline(lua) fn __ffi_new_float_1() -> Ptr<float> = 'return ffi.new("float[1]")'

fn ffi_out_int() -> Ptr<int> { return __ffi_new_int_1() }
fn ffi_out_float() -> Ptr<float> { return __ffi_new_float_1() }

inline(lua) fn read(p: Ptr<int>) -> int = "return p[0]"
inline(lua) fn read(p: Ptr<float>) -> float = "return p[0]"
// JS: a Ptr<T> is the TypedArray itself (NativeBuffer .ptr).
inline(js) fn read(p: Ptr<int>) -> int = "return p[0];"
inline(js) fn read(p: Ptr<float>) -> float = "return p[0];"

// ============================================================================
// Typed pointer phantoms — close the Rock-side FFI hole
// ============================================================================
//
// `Ptr<T>` and the sized variants (PtrU8/PtrI8/PtrU16/PtrI16/PtrU32) are
// empty phantom structs. At runtime they carry raw LuaJIT cdata (no
// wrapper table — the inline(lua) constructors return the cdata directly
// and Rock's static typing is nominal). At compile time they give
// extern(ffi) signatures the power to say "this argument must be a
// float* (not an int*, not a uint8_t*)" without runtime cost.
//
// NativeBuffer<T>.ptr is typed as Ptr<T>; sized variants' .ptr fields use
// the distinct phantom variant. Pre-existing use of .ptr at call sites
// keeps working — the runtime value is still cdata, the Rock type just
// became more specific.

struct Ptr<T> { }
struct PtrU8  { }
struct PtrI8  { }
struct PtrU16 { }
struct PtrI16 { }
struct PtrU32 { }

// ============================================================================
// NativeBuffer<T> — typed contiguous ffi buffers
// ============================================================================
//
// Wraps an `ffi.new("T[?]", n)` cdata with a phantom type parameter. Enables
// type-safe construction + indexed read/write for bulk numeric buffers, while
// still passing through to C FFI externs as a raw pointer via `.ptr`.
//
// Usage:
//   let verts = native_buffer_float(14 * vertex_count)
//   nb_set(verts, 0, 1.0)
//   stone_submit_verts(verts.ptr, verts.len)  // extern takes (Ptr<float>, int)
//
// Bounds: reads/writes past `len` yield LuaJIT garbage; indexing is 0-based.
// T ∈ {int, float}; extend with more primitives as needed.

struct NativeBuffer<T> {
    ptr: Ptr<T>,
    len: int,
}

// Compiler intrinsic: every call is expanded by skull to `NativeBuffer { ptr =
// ffi.new("<ctype>[?]", n), len = n }` with the concrete element cdef name
// resolved at the call site (skull owns the value-struct ct names). Legal only
// where `T` resolves to an FFI-clean value struct or int/float/bool; a
// GC-carrying or opaque-generic `T` is a spanned emit-time error. The body is a
// never-reached guard (all calls are intercepted before resolution).
inline(lua) fn native_buffer_alloc<T>(n: int) -> NativeBuffer<T> = "error('native_buffer_alloc is a skull compiler intrinsic; a call reached runtime unexpanded')"

// The primitive ctors are thin wrappers over the intrinsic (T binds concretely
// here, so the intrinsic resolves at this site -- no per-type `__nb_alloc_*`).
@inline fn native_buffer_float(n: int) -> NativeBuffer<float> {
    return native_buffer_alloc(n)
}
@inline fn native_buffer_int(n: int) -> NativeBuffer<int> {
    return native_buffer_alloc(n)
}

// Single-hop accessors: the inline(lua) body reaches into the Rock struct's
// .ptr field directly. This avoids the extra Lua call frame a wrapper would
// introduce and lets LuaJIT fold the field load + ffi index in one trace.
@intrinsic @native_required inline(lua) fn nb_get(b: NativeBuffer<float>, i: int) -> float = "return b.ptr[i]"
@intrinsic @native_required inline(lua) fn nb_set(b: NativeBuffer<float>, i: int, v: float) = "b.ptr[i] = v"
@intrinsic @native_required inline(lua) fn nb_get(b: NativeBuffer<int>, i: int) -> int = "return b.ptr[i]"
@intrinsic @native_required inline(lua) fn nb_set(b: NativeBuffer<int>, i: int, v: int) = "b.ptr[i] = v"

// Safe accessor matching the unified `.get(i) -> T?` surface used across
// all collection types. Returns null on out-of-range; `buf[i]` is the
// direct-access counterpart.
@intrinsic @native_required inline(lua) fn get(b: NativeBuffer<float>, i: int) -> float? = """
    if i < 0 or i >= b.len then return nil end
    return b.ptr[i]
"""
@intrinsic @native_required inline(lua) fn get(b: NativeBuffer<int>, i: int) -> int? = """
    if i < 0 or i >= b.len then return nil end
    return b.ptr[i]
"""

// ============================================================================
// Windowed statistics -- one Metric per measured series.
// ----------------------------------------------------------------------------
// Holds a trailing window of `cap` samples plus its live summary
// (mean/stddev/min/max/p50/p90/p99). `sorted` stays ascending so order stats
// are index lookups; `ring` is insertion order, giving the oldest sample to
// evict and the raw per-frame signal for plots. metric_add recomputes the
// summary in O(cap) with zero allocation and uniform cost, so a reader can
// pull p99 every frame without perturbing what it measures.
// Design: docs/effective-fps-and-stats-plan.md.
// ============================================================================

value StatSummary {
    mean: float,
    stddev: float,
    min: float,
    max: float,
    p50: float,
    p90: float,
    p99: float,
    n: int,
}

struct Metric {
    name: string,
    cap: int,
    ring: NativeBuffer<float>,    // insertion order (eviction + raw plot source)
    sorted: NativeBuffer<float>,  // same values, ascending (order stats)
    head: int,
    count: int,
    // Live summary -- overwritten in place by every metric_add.
    mean: float,
    stddev: float,
    min: float,
    max: float,
    p50: float,
    p90: float,
    p99: float,
}

fn metric_new(name: string, cap: int) -> Metric {
    return Metric {
        name: name,
        cap: cap,
        ring: native_buffer_float(cap),
        sorted: native_buffer_float(cap),
        head: 0,
        count: 0,
        mean: 0.0,
        stddev: 0.0,
        min: 0.0,
        max: 0.0,
        p50: 0.0,
        p90: 0.0,
        p99: 0.0,
    }
}

// round(p/100 * (n-1)), clamped to n-1. `min` isn't provably @pure, so the
// clamp is spelled out.
@pure
fn metric_percentile_index(p: int, n: int) -> int {
    if n <= 1 { return 0 }
    let idx = (p * (n - 1) + 50) ./ 100
    if idx > n - 1 { return n - 1 }
    return idx
}

// Only called from metric_add, which adds a sample first, so count >= 1.
fn metric_recompute(m: Metric) {
    let n = m.count
    let sum = 0.0
    let sum_sq = 0.0
    for i in 0..n {
        let x = nb_get(m.sorted, i)
        sum = sum + x
        sum_sq = sum_sq + x * x
    }
    let nf = n as float
    let mean = sum / nf
    m.mean = mean
    // Clamp guards float cancellation in the sum_sq - mean^2 variance form.
    m.stddev = sqrt(max(0.0, sum_sq / nf - mean * mean))
    m.min = nb_get(m.sorted, 0)
    m.max = nb_get(m.sorted, n - 1)
    m.p50 = nb_get(m.sorted, metric_percentile_index(50, n))
    m.p90 = nb_get(m.sorted, metric_percentile_index(90, n))
    m.p99 = nb_get(m.sorted, metric_percentile_index(99, n))
}

// Add one sample: maintain the ascending `sorted` window (evict oldest if
// full, insert the new value) and the insertion-order `ring`, then recompute
// the summary fields. O(cap), zero allocation, uniform cost per call.
fn metric_add(m: Metric, v: float) {
    let evicting = m.count >= m.cap

    // `len` = valid length of `sorted` after any eviction, before inserting v.
    let len = if evicting {
        // Remove the oldest sample (ring[head]) from sorted: linear scan for
        // its slot, then shift left. Equality is exact -- ring and sorted hold
        // the same bit-for-bit float32 (both written via nb_set).
        let old = nb_get(m.ring, m.head)
        let oi = 0
        for i in 0..m.count {
            if nb_get(m.sorted, i) == old {
                oi = i
                break
            }
        }
        for i in oi..(m.count - 1) {
            nb_set(m.sorted, i, nb_get(m.sorted, i + 1))
        }
        m.count - 1
    } else {
        m.count
    }

    // Ascending insert position for v in sorted[0..len); shift the tail right.
    let ins = len
    for i in 0..len {
        if v < nb_get(m.sorted, i) {
            ins = i
            break
        }
    }
    let j = len
    while j > ins {
        nb_set(m.sorted, j, nb_get(m.sorted, j - 1))
        j = j - 1
    }
    nb_set(m.sorted, ins, v)

    // Insertion-order ring + cursor.
    nb_set(m.ring, m.head, v)
    m.head = (m.head + 1) % m.cap
    if !evicting {
        m.count = m.count + 1
    }

    metric_recompute(m)
}

// Zero the metric in place: count/head + every summary field back to 0. The
// ring/sorted buffers are left as-is (logically empty at count 0; metric_add
// overwrites from head=0). Lets a caller restart a metric's window without
// re-allocating the buffers -- the warmup transition uses this instead of
// re-`metric_new`-ing everything.
fn metric_reset(m: Metric) {
    m.head = 0
    m.count = 0
    m.mean = 0.0
    m.stddev = 0.0
    m.min = 0.0
    m.max = 0.0
    m.p50 = 0.0
    m.p90 = 0.0
    m.p99 = 0.0
}

// Snapshot the live fields into a value struct -- for serializers (JSON/pretty)
// that pass a whole summary around. Not used on the per-frame hot path, where
// callers read m.mean / m.p99 directly.
fn metric_snapshot(m: Metric) -> StatSummary {
    return StatSummary {
        mean: m.mean,
        stddev: m.stddev,
        min: m.min,
        max: m.max,
        p50: m.p50,
        p90: m.p90,
        p99: m.p99,
        n: m.count,
    }
}

// Read the i-th most recent sample from a Metric's insertion-order ring
// (i=0 is newest). For plotting the raw signal as a time-series. Caller
// guarantees 0 <= i < m.count.
fn metric_recent(m: Metric, i: int) -> float {
    let idx = ((m.head - 1 - i) % m.cap + m.cap) % m.cap
    return nb_get(m.ring, idx)
}

// NativeBuffer<T: value> — value-struct elements
// ----------------------------------------------
// The ffi.cdef for every `value` struct is emitted automatically, so
// `ffi.new("Vec2[?]", n)` is a valid LuaJIT allocation. `native_buffer_alloc<T>`
// (above) is the generic-body-legal allocator: skull resolves the concrete
// element cdef name at each call site, so `native_buffer_alloc(n)` works for any
// FFI-clean value struct with no per-type boilerplate. At runtime elements are
// stored contiguously as `T` cdata (AoS); a whole-value `buf[i]` read copies the
// element out, `buf[i].x` reads the slot live, `buf[i].x = v` writes through it,
// and `buf[i] = v` copies the struct field-wise. See
// tests/native_buffer_value.rock, tests/value_element_read_copy.rock,
// tests/value_place_leaf_write.rock and FlatVec<T> below.

// ============================================================================
// FlatVec<T> — growable flat storage for FFI-clean value structs
// ============================================================================
//
// `NativeBuffer<T>` + a tracked `len` + amortized 2x growth, wearing Vec's API.
// Elements live inline in one ffi array (C-struct layout), so push/index lower to
// field-wise scalar stores/loads with zero steady-state allocation -- the boxed
// `[Vec2]` (Lua-table cell) cost a value struct pays escaping into a Vec.
//
// Every op is `@inline` and specializes per element type at its call site (the
// inliner's call-site specialization, docs/flatvec-plan.md P2): `buf[len] = v`
// scalarizes and `native_buffer_alloc<T>` names the ctype inside the spliced body.
// `T` MUST be an FFI-clean value struct -- a primitive or GC-carrying element is a
// spanned emit-time error at the `flat_vec_new` call (use `native_buffer_int`/
// `_float` for primitive buffers).
//
//     value RayTarget { angle: float, x: float, y: float }
//     let rays = flat_vec_new<RayTarget>(16)
//     rays.push(RayTarget { angle: a, x: px, y: py })   // zero-alloc
//     rays.sort((t) => t.angle)                          // by precomputed field
//     for i in 0..rays.len { let t = rays.get(i); ... }

struct FlatVec<T> { buf: NativeBuffer<T>, len: int }   // buf.len = capacity

// Constructor (no receiver -> a free fn, not the `Type.method` D-form).
@inline fn flat_vec_new<T>(cap: int = 8) -> FlatVec<T> {
    return FlatVec { buf: native_buffer_alloc(cap), len: 0 }
}

// Grow to 2x (>= 4) capacity via a fresh alloc + a scalar element-copy loop; the
// copy JIT-compiles at these sizes (docs/flatvec-plan.md P3 bench: scalar loop).
@inline fn FlatVec<T>.grow(fv) {
    let old = fv.buf
    let cap = old.len
    let new_cap = if cap < 2 { 4 } else { cap * 2 }
    let grown: NativeBuffer<T> = native_buffer_alloc(new_cap)
    for i in 0..fv.len {
        grown[i] = old[i]
    }
    fv.buf = grown
}

@inline fn FlatVec<T>.push(fv, v: T) {
    if fv.len == fv.buf.len {
        fv.grow()
    }
    fv.buf[fv.len] = v
    fv.len = fv.len + 1
}

// Debug-checked index (release strips the check -- inherits the NativeBuffer
// compile-mode gate, docs/compile-modes.md). `fv.get(i)` / `fv.set(i, v)`.
@inline fn FlatVec<T>.get(fv, i: int) -> T {
    if !is_release_mode() {
        if i < 0 || i >= fv.len {
            error("FlatVec.get: index {i} out of range (len {fv.len})")
        }
    }
    return fv.buf[i]
}

@inline fn FlatVec<T>.set(fv, i: int, v: T) {
    if !is_release_mode() {
        if i < 0 || i >= fv.len {
            error("FlatVec.set: index {i} out of range (len {fv.len})")
        }
    }
    fv.buf[i] = v
}

// clear keeps the allocated capacity; a later push reuses it (zero-alloc reset).
@inline fn FlatVec<T>.clear(fv) {
    fv.len = 0
}

// The typed staging pointer for the flat FFI upload path (shader_set_vec4_array
// _flat etc.): the first `len` elements are contiguous C-layout.
@inline fn FlatVec<T>.ptr(fv) -> Ptr<T> {
    return fv.buf.ptr
}

// In-place insertion sort by a `(T) -> float` key. The key fn must be capture-free
// (a capturing lambda allocates per call); a `(t) => t.field` projection compiles
// to one shared fn, no per-call closure. O(n^2); the pilot's n is small and the
// key is a single precomputed field read.
@inline fn FlatVec<T>.sort(fv, key_fn: (T) -> float) {
    for i in 1..fv.len {
        let x = fv.buf[i]
        let kx = key_fn(x)
        let j = i - 1
        while j >= 0 && key_fn(fv.buf[j]) > kx {
            fv.buf[j + 1] = fv.buf[j]
            j = j - 1
        }
        fv.buf[j + 1] = x
    }
}

// ----------------------------------------------------------------------------
// Sized-storage NativeBuffer variants (distinct-struct phantoms)
// ----------------------------------------------------------------------------
//
// These are distinct struct types backed by smaller C integer sizes. Same
// shape as NativeBuffer<int> at runtime (struct with `.ptr` + `.len`), but
// the Rock type system treats them as incompatible — passing a
// NativeBufferU8 where NativeBufferI16 is expected is a compile error.
//
// This is the ergonomic way to get phantom-style safety. Indexing surfaces
// as plain `int` (no newtype wrapping), because LuaJIT auto-converts
// uint8_t/int16_t/etc. to Lua number on read and truncates on write.
//
// Variants:
//   NativeBufferU8   / native_buffer_u8(n)   uint8_t[?]   — pixel bytes (RGBA)
//   NativeBufferI8   / native_buffer_i8(n)   int8_t[?]
//   NativeBufferU16  / native_buffer_u16(n)  uint16_t[?]  — short indices
//   NativeBufferI16  / native_buffer_i16(n)  int16_t[?]   — audio samples
//   NativeBufferU32  / native_buffer_u32(n)  uint32_t[?]  — packed colors, indices
//
// Element type is `int` for all of them. `.ptr` is typed as distinct
// `PtrU8`/`PtrI8`/`PtrU16`/`PtrI16`/`PtrU32` phantoms so extern signatures
// can declare the exact variant they accept — passing `PtrI16` where
// `PtrU8` is expected is a compile error.

struct NativeBufferU8  { ptr: PtrU8,  len: int }
struct NativeBufferI8  { ptr: PtrI8,  len: int }
struct NativeBufferU16 { ptr: PtrU16, len: int }
struct NativeBufferI16 { ptr: PtrI16, len: int }
struct NativeBufferU32 { ptr: PtrU32, len: int }

@intrinsic @native_required @nomangle inline(lua) fn __nb_alloc_u8(n: int)  -> PtrU8  = 'return ffi.new("uint8_t[?]", n)'
@intrinsic @native_required @nomangle inline(lua) fn __nb_alloc_i8(n: int)  -> PtrI8  = 'return ffi.new("int8_t[?]", n)'
@intrinsic @native_required @nomangle inline(lua) fn __nb_alloc_u16(n: int) -> PtrU16 = 'return ffi.new("uint16_t[?]", n)'
@intrinsic @native_required @nomangle inline(lua) fn __nb_alloc_i16(n: int) -> PtrI16 = 'return ffi.new("int16_t[?]", n)'
@intrinsic @native_required @nomangle inline(lua) fn __nb_alloc_u32(n: int) -> PtrU32 = 'return ffi.new("uint32_t[?]", n)'

fn native_buffer_u8(n: int)  -> NativeBufferU8  { return NativeBufferU8  { ptr: __nb_alloc_u8(n),  len: n } }
fn native_buffer_i8(n: int)  -> NativeBufferI8  { return NativeBufferI8  { ptr: __nb_alloc_i8(n),  len: n } }
fn native_buffer_u16(n: int) -> NativeBufferU16 { return NativeBufferU16 { ptr: __nb_alloc_u16(n), len: n } }
fn native_buffer_i16(n: int) -> NativeBufferI16 { return NativeBufferI16 { ptr: __nb_alloc_i16(n), len: n } }
fn native_buffer_u32(n: int) -> NativeBufferU32 { return NativeBufferU32 { ptr: __nb_alloc_u32(n), len: n } }

// Single-hop accessors per variant. All surface as int (LuaJIT handles
// the C<->Lua number conversion at the ffi boundary). One nb_get + nb_set
// pair per NativeBuffer phantom variant.
@intrinsic @native_required inline(lua) fn nb_get(b: NativeBufferU8,  i: int) -> int = "return b.ptr[i]"
@intrinsic @native_required inline(lua) fn nb_set(b: NativeBufferU8,  i: int, v: int) = "b.ptr[i] = v"
@intrinsic @native_required inline(lua) fn nb_get(b: NativeBufferI8,  i: int) -> int = "return b.ptr[i]"
@intrinsic @native_required inline(lua) fn nb_set(b: NativeBufferI8,  i: int, v: int) = "b.ptr[i] = v"
@intrinsic @native_required inline(lua) fn nb_get(b: NativeBufferU16, i: int) -> int = "return b.ptr[i]"
@intrinsic @native_required inline(lua) fn nb_set(b: NativeBufferU16, i: int, v: int) = "b.ptr[i] = v"
@intrinsic @native_required inline(lua) fn nb_get(b: NativeBufferI16, i: int) -> int = "return b.ptr[i]"
@intrinsic @native_required inline(lua) fn nb_set(b: NativeBufferI16, i: int, v: int) = "b.ptr[i] = v"
@intrinsic @native_required inline(lua) fn nb_get(b: NativeBufferU32, i: int) -> int = "return b.ptr[i]"
@intrinsic @native_required inline(lua) fn nb_set(b: NativeBufferU32, i: int, v: int) = "b.ptr[i] = v"

// Safe `.get(i) -> int?` per variant. Codegen for `buf[i]` emits the
// bounds-checked helper `__nb_checked_get` (type-agnostic on struct).
@intrinsic @native_required inline(lua) fn get(b: NativeBufferU8,  i: int) -> int? = """
    if i < 0 or i >= b.len then return nil end; return b.ptr[i]
"""
@intrinsic @native_required inline(lua) fn get(b: NativeBufferI8,  i: int) -> int? = """
    if i < 0 or i >= b.len then return nil end; return b.ptr[i]
"""
@intrinsic @native_required inline(lua) fn get(b: NativeBufferU16, i: int) -> int? = """
    if i < 0 or i >= b.len then return nil end; return b.ptr[i]
"""
@intrinsic @native_required inline(lua) fn get(b: NativeBufferI16, i: int) -> int? = """
    if i < 0 or i >= b.len then return nil end; return b.ptr[i]
"""
@intrinsic @native_required inline(lua) fn get(b: NativeBufferU32, i: int) -> int? = """
    if i < 0 or i >= b.len then return nil end; return b.ptr[i]
"""

// Debug-mode bounds-checked access. The compiler emits calls to these in
// non-release builds instead of direct buf.ptr[i] access. Release builds
// (`--release` or `ROCK_RELEASE=1`) skip the check entirely and emit raw
// ffi access, preserving zero-overhead semantics.
@nomangle inline(lua) fn __nb_checked_get(buf: any, i: int) -> any = """
    if i < 0 or i >= buf.len then
        error("NativeBuffer index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(buf.len) .. ")")
    end
    return buf.ptr[i]
"""

// Refresh a NativeBuffer's leaf VIEWS after its `ptr` has been reseated.
//
// The views (`__vf`/`__vi`/`__vb`) are `ffi.cast` pointers over the element
// storage, made once at construction. `ffi.cast` does NOT anchor its target, so
// any code that reassigns `buf.ptr` -- a hand-written `inline(lua)` grow/realloc
// -- leaves every view pointing at the OLD array, which is then collected: the
// views dangle and reads return garbage from reused memory.
//
// The compiler cannot see into an `inline(lua)` body, so this is an UNCHECKED
// CONTRACT of the same family as `@nomangle`: reseat `buf.ptr` by hand and you
// must call this. A regular Rock reallocation (`native_buffer_alloc`) builds a
// fresh buffer with fresh views and needs nothing.
@nomangle inline(lua) fn __nb_refresh_views(buf: any) = """
    if buf.__vf ~= nil then buf.__vf = ffi.cast("float*", buf.ptr) end
    if buf.__vi ~= nil then buf.__vi = ffi.cast("int*", buf.ptr) end
    if buf.__vb ~= nil then buf.__vb = ffi.cast("bool*", buf.ptr) end
"""

// Bounds-check WITHOUT taking a slot reference: returns the index unchanged.
// Leaf addressing turns one element access into K leaf accesses, and the check
// belongs to the ELEMENT -- checking each leaf would pay K times for one access,
// and checking after would let the out-of-bounds access happen first. So the
// check runs once, up front, and the leaves then index their views raw.
// (Sibling of `__vec_checked_index` for column storage.)
@nomangle inline(lua) fn __nb_checked_index(buf: any, i: int) -> int = """
    if i < 0 or i >= buf.len then
        error("NativeBuffer index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(buf.len) .. ")")
    end
    return i
"""

@nomangle inline(lua) fn __nb_checked_set(buf: any, i: int, v: any) = """
    if i < 0 or i >= buf.len then
        error("NativeBuffer index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(buf.len) .. ")")
    end
    buf.ptr[i] = v
"""

// True when this build was compiled with --release or ROCK_RELEASE=1.
// Set by the compiler in the BUILTIN module's init_code. Useful for
// tests that need to gate expectations on compile mode, and for
// conditionally expensive invariant checks at the source level.
@nomangle inline(lua) fn is_release_mode() -> bool = "return _G.__ROCK_RELEASE == true"

struct Arena<T> {
    entries: [ArenaEntry<T>],
    free_indices: [int],
    occupied_count: int = 0,
}

// GC-carrying `value` struct (generic + an `Arena<T>` field): immutable,
// scalarized through calls/loops so a non-escaping arena `for (e, d)` pair-scan
// builds no per-iteration Entity table; materializes as an immutable Lua table
// (`Entity_vt`) only where it escapes (stored in a Vec / enum payload / global).
// `==` is the metatable value eq: `_arena` by reference, `_index`/`_generation`
// structural -- so entities from the SAME arena with equal slot+generation are
// equal (a superset of `.equals`, which ignores the arena).
value Entity<T> {
    // `_`-prefixed: implementation details, hidden from member completion. Use
    // the method API (`get`/`remove`/`equals`/...), not the fields.
    _arena: Arena<T>,
    _index: int,
    _generation: int,
}

// ============================================================================
// Type System Runtime
// ============================================================================
//
// Types are registered by the compiler, not at runtime. skull's
// `type_table_defs` (`crates/skull/src/lib.rs`) emits
// `_G.__ROCK_TYPE_TABLE["TypeName"]` (field metadata used by reflection).
// The prelude pre-seeds the type table as empty so lookups are safe during
// the bootstrap window before those defs run.

// Get the Rock type of a table value from its direct `__ty` tag. Every
// struct/newtype/Vec carries it (set by __rock_create_struct / vec_new /
// skull's literal emission); there is no metatable. cdata `value` structs
// are not tables -- they reflect via __ROCK_TYPE_TABLE + ffi.istype, not here.
@nomangle inline(lua) fn __rock_get_type(obj: any) -> string? = """
    if type(obj) ~= "table" then
        return nil
    end
    return obj.__ty
"""

// A capturing-lambda env record (`setmetatable({__fn=..,..}, __rock_fn_mt)`) is
// the one metatable-carrying value in skull output. Every generic table-walker
// (__op_eq, inspect, serialize) must treat it as an opaque callable LEAF, not a
// data table -- this is the shared probe (mirrors __rock_get_type sharing). The
// global is guarded for a bare test harness with no runtime prelude; on a
// non-table `v`, getmetatable returns nil so the compare is false.
@nomangle inline(lua) fn __rock_is_fn_record(v: any) -> bool = """
    return _G.__rock_fn_mt ~= nil and getmetatable(v) == _G.__rock_fn_mt
"""

// Register a callback to fire after each hot reload. Two forms:
//   - `on_hot_reload(f)` stores a function VALUE — for closures / anonymous
//     callbacks. The value is captured once, so an EDITED body does not
//     propagate (the closure is fixed). Fine when the callback CODE is stable
//     and only its effect must re-run (buff reapply, cache rehydration).
//   - `on_hot_reload_by_name(name)` stores a global NAME, re-resolved via
//     `_G[name]` at every fire — so an edited body of that global DOES
//     propagate (the name-lookup trick coroutine step fns use). The `@on_reload`
//     deco uses this form, which is why `@on_reload` requires `@nomangle` (the
//     Lua global must equal the source name for `_G[name]` to resolve).
//
// Semantics:
//   - Callbacks fire in FIFO order of registration.
//   - The registry PERSISTS across firings; it is cleared only by
//     `__rock_clear_hot_reload_callbacks()` (which `clear_all_systems()` calls
//     at the start of a FULL reload, before `dofile` re-runs every `@on_reload`
//     deco-init). A body-edit OVERLAY never re-runs those deco-inits, so a fire
//     that consumed the list would leave it empty after the first light reload
//     and never fire again — the registration must survive every reload.
//   - The fire step iterates a COPY, so a callback that registers during the
//     pass lands in the next firing, not this one.
//   - The engine hot-reload pipeline invokes
//     `__rock_fire_hot_reload_callbacks()` after `dofile()` completes.
@nomangle inline(lua) fn on_hot_reload(f: fn() -> ()) = """
    if not _G.__rock_on_hot_reload then
        _G.__rock_on_hot_reload = {}
    end
    _G.__rock_on_hot_reload[#_G.__rock_on_hot_reload + 1] = f
"""

// Register a hot-reload callback by its GLOBAL NAME (re-resolved each fire), so
// an edited callback body propagates. The `@on_reload` deco uses this.
@nomangle inline(lua) fn on_hot_reload_by_name(name: string) = """
    if not _G.__rock_on_hot_reload then
        _G.__rock_on_hot_reload = {}
    end
    _G.__rock_on_hot_reload[#_G.__rock_on_hot_reload + 1] = name
"""

// JS: no hot reload (a browser/node program loads once); registration is a
// no-op so @on_reload-decorated fns compile unchanged.
@nomangle inline(js) fn on_hot_reload(f: fn() -> ()) = ""
@nomangle inline(js) fn on_hot_reload_by_name(name: string) = ""

// Fire every registered on_hot_reload callback. Iterates a COPY and does NOT
// clear the list (see on_hot_reload's doc). A STRING entry is a global name,
// resolved via `_G[name]` at fire time (name-lookup → edited bodies propagate);
// a missing name is logged once and skipped (the global was renamed/removed, or
// mangled — `@on_reload` requires `@nomangle` to keep it stable). A non-string
// entry is a function value, called directly.
@nomangle inline(lua) fn __rock_fire_hot_reload_callbacks() = """
    local src = _G.__rock_on_hot_reload or {}
    local cbs = {}
    for i = 1, #src do cbs[i] = src[i] end
    for i = 1, #cbs do
        local entry = cbs[i]
        if type(entry) == "string" then
            local f = _G[entry]
            if f then
                f()
            else
                _G.__rock_hot_reload_missing = _G.__rock_hot_reload_missing or {}
                if not _G.__rock_hot_reload_missing[entry] then
                    _G.__rock_hot_reload_missing[entry] = true
                    __stone_log(0, "HOTRELOAD", "on_reload callback '" .. entry .. "' is not a global (renamed/mangled? @on_reload needs @nomangle); skipping")
                end
            end
        else
            entry()
        end
    end
"""

// Reset the on_hot_reload callback list. Called by engine `clear_all_systems()`
// at the start of a hot reload — mirrors the behavior of clearing
// INIT_SYSTEMS/DRAW_SYSTEMS/etc, so callbacks that were registered via
// mechanisms that re-run during dofile (e.g. the @on_reload decorator)
// don't accumulate duplicates.
@nomangle inline(lua) fn __rock_clear_hot_reload_callbacks() = """
    _G.__rock_on_hot_reload = {}
"""

// @on_reload — a function decorator that registers the decorated function
// as a hot-reload callback. The deco-init body runs on every function
// definition, so after `clear_all_systems()` wipes the list and the engine
// re-runs the script, the decorated function re-registers itself.
//
// Registers BY NAME (not value), so editing the decorated function's body and
// hot-reloading runs the NEW body — the global is re-resolved at fire time.
// This requires the function to be `@nomangle` (the Lua global must equal the
// source name); a missing `@nomangle` is a compile error.
//
// This is the canonical way to hook into hot reload for global state
// that needs to refresh after reload — top-level `on_hot_reload(f)` calls
// don't work for this purpose because they live in __rock_main, which is
// HOT_RELOAD-guarded and skipped on reload.
//
// Example:
//   @nomangle
//   @on_reload
//   fn reapply_buffs() {
//       for p in ALL_PLAYERS { p.buffs.reapply() }
//   }
deco init on_reload {
    on_hot_reload_by_name(target.name)
}

// Program entry wrapper. The assembler emits a single call to this at the
// very end of the compiled output, passing the user's `main` function as an
// argument. Skips under hot reload (the reload path re-runs top-level code
// but must not re-enter main), catches Ctrl+C cleanly, and re-raises other
// errors with their original message so stack traces point at the real fault.
@nomangle inline(lua) fn __rock_main_wrapper(main_fn: any) = """
    if _G.HOT_RELOAD then return end
    local ok, err = pcall(main_fn)
    if not ok then
        if type(err) == "string" and err:find("interrupted!") then
            os.exit(0)
        else
            error(err, 0)
        end
    end
"""

// Generic operator functions using different names to avoid compiler conflicts
@nomangle inline(lua) fn __op_eq(a: any, b: any) -> bool = """
    -- Primitive fast path
    if type(a) ~= "table" or type(b) ~= "table" then
        return a == b
    end

    -- Same reference
    if a == b then return true end

    local type_a = __rock_get_type(a)
    local type_b = __rock_get_type(b)

    -- A capturing-lambda env record is a callable value, not a data table: it
    -- compares as an opaque LEAF by IDENTITY, never by walking its capture
    -- fields (mirrors the inspect/serialize record rule). Two distinct closure
    -- instances with equal captures are NOT equal; the same instance already
    -- returned true above. A record carries no `__ty`, so gate on `not type_a`:
    -- a tagged struct/enum compare skips the getmetatable probe entirely.
    if not type_a and __rock_is_fn_record(a) then
        return rawequal(a, b)
    end

    -- Different Rock types are never equal
    if type_a and type_b and type_a ~= type_b then
        return false
    end

    -- A GC-carrying value struct (table repr) carries a per-type `__eq`
    -- metatable that is the AUTHORITY: scalar/value fields structural, GC-ref
    -- fields BY REFERENCE. The `a == b` reference check above already invoked it
    -- (LuaJIT fires `__eq` on two same-metamethod tables); reaching here means it
    -- returned false, so they are unequal -- do NOT fall through to the generic
    -- structural walk (which would compare a GC-ref field by contents).
    local mt = getmetatable(a)
    if mt and mt.__eq then
        return false
    end

    -- Structural equality: walk fields (skipping the `__ty` tag). Covers
    -- structs, enums, newtypes, tuples, and anonymous Lua tables alike; cdata
    -- `value` structs never reach here (they hit the primitive `==` fast path
    -- above -- a byte-value compare).
    for k, v in pairs(a) do
        if k ~= "__ty" then
            if not __op_eq(v, b[k]) then
                return false
            end
        end
    end
    for k, v in pairs(b) do
        if k ~= "__ty" and a[k] == nil then
            return false
        end
    end
    return true
"""

@nomangle inline(lua) fn __op_ne(a: any, b: any) -> bool = """
    return not __op_eq(a, b)
"""

// Tag a newly-created struct table with its type. Emitted by structs.rs for
// every struct literal in user code. `__ty` is the single, direct type marker
// (same scheme as Vec and every other value) -- `__rock_get_type` reads it,
// `__op_eq`/inspect/serialize dispatch off it. No metatable: the old
// `__ROCK_METATABLES` mechanism was a pure `__rock_type` tag with no
// metamethods, redundant with `__ty`, and is gone
// (docs/skull-vec-representation-divergence.md).
@nomangle inline(lua) fn __rock_create_struct(typeName: string, fields: any) -> any = """
    local obj = fields or {}
    obj.__ty = typeName
    return obj
"""

// Runtime value for a range literal that escapes its for-loop iter-expression
// (e.g. `let r = 0..10; for x in r {}`). In the in-place case
// `for x in 0..10 {}`, loops.rs strips the `__range(a,b)` marker and emits a
// native numeric for — this function body is unreachable there. Returns a
// Vec-shaped `{_data, len}` so the result iterates and indexes like a Vec.
@nomangle inline(lua) fn __range(start_val: int, end_val: int) -> any = """
    local t = {}
    for i = start_val, end_val - 1 do
        table.insert(t, i)
    end
    return { _data = t, len = end_val - start_val }
"""

// Comparison operators
// Operators are functions. These primitive ones are pure and inline
// to native Lua ops (the parser lowers `a + b` to `__op_add(a, b)`;
// @inline inline(lua) splices the body back so hot loops stay native).
// Concrete primitive ==/!= overloads so resolution is exact (no
// ambiguity vs the `any` fallback). Operators are ordinary overloaded
// functions now; precise overloads replace the old operator-registry
// special disambiguation.
@pure @inline operator(lua) ==(a: int, b: int) -> bool = "return a == b"
@pure @inline operator(lua) ==(a: float, b: float) -> bool = "return a == b"
@pure @inline operator(lua) ==(a: bool, b: bool) -> bool = "return a == b"
@pure @inline operator(lua) !=(a: int, b: int) -> bool = "return a ~= b"
@pure @inline operator(lua) !=(a: float, b: float) -> bool = "return a ~= b"
@pure @inline operator(lua) !=(a: bool, b: bool) -> bool = "return a ~= b"
@pure @inline operator(lua) ==(a: any, b: any) -> bool = "return a == b"
@pure @inline operator(lua) !=(a: any, b: any) -> bool = "return a ~= b"

// Arithmetic operators
@pure @inline operator(lua) +(a: int, b: int) -> int = "return a + b"
@pure @inline operator(lua) +(a: float, b: float) -> float = "return a + b"
@pure @inline operator(lua) -(a: int, b: int) -> int = "return a - b"
@pure @inline operator(lua) -(a: float, b: float) -> float = "return a - b"
@pure @inline operator(lua) *(a: int, b: int) -> int = "return a * b"
@pure @inline operator(lua) *(a: float, b: float) -> float = "return a * b"
@pure @inline operator(lua) /(a: float, b: float) -> float = "return a / b"
@pure @inline operator(lua) ./(a: int, b: int) -> int = "return math.floor(a / b)"
@pure @inline operator(lua) %(a: int, b: int) -> int = "return a % b"
@pure @inline operator(lua) %(a: float, b: float) -> float = "return a % b"

// Less than, greater than operators
@pure @inline operator(lua) <(a: int, b: int) -> bool = "return a < b"
@pure @inline operator(lua) <(a: float, b: float) -> bool = "return a < b"
@pure @inline operator(lua) <=(a: int, b: int) -> bool = "return a <= b"
@pure @inline operator(lua) <=(a: float, b: float) -> bool = "return a <= b"
@pure @inline operator(lua) >(a: int, b: int) -> bool = "return a > b"
@pure @inline operator(lua) >(a: float, b: float) -> bool = "return a > b"
@pure @inline operator(lua) >=(a: int, b: int) -> bool = "return a >= b"
@pure @inline operator(lua) >=(a: float, b: float) -> bool = "return a >= b"

// Logical operators
@pure @inline operator(lua) &&(a: bool, b: bool) -> bool = "return a and b"
@pure @inline operator(lua) ||(a: bool, b: bool) -> bool = "return a or b"

// Unary operators
@pure @inline operator(lua) -(a: int) -> int = "return -a"
@pure @inline operator(lua) -(a: float) -> float = "return -a"
@pure @inline operator(lua) !(a: bool) -> bool = "return not a"
@pure @inline operator(lua) ~(a: int) -> int = "return bit.bnot(a)"

// String concatenation
@pure @inline operator(lua) +(a: string, b: string) -> string = "return a .. b"
@pure @inline operator(lua) ==(a: string, b: string) -> bool = "return a == b"
@pure @inline operator(lua) !=(a: string, b: string) -> bool = "return a ~= b"

// Bitwise operators (integers only)
@pure @inline operator(lua) &(a: int, b: int) -> int = "return bit.band(a, b)"
@pure @inline operator(lua) |(a: int, b: int) -> int = "return bit.bor(a, b)"
@pure @inline operator(lua) ^(a: int, b: int) -> int = "return bit.bxor(a, b)"
@pure @inline operator(lua) <<(a: int, b: int) -> int = "return bit.lshift(a, b)"
@pure @inline operator(lua) >>(a: int, b: int) -> int = "return bit.rshift(a, b)"

// Safe navigation (?.field, ?.method(), ?.let) is handled natively by the
// compiler — no runtime functions needed. The codegen emits inline nil checks.

// Print function
// Use native print but with our own float formatting
// `@debug_impure`: observable side effect, but debug-only. `@pure`
// functions that transitively call `print` get demoted with a warning
// (rather than a hard error) so a `print(x)` dropped into a pure
// helper for debugging doesn't force stripping the annotation.
@debug_impure
extern(lua) fn print(args: ...any)

// Helper to ensure float formatting
fn print_float(value: float) { print(to_string(value)) }

// Error handling
extern(lua) fn error(message: string)

// Note: Lua has built-in tostring(), declare as extern
extern(lua) fn tostring(value: any) -> string

// Method versions of tostring for basic types
fn to_string(value: int) -> string { return tostring(value) }

fn to_string(value: float) -> string {
    let str_value = tostring(value)
    // Ensure floats always show decimal point for Lua compatibility
    if str_value.find(".") == -1 { return str_value + ".0" }
    return str_value
}

// `to_string(string)` is the identity via @expand — does NOT allocate.
@inline inline(lua) fn to_string(value: string) -> string = "return value"

fn to_string(value: bool) -> string { return tostring(value) }

// Generic to_string function that handles any type including nullable/nil values
@nomangle inline(lua) fn to_string(value: any) -> string = """
    if value == nil then
        return "nil"
    end
    -- For tables (structs, arrays, etc.), use Rock's inspect for type-aware formatting
    if type(value) == "table" then
        return inspect(value)  -- This calls the Rock stdlib inspect function
    end
    return tostring(value)
"""

// Assert functions
fn assert(condition: bool, message: string) {
    if !condition { error(message) }
}

// Single parameter assert overload
fn assert(condition: bool) {
    if !condition { error("Assertion failed") }
}

// Assert equality/inequality, inline-expanded at the call site so
// failures surface with the caller's span instead of a stdlib frame.
// Args are let-bound once each to preserve fn-call semantics for
// side-effecting expressions like `assert_eq(next_counter(), 1)`.
macro assert_eq(actual: expr, expected: expr, message: expr = "Values should be equal") {
    let __actual = actual
    let __expected = expected
    if !(__actual == __expected) {
        error("Assertion failed: " + tostring(message) + " (expected: " + tostring(__expected) + ", got: " + tostring(__actual) + ")")
    }
}

macro assert_ne(actual: expr, expected: expr, message: expr = "Values should not be equal") {
    let __actual = actual
    let __expected = expected
    if __actual == __expected {
        error("Assertion failed: " + tostring(message) + " (both values are: " + tostring(__actual) + ")")
    }
}

// versions that use direct comparison - only use for primitive types!
fn assert_eq_simple<T>(actual: T, expected: T, message: string = "Values should be equal") {
    if !(actual == expected) {
        let error_msg = "Assertion failed: " + tostring(message) + " (expected: " + tostring(expected) + ", got: " + tostring(actual) + ")"
        error(error_msg)
    }
}

fn assert_ne_simple<T>(actual: T, expected: T, message: string = "Values should not be equal") {
    if actual == expected {
        let error_msg = "Assertion failed: " + tostring(message) + " (both values are: " + tostring(actual) + ")"
        error(error_msg)
    }
}

fn assert_true(condition: bool, message: string = "Expected true") {
    if !condition {
        let error_msg = "Assertion failed: " + tostring(message)
        error(error_msg)
    }
}

fn assert_false(condition: bool, message: string = "Expected false") {
    if condition {
        let error_msg = "Assertion failed: " + tostring(message)
        error(error_msg)
    }
}

fn assert_not_null<T>(value: T?, message: string = "Expected non-null value") {
    if value == null {
        let error_msg = "Assertion failed: " + tostring(message)
        error(error_msg)
    }
}

fn assert_null<T>(value: T?, message: string = "Expected null value") {
    if value != null {
        let error_msg = "Assertion failed: " + tostring(message)
        error(error_msg)
    }
}

// Range functions

// THE Vec constructor. Two roles, one function:
//   - typed (`-> [T]`): the type checker resolves `[...]` / `[]` literals to a
//     `vec_new` call so a Vec is `[T]`, not `any`. rock codegen also lowers
//     literals to this call (rock-codegen/src/anf/emit.rs); skull inlines the
//     table directly and never calls it.
//   - `@nomangle`: a single fixed name, so `inline(lua)` bodies that need an
//     empty Vec to push into call `vec_new()` directly.
// Emits the SAME shape skull uses for literals: a bare table with a direct
// `__ty = "Vec"` tag and NO metatable, so every Vec has one representation
// regardless of origin. `__ty` is the lone type marker (`__rock_get_type` reads
// it, the serializer checks `v.__ty == "Vec"`, methods resolve statically via
// UFCS). See docs/skull-vec-representation-divergence.md.
@nomangle inline(lua) fn vec_new<T>() -> [T] = """
    return { _data = {}, len = 0, __ty = "Vec" }
"""

// Bridges for inline(lua) callers that must work with the raw 1-indexed
// backing array (handing it to a C/Lua API, or wrapping one built in raw
// Lua). Keeps the `data` field name confined to stdlib.
@nomangle inline(lua) fn __rock_vec_to_lua_array<T>(vec: [T]) -> any = """
    local out = {}
    for i = 1, vec.len do out[i] = vec._data[i] end
    return out
"""

@nomangle inline(lua) fn __rock_vec_from_lua_array<T>(arr: any, len: int) -> [T] = """
    return { _data = arr, len = len, __ty = "Vec" }
"""

// Hot enough that the call frame matters — mag's outline-overlay loop
// calls this 3-6x per iteration over OUTLINE_MAX_ENTRIES. Body
// translated from the Rock equivalent
// `{ vec.len = vec.len + 1; table_set(vec._data, vec.len, item) }`.
// See docs/jit-fnew-codegen-investigation.md §"Fourth pass".
@nomangle @inline inline(lua) fn vec_push<T>(vec: [T], item: T) = """
    vec.len = vec.len + 1
    vec._data[vec.len] = item
"""

@nomangle @inline fn vec_get<T>(vec: [T], index: int) -> T? {
    if index < 0 || index >= vec.len {
        return null
    }
    return cast(__vec_data_get(vec, index))
}

// Safe accessor matching the unified `.get(i) -> T?` surface across all
// collection types. `v[i]` is the direct counterpart.
@inline fn Vec<T>.get(vec, index: int) -> T? {
    return vec_get(vec, index)
}

@nomangle fn vec_set<T>(vec: [T], index: int, value: T) {
    if index < 0 || index >= vec.len {
        error("Vec.set index out of bounds: index {index} is outside [0, {vec.len})")
    }
    __vec_data_set(vec, index, value)
}

// Bounds-checked indexing helpers, emitted by codegen for `xs[i]` reads and
// stores (the __nb_checked_* pattern; release stripping is the same future
// release-mode work). `.get(i)` above is the null-returning form.
@nomangle inline(lua) fn __vec_checked_get(vec: any, i: int) -> any = """
    if i < 0 or i >= vec.len then
        error("Vec index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(vec.len) .. ")")
    end
    return vec._data[i + 1]
"""

// Bounds-check once, return the 1-based backing index. Column-storage Vecs
// (`ContainerKind::VecValueColumns`) read K leaf arrays per element; checking
// here keeps the debug bounds contract at ONE call per access regardless of K,
// instead of one per column.
@nomangle inline(lua) fn __vec_checked_index(vec: any, i: int) -> int = """
    if i < 0 or i >= vec.len then
        error("Vec index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(vec.len) .. ")")
    end
    return i + 1
"""

@nomangle inline(lua) fn __vec_checked_set(vec: any, i: int, v: any) = """
    if i < 0 or i >= vec.len then
        error("Vec index out of bounds: index " .. tostring(i) ..
              " is outside [0, " .. tostring(vec.len) .. ")")
    end
    vec._data[i + 1] = v
"""

@nomangle fn vec_len<T>(vec: [T]) -> int {
    return vec.len
}

// Bare-name UFCS wrappers for the 5 codegen-tied @nomangle vec_* fns.
// Codegen emits `vec_push`/`vec_get`/`vec_set`/`vec_len`/`vec_new` by
// literal name (Lua codegen lowers `xs[i]`, `[a,b,c]`, etc. to those
// calls), so the underlying functions stay @nomangle with the prefix
// name. Users still write `xs.push(x)`/`xs.len()`/etc. — these
// wrappers are how those dot-form calls resolve.
@inline fn Vec<T>.push(vec, item: T) { vec_push(vec, item) }
@inline fn Vec<T>.set(vec, index: int, value: T) { vec_set(vec, index, value) }
@inline fn Vec<T>.len(vec) -> int { return vec_len(vec) }


fn Vec<T>.pop(vec) -> T? {
    if vec.len == 0 {
        return null
    }
    let value: T? = cast(__vec_data_get(vec, vec.len - 1))
    __vec_data_unset(vec, vec.len - 1)
    vec.len = vec.len - 1
    return value
}

fn Vec<T>.is_empty(vec) -> bool {
    return vec.len == 0
}

fn Vec<T>.clear(vec) {
    for i in 0..vec.len {
        __vec_data_unset(vec, i)
    }
    vec.len = 0
}

fn Vec<T>.remove_at(vec, index: int) -> T? {
    if index < 0 || index >= vec.len {
        return null
    }
    let value: T? = cast(__vec_data_get(vec, index))
    for i in index..(vec.len - 1) {
        __vec_data_set(vec, i, __vec_data_get(vec, i + 1))
    }
    __vec_data_unset(vec, vec.len - 1)
    vec.len = vec.len - 1
    return value
}

fn Vec<T>.swap_remove(vec, index: int) -> T? {
    if index < 0 || index >= vec.len {
        return null
    }
    let value: T? = cast(__vec_data_get(vec, index))
    if index + 1 < vec.len {
        __vec_data_set(vec, index, __vec_data_get(vec, vec.len - 1))
    }
    __vec_data_unset(vec, vec.len - 1)
    vec.len = vec.len - 1
    return value
}

// enumerate() materializes an eager [(int, value)] Vec. In for-position
// (`for (i, x) in enumerate(coll)`) bone keeps the builtin template lowering
// (`builtin_enumerable`) and never calls these overloads; they serve non-`for`
// uses (`let it = enumerate(v)`), so the declared Vec type is the real runtime
// shape. Chains (`v.iter().enumerate()`) resolve to the EnumIter overload.

fn Vec<T>.enumerate(collection) -> [(int, T)] {
    let out: [(int, T)] = []
    for i in 0..collection.len {
        out.push((i, collection[i]))
    }
    return out
}

fn Arena<T>.enumerate(collection) -> [(int, (Entity<T>, T))] {
    let out: [(int, (Entity<T>, T))] = []
    let i = 0
    for (e, v) in collection {
        out.push((i, (e, v)))
        i = i + 1
    }
    return out
}

fn Map<K, V>.enumerate(collection) -> [(int, (K, V))] {
    let out: [(int, (K, V))] = []
    let i = 0
    for (k, v) in collection {
        out.push((i, (k, v)))
        i = i + 1
    }
    return out
}

// NativeBuffer enumerate: for-loop codegen intercepts `for ... in enumerate(buf)`
// via unwrap_enumerate_expr and emits a direct numeric loop reading buf.ptr[i].
// This overload only runs if enumerate(buf) is called from a non-for-loop
// context (e.g. stored in a variable) — it materializes the tuples into a Vec.
inline(lua) fn enumerate<T>(collection: NativeBuffer<T>) -> [(int, T)] = """
    local out = vec_new()
    local n = collection.len
    local ptr = collection.ptr
    for i = 0, n - 1 do
        out.len = out.len + 1
        out._data[out.len] = { i, ptr[i] }
    end
    return out
"""

// Sized NativeBuffer variants: type-checker stubs so `enumerate(buf)`
// typechecks; the for-loop codegen intercepts and emits a direct numeric
// loop, so the body is only reached if enumerate is called from a
// non-for-loop context (rare). Macro-generated — one invocation per
// phantom variant.
inline(lua) fn enumerate(collection: NativeBufferU8) -> [(int, int)] = """
    local out = vec_new(); local n = collection.len; local ptr = collection.ptr
    for i = 0, n - 1 do out.len = out.len + 1; out._data[out.len] = { i, ptr[i] } end
    return out
"""
inline(lua) fn enumerate(collection: NativeBufferI8) -> [(int, int)] = """
    local out = vec_new(); local n = collection.len; local ptr = collection.ptr
    for i = 0, n - 1 do out.len = out.len + 1; out._data[out.len] = { i, ptr[i] } end
    return out
"""
inline(lua) fn enumerate(collection: NativeBufferU16) -> [(int, int)] = """
    local out = vec_new(); local n = collection.len; local ptr = collection.ptr
    for i = 0, n - 1 do out.len = out.len + 1; out._data[out.len] = { i, ptr[i] } end
    return out
"""
inline(lua) fn enumerate(collection: NativeBufferI16) -> [(int, int)] = """
    local out = vec_new(); local n = collection.len; local ptr = collection.ptr
    for i = 0, n - 1 do out.len = out.len + 1; out._data[out.len] = { i, ptr[i] } end
    return out
"""
inline(lua) fn enumerate(collection: NativeBufferU32) -> [(int, int)] = """
    local out = vec_new(); local n = collection.len; local ptr = collection.ptr
    for i = 0, n - 1 do out.len = out.len + 1; out._data[out.len] = { i, ptr[i] } end
    return out
"""

// rev() reverses any [T] into a new Vec.
fn Vec<T>.rev(collection) -> [T] {
    let out: [T] = []
    let n = collection.len
    for i in 0..n {
        out.push(collection[n - 1 - i])
    }
    return out
}

// Null coalesce operator
inline(lua) fn __op_null_coalesce<T>(a: T?, b: T) -> T = """
    if a == nil then return b else return a end
"""

// Overload for nullable ?? nullable -> nullable
inline(lua) fn __op_null_coalesce<T>(a: T?, b: T?) -> T? = """
    if a == nil then return b else return a end
"""

// Unwrap functions for nullable types (moved early to support vec functions)
@nomangle @inline inline(lua) fn is_null(value: any) -> bool = "return value == nil"

// Expands debug.traceback("", 2) inline — level 2 = caller of the enclosing function.
@inline inline(lua) fn __debug_traceback() -> string = 'return debug.traceback("", 2)'

@inline fn unwrap<T>(value: T?) -> T {
    if value != null { return value }
    error("unwrap() called on null value\n" + __debug_traceback())
    return phantom()
}

@nomangle fn unwrap_or<T>(value: T?, alt: T) -> T {
    return value ?? alt
}

fn expect<T>(value: T?, message: string) -> T {
    if value != null { return value }
    error("expect() failed: " + message + "\n" + __debug_traceback())
    return phantom()
}

// Common utility functions. min/max are concrete int/float overloads, not
// generic: an unconstrained `min<T>` shape-matches every two-arg call and
// ties with specialized overloads (`Vec2.min`), and its body only ever
// worked for ordered primitives anyway.
@intrinsic @pure fn max(a: int, b: int) -> int {
    if a > b { return a } else { return b }
}

@intrinsic @pure fn max(a: float, b: float) -> float {
    if a > b { return a } else { return b }
}

@intrinsic @pure fn min(a: int, b: int) -> int {
    if a < b { return a } else { return b }
}

@intrinsic @pure fn min(a: float, b: float) -> float {
    if a < b { return a } else { return b }
}


@intrinsic @pure fn clamp(value: float, min: float, max: float) -> float {
    if value < min {
        return min
    } else if value > max {
        return max
    } else {
        return value
    }
}

// Type introspection functions
@inline inline(lua) fn typeof(x: any) -> string = "type(x)"

// Historical aliases for `float(int)`. All three — `float`, `int_to_float`,
// `to_float` — are `@expand("$1")` identities, substituted at call sites
// with zero runtime cost. `float(int)` is the canonical name.
@intrinsic @pure @inline inline(lua) fn int_to_float(value: int) -> float = "return value"
@intrinsic @pure @inline inline(lua) fn to_float(value: int) -> float = "return value"

// `float_to_int` is taken as a fn VALUE (tests/function_ref_cross_module), so
// it needs a real bound JS fn, not a call-site template: an inline(js) sibling
// of the inline(lua) body. bone collapses the same-name backend pair to one
// logical fn in the value path, so the reference / call binds the right variant.
inline(lua) fn float_to_int(value: float) -> int = """
    if type(value) ~= "number" then
        error("Expected a number, got " .. type(value))
    end
    return math.floor(value)
"""
inline(js) fn float_to_int(value: float) -> int = "return Math.floor(value);"

@inline fn to_int(value: float) -> int { return float_to_int(value) }

// Aliasing-preserving, cycle-safe deep copy. `seen` maps each already-copied
// source table to its copy; recording `seen[obj] = copy` BEFORE recursing
// children makes two references to one table (or one shared capture box) copy
// to ONE table, and lets a cyclic table copy without recursing forever. One
// seen table per top-level `deepcopy` call. Hoisted (like __rock_inspect_value)
// so the wrapper doesn't allocate a fresh closure per copy; @nomangle because
// it recurses by name and is called from deepcopy's body.
@nomangle inline(lua) fn __rock_deepcopy_value(obj: any, seen: any) -> any = """
    if type(obj) == "cdata" and _G.__ROCK_C_STRUCT then
        for _, info in pairs(_G.__ROCK_C_STRUCT) do
            if ffi.istype(info.name, obj) then
                return info.copy(obj)
            end
        end
        return obj
    end
    if type(obj) ~= "table" then
        return obj
    end
    if seen[obj] then
        return seen[obj]
    end

    local copy = {}
    seen[obj] = copy
    for k, v in pairs(obj) do
        -- copy *both* key and value, in case either is a table.
        copy[__rock_deepcopy_value(k, seen)] = __rock_deepcopy_value(v, seen)
    end
    -- Preserve the metatable: a capturing lambda is an env record carrying
    -- `__rock_fn_mt` (its `__call` is what makes it invokable) -- a copy that
    -- drops it is an uncallable table. General, not fn-record-special-cased.
    setmetatable(copy, getmetatable(obj))

    return copy
"""

@nomangle inline(lua) fn deepcopy<T>(obj: T) -> T = """
    return __rock_deepcopy_value(obj, {})
"""

@materialize @intrinsic @pure fn materialize<T>(value: T) -> T {
    return value
}

// Both cast<T> and transmute<A,B> are no-ops at runtime — they just reshape
// the Rock type, no Lua work needed. `@expand("$1")` substitutes the arg
// at each call site with zero overhead. See docs/compiler-architecture.md.
@inline inline(lua) fn cast<T>(value: any) -> T = "return value"
@inline inline(lua) fn transmute<A, B>(x: A) -> B = "return x"

// int and float are both `number` in Lua — this cast is a no-op at runtime.
// `@expand("$1")` substitutes the argument expression at the call site with
// zero function-call overhead. Confirmed in tmp/codegen_expand.lua: calls
// vanish entirely in the generated Lua.
@intrinsic @pure @inline inline(lua) fn float(value: int) -> float = "return value"

// Coroutine support functions
// Global resume function for method call rewrite - will be overridden by coroutine object methods
// Type parameters: Y = yield type, R = return type (returned via
// `.result()`), N = resume-arg type (lands with resume-with-value
// per docs/coroutine-resume-with-value-plan.md).
// `Coroutine<Y>` resolves to `Coroutine<Y, (), ()>` via PR-α
// default-type-params + PR-A arity bump; `.resume()` shape stays
// `Y?` regardless of R (D2a unit-elision), with the typed return
// value on `.result()`.
inline(lua) fn resume<Y, R, N>(c: Coroutine<Y, R, N>) -> Y? = """
    return c.__resume(c)
"""

// Unified resume: 2-arg overload for `N != ()`. Same name as the
// arg-less form -- Rock's overload-by-arity picks the right one at
// the call site (`c.resume()` -> 1-arg; `c.resume(arg)` -> 2-arg).
// The body's `let x = yield V` reads `arg` here on the next pump.
//
// Polish B (`b06199ca0`) rejects the arg-less form when N != ()
// at compile time -- the 2-arg form is the only valid resume there.
// For N = (), both forms compile; the 2-arg form is rarely useful
// (no `let x = yield V` exists for the body to bind), so prefer the
// arg-less form there.
inline(lua) fn resume<Y, R, N>(c: Coroutine<Y, R, N>, arg: N) -> Y? = """
    return c.__resume(c, arg)
"""

// PR-γ: read the value stashed by `return expr` at a co fn's
// terminal. Returns null when the coroutine is still suspended, was
// killed, or fell off without a value-bearing return. For
// `R = ()` coroutines (the default), `R?` is `()?` and is always
// null in practice — same observable as before.
inline(lua) fn result<Y, R, N>(c: Coroutine<Y, R, N>) -> R? = """
    return c.__return
"""

inline(lua) fn status<Y, R, N>(c: Coroutine<Y, R, N>) -> string = """
    if c.__state == -2 then return "errored" elseif c.__state < 0 then return "dead" else return "suspended" end
"""

// Ran to its natural end (`return` / fall-off; terminal -3), as opposed to
// killed (-1) or errored (-2) -- the only state where `result()` is
// trustworthy: explicit `return`s are bone-coerced to R and a reachable
// fall-off in a concrete non-unit co fn rejects at emit, so for a completed
// coroutine `__return` holds the body's return value (nil iff R is unit or a
// null-valued nullable). `status()` keeps reporting "dead" for both completed
// and killed.
inline(lua) fn completed<Y, R, N>(c: Coroutine<Y, R, N>) -> bool = """
    return c.__state == -3
"""

// D6b: read the error message captured when a step-fn raised during a
// `.resume()`. Returns `null` when the coroutine is suspended, dead
// (killed), or completed normally. The runtime puts the coroutine into
// the new "errored" terminal state on a step-fn raise; status() reports
// "errored", subsequent resumes return null, and last_error() reads
// whatever the body's `error("...")` raised. Avoid name collision with
// the stdlib `extern(lua) fn error(message: string)` (the panic-style
// thrower) -- that's a parking note from the design discussion.
inline(lua) fn last_error<Y, R, N>(c: Coroutine<Y, R, N>) -> string? = """
    return c.__error
"""

// Generators-as-iterators: a `Coroutine<Y, R, ()>` iterates as itself via
// the structural `next` protocol. Resume, then key liveness off `status()`
// (NOT a null-sentinel), so a body that `yield null`s (nullable `Y`) still
// produces real null elements. `N != ()` has no overload -- a `for` head
// can't supply a resume-arg -- so a resume-taking coroutine rejects at the
// loop naturally.
fn next<Y, R>(c: Coroutine<Y, R, ()>) -> (bool, Y) {
    let y = resume(c)
    if status(c) == "suspended" {
        return (true, cast(y))
    }
    return (false, phantom())
}

// Kill a coroutine. Fires the on_killed hook (if registered) and
// transitions state to terminal. Further resumes return nil. Idempotent:
// calling kill twice only fires the hook once.
// Run a dying coroutine's still-pending terminal defers, LIFO, each body
// pcall'd so one failing defer is logged and the rest still run. `__defers`
// holds the per-site defer fns BY VALUE (creation-time), so a stale frame
// (hot-reload stamp-kill) runs cleanup matching ITS layout. @nomangle: called
// from __rock_coroutine_kill's inline body and from compiler-emitted ctors.
@nomangle inline(lua) fn __rock_coroutine_run_defers(c: any) = """
    if not c.__defers then return end
    for i = #c.__defers, 1, -1 do
        local ok, err = pcall(c.__defers[i], c)
        if not ok then __stone_log(0, "CO", "coroutine defer failed during cleanup: " .. tostring(err)) end
    end
"""

// Recursive kill core: terminal-mark, chain into the delegated inner
// (`await` stores it at `__inner`), run pending terminal defers, fire the
// on_killed hook. @nomangle: calls ITSELF by name and is called from kill()'s
// inline(lua) body.
@nomangle inline(lua) fn __rock_coroutine_kill(c: any) = """
    if c.__state < 0 then return end
    c.__state = -1
    if c.__inner then __rock_coroutine_kill(c.__inner) end
    __rock_coroutine_run_defers(c)
    if c.__on_killed then c.__on_killed(c) end
"""

inline(lua) fn kill<Y, R, N>(c: Coroutine<Y, R, N>) = """
    __rock_coroutine_kill(c)
"""

// Fire the on_hot_reload hook on a live coroutine instance (if declared
// and not already terminal). The engine's coroutine poller drives this
// on every hot reload across all polled coroutines. Safe to call on any
// handle — dead or hook-less coroutines no-op.
inline(lua) fn fire_hot_reload<Y, R, N>(c: Coroutine<Y, R, N>) = """
    if c.__state >= 0 and c.__on_hot_reload then
        c.__on_hot_reload(c)
    end
"""

// Register a closure to run at the start of every .resume() call on this
// coroutine instance. MUST be called inside a co fn body — the compiler
// relocates this call to constructor-time so the hook fires on the first
// resume too. Invoking outside a co fn body is a runtime error.
inline(lua) fn on_resume(f: fn() -> ()) = """
    error("on_resume can only be called inside a co fn body")
"""

// Register a closure to run when the handle's .kill() is invoked. MUST
// be called inside a co fn body. Invoking outside is a runtime error.
inline(lua) fn on_killed(f: fn() -> ()) = """
    error("on_killed can only be called inside a co fn body")
"""

// Low-level Lua table operations for implementing [T]
inline(lua) fn table_new() -> any = """return {}"""

@inline inline(lua) fn table_insert(tbl: any, value: any) = "table.insert(tbl, value)"

@inline inline(lua) fn table_insert_at(tbl: any, index: int, value: any) = "table.insert(tbl, index, value)"

// Trampoline primitives — these are one-line Lua bodies that the JIT
// can't see through when emitted as a function (frame inlining tripped
// `loop unroll limit reached` in per-frame paths like vec_push /
// vec_get). Marked `@inline inline(lua)` so codegen splices the body
// at every call site instead of emitting + calling. See
// docs/function-and-inlining-design.md and
// docs/jit-fnew-codegen-investigation.md §"Fourth pass".
@inline inline(lua) fn table_len(tbl: any) -> int = """
    return #tbl
"""

@intrinsic @native_required @inline inline(lua) fn table_get(tbl: any, index: any) -> any = """
    return tbl[index]
"""

@intrinsic @native_required @inline inline(lua) fn table_set(tbl: any, index: any, value: any) = """
    tbl[index] = value
"""

// Field references. The `.field` literal is the interned field name at runtime;
// `o[f]` == `o.field` since skull emits named struct keys. `FieldRef<T, V>` is
// the TOP of the lattice -- it carries both capabilities and coerces down to the
// single-capability selectors. `ReadFieldRef<T, V>` is read-only (`field_get`)
// and allows a `value`-struct T, since reading a value field is fine; the
// writable side refuses a `value`-struct T (immutable). Split per
// docs/field-refs-plan.md 1.
// `field_set` takes the write-only `WriteFieldRef<T, V>` -- the selector an
// EMBEDDED field can satisfy, being the one that grants no whole-value read
// (docs/scalarization-and-boxing-design.md S 6). A `FieldRef` coerces down to
// it, so call sites are unchanged.
@inline inline(lua) fn field_get<T, V>(o: T, f: ReadFieldRef<T, V>) -> V = """
    return o[f]
"""

@inline inline(lua) fn field_set<T, V>(o: T, f: WriteFieldRef<T, V>, v: V) = """
    o[f] = v
"""

@inline inline(lua) fn table_unset(tbl: any, index: any) = """
    tbl[index] = nil
"""

// Base-agnostic Vec `_data` element accessors: a logical 0-based element index,
// the storage base absorbed per-backend (luajit 1-based `[i + 1]`, JS 0-based
// `[i]` via the intrinsic map) so the shared pure-Rock Vec ops stop hard-coding
// the Lua base. `@inline` so hot `vec_get` / drain callsites still splice with
// no call frame.
@nomangle @inline inline(lua) fn __vec_data_get(vec: any, index: int) -> any = "return vec._data[index + 1]"
@nomangle @inline inline(lua) fn __vec_data_set(vec: any, index: int, value: any) = "vec._data[index + 1] = value"
@nomangle @inline inline(lua) fn __vec_data_unset(vec: any, index: int) = "vec._data[index + 1] = nil"

// The COLD half of the same boundary. `get`/`set`/`unset` cover every op that
// reaches storage one element at a time; these are the ops that touch the
// backing AS A WHOLE (allocate it, measure it, copy it, shift it, reorder it),
// which a per-element accessor cannot express. Same contract: the body below is
// the boxed lowering, and a column-stored receiver is intercepted at lowering,
// statically per instantiation -- never a runtime `_data` test.
//
// Not `@inline`: these are cold (construction, clone, sort), so a call frame is
// the right trade and splicing them into every caller is not.
@nomangle inline(lua) fn __vec_data_alloc<T>(capacity: int) -> [T] = """
    local tbl = {}
    for i = 1, capacity do tbl[i] = false end
    return { _data = tbl, len = 0, __ty = "Vec" }
"""

@nomangle inline(lua) fn __vec_data_capacity<T>(vec: [T]) -> int = "return #vec._data"

@nomangle inline(lua) fn __vec_data_insert<T>(vec: [T], lua_index: int, value: T) = """
    table.insert(vec._data, lua_index, value)
"""

@nomangle inline(lua) fn __vec_data_clone<T>(vec: [T]) -> [T] = """
    local copy = {}
    for i = 1, #vec._data do copy[i] = vec._data[i] end
    return { _data = copy, len = vec.len, __ty = "Vec" }
"""

@nomangle inline(lua) fn __vec_data_sort<T, K>(vec: [T], key_fn: fn(T) -> K) = """
    table.sort(vec._data, function(a, b)
        return key_fn(a) < key_fn(b)
    end)
"""

// Column-storage counterparts, called by the lowering with ONE column table at
// a time -- so the leaf count stays a compile-time fact and no runtime key walk
// is needed.
@nomangle inline(lua) fn __rock_col_insert(col: any, lua_index: int, value: any) = """
    table.insert(col, lua_index, value)
"""

@nomangle inline(lua) fn __rock_col_copy(col: any) -> any = """
    local copy = {}
    for i = 1, #col do copy[i] = col[i] end
    return copy
"""

@nomangle inline(lua) fn __rock_col_capacity(reserved: int, physical: int) -> int = """
    if reserved > physical then return reserved end
    return physical
"""

// Whether `v` is a column-stored Vec.
@nomangle inline(lua) fn __rock_is_column_vec(v: any) -> bool = """
    if type(v) ~= "table" or v.__ty ~= "Vec" then return false end
    local h = rawget(v, "@vec")
    return type(h) == "table" and h.repr == "columns"
"""

// The sorted leaf paths of a column Vec -- the shared key discovery, so zip and
// sort can never disagree about column order.
@nomangle inline(lua) fn __rock_col_paths(vec: any) -> any = """
    local names = {}
    for k, v in pairs(vec) do
        if k ~= "len" and k ~= "__ty" and k ~= "@vec" and type(v) == "table" then
            names[#names + 1] = k
        end
    end
    table.sort(names)
    return names
"""

@nomangle inline(lua) fn __rock_materialize_column_type(
    vec: any,
    index: int,
    type_name: string,
    prefix: string
) -> any = """
    local decl = _G.__ROCK_TYPE_TABLE[type_name]
    local ctor = _G[type_name .. "_ct"]
    if not decl or (decl.kind ~= "c_struct" and decl.kind ~= "c_enum") or not ctor then
        error("invalid column element type: " .. tostring(type_name))
    end
    local args = {}
    for i = 1, #decl.fields do
        local field = decl.fields[i]
        local path = prefix == "" and field.name or (prefix .. "." .. field.name)
        local child = _G.__ROCK_TYPE_TABLE[field.type]
        if child and (child.kind == "c_struct" or child.kind == "c_enum") then
            args[i] = __rock_materialize_column_type(vec, index, field.type, path)
        else
            args[i] = vec[path][index]
        end
    end
    return ctor(unpack(args))
"""

@nomangle inline(lua) fn __rock_materialize_column_element(vec: any, index: int) -> any = """
    local h = rawget(vec, "@vec")
    if type(h) ~= "table" or h.repr ~= "columns" then
        error("expected column Vec")
    end
    return __rock_materialize_column_type(vec, index, h.elem, "")
"""

@nomangle inline(lua) fn __rock_vec_column_elements(vec: any) -> any = """
    local out = {}
    for i = 1, vec.len or 0 do
        out[i] = __rock_materialize_column_element(vec, i)
    end
    return out
"""

@nomangle inline(lua) fn __rock_col_sort<T, K>(vec: [T], key_fn: fn(T) -> K) = """
    local n = vec.len or 0
    local order = {}
    local elements = {}
    for i = 1, n do
        order[i] = i
        elements[i] = __rock_materialize_column_element(vec, i)
    end
    table.sort(order, function(a, b)
        return key_fn(elements[a]) < key_fn(elements[b])
    end)
    for _, path in ipairs(__rock_col_paths(vec)) do
        local col = vec[path]
        local tmp = {}
        for i = 1, n do tmp[i] = col[order[i]] end
        for i = 1, n do col[i] = tmp[i] end
    end
"""

inline(lua) fn table_clear(tbl: any) = """
    for k in pairs(tbl) do
        tbl[k] = nil
    end
"""

inline(lua) fn table_copy(tbl: any) -> any = """
    local copy = {}
    for k, v in pairs(tbl) do
        copy[k] = v
    end
    return copy
"""

inline(lua) fn table_copy_array(tbl: any) -> any = """
    local copy = {}
    for i = 1, #tbl do
        copy[i] = tbl[i]
    end
    return copy
"""

inline(lua) fn table_new_with_size(size: int) -> any = """
    local tbl = {}
    for i = 1, size do
        tbl[i] = false  -- Pre-allocate with false values
    end
    return tbl
"""

@inline inline(lua) fn table_remove(t: any, key: any) -> any = "table.remove(t, key)"

// Global constants
global PI: float = 3.141592653589793

// Assert function overloads are defined earlier in the file to avoid duplicates

// Inspect function for debugging — pretty-prints any value.
// cycle_detect=true (default) tracks visited tables to detect cycles.
// precision=-1 (default) means no float precision formatting.
// Module-level recursive helper. Hoisted out of `inspect` so each call
// doesn't allocate a fresh pair of upvalue-capturing closures
// (`_itbl` / `format_value`) — that closure construction tripped
// LuaJIT's FNEW abort on every table-shaped inspect call. State that
// the old closures captured (`visited`, `precision`) is now passed
// explicitly. See docs/jit-fnew-codegen-investigation.md.
@nomangle inline(lua) fn __rock_inspect_value(v: any, indent: string, path: string, visited: any, precision: int) -> string = """
    local vt = type(v)
    if vt == "string" then
        return "\"" .. v .. "\""
    elseif vt == "number" then
        if precision >= 0 and v ~= math.floor(v) then
            return string.format("%." .. precision .. "f", v)
        end
        return tostring(v)
    elseif vt ~= "table" then
        return tostring(v)
    end

    -- table case
    local t = v
    -- A capturing-lambda env record is a callable value, not a data table --
    -- render it as its function (the hoisted `__fn`), matching a capture-free
    -- lambda (a raw Lua function), never by walking its capture fields.
    if __rock_is_fn_record(t) then
        return tostring(t.__fn)
    end
    if visited then
        if visited[t] then
            return "<CYCLE: " .. visited[t] .. ">"
        end
        visited[t] = path
    end

    local type_name = __rock_get_type(t)

    -- Vec type
    -- The explicit column marker wins even when the element itself has an
    -- `_data` leaf column.
    if type_name == "Vec" and t.len and (t._data or __rock_is_column_vec(t)) then
        local elems
        if __rock_is_column_vec(t) then
            elems = __rock_vec_column_elements(t)
        else
            elems = t._data
        end
        local parts = {}
        for i = 1, t.len do
            parts[i] = __rock_inspect_value(elems[i], indent, path .. "[" .. (i-1) .. "]", visited, precision)
        end
        if visited then visited[t] = nil end
        if #parts == 0 then return "Vec { }" end
        return "Vec { " .. table.concat(parts, ", ") .. " }"
    end

    -- Check if sequential array
    local is_array = true
    local max_index = 0
    local count = 0
    for k, _ in pairs(t) do
        count = count + 1
        if type(k) ~= "number" or k ~= math.floor(k) or k < 1 then
            is_array = false
            break
        end
        max_index = math.max(max_index, k)
    end
    is_array = is_array and count == max_index

    local result
    if is_array then
        if max_index == 0 then
            if visited then visited[t] = nil end
            return "{}"
        end
        local parts = {}
        for i = 1, max_index do
            parts[i] = __rock_inspect_value(t[i], indent, path .. "[" .. (i-1) .. "]", visited, precision)
        end
        result = "{ " .. table.concat(parts, ", ") .. " }"
    else
        -- Collect and sort keys, skipping metadata
        local keys = {}
        local seen = {}
        for k, _ in pairs(t) do
            -- A dotted key is a compiler-minted PHYSICAL slot (an `embed` leaf,
            -- a flattened enum's discriminant/payload). It has no source-level
            -- name, so it is never shown; the declared field it belongs to is
            -- rendered from the leaves instead.
            if k ~= "__variant" and k ~= "__ty"
               and not (type(k) == "string" and string.find(k, ".", 1, true)) then
                keys[#keys + 1] = k
                seen[k] = true
            end
        end
        -- A null field is an ABSENT key, so `pairs` alone under-reports a
        -- struct's shape. Declared fields come from the type table instead.
        local decl = type_name and _G.__ROCK_TYPE_TABLE[type_name]
        local embed_vals = nil
        if decl and not t.__variant then
            for i = 1, #decl.fields do
                local f = decl.fields[i]
                if not seen[f.name] then
                    keys[#keys + 1] = f.name
                    seen[f.name] = true
                end
                -- An embedded field's declared name holds either nothing or a
                -- presence flag, so rebuild its logical value from the leaves.
                -- A TABLE there means this is already a rebuilt logical view
                -- (nested embed), whose child sits under the name directly.
                if f.embed and type(t[f.name]) ~= "table" then
                    embed_vals = embed_vals or {}
                    embed_vals[f.name] = __rock_embed_view(t, f.name, f.type, f.nullable)
                end
            end
        end
        table.sort(keys, __rock_inspect_key_lt)

        local variant = t.__variant

        -- Unit enum variant
        if type_name and variant and #keys == 0 then
            if visited then visited[t] = nil end
            return type_name .. "::" .. variant
        end

        -- Header
        local header
        if type_name and variant then
            header = type_name .. "::" .. variant
        elseif type_name then
            header = type_name
        else
            header = ""
        end

        if #keys <= 2 then
            -- Compact single-line
            local parts = {}
            for i, k in ipairs(keys) do
                local key_str = type(k) == "string" and k or ("[" .. tostring(k) .. "]")
                local v = t[k]
                if embed_vals and embed_vals[k] ~= nil then v = embed_vals[k] end
                parts[i] = key_str .. " = " .. __rock_inspect_value(v, indent, path .. "." .. tostring(k), visited, precision)
            end
            if header ~= "" then
                result = header .. " { " .. table.concat(parts, ", ") .. " }"
            else
                result = "{ " .. table.concat(parts, ", ") .. " }"
            end
        else
            -- Multi-line
            local lines = {}
            for _, k in ipairs(keys) do
                local key_str = type(k) == "string" and k or ("[" .. tostring(k) .. "]")
                local v = t[k]
                if embed_vals and embed_vals[k] ~= nil then v = embed_vals[k] end
                lines[#lines + 1] = indent .. "  " .. key_str .. " = " .. __rock_inspect_value(v, indent .. "  ", path .. "." .. tostring(k), visited, precision)
            end
            local body = table.concat(lines, ",\n")
            if header ~= "" then
                result = header .. " {\n" .. body .. "\n" .. indent .. "}"
            else
                result = "{\n" .. body .. "\n" .. indent .. "}"
            end
        end
    end

    if visited then visited[t] = nil end
    return result
"""

// Rebuild an `embed` field's LOGICAL value from the parent's physical leaves.
// The child has no box of its own: its leaves live at `<prefix>.<subfield>` on
// the parent, recursively, and a nullable embed keeps presence at `<prefix>`.
// Returns nil when absent, so an absent field reads as null rather than as a
// struct assembled from stale leaves.
@nomangle inline(lua) fn __rock_embed_view(t: any, prefix: string, ty: string, nullable: bool) -> any = """
    if nullable and t[prefix] == nil then return nil end
    local decl = _G.__ROCK_TYPE_TABLE[ty]
    if not decl then return nil end
    local o = { __ty = ty }
    for i = 1, #decl.fields do
        local f = decl.fields[i]
        local key = prefix .. "." .. f.name
        if f.embed then
            o[f.name] = __rock_embed_view(t, key, f.type, f.nullable)
        else
            o[f.name] = t[key]
        end
    end
    return o
"""

// Hoisted sort comparator — module-level so `table.sort` doesn't allocate
// a fresh closure per inspect call. (FNEW abort, same root cause.)
@nomangle inline(lua) fn __rock_inspect_key_lt(a: any, b: any) -> bool = """
    return tostring(a) < tostring(b)
"""

@nomangle inline(lua) fn inspect(obj: any, cycle_detect: bool = true, precision: int = -1) -> string = """
    if type(obj) == "cdata" and _G.__ROCK_C_STRUCT then
        for _, info in pairs(_G.__ROCK_C_STRUCT) do
            if ffi.istype(info.name, obj) then
                return info.inspect(obj)
            end
        end
        return tostring(obj)
    end

    -- Primitive fast path — avoids touching the table-case helper at all.
    local obj_type = type(obj)
    if obj_type ~= "table" then
        if obj_type == "string" then
            return "\"" .. obj .. "\""
        elseif obj_type == "number" and precision >= 0 and obj ~= math.floor(obj) then
            return string.format("%." .. precision .. "f", obj)
        else
            return tostring(obj)
        end
    end

    local visited = cycle_detect and {} or nil
    return __rock_inspect_value(obj, "", "root", visited, precision)
"""

// Thin wrapper kept for compiler codegen compatibility (incremental.rs emits inspect_formatted calls).
@nomangle inline(lua) fn inspect_formatted(obj: any, precision: int) -> string = """
    return inspect(obj, true, precision)
"""

// Smart float formatting for `"{x}"` interpolation: scientific for
// very small/large magnitudes; up to 4 decimals otherwise, trailing
// zeros and trailing decimal point trimmed. Module-level (not an
// IIFE per interpolation) so LuaJIT can trace per-frame string
// building without an FNEW abort. See
// docs/jit-fnew-codegen-investigation.md open thread #5.
@nomangle inline(lua) fn __rock_format_float(v: float) -> string = """
    local av = math.abs(v)
    if av ~= 0 and (av < 0.0001 or av >= 1000000) then
        return string.format("%.2g", v)
    else
        local s = string.format("%.4f", v)
        s = s:gsub("0+$", "")
        s = s:gsub("%.$", "")
        return s
    end
"""


// Math functions
// random / random_range / random_int / random_seed read and mutate the
// splitmix64 RNG state (`__rock_rng_next`, seeded in skull's prelude) —
// NotPure, intentionally no @pure. One stream: the state is a single
// serializable uint64 counter, so replay/keyframe restore can round-trip it
// (docs/replay-scrub-plan.md).
// 53-bit mantissa draw: top 53 bits of the next splitmix64 word / 2^53 gives
// a uniform [0, 1) double (bit-identical across architectures — math.random
// is not).
inline(lua) fn random() -> float = """
    return tonumber(__rock_rng_next() / 2048ULL) * (1.0 / 9007199254740992.0)
"""
fn random_range(min: float, max: float) -> float { return random() * (max - min) + min }
inline(lua) fn random_int(min: int, max: int) -> int = """
    local r = max - min
    if r <= 0 then return min end
    local z = __rock_rng_next()
    return tonumber(z % ffi.cast("uint64_t", r)) + min
"""
inline(lua) fn random_seed(seed: int) = """
    __rock_rng_seed(seed)
"""
@intrinsic @pure @inline inline(lua) fn sin(x: float) -> float = "math.sin(x)"
@intrinsic @pure @inline inline(lua) fn cos(x: float) -> float = "math.cos(x)"
@intrinsic @pure @inline inline(lua) fn tan(x: float) -> float = "math.tan(x)"
@intrinsic @pure @inline inline(lua) fn sqrt(x: float) -> float = "math.sqrt(x)"
@intrinsic @pure @inline inline(lua) fn exp(x: float) -> float = "math.exp(x)"
@intrinsic @pure @inline inline(lua) fn pow(a: float, b: float) -> float = "math.pow(a, b)"
@intrinsic @pure @inline inline(lua) fn atan2(y: float, x: float) -> float = "math.atan2(y, x)"
@intrinsic @pure fn round(x: float) -> float { return floor(x + 0.5) }
@pure fn round_to_places(x: float, places: int) -> float {
    let mult = pow(10.0, float(places))
    return floor(x * mult + 0.5) / mult
}
@intrinsic @pure @inline inline(lua) fn abs(x: float) -> float = "math.abs(x)"
@intrinsic @pure @inline inline(lua) fn abs(x: int) -> int = "math.abs(x)"

@intrinsic @pure fn sign(x: int) -> int {
    if x > 0 { 1 } else if x < 0 { -1 } else { 0 }
}
@intrinsic @pure fn sign(x: float) -> float {
    if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 }
}
@intrinsic @pure @inline inline(lua) fn floor(x: float) -> float = "math.floor(x)"
@intrinsic @pure @inline inline(lua) fn ceil(x: float) -> float = "math.ceil(x)"

// Miscellaneous functions
inline(lua) fn get_os() -> string = """
    -- Returns the operating system: "Windows", "Linux", "OSX", or "Other"
    if jit then
        return jit.os
    else
        -- Fallback for non-LuaJIT environments
        if package.config:sub(1,1) == '\\' then
            return "Windows"
        else
            return "Linux"  -- Could be any Unix-like OS
        end
    end
"""

@inline inline(lua) fn phantom<T>() -> T = """return nil"""
inline(lua) fn tuple_first<A, B>(tuple: (A, B)) -> A = """return tuple[1]"""
inline(lua) fn tuple_second<A, B>(tuple: (A, B)) -> B = """return tuple[2]"""
inline(lua) fn tuple_nth<A>(tuple: any, n: int) -> A = """return tuple[n]"""

fn char_to_byte(c: string) -> int { return unit_at(c, 0) }


// FFI helper functions for LuaJIT FFI interop
@inline inline(lua) fn ffi_new(ty: string) -> any = "ffi.new(ty)"

inline(lua) fn ffi_new_array(ty: string, size: int) -> any = """
    return ffi.new(ty .. "[" .. size .. "]")
"""

@inline inline(lua) fn ffi_new_with_init(ty: string, init: any) -> any = "ffi.new(ty, init)"

@inline inline(lua) fn ffi_sizeof(ty: string) -> int = "ffi.sizeof(ty)"

@inline inline(lua) fn ffi_typeof(ty: string) -> any = "ffi.typeof(ty)"

@inline inline(lua) fn ffi_cast(ty: string, obj: any) -> any = "ffi.cast(ty, obj)"

inline(lua) fn ffi_null() -> any = """
    return nil
"""

inline(lua) fn ffi_string(ptr: any, len: int?) -> string = """
    if len then
        return ffi.string(ptr, len)
    else
        return ffi.string(ptr)
    end
"""

inline(lua) fn ffi_copy(dst: any, src: any, len: int?) = """
    if len then
        ffi.copy(dst, src, len)
    else
        ffi.copy(dst, src)
    end
"""

inline(lua) fn ffi_fill(dst: any, len: int, value: int?) = """
    if value then
        ffi.fill(dst, len, value)
    else
        ffi.fill(dst, len)
    end
"""

inline(lua) fn ffi_cdef(def: string) = """
    _G._ffi_defined = _G._ffi_defined or {}
    if not _G._ffi_defined[def] then
        ffi.cdef(def)
        _G._ffi_defined[def] = true
    end
"""


// Map operations
fn map_new<K, V>() -> Map<K, V> {
    transmute(table_new())
}

fn Map<K, V>.insert(map, key: K, value: V) {
    map[key] = value
}

@nomangle @inline inline(lua) fn Map<K, V>.get(map, key: K) -> V? = """
    return map[key]
"""

// (The `.get(k)` UFCS surface for Map<K,V> resolves through `get`
// above — the naming convention `map_*` is what `m.get(k)` prefers. No
// separate `get<K,V>` overload needed.)

// Checked map read: emitted by the compiler for `m[key]` syntax on
// Map<K, V>. Returns V directly and errors if the key is missing.
// (`.get(key)` stays for the safe V? variant.)
@nomangle fn __map_get_checked(map: any, key: any) -> any {
    let v = table_get(map, key)
    assert(!is_null(v), "Map key not found")
    v
}

fn Map<K, V>.remove(map, key: K) -> V? {
    let old = get(map, key)
    table_unset(map, key)
    old
}

fn Map<K, V>.contains(map, key: K) -> bool {
    get(map, key) != null
}

fn Map<K, V>.len(map) -> int {
    let count = 0
    for (k, v) in map {
        count = count + 1
    }
    count
}


fn Map<K, V>.clear(map) {
    for (k, v) in map {
        table_unset(map, k)
    }
}

fn Map<K, V>.keys(map) -> [K] {
    let keys: [K] = []
    for (k, v) in map {
        vec_push(keys, k)
    }
    sort(keys, (k: K) => tostring(k))
    return keys
}

fn Map<K, V>.values(map) -> [V] {
    let keys = keys(map)
    let values: [V] = []
    for k in keys {
        vec_push(values, map[k])
    }
    return values
}

fn Map<K, V>.to_array(map) -> [(K, V)] {
    let keys = keys(map)
    let result: [(K, V)] = []
    for k in keys {
        vec_push(result, (k, map[k]))
    }
    return result
}

// Additional Map operations

// Get value or insert default if key doesn't exist
fn Map<K, V>.get_or_insert(map, key: K, default_value: V) -> V {
    let existing = get(map, key)
    if existing != null {
        return existing
    }
    map[key] = default_value
    default_value
}

// Update existing value only if key exists, returns old value if it existed
fn Map<K, V>.update(map, key: K, value: V) -> V? {
    let old = get(map, key)
    if old != null {
        map[key] = value
    }
    old
}

// Insert or update value (upsert), returns old value if it existed
fn Map<K, V>.upsert(map, key: K, value: V) -> V? {
    let old = get(map, key)
    map[key] = value
    old
}

// Range functions

// Backing implementation of the `a..b` and `a..b..step` range operators.
// Codegen desugars `a..b` to `__rock_range(a, b, 1)`.
// step > 0: forward [min, max); step < 0: backward (max, min]; step == 0: empty.
@nomangle fn __rock_range(min: int, max: int, step: int = 1) -> [int] {
    let result: [int] = []
    if step == 0 { return result }
    if step > 0 {
        let i = min
        while i < max {
            result.push(i)
            i = i + step
        }
    } else {
        let i = min
        while i > max {
            result.push(i)
            i = i + step
        }
    }
    return result
}

// count evenly-spaced floats from start to end, inclusive on both ends.
// linspace(0.0, 1.0, 5) -> [0.0, 0.25, 0.5, 0.75, 1.0]
// Uses index-based arithmetic (start + i*step) to avoid drift over many points.
fn linspace(start: float, end_val: float, count: int) -> [float] {
    let result: [float] = []
    if count <= 0 { return result }
    if count == 1 {
        result.push(start)
        return result
    }
    let step = (end_val - start) / float(count - 1)
    for i in 0..count {
        result.push(start + float(i) * step)
    }
    return result
}

// float values from start up to (but not including) end_val, spaced by step.
// float_range(0.0, 1.0, 0.25) -> [0.0, 0.25, 0.5, 0.75]
// Negative step iterates downward: float_range(10.0, 0.0, -3.0) -> [10.0, 7.0, 4.0, 1.0]
fn float_range(start: float, end_val: float, step: float) -> [float] {
    let result: [float] = []
    if step == 0.0 { return result }
    if step > 0.0 {
        let x = start
        while x < end_val {
            result.push(x)
            x = x + step
        }
    } else {
        let x = start
        while x > end_val {
            result.push(x)
            x = x + step
        }
    }
    return result
}

// Vec<T> — Rock's growable array type. `[T]` is syntactic sugar for
// `Vec<T>` (they are the same type). Backed by a plain Lua table in
// `data` (1-indexed) plus an explicit `len` so vec_* functions don't
// rely on `#t` which is unreliable for tables with holes.
struct Vec<T> {
    _data: any,
    len: int,
}

// Vec iteration -- `for x in vec` desugars through this iter/next pair
// (skull inlines both, SROA peels the cursor, and the FORL-recovery pass
// re-emits a native numeric `for`; parity with the old builtin template is
// pinned by `for_real_vec_loop_is_forl_zero_alloc` in skull-codegen-lua).
struct VecIter<T> {
    vec: [T],
    i: int,
}

@inline
fn Vec<T>.iter(v) -> VecIter<T> {
    return VecIter { vec: v, i: 0 }
}

@inline
fn VecIter<T>.next(it) -> (bool, T) {
    if it.i >= it.vec.len { return (false, phantom()) }
    let v = it.vec[it.i]
    it.i = it.i + 1
    return (true, v)
}

// Iterator combinators -- lazy wrapper iterators over any `I: Iterator<T>`
// (structural: any type with `next(I) -> (bool, T)`). All `@inline`: a chain
// like `v.iter().map(f).filter(p)` fully inlines at its `for` loop, SROA peels
// every cursor, and the FORL-recovery pass (`skull-transform/src/forl.rs`)
// rewrites the whole chain into a native counted `for` -- the chain IS the
// hand-written loop (`docs/iterator-desugaring-investigation.md`).
// Shapes are load-bearing for that matcher: map/enumerate are straight-line;
// filter fetches INSIDE its skip loop and take_while separates its two stop
// causes, so each layer contributes either a plain ok-flag join, a skip edge
// back to the fetch head, or a stop edge to a done block -- the shapes
// forl.rs peels. The fetch-outside rule (the 8.8x standalone-`next()` trace
// cliff) does NOT apply here: bounded combinators are always fully inlined
// (residual bound calls are compile errors), so no callable `next()` exists.

struct MapIter<I, T, U> {
    __inner: I,
    __f: fn(T) -> U,
}

@inline
fn map<I: Iterator<T>, T, U>(it: I, f: fn(T) -> U) -> MapIter<I, T, U> {
    return MapIter { __inner: it, __f: f }
}

@inline
fn MapIter<I: Iterator<T>, T, U>.next(it) -> (bool, U) {
    let (ok, x) = next(it.__inner)
    if !ok { return (false, phantom()) }
    return (true, (it.__f)(x))
}

struct FilterIter<I, T> {
    __inner: I,
    __pred: fn(T) -> bool,
}

@inline
fn filter<I: Iterator<T>, T>(it: I, pred: fn(T) -> bool) -> FilterIter<I, T> {
    return FilterIter { __inner: it, __pred: pred }
}

@inline
fn FilterIter<I: Iterator<T>, T>.next(it) -> (bool, T) {
    loop {
        let (ok, x) = next(it.__inner)
        if !ok { return (false, phantom()) }
        if (it.__pred)(x) { return (true, x) }
    }
    return (false, phantom())
}

struct EnumIter<I, T> {
    __inner: I,
    __i: int,
}

@inline
fn enumerate<I: Iterator<T>, T>(it: I) -> EnumIter<I, T> {
    return EnumIter { __inner: it, __i: -1 }
}

@inline
fn EnumIter<I: Iterator<T>, T>.next(it) -> (bool, (int, T)) {
    let (ok, x) = next(it.__inner)
    if !ok { return (false, phantom()) }
    it.__i = it.__i + 1
    return (true, (it.__i, x))
}

struct ZipIter<I1, I2, A, B> {
    __a: I1,
    __b: I2,
}

@inline
fn zip<I1: Iterator<A>, I2: Iterator<B>, A, B>(a: I1, b: I2) -> ZipIter<I1, I2, A, B> {
    return ZipIter { __a: a, __b: b }
}

@inline
fn ZipIter<I1: Iterator<A>, I2: Iterator<B>, A, B>.next(it) -> (bool, (A, B)) {
    let (ok_a, x) = next(it.__a)
    if !ok_a { return (false, phantom()) }
    let (ok_b, y) = next(it.__b)
    if !ok_b { return (false, phantom()) }
    return (true, (x, y))
}

struct TakeWhileIter<I, T> {
    __inner: I,
    __pred: fn(T) -> bool,
    __done: bool,
}

@inline
fn take_while<I: Iterator<T>, T>(it: I, pred: fn(T) -> bool) -> TakeWhileIter<I, T> {
    return TakeWhileIter { __inner: it, __pred: pred, __done: false }
}

@inline
fn TakeWhileIter<I: Iterator<T>, T>.next(it) -> (bool, T) {
    if it.__done { return (false, phantom()) }
    let (ok, x) = next(it.__inner)
    if !ok {
        it.__done = true
        return (false, phantom())
    }
    if !(it.__pred)(x) {
        it.__done = true
        return (false, phantom())
    }
    return (true, x)
}

struct SkipIter<I, T> {
    __inner: I,
    __n: int,
}

@inline
fn skip<I: Iterator<T>, T>(it: I, n: int) -> SkipIter<I, T> {
    return SkipIter { __inner: it, __n: n }
}

// Same shape as FilterIter: single fetch at the loop head, a skip edge
// back to it while the counter is live, one return edge -- so forl.rs
// peels it identically.
@inline
fn SkipIter<I: Iterator<T>, T>.next(it) -> (bool, T) {
    loop {
        let (ok, x) = next(it.__inner)
        if !ok { return (false, phantom()) }
        if it.__n <= 0 { return (true, x) }
        it.__n = it.__n - 1
    }
    return (false, phantom())
}

struct StepByIter<I, T> {
    __inner: I,
    __n: int,
    __skip: int,
}

// Yields the first element, then every nth after it (indices 0, n, 2n, ...).
@inline
fn step_by<I: Iterator<T>, T>(it: I, n: int) -> StepByIter<I, T> {
    if n < 1 { error("step_by: n must be >= 1, got {n}") }
    return StepByIter { __inner: it, __n: n, __skip: 0 }
}

// Same peelable shape as SkipIter: single fetch at the head, a drop edge
// back to it while __skip is live, one return edge. __skip re-arms to n-1
// after each yield.
@inline
fn StepByIter<I: Iterator<T>, T>.next(it) -> (bool, T) {
    loop {
        let (ok, x) = next(it.__inner)
        if !ok { return (false, phantom()) }
        if it.__skip <= 0 {
            it.__skip = it.__n - 1
            return (true, x)
        }
        it.__skip = it.__skip - 1
    }
    return (false, phantom())
}

struct TakeIter<I, T> {
    __inner: I,
    __n: int,
}

// Yields at most n elements, then stops (the count-bounded dual of take_while).
@inline
fn take<I: Iterator<T>, T>(it: I, n: int) -> TakeIter<I, T> {
    return TakeIter { __inner: it, __n: n }
}

@inline
fn TakeIter<I: Iterator<T>, T>.next(it) -> (bool, T) {
    if it.__n <= 0 { return (false, phantom()) }
    let (ok, x) = next(it.__inner)
    if !ok { return (false, phantom()) }
    it.__n = it.__n - 1
    return (true, x)
}

struct ChainIter<I1, I2, T> {
    __a: I1,
    __b: I2,
    __first: bool,
}

// Concatenate two iterators of the same element type: all of a, then all of b.
@inline
fn chain<I1: Iterator<T>, I2: Iterator<T>, T>(a: I1, b: I2) -> ChainIter<I1, I2, T> {
    return ChainIter { __a: a, __b: b, __first: true }
}

@inline
fn ChainIter<I1: Iterator<T>, I2: Iterator<T>, T>.next(it) -> (bool, T) {
    if it.__first {
        let (ok, x) = next(it.__a)
        if ok { return (true, x) }
        it.__first = false
    }
    return next(it.__b)
}

// The current inner iterator is a real field (not II?) so `next(it.__cur)`
// advances its stored cursor -- a nullable would mutate a throwaway copy.
// __has gates the phantom initial before the first outer pull.
struct FlattenIter<IO, II, T> {
    __outer: IO,
    __cur: II,
    __has: bool,
}

@inline
fn flatten<IO: Iterator<II>, II: Iterator<T>, T>(outer: IO) -> FlattenIter<IO, II, T> {
    return FlattenIter { __outer: outer, __cur: phantom(), __has: false }
}

@inline
fn FlattenIter<IO: Iterator<II>, II: Iterator<T>, T>.next(it) -> (bool, T) {
    loop {
        if !it.__has {
            let (ok, inner) = next(it.__outer)
            if !ok { return (false, phantom()) }
            it.__cur = inner
            it.__has = true
        }
        let (ok2, x) = next(it.__cur)
        if ok2 { return (true, x) }
        it.__has = false
    }
    return (false, phantom())
}

// map each element to an iterator, then concatenate them all.
@inline
fn flat_map<IO: Iterator<T>, T, II: Iterator<U>, U>(it: IO, f: fn(T) -> II) -> FlattenIter<MapIter<IO, T, II>, II, U> {
    return flatten(map(it, f))
}

// Iterator terminal ops -- consume any `I: Iterator<T>` into a materialized
// value or scalar. The lazy combinators above are intermediate (iterator ->
// iterator); these are the other half of the API. Bounded, so they fully
// inline at the call site like the combinators.

@inline
fn collect<I: Iterator<T>, T>(it: I) -> [T] {
    let result: [T] = []
    for x in it {
        vec_push(result, x)
    }
    return result
}

@inline
fn reduce<I: Iterator<T>, T, U>(it: I, initial: U, f: (U, T) -> U) -> U {
    let acc = initial
    for x in it {
        acc = f(acc, x)
    }
    return acc
}

@inline
fn find<I: Iterator<T>, T>(it: I, pred: fn(T) -> bool) -> T? {
    for x in it {
        if pred(x) { return x }
    }
    return null
}

@inline
fn any<I: Iterator<T>, T>(it: I, pred: fn(T) -> bool) -> bool {
    for x in it {
        if pred(x) { return true }
    }
    return false
}

@inline
fn all<I: Iterator<T>, T>(it: I, pred: fn(T) -> bool) -> bool {
    for x in it {
        if !pred(x) { return false }
    }
    return true
}

@inline
fn count<I: Iterator<T>, T>(it: I) -> int {
    let n = 0
    for x in it { n = n + 1 }
    return n
}

@inline
fn min_by<I: Iterator<T>, T>(it: I, key: fn(T) -> float) -> T? {
    let best: T? = null
    let best_k = 0.0
    for x in it {
        let k = key(x)
        if best == null || k < best_k {
            best = x
            best_k = k
        }
    }
    return best
}

@inline
fn max_by<I: Iterator<T>, T>(it: I, key: fn(T) -> float) -> T? {
    let best: T? = null
    let best_k = 0.0
    for x in it {
        let k = key(x)
        if best == null || k > best_k {
            best = x
            best_k = k
        }
    }
    return best
}

@inline
fn sum<I: Iterator<int>>(it: I) -> int {
    let acc = 0
    for x in it { acc = acc + x }
    return acc
}

@inline
fn sum_f<I: Iterator<float>>(it: I) -> float {
    let acc = 0.0
    for x in it { acc = acc + x }
    return acc
}

// RingBuffer<T> -- fixed-capacity history buffer (trails, position history,
// decals). `push` appends until full, then overwrites the oldest. `ago(k)`
// indexes newest-first (ago(0) = last push); iteration is oldest-to-newest.

struct RingBuffer<T> {
    data: [T],
    cap: int,
    head: int,
}

fn ring_new<T>(cap: int) -> RingBuffer<T> {
    return RingBuffer { data: [], cap: cap, head: 0 }
}

fn RingBuffer<T>.len(rb) -> int { return rb.data.len }

fn RingBuffer<T>.push(rb, x: T) {
    if rb.data.len < rb.cap {
        rb.data.push(x)
    } else {
        rb.data[rb.head] = x
    }
    rb.head = (rb.head + 1) % rb.cap
}

fn RingBuffer<T>.ago(rb, k: int) -> T {
    let n = rb.data.len
    if k < 0 || k >= n {
        error("RingBuffer.ago out of range: k={k}, len={n}")
    }
    return rb.data[((rb.head - 1 - k) % n + n) % n]
}

fn RingBuffer<T>.clear(rb) {
    rb.data.clear()
    rb.head = 0
}

struct RingIter<T> {
    rb: RingBuffer<T>,
    i: int,
}

@inline
fn RingBuffer<T>.iter(rb) -> RingIter<T> {
    return RingIter { rb: rb, i: 0 }
}

@inline
fn RingIter<T>.next(it) -> (bool, T) {
    let n = it.rb.data.len
    if it.i >= n { return (false, phantom()) }
    let idx = (it.rb.head + it.rb.cap - n + it.i) % it.rb.cap
    it.i = it.i + 1
    return (true, it.rb.data[idx])
}

// Vec operations
// The eager functional ops (map/filter/reduce/fold_right/find/any/all) are
// deleted: `v.iter().<combinators>().<terminal>()` is the one mechanism.

fn vec_new_with_capacity<T>(capacity: int) -> [T] {
    return __vec_data_alloc(capacity)
}

fn Vec<T>.capacity(vec) -> int { return __vec_data_capacity(vec) }

fn Vec<T>.insert_at(vec, index: int, value: T) {
    if index < 0 || index > vec.len { error("Error: Index out of bounds") }

    // Convert 0-based to 1-based for Lua
    let lua_index = index + 1
    __vec_data_insert(vec, lua_index, value)
    vec.len += 1
}

fn Vec<T>.clone(vec) -> [T] {
    return __vec_data_clone(vec)
}

fn Vec<T>.sort<K>(vec, key_fn: fn(T) -> K) {
    __vec_data_sort(vec, key_fn)
}

fn Vec<T>.sample(vec) -> T? {
    let len = vec_len(vec)
    if len == 0 { return null }
    let index = random_int(0, len)
    return vec_get(vec, index)
}

@intrinsic @pure fn lerp(a: float, b: float, t: float) -> float { return a + (b - a) * t }

@intrinsic @pure fn fract(x: float) -> float { return x - floor(x) }

@intrinsic @pure fn smoothstep(edge0: float, edge1: float, x: float) -> float {
    let t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
}


fn ease_in_quad(t: float) -> float { return t * t }

fn ease_out_quad(t: float) -> float {
    let inv = 1 - t
    return 1 - inv * inv
}

fn ease_in_out_quad(t: float) -> float {
    if t < 0.5 {
        return 2.0 * t * t
    } else {
        // (-2t + 2)^2 / 2.0 = (2 - 2t)^2 / 2.0
        let x = 2.0 - 2.0 * t
        return 1 - (x * x) / 2.0
    }
}

fn ease_in_cubic(t: float) -> float { return t * t * t }

fn ease_out_cubic(t: float) -> float {
    let inv = 1 - t
    return 1 - inv * inv * inv
}

fn ease_in_out_cubic(t: float) -> float {
    if t < 0.5 {
        return 4.0 * t * t * t
    } else {
        let x = 2.0 - 2.0 * t
        return 1 - (x * x * x) / 2.0
    }
}

// Quartic
fn ease_in_quart(t: float) -> float { return t * t * t * t }

fn ease_out_quart(t: float) -> float {
    let inv = 1 - t
    return 1 - inv * inv * inv * inv
}

fn ease_in_out_quart(t: float) -> float {
    if t < 0.5 {
        return 8.0 * t * t * t * t
    } else {
        let x = 2.0 - 2.0 * t
        return 1 - (x * x * x * x) / 2.0
    }
}

// Quintic
fn ease_in_quint(t: float) -> float { return t * t * t * t * t }

fn ease_out_quint(t: float) -> float {
    let inv = 1 - t
    return 1 - inv * inv * inv * inv * inv
}

fn ease_in_out_quint(t: float) -> float {
    if t < 0.5 {
        return 16.0 * t * t * t * t * t
    } else {
        let x = 2.0 - 2.0 * t
        return 1 - (x * x * x * x * x) / 2.0
    }
}

// Sine
fn ease_in_sine(t: float) -> float { return 1 - cos(t * PI / 2.0) }

fn ease_out_sine(t: float) -> float { return sin(t * PI / 2.0) }

fn ease_in_out_sine(t: float) -> float { return -1 * (cos(PI * t) - 1) / 2.0 }

// Exponential
fn ease_in_expo(t: float) -> float {
    if t == 0 { return 0.0 } else { return pow(2.0, 10.0 * t - 10.0) }
}

fn ease_out_expo(t: float) -> float {
    if t >= 1 { return 1.0 } else { return 1 - pow(2.0, -10.0 * t) }
}

fn ease_in_out_expo(t: float) -> float {
    if t == 0 {
        return 0.0
    } else {
        if t >= 1 {
            return 1.0
        } else {
            if t < 0.5 {
                return pow(2.0, 20.0 * t - 10.0) / 2.0
            } else {
                return (2.0 - pow(2.0, -20.0 * t + 10.0)) / 2.0
            }
        }
    }
}

// Circular
fn ease_in_circ(t: float) -> float { return 1.0 - sqrt(1.0 - t * t) }

fn ease_out_circ(t: float) -> float { return sqrt(1.0 - (t - 1.0) * (t - 1.0)) }

fn ease_in_out_circ(t: float) -> float {
    if t < 0.5 {
        return (1.0 - sqrt(1.0 - (2.0 * t) * (2.0 * t))) / 2.0
    } else {
        return (sqrt(1.0 - (2.0 - 2.0 * t) * (2.0 - 2.0 * t)) + 1.0) / 2.0
    }
}

// Envelope -- goal-chasing follower with asymmetric rates (audio AR).
// Unlike a tween (event-triggered playback of a known from/to journey),
// an envelope has no timeline: pass the goal every step and it chases,
// retargeting mid-flight for free. Linear rate-limited, so `value`
// reaches the goal EXACTLY (no asymptotic tail); shaping (env^2,
// ease_out_quad, ...) is applied by consumers at the read site.
// Engine sugar stepping against the frame clock: Envelope.step (stone).

// The first no-box value customer after mutable-place semantics land.
struct Envelope {
    value: float = 0,
    attack: float,
    release: float,
}

fn envelope(attack: float, release: float) -> Envelope {
    return Envelope { value: 0, attack: attack, release: release }
}

fn Envelope.step_by(e, goal: float, step_dt: float) -> float {
    if e.value < goal {
        e.value = min(goal, e.value + step_dt / e.attack)
    } else {
        e.value = max(goal, e.value - step_dt / e.release)
    }
    return e.value
}

// String manipulation functions
// string had a redundant `len` + `length` pair (both `string.len`); keep
// `len` to match Vec/Map/Arena. (Vec2.length is an unrelated overload.)
@intrinsic @inline inline(lua) fn string.len(s) -> int = "string.len(s)"


@intrinsic inline(lua) fn string.substring(s, start: int, end_idx: int) -> string = """
    -- Rock uses 0-based indexing, Lua uses 1-based
    return string.sub(s, start + 1, end_idx)
"""

@inline inline(lua) fn string.upper(s) -> string = "string.upper(s)"

@inline inline(lua) fn string.lower(s) -> string = "string.lower(s)"

// Plain-text search for `substr`, starting the scan at unit index `from`.
// Returns the 0-based unit index of the first match at or after `from`, or -1.
// Stays intrinsic (Lua `string.find(..., true)` runs at C speed); Layer-2
// string algorithms in strings.rock build on it.
@intrinsic @native_required inline(lua) fn string.find(s, substr: string, from: int = 0) -> int = """
    local pos = string.find(s, substr, from + 1, true)
    if pos then
        return pos - 1  -- Convert to 0-based index
    else
        return -1
    end
"""

@intrinsic @inline inline(lua) fn string_char(code: int) -> string = "string.char(code)"

@intrinsic inline(lua) fn from_codepoint(cp: int) -> string = """
    if cp < 0 or cp > 0x10FFFF then
        error("from_codepoint: codepoint out of range: " .. tostring(cp))
    end
    if cp >= 0xD800 and cp <= 0xDFFF then
        error("from_codepoint: surrogate is not a code point: " .. tostring(cp))
    end
    if cp < 0x80 then
        return string.char(cp)
    elseif cp < 0x800 then
        return string.char(0xC0 + math.floor(cp / 0x40), 0x80 + (cp % 0x40))
    elseif cp < 0x10000 then
        return string.char(0xE0 + math.floor(cp / 0x1000), 0x80 + (math.floor(cp / 0x40) % 0x40), 0x80 + (cp % 0x40))
    else
        return string.char(0xF0 + math.floor(cp / 0x40000), 0x80 + (math.floor(cp / 0x1000) % 0x40), 0x80 + (math.floor(cp / 0x40) % 0x40), 0x80 + (cp % 0x40))
    end
"""

// One native code unit (a byte on luajit, a UTF-16 unit on JS) at `index`, or
// 0 if out of bounds. NOT named `byte`: the 0-255 range that implies is a
// false cross-backend promise -- an index is opaque, feed it back to a string
// primitive, do not do arithmetic on the value across backends. Real
// characters come from `chars()`.
@intrinsic inline(lua) fn string.unit_at(s, index: int) -> int = """
    return string.byte(s, index + 1) or 0  -- Convert to 1-based, return 0 if out of bounds
"""

@inline inline(lua) fn string.repeat(s, count: int) -> string = "string.rep(s, count)"
@inline inline(js) fn string.repeat(s, count: int) -> string = "return s.repeat(count);"

// StringBuilder: append-and-join accumulator. Naive `+` concat in a loop is
// O(n^2) even on luajit (immutable interned strings), so join/split/format
// results build through this (Lua: table + table.concat).
struct StringBuilder {}
@intrinsic inline(lua) fn sb_new() -> StringBuilder = "return {}"
@intrinsic inline(lua) fn sb_push(sb: StringBuilder, s: string) = "sb[#sb + 1] = s"
@intrinsic inline(lua) fn sb_build(sb: StringBuilder) -> string = "return table.concat(sb)"

fn lt(a: string, b: string) -> bool { return le(a, b) && a != b }
inline(lua) fn le(a: string, b: string) -> bool = "return a <= b"

// __rock_fmt_pad/grouping/binary/percent (the string-interpolation format
// helpers the codegen calls by name) live in stdlib/strings.rock.

// Left-align `s` in a field of `width` chars by appending spaces. Returns
// `s` unchanged when `#s >= width` (never truncates).
inline(lua) fn string.pad_right(s, width: int) -> string = """
    local len = #s
    if len >= width then return s end
    return s .. string.rep(" ", width - len)
"""

// Right-align `s` in a field of `width` chars by prepending spaces. Returns
// `s` unchanged when `#s >= width` (never truncates).
inline(lua) fn string.pad_left(s, width: int) -> string = """
    local len = #s
    if len >= width then return s end
    return string.rep(" ", width - len) .. s
"""

// Format a float as a string with exactly `decimals` fractional digits,
// right-aligned in a field of `width` chars (use 0 to skip padding).
// Wraps `string.format("%<width>.<decimals>f", v)`.
inline(lua) fn format_float(v: float, width: int, decimals: int) -> string = """
    return string.format("%" .. tostring(width) .. "." .. tostring(decimals) .. "f", v)
"""

// Pattern-based string matching (Lua patterns, not regex)
@inline inline(lua) fn string_match(s: string, pattern: string) -> string? = "string.match(s, pattern)"
// JS: first capture (or whole match) via the shared Lua-pattern translator.
inline(js) fn string_match(s: string, pattern: string) -> string? = """
    var m = s.match(new RegExp(__lua_pattern_to_regex(pattern)));
    if (!m) return null;
    return m.length > 1 ? m[1] : m[0];
"""

// Lazy iterator over all matches of pattern in s — works directly in for-loops
@inline inline(lua) fn string.gmatch(s, pattern: string) -> fn() -> string? = "string.gmatch(s, pattern)"

// Pattern-based replacement (use replace for literal replacement)
inline(lua) fn string.gsub(s, pattern: string, replacement: string) -> string = """
    return (string.gsub(s, pattern, replacement))
"""

// JS: a minimal Lua-pattern subset translated to a JS regex (classes %w %d
// %s %a, their uppercase negations, [...] sets, captures, anchors, + * - ?).
// Anything outside the subset THROWS naming the pattern -- loud gap, never a
// silent wrong result. `-` (lazy) maps to `*?`; %-escaped magic chars unescape.
@nomangle inline(js) fn __lua_pattern_to_regex(pattern: string) -> string = """
    var out = "";
    var i = 0;
    while (i < pattern.length) {
        var c = pattern[i];
        if (c === "%") {
            var n = pattern[i + 1];
            if (n === "w") out += "[A-Za-z0-9]";
            else if (n === "W") out += "[^A-Za-z0-9]";
            else if (n === "d") out += "[0-9]";
            else if (n === "D") out += "[^0-9]";
            else if (n === "s") out += "[ \\t\\n\\r]";
            else if (n === "S") out += "[^ \\t\\n\\r]";
            else if (n === "a") out += "[A-Za-z]";
            else if (n === "A") out += "[^A-Za-z]";
            else if ("^$()%.[]*+-?".indexOf(n) >= 0) out += "\\" + n;
            else throw new Error("lua pattern (js): unsupported escape %" + n + " in: " + pattern);
            i += 2;
        } else if (c === "[") {
            var j = i + 1;
            var cls = "[";
            if (pattern[j] === "^") { cls += "^"; j++; }
            while (j < pattern.length && pattern[j] !== "]") {
                if (pattern[j] === "%") {
                    var m = pattern[j + 1];
                    if (m === "w") cls += "A-Za-z0-9";
                    else if (m === "d") cls += "0-9";
                    else if (m === "s") cls += " \\t\\n\\r";
                    else if (m === "a") cls += "A-Za-z";
                    else cls += "\\" + m;
                    j += 2;
                } else {
                    var ch = pattern[j];
                    cls += ("\\^$.|?*+()[]{}".indexOf(ch) >= 0 ? "\\" + ch : ch);
                    j++;
                }
            }
            if (pattern[j] !== "]") throw new Error("lua pattern (js): unterminated [] set in: " + pattern);
            out += cls + "]";
            i = j + 1;
        } else if (c === "-") {
            out += "*?";
            i++;
        } else if ("\\|{}".indexOf(c) >= 0) {
            out += "\\" + c;
            i++;
        } else if (c === "." ) {
            out += "[^]";
            i++;
        } else {
            out += c;
            i++;
        }
    }
    return out;
"""

inline(js) fn string.gsub(s, pattern: string, replacement: string) -> string = """
    var rx = new RegExp(__lua_pattern_to_regex(pattern), "g");
    var rep = replacement.replace(/%([0-9%%])/g, function (_, d) { return d === "%" ? "%" : "$" + d; });
    return s.replace(rx, rep);
"""

// `join` (portable, over StringBuilder) lives in stdlib/strings.rock.

// Split a string into lines
fn string.lines(s) -> [string] {
    return s.split("\n")
}

// Parse a decimal integer from a string. Returns null if the string is not a valid integer.
fn string.parse_int(s) -> int? {
    let f = s.parse_float()
    if f == null { return null }
    return int(floor(f.unwrap()))
}

// Parse a float from a string. Returns null if the string is not a valid number.
@inline inline(lua) fn string.parse_float(s) -> float? = "tonumber(s)"

// Read an environment variable by name. Returns null if the variable is not set.
@inline inline(lua) fn env_var(name: string) -> string? = "os.getenv(name)"

// Read an env var as int. Returns `default_val` if unset or unparseable.
fn get_env_int(var: string, default_val: int) -> int {
    let v = env_var(var)
    if v == null { return default_val }
    return v.unwrap().parse_int() ?? default_val
}

// Read an env var as float. Returns `default_val` if unset or unparseable.
fn get_env_float(var: string, default_val: float) -> float {
    let v = env_var(var)
    if v == null { return default_val }
    return v.unwrap().parse_float() ?? default_val
}

// TODO: format_lua is an escape hatch for printf-style formatting.
// When Rock's string interpolation supports all common format specifiers
// (including %q for Lua-style quoting), this should be removed.
@inline inline(lua) fn format_lua(fmt: string, arg: any) -> string = "string.format(fmt, arg)"

// `match` is a Rock keyword, can't define `fn match` for string —
// callers use `string_match(s, p)` directly.

// Structure to hold function call info with stage
struct FunctionCallInfo {
    name: string,
    stage: int,
}
