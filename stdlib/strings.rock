// String offsets and lengths count native units (bytes on luajit).

fn string.split(s, delimiter: string) -> [string] {
    let dl = delimiter.len()
    if dl == 0 { error("split: empty delimiter") }
    let result: [string] = []
    let n = s.len()
    let start = 0
    while true {
        let idx = s.find(delimiter, start)
        if idx < 0 {
            result.push(s.substring(start, n))
            break
        }
        result.push(s.substring(start, idx))
        start = idx + dl
    }
    return result
}

fn string.replace(s, old: string, new: string) -> string {
    let ol = old.len()
    if ol == 0 { error("replace: empty needle") }
    let sb = sb_new()
    let n = s.len()
    let start = 0
    while true {
        let idx = s.find(old, start)
        if idx < 0 {
            sb_push(sb, s.substring(start, n))
            break
        }
        sb_push(sb, s.substring(start, idx))
        sb_push(sb, new)
        start = idx + ol
    }
    return sb_build(sb)
}

fn string.contains(s, substr: string) -> bool {
    return s.find(substr) >= 0
}

fn string.starts_with(s, prefix: string) -> bool {
    return s.substring(0, prefix.len()) == prefix
}

fn string.ends_with(s, suffix: string) -> bool {
    let sl = s.len()
    let fl = suffix.len()
    if fl > sl { return false }
    return s.substring(sl - fl, sl) == suffix
}

@pure fn is_ascii_ws(u: int) -> bool {
    return u == 32 || u == 9 || u == 10 || u == 13 || u == 12 || u == 11
}

fn string.trim(s) -> string {
    let n = s.len()
    let start = 0
    while start < n && is_ascii_ws(s.unit_at(start)) { start = start + 1 }
    let end = n
    while end > start && is_ascii_ws(s.unit_at(end - 1)) { end = end - 1 }
    return s.substring(start, end)
}

@intrinsic inline(lua) fn join(parts: [string], separator: string) -> string = """
    return table.concat(parts, separator, 1, parts[0])
"""

@consume struct CharsIter {
    s: string,
    i: int,
    n: int,
}

fn string.chars(s) -> CharsIter {
    return CharsIter { s: s, i: 0, n: s.len() }
}

fn CharsIter.next(it) -> (bool, int) {
    if it.i >= it.n { return (false, 0) }
    let b0 = it.s.unit_at(it.i)
    if b0 < 0x80 {
        it.i = it.i + 1
        return (true, b0)
    }
    let cp = __char_decode(it.s, it.i, b0)
    it.i = it.i + __char_units(b0, cp)
    return (true, cp)
}

fn __char_decode(s: string, i: int, b0: int) -> int {
    if b0 < 0xE0 {
        let b1 = s.unit_at(i + 1)
        return (b0 - 0xC0) * 0x40 + (b1 - 0x80)
    } else if b0 < 0xF0 {
        let b1 = s.unit_at(i + 1)
        let b2 = s.unit_at(i + 2)
        return (b0 - 0xE0) * 0x1000 + (b1 - 0x80) * 0x40 + (b2 - 0x80)
    }
    let b1 = s.unit_at(i + 1)
    let b2 = s.unit_at(i + 2)
    let b3 = s.unit_at(i + 3)
    return (b0 - 0xF0) * 0x40000 + (b1 - 0x80) * 0x1000 + (b2 - 0x80) * 0x40 + (b3 - 0x80)
}

fn __char_units(b0: int, cp: int) -> int {
    if b0 < 0xE0 { return 2 }
    if b0 < 0xF0 { return 3 }
    return 4
}

// ---------------------------------------------------------------------------
// String-interpolation format helpers. Called by generated code by name, so
// they keep @nomangle.
// ---------------------------------------------------------------------------

@nomangle
@intrinsic fn __rock_fmt_pad(s: string, width: int, align: string, fill: string) -> string {
    let text = tostring(s)
    let n = text.len()
    if n >= width { return text }
    let pad = width - n
    if align == "<" { return text + fill.repeat(pad) }
    if align == "^" {
        let left = pad ./ 2
        return fill.repeat(left) + text + fill.repeat(pad - left)
    }
    return fill.repeat(pad) + text
}

@nomangle
@intrinsic inline(lua) fn __rock_fmt_grouping(s: string, sep: string, group: int) -> string = """
    local sign, num, frac = s:match("^([%+%-]?)(%w+)(%.?.*)$")
    if not num then return s end
    local pattern = "(" .. string.rep(".", group) .. ")"
    local reversed = num:reverse():gsub(pattern, "%1" .. sep)
    if reversed:sub(-#sep) == sep then
        reversed = reversed:sub(1, -#sep - 1)
    end
    return sign .. reversed:reverse() .. frac
"""

@nomangle
@intrinsic inline(lua) fn __rock_fmt_binary(n: int) -> string = """
    local __n = math.floor(n)
    if __n == 0 then return "0" end
    local __neg = __n < 0
    if __neg then __n = -__n end
    local __s = ""
    while __n > 0 do __s = (__n % 2) .. __s; __n = math.floor(__n / 2) end
    return (__neg and "-" or "") .. __s
"""

@nomangle
@intrinsic inline(lua) fn __rock_fmt_percent(v: float, p: int) -> string = """
    local __p = p
    if __p < 0 then __p = 6 end
    local scaled = v * 100
    if scaled < 1e-100 and scaled > -1e-100 then scaled = scaled * 0 end
    return string.format("%." .. __p .. "f", scaled) .. "%"
"""
