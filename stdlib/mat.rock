// Mat4: 4x4 matrix, stored as 4 Vec4 columns (column-major double[16] in memory;
// the GL upload packs it to float[16], no transpose). Element (row i,
// col j) is c{j}[i].

value Mat4 {
    c0: Vec4,
    c1: Vec4,
    c2: Vec4,
    c3: Vec4,
}

@pure fn mat4_identity() -> Mat4 {
    return Mat4 {
        c0: v(1.0, 0.0, 0.0, 0.0),
        c1: v(0.0, 1.0, 0.0, 0.0),
        c2: v(0.0, 0.0, 1.0, 0.0),
        c3: v(0.0, 0.0, 0.0, 1.0),
    }
}

// Apply a matrix to a column vector: A * v = c0*v.x + c1*v.y + c2*v.z + c3*v.w.
@pure operator *(a: Mat4, v: Vec4) -> Vec4 {
    return a.c0 * v.x + a.c1 * v.y + a.c2 * v.z + a.c3 * v.w
}

// Column-major compose: (A*B).col[j] = A * B.col[j].
@pure operator *(a: Mat4, b: Mat4) -> Mat4 {
    return Mat4 {
        c0: a * b.c0,
        c1: a * b.c1,
        c2: a * b.c2,
        c3: a * b.c3,
    }
}

@pure fn mat4_translate(t: Vec3) -> Mat4 {
    return Mat4 {
        c0: v(1.0, 0.0, 0.0, 0.0),
        c1: v(0.0, 1.0, 0.0, 0.0),
        c2: v(0.0, 0.0, 1.0, 0.0),
        c3: v(t.x, t.y, t.z, 1.0),
    }
}

@pure fn mat4_scale(s: Vec3) -> Mat4 {
    return Mat4 {
        c0: v(s.x, 0.0, 0.0, 0.0),
        c1: v(0.0, s.y, 0.0, 0.0),
        c2: v(0.0, 0.0, s.z, 0.0),
        c3: v(0.0, 0.0, 0.0, 1.0),
    }
}

@pure fn mat4_rotate_x(angle: float) -> Mat4 {
    let c = angle.cos()
    let s = angle.sin()
    return Mat4 {
        c0: v(1.0, 0.0, 0.0, 0.0),
        c1: v(0.0, c, s, 0.0),
        c2: v(0.0, -s, c, 0.0),
        c3: v(0.0, 0.0, 0.0, 1.0),
    }
}

@pure fn mat4_rotate_y(angle: float) -> Mat4 {
    let c = angle.cos()
    let s = angle.sin()
    return Mat4 {
        c0: v(c, 0.0, -s, 0.0),
        c1: v(0.0, 1.0, 0.0, 0.0),
        c2: v(s, 0.0, c, 0.0),
        c3: v(0.0, 0.0, 0.0, 1.0),
    }
}

@pure fn mat4_rotate_z(angle: float) -> Mat4 {
    let c = angle.cos()
    let s = angle.sin()
    return Mat4 {
        c0: v(c, s, 0.0, 0.0),
        c1: v(-s, c, 0.0, 0.0),
        c2: v(0.0, 0.0, 1.0, 0.0),
        c3: v(0.0, 0.0, 0.0, 1.0),
    }
}

// GL orthographic projection (maps [l,r]x[b,t]x[n,f] to the [-1,1] cube).
@pure fn mat4_ortho(left: float, right: float, bottom: float, top: float, near: float, far: float) -> Mat4 {
    let rl = right - left
    let tb = top - bottom
    let fn_ = far - near
    return Mat4 {
        c0: v(2.0 / rl, 0.0, 0.0, 0.0),
        c1: v(0.0, 2.0 / tb, 0.0, 0.0),
        c2: v(0.0, 0.0, -2.0 / fn_, 0.0),
        c3: v(-(right + left) / rl, -(top + bottom) / tb, -(far + near) / fn_, 1.0),
    }
}

// Affine point transform (w = 1: includes translation). No perspective divide
// -- every ctor here is affine so w stays 1.
@pure fn Mat4.transform_point(m, p: Vec3) -> Vec3 {
    let r = m * v(p.x, p.y, p.z, 1.0)
    return v(r.x, r.y, r.z)
}

// Direction transform (w = 0: ignores translation).
@pure fn Mat4.transform_vector(m, d: Vec3) -> Vec3 {
    let r = m * v(d.x, d.y, d.z, 0.0)
    return v(r.x, r.y, r.z)
}
