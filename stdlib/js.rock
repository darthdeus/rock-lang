    if (__json_record_js_failed(result)) throw new Error("invalid value for json record encoding");
    return result;
"""

inline(js) fn __json_record_decode<T>(name: string, codec: JsonRecordCodec, value: JsonValue,
    parse_raw: fn(string) -> JsonValue?) -> T? = """
    var context = __json_record_js_context(codec, __rock_json_types);
    context.parse_raw = parse_raw;
    return __json_record_js_decode(codec, context, name, value, null);
"""

inline(js) fn __json_record_lua_backend() -> bool = "return false;"
@nomangle inline(js) fn __json_record_adapters(codec: JsonRecordCodec) -> Map<string, JsonRecordAdapter>? = 'throw new Error("json record adapter caching is Lua-only");'
inline(js) fn __json_record_write<T>(name: string, codec: JsonRecordCodec, value: T, sink: __JsonRecordSink) -> string = 'throw new Error("json record text writing is Lua-only");'
inline(js) fn __json_record_read<T>(name: string, codec: JsonRecordCodec, src: string, at: int, source: __JsonRecordSource) -> T? = 'throw new Error("json record source decoding is Lua-only");'

