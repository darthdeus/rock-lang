// Separate JS bodies avoid shifting Lua source locations and remain available without a host.

@nowrite @inline inline(js) fn format_float_roundtrip(value: float) -> string = "return String(value);"

// UTF-16: a lone surrogate decodes to itself, one unit wide.
@inline inline(js) fn __char_decode(s: string, i: int, b0: int) -> int = "return s.codePointAt(i);"
@inline inline(js) fn __char_units(b0: int, cp: int) -> int = "return cp > 0xFFFF ? 2 : 1;"

// The luajit `__slot_alloc` in unified.rock is the contract; this is the same
// free list over a 0-based array.
@nomangle inline(js) fn __slot_alloc(m: any, hw: any) -> int = """
  var fi = m.free_indices;
  var s;
  if (fi.len > 0) {
    s = fi._data[fi.len - 1];
    fi._data[fi.len - 1] = null;
    fi.len = fi.len - 1;
  } else {
    s = hw.len;
    hw.len = s + 1;
  }
  m.occupied_count = m.occupied_count + 1;
  return s;
"""

@nomangle inline(js) fn __slot_release(m: any, slot: int) = """
  var fi = m.free_indices;
  fi._data[fi.len] = slot;
  fi.len = fi.len + 1;
  m.occupied_count = m.occupied_count - 1;
"""

@inline inline(js) fn field_get<T, V>(o: T, f: ReadFieldRef<T, V>) -> V = "return o[f];"

@inline inline(js) fn field_set<T, V>(o: T, f: WriteFieldRef<T, V>, v: V) = "o[f] = v;"

// luajit narrows through the ffi; a JS number is already the value.
@pure @inline inline(js) fn int(value: int) -> int = "return value;"

@intrinsic @inline inline(js) fn native_buffer_uint(n: int) -> NativeBuffer<uint> =
    "return {ptr: new Uint32Array(n), len: n};"

inline(js) fn ffi_string(ptr: any, len: int?) -> string = """
  return typeof ptr === "string" ? ptr : String(ptr);
"""

// A failed `unwrap()` or `expect()` reaches this, so a JS program without a
// host still gets a traceback.
@nowrite @intrinsic inline(js) fn __unwrap_failed(message: string) =
    "throw new Error(message + \"\\n\" + (new Error().stack || \"\"));"

// Rock expects Lua type names: capturing functions are tables, while
// capture-free functions are functions. NativeBuffer reports table on JS.
@nowrite @inline inline(js) fn typeof(x: any) -> string = """
  return (x === null || x === undefined) ? "nil"
    : typeof x === "object" ? "table"
    : typeof x;
"""

@nomangle inline(js) fn __rock_get_type(obj: any) -> string? = """
  if (obj === null || typeof obj !== "object") return null;
  return obj.__ty === undefined ? null : obj.__ty;
"""

@relocates @nomangle inline(js) fn __sort_map_keys<K>(keys: [K]) = """
  keys._data.sort(function(a, b) {
    var sa = lua_tostring(a), sb = lua_tostring(b);
    return sa < sb ? -1 : (sa > sb ? 1 : 0);
  });
"""

@intrinsic @inline inline(js) fn table_len(tbl: any) -> int = "return __table_len(tbl);"

// `len` rather than the array's length: a column reserved past `len` holds
// stale slots, and shifting those would carry them into the live range.
@nomangle inline(js) fn __rock_col_insert(col: any, lua_index: int, len: int, value: any) = """
  for (var i = len; i >= lua_index; i--) col[i] = col[i - 1];
  col[lua_index - 1] = value;
"""

@nomangle inline(js) fn __rock_col_copy(col: any, len: int) -> any = "return col.slice(0, len);"

@nomangle inline(js) fn __rock_stride_insert(
  data: any,
  lua_index: int,
  len: int,
  stride: int
) = """
  var start = (lua_index - 1) * stride;
  for (var i = len * stride - 1; i >= start; i--) data[i + stride] = data[i];
  for (var i = start; i < start + stride; i++) data[i] = false;
"""

@nomangle inline(js) fn __rock_stride_copy(data: any, len: int, stride: int) -> any =
  "return data.slice(0, len * stride);"

@nomangle inline(js) fn __rock_stride_sort(
  vec: any,
  key_fn: any,
  stride: int
) = """
  var n = vec.len || 0, data = vec._data, order = [];
  for (var i = 0; i < n; i++) order.push(i);
  function key_at(row) {
    return __rock_call(key_fn, __rock_materialize_strided_element(vec, row));
  }
  order.sort(function(a, b) {
    var ka = key_at(a), kb = key_at(b);
    return ka < kb ? -1 : (ka > kb ? 1 : 0);
  });
  var sorted = [];
  for (var row = 0; row < n; row++) {
    var source = order[row] * stride, target = row * stride;
    for (var j = 0; j < stride; j++) sorted[target + j] = data[source + j];
  }
  for (var i = 0; i < n * stride; i++) data[i] = sorted[i];
"""

@nomangle inline(js) fn __rock_stride_sort_leaves(vec: any, key_fn: any, stride: int) = """
  var n = vec.len || 0, data = vec._data, order = [];
  for (var i = 0; i < n; i++) order.push(i);
  function key_at(row) {
    var args = [key_fn], base = row * stride;
    for (var j = 0; j < stride; j++) args.push(data[base + j]);
    return __rock_call.apply(null, args);
  }
  order.sort(function(a, b) {
    var ka = key_at(a), kb = key_at(b);
    return ka < kb ? -1 : (ka > kb ? 1 : 0);
  });
  var sorted = [];
  for (var row = 0; row < n; row++) {
    var source = order[row] * stride, target = row * stride;
    for (var j = 0; j < stride; j++) sorted[target + j] = data[source + j];
  }
  for (var i = 0; i < n * stride; i++) data[i] = sorted[i];
"""

@nomangle inline(js) fn __rock_materialize_strided_element(vec: any, index: int) -> any = """
  var h = vec["@vec"], base = index * h.stride;
  var out = { __variant: vec._data[base], __ty: h.elem };
  for (var j = 1; j < h.stride; j++) {
    var value = vec._data[base + j];
    if (value !== false) out[j - 1] = value;
  }
  return out;
"""

@nomangle inline(js) fn __rock_is_column_vec(v: any) -> bool = """
  if (v === null || typeof v !== "object" || v.__ty !== "Vec") return false;
  var h = v["@vec"];
  return h !== null && typeof h === "object" && h.repr === "columns";
"""

@nomangle inline(js) fn __rock_col_paths(vec: any) -> any = """
  var names = [];
  for (var k in vec) {
    if (Object.prototype.hasOwnProperty.call(vec, k) &&
        k !== "len" && k !== "__ty" && k !== "@vec" && Array.isArray(vec[k])) {
      names.push(k);
    }
  }
  names.sort();
  return names;
"""

@nomangle inline(js) fn __rock_materialize_column_element(vec: any, index: int) -> any = """
  var h = vec["@vec"];
  if (h === null || typeof h !== "object" || h.repr !== "columns") {
    throw new Error("expected column Vec");
  }
  var mat = __rock_col_mat[h.elem];
  if (mat === undefined) {
    throw new Error("no column materializer emitted for element type " + h.elem);
  }
  return mat(vec, index);
"""

@nomangle inline(js) fn __rock_vec_column_elements(vec: any) -> any = """
  var out = [];
  for (var i = 0; i < (vec.len || 0); i++) out.push(__rock_materialize_column_element(vec, i));
  return out;
"""

@nomangle inline(js) fn __rock_col_sort(vec: any, key_fn: any) = """
  var n = vec.len || 0;
  var order = [], elements = [];
  for (var i = 0; i < n; i++) {
    order.push(i);
    elements.push(__rock_materialize_column_element(vec, i));
  }
  order.sort(function(a, b) {
    var ka = __rock_call(key_fn, elements[a]), kb = __rock_call(key_fn, elements[b]);
    return ka < kb ? -1 : (ka > kb ? 1 : 0);
  });
  var paths = __rock_col_paths(vec);
  for (var p = 0; p < paths.length; p++) {
    var col = vec[paths[p]], tmp = [];
    for (var i = 0; i < n; i++) tmp.push(col[order[i]]);
    for (var i = 0; i < n; i++) col[i] = tmp[i];
  }
"""

@nowrite @nomangle inline(js) fn __nb_checked_index(buf: any, i: int) -> int = """
  if (i < 0 || i >= buf.len) {
    throw new Error("NativeBuffer index out of bounds: index " + i +
                    " is outside [0, " + buf.len + ")");
  }
  return i;
"""

@nomangle inline(js) fn __rock_is_fn_record(v: any) -> bool = """
  return typeof __rock_code_ref_kind === "function" && __rock_code_ref_kind(v) !== null;
"""

@nomangle inline(js) fn __nb_refresh_views(buf: any) = """
  for (var k in buf) {
    if (Object.prototype.hasOwnProperty.call(buf, k) && k !== "ptr" &&
        ArrayBuffer.isView(buf[k])) {
      buf[k] = new buf[k].constructor(buf.ptr.buffer, buf.ptr.byteOffset);
    }
  }
"""

@nomangle inline(js) fn __descriptor_with(d: any, field: string, v: any) -> any = """
  var out = Object.assign(Object.create(Object.getPrototypeOf(d)), d);
  out[field] = v;
  if (field === "ptr") {
    for (var k in out) {
      if (Object.prototype.hasOwnProperty.call(out, k) && k !== "ptr" &&
          ArrayBuffer.isView(out[k])) {
        out[k] = new out[k].constructor(v.buffer, v.byteOffset);
      }
    }
  }
  return out;
"""

// Applies the key per comparison, as luajit does: a key fn with effects must
// observe the same calls on both backends.
@nomangle inline(js) fn __rock_col_sort_leaves(vec: any, key_fn: any, paths: any) = """
  var n = vec.len || 0;
  var width = paths.length;
  var cols = [];
  for (var j = 0; j < width; j++) cols.push(vec[paths[j]]);
  var order = [];
  for (var i = 0; i < n; i++) order.push(i);
  function key_at(i) {
    var args = [key_fn];
    for (var j = 0; j < width; j++) args.push(cols[j][i]);
    return __rock_call.apply(null, args);
  }
  order.sort(function(a, b) {
    var ka = key_at(a), kb = key_at(b);
    return ka < kb ? -1 : (ka > kb ? 1 : 0);
  });
  for (var j = 0; j < width; j++) {
    var col = cols[j], tmp = [];
    for (var i = 0; i < n; i++) tmp.push(col[order[i]]);
    for (var i = 0; i < n; i++) col[i] = tmp[i];
  }
"""

// A native Map, not a plain object: spine keys are data, and an object would
// coerce `1` and "1" together and inherit Object.prototype names. Vec `_data`
// is 0-based here, so free-list push/pop run in the opposite order to luajit.
@nomangle inline(js) fn __map_col_new_spine() -> any = """
  return new Map();
"""

@returns_nonneg @returns_index_below("m.data") @nomangle inline(js) fn __map_col_slot(m: any, key: any) -> int = """
  var s = m.spine.get(key);
  if (s !== undefined) return s;
  var fi = m.free_indices;
  if (fi.len > 0) {
    fi.len = fi.len - 1;
    s = fi._data[fi.len];
    fi._data[fi.len] = undefined;
  } else {
    s = m.data.len;
    m.data.len = m.data.len + 1;
  }
  m.spine.set(key, s);
  m.occupied_count = m.occupied_count + 1;
  return s;
"""

@returns_index_below("m.data") @nomangle inline(js) fn __map_col_slot_of(m: any, key: any) -> int = """
  var s = m.spine.get(key);
  return s === undefined ? -1 : s;
"""

@returns_nonneg @returns_index_below("m.data") @nomangle inline(js) fn __map_col_slot_checked(m: any, key: any) -> int = """
  var s = m.spine.get(key);
  if (s === undefined) throw new Error("Map key not found");
  return s;
"""

@nomangle inline(js) fn __map_col_free(m: any, key: any) -> int = """
  var s = m.spine.get(key);
  if (s === undefined) return -1;
  m.spine.delete(key);
  var fi = m.free_indices;
  fi._data[fi.len] = s;
  fi.len = fi.len + 1;
  m.occupied_count = m.occupied_count - 1;
  return s;
"""

@nomangle inline(js) fn __map_col_len(m: any) -> int = """
  return m.occupied_count;
"""

@nomangle inline(js) fn __map_col_contains(m: any, key: any) -> bool = """
  return m.spine.has(key);
"""

@nomangle inline(js) fn __map_col_clear(m: any) = """
  var fi = m.free_indices;
  var it = m.spine.values();
  for (var r = it.next(); !r.done; r = it.next()) {
    fi._data[fi.len] = r.value;
    fi.len = fi.len + 1;
  }
  m.spine.clear();
  m.occupied_count = 0;
"""

@nomangle inline(js) fn __weak_cache_retire(scene: int, arena: int, slot: int) = """
    var owners = typeof __rock_weak_cache_owners === "undefined" ? null : __rock_weak_cache_owners;
    var scenes = owners && owners[scene];
    if (!scenes) return;
    if (arena === -1) {
        delete owners[scene];
    } else {
        var slots = scenes[arena];
        if (!slots) return;
        if (slot === -1) delete scenes[arena];
        else {
            delete slots[slot];
            if (Object.keys(slots).length === 0) delete scenes[arena];
        }
        if (Object.keys(scenes).length === 0) delete owners[scene];
    }
"""

// JS object keys are strings, so Scene-level names take an "n:" prefix to
// stay apart from numeric Arena ids.
@nomangle inline(js) fn __weak_cache_write(name: string, scene: int, arena: int, slot: int, generation: int, backing: any, value: any) = """
    var owners = globalThis.__rock_weak_cache_owners || (globalThis.__rock_weak_cache_owners = {});
    var scenes = owners[scene] || (owners[scene] = {});
    var entries = scenes, key = "n:" + name;
    if (arena !== -1) {
        var slots = scenes[arena] || (scenes[arena] = {});
        entries = slots[slot] || (slots[slot] = {});
        key = name;
    }
    entries[key] = { generation: generation, backing: backing, value: value };
    var counts = globalThis.__rock_weak_cache_builds || (globalThis.__rock_weak_cache_builds = {});
    counts[name] = (counts[name] || 0) + 1;
"""

@nomangle inline(js) fn __weak_cache_delete(name: string, scene: int, arena: int, slot: int, generation: int) = """
    var owners = globalThis.__rock_weak_cache_owners;
    var scenes = owners && owners[scene];
    if (!scenes) return;
    var slots = scenes[arena];
    var entries = arena === -1 ? scenes : (slots && slots[slot]);
    var key = arena === -1 ? "n:" + name : name;
    var entry = entries && entries[key];
    if (entry && entry.generation === generation) {
        delete entries[key];
        if (arena !== -1 && Object.keys(entries).length === 0) {
            delete slots[slot];
            if (Object.keys(slots).length === 0) delete scenes[arena];
        }
        if (Object.keys(scenes).length === 0) delete owners[scene];
    }
"""

inline(js) fn __weak_cache_entity_get<V>(name: string, scene: int, arena: int, slot: int, generation: int) -> V? = """
    var backing = __arena_store_any(scene, arena);
    if (backing == null || backing.generations._data[slot] !== generation) return null;
    var owners = globalThis.__rock_weak_cache_owners;
    var scenes = owners && owners[scene];
    var slots = scenes && scenes[arena];
    var entries = slots && slots[slot];
    var entry = entries && entries[name];
    if (entry && entry.generation === generation && entry.backing === backing) return entry.value;
    return null;
"""

inline(js) fn __weak_cache_entity_put<V>(name: string, scene: int, arena: int, slot: int, generation: int, value: V) = """
    var backing = __arena_store_any(scene, arena);
    if (backing == null || backing.generations._data[slot] !== generation) {
        throw new Error("weak_cache_put requires a live owner");
    }
    __weak_cache_write(name, scene, arena, slot, generation, backing, value);
"""

inline(js) fn __weak_cache_scene_get<T, V>(name: string, scene: int, backing: T) -> V? = """
    var owners = globalThis.__rock_weak_cache_owners;
    var scenes = owners && owners[scene];
    var entry = scenes && scenes["n:" + name];
    if (entry && entry.backing === backing) return entry.value;
    return null;
"""

inline(js) fn __weak_cache_scene_put<V>(name: string, scene: int, value: V) = """
    var backing = __scene_root_any(scene);
    if (backing == null) throw new Error("weak_cache_put requires a live owner");
    __weak_cache_write(name, scene, -1, -1, 0, backing, value);
"""

inline(js) fn weak_cache_builds(name: string) -> int = """
    var counts = globalThis.__rock_weak_cache_builds;
    return (counts && counts[name]) || 0;
"""

inline(js) fn weak_cache_live(name: string) -> int = """
    var owners = globalThis.__rock_weak_cache_owners || {};
    var records = globalThis.__rock_record_cache_live;
    var n = (records && records[name]) || 0;
    for (var s in owners) {
        var scenes = owners[s];
        if (scenes["n:" + name]) n++;
        for (var a in scenes) {
            if (a.startsWith("n:")) continue;
            var slots = scenes[a];
            for (var k in slots) if (slots[k][name]) n++;
        }
    }
    return n;
"""

// A WeakMap cannot be enumerated, so live entries are counted on store and
// evict; an entry the collector reclaims with its owner is not subtracted.
inline(js) fn weak_cache_get<V>(name: string, owner: CacheOwner) -> V? = """
    if (owner.retired) return null;
    var owners = globalThis.__rock_record_caches;
    var entries = owners && owners.get(owner);
    return entries && entries.has(name) ? entries.get(name) : null;
"""

inline(js) fn weak_cache_put<V>(name: string, owner: CacheOwner, value: V) = """
    if (owner.retired) throw new Error("weak_cache_put requires a live owner");
    var owners = globalThis.__rock_record_caches || (globalThis.__rock_record_caches = new WeakMap());
    var entries = owners.get(owner);
    if (!entries) { entries = new Map(); owners.set(owner, entries); }
    if (!entries.has(name)) {
        var live = globalThis.__rock_record_cache_live || (globalThis.__rock_record_cache_live = {});
        live[name] = (live[name] || 0) + 1;
    }
    entries.set(name, value);
    var counts = globalThis.__rock_weak_cache_builds || (globalThis.__rock_weak_cache_builds = {});
    counts[name] = (counts[name] || 0) + 1;
"""

inline(js) fn weak_cache_drop(name: string, owner: CacheOwner) = """
    var owners = globalThis.__rock_record_caches;
    var entries = owners && owners.get(owner);
    if (entries && entries.has(name)) {
        entries.delete(name);
        globalThis.__rock_record_cache_live[name]--;
        if (entries.size === 0) owners.delete(owner);
    }
"""

inline(js) fn cache_owner_retire(owner: CacheOwner) -> bool = """
    if (owner.retired) return false;
    owner.retired = true;
    var owners = globalThis.__rock_record_caches;
    var entries = owners && owners.get(owner);
    if (entries) {
        var live = globalThis.__rock_record_cache_live;
        entries.forEach(function(_, name) { live[name]--; });
        owners.delete(owner);
    }
    return true;
"""

// Decoded records must carry every constructor key because __op_eq compares key sets.
// A failed decode returns a { __json_record_js_error: error } box.

@nomangle inline(js) fn __json_record_js_node(tag: string, item: any) -> any = """
    if (tag === "Null") return { __variant: "Null", __ty: "JsonValue" };
    return { __variant: tag, __ty: "JsonValue", 0: item };
"""

@nomangle inline(js) fn __json_record_js_tag(value: any, tag: string) -> bool = """
    return value !== null && typeof value === "object" && value.__variant === tag;
"""

@nomangle inline(js) fn __json_record_js_failure(shape: any, value: any) -> any = """
    var actual;
    if (value === null || value === undefined) actual = "missing";
    else if (typeof value === "object") actual = value.__variant !== undefined ? value.__variant : "table";
    else actual = typeof value;
    if ((actual === "True" || actual === "False") && value.__ty === "JsonValue") actual = "Bool";
    return { __json_record_js_error: { __ty: "JsonRecordError", path: "",
        expected: shape.name !== undefined ? shape.name : shape.k, actual: actual } };
"""

@nomangle inline(js) fn __json_record_js_failed(result: any) -> bool = """
    return result !== null && typeof result === "object" && result.__json_record_js_error !== undefined;
"""

@nomangle inline(js) fn __json_record_js_error_at(failure: any, key: any) -> any = """
    var error = failure.__json_record_js_error;
    error.path = "/" + String(key).replace(/~/g, "~0").replace(/\//g, "~1") + error.path;
    return failure;
"""

@nomangle inline(js) fn __json_record_js_native_get(source: any, name: string, prefix: string) -> any = """
    var fields = __rock_json_types.types[name].fields;
    var result = { __ty: name };
    for (var i = 0; i < fields.length; i++) {
        var field = fields[i], path = prefix + field.name;
        var child = __rock_json_types.types[field.type];
        result[field.name] = child !== undefined && child.kind === "c_struct"
            ? __json_record_js_native_get(source, field.type, path + ".") : source[path];
    }
    return result;
"""

@nomangle inline(js) fn __json_record_js_native_put(target: any, value: any, name: string, prefix: string) = """
    var fields = __rock_json_types.types[name].fields;
    for (var i = 0; i < fields.length; i++) {
        var field = fields[i], path = prefix + field.name;
        var item = value === null ? null : value[field.name];
        var child = __rock_json_types.types[field.type];
        if (child !== undefined && child.kind === "c_struct") {
            __json_record_js_native_put(target, item === undefined ? null : item, field.type, path + ".");
        } else target[path] = item;
    }
"""

@nomangle inline(js) fn __json_record_js_table_put(target: any, value: any, name: string, prefix: string) = """
    if (value !== null) {
        for (var key in value) {
            if (Object.prototype.hasOwnProperty.call(value, key) && key !== "__ty") target[prefix + key] = value[key];
        }
        return;
    }
    var fields = __rock_json_types.types[name].fields;
    for (var i = 0; i < fields.length; i++) {
        var field = fields[i];
        if (field.flat) {
            for (var j = 0; j < field.flat.length; j++) target[prefix + field.flat[j]] = null;
        } else if (field.embed) {
            __json_record_js_field_put(target, { name: prefix + field.name, type: field.type,
                nullable: field.nullable, embed: true }, null);
        } else target[prefix + field.name] = null;
    }
"""

@nomangle inline(js) fn __json_record_js_field_get(source: any, field: any) -> any = """
    var key = field.name;
    if (field.flat) {
        var tag = source[field.flat[0]];
        if (tag === null || tag === undefined) return null;
        var value = { __variant: tag, __ty: field.type };
        var layout = __rock_json_types.flat[field.type];
        for (var i = 1; i < field.flat.length; i++) {
            var item = source[field.flat[i]];
            if (item !== null && item !== undefined) {
                value[i > layout.tuple_width ? layout.record_fields[i - 1 - layout.tuple_width] : i - 1] = item;
            }
        }
        return value;
    }
    if (!field.embed) return source[key] === undefined ? null : source[key];
    if (field.nullable && !source[key]) return null;
    if (__rock_json_types.types[field.type].kind === "c_struct") {
        return __json_record_js_native_get(source, field.type, key + ".");
    }
