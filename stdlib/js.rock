// JS-backend bodies for stdlib functions whose luajit body lives in another
// stdlib file.
//
// They are HERE rather than beside their luajit sibling because an `inline(js)`
// fn added to a lua-emitting file pushes every `__SITE__` below it down a line,
// and `__SITE__` is "file:line" -- so co-locating one breaks Lua byte-identity
// for every log site under it. A whole new FILE shifts nothing.
//
// They are here rather than in `stone/engine/web/js_ffi.rock` -- where the first
// few of them lived -- because that file is the web ENGINE, staged only by
// `rock web`. A stdlib function whose JS body ships with stone has no binding in
// a JS program that does not use stone, which is every `--backend js` test.
// Engine-owned fns keep their siblings in `js_ffi.rock`; only stdlib-owned ones
// belong here.

// docs/field-refs-plan.md 1. A field ref IS the key on both backends, so both
// bodies are the same indexing operation spelled twice.
@inline inline(js) fn field_get<T, V>(o: T, f: ReadFieldRef<T, V>) -> V = "return o[f];"

@inline inline(js) fn field_set<T, V>(o: T, f: WriteFieldRef<T, V>, v: V) = "o[f] = v;"

// luajit narrows through the ffi; a JS number is already the value.
@pure @inline inline(js) fn int(value: int) -> int = "return value;"

// There is no FFI pointer on JS at all, so what luajit reconstructs from a
// `char*` is already a string here; `len` has nothing to bound.
inline(js) fn ffi_string(ptr: any, len: int?) -> string = """
  return typeof ptr === "string" ? ptr : String(ptr);
"""

// `unwrap()` on a null reaches this, so a JS program with no stone in it still
// needs a traceback.
@inline inline(js) fn __debug_traceback() -> string = "return new Error().stack || \"\";"

// Reports LUA type names, not JS ones -- the return value is compared against
// `"table"` / `"function"` in Rock source, so the names are the contract and JS
// is the thing being translated. An env record `{__fn, ..}` deliberately reports
// `table`, because that is what `type()` says about luajit's
// `setmetatable({__fn=..}, __rock_fn_mt)` -- only a CAPTURE-FREE lambda is a
// bare function on either backend. `cdata`/`userdata`/`thread` have no JS side,
// so a NativeBuffer `{ptr, len}` reports `table` where luajit says `cdata`.
@inline inline(js) fn typeof(x: any) -> string = """
  return (x === null || x === undefined) ? "nil"
    : typeof x === "object" ? "table"
    : typeof x;
"""

// The `__ty` string tag is the lone type marker on BOTH backends (structs,
// enums, Vec and coroutine handles all carry it), so this is the same field
// read spelled twice. `null` is `typeof "object"` in JS, hence the extra guard
// the Lua body does not need.
@nomangle inline(js) fn __rock_get_type(obj: any) -> string? = """
  if (obj === null || typeof obj !== "object") return null;
  return obj.__ty === undefined ? null : obj.__ty;
"""
