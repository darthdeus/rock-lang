// Scene<T>: one independently disposable state root inside the Session -- a
// dungeon room, loaded level, editor document, preview viewport. `Scene` and
// `SceneBuilder` are declared in unified.rock with the other early type decls.
//
// Design and the phase this implements: `docs/scene-system-plan.md` P2.
//
// Two facts shape everything below.
//
// Ownership is a Scene concern but LOOKUP is flat, exactly as it is for Arenas:
// `_scene_id` indexes the parallel registry columns directly. A Scene owns the
// LIST of Arena IDs it created, which is what teardown needs; nothing walks
// Session -> Scene -> Arena to resolve a row.
//
// Destruction is two steps. `scene_close` is a REQUEST: it hides the Scene from
// lookup at once and refuses a second request, but the rows stay live so nothing
// is pulled out from under an update or draw that is already holding them.
// `__scene_drain_closed` is the physical teardown, and the runner calls it at one
// end-of-frame safe point (`frame_core_end`) after every consumer has returned.

// The Session root, the owner ID every `arena_new()` Arena already carries. It
// is not a Scene and is never published; it exists here so the registry stays
// dense from index 0.
const __SCENE_RESERVED: int = 0
const __SCENE_BUILDING: int = 1
const __SCENE_LIVE: int = 2
const __SCENE_CLOSING: int = 3
const __SCENE_DEAD: int = 4
// Requested by `scene_discard`: queued exactly like Closing and equally
// invisible to lookup, and distinguished only so the drain knows to skip this
// incarnation's teardown actions.
const __SCENE_DISCARDING: int = 5

// The Session Scene registry: authoritative columns indexed by Scene ID. The
// compiler records this nominal root in StateSchema so WorldImage can copy it
// with the ordinary Session graph.
struct SceneRegistry {
    roots: [any?],
    states: [int],
    arena_ids: [[int]],
    next_id: int,
    closers: [[() -> ()]],
    pending_close: [int],
    root_type_key: [string],
    root_type_bucket: [int],
    type_keys: [string],
    type_buckets: [[int]],
    type_bucket_pos: [int],
    type_bucket_lookup: Map<string, int>,
    phase_bucket_lengths: [int],
}

@state(ownership=session, world=include, realization=fresh_session)
global __SCENE_REGISTRY: SceneRegistry = SceneRegistry {
    roots: [], states: [], arena_ids: [], next_id: 0, closers: [],
    pending_close: [], root_type_key: [], root_type_bucket: [],
    type_keys: [], type_buckets: [], type_bucket_pos: [],
    type_bucket_lookup: map_new(), phase_bucket_lengths: [],
}

@scene_type_key
inline(lua) fn __rock_scene_type_key<T>() -> string = """
    error("__rock_scene_type_key must be compiler-expanded")
"""

fn __scene_state(scene_id: int) -> int {
    let st = __SCENE_REGISTRY.states.get(scene_id)
    if is_null(st) { return __SCENE_DEAD }
    return st.unwrap()
}

// THE physical resolution oracle: non-generic, so the element type is recovered
// by the typed wrapper below rather than inferred at the call site. A Building,
// Closing or dead Scene answers null -- close takes effect for lookup
// immediately, whatever the drain has done yet.
//
// `@nomangle`: called directly by name from compiler-synthesized Scene
// lifecycle thunks (`crates/skull/src/mir_emit.rs`, `crates/skull-codegen-js/src/emit.rs`).
@nomangle
fn __scene_root_any(scene_id: int) -> any? {
    if __scene_state(scene_id) != __SCENE_LIVE { return null }
    let slot = __SCENE_REGISTRY.roots.get(scene_id)
    if is_null(slot) { return null }
    return slot.unwrap()
}

// A Scene root is an identity, and identities never coerce to ordinary `any`;
// this is the registry's only erasure (`@identity_erasure`,
// docs/identity-storage-plan.md S0d). `Scene.get`'s `cast` recovers the type.
@identity_erasure @inline
fn __scene_root_erased<T>(root: T) -> any { return root }

fn Scene<T>.get(scene) -> T? {
    let boxed = __scene_root_any(scene._scene_id)
    if is_null(boxed) { return null }
    let root: T = cast(boxed.unwrap())
    return root
}

fn Scene<T>.is_live(scene) -> bool {
    return __scene_state(scene._scene_id) == __SCENE_LIVE
}

fn __scene_reserve() -> int {
    if __SCENE_REGISTRY.next_id == 0 {
        let root_arenas: [int] = []
        let root_closers: [() -> ()] = []
        vec_push(__SCENE_REGISTRY.roots, null)
        vec_push(__SCENE_REGISTRY.states, __SCENE_RESERVED)
        vec_push(__SCENE_REGISTRY.arena_ids, root_arenas)
        vec_push(__SCENE_REGISTRY.closers, root_closers)
        vec_push(__SCENE_REGISTRY.root_type_key, "")
        vec_push(__SCENE_REGISTRY.root_type_bucket, -1)
        vec_push(__SCENE_REGISTRY.type_bucket_pos, -1)
        __SCENE_REGISTRY.next_id = 1
    }
    let id = __SCENE_REGISTRY.next_id
    assert(id == vec_len(__SCENE_REGISTRY.states), "Scene registry is not dense at id {id}")
    __SCENE_REGISTRY.next_id = id + 1
    let owned: [int] = []
    let closers: [() -> ()] = []
    vec_push(__SCENE_REGISTRY.roots, null)
    vec_push(__SCENE_REGISTRY.states, __SCENE_BUILDING)
    vec_push(__SCENE_REGISTRY.arena_ids, owned)
    vec_push(__SCENE_REGISTRY.closers, closers)
    vec_push(__SCENE_REGISTRY.root_type_key, "")
    vec_push(__SCENE_REGISTRY.root_type_bucket, -1)
    vec_push(__SCENE_REGISTRY.type_bucket_pos, -1)
    return id
}

// Finds `type_key`'s bucket index, creating an empty bucket for a type seen
// for the first time.
fn __scene_type_bucket_index(type_key: string) -> int {
    let existing = __SCENE_REGISTRY.type_bucket_lookup.get(type_key)
    if !is_null(existing) {
        return existing.unwrap()
    }
    let empty: [int] = []
    let bucket_index = vec_len(__SCENE_REGISTRY.type_keys)
    vec_push(__SCENE_REGISTRY.type_keys, type_key)
    vec_push(__SCENE_REGISTRY.type_buckets, empty)
    __SCENE_REGISTRY.type_bucket_lookup.insert(type_key, bucket_index)
    return bucket_index
}

// Inserts `scene_id` into its type's live bucket, recording the bucket
// position for O(1) swap-removal at retirement.
fn __scene_type_bucket_insert(scene_id: int, type_key: string) {
    __SCENE_REGISTRY.root_type_key.set(scene_id, type_key)
    let bucket_index = __scene_type_bucket_index(type_key)
    __SCENE_REGISTRY.root_type_bucket.set(scene_id, bucket_index)
    let live = __SCENE_REGISTRY.type_buckets[bucket_index]
    __SCENE_REGISTRY.type_bucket_pos.set(scene_id, vec_len(live))
    vec_push(live, scene_id)
}

// Swap-removes `scene_id` from its type's live bucket. A no-op for a Scene
// that never published a root (the reserved id 0, or an aborted `build`).
fn __scene_type_bucket_remove(scene_id: int) {
    let bucket_index = __SCENE_REGISTRY.root_type_bucket[scene_id]
    if bucket_index < 0 { return }
    let pos = __SCENE_REGISTRY.type_bucket_pos[scene_id]
    if pos < 0 { return }
    let live = __SCENE_REGISTRY.type_buckets[bucket_index]
    let last_index = vec_len(live) - 1
    let last_id = live[last_index]
    live.set(pos, last_id)
    __SCENE_REGISTRY.type_bucket_pos.set(last_id, pos)
    live.pop()
    __SCENE_REGISTRY.root_type_key.set(scene_id, "")
    __SCENE_REGISTRY.root_type_bucket.set(scene_id, -1)
    __SCENE_REGISTRY.type_bucket_pos.set(scene_id, -1)
}

@nomangle
fn __scene_rebuild_type_buckets() {
    let type_keys: [string] = []
    let type_buckets: [[int]] = []
    let type_bucket_pos: [int] = []
    let root_type_bucket: [int] = []
    let lookup: Map<string, int> = map_new()
    __SCENE_REGISTRY.type_keys = type_keys
    __SCENE_REGISTRY.type_buckets = type_buckets
    __SCENE_REGISTRY.type_bucket_pos = type_bucket_pos
    __SCENE_REGISTRY.root_type_bucket = root_type_bucket
    __SCENE_REGISTRY.type_bucket_lookup = lookup
    __SCENE_REGISTRY.phase_bucket_lengths = []
    for i in 0..vec_len(__SCENE_REGISTRY.states) {
        vec_push(__SCENE_REGISTRY.root_type_bucket, -1)
        vec_push(__SCENE_REGISTRY.type_bucket_pos, -1)
    }
    for i in 0..vec_len(__SCENE_REGISTRY.states) {
        if __SCENE_REGISTRY.states[i] == __SCENE_LIVE {
            let key = __SCENE_REGISTRY.root_type_key.get(i)
            if !is_null(key) && key.unwrap() != "" {
                __scene_type_bucket_insert(i, key.unwrap())
            }
        }
    }
}

// Releases everything one incarnation owns and marks it dead. Each owned Arena
// is retired through the ordinary Arena primitive, and one a caller already
// destroyed reports false and is stepped over -- the loop releases what it owns,
// not what it assumes.
//
// `graceful` runs the registered teardown actions first, in registration order
// and BEFORE any Arena is retired: a task's defer or a resource's release is
// entitled to read and write the rows it was running against, and after
// retirement those reads answer null and those writes assert. A closer that
// throws propagates -- the Scene stays queued with its rows intact rather than
// half-torn-down, which is the loud failure, not a swallowed one.
fn __scene_retire(scene_id: int, graceful: bool) {
    if graceful {
        let closers = __SCENE_REGISTRY.closers[scene_id]
        for i in 0..vec_len(closers) {
            closers[i]()
        }
    }
    let no_closers: [() -> ()] = []
    __SCENE_REGISTRY.closers.set(scene_id, no_closers)
    let owned = __SCENE_REGISTRY.arena_ids[scene_id]
    for i in 0..vec_len(owned) {
        __arena_destroy_id(scene_id, owned[i])
    }
    let empty: [int] = []
    __SCENE_REGISTRY.arena_ids.set(scene_id, empty)
    __SCENE_REGISTRY.roots.set(scene_id, null)
    __SCENE_REGISTRY.states.set(scene_id, __SCENE_DEAD)
    __scene_type_bucket_remove(scene_id)
}

// Transactional construction. The Scene's identity exists before its Arenas do,
// so `build` can attach them explicitly; a null result aborts, retiring every
// attached Arena and publishing nothing. The ID is consumed either way.
//
// Failure is the callback returning null, not a caught runtime error: a `pcall`
// around user code would swallow exactly the failures that must propagate.
//
// The abort is GRACEFUL: a builder that acquired something and then failed
// registered its release on the way, and the abort is the only moment that
// release can still run.
fn scene_create<T>(build: fn(SceneBuilder) -> T?) -> Scene<T>? {
    let id = __scene_reserve()
    let root = build(SceneBuilder { _scene_id: id })
    if root == null {
        __scene_retire(id, true)
        return null
    }
    __SCENE_REGISTRY.roots.set(id, __scene_root_erased(root.unwrap()))
    __SCENE_REGISTRY.states.set(id, __SCENE_LIVE)
    let type_key = __rock_scene_type_key<T>()
    __scene_type_bucket_insert(id, type_key)
    return Scene { _scene_id: id }
}

// The builder's one capability, and it is gated on the Building state rather
// than on holding the builder: a copy that outlived construction names an entry
// that is Live or Dead, and rejects here. A write that silently did nothing
// could not be told from one that worked.
fn SceneBuilder.arena<T>(builder) -> Arena<T> {
    let scene_id = builder._scene_id
    assert(__scene_state(scene_id) == __SCENE_BUILDING,
        "SceneBuilder for scene {scene_id} is no longer constructing (its Scene published or aborted)")
    let arena: Arena<T> = __arena_new_owned(scene_id)
    vec_push(__SCENE_REGISTRY.arena_ids[scene_id], arena._arena_id)
    return arena
}

// The builder's other capability: register what a graceful close must run for
// the contents being built here. Same Building gate and same reason as
// `arena` -- a copy that outlived construction would be registering against a
// Scene that is already published or aborted.
fn SceneBuilder.on_close(builder, action: () -> ()) {
    let scene_id = builder._scene_id
    assert(__scene_state(scene_id) == __SCENE_BUILDING,
        "SceneBuilder for scene {scene_id} is no longer constructing (its Scene published or aborted)")
    vec_push(__SCENE_REGISTRY.closers[scene_id], action)
}

// Requests closure. True on the first call for a live Scene, false for a repeat
// or a dead handle, so a caller can tell which close was theirs. Lookup stops
// resolving immediately; the rows die at the next safe-point drain.
fn scene_close<T>(scene: Scene<T>) -> bool {
    let id = scene._scene_id
    if __scene_state(id) != __SCENE_LIVE { return false }
    __SCENE_REGISTRY.states.set(id, __SCENE_CLOSING)
    vec_push(__SCENE_REGISTRY.pending_close, id)
    return true
}

// Discards the Scene: same request, same safe point, same invalidation -- and
// none of its teardown actions run. This is the abrupt half of the pair, for a
// world being thrown away rather than shut down: a level reload where the
// outgoing room's on-death effects must not fire, a failed load, an editor
// document abandoned without committing.
//
// It is a REQUEST for the same reason `scene_close` is: retiring rows the
// moment a caller asks would pull them out from under an update already holding
// them. A Scene already closing or discarding refuses, so the first request
// wins and its mode is the one the drain honours.
fn scene_discard<T>(scene: Scene<T>) -> bool {
    let id = scene._scene_id
    if __scene_state(id) != __SCENE_LIVE { return false }
    __SCENE_REGISTRY.states.set(id, __SCENE_DISCARDING)
    vec_push(__SCENE_REGISTRY.pending_close, id)
    return true
}

// Registers a teardown action on a LIVE Scene, for something acquired after
// construction -- a task spawned by gameplay, a resource opened on demand.
// False for a Scene that has left lookup: an action accepted after the close
// request would never run, and the caller could not tell.
fn scene_on_close<T>(scene: Scene<T>, action: () -> ()) -> bool {
    let id = scene._scene_id
    if __scene_state(id) != __SCENE_LIVE { return false }
    vec_push(__SCENE_REGISTRY.closers[id], action)
    return true
}

// The safe point: physically retires every Scene closed since the last drain and
// returns how many.
//
// INTERNAL, and the underscore is load-bearing. The runner owns the one call, at
// `frame_core_end`, after every update and draw consumer has returned; a system
// calling it mid-frame would invalidate rows a caller further up the stack is
// still holding, which is exactly the guarantee the close/drain split exists to
// give. Ordinary code uses `scene_close`. Tests drive this directly on purpose,
// to observe the drain without waiting a frame.
fn __scene_drain_closed() -> int {
    let pending = __SCENE_REGISTRY.pending_close
    if vec_len(pending) == 0 { return 0 }
    let fresh: [int] = []
    __SCENE_REGISTRY.pending_close = fresh
    let drained = 0
    for i in 0..vec_len(pending) {
        let id = pending[i]
        let state = __scene_state(id)
        if state == __SCENE_CLOSING {
            __scene_retire(id, true)
            drained += 1
        } else if state == __SCENE_DISCARDING {
            __scene_retire(id, false)
            drained += 1
        }
    }
    return drained
}

// Capture the current length of every typed bucket once at a lifecycle phase
// boundary. Newborns append to the same buckets but remain beyond these
// lengths until the next phase.
fn __scene_begin_update_phase() {
    let lengths: [int] = []
    for i in 0..vec_len(__SCENE_REGISTRY.type_buckets) {
        vec_push(lengths, vec_len(__SCENE_REGISTRY.type_buckets[i]))
    }
    __SCENE_REGISTRY.phase_bucket_lengths = lengths
}

fn __scene_type_population(root_type: string) -> [int] {
    let bucket_index = __scene_type_bucket_index(root_type)
    return __SCENE_REGISTRY.type_buckets[bucket_index]
}

fn __scene_type_population_length(root_type: string) -> int {
    let bucket_index = __scene_type_bucket_index(root_type)
    if bucket_index >= vec_len(__SCENE_REGISTRY.phase_bucket_lengths) { return 0 }
    return __SCENE_REGISTRY.phase_bucket_lengths[bucket_index]
}

// How many Scene incarnations the registry currently resolves. Closing Scenes
// are excluded: they are already invisible to lookup.
fn scene_live_count() -> int {
    let live = 0
    for i in 0..vec_len(__SCENE_REGISTRY.states) {
        if __SCENE_REGISTRY.states[i] == __SCENE_LIVE { live += 1 }
    }
    return live
}

// The exact population the next drain will retire.
fn scene_pending_close_count() -> int {
    return vec_len(__SCENE_REGISTRY.pending_close)
}

// How many teardown actions this Scene will run on a graceful close. Zero for
// a dead one, which is also what a drained Scene reports: the list is released
// with the rows.
fn scene_closer_count<T>(scene: Scene<T>) -> int {
    let id = scene._scene_id
    if __scene_state(id) == __SCENE_DEAD { return 0 }
    return vec_len(__SCENE_REGISTRY.closers[id])
}

// How many Arena incarnations this Scene still owns backing for. The identity
// control beside `scene_live_count`: a flat Scene count cannot see an Arena that
// outlived its owner.
fn scene_arena_count<T>(scene: Scene<T>) -> int {
    let id = scene._scene_id
    if __scene_state(id) == __SCENE_DEAD { return 0 }
    let owned = __SCENE_REGISTRY.arena_ids[id]
    let live = 0
    for i in 0..vec_len(owned) {
        if !is_null(__arena_store_any(id, owned[i])) { live += 1 }
    }
    return live
}
