// Tier-0 math value types: Vec2/Vec3/Vec4 and their pure algebra -- the
// keystone type family all backends share (game math and shader math),
// including the v()/zero() constructors and the Vec2 helpers routed through
// them. IVec2/Rect/Color and their constructors stay engine-side
// (stone/engine/math/) because they touch engine-only types or globals.

value Vec2 {
    x: float,
    y: float,
}

value Vec3 {
    x: float,
    y: float,
    z: float,
}

value Vec4 {
    x: float,
    y: float,
    z: float,
    w: float,
}

@pure operator +(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y }
}

@pure operator +(a: Vec2, b: float) -> Vec2 {
    return Vec2 { x: a.x + b, y: a.y + b }
}

@pure operator -(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x - b.x, y: a.y - b.y }
}

@pure operator -(a: Vec2, b: float) -> Vec2 {
    return Vec2 { x: a.x - b, y: a.y - b }
}

@pure operator *(a: Vec2, b: float) -> Vec2 {
    return Vec2 { x: a.x * b, y: a.y * b }
}

@pure operator *(a: float, b: Vec2) -> Vec2 {
    return Vec2 { x: a * b.x, y: a * b.y }
}

@pure operator *(a: Vec2, b: int) -> Vec2 {
    return Vec2 { x: int_to_float(b) * a.x, y: int_to_float(b) * a.y }
}

@pure operator *(a: int, b: Vec2) -> Vec2 {
    return Vec2 { x: int_to_float(a) * b.x, y: int_to_float(a) * b.y }
}

@pure operator *(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x * b.x, y: a.y * b.y }
}

@pure operator /(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x / b.x, y: a.y / b.y }
}

@pure operator /(a: Vec2, b: float) -> Vec2 {
    return Vec2 { x: a.x / b, y: a.y / b }
}

@pure operator /(a: Vec2, b: int) -> Vec2 {
    return Vec2 { x: a.x / int_to_float(b), y: a.y / int_to_float(b) }
}

@intrinsic @pure fn Vec2.distance(a, b: Vec2) -> float {
    let dx = a.x - b.x
    let dy = a.y - b.y

    return sqrt(dx * dx + dy * dy)
}

@pure fn Vec2.angle(v) -> float {
    return atan2(v.y, v.x)
}

@pure fn Vec2.neg(v) -> Vec2 {
    return Vec2 { x: -v.x, y: -v.y }
}

@intrinsic @pure fn Vec2.dot(a, b: Vec2) -> float {
    return a.x * b.x + a.y * b.y
}

@intrinsic @pure fn Vec2.length(v) -> float {
    return (v.x * v.x + v.y * v.y).sqrt()
}

fn Vec2.to_array(v) -> [float] {
    return [v.x, v.y]
}

// Vec2 constructors. The IVec2 overload stays engine-side (IVec2 is
// engine-defined). @inline only where each param is used once -- the one-arg
// v(x) reuses x, so V0 leaves it non-inline (would double-eval args like
// v(off / 32)); V1 will bind to a local and make it inline-safe too.
@intrinsic @inline @pure fn zero() -> Vec2 { return Vec2 { x: 0, y: 0 } }
@intrinsic @inline @pure fn v() -> Vec2 { return Vec2 { x: 0, y: 0 } }
@intrinsic @pure fn v(x: float) -> Vec2 { return Vec2 { x: x, y: x } }
@intrinsic @inline @pure fn v(x: float, y: float) -> Vec2 { return Vec2 { x: x, y: y } }

@pure fn Vec2.normalize(v) -> Vec2 {
    if v.x == 0 && v.y == 0 {
        return zero()
    } else {
        let len = sqrt(v.x * v.x + v.y * v.y)
        return Vec2 { x: v.x / len, y: v.y / len }
    }
}

// Per-element sign/abs. UFCS: `d.sign()`, `d.abs()`.
@pure fn Vec2.sign(a) -> Vec2 { return v(sign(a.x), sign(a.y)) }
@pure fn Vec2.abs(a) -> Vec2 { return v(abs(a.x), abs(a.y)) }

// Componentwise math, mirroring the GLSL builtins (docs/vec-swizzles-plan.md).
// Pure tier-0 bodies: CPU and route-B GLSL share the same code.
@pure fn Vec2.min(a, b: Vec2) -> Vec2 { return v(min(a.x, b.x), min(a.y, b.y)) }
@pure fn Vec2.max(a, b: Vec2) -> Vec2 { return v(max(a.x, b.x), max(a.y, b.y)) }
@pure fn Vec2.clamp(a, lo: float, hi: float) -> Vec2 {
    return v(clamp(a.x, lo, hi), clamp(a.y, lo, hi))
}
@pure fn Vec2.clamp(a, lo: Vec2, hi: Vec2) -> Vec2 {
    return v(clamp(a.x, lo.x, hi.x), clamp(a.y, lo.y, hi.y))
}
@pure fn Vec2.floor(a) -> Vec2 { return v(floor(a.x), floor(a.y)) }
@pure fn Vec2.fract(a) -> Vec2 { return v(fract(a.x), fract(a.y)) }

@pure fn vec2_from_angle(angle: float) -> Vec2 {
    return v(angle.cos(), angle.sin())
}

@pure fn Vec2.rotate(a, angle: float) -> Vec2 {
    let cos = angle.cos()
    let sin = angle.sin()

    return v(a.x * cos - a.y * sin, a.x * sin + a.y * cos)
}

// Complex-multiply `a` by `rhs`: rotates `a` by the angle of `rhs` (and scales
// by |rhs|). A normalized `rhs` gives a pure rotation.
@pure fn Vec2.rotate(a, rhs: Vec2) -> Vec2 {
    return v(a.x * rhs.x - a.y * rhs.y, a.x * rhs.y + a.y * rhs.x)
}

fn Vec2.wiggle(v, angle: float) -> Vec2 {
    return v.rotate(vec2_from_angle(random_range(angle / -2.0, angle / 2)))
}

fn random_dir() -> Vec2 {
    let angle = random_range(0.0, PI * 2.0)
    return v(angle.cos(), angle.sin())
}

fn random_vec(min: float, max: float) -> Vec2 {
    return random_dir() * random_range(min, max)
}

fn random_offset(radius: float) -> Vec2 {
    return random_dir() * random_range(0.0, radius)
}

fn random_circle(radius: float) -> Vec2 {
    return random_offset(radius)
}

fn random_box(center: Vec2, size: Vec2) -> Vec2 {
    return center + v(random_range(-1 * size.x, size.x) / 2, random_range(-1 * size.y, size.y) / 2)
}

fn random_around(position: Vec2, min: float, max: float) -> Vec2 {
    return position + random_vec(min, max)
}

@pure fn intersect_circle(center_a: Vec2, radius_a: float, center_b: Vec2, radius_b: float) -> bool {
    let dist = center_a.distance(center_b)
    return dist < (radius_a + radius_b)
}

@pure fn Vec2.lerp(a, b: Vec2, t: float) -> Vec2 {
    return v(lerp(a.x, b.x, t), lerp(a.y, b.y, t))
}

// Vec3 algebra. Fake-3D convention across games: xy is the ground plane, z is
// height.

@intrinsic @inline
@pure fn v(x: float, y: float, z: float) -> Vec3 {
    return Vec3 { x: x, y: y, z: z }
}

@pure operator +(a: Vec3, b: Vec3) -> Vec3 {
    return v(a.x + b.x, a.y + b.y, a.z + b.z)
}

@pure operator -(a: Vec3, b: Vec3) -> Vec3 {
    return v(a.x - b.x, a.y - b.y, a.z - b.z)
}

@pure operator *(a: Vec3, b: float) -> Vec3 {
    return v(a.x * b, a.y * b, a.z * b)
}

@pure operator *(a: float, b: Vec3) -> Vec3 {
    return v(a * b.x, a * b.y, a * b.z)
}

@pure operator /(a: Vec3, b: float) -> Vec3 {
    return v(a.x / b, a.y / b, a.z / b)
}

@pure operator +(a: Vec3, b: float) -> Vec3 {
    return v(a.x + b, a.y + b, a.z + b)
}

@pure operator -(a: Vec3, b: float) -> Vec3 {
    return v(a.x - b, a.y - b, a.z - b)
}

@pure operator *(a: Vec3, b: Vec3) -> Vec3 {
    return v(a.x * b.x, a.y * b.y, a.z * b.z)
}

@pure operator /(a: Vec3, b: Vec3) -> Vec3 {
    return v(a.x / b.x, a.y / b.y, a.z / b.z)
}

@pure fn Vec3.neg(a) -> Vec3 {
    return v(-a.x, -a.y, -a.z)
}

@pure fn Vec3.sign(a) -> Vec3 { return v(sign(a.x), sign(a.y), sign(a.z)) }
@pure fn Vec3.abs(a) -> Vec3 { return v(abs(a.x), abs(a.y), abs(a.z)) }

@pure fn Vec3.min(a, b: Vec3) -> Vec3 {
    return v(min(a.x, b.x), min(a.y, b.y), min(a.z, b.z))
}
@pure fn Vec3.max(a, b: Vec3) -> Vec3 {
    return v(max(a.x, b.x), max(a.y, b.y), max(a.z, b.z))
}
@pure fn Vec3.clamp(a, lo: float, hi: float) -> Vec3 {
    return v(clamp(a.x, lo, hi), clamp(a.y, lo, hi), clamp(a.z, lo, hi))
}
@pure fn Vec3.clamp(a, lo: Vec3, hi: Vec3) -> Vec3 {
    return v(clamp(a.x, lo.x, hi.x), clamp(a.y, lo.y, hi.y), clamp(a.z, lo.z, hi.z))
}
@pure fn Vec3.floor(a) -> Vec3 { return v(floor(a.x), floor(a.y), floor(a.z)) }
@pure fn Vec3.fract(a) -> Vec3 { return v(fract(a.x), fract(a.y), fract(a.z)) }

@intrinsic @pure fn Vec3.dot(a, b: Vec3) -> float {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

@pure fn Vec3.cross(a, b: Vec3) -> Vec3 {
    return v(
        a.y * b.z - a.z * b.y,
        a.z * b.x - a.x * b.z,
        a.x * b.y - a.y * b.x
    )
}

@intrinsic @pure fn Vec3.length(a) -> float {
    return sqrt(a.dot(a))
}

@intrinsic @pure fn Vec3.distance(a, b: Vec3) -> float {
    return (a - b).length()
}

@pure fn Vec3.normalize(a) -> Vec3 {
    let len = a.length()
    if len < 0.000001 { return v(0.0, 0.0, 0.0) }
    return a / len
}

@pure fn Vec3.lerp(a, b: Vec3, t: float) -> Vec3 {
    return v(
        a.x + (b.x - a.x) * t,
        a.y + (b.y - a.y) * t,
        a.z + (b.z - a.z) * t
    )
}

// Vec4 algebra -- shader-facing (colors, homogeneous coords). No zero() ctor:
// the near-zero normalize guard returns v(0, 0, 0, 0) inline, matching Vec3.

@intrinsic @inline
@pure fn v(x: float, y: float, z: float, w: float) -> Vec4 {
    return Vec4 { x: x, y: y, z: z, w: w }
}

@pure operator +(a: Vec4, b: Vec4) -> Vec4 {
    return v(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w)
}

@pure operator +(a: Vec4, b: float) -> Vec4 {
    return v(a.x + b, a.y + b, a.z + b, a.w + b)
}

@pure operator -(a: Vec4, b: float) -> Vec4 {
    return v(a.x - b, a.y - b, a.z - b, a.w - b)
}

@pure operator -(a: Vec4, b: Vec4) -> Vec4 {
    return v(a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w)
}

@pure operator *(a: Vec4, b: float) -> Vec4 {
    return v(a.x * b, a.y * b, a.z * b, a.w * b)
}

@pure operator *(a: float, b: Vec4) -> Vec4 {
    return v(a * b.x, a * b.y, a * b.z, a * b.w)
}

@pure operator *(a: Vec4, b: Vec4) -> Vec4 {
    return v(a.x * b.x, a.y * b.y, a.z * b.z, a.w * b.w)
}

@pure operator /(a: Vec4, b: Vec4) -> Vec4 {
    return v(a.x / b.x, a.y / b.y, a.z / b.z, a.w / b.w)
}

@pure operator /(a: Vec4, b: float) -> Vec4 {
    return v(a.x / b, a.y / b, a.z / b, a.w / b)
}

@intrinsic @pure fn Vec4.dot(a, b: Vec4) -> float {
    return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
}

@intrinsic @pure fn Vec4.length(a) -> float {
    return sqrt(a.dot(a))
}

@pure fn Vec4.normalize(a) -> Vec4 {
    let len = a.length()
    if len < 0.000001 { return v(0.0, 0.0, 0.0, 0.0) }
    return a / len
}

@pure fn Vec4.lerp(a, b: Vec4, t: float) -> Vec4 {
    return v(
        a.x + (b.x - a.x) * t,
        a.y + (b.y - a.y) * t,
        a.z + (b.z - a.z) * t,
        a.w + (b.w - a.w) * t
    )
}

@pure fn Vec4.abs(a) -> Vec4 { return v(abs(a.x), abs(a.y), abs(a.z), abs(a.w)) }
@pure fn Vec4.min(a, b: Vec4) -> Vec4 {
    return v(min(a.x, b.x), min(a.y, b.y), min(a.z, b.z), min(a.w, b.w))
}
@pure fn Vec4.max(a, b: Vec4) -> Vec4 {
    return v(max(a.x, b.x), max(a.y, b.y), max(a.z, b.z), max(a.w, b.w))
}
@pure fn Vec4.clamp(a, lo: float, hi: float) -> Vec4 {
    return v(clamp(a.x, lo, hi), clamp(a.y, lo, hi), clamp(a.z, lo, hi), clamp(a.w, lo, hi))
}
@pure fn Vec4.clamp(a, lo: Vec4, hi: Vec4) -> Vec4 {
    return v(clamp(a.x, lo.x, hi.x), clamp(a.y, lo.y, hi.y), clamp(a.z, lo.z, hi.z), clamp(a.w, lo.w, hi.w))
}
@pure fn Vec4.floor(a) -> Vec4 { return v(floor(a.x), floor(a.y), floor(a.z), floor(a.w)) }
@pure fn Vec4.fract(a) -> Vec4 { return v(fract(a.x), fract(a.y), fract(a.z), fract(a.w)) }

// Mixed vector ctors -- the GLSL `vec4(v.rgb, 1.0)` idiom.
@inline @pure fn v(xy: Vec2, z: float) -> Vec3 { return v(xy.x, xy.y, z) }
@inline @pure fn v(xyz: Vec3, w: float) -> Vec4 { return v(xyz.x, xyz.y, xyz.z, w) }
@inline @pure fn v(xy: Vec2, z: float, w: float) -> Vec4 { return v(xy.x, xy.y, z, w) }
