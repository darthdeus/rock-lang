// IEEE non-finite predicates. GLES 3.00 has isnan/isinf natively (the GLSL
// templates map straight through). NOT @gpu_only -- CPU-callable, so the
// value-test corpus exercises them on luajit and JS; the inline(lua) body IS
// the luajit mapping, JS gets a table row (crates/skull-codegen-js).
@intrinsic inline(lua) fn isnan(x: float) -> bool = """
    return x ~= x
"""

@intrinsic inline(lua) fn isinf(x: float) -> bool = """
    return x == math.huge or x == -math.huge
"""

// Bool-vector tier. A plain value struct -- luajit/JS get it
// free as a value; the GLSL emitter maps it to `bvec3`, LOCAL/TEMP ONLY (bool
// interpolants are rejected in attr/varying/uniform position). Built via
// `bvec3(...)`, reduced via `any`, produced by `greater_than`, and cast to Vec3
// via `to_vec3` (the GLSL `vec3(bvec)` per-channel bool->float select).
value Bvec3 { x: bool, y: bool, z: bool }

// Ctor: portable `Bvec3 { ... }` body for luajit/JS; a GLSL template renders the
// native `bvec3(a, b, c)` inline (a helper fn would collide with the GLSL builtin
// type name -- "recursive call to bvec3").
@intrinsic fn bvec3(x: bool, y: bool, z: bool) -> Bvec3 {
    return Bvec3 { x: x, y: y, z: z }
}

// The three below carry a portable Rock body (luajit/JS need nothing) AND a
// GLSL template (crates/skull-codegen-glsl) so the shader path renders the
// native builtin inline. `any` here is arity-1 (the iterator `any` is arity-2).
@intrinsic fn any(b: Bvec3) -> bool {
    return b.x || b.y || b.z
}

@intrinsic fn greater_than(a: Vec3, b: Vec3) -> Bvec3 {
    return Bvec3 { x: a.x > b.x, y: a.y > b.y, z: a.z > b.z }
}

@intrinsic fn to_vec3(b: Bvec3) -> Vec3 {
    let x = if b.x { 1.0 } else { 0.0 }
    let y = if b.y { 1.0 } else { 0.0 }
    let z = if b.z { 1.0 } else { 0.0 }
    return v(x, y, z)
}

// In-game shader compilation. A call
// `rock_shader(vert, frag)` (two direct references to top-level @shader fns)
// is expanded at MIR lowering to the pipeline key const "<vert>+<frag>" that
// pipeline() looks up; the driver emits one __rock_shader_register(key, glsl)
// per distinct pair at chunk top level. Annotation-keyed (not name-keyed) so a
// user fn named rock_shader can't hijack it. The CPU body only fires if the fn
// is taken as a value (never a silent stub); a real call is always expanded.
@shader_expand inline(lua) fn rock_shader<V, F>(vert: V, frag: F) -> string = """
    error("rock_shader is a compile-time shader-pipeline intrinsic (expanded at compile time)")
"""

// Single-arg fullscreen form: a direct
// reference to a top-level @shader(fragment) fn. Expands to the bare frag-name
// key (never contains '+', so it cannot collide with a pair key); the driver
// routes it to the A1 single-entry emitter (PIXEL body + fullscreen VERTEX
// passthrough). Same @shader_expand, so resolution stays annotation-keyed.
@shader_expand inline(lua) fn rock_shader<F>(frag: F) -> string = """
    error("rock_shader is a compile-time shader-pipeline intrinsic (expanded at compile time)")
"""

@shader_expand inline(lua) fn rock_compute<F>(entry: F) -> string = """
    error("rock_compute is a compile-time compute-artifact intrinsic (expanded at compile time)")
"""

// The one compiler-owned logical value packet shared by GL, WebGL and wgpu.
// Its leaves contain values and kinds only; physical offsets and padding belong
// to each backend's ABI projection.
enum CanonicalUniformLeaf {
    Float(float),
    Int(int),
    Uint(uint),
    Bool(bool),
}

struct SemanticUniformBlock {
    fingerprint: int,
    leaves: [CanonicalUniformLeaf],
}

value SemanticUniformArrayMember {
    name: string,
    values: [CanonicalUniformLeaf],
}

value SemanticUniformArrayBlock {
    name: string,
    members: [SemanticUniformArrayMember],
}

@uniform_values inline(lua) fn uniform_values<T>(u: T) -> SemanticUniformBlock = """
    error("uniform_values is compiler-expanded")
"""

// Pack `u` into a std140 uniform block: one direct typed store per primitive
// leaf, at that leaf's std140 element index, through the two views the caller
// passes. Never a per-leaf helper call and never a pack -- the leaves go from
// registers into the views.
//
// The layout comes from `u`'s CONCRETE type. A generic source wrapper is
// admitted; its retained concrete instance supplies that type to the expander.
@uniform_expand inline(lua) fn pack_uniform_block<T>(fv: Ptr<float>, iv: Ptr<int>, u: T) = """
    error("pack_uniform_block is compiler-expanded")
"""

// The std140 layout identity of `u`'s CONCRETE type, as a compile-time
// constant. Same annotation as the packer because it answers the same question
// -- what is `T`'s plan -- and the arity picks the shape.
//
// This is how a call site says WHICH of a program's blocks it means: an A2
// pipeline has one block per stage, so the shader name no longer identifies
// one and the value's type is what does.
@uniform_expand inline(lua) fn uniform_block_id<T>(u: T) -> int = """
    error("uniform_block_id is compiler-expanded")
"""
