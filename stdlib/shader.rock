// GPU-only shader surface. Sampler2D is a phantom
// param type for @shader entry fns -- never constructed CPU-side. texture()
// maps to the GLSL builtin; reaching it on the CPU is a hard error, never a
// silent stub.

value Sampler2D {
    __handle: int,
}

@intrinsic @gpu_only inline(lua) fn texture(s: Sampler2D, uv: Vec2) -> Vec4 = """
    error("texture() is GPU-only (shader fns are not CPU-callable)")
"""

// The sampler's mip-0 dimensions as a float Vec2 (`vec2(textureSize(s, 0))`).
// Not stage-restricted -- textureSize is legal in every GLSL stage.
@intrinsic @gpu_only inline(lua) fn texture_size(s: Sampler2D) -> Vec2 = """
    error("texture_size() is GPU-only (shader fns are not CPU-callable)")
"""

// Integer sampler (the R32I entity-id tier).
// Phantom like Sampler2D. texture_id() reads the id channel as int
// (`texture(s, uv).r`); GLSL ES gives isampler2D no default precision, so the
// emitter declares it `highp` at the use site.
value ISampler2D {
    __handle: int,
}

@intrinsic @gpu_only inline(lua) fn texture_id(s: ISampler2D, uv: Vec2) -> int = """
    error("texture_id() is GPU-only (shader fns are not CPU-callable)")
"""

@intrinsic @gpu_only inline(lua) fn texture_size(s: ISampler2D) -> Vec2 = """
    error("texture_size() is GPU-only (shader fns are not CPU-callable)")
"""

// GPU builtins. Fragment-stage only; the
// emitter whitelists them per stage. CPU bodies error -- never a silent stub.
@intrinsic @gpu_only inline(lua) fn frag_coord() -> Vec4 = """
    error("frag_coord() is GPU-only (fragment-stage builtin)")
"""

@intrinsic @gpu_only inline(lua) fn fwidth(x: float) -> float = """
    error("fwidth() is GPU-only (fragment-stage builtin)")
