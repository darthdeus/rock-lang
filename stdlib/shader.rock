// Sampler2D is a shader-only phantom; CPU texture calls fail.

value Sampler2D {
    __handle: int,
}

@intrinsic @gpu_only inline(lua) fn texture(s: Sampler2D, uv: Vec2) -> Vec4 = """
    error("texture() is GPU-only (shader fns are not CPU-callable)")
"""

@intrinsic @gpu_only inline(lua) fn texture_size(s: Sampler2D) -> Vec2 = """
    error("texture_size() is GPU-only (shader fns are not CPU-callable)")
"""

// GLSL ES gives isampler2D no default precision, so the emitter declares it
// `highp` at the use site.
value ISampler2D {
    __handle: int,
}

@intrinsic @gpu_only inline(lua) fn texture_id(s: ISampler2D, uv: Vec2) -> int = """
    error("texture_id() is GPU-only (shader fns are not CPU-callable)")
"""

@intrinsic @gpu_only inline(lua) fn texture_size(s: ISampler2D) -> Vec2 = """
    error("texture_size() is GPU-only (shader fns are not CPU-callable)")
"""

@intrinsic @gpu_only inline(lua) fn frag_coord() -> Vec4 = """
    error("frag_coord() is GPU-only (fragment-stage builtin)")
"""

@intrinsic @gpu_only inline(lua) fn fwidth(x: float) -> float = """
    error("fwidth() is GPU-only (fragment-stage builtin)")
"""

@intrinsic @gpu_only inline(lua) fn dfdx(x: float) -> float = """
    error("dfdx() is GPU-only (fragment-stage builtin)")
"""

@intrinsic @gpu_only inline(lua) fn dfdy(x: float) -> float = """
    error("dfdy() is GPU-only (fragment-stage builtin)")
"""

@intrinsic @gpu_only inline(lua) fn discard() = """
    error("discard() is GPU-only (fragment-stage builtin)")
"""

@intrinsic @gpu_only inline(lua) fn vertex_id() -> int = """
    error("vertex_id() is GPU-only (vertex-stage builtin)")
"""

// Uniform arrays. Param-position-only
// phantom, `@size(N)` required on the param, param name = GLSL uniform name.
// CPU upload stays shader_set_*_array (declared N is capacity).
struct UniformArray<T> { }

@intrinsic @gpu_only inline(lua) fn at<T>(a: UniformArray<T>, i: int) -> T = """
    error("at() is GPU-only (uniform-array indexing)")
"""

// GLSL uses the native IEEE predicates.
@intrinsic @inline fn isnan(x: float) -> bool { return x != x }

@intrinsic @inline fn isinf(x: float) -> bool {
    return abs(x) == 1.0 / 0.0
}

value Bvec3 { x: bool, y: bool, z: bool }

// A GLSL template renders `bvec3(...)` inline; a helper fn would collide with
// the GLSL builtin type name.
@intrinsic fn bvec3(x: bool, y: bool, z: bool) -> Bvec3 {
    return Bvec3 { x: x, y: y, z: z }
}

@intrinsic fn any(b: Bvec3) -> bool {
    return b.x || b.y || b.z
}

@intrinsic fn greater_than(a: Vec3, b: Vec3) -> Bvec3 {
    return Bvec3 { x: a.x > b.x, y: a.y > b.y, z: a.z > b.z }
}

@intrinsic fn to_vec3(b: Bvec3) -> Vec3 {
    let x = if b.x { 1.0 } else { 0.0 }
    let y = if b.y { 1.0 } else { 0.0 }
    let z = if b.z { 1.0 } else { 0.0 }
    return v(x, y, z)
}

// The compiler expands direct shader references to a pipeline key and
// registers each distinct pair. Calls are matched by annotation, not name.
@shader_expand inline(lua) fn rock_shader<V, F>(vert: V, frag: F) -> string = """
    error("rock_shader is a compile-time shader-pipeline intrinsic (expanded at compile time)")
"""

// The fullscreen fragment key contains no '+', so it cannot collide with a pair key.
@shader_expand inline(lua) fn rock_shader<F>(frag: F) -> string = """
    error("rock_shader is a compile-time shader-pipeline intrinsic (expanded at compile time)")
"""

// Physical offsets and padding belong to each backend's ABI projection.
enum CanonicalUniformLeaf {
    Float(float),
    Int(int),
    Uint(uint),
    Bool(bool),
}

struct SemanticUniformBlock {
    fingerprint: int,
    leaves: [CanonicalUniformLeaf],
}

@uniform_values inline(lua) fn uniform_values<T>(u: T) -> SemanticUniformBlock = """
    error("uniform_values is compiler-expanded")
"""

// The concrete type supplies the std140 layout, even through a generic wrapper.
@uniform_expand inline(lua) fn pack_uniform_block<T>(fv: Ptr<float>, iv: Ptr<int>, u: T) = """
    error("pack_uniform_block is compiler-expanded")
"""

// The concrete value type identifies the block; a pipeline can have one per stage.
@uniform_expand inline(lua) fn uniform_block_id<T>(u: T) -> int = """
    error("uniform_block_id is compiler-expanded")
"""
