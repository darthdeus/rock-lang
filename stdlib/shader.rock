// GPU-only shader surface (docs/shaders.md). Sampler2D is a phantom
// param type for @shader entry fns -- never constructed CPU-side. texture()
// maps to the GLSL builtin; reaching it on the CPU is a hard error, never a
// silent stub.

struct Sampler2D {
    __handle: int,
}

@intrinsic @gpu_only inline(lua) fn texture(s: Sampler2D, uv: Vec2) -> Vec4 = """
    error("texture() is GPU-only (shader fns are not CPU-callable)")
"""

// The sampler's mip-0 dimensions as a float Vec2 (`vec2(textureSize(s, 0))`).
// Not stage-restricted -- textureSize is legal in every GLSL stage.
@intrinsic @gpu_only inline(lua) fn texture_size(s: Sampler2D) -> Vec2 = """
    error("texture_size() is GPU-only (shader fns are not CPU-callable)")
"""

// GPU builtins (docs/shaders.md). Fragment-stage only; the
// emitter whitelists them per stage. CPU bodies error -- never a silent stub.
@intrinsic @gpu_only inline(lua) fn frag_coord() -> Vec4 = """
    error("frag_coord() is GPU-only (fragment-stage builtin)")
"""

@intrinsic @gpu_only inline(lua) fn fwidth(x: float) -> float = """
    error("fwidth() is GPU-only (fragment-stage builtin)")
"""

@intrinsic @gpu_only inline(lua) fn discard() = """
    error("discard() is GPU-only (fragment-stage builtin)")
"""

// Vertex-stage only (A2c): the per-vertex index within the draw call.
@intrinsic @gpu_only inline(lua) fn vertex_id() -> int = """
    error("vertex_id() is GPU-only (vertex-stage builtin)")
"""

// Uniform arrays (docs/shaders.md). Param-position-only
// phantom, `@size(N)` required on the param, param name = GLSL uniform name.
// CPU upload stays shader_set_*_array (declared N is capacity).
struct UniformArray<T> { }

@intrinsic @gpu_only inline(lua) fn at<T>(a: UniformArray<T>, i: int) -> T = """
    error("at() is GPU-only (uniform-array indexing)")
"""

// In-game shader compilation (docs/shaders.md). A call
// `rock_shader(vert, frag)` (two direct references to top-level @shader fns)
// is expanded at MIR lowering to the pipeline key const "<vert>+<frag>" that
// pipeline() looks up; the driver emits one __rock_shader_register(key, glsl)
// per distinct pair at chunk top level. Annotation-keyed (not name-keyed) so a
// user fn named rock_shader can't hijack it. The CPU body only fires if the fn
// is taken as a value (never a silent stub); a real call is always expanded.
@shader_expand inline(lua) fn rock_shader<V, F>(vert: V, frag: F) -> string = """
    error("rock_shader is a compile-time shader-pipeline intrinsic (expanded at compile time)")
"""

// Single-arg fullscreen form (docs/shaders.md): a direct
// reference to a top-level @shader(fragment) fn. Expands to the bare frag-name
// key (never contains '+', so it cannot collide with a pair key); the driver
// routes it to the A1 single-entry emitter (PIXEL body + fullscreen VERTEX
// passthrough). Same @shader_expand, so resolution stays annotation-keyed.
@shader_expand inline(lua) fn rock_shader<F>(frag: F) -> string = """
    error("rock_shader is a compile-time shader-pipeline intrinsic (expanded at compile time)")
"""
