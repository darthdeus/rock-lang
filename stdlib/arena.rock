// Arena<T> + Entity<T>: generational-index entity storage (dynamic mobs,
// projectiles). Both are WEAK handles -- scalar logical identities resolved
// through the Session Arena registry below -- so neither keeps backing data
// alive and neither survives the incarnation it names. The `Arena`/`Entity`
// decls live in unified.rock with the other early type decls.
//
// Design and the phase this implements: `docs/scene-system-plan.md` P1.

// The bookkeeping SoA one Arena incarnation owns. A slot's index IS its
// position in every column, so ops touch column SUBSETS -- `contains` reads
// occupancy+generations, `get` adds data, `values()` never looks at generations.
//
// `next_generation` is the per-Arena monotonic issuance counter: EVERY
// insertion takes the next value and advances it, reused slot or fresh. That is
// what lets `clear()` empty the columns while remaining unable to reissue a
// generation a stale handle already holds.
struct ArenaStore<T> {
    generations: [int],
    occupied: [bool],
    data: [T],
    free_indices: [int],
    occupied_count: int = 0,
    next_generation: int = 0,
}

// --- the Session Arena registry ----------------------------------------------
//
// One flat physical lookup for the whole Session: ownership is a Scene concern,
// but a nested Session -> Scene -> Arena walk would put two hash lookups in
// front of every random `Entity.get()`. Arena IDs are dense and monotonic, so
// `_arena_id` indexes `__ARENA_STORES` directly.
//
// IDs are never reused: a destroyed Arena's slot is nulled and its ID retires
// with it, which is what stops an escaped handle from resolving into whatever
// is created next. Owner IDs are a parallel column rather than a store field,
// so the physical lookup needs no knowledge of the element type.
//
// Everything created by `arena_new()` belongs to owner (scene) 0, the Session
// root, until P2 introduces typed Scenes.
@state(ownership=session, world=boot_only, realization=fresh_session)
global __ARENA_STORES: [any?] = []
@state(ownership=session, world=boot_only, realization=fresh_session)
global __ARENA_SCENE_IDS: [int] = []
@state(ownership=session, world=boot_only, realization=fresh_session)
global __ARENA_NEXT_ID: int = 0

@state(ownership=session, world=boot_only, realization=fresh_session)
global __ARENA_SESSION_ROOT: int = 0

// THE resolution oracle: every Arena operation, the `enumerate(arena)` loop
// lowering, and the serializer's logical-Arena projection all reach backing
// through this one function. Non-generic so a synthesized `Inst::Call` and an
// `inline(lua)` walker can both target it; the element type is recovered by the
// typed wrapper below, which is a no-op at runtime.
@nomangle fn __arena_store_any(scene_id: int, arena_id: int) -> any? {
    let slot = __ARENA_STORES.get(arena_id)
    if is_null(slot) { return null }
    let store = slot.unwrap()
    if is_null(store) { return null }
    if __ARENA_SCENE_IDS[arena_id] != scene_id { return null }
    return store
}

// `T` is pinned by the handle rather than left to the call site: an oracle
// taking two bare ints has nothing to infer from, and the use site's expected
// type is `T?`, which silently instantiates the store's column as `[T?]`.
fn __arena_store<T>(arena: Arena<T>) -> ArenaStore<T>? {
    let boxed = __arena_store_any(arena._scene_id, arena._arena_id)
    if is_null(boxed) { return null }
    let store: ArenaStore<T> = cast(boxed.unwrap())
    return store
}

// A write through a retired handle must not quietly do nothing: a no-op write is
// indistinguishable from one that worked. Reads answer "not there"; mutations
// reject here.
fn __arena_store_mut<T>(arena: Arena<T>) -> ArenaStore<T> {
    let store = __arena_store(arena)
    assert(!is_null(store), "Arena {arena._arena_id} is not live (destroyed, or its scene was unloaded)")
    return store.unwrap()
}

// Never null, so a walk over a retired handle is a zero-length one rather than
// a branch that has to invent empty columns -- three `[]` literals per arena
// loop, in the cold arm of every one. The shared dead store's occupancy column
// is empty, so `data` and `generations` are never read and their element type
// never matters; the `cast` is the usual runtime no-op.
//
// `__arena_store_or_empty` is the same store for the `enumerate(arena)`
// lowering, which needs a non-generic callee for its synthesized `Inst::Call`.
@state(ownership=session, world=boot_only, realization=fresh_session)
global __ARENA_DEAD_STORE: ArenaStore<int> = ArenaStore {
    generations: [], occupied: [], data: [], free_indices: [],
    occupied_count: 0, next_generation: 0,
}

fn __arena_store_or_dead<T>(arena: Arena<T>) -> ArenaStore<T> {
    let found = __arena_store(arena)
    if is_null(found) {
        let dead: ArenaStore<T> = cast(__ARENA_DEAD_STORE)
        return dead
    }
    return found.unwrap()
}

@nomangle fn __arena_store_or_empty(scene_id: int, arena_id: int) -> any {
    let boxed = __arena_store_any(scene_id, arena_id)
    if is_null(boxed) { return __ARENA_DEAD_STORE }
    return boxed.unwrap()
}

// An Arena owned by the Session root. Scene-owned Arenas come from
// `SceneBuilder.arena()` (`stdlib/scene.rock`), which is the same registry and
// the same creation path with a different owner ID -- not a second Arena
// implementation.
fn arena_new<T>() -> Arena<T> {
    return __arena_new_owned(__ARENA_SESSION_ROOT)
}

fn __arena_new_owned<T>(scene_id: int) -> Arena<T> {
    let id = __ARENA_NEXT_ID
    assert(id == vec_len(__ARENA_STORES), "Arena registry is not dense at id {id}")
    __ARENA_NEXT_ID = id + 1
    let store: ArenaStore<T> = ArenaStore {
        generations: [], occupied: [], data: [], free_indices: [],
        occupied_count: 0, next_generation: 0,
    }
    vec_push(__ARENA_STORES, store)
    vec_push(__ARENA_SCENE_IDS, scene_id)
    return Arena { _scene_id: scene_id, _arena_id: id }
}

fn __arena_reinitialize<T>(arena: Arena<T>) {
    assert(!is_null(__arena_store_any(arena._scene_id, arena._arena_id)),
        "Arena {arena._arena_id} is not live")
    let store: ArenaStore<T> = ArenaStore {
        generations: [], occupied: [], data: [], free_indices: [],
        occupied_count: 0, next_generation: 0,
    }
    __ARENA_STORES[arena._arena_id] = store
}

// Retires one Arena incarnation, releasing its rows. True on the first call,
// false for a handle that was already dead -- so a caller can tell which
// destruction was theirs. The ID stays consumed.
fn arena_destroy<T>(arena: Arena<T>) -> bool {
    return __arena_destroy_id(arena._scene_id, arena._arena_id)
}

// The element-type-free half, for Scene teardown: a Scene owns Arena IDs, not
// typed handles, so the drain cannot spell `Arena<T>` for each one.
fn __arena_destroy_id(scene_id: int, arena_id: int) -> bool {
    if is_null(__arena_store_any(scene_id, arena_id)) { return false }
    __ARENA_STORES.set(arena_id, null)
    return true
}

fn entity_new<T>(arena: Arena<T>, slot: int, generation: int) -> Entity<T> {
    assert(slot >= 0, "entity_new::Entity slot is invalid")
    assert(generation >= 0, "Entity generation is invalid")

    return Entity {
        _scene_id: arena._scene_id,
        _arena_id: arena._arena_id,
        _slot: slot,
        _generation: generation,
    }
}

fn __entity_arena<T>(entity: Entity<T>) -> Arena<T> {
    return Arena { _scene_id: entity._scene_id, _arena_id: entity._arena_id }
}

fn Entity<T>.get(entity) -> T? { return get(__entity_arena(entity), entity) }

fn Entity<T>.remove(entity) -> T? { return remove(__entity_arena(entity), entity) }

fn Entity<T>.equals(a, b: Entity<T>) -> bool {
    return a._scene_id == b._scene_id
        && a._arena_id == b._arena_id
        && a._slot == b._slot
        && a._generation == b._generation
}

// Stable identity string for one entity, unique across slot reuse, Arena
// replacement and scene reload -- the public form of the `_`-prefixed fields
// for keying UI ids, maps and debug labels.
fn entity_key<T>(entity: Entity<T>) -> string {
    return "{entity._scene_id}:{entity._arena_id}:{entity._slot}:{entity._generation}"
}

// Whether `slot` names a live row matching `generation`. The single
// occupancy+generation test every op shares -- `occupied.get` doubles as the
// range check, returning null past the end.
fn arena_slot_live<T>(store: ArenaStore<T>, slot: int, generation: int) -> bool {
    let live = store.occupied.get(slot)
    if is_null(live) || !live.unwrap() { return false }
    return store.generations[slot] == generation
}

// A handle only addresses the Arena that issued it. Checking identity BEFORE
// the registry lookup means a foreign entity is rejected on its own terms
// rather than resolving against whichever store this Arena names.
fn __arena_owns<T>(arena: Arena<T>, entity: Entity<T>) -> bool {
    return arena._scene_id == entity._scene_id && arena._arena_id == entity._arena_id
}

fn Arena<T>.insert(arena, value: T) -> Entity<T> {
    let store = __arena_store_mut(arena)
    let generation = store.next_generation
    store.next_generation = generation + 1

    // Fresh slots arrive at the occupancy column's old length; the other two
    // columns are still one short, which is exactly the test for "grow".
    let slot = __slot_alloc(store, store.occupied)
    if slot == vec_len(store.generations) {
        vec_push(store.generations, generation)
        vec_push(store.data, value)
    } else {
        store.generations.set(slot, generation)
        store.data.set(slot, value)
    }
    store.occupied.set(slot, true)

    return entity_new(arena, slot, generation)
}

fn Arena<T>.get(arena, entity: Entity<T>) -> T? {
    if !__arena_owns(arena, entity) { return null }
    let found = __arena_store(arena)
    if is_null(found) { return null }
    let store = found.unwrap()
    if !arena_slot_live(store, entity._slot, entity._generation) { return null }
    return store.data[entity._slot]
}

fn Arena<T>.contains(arena, entity: Entity<T>) -> bool {
    if !__arena_owns(arena, entity) { return false }
    let found = __arena_store(arena)
    if is_null(found) { return false }
    return arena_slot_live(found.unwrap(), entity._slot, entity._generation)
}

fn Arena<T>.remove(arena, entity: Entity<T>) -> T? {
    if !__arena_owns(arena, entity) { return null }
    let found = __arena_store(arena)
    if is_null(found) { return null }
    let store = found.unwrap()
    let slot = entity._slot
    if !arena_slot_live(store, slot, entity._generation) { return null }
    // `data[slot]` is left as-is: nothing reads a free slot (every read goes
    // through the occupancy test), and clearing it would mean inventing a T.
    store.occupied.set(slot, false)
    __slot_release(store, slot)
    return store.data[slot]
}

fn Arena<T>.len(arena) -> int {
    let found = __arena_store(arena)
    if is_null(found) { return 0 }
    return found.unwrap().occupied_count
}

// How many Arena incarnations the Session registry is still holding backing for.
//
// The registry is a STRONG root: a store lives until something retires it, which
// is a change from the pre-P1 representation where an unreferenced `Arena` table
// was collectible. Until Scenes own Arenas (`docs/scene-system-plan.md` P2), that
// makes this the leak oracle -- a loop that spawns and despawns must leave it
// flat, and a test asserting only `len()` cannot see the difference.
fn arena_live_count() -> int {
    let live = 0
    for i in 0..vec_len(__ARENA_STORES) {
        if !is_null(__ARENA_STORES[i]) { live += 1 }
    }
    return live
}

// How many slots the Arena has ever allocated, live or free -- its high-water
// mark, not its population. The observable for free-list reuse: churn that
// reuses slots leaves this flat while `len()` moves.
fn arena_slot_count<T>(arena: Arena<T>) -> int {
    let found = __arena_store(arena)
    if is_null(found) { return 0 }
    return vec_len(found.unwrap().occupied)
}

// Releases the payload graph while keeping the incarnation: same Arena ID, so
// nothing downstream re-acquires the handle, and the same `next_generation`, so
// no pre-clear Entity can be reissued.
fn Arena<T>.clear(arena) {
    let store = __arena_store_mut(arena)
    store.generations = []
    store.occupied = []
    store.data = []
    store.free_indices = []
    store.occupied_count = 0
}

fn Arena<T>.random(arena) -> (Entity<T>, T)? {
    let found = __arena_store(arena)
    if is_null(found) { return null }
    let store = found.unwrap()
    let len = store.occupied_count
    if len == 0 { return null }

    // random_int is half-open [min, max), so use `len` not `len - 1`
    // to make the last occupied slot reachable.
    let random_index = random_int(0, len)
    let current_count = 0
    let slots = vec_len(store.occupied)

    for i in 0..slots {
        if store.occupied[i] {
            if current_count == random_index {
                return (entity_new(arena, i, store.generations[i]), store.data[i])
            }
            current_count += 1
        }
    }

    return null
}

// Arena iteration -- two modes, both `Iterator<..>`-conformant so they compose
// with the combinators + terminals. `values()` yields `T`; `pairs()` yields a
// `(Entity<T>, T)` tuple ELEMENT (2-tuple `next`, not multi-value -- a bound
// cannot wrap an unknown-arity splat). Bare `for (e, v) in arena` desugars
// through `iter(arena)` = pairs mode; the per-iteration pair tuple (and the
// Entity, when unused) scalarizes away at codegen (tuple SROA,
// `crates/skull/tests/tuple_scalarize.rs`). Both keep the FETCH-OUTSIDE skip-loop
// shape (one candidate fetched before the while; the loop body runs only on a
// dead slot) -- the naive fetch-inside shape blacklists to the interpreter at
// light fragmentation (`docs/iterator-desugaring-investigation.md`, 8.8x at 10%
// holes). entries/len snapshot once per loop (mutation mid-iteration beyond
// removing the current element is recorded UB).
//
// Backing resolves ONCE, at construction: Scene ownership must not put a
// registry lookup in front of every row. A retired handle yields an iterator
// over an empty column rather than an error, matching `len() == 0`.
//
// Each iterator snapshots only the columns it yields from: `values()` never
// touches generations, `keys()` never touches data.

struct ArenaValIter<T> {
    occupied: [bool],
    data: [T],
    n: int,
    i: int,
}

@inline
fn values<T>(a: Arena<T>) -> ArenaValIter<T> {
    let store = __arena_store_or_dead(a)
    return ArenaValIter { occupied: store.occupied, data: store.data, n: store.occupied.len, i: 0 }
}

@inline
fn next<T>(it: ArenaValIter<T>) -> (bool, T) {
    let i = it.i
    if i >= it.n { return (false, phantom()) }
    while !it.occupied[i] {
        i = i + 1
        if i >= it.n { it.i = i; return (false, phantom()) }
    }
    it.i = i + 1
    return (true, it.data[i])
}

struct ArenaPairIter<T> {
    arena: Arena<T>,
    occupied: [bool],
    generations: [int],
    data: [T],
    n: int,
    i: int,
}

@inline
fn pairs<T>(a: Arena<T>) -> ArenaPairIter<T> {
    let store = __arena_store_or_dead(a)
    return ArenaPairIter {
        arena: a,
        occupied: store.occupied,
        generations: store.generations,
        data: store.data,
        n: store.occupied.len,
        i: 0,
    }
}

@inline
fn next<T>(it: ArenaPairIter<T>) -> (bool, (Entity<T>, T)) {
    let i = it.i
    if i >= it.n { return (false, phantom()) }
    while !it.occupied[i] {
        i = i + 1
        if i >= it.n { it.i = i; return (false, phantom()) }
    }
    it.i = i + 1
    let e = Entity {
        _scene_id: it.arena._scene_id,
        _arena_id: it.arena._arena_id,
        _slot: i,
        _generation: it.generations[i],
    }
    return (true, (e, it.data[i]))
}

struct ArenaKeyIter<T> {
    arena: Arena<T>,
    occupied: [bool],
    generations: [int],
    n: int,
    i: int,
}

@inline
fn keys<T>(a: Arena<T>) -> ArenaKeyIter<T> {
    let store = __arena_store_or_dead(a)
    return ArenaKeyIter {
        arena: a,
        occupied: store.occupied,
        generations: store.generations,
        n: store.occupied.len,
        i: 0,
    }
}

@inline
fn next<T>(it: ArenaKeyIter<T>) -> (bool, Entity<T>) {
    let i = it.i
    if i >= it.n { return (false, phantom()) }
    while !it.occupied[i] {
        i = i + 1
        if i >= it.n { it.i = i; return (false, phantom()) }
    }
    it.i = i + 1
    return (true, Entity {
        _scene_id: it.arena._scene_id,
        _arena_id: it.arena._arena_id,
        _slot: i,
        _generation: it.generations[i],
    })
}

@inline
fn iter<T>(a: Arena<T>) -> ArenaPairIter<T> {
    return pairs(a)
}
