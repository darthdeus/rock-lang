struct ArenaStore<T> {
    _owner_scene_id: int,
    generations: [int],
    occupied: [bool],
    @identity_storage
    data: [T],
    free_indices: [int],
    occupied_count: int = 0,
    next_generation: int = 0,
}

value ArenaGenerationSnapshot {
    generations: [int],
    free_indices: [int],
    next_generation: int,
}

struct ArenaRegistry {
    stores: Map<int, any>,
    next_id: int,
    process_root: int,
    live_count: int,
    retired_since_compact: int,
}

global __ARENA_REGISTRY: ArenaRegistry = ArenaRegistry {
    stores: map_new(), next_id: 0, process_root: 0,
    live_count: 0, retired_since_compact: 0,
}

// The registry holds each store erased, since one map spans every row type. An
// `ArenaStore<T>` is an identity, and identities never coerce to ordinary
// `any`; this is the Arena's only erasure (`@identity_erasure`).
// `cast` recovers the type; neither side
// does anything at runtime.
@identity_erasure @inline
fn __arena_store_erased<T>(store: ArenaStore<T>) -> any { return store }

@inline @nomangle fn __arena_store_any(scene_id: int, arena_id: int) -> any? {
    let store = __ARENA_REGISTRY.stores.get(arena_id) ?? return null
    let owner: ArenaStore<int> = cast(store)
    if owner._owner_scene_id != scene_id { return null }
    return store
}

fn __arena_store<T>(arena: Arena<T>) -> ArenaStore<T>? {
    let boxed = __arena_store_any(arena._scene_id, arena._arena_id)
    if is_null(boxed) { return null }
    let store: ArenaStore<T> = cast(boxed.unwrap())
    return store
}

fn __arena_store_mut<T>(arena: Arena<T>) -> ArenaStore<T> {
    let store = __arena_store(arena)
    if store == null {
        error("Arena {arena._arena_id} is not live (destroyed, or its scene was unloaded)")
    }
    return store.unwrap()
}

global __ARENA_DEAD_STORE: ArenaStore<int> = ArenaStore {
    _owner_scene_id: -1,
    generations: [], occupied: [], data: [], free_indices: [],
    occupied_count: 0, next_generation: 0,
}

fn __arena_store_or_dead<T>(arena: Arena<T>) -> ArenaStore<T> {
    let found = __arena_store(arena)
    if found == null {
        let dead: ArenaStore<T> = cast(__arena_store_erased(__ARENA_DEAD_STORE))
        return dead
    }
    return found
}

@nomangle fn __arena_store_or_empty(scene_id: int, arena_id: int) -> any {
    let boxed = __arena_store_any(scene_id, arena_id)
    if is_null(boxed) { return __arena_store_erased(__ARENA_DEAD_STORE) }
    return boxed.unwrap()
}

fn arena_new<T>() -> Arena<T> {
    return __arena_new_owned(__ARENA_REGISTRY.process_root)
}

fn __arena_new_owned<T>(scene_id: int) -> Arena<T> {
    let id = __ARENA_REGISTRY.next_id
    __ARENA_REGISTRY.next_id = id + 1
    let store: ArenaStore<T> = ArenaStore {
        _owner_scene_id: scene_id,
        generations: [], occupied: [], data: [], free_indices: [],
        occupied_count: 0, next_generation: 0,
    }
    __ARENA_REGISTRY.stores.insert(id, __arena_store_erased(store))
    __ARENA_REGISTRY.live_count += 1
    return Arena { _scene_id: scene_id, _arena_id: id }
}

fn __arena_reinitialize<T>(arena: Arena<T>) {
    __weak_cache_retire(arena._scene_id, arena._arena_id, -1)
    assert(!is_null(__arena_store_any(arena._scene_id, arena._arena_id)),
        "Arena {arena._arena_id} is not live")
    let store: ArenaStore<T> = ArenaStore {
        _owner_scene_id: arena._scene_id,
        generations: [], occupied: [], data: [], free_indices: [],
        occupied_count: 0, next_generation: 0,
    }
    __ARENA_REGISTRY.stores.insert(arena._arena_id, __arena_store_erased(store))
}

fn arena_destroy<T>(arena: Arena<T>) -> bool {
    return __arena_destroy_id(arena._scene_id, arena._arena_id)
}

fn __arena_drain_retired() {}

fn __arena_compact_retired_registry() {
    if __ARENA_REGISTRY.live_count == 0 {
        __ARENA_REGISTRY.stores = map_new()
        __ARENA_REGISTRY.retired_since_compact = 0
        return
    }

    let threshold = __ARENA_REGISTRY.live_count + 32
    if __ARENA_REGISTRY.retired_since_compact <= threshold { return }

    let compacted: Map<int, any> = map_new()
    for (id, store) in __ARENA_REGISTRY.stores {
        compacted.insert(id, store)
    }
    __ARENA_REGISTRY.stores = compacted
    __ARENA_REGISTRY.retired_since_compact = 0
}

fn __arena_destroy_id(scene_id: int, arena_id: int) -> bool {
    if is_null(__arena_store_any(scene_id, arena_id)) { return false }
    __weak_cache_retire(scene_id, arena_id, -1)
    __ARENA_REGISTRY.stores.remove(arena_id)
    __ARENA_REGISTRY.live_count -= 1
    __ARENA_REGISTRY.retired_since_compact += 1
    __arena_compact_retired_registry()
    return true
}

fn entity_new<T>(arena: Arena<T>, slot: int, generation: int) -> Entity<T> {
    assert(slot >= 0, "entity_new::Entity slot is invalid")
    assert(generation >= 0, "Entity generation is invalid")

    return Entity {
        _scene_id: arena._scene_id,
        _arena_id: arena._arena_id,
        _slot: slot,
        _generation: generation,
    }
}

fn __entity_arena<T>(entity: Entity<T>) -> Arena<T> {
    return Arena { _scene_id: entity._scene_id, _arena_id: entity._arena_id }
}

// Resolved here rather than through `get(__entity_arena(entity), entity)`.
// The arena that walk builds is the entity's OWN, so `__arena_owns` compares a
// pair of fields with themselves and `__arena_store`'s cast is already a
// runtime no-op: four inlined frames whose only job is to be true. Dropping
// them leaves the two oracles that decide the answer -- the registry lookup
// and the generation test -- reached from one frame instead of five.
//
// It is not spelled this way for elegance. LuaJIT charges a trace two IR
// constants per distinct global name plus one per inlined function object, and
// `Entity.get` is inlined into every trace that reads an entity; the four
// frames cost 12 of the 500-constant budget and one of the 15 tail-call unroll
// slots there. Text traces reach their glyph loop with both nearly spent
//
fn Entity<T>.get(entity) -> T? {
    let boxed = __arena_store_any(entity._scene_id, entity._arena_id) ?? return null
    let store: ArenaStore<T> = cast(boxed)
    if !arena_slot_live(store, entity._slot, entity._generation) { return null }
    return cast(__vec_data_get(store.data, entity._slot))
}

@intrinsic @native_required inline(lua)
fn Entity<T>.storage(entity) -> Storage = """
    return nil
"""

fn Entity<T>.borrow(entity) -> (ref T)? { return borrow(__entity_arena(entity), entity) }

fn Entity<T>.remove(entity) -> T? { return remove(__entity_arena(entity), entity) }

fn Entity<T>.equals(a, b: Entity<T>) -> bool {
    return a._scene_id == b._scene_id
        && a._arena_id == b._arena_id
        && a._slot == b._slot
        && a._generation == b._generation
}

fn entity_key<T>(entity: Entity<T>) -> string {
    return "{entity._scene_id}:{entity._arena_id}:{entity._slot}:{entity._generation}"
}

// Whether `slot` names a live row matching `generation`. The single liveness
// test every op shares, inlined into every trace that reads a row, so it
// carries no guard the answer does not need (ledger B2a, ENTITY READ TRACE
// COST): a vacant slot's complemented generation never equals an issued one, so
// occupancy needs no load of its own. There is no range check: the columns only
// grow one slot at a time through `__slot_alloc` and `clear` replaces them, so
// they hold no element outside `[0, len)` and an out-of-range slot reads as
// absent (nil), which equals no generation. The three columns always have one
// length, so a live slot is in range for `data` too.
@inline
fn arena_slot_live<T>(store: ArenaStore<T>, slot: int, generation: int) -> bool {
    let current: int = cast(__vec_data_get(store.generations, slot))
    return current == generation
}

fn __arena_owns<T>(arena: Arena<T>, entity: Entity<T>) -> bool {
    return arena._scene_id == entity._scene_id && arena._arena_id == entity._arena_id
}

fn Arena<T>.insert(arena, value: T) -> Entity<T> {
    let store = __arena_store_mut(arena)
    let generation = store.next_generation
    store.next_generation = generation + 1

    let slot = __slot_alloc(__arena_store_erased(store), store.occupied)
    if slot == vec_len(store.generations) {
        vec_push(store.generations, generation)
        vec_push(store.data, value)
    } else {
        store.generations.set(slot, generation)
        store.data.set(slot, value)
    }
    store.occupied.set(slot, true)

    return entity_new(arena, slot, generation)
}

fn Arena<T>.reuse_retained_entity(arena) -> Entity<T>? {
    let store = __arena_store_mut(arena)
    if store.free_indices.len() == 0 { return null }

    let generation = store.next_generation
    store.next_generation = generation + 1
    let slot = __slot_alloc(__arena_store_erased(store), store.occupied)
    assert(slot < vec_len(store.data), "Arena retained slot is outside its data column")
    store.generations.set(slot, generation)
    store.occupied.set(slot, true)
    return entity_new(arena, slot, generation)
}

fn Arena<T>.reuse_retained(arena) -> T? {
    let entity = arena.reuse_retained_entity() ?? return null
    return entity.get()
}

fn Arena<T>.get(arena, entity: Entity<T>) -> T? {
    if !__arena_owns(arena, entity) { return null }
    return entity.get()
}

@frame_ref_source
fn Arena<T>.borrow(arena, entity: Entity<T>) -> (ref T)? {
    if !__arena_owns(arena, entity) { return null }
    let found = __arena_store(arena)
    if found == null { return null }
    let store = found
    if !arena_slot_live(store, entity._slot, entity._generation) { return null }
    return store.data[entity._slot]
}

fn Arena<T>.contains(arena, entity: Entity<T>) -> bool {
    if !__arena_owns(arena, entity) { return false }
    let found = __arena_store(arena)
    if found == null { return false }
    return arena_slot_live(found, entity._slot, entity._generation)
}

fn Arena<T>.remove(arena, entity: Entity<T>) -> T? {
    if !__arena_owns(arena, entity) { return null }
    let found = __arena_store(arena)
    if found == null { return null }
    let store = found
    let slot = entity._slot
    if !arena_slot_live(store, slot, entity._generation) { return null }
    __weak_cache_retire(entity._scene_id, entity._arena_id, slot)
    store.occupied.set(slot, false)
    store.generations.set(slot, -1 - entity._generation)
    __slot_release(__arena_store_erased(store), slot)
    return store.data[slot]
}

fn Arena<T>.len(arena) -> int {
    let found = __arena_store(arena)
    if found == null { return 0 }
    return found.occupied_count
}

fn arena_live_count() -> int {
    return __ARENA_REGISTRY.live_count
}

fn arena_registry_storage_bound() -> int {
    return __ARENA_REGISTRY.live_count + __ARENA_REGISTRY.retired_since_compact
}

fn arena_slot_count<T>(arena: Arena<T>) -> int {
    let found = __arena_store(arena)
    if found == null { return 0 }
    return vec_len(found.occupied)
}

fn Arena<T>.clear(arena) {
    let store = __arena_store_mut(arena)
    __weak_cache_retire(arena._scene_id, arena._arena_id, -1)
    store.generations = []
    store.occupied = []
    store.data = []
    store.free_indices = []
    store.occupied_count = 0
}

fn Arena<T>.random(arena) -> (Entity<T>, T)? {
    let found = __arena_store(arena)
    if found == null { return null }
    let store = found
    let len = store.occupied_count
    if len == 0 { return null }

    let random_index = random_int(0, len)
    let current_count = 0
    let slots = vec_len(store.occupied)

    for i in 0..slots {
        if store.occupied[i] {
            if current_count == random_index {
                return (entity_new(arena, i, store.generations[i]), store.data[i])
            }
            current_count += 1
        }
    }

    return null
}

// Arena iteration -- two modes, both `Iterator<..>`-conformant so they compose
// with the combinators + terminals. `values()` yields `T`; `pairs()` yields a
// `(Entity<T>, T)` tuple ELEMENT (2-tuple `next`, not multi-value -- a bound
// cannot wrap an unknown-arity splat). Bare `for (e, v) in arena` desugars
// through `iter(arena)` = pairs mode; the per-iteration pair tuple (and the
// Entity, when unused) scalarizes away at codegen (tuple SROA,
// `crates/skull/tests/tuple_scalarize.rs`). Both keep the FETCH-OUTSIDE skip-loop
// shape (one candidate fetched before the while; the loop body runs only on a
// dead slot) -- the naive fetch-inside shape blacklists to the interpreter at
// light fragmentation. entries/len snapshot once per loop (mutation mid-iteration beyond
//
// removing the current element is recorded UB).
//
// Backing resolves ONCE, at construction: Scene ownership must not put a
// registry lookup in front of every row. A retired handle yields an iterator
// over an empty column rather than an error, matching `len() == 0`.
//
// Each iterator snapshots only the columns it yields from: `values()` never
// touches generations, `keys()` never touches data. The `data` snapshot is
// the store's own row column, so it is an `@identity_storage` edge like
// `ArenaStore.data`.

@consume struct ArenaValIter<T> {
    occupied: [bool],
    @identity_storage
    data: [T],
    n: int,
    i: int,
}

@inline
fn values<T>(a: Arena<T>) -> ArenaValIter<T> {
    let store = __arena_store_or_dead(a)
    return ArenaValIter { occupied: store.occupied, data: store.data, n: store.occupied.len, i: 0 }
}

@inline
fn next<T>(it: ArenaValIter<T>) -> (bool, T) {
    let i = it.i
    if i >= it.n { return (false, phantom()) }
    while !it.occupied[i] {
        i = i + 1
        if i >= it.n { it.i = i; return (false, phantom()) }
    }
    it.i = i + 1
    return (true, it.data[i])
}

@consume struct ArenaPairIter<T> {
    arena: Arena<T>,
    occupied: [bool],
    generations: [int],
    @identity_storage
    data: [T],
    n: int,
    i: int,
}

@inline
fn pairs<T>(a: Arena<T>) -> ArenaPairIter<T> {
    let store = __arena_store_or_dead(a)
    return ArenaPairIter {
        arena: a,
        occupied: store.occupied,
        generations: store.generations,
        data: store.data,
        n: store.occupied.len,
        i: 0,
    }
}

@inline
fn next<T>(it: ArenaPairIter<T>) -> (bool, (Entity<T>, T)) {
    let i = it.i
    if i >= it.n { return (false, phantom()) }
    while !it.occupied[i] {
        i = i + 1
        if i >= it.n { it.i = i; return (false, phantom()) }
    }
    it.i = i + 1
    let e = Entity {
        _scene_id: it.arena._scene_id,
        _arena_id: it.arena._arena_id,
        _slot: i,
        _generation: it.generations[i],
    }
    return (true, (e, it.data[i]))
}

@consume struct ArenaKeyIter<T> {
    arena: Arena<T>,
    occupied: [bool],
    generations: [int],
    n: int,
    i: int,
}

@inline
fn keys<T>(a: Arena<T>) -> ArenaKeyIter<T> {
    let store = __arena_store_or_dead(a)
    return ArenaKeyIter {
        arena: a,
        occupied: store.occupied,
        generations: store.generations,
        n: store.occupied.len,
        i: 0,
    }
}

@inline
fn next<T>(it: ArenaKeyIter<T>) -> (bool, Entity<T>) {
    let i = it.i
    if i >= it.n { return (false, phantom()) }
    while !it.occupied[i] {
        i = i + 1
        if i >= it.n { it.i = i; return (false, phantom()) }
    }
    it.i = i + 1
    return (true, Entity {
        _scene_id: it.arena._scene_id,
        _arena_id: it.arena._arena_id,
        _slot: i,
        _generation: it.generations[i],
    })
}

@inline
fn iter<T>(a: Arena<T>) -> ArenaPairIter<T> {
    return pairs(a)
}
