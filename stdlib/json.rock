enum JsonValue {
    Null,
    True,
    False,
    Int(int),
    Float(float),
    Str(string),
    Array([JsonValue]),
    Object(Map<string, JsonValue>),
    // JSON text written verbatim by the encoders, such as json_record_write
    // output placed into a larger document. It is never parsed back into a tree.
    Raw(string),
}

fn json_null() -> JsonValue { return JsonValue::Null }
@nomangle fn json_bool(b: bool) -> JsonValue { return if b { JsonValue::True } else { JsonValue::False } }
fn json_int(i: int) -> JsonValue { return JsonValue::Int(i) }
fn json_float(f: float) -> JsonValue { return JsonValue::Float(f) }
fn json_str(s: string) -> JsonValue { return JsonValue::Str(s) }
fn json_array(items: [JsonValue]) -> JsonValue { return JsonValue::Array(items) }
fn json_object(m: Map<string, JsonValue>) -> JsonValue { return JsonValue::Object(m) }
fn json_raw(text: string) -> JsonValue { return JsonValue::Raw(text) }

fn json_is_null(v: JsonValue) -> bool {
    match v {
        Null => return true,
        _ => return false,
    }
}

fn json_as_bool(v: JsonValue) -> bool? {
    match v {
        True => return true,
        False => return false,
        _ => return null,
    }
}

fn json_as_int(v: JsonValue) -> int? {
    match v {
        Int(i) => return i,
        Float(f) => return f as int,
        _ => return null,
    }
}

fn json_as_float(v: JsonValue) -> float? {
    match v {
        Int(i) => return i as float,
        Float(f) => return f,
        _ => return null,
    }
}

fn json_as_str(v: JsonValue) -> string? {
    match v {
        Str(s) => return s,
        _ => return null,
    }
}

fn json_as_array(v: JsonValue) -> [JsonValue]? {
    match v {
        Array(items) => return items,
        _ => return null,
    }
}

fn json_as_object(v: JsonValue) -> Map<string, JsonValue>? {
    match v {
        Object(m) => return m,
        _ => return null,
    }
}

fn json_field(v: JsonValue, key: string) -> JsonValue? {
    let m = json_as_object(v)
    if m == null { return null }
    let mm = m
    if !mm.contains(key) { return null }
    return mm[key]
}

fn json_encode(v: JsonValue) -> string {
    if let scalar = encode_scalar(v) { return scalar }
    let parts = sb_new()
    encode_container(v, parts)
    return sb_build(parts)
}

fn encode_scalar(v: JsonValue) -> string? {
    return match v {
        Null => "null",
        True => "true",
        False => "false",
        Int(i) => json_int_text(i),
        Float(f) => format_float(f),
        Str(s) => encode_string(s),
        Raw(text) => text,
        _ => null,
    }
}

@nomangle fn json_int_text(i: int) -> string {
    return if i > -100000000000000 && i < 100000000000000 { "{i}" } else { "{i:d}" }
}

fn encode_into(v: JsonValue, parts: StringBuilder) {
    if let scalar = encode_scalar(v) {
        sb_push(parts, scalar)
    } else {
        encode_container(v, parts)
    }
}

fn encode_container(v: JsonValue, parts: StringBuilder) {
    match v {
        Array(items) => encode_array(items, parts),
        Object(m) => encode_object(m, parts),
        _ => {},
    }
}

fn encode_array(items: [JsonValue], parts: StringBuilder) {
    sb_push(parts, "[")
    for i in 0..items.len {
        if i > 0 { sb_push(parts, ",") }
        encode_into(items[i], parts)
    }
    sb_push(parts, "]")
}

fn encode_object(m: Map<string, JsonValue>, parts: StringBuilder) {
    let keys = keys(m)
    sb_push(parts, "{{")
    let first = true
    for k in keys {
        if !first { sb_push(parts, ",") }
        first = false
        sb_push(parts, encode_string(k))
        sb_push(parts, ":")
        encode_into(m[k], parts)
    }
    sb_push(parts, "}}")
}

fn json_encode_pretty(v: JsonValue, compact_items_of: [string] = []) -> string {
    if let scalar = encode_scalar(v) { return scalar }
    let parts = sb_new()
    encode_pretty_into(v, parts, 0, compact_items_of)
    return sb_build(parts)
}

fn encode_pretty_into(v: JsonValue, parts: StringBuilder, level: int, compact_items_of: [string],
                      compact_items: bool = false) {
    match v {
        Array(items) => {
            if json_has_nested_container(v) {
                encode_pretty_array(items, parts, level, compact_items_of, compact_items)
            } else {
                encode_array(items, parts)
            }
        },
        Object(m) => {
            if json_has_nested_container(v) {
                encode_pretty_object(m, parts, level, compact_items_of)
            } else {
                encode_object(m, parts)
            }
        },
        _ => encode_into(v, parts),
    }
}

@inline fn json_is_container(value: JsonValue) -> bool {
    return match value { Array(_) => true, Object(_) => true, _ => false }
}

fn json_has_nested_container(v: JsonValue) -> bool {
    return match v {
        Array(items) => {
            for i in 0..items.len {
                if json_is_container(items[i]) { return true }
            }
            false
        },
        Object(m) => {
            for (_, child) in m {
                match child {
                    Array(_) => return true,
                    Object(_) => return true,
                    _ => {}
                }
            }
            false
        },
        _ => false,
    }
}

fn encode_pretty_array(items: [JsonValue], parts: StringBuilder, level: int,
                       compact_items_of: [string], compact_items: bool) {
    sb_push(parts, "[\n")
    let inner = json_indent(level + 1)
    for i in 0..items.len {
        if i > 0 { sb_push(parts, ",\n") }
        sb_push(parts, inner)
        if compact_items {
            encode_into(items[i], parts)
        } else {
            encode_pretty_into(items[i], parts, level + 1, compact_items_of)
        }
    }
    sb_push(parts, "\n")
    sb_push(parts, json_indent(level))
    sb_push(parts, "]")
}

fn encode_pretty_object(m: Map<string, JsonValue>, parts: StringBuilder, level: int,
                        compact_items_of: [string]) {
    let ks = keys(m)
    sb_push(parts, "{{\n")
    let inner = json_indent(level + 1)
    let first = true
    for k in ks {
        if !first { sb_push(parts, ",\n") }
        first = false
        sb_push(parts, inner)
        sb_push(parts, encode_string(k))
        sb_push(parts, ": ")
        encode_pretty_into(m[k], parts, level + 1, compact_items_of, json_key_listed(compact_items_of, k))
    }
    sb_push(parts, "\n")
    sb_push(parts, json_indent(level))
    sb_push(parts, "}}")
}

fn json_key_listed(keys: [string], key: string) -> bool {
    for k in keys {
        if k == key { return true }
    }
    return false
}

fn json_indent(level: int) -> string {
    return "  ".repeat(level)
}

fn encode_string(s: string) -> string {
    let n = s.len()
    let i = 0
    while i < n {
        let b = s.unit_at(i)
        if b < 32 || b == 34 || b == 92 { break }
        i += 1
    }
    if i == n { return "\"" + s + "\"" }
    let parts: [string] = ["\""]
    json_escape_into(s, parts)
    parts.push("\"")
    return join(parts, "")
}

fn json_escape_into(s: string, parts: [string]) {
    let start = 0
    let index = 0
    while index < s.len() {
        let unit = s.unit_at(index)
        if unit < 32 || unit == 34 || unit == 92 {
            if start < index { parts.push(s.substring(start, index)) }
            if unit == 34 { parts.push("\\\"") }
            else if unit == 92 { parts.push("\\\\") }
            else if unit == 8 { parts.push("\\b") }
            else if unit == 9 { parts.push("\\t") }
            else if unit == 10 { parts.push("\\n") }
            else if unit == 12 { parts.push("\\f") }
            else if unit == 13 { parts.push("\\r") }
            else { parts.push("\\u" + hex4(unit)) }
            start = index + 1
        }
        index += 1
    }
    if start == 0 {
        if s.len() > 0 { parts.push(s) }
    } else if start < s.len() { parts.push(s.substring(start, s.len())) }
}

fn hex4(n: int) -> string {
    let digits = "0123456789abcdef"
    let i0 = (n ./ 4096) % 16
    let i1 = (n ./ 256) % 16
    let i2 = (n ./ 16) % 16
    let i3 = n % 16
    let d0 = digits.substring(i0, i0 + 1)
    let d1 = digits.substring(i1, i1 + 1)
    let d2 = digits.substring(i2, i2 + 1)
    let d3 = digits.substring(i3, i3 + 1)
    return "{d0}{d1}{d2}{d3}"
}

fn format_float(f: float) -> string {
    if f != f { return "null" }
    if f == 1.0 / 0.0 || f == -1.0 / 0.0 { return "null" }
    // A fractional token keeps decoding off LuaJIT's narrowing integer path.
    if f == 0.0 && 1.0 / f < 0.0 { return "-0.0" }
    let i = f as int
    if (i as float) == f {
        let text = "{i}"
        // Large integers can lose digits through the backend's tostring.
        if (f > -1e14 && f < 1e14) || text.parse_float().unwrap() == f {
            return text
        }
    }
    return format_float_roundtrip(f)
}

struct JsonParser {
    src: string,
    pos: int,
    len: int,
    ok: bool,
    depth: int,
}

// Container nesting a document may reach before it is rejected as malformed.
// The decoder is recursive, so without this a deep document overflows the
// interpreter stack and takes the process down instead of returning null.
//
// Sized for the shallower backend, not the roomier one: measured, LuaJIT
// overflows near 4500 levels and the JS backend between 900 and 1000 -- and
// the JS figure is not a constant, it shrinks as the caller's own stack grows,
// so a limit set just under it would hold from main and fail from inside a
// game. 256 keeps ~3.7x margin against the shallowest observed ceiling while
// staying 50x above the deepest JSON in this repo, which is 5.
fn json_max_depth() -> int { return 256 }

fn json_decode(s: string) -> JsonValue? {
    let p = JsonParser { src: s, pos: 0, len: s.len(), ok: true, depth: 0 }
    parse_skip_ws(p)
    let v = parse_value(p)
    parse_skip_ws(p)
    if !p.ok { return null }
    if p.pos != p.len { return null }
    return v
}

// Inlined at typed readers so the whitespace loop's function entry is not
// blacklisted; the graph parser keeps its call boundary.
@inline fn parse_skip_ws_inline_at(src: string, at: int) -> int {
    let pos = at
    let len = src.len()
    while pos < len {
        let b = src.unit_at(pos)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            pos = pos + 1
        } else {
            break
        }
    }
    return pos
}

fn parse_skip_ws_at(src: string, at: int) -> int {
    return parse_skip_ws_inline_at(src, at)
}

@inline fn parse_skip_ws(p: JsonParser) {
    p.pos = parse_skip_ws_at(p.src, p.pos)
}

fn parse_value(p: JsonParser) -> JsonValue {
    parse_skip_ws(p)
    if p.pos >= p.len {
        p.ok = false
        return JsonValue::Null
    }
    let b = p.src.unit_at(p.pos)
    if b == 110 && parse_keyword(p, "null") { return JsonValue::Null }
    if b == 116 && parse_keyword(p, "true") { return JsonValue::True }
    if b == 102 && parse_keyword(p, "false") { return JsonValue::False }
    if b == 34 { return parse_string_value(p) }
    if b == 91 || b == 123 {
        p.depth = p.depth + 1
        if p.depth > json_max_depth() {
            p.ok = false
            return JsonValue::Null
        }
        let v = if b == 91 { parse_array_value(p) } else { parse_object_value(p) }
        p.depth = p.depth - 1
        return v
    }
    if b == 45 || (b >= 48 && b <= 57) {
        return parse_number(p)
    }
    p.ok = false
    return JsonValue::Null
}

fn parse_keyword(p: JsonParser, kw: string) -> bool {
    let start = p.pos
    let end = start + kw.len()
    if end > p.len { return false }
    for i in 0..kw.len() {
        if p.src.unit_at(start + i) != kw.unit_at(i) { return false }
    }
    p.pos = end
    return true
}

fn parse_string_value(p: JsonParser) -> JsonValue {
    let s = parse_string_raw(p)
    if s == null { return JsonValue::Null }
    return JsonValue::Str(s)
}

fn parse_string_raw_at(src: string, at: int, materialize: bool = true) -> (string?, int) {
    let pos = at
    let len = src.len()
    if src.unit_at(pos) != 34 { return (null, pos) }
    pos += 1

    let segment_start = pos
    let first_end = pos
    let first_escape: string? = null
    let parts: StringBuilder? = null
    while pos < len {
        let b = src.unit_at(pos)
        if b == 34 {
            if !materialize { return ("", pos + 1) }
            let tail = src.substring(segment_start, pos)
            if parts != null {
                sb_push(parts, tail)
                return (sb_build(parts), pos + 1)
            }
            if first_escape == null { return (tail, pos + 1) }
            return (src.substring(at + 1, first_end) + first_escape + tail, pos + 1)
        }
        if b == 92 {
            let segment_end = pos
            pos += 1
            if pos >= len { return (null, pos) }
            let esc = src.unit_at(pos)
            pos += 1
            let text = match esc {
                34 => "\"",
                92 => "\\",
                47 => "/",
                110 => "\n",
                114 => "\r",
                116 => "\t",
                98 => "\u{8}",
                102 => "\u{c}",
                117 => {
                    if pos + 4 > len { return (null, pos) }
                    let cp = parse_hex4_at(src, pos) ?? return (null, pos + 4)
                    pos += 4
                    if cp >= 0xD800 && cp <= 0xDBFF {
                        if pos + 6 > len || src.unit_at(pos) != 92 || src.unit_at(pos + 1) != 117 {
                            return (null, pos)
                        }
                        let lo = parse_hex4_at(src, pos + 2) ?? return (null, pos)
                        if lo < 0xDC00 || lo > 0xDFFF { return (null, pos) }
                        pos += 6
                        cp = 0x10000 + (cp - 0xD800) * 0x400 + (lo - 0xDC00)
                    } else if cp >= 0xDC00 && cp <= 0xDFFF {
                        return (null, pos)
                    }
                    if materialize { from_codepoint(cp) } else { "" }
                }
                _ => null,
            }
            if text == null { return (null, pos) }
            if materialize {
                if first_escape == null {
                    first_end = segment_end
                    first_escape = text
                } else {
                    let buffer = if parts != null { parts } else {
                        let fresh = sb_new()
                        sb_push(fresh, src.substring(at + 1, first_end))
                        sb_push(fresh, first_escape)
                        parts = fresh
                        fresh
                    }
                    if segment_end > segment_start { sb_push(buffer, src.substring(segment_start, segment_end)) }
                    sb_push(buffer, text)
                }
            }
            segment_start = pos
        } else if b < 32 {
            return (null, pos)
        } else {
            pos = pos + 1
        }
    }
    return (null, pos)
}

@inline fn parse_string_raw(p: JsonParser) -> string? {
    let (value, pos) = parse_string_raw_at(p.src, p.pos)
    p.pos = pos
    if value == null { p.ok = false }
    return value
}

fn parse_hex4_at(s: string, at: int) -> int? {
    let result = 0
    let i = 0
    while i < 4 {
        let b = s.unit_at(at + i)
        let d = 0
        if b >= 48 && b <= 57 {
            d = b - 48
        } else if b >= 97 && b <= 102 {
            d = b - 97 + 10
        } else if b >= 65 && b <= 70 {
            d = b - 65 + 10
        } else {
            return null
        }
        result = result * 16 + d
        i = i + 1
    }
    return result
}

@inline fn parse_digits_at(src: string, at: int, len: int) -> int {
    let end = at
    for pos in at..len {
        let b = src.unit_at(pos)
        if b < 48 || b > 57 { break }
        end = pos + 1
    }
    return end
}

@inline fn parse_number_scan_at(src: string, at: int) -> (int, bool, bool) {
    let pos = at
    let len = src.len()
    // The grammar `[-] int [frac] [exp]` is enforced here, not by parse_float:
    // Lua's tonumber accepts `2.e3`, `.5` and `01`.
    let is_float = false
    if pos < len && src.unit_at(pos) == 45 {
        pos = pos + 1
    }

    if pos >= len {
        return (pos, is_float, false)
    }
    let lead = src.unit_at(pos)
    if lead == 48 {
        pos = pos + 1
    } else if lead >= 49 && lead <= 57 {
        pos = parse_digits_at(src, pos, len)
    } else {
        return (pos, is_float, false)
    }

    if pos < len && src.unit_at(pos) == 46 {
        is_float = true
        pos = pos + 1
        let frac_start = pos
        pos = parse_digits_at(src, pos, len)
        if pos == frac_start {
            return (pos, is_float, false)
        }
    }

    if pos < len {
        let b = src.unit_at(pos)
        if b == 101 || b == 69 {
            is_float = true
            pos = pos + 1
            if pos < len {
                let sign = src.unit_at(pos)
                if sign == 43 || sign == 45 {
                    pos = pos + 1
                }
            }
            let exp_start = pos
            pos = parse_digits_at(src, pos, len)
            if pos == exp_start {
                return (pos, is_float, false)
            }
        }
    }

    return (pos, is_float, true)
}

@inline fn parse_number_scan(p: JsonParser) -> bool? {
    let (pos, is_float, ok) = parse_number_scan_at(p.src, p.pos)
    p.pos = pos
    if !ok { p.ok = false; return null }
    return is_float
}

fn parse_number(p: JsonParser) -> JsonValue {
    let start = p.pos
    let is_float = parse_number_scan(p) ?? return JsonValue::Null
    if is_float { return JsonValue::Float(p.src.parse_float_at(start, p.pos)) }
    let i = p.src.substring(start, p.pos).parse_int()
    if i == null { p.ok = false; return JsonValue::Null }
    return JsonValue::Int(i)
}

fn parse_array_value(p: JsonParser) -> JsonValue {
    p.pos = p.pos + 1   // consume [
    let items: [JsonValue] = []
    parse_skip_ws(p)
    if p.pos < p.len && p.src.unit_at(p.pos) == 93 {
        p.pos = p.pos + 1
        return JsonValue::Array(items)
    }
    while p.pos < p.len {
        parse_skip_ws(p)
        let item = parse_value(p)
        if !p.ok { return JsonValue::Null }
        items.push(item)
        parse_skip_ws(p)
        if p.pos >= p.len {
            p.ok = false
            return JsonValue::Null
        }
        let b = p.src.unit_at(p.pos)
        if b == 93 {
            p.pos = p.pos + 1
            return JsonValue::Array(items)
        }
        if b != 44 {
            p.ok = false
            return JsonValue::Null
        }
        p.pos = p.pos + 1
    }
    p.ok = false
    return JsonValue::Null
}

fn parse_object_value(p: JsonParser) -> JsonValue {
    p.pos = p.pos + 1   // consume {
    let m: Map<string, JsonValue> = map_new()
    parse_skip_ws(p)
    if p.pos < p.len && p.src.unit_at(p.pos) == 125 {
        p.pos = p.pos + 1
        return JsonValue::Object(m)
    }
    while p.pos < p.len {
        parse_skip_ws(p)
        let key = parse_string_raw(p)
        if key == null { return JsonValue::Null }
        parse_skip_ws(p)
        if p.pos >= p.len || p.src.unit_at(p.pos) != 58 {
            p.ok = false
            return JsonValue::Null
        }
        p.pos = p.pos + 1
        parse_skip_ws(p)
        let val = parse_value(p)
        if !p.ok { return JsonValue::Null }
        insert(m, key, val)
        parse_skip_ws(p)
        if p.pos >= p.len {
            p.ok = false
            return JsonValue::Null
        }
        let b = p.src.unit_at(p.pos)
        if b == 125 {
            p.pos = p.pos + 1
            return JsonValue::Object(m)
        }
        if b != 44 {
            p.ok = false
            return JsonValue::Null
        }
        p.pos = p.pos + 1
    }
    p.ok = false
    return JsonValue::Null
}

fn jv_str(v: JsonValue?, default_val: string) -> string {
    let vv = v ?? return default_val
    return json_as_str(vv) ?? default_val
}

fn jv_int(v: JsonValue?, default_val: int) -> int {
    let vv = v ?? return default_val
    let f = json_as_float(vv) ?? return default_val
    return int(f)
}

fn jv_float(v: JsonValue?, default_val: float) -> float {
    let vv = v ?? return default_val
    return json_as_float(vv) ?? default_val
}

fn jv_bool(v: JsonValue?, default_val: bool) -> bool {
    let vv = v ?? return default_val
    return json_as_bool(vv) ?? default_val
}

fn jv_float_arr(v: JsonValue?, default_val: [float]) -> [float] {
    let vv = v ?? return default_val
    let arr = json_as_array(vv) ?? return default_val
    let out: [float] = []
    for e in arr {
        if let f = json_as_float(e) { out.push(f) }
    }
    if out.len() == 0 { return default_val }
    return out
}

nobox value JsonReader {
    src: string? = null,
    at: int = -1,
    value: JsonValue? = null,
    offsets: Map<int, JsonReaderOffsets>? = null,
}

nobox value JsonReaderOffsets {
    fields: Map<string, int>? = null,
    end: int = -1,
}

value JsonReaderArray {
    reader: JsonReader,
    values: [JsonValue]? = null,
    first: int = -1,
}

@consume struct JsonReaderArrayIter {
    array: JsonReaderArray,
    pos: int,
    index: int = 0,
}

struct JsonReaderPath {
    keys: [string] = [],
    indices: [int] = [],
    next_indices: [int] = [],
}

struct JsonReaderValidation {
    path: JsonReaderPath? = null,
    problem: string = "invalid JSON",
    root_fields: Map<string, int> = map_new(),
    index_min_bytes: int = 0,
    offsets: Map<int, JsonReaderOffsets> = map_new(),
}

@inline fn json_reader_value(value: JsonValue) -> JsonReader { return JsonReader { value } }
@inline fn json_reader_null() -> JsonReader { return JsonReader {} }
@inline fn json_reader_int(value: int) -> JsonReader { return json_reader_value(json_int(value)) }
@inline fn json_reader_empty_array() -> JsonReaderArray { return JsonReaderArray { reader: json_reader_null() } }

fn json_reader_error_path(validation: JsonReaderValidation) -> string {
    let tracked = validation.path ?? return "$"
    let path = "$"
    for i in 0..tracked.keys.len() {
        if tracked.indices[i] >= 0 { path += "[{tracked.indices[i]}]" }
        else { path += "[" + encode_string(tracked.keys[i]) + "]" }
    }
    return path
}

fn json_reader_close_container(validation: JsonReaderValidation, start: int, end: int) {
    if validation.index_min_bytes > 0 && end - start >= validation.index_min_bytes {
        validation.offsets[start] = JsonReaderOffsets { end }
    }
}

fn json_reader_validate(src: string, at: int, validation: JsonReaderValidation) -> (int, bool) {
    let pos = at
    let len = src.len()
    let depth = 0
    let starts: [int] = []
    let path = validation.path
    // 0: value or empty array, 1: separator, 2: key or empty object,
    // 3: key after comma, 4: value after comma.
    let state = 0
    let kind = 0
    while true {
        if state == 1 {
            if path != null && path.keys.len() == depth && depth > 0 {
                let _ = path.keys.pop()
                let _ = path.indices.pop()
            }
            if depth == 0 { return (pos, true) }
        }
        pos = parse_skip_ws_inline_at(src, pos)
        if pos >= len { return (pos, false) }
        let b = src.unit_at(pos)
        if state == 1 {
            if b == 44 {
                pos += 1
                state = if kind == 91 { 4 } else { 3 }
                continue
            }
            if b != (if kind == 91 { 93 } else { 125 }) { return (pos, false) }
            let start = starts.pop().unwrap()
            if path != null { let _ = path.next_indices.pop() }
            pos += 1
            depth -= 1
            json_reader_close_container(validation, start, pos)
            kind = if depth > 0 { src.unit_at(starts[depth - 1]) } else { 0 }
            continue
        }
        if state == 2 || state == 3 {
            if state == 2 && b == 125 {
                let start = starts.pop().unwrap()
                if path != null { let _ = path.next_indices.pop() }
                pos += 1
                depth -= 1
                json_reader_close_container(validation, start, pos)
                kind = if depth > 0 { src.unit_at(starts[depth - 1]) } else { 0 }
                state = 1
                continue
            }
            let (value, end) = parse_string_raw_at(src, pos, depth == 1 || path != null)
            pos = end
            let key = value ?? return (pos, false)
            pos = parse_skip_ws_inline_at(src, pos)
            if pos >= len || src.unit_at(pos) != 58 { return (pos, false) }
            pos = parse_skip_ws_inline_at(src, pos + 1)
            if depth == 1 { validation.root_fields[key] = pos }
            if path != null {
                path.keys.push(key)
                path.indices.push(-1)
            }
            state = 0
            continue
        }
        if kind == 91 {
            if state == 0 && b == 93 {
                let start = starts.pop().unwrap()
                if path != null { let _ = path.next_indices.pop() }
                pos += 1
                depth -= 1
                json_reader_close_container(validation, start, pos)
                kind = if depth > 0 { src.unit_at(starts[depth - 1]) } else { 0 }
                state = 1
                continue
            }
            if path != null {
                path.keys.push("")
                path.indices.push(path.next_indices[depth - 1])
                path.next_indices[depth - 1] += 1
            }
        }
        state = 1
        if b == 34 {
            let (value, end) = parse_string_raw_at(src, pos, false)
            pos = end
            if value == null { return (pos, false) }
            continue
        }
        if b == 110 || b == 116 || b == 102 {
            let keyword = if b == 110 { "null" } else if b == 116 { "true" } else { "false" }
            if pos + keyword.len() > len { return (pos, false) }
            for i in 0..keyword.len() {
                if src.unit_at(pos + i) != keyword.unit_at(i) { return (pos, false) }
            }
            pos += keyword.len()
            continue
        }
        if b == 45 || (b >= 48 && b <= 57) {
            let start = pos
            let (end, is_float, ok) = parse_number_scan_at(src, pos)
            pos = end
            if !ok { return (pos, false) }
            if !is_float && pos - start >= 19 && src.substring(start, pos).parse_int() == null { return (pos, false) }
            continue
        }
        if b != 91 && b != 123 { return (pos, false) }
        starts.push(pos)
        kind = b
        if path != null { path.next_indices.push(0) }
        depth += 1
        if depth > json_max_depth() { validation.problem = "maximum JSON depth exceeded"; return (pos, false) }
        pos += 1
        state = if b == 91 { 0 } else { 2 }
    }
    return (pos, false)
}

fn json_reader_decode(src: string, rejected: fn(string, int, string)? = null, index_min_bytes: int = 0) -> JsonReader? {
    let validation = JsonReaderValidation {
        path: if rejected != null { JsonReaderPath {} } else { null }, index_min_bytes,
    }
    let at = parse_skip_ws_inline_at(src, 0)
    let (end, ok) = json_reader_validate(src, at, validation)
    let pos = parse_skip_ws_inline_at(src, end)
    if !ok || pos != src.len() {
        if let report = rejected { report(json_reader_error_path(validation), pos, validation.problem) }
        return null
    }
    if src.unit_at(at) == 123 {
        let root_offsets = validation.offsets.get(at) ?? JsonReaderOffsets {}
        validation.offsets[at] = JsonReaderOffsets { fields: validation.root_fields, end: root_offsets.end }
    }
    return JsonReader { src, at, offsets: validation.offsets }
}

fn json_reader_skip(src: string, at: int, offsets: Map<int, JsonReaderOffsets>? = null) -> int {
    let first = src.unit_at(at)
    if first == 91 || first == 123 {
        if let index = offsets {
            if let entry = index.get(at) { if entry.end >= 0 { return entry.end } }
        }
    }
    let pos = at
    let len = src.len()
    let depth = 0
    let quoted = false
    while pos < len {
        let b = src.unit_at(pos)
        if quoted {
            if b == 92 { pos += 2; continue }
            pos += 1
            if b == 34 { quoted = false; if depth == 0 { return pos } }
            continue
        }
        if b == 34 { quoted = true }
        else if b == 91 || b == 123 { depth += 1 }
        else if b == 93 || b == 125 {
            if depth == 0 { return pos }
            depth -= 1
            pos += 1
            if depth == 0 { return pos }
            continue
        } else if depth == 0 && (b == 44 || b == 32 || b == 9 || b == 10 || b == 13) { return pos }
        pos += 1
    }
    return pos
}

@inline fn json_reader_at(reader: JsonReader, at: int) -> JsonReader {
    return JsonReader { src: reader.src, at, offsets: reader.offsets }
}

@inline fn json_reader_fields(reader: JsonReader) -> Map<string, int>? {
    let offsets = reader.offsets ?? return null
    let entry = offsets.get(reader.at) ?? return null
    return entry.fields
}

fn json_reader_index(reader: JsonReader) -> JsonReader {
    if json_reader_fields(reader) != null { return reader }
    if reader.src == null || reader.at < 0 { return reader }
    let (indexed, _) = json_reader_index_at(reader)
    return indexed
}

fn json_reader_index_at(reader: JsonReader) -> (JsonReader, int) {
    let src = reader.src.unwrap()
    if src.unit_at(reader.at) != 123 { return (reader, reader.at) }
    let fields: Map<string, int> = map_new()
    let pos = parse_skip_ws_inline_at(src, reader.at + 1)
    while src.unit_at(pos) != 125 {
        let (key, end) = parse_string_raw_at(src, pos)
        pos = parse_skip_ws_inline_at(src, end)
        pos = parse_skip_ws_inline_at(src, pos + 1)
        fields[key.unwrap()] = pos
        pos = parse_skip_ws_inline_at(src, json_reader_skip(src, pos, reader.offsets))
        if src.unit_at(pos) == 44 { pos = parse_skip_ws_inline_at(src, pos + 1) }
    }
    let offsets = reader.offsets.unwrap()
    offsets[reader.at] = JsonReaderOffsets { fields, end: pos + 1 }
    return (reader, pos)
}

fn json_reader_field_offset(reader: JsonReader, key: string) -> int {
    if reader.at < 0 { return -1 }
    if let fields = json_reader_fields(reader) {
        let at = fields.get(key) ?? return -1
        return at
    }
    let src = reader.src.unwrap()
    if src.unit_at(reader.at) != 123 { return -1 }
    let (indexed, _) = json_reader_index_at(reader)
    return json_reader_fields(indexed).unwrap().get(key) ?? -1
}

fn json_reader_field(reader: JsonReader, key: string) -> JsonReader? {
    if let value = reader.value {
        let field = json_field(value, key) ?? return null
        return json_reader_value(field)
    }
    let at = json_reader_field_offset(reader, key)
    return if at < 0 { null } else { json_reader_at(reader, at) }
}

fn json_reader_as_str_at(src: string, at: int) -> string? {
    if at < 0 { return null }
    if src.unit_at(at) != 34 { return null }
    let (value, _) = parse_string_raw_at(src, at)
    return value
}

fn json_reader_as_str(reader: JsonReader) -> string? {
    if let value = reader.value { return json_as_str(value) }
    if reader.at < 0 { return null }
    return json_reader_as_str_at(reader.src.unwrap(), reader.at)
}

fn json_reader_as_bool_at(src: string, at: int) -> bool? {
    if at < 0 { return null }
    let b = src.unit_at(at)
    return if b == 116 { true } else if b == 102 { false } else { null }
}

fn json_reader_as_bool(reader: JsonReader) -> bool? {
    if let value = reader.value { return json_as_bool(value) }
    if reader.at < 0 { return null }
    return json_reader_as_bool_at(reader.src.unwrap(), reader.at)
}

fn json_reader_number_end_at(src: string, at: int) -> (float?, int) {
    if at < 0 { return (null, at) }
    let b = src.unit_at(at)
    if b != 45 && (b < 48 || b > 57) { return (null, at) }
    let (end, is_float, ok) = parse_number_scan_at(src, at)
    assert(ok, "validated JSON reader number must scan")
    if is_float { return (src.parse_float_at(at, end), end) }
    return (src.substring(at, end).parse_int().unwrap() as float, end)
}

fn json_reader_number_at(src: string, at: int) -> float? {
    let (value, _) = json_reader_number_end_at(src, at)
    return value
}

fn json_reader_as_float(reader: JsonReader) -> float? {
    if let value = reader.value { return json_as_float(value) }
    if reader.at < 0 { return null }
    return json_reader_number_at(reader.src.unwrap(), reader.at)
}

fn json_reader_read_int_at(src: string, at: int, strict: bool) -> int? {
    if at < 0 { return null }
    let b = src.unit_at(at)
    if b != 45 && (b < 48 || b > 57) { return null }
    let (end, is_float, ok) = parse_number_scan_at(src, at)
    assert(ok, "validated JSON reader number must scan")
    if is_float {
        if strict { return null }
        return src.parse_float_at(at, end) as int
    }
    return src.substring(at, end).parse_int()
}

fn json_reader_read_int(reader: JsonReader, strict: bool) -> int? {
    if let value = reader.value {
        if strict { return match value { JsonValue::Int(i) => i, _ => null } }
        return json_as_int(value)
    }
    if reader.at < 0 { return null }
    return json_reader_read_int_at(reader.src.unwrap(), reader.at, strict)
}

fn json_reader_as_int(reader: JsonReader) -> int? { return json_reader_read_int(reader, false) }
fn json_reader_strict_int(reader: JsonReader) -> int? { return json_reader_read_int(reader, true) }

fn json_reader_as_array(reader: JsonReader) -> JsonReaderArray? {
    if let value = reader.value {
        return JsonReaderArray { reader, values: json_as_array(value) ?? return null }
    }
    if reader.at < 0 { return null }
    let src = reader.src.unwrap()
    if src.unit_at(reader.at) != 91 { return null }
    return JsonReaderArray { reader, first: parse_skip_ws_inline_at(src, reader.at + 1) }
}

@inline fn JsonReaderArray.iter(array) -> JsonReaderArrayIter {
    return JsonReaderArrayIter { array, pos: array.first }
}

@inline fn JsonReaderArrayIter.next(it) -> (bool, JsonReader) {
    return json_reader_array_next(it, true)
}

fn JsonReaderArrayIter.next_unindexed(it) -> (bool, JsonReader) {
    return json_reader_array_next(it, false)
}

fn json_reader_array_next(it: JsonReaderArrayIter, index_objects: bool) -> (bool, JsonReader) {
    let array = it.array
    if let values = array.values {
        if it.index >= values.len() { return (false, json_reader_null()) }
        let value = values[it.index]
        it.index += 1
        return (true, json_reader_value(value))
    }
    if it.pos < 0 { return (false, json_reader_null()) }
    let at = it.pos
    let src = array.reader.src.unwrap()
    if src.unit_at(at) == 93 { return (false, json_reader_null()) }
    let entry = json_reader_at(array.reader, at)
    let pos = at
    if index_objects && src.unit_at(at) == 123 {
        let (indexed, end) = json_reader_index_at(entry)
        entry = indexed
        pos = end + 1
    } else {
        pos = json_reader_skip(src, at, array.reader.offsets)
    }
    pos = parse_skip_ws_inline_at(src, pos)
    if src.unit_at(pos) == 44 { pos = parse_skip_ws_inline_at(src, pos + 1) }
    it.pos = pos
    it.index += 1
    return (true, entry)
}

fn JsonReaderArray.len(array) -> int {
    if let values = array.values { return values.len() }
    if array.first < 0 { return 0 }
    let src = array.reader.src.unwrap()
    let pos = array.first
    let size = 0
    while src.unit_at(pos) != 93 {
        pos = json_reader_skip(src, pos, array.reader.offsets)
        size += 1
        pos = parse_skip_ws_inline_at(src, pos)
        if src.unit_at(pos) == 44 { pos = parse_skip_ws_inline_at(src, pos + 1) }
    }
    return size
}

fn JsonReaderArray.get_at(array, index: int) -> JsonReader {
    if let values = array.values { return json_reader_value(values[index]) }
    for (i, entry) in enumerate(array) { if i == index { return entry } }
    error("JSON array index out of bounds: {index}")
    return json_reader_null()
}

fn json_reader_as_object(reader: JsonReader) -> Map<string, JsonReader>? {
    let fields: Map<string, JsonReader> = map_new()
    if let value = reader.value {
        let object = json_as_object(value) ?? return null
        for (key, entry) in object { fields[key] = json_reader_value(entry) }
        return fields
    }
    if reader.at < 0 { return null }
    let indexed = json_reader_index(reader)
    let offsets = json_reader_fields(indexed) ?? return null
    for (key, at) in offsets { fields[key] = json_reader_at(reader, at) }
    return fields
}

fn json_reader_field_as_str(reader: JsonReader, key: string) -> string? {
    if let value = reader.value { return json_as_str(json_field(value, key) ?? json_null()) }
    let at = json_reader_field_offset(reader, key)
    if at < 0 { return null }
    return json_reader_as_str_at(reader.src.unwrap(), at)
}

fn json_reader_field_as_bool(reader: JsonReader, key: string) -> bool? {
    if let value = reader.value { return json_as_bool(json_field(value, key) ?? json_null()) }
    let at = json_reader_field_offset(reader, key)
    if at < 0 { return null }
    return json_reader_as_bool_at(reader.src.unwrap(), at)
}

fn json_reader_field_as_float(reader: JsonReader, key: string) -> float? {
    if let value = reader.value { return json_as_float(json_field(value, key) ?? json_null()) }
    let at = json_reader_field_offset(reader, key)
    if at < 0 { return null }
    return json_reader_number_at(reader.src.unwrap(), at)
}

fn json_reader_field_as_int(reader: JsonReader, key: string) -> int? {
    if let value = reader.value { return json_as_int(json_field(value, key) ?? json_null()) }
    let at = json_reader_field_offset(reader, key)
    if at < 0 { return null }
    return json_reader_read_int_at(reader.src.unwrap(), at, false)
}

fn json_reader_field_as_strict_int(reader: JsonReader, key: string) -> int? {
    if let value = reader.value { return match json_field(value, key) ?? json_null() { JsonValue::Int(i) => i, _ => null } }
    let at = json_reader_field_offset(reader, key)
    if at < 0 { return null }
    return json_reader_read_int_at(reader.src.unwrap(), at, true)
}

fn json_reader_is_null(reader: JsonReader) -> bool {
    if let value = reader.value { return json_is_null(value) }
    return reader.at < 0 || reader.src.unwrap().unit_at(reader.at) == 110
}

fn json_reader_materialize(reader: JsonReader) -> JsonValue {
    if let value = reader.value { return value }
    if reader.at < 0 { return json_null() }
    let src = reader.src.unwrap()
    let p = JsonParser { src, pos: reader.at, len: src.len(), ok: true, depth: 0 }
    return parse_value(p)
}

fn json_reader_is_object(reader: JsonReader) -> bool {
    if let value = reader.value { return json_as_object(value) != null }
    return reader.at >= 0 && reader.src.unwrap().unit_at(reader.at) == 123
}

@lua_named struct JsonField<T> {
    present: bool = false,
    value: T? = null,
}

@lua_named struct JsonRecordAdapter {
    name: string,
    encode: fn(any) -> JsonValue,
    decode: fn(JsonValue) -> any?,
}

@lua_named struct JsonRecordError {
    path: string,
    expected: string,
    actual: string,
}

@lua_named struct JsonRecordCodec {
    reject_unknown_fields: bool = false,
    on_error: fn(JsonRecordError)? = null,
    adapters: [JsonRecordAdapter] = [],
    encode_float: fn(float) -> JsonValue = json_float,
    decode_float: fn(JsonValue) -> float? = json_record_finite_float,
}

fn json_record_finite_float(value: JsonValue) -> float? {
    let number = json_as_float(value) ?? return null
    if is_nan(number) || number == 1.0 / 0.0 || number == -1.0 / 0.0 { return null }
    return number
}

inline(lua) fn __json_record_type<T>(sample: T) -> string = "error('json record type intrinsic reached runtime')"

fn json_record_adapter_result<T>(decode: fn(JsonValue) -> T?, value: JsonValue) -> any? {
    let result = decode(value) ?? return null
    return materialize(result)
}

fn json_record_adapter<T>(sample: T, encode: fn(T) -> JsonValue,
    decode: fn(JsonValue) -> T?) -> JsonRecordAdapter {
    return JsonRecordAdapter {
        name: __json_record_type(sample),
        encode: value => encode(cast<T>(value)),
        decode: value => json_record_adapter_result(decode, value),
    }
}

@nomangle @lua_helper inline(lua) fn __json_record_node(tag: string, item: any, row: bool = false) -> JsonValue = """
    if row then return item or false, tag end
    if tag == 'Null' then return __rock_enum_unit('JsonValue', 'Null') end
    return setmetatable({ __variant = tag, item }, __rock_box_mts.JsonValue)
"""

@nomangle @lua_helper inline(lua) fn __json_record_vec(items: any, count: int) -> any = """
    items[0] = count
    return setmetatable(items, __rock_box_mts.Vec)
"""
@nomangle @lua_helper inline(lua) fn __json_record_json_vec(data: any, count: int) -> any = """
    return { _data = data, len = count, ['@vec'] = __rock_vec_header('strided', 'JsonValue', 2) }
"""
@nomangle @lua_helper inline(lua) fn __json_record_label(codec: any, tag: any, items: any) -> string? = """
    if tag ~= 'Array' or items.len == 0 then return nil end
    if codec.src then
        if __json_record_source_kind(codec.src, items[1]) == 'Str' then return (__json_record_source_text(codec, items[1])) end
        return nil
    end
    local first_tag, label = __rock_json_vec_parts(items, 1)
    if first_tag == 'Str' then return label end
"""

// Decoding reads a JsonValue, a JSON array row, or, when the context carries
// `src`, the offset of a value in validated JSON text; arrays of offsets hold
// their elements. All three report the same JsonValue tags and payloads.
@nomangle @lua_helper inline(lua) fn __json_record_source_body(codec: any, at: int) -> any = """
    local b = string.byte(codec.src, at + 1)
    if b == 34 then return (__json_record_source_text(codec, at)) end
    if b == 91 then return __json_record_source_items(codec.src, at) end
    if b == 123 then return __json_record_source_fields(codec, at) end
    if b == 45 or (b >= 48 and b <= 57) then return __json_record_source_number(codec, at) end
    return nil
"""

@nomangle @lua_helper inline(lua) fn __json_record_input_value(codec: any, value: any, index: int?) -> any = """
    if codec.src then return value and codec.source.value_at(codec.src, value) end
    if index then return __rock_json_vec_at(value, index) end
    return value
"""

@nomangle @lua_helper inline(lua) fn __json_record_source_kind(src: string, at: int) -> any = """
    local b = string.byte(src, at + 1)
    if b == 34 then return 'Str' end
    if b == 91 then return 'Array' end
    if b == 123 then return 'Object' end
    if b == 116 then return 'True' end
    if b == 102 then return 'False' end
    if b == 110 then return 'Null' end
    local _, is_float = __json_record_source_number_end(src, at)
    return is_float and 'Float' or 'Int'
"""

// 0 ends a number, 1 continues it, 2 continues it and makes it a float.
@nomangle @lua_helper inline(lua) fn __json_record_number_byte(b: int?) -> int = """
    if b == 46 or b == 101 or b == 69 then return 2 end
    if not b or b < 43 or b > 57 or b == 44 or b == 47 then return 0 end
    return 1
"""

@nomangle @lua_helper inline(lua) fn __json_record_source_number_tail(src: string, i: int, is_float: bool) -> any = """
    while true do
        local c = __json_record_number_byte(string.byte(src, i + 1))
        if c == 0 then return i, is_float end
        is_float = is_float or c == 2
        i = i + 1
    end
"""

// Unrolled so that short numbers, the common case, do not start a loop inside
// the visitor's trace; a looping scan here gets the caller blacklisted.
@nomangle @lua_helper inline(lua) fn __json_record_source_number_end(src: string, at: int) -> any = """
    local _, b2, b3, b4, b5, b6, b7, b8 = string.byte(src, at + 1, at + 8)
    local c = __json_record_number_byte(b2)
    if c == 0 then return at + 1, false end
    local f = c == 2
    c = __json_record_number_byte(b3); if c == 0 then return at + 2, f end; f = f or c == 2
    c = __json_record_number_byte(b4); if c == 0 then return at + 3, f end; f = f or c == 2
    c = __json_record_number_byte(b5); if c == 0 then return at + 4, f end; f = f or c == 2
    c = __json_record_number_byte(b6); if c == 0 then return at + 5, f end; f = f or c == 2
    c = __json_record_number_byte(b7); if c == 0 then return at + 6, f end; f = f or c == 2
    c = __json_record_number_byte(b8); if c == 0 then return at + 7, f end; f = f or c == 2
    return __json_record_source_number_tail(src, at + 8, f)
"""

@nomangle @lua_helper inline(lua) fn __json_record_source_number(codec: any, at: int) -> any = """
    local src = codec.src
    local stop, is_float = __json_record_source_number_end(src, at)
    if is_float then return codec.source.float_at(src, at, stop) end
    return math.floor(tonumber(string.sub(src, at + 1, stop)))
"""

// The text was validated when the reader was built, so indexing only finds
// value boundaries. Strings jump to their closing quote with a plain find.
@nomangle @lua_helper inline(lua) fn __json_record_source_quote(src: string, at: int) -> int = """
    local q = string.find(src, '"', at + 2, true)
    if string.byte(src, q - 1) ~= 92 then return q end
    return __json_record_source_escaped_quote(src, q)
"""

@nomangle @lua_helper inline(lua) fn __json_record_source_escaped_quote(src: string, q: int) -> int = """
    while true do
        local slash = q - 1
        while string.byte(src, slash) == 92 do slash = slash - 1 end
        if (q - 1 - slash) % 2 == 0 then return q end
        q = string.find(src, '"', q + 1, true)
    end
"""

@nomangle @lua_helper inline(lua) fn __json_record_source_skip(src: string, at: int) -> int = """
    local byte = string.byte
    local i = at + 1
    local b = byte(src, i)
    if b == 34 then return __json_record_source_quote(src, at) end
    if b ~= 91 and b ~= 123 then
        repeat
            i = i + 1
            b = byte(src, i)
        until b == nil or b == 44 or b == 93 or b == 125 or b == 32 or b == 10 or b == 13 or b == 9
        return i - 1
    end
    local depth = 1
    while true do
        i = i + 1
        b = byte(src, i)
        if b == 34 then i = __json_record_source_quote(src, i - 1)
        elseif b == 91 or b == 123 then depth = depth + 1
        elseif b == 93 or b == 125 then
            depth = depth - 1
            if depth == 0 then return i end
        end
    end
"""

@nomangle @lua_helper inline(lua) fn __json_record_source_ws(src: string, at: int) -> int = """
    local byte = string.byte
    local b = byte(src, at + 1)
    while b == 32 or b == 10 or b == 13 or b == 9 do
        at = at + 1
        b = byte(src, at + 1)
    end
    return at
"""

@nomangle @lua_helper inline(lua) fn __json_record_source_items(src: string, at: int) -> any = """
    local byte = string.byte
    local items, n = {}, 0
    local pos = __json_record_source_ws(src, at + 1)
    if byte(src, pos + 1) ~= 93 then
        while true do
            n = n + 1
            items[n] = pos
            pos = __json_record_source_ws(src, __json_record_source_skip(src, pos))
            if byte(src, pos + 1) == 93 then break end
            pos = __json_record_source_ws(src, pos + 1)
        end
    end
    items.len = n
    return items
"""

@nomangle @lua_helper inline(lua) fn __json_record_source_fields(codec: any, at: int) -> any = """
    local src = codec.src
    local byte = string.byte
    local fields = {}
    local pos = __json_record_source_ws(src, at + 1)
    if byte(src, pos + 1) == 125 then return fields end
    while true do
        local key, after = __json_record_source_text(codec, pos)
        local value = __json_record_source_ws(src, __json_record_source_ws(src, after) + 1)
        fields[key] = value
        pos = __json_record_source_ws(src, __json_record_source_skip(src, value))
        if byte(src, pos + 1) == 125 then return fields end
        pos = __json_record_source_ws(src, pos + 1)
    end
"""

@nomangle @lua_helper inline(lua) fn __json_record_source_text(codec: any, at: int) -> any = """
    local src = codec.src
    local close = __json_record_source_quote(src, at)
    for i = at + 2, close - 1 do
        if string.byte(src, i) == 92 then return codec.source.string_at(src, at), close end
    end
    return string.sub(src, at + 2, close - 1), close
"""

@nomangle @lua_helper inline(lua) fn __json_record_finite(n: float) -> bool = "return n == n and n ~= math.huge and n ~= -math.huge"

// Reads a native value stored as leaves: in `source` by path (through `slots`),
// in strided data at `base` plus the path's offset, or in columns at row `base`.
// `into` receives the leaves instead of a new value.
@nomangle @lua_helper inline(lua) fn __json_record_native_get(source: any, name: string, prefix: string, slots: any? = null,
    into: any? = null, base: int? = null) -> any = """
    local result = into or _G[name .. '_ct']()
    for _, field in ipairs(_G.__ROCK_TYPE_TABLE[name].fields) do
        local path = prefix .. field.name
        local child = _G.__ROCK_TYPE_TABLE[field.type]
        -- Columns also store native enum fields as leaves.
        if child and (child.kind == 'c_struct' or (child.kind == 'c_enum' and base and not slots)) then
            if into then __json_record_native_get(source, field.type, path .. '.', slots, result[field.name], base)
            else result[field.name] = __json_record_native_get(source, field.type, path .. '.', slots, nil, base) end
        elseif not base then result[field.name] = source[slots and slots[path] or path]
        elseif slots then result[field.name] = source[base + slots[path]]
        else result[field.name] = source[path][base] end
    end
    return result
"""

@nomangle @lua_helper inline(lua) fn __json_record_native_put(target: any, value: any, name: string, prefix: string, slots: any? = null) = """
    for _, field in ipairs(_G.__ROCK_TYPE_TABLE[name].fields) do
        local path = prefix .. field.name
        local child = _G.__ROCK_TYPE_TABLE[field.type]
        if child and child.kind == 'c_struct' then
            __json_record_native_put(target, value[field.name], field.type, path .. '.', slots)
        else target[slots and slots[path] or path] = value[field.name] end
    end
"""

// Encoding copies a stored value it must box into one value reused per type
// and depth, unless an adapter, which may keep it, receives a boxed value.
// Native values reach adapters and omit predicates only as leaves, so they
// are always reused. A reused table comes back empty, with the pool its nested
// values are reused from. Decoding contexts have no scratch and box afresh.
@nomangle @lua_helper inline(lua) fn __json_record_scratch(codec: any?, name: string, depth: int) -> any = """
    local scratch = codec and codec.scratch
    if not scratch then return nil end
    local native = _G.__ROCK_TYPE_TABLE[name].kind == 'c_struct'
    if not native and codec.adapters and codec.adapters[name] then return nil end
    local level = scratch[depth]
    if not level then
        level = {}
        scratch[depth] = level
    end
    local entry = level[name]
    if native then
        if not entry then
            entry = _G[name .. '_ct']()
            level[name] = entry
        end
        return entry
    end
    if not entry then
        entry = { setmetatable({}, __rock_box_mts[name]), {} }
        level[name] = entry
    end
    local value = entry[1]
    for key in pairs(value) do value[key] = nil end
    return value, entry[2]
"""

@nomangle @lua_helper inline(lua) fn __json_record_field_get(source: any, field: any, slots: any, codec: any? = null, depth: int = 0) -> any = """
    local key = field.name
    if field.flat then
        local tag_key = field.flat[1]
        local tag = source[slots and slots[tag_key] or tag_key]
        if tag == nil then return nil end
        local value = __json_record_scratch(codec, field.type, depth) or setmetatable({}, __rock_box_mts[field.type])
        value.__variant = tag
        for i = 2, #field.flat do
            local path = field.flat[i]
            value[i - 1] = source[slots and slots[path] or path]
        end
        return value
    end
    if not field.embed then return source[slots and slots[key] or key] end
    if field.nullable and not source[slots and slots[key] or key] then return nil end
    if _G.__ROCK_TYPE_TABLE[field.type].kind == 'c_struct' then
        return __json_record_native_get(source, field.type, key .. '.', slots, __json_record_scratch(codec, field.type, depth))
    end
    local mt = __rock_box_mts[field.type]
    local child_slots = mt.__rock_slots
    local value, prefix = field.json_omit == nil and __json_record_scratch(codec, field.type, depth) or setmetatable({}, mt), key .. '.'
    local source_names = slots and getmetatable(source).__rock_fields
    for name, item in pairs(source) do
        name = source_names and source_names[name] or name
        if type(name) == 'string' and name:sub(1, #prefix) == prefix then
            local child_key = name:sub(#prefix + 1)
            value[child_slots and child_slots[child_key] or child_key] = item
        end
    end
    return value
"""

@nomangle @lua_helper inline(lua) fn __json_record_field_put(target: any, field: any, value: any, slots: any) = """
    local key = field.name
    if field.flat then
        if value == nil then return end
        local tag_key = field.flat[1]
        target[slots and slots[tag_key] or tag_key] = value.__variant
        for i = 2, #field.flat do
            local path = field.flat[i]
            target[slots and slots[path] or path] = value[i - 1]
        end
    elseif field.embed then
        if field.nullable then target[slots and slots[key] or key] = value ~= nil and true or nil end
        if type(value) == 'cdata' then
            __json_record_native_put(target, value, field.type, key .. '.', slots)
        elseif value ~= nil then
            local mt = getmetatable(value)
            local names = type(mt) == 'table' and mt.__rock_fields
            for name, item in pairs(value) do
                if name ~= '__ty' then
                    local path = key .. '.' .. (names and names[name] or name)
                    target[slots and slots[path] or path] = item
                end
            end
        end
    else target[slots and slots[key] or key] = value end
"""

@nomangle @lua_helper inline(lua) fn __json_record_payload_get(value: any, shape: any, index: int, codec: any? = null, depth: int = 0) -> any = """
    local slot = shape.slot or index
    local leaves = shape.leaves
    if not leaves then return value[slot] end
    if shape.k == 'opt' then
        if not value[slot] then return nil end
        slot, shape = slot + 1, shape.inner
    end
    local flat = _G.__ROCK_ENUM_FLAT_LAYOUT[shape.name]
    if flat then
        local result = __json_record_scratch(codec, shape.name, depth) or setmetatable({}, __rock_box_mts[shape.name])
        result.__variant = value[slot]
        for i = 1, flat.tuple_width do result[i] = value[slot + i] end
        return result
    end
    local decl = _G.__ROCK_TYPE_TABLE[shape.name]
    local result, pool = __json_record_scratch(codec, shape.name, depth)
    result = result or decl.kind == 'c_struct' and _G[shape.name .. '_ct']() or setmetatable({}, __rock_box_mts[shape.name])
    local nested = false
    for i, path in ipairs(leaves) do
        local dot = path:find('.', 1, true)
        if dot and decl.kind == 'c_struct' then
            local child = result
            local start = 1
            while dot do
                child, start = child[path:sub(start, dot - 1)], dot + 1
                dot = path:find('.', start, true)
            end
            child[path:sub(start)] = value[slot + i - 1]
        else
            result[path] = value[slot + i - 1]
            nested = nested or dot ~= nil
        end
    end
    return nested and __json_record_row_object(result, shape.name, pool) or result
"""

@nomangle @lua_helper inline(lua) fn __json_record_payload_put(target: any, shape: any, index: int, value: any) = """
    local slot = shape.slot or index
    local leaves = shape.leaves
    if not leaves then target[slot] = value; return end
    local presence = shape.presence
    if shape.k == 'opt' then
        target[slot] = value ~= nil
        if value == nil then
            if presence then
                for i in pairs(presence) do target[slot + i] = false end
            end
            return
        end
        slot, shape = slot + 1, shape.inner
    end
    local flat = _G.__ROCK_ENUM_FLAT_LAYOUT[shape.name]
    if flat then
        target[slot] = value.__variant
        for i = 1, flat.tuple_width do target[slot + i] = value[i] end
        return
    end
    for i, path in ipairs(leaves) do
        local leaf
        if path:find('.', 1, true) then
            leaf = __json_record_row_leaf(value, path)
        else
            leaf = value[path]
        end
        if presence and presence[i] then leaf = not not leaf end
        target[slot + i - 1] = leaf
    end
"""

// Builds a row's nested value tables from its flat leaves; with a pool, each
// nested table is reused and emptied first.
@nomangle @lua_helper inline(lua) fn __json_record_row_object(row: any, name: string, pool: any? = null) -> any = """
    for _, field in ipairs(_G.__ROCK_TYPE_TABLE[name].fields) do
        local child = _G.__ROCK_TYPE_TABLE[field.type]
        if field.embed and field.nullable and row[field.name] == false then row[field.name] = nil end
        if child and child.kind == 'value_table' and not field.embed
            and (not field.nullable or row[field.name] ~= nil)
            and type(row[field.name]) ~= 'table' then
            local value, nested
            if pool then
                local entry = pool[field.name]
                if not entry then
                    entry = { setmetatable({}, __rock_box_mts[field.type]), {} }
                    pool[field.name] = entry
                end
                value, nested = entry[1], entry[2]
                for key in pairs(value) do value[key] = nil end
            else value = setmetatable({}, __rock_box_mts[field.type]) end
            local prefix = field.name .. '.'
            for path, item in pairs(row) do
                if path:sub(1, #prefix) == prefix then value[path:sub(#prefix + 1)] = item end
            end
            row[field.name] = __json_record_row_object(value, field.type, nested)
        end
    end
    return row
"""

@nomangle @lua_helper inline(lua) fn __json_record_row_leaf(value: any, path: string) -> any = """
    if type(value) == 'table' and value[path] ~= nil then return value[path] end
    local dot = path:find('.', 1, true)
    if dot then
        local child = value[path:sub(1, dot - 1)]
        if type(child) == 'table' or type(child) == 'cdata' then
            return __json_record_row_leaf(child, path:sub(dot + 1))
        end
    elseif type(value) == 'cdata' then return value[path]
    elseif type(value) == 'table' then
        for _, field in ipairs(__rock_field_declaration(value).fields) do
            if field.name == path and field.embed and field.nullable then return false end
        end
    end
    return nil
"""

@nomangle @lua_helper inline(lua) fn __json_record_failure(shape: any, value: any, index: int? = null, codec: any? = null) -> any = """
    if index then value = __rock_json_vec_at(value, index) end
    local source = value ~= nil and codec and codec.src
    local actual = value == nil and 'missing' or source and __json_record_source_kind(source, value)
        or value.__variant or type(value)
    if (actual == 'True' or actual == 'False') and (source or getmetatable(value) == __rock_box_mts.JsonValue) then
        actual = 'Bool'
    end
    return setmetatable({ path = '', expected = shape.name or shape.k,
        actual = actual }, __rock_box_mts.JsonRecordError)
"""

@nomangle @lua_helper inline(lua) fn __json_record_error_at(failure: any, key: any) -> any = """
    local part = tostring(key):gsub('~', '~0'):gsub('/', '~1')
    failure.path = '/' .. part .. failure.path
    return failure
"""

@nomangle fn __json_record_copy_default(value: any) -> any { return deepcopy(value) }

// Pieces are joined every 512 so the piece table stays small; the joined
// chunks add up to the output size.
@nomangle @lua_helper inline(lua) fn __json_record_put(codec: any, text: string) = """
    local n, out = codec.n + 1, codec.out
    out[n] = text
    if n == 512 then
        local chunks = codec.chunks or {}
        codec.chunks = chunks
        chunks[#chunks + 1] = table.concat(out, '', 1, 512)
        n = 0
    end
    codec.n = n
"""

// Fields in the order json_encode writes object keys.
@nomangle @lua_helper inline(lua) fn __json_record_write_fields(codec: any, decl: any) -> any = """
    local fields = decl.json_write_fields
    if fields then return fields end
    fields = {}
    for _, field in ipairs(decl.fields) do
        if not field.json_skip then
            field.json_write_key = codec.sink.string_text(field.json_name or field.name) .. ':'
            field.json_write_next_key = ',' .. field.json_write_key
            fields[#fields + 1] = field
        end
    end
    table.sort(fields, function(a, b) return (a.json_name or a.name) < (b.json_name or b.name) end)
    decl.json_write_fields = fields
    return fields
"""

@nomangle @lua_helper inline(lua) fn __json_record_visit(codec: any, shape: any,
    value: any, reading: bool, seen: any, depth: int, defaults: any,
    row: bool = false, index: int? = null) -> any = """
    if depth > 128 then
        if reading then return false, __json_record_failure(shape, value, index, codec) end
        error('json record nesting exceeds 128', 0)
    end
    -- Array input keeps its row until a codec callback or diagnostic needs a box.
    local kind = shape.k
    -- Writing appends JSON text to codec.out instead of building nodes.
    local out = not reading and codec.out
    local input_tag, input_payload
    if reading and codec.src then
        if index then value, index = value[index], nil end
        if value ~= nil then
            input_tag = __json_record_source_kind(codec.src, value)
            if kind ~= 'opt' and kind ~= 'field' and kind ~= 'float' then
                input_payload = __json_record_source_body(codec, value)
            end
        end
    elseif reading then
        if index then input_tag, input_payload = __rock_json_vec_parts(value, index)
        elseif type(value) == 'table' then input_tag, input_payload = value.__variant, value[1] end
        if input_tag == 'Raw' then
            local parsed = codec.parse_raw and codec.parse_raw(input_payload)
            if parsed == nil then return false, __json_record_failure(shape, value, index, codec) end
            return __json_record_visit(codec, shape, parsed, true, seen, depth, defaults)
        end
    end
    if kind == 'field' then
        if reading then
            if value == nil then return true, setmetatable({ present = false }, __rock_box_mts.JsonField) end
            local ok, decoded = __json_record_visit(codec, shape.inner, value, true, seen, depth + 1, nil, false, index)
            if not ok then return false, decoded end
            return true, setmetatable({ present = true, value = decoded }, __rock_box_mts.JsonField)
        end
        if not value.present then error('json record absent field requires an object field', 0) end
        return __json_record_visit(codec, shape.inner, value.value, false, seen, depth + 1, nil, row)
    end
    if kind == 'opt' then
        if reading and input_tag == 'Null' then return true, nil end
        if not reading and value == nil then
            if out then __json_record_put(codec, 'null'); return true end
            return true, __json_record_node('Null', nil, row)
        end
        return __json_record_visit(codec, shape.inner, value, reading, seen, depth + 1, defaults, row, index)
    end
    if kind == 'int' or kind == 'uint' then
        local n = value
        if reading then n = (input_tag == 'Int' or input_tag == 'Float') and input_payload or nil end
        if type(n) ~= 'number' or not __json_record_finite(n) or n ~= math.floor(n)
            or (kind == 'uint' and n < 0) then return false, __json_record_failure(shape, value, index, codec) end
        if reading then return true, n end
        if out then __json_record_put(codec, codec.sink.int_text(n)); return true end
        return true, __json_record_node('Int', n, row)
    end
    if kind == 'float' then
        if reading then
            local n
            if codec.src and codec.decode_float == codec.source.finite_float then
                n = (input_tag == 'Int' or input_tag == 'Float') and __json_record_source_number(codec, value) or nil
            else n = codec.decode_float(__json_record_input_value(codec, value, index)) end
            if n == nil or not __json_record_finite(n) then return false, __json_record_failure(shape, value, index, codec) end
            return true, n
        end
        if not __json_record_finite(value) then error('json record cannot encode a nonfinite float', 0) end
        if out then
            local sink = codec.sink
            __json_record_put(codec, codec.encode_float == sink.default_float and sink.float_text(value)
                or sink.value_text(codec.encode_float(value)))
            return true
        end
        return true, (codec.encode_float(value))
    end
    if kind == 'string' then
        if out then __json_record_put(codec, codec.sink.string_text(value)); return true end
        if not reading then return true, __json_record_node('Str', value, row) end
        if input_tag == 'Str' then return true, input_payload end
        return false, __json_record_failure(shape, value, index, codec)
    end
    if kind == 'bool' then
        if out then __json_record_put(codec, value and 'true' or 'false'); return true end
        if not reading then return true, json_bool(value) end
        if input_tag == 'True' then return true, true end
        if input_tag == 'False' then return true, false end
        return false, __json_record_failure(shape, value, index, codec)
    end
    if kind == 'vec' then
        local element = shape.elem.k == 'nom' and _G.__ROCK_TYPE_TABLE[shape.elem.name]
        if element and element.kind == 'c_enum' then
            error('json record does not support native enum arrays', 0)
        end
        if reading and input_tag ~= 'Array' then return false, __json_record_failure(shape, value, index, codec) end
        local items = reading and input_payload or value
        local json_items = element and shape.elem.name == 'JsonValue'
        local offsets = element and _G.__ROCK_STRIDED_ROWS[shape.elem.name]
        local columns = element and element.kind == 'c_struct' and element.vec_columns
        local column_stored = not reading and __rock_is_column_vec(items)
        local strided = __rock_is_strided_vec(items)
        if (column_stored and not columns) or (strided and not (offsets or json_items or reading)) then
            error('json record does not support this array storage', 0)
        end
        local stride = 0
        if offsets then for _, offset in pairs(offsets) do stride = math.max(stride, offset) end end
        local result = not out and {}
        if reading and columns then
            for _, path in ipairs(columns) do result[path] = {} end
        end
        local len = items[0] or items.len
        if out then __json_record_put(codec, '[') end
        for i = 1, len do
            if out and i > 1 then __json_record_put(codec, ',') end
            local item
            if reading then
                item = items
            elseif json_items then
                item = __rock_json_vec_at(items, i)
            elseif column_stored then
                item = __json_record_native_get(items, shape.elem.name, '', nil, __json_record_scratch(codec, shape.elem.name, depth), i)
            elseif strided and element.kind == 'c_struct' then
                item = __json_record_native_get(items._data, shape.elem.name, '', offsets,
                    __json_record_scratch(codec, shape.elem.name, depth), (i - 1) * stride)
            elseif strided then
                local pool
                item, pool = __json_record_scratch(codec, shape.elem.name, depth)
                item = item or setmetatable({}, __rock_box_mts[shape.elem.name])
                for path, offset in pairs(offsets) do item[path] = items._data[(i - 1) * stride + offset] end
                item = __json_record_row_object(item, shape.elem.name, pool)
            else item = items[i] end
            local ok, decoded, tag = __json_record_visit(codec, shape.elem, item, reading, seen, depth + 1, nil, not reading, reading and i or nil)
            if not ok then return false, __json_record_error_at(decoded, i - 1) end
            if out then
            elseif not reading or json_items then
                result[i * 2 - 1], result[i * 2] = tag or decoded, tag and decoded or false
            elseif columns then
                for _, path in ipairs(columns) do result[path][i] = __json_record_row_leaf(decoded, path) end
            elseif offsets then
                for path, offset in pairs(offsets) do result[(i - 1) * stride + offset] = __json_record_row_leaf(decoded, path) end
            else result[i] = decoded end
        end
        if out then __json_record_put(codec, ']'); return true end
        if not reading then return true, __json_record_node('Array', __json_record_json_vec(result, len), row) end
        if json_items then return true, __json_record_json_vec(result, len) end
        if columns then
            result.len = len
            result['@vec'] = { repr = 'columns', elem = shape.elem.name, cap = len }
            return true, result
        end
        if offsets then
            return true, { _data = result, len = len,
                ['@vec'] = { repr = 'strided', elem = shape.elem.name, stride = stride, cap = len } }
        end
        return true, __json_record_vec(result, len)
    end
    if kind == 'map' then
        if shape.key.k ~= 'string' then error('json record maps require string keys', 0) end
        local element = shape.val.k == 'nom' and _G.__ROCK_TYPE_TABLE[shape.val.name]
        if element and (element.kind == 'c_struct' or element.kind == 'c_enum') then
            error('json record does not support native value maps', 0)
        end
        if reading and input_tag ~= 'Object' then return false, __json_record_failure(shape, value, index, codec) end
        local items = reading and input_payload or value
        if out then
            local keys = {}
            for key in pairs(items) do keys[#keys + 1] = key end
            table.sort(keys)
            __json_record_put(codec, '{')
            for i, key in ipairs(keys) do
                __json_record_put(codec, (i > 1 and ',' or '') .. codec.sink.string_text(key) .. ':')
                local ok, failure = __json_record_visit(codec, shape.val, items[key], false, seen, depth + 1)
                if not ok then return false, __json_record_error_at(failure, key) end
            end
            __json_record_put(codec, '}')
            return true
        end
        local result = {}
        for key, item in pairs(items) do
            local ok, decoded = __json_record_visit(codec, shape.val, item, reading, seen, depth + 1)
            if not ok then return false, __json_record_error_at(decoded, key) end
            result[key] = decoded
        end
        if reading then return true, result end
        return true, __json_record_node('Object', result, row)
    end
    if kind ~= 'nom' then error('json record unsupported shape: ' .. tostring(kind), 0) end
    local name = shape.name
    local adapter = codec.adapters and codec.adapters[name]
    if adapter then
        if out then __json_record_put(codec, codec.sink.value_text(adapter.encode(value))); return true end
        if not reading then return true, (adapter.encode(value)) end
        local result = adapter.decode(__json_record_input_value(codec, value, index))
        if result == nil then return false, __json_record_failure(shape, value, index, codec) end
        return true, result
    end
    local decl = _G.__ROCK_TYPE_TABLE[name]
    if not decl then error('json record missing declaration: ' .. name, 0) end
    if decl.kind == 'enum_tag' then
        if reading then
            local label = __json_record_label(codec, input_tag, input_payload)
            if label == nil or input_payload.len ~= 1 then return false, __json_record_failure(shape, value, index, codec) end
            for tag, name in pairs(decl.variants) do if name == label then return true, tag end end
            return false, __json_record_failure(shape, value, index, codec)
        end
        local label = decl.variants[value]
        if not label then return false, __json_record_failure(shape, value, index, codec) end
        if out then __json_record_put(codec, '[' .. codec.sink.string_text(label) .. ']'); return true end
        return true, __json_record_node('Array', __json_record_json_vec({'Str', label}, 1), row)
    end
    -- Only references can form cycles; values are copies.
    local tracked = not reading and decl.kind == 'struct'
    if not reading then
        if value == nil then error('json record missing value for ' .. name .. ' at depth ' .. depth, 0) end
        if tracked then
            if seen[value] then error('json record cannot encode cycles', 0) end
            seen[value] = true
        end
    end
    local result, wire_tag
    if decl.kind == 'enum' or decl.kind == 'c_enum' then
        local tag, fields, payload, selected, json_bool_wire
        if decl.kind == 'c_enum' then
            if reading then
                local label = __json_record_label(codec, input_tag, input_payload)
                if label == nil then return false, __json_record_failure(shape, value, index, codec) end
                for index, candidate in pairs(decl.variants) do
                    if candidate.name == label then tag, selected = index, candidate; break end
                end
            else
                tag = tonumber(value.__tag)
                selected = decl.variants[tag]
            end
            if not selected then return false, __json_record_failure(shape, value, index, codec) end
            fields, payload = selected.fields, selected.json_payload
            if not payload then
                payload = {}
                for i, field in ipairs(fields) do
                    if field.name ~= tostring(i) then error('json record does not support record enum payloads', 0) end
                    payload[i] = field.desc or (_G.__ROCK_TYPE_TABLE[field.type]
                        and { k = 'nom', name = field.type } or { k = field.type })
                end
                selected.json_payload = payload
            end
        else
            if reading then
                tag = __json_record_label(codec, input_tag, input_payload)
                if tag == nil then return false, __json_record_failure(shape, value, index, codec) end
            else tag = value.__variant end
            -- Typed JsonValue records use ["Bool", value] on the wire.
            if name == 'JsonValue' then
                local unit = tag == 'True' or tag == 'False'
                if reading and unit then return false, __json_record_failure(shape, value, index, codec) end
                json_bool_wire = (reading and tag == 'Bool') or (not reading and unit)
                if json_bool_wire then tag = 'Bool' end
            end
            selected = json_bool_wire and { pos = {{ k = 'bool' }} } or decl.variant_desc[tag]
            if not selected then
                if not reading then error('json record invalid variant ' .. name .. ':' .. tostring(tag), 0) end
                return false, __json_record_failure(shape, value, index, codec)
            end
            if not selected.pos then error('json record does not support record enum payloads', 0) end
            payload = selected.pos
        end
        local count = #payload
        if reading and input_payload.len ~= count + 1 then return false, __json_record_failure(shape, value, index, codec) end
        local data
        if reading then
            if fields then
                result = _G[name .. '_ct']()
                result.__tag = tag
            elseif not json_bool_wire then
                result = (count == 0 and __rock_enum_unit(name, tag)) or setmetatable({ __variant = tag }, __rock_box_mts[name])
            end
        elseif out then __json_record_put(codec, '[' .. codec.sink.string_text(fields and selected.name or tag))
        else data = {'Str', fields and selected.name or tag} end
        for i = 1, count do
            if out then __json_record_put(codec, ',') end
            local item
            if reading then item = input_payload
            elseif fields then item = value[fields[i].slot]
            elseif json_bool_wire then item = value.__variant == 'True'
            else item = __json_record_payload_get(value, payload[i], i, codec, depth) end
            local ok, decoded, child_tag = __json_record_visit(codec, payload[i], item, reading, seen, depth + 1, nil, not reading, reading and i + 1 or nil)
            if not ok then
                if not reading then error('json record invalid payload ' .. name .. '.' .. tostring(tag) .. '[' .. i .. ']', 0) end
                return false, __json_record_error_at(decoded, i)
            end
            if out then
            elseif not reading then data[i * 2 + 1], data[i * 2 + 2] = child_tag or decoded, child_tag and decoded or false
            elseif fields then result[fields[i].slot] = decoded
            elseif json_bool_wire then result = json_bool(decoded)
            else __json_record_payload_put(result, payload[i], i, decoded) end
        end
        if out then __json_record_put(codec, ']')
        elseif not reading then
            result, wire_tag = __json_record_json_vec(data, count + 1), 'Array'
        end
    elseif decl.kind == 'struct' or decl.kind == 'value_table' or decl.kind == 'c_struct' then
        if reading and input_tag ~= 'Object' then return false, __json_record_failure(shape, value, index, codec) end
        if codec.field_names then
            local names = codec.field_names[name]
            if not names then
                names = {}
                for _, field in ipairs(decl.fields) do
                    if not field.json_skip then names[field.json_name or field.name] = true end
                end
                codec.field_names[name] = names
            end
            for key in pairs(input_payload) do
                if not names[key] then
                    return false, __json_record_error_at(setmetatable({ path = '',
                        expected = 'declared field', actual = 'unknown field' }, __rock_box_mts.JsonRecordError), key)
                end
            end
        end
        local data = reading and decl.kind == 'c_struct' and _G[name .. '_ct']() or not out and {}
        local slots = __rock_box_mts[name].__rock_slots
        local first = true
        if out then __json_record_put(codec, '{') end
        for _, field in ipairs(out and __json_record_write_fields(codec, decl) or decl.fields) do
            if field.json_skip then
                if reading then __json_record_field_put(data, field, _G[field.json_default](), slots) end
            else
                local wire_name = field.json_name or field.name
                local item
                if reading then item = input_payload[wire_name]
                elseif type(value) == 'table' then item = __json_record_field_get(value, field, slots, codec, depth)
                else item = value[field.name] end
                local child = field.desc
                if not child then
                    child = _G.__ROCK_TYPE_TABLE[field.type] and { k = 'nom', name = field.type } or { k = field.type }
                end
                if field.nullable and child.k ~= 'opt' then child = { k = 'opt', inner = child } end
                local absent = not reading and child.k == 'field' and not item.present
                if not absent and (reading or not field.json_omit or not _G[field.json_omit](item)) then
                    if decl.kind == 'c_struct' and field.nullable then
                        error('json record does not support nullable native fields', 0)
                    end
                    local fallback
                    if reading and defaults ~= nil then fallback = __json_record_field_get(defaults, field, slots) end
                    local ok, decoded
                    if reading and item == nil then
                        if defaults ~= nil then ok, decoded = true, __json_record_copy_default(fallback)
                        elseif field.json_default then ok, decoded = true, _G[field.json_default]()
                        elseif child.k == 'field' then
                            ok, decoded = __json_record_visit(codec, child, nil, true, seen, depth + 1)
                        else return false, __json_record_error_at(__json_record_failure(child, nil), wire_name) end
                    else
                        if out then
                            __json_record_put(codec, first and field.json_write_key or field.json_write_next_key)
                            first = false
                        end
                        ok, decoded = __json_record_visit(codec, child, item, reading, seen, depth + 1, fallback)
                    end
                    if not ok then
                        if not reading then error('json record invalid field ' .. name .. '.' .. field.name, 0) end
                        return false, __json_record_error_at(decoded, wire_name)
                    end
                    if reading then __json_record_field_put(data, field, decoded, slots)
                    elseif not out then data[wire_name] = decoded end
                end
            end
        end
        if reading then
            if decl.kind ~= 'c_struct' then setmetatable(data, __rock_box_mts[name]) end
            result = data
        elseif out then __json_record_put(codec, '}')
        else result, wire_tag = data, 'Object' end
    else error('json record unsupported declaration: ' .. name, 0) end
    if not reading then
        if tracked then seen[value] = nil end
        if out then return true end
        return true, __json_record_node(wire_tag, result, row)
    end
    return true, result
"""

@lua_named struct __JsonRecordContext {
    adapters: Map<string, JsonRecordAdapter>?,
    field_names: Map<string, Map<string, bool>>?,
    encode_float: fn(float) -> JsonValue,
    decode_float: fn(JsonValue) -> float?,
    src: string? = null,
    source: __JsonRecordSource? = null,
    parse_raw: (fn(string) -> JsonValue?)? = null,
    out: [string]? = null,
    chunks: [string]? = null,
    n: int = 0,
    sink: __JsonRecordSink? = null,
}

// Writing text reaches the encoders only through these, so programs that
// never call json_record_write do not carry the writer's callbacks.
@lua_named struct __JsonRecordSink {
    default_float: fn(float) -> JsonValue,
    float_text: fn(float) -> string,
    int_text: fn(int) -> string,
    string_text: fn(string) -> string,
    value_text: fn(JsonValue) -> string,
}

// Reading from source text reaches the parser only through these, so programs
// that never call json_record_read do not carry it.
@lua_named struct __JsonRecordSource {
    finite_float: fn(JsonValue) -> float?,
    float_at: fn(string, int, int) -> float,
    string_at: fn(string, int) -> string,
    value_at: fn(string, int) -> JsonValue,
}

fn json_record_source_string(src: string, at: int) -> string {
    let (value, _) = parse_string_raw_at(src, at)
    return value.unwrap()
}

// The lookup is kept on the codec and reused while its adapters are the same
// objects, so a codec encoding many small records builds it once.
@nomangle @lua_helper inline(lua) fn __json_record_adapters(codec: JsonRecordCodec) -> Map<string, JsonRecordAdapter>? = """
    local adapters = codec.adapters
    local count = adapters[0]
    if count == 0 then return nil end
    local lookup = rawget(codec, '__json_adapters')
    if lookup and rawget(codec, '__json_adapter_count') == count then
        for i = 1, count do
            local adapter = adapters[i]
            if lookup[adapter.name] ~= adapter then lookup = nil break end
        end
        if lookup then return lookup end
    end
    lookup = {}
    for i = 1, count do
        local adapter = adapters[i]
        if lookup[adapter.name] then error('json record duplicate adapter: ' .. adapter.name) end
        lookup[adapter.name] = adapter
    end
    rawset(codec, '__json_adapters', lookup)
    rawset(codec, '__json_adapter_count', count)
    return lookup
"""

fn __json_record_adapter_map(codec: JsonRecordCodec) -> Map<string, JsonRecordAdapter>? {
    if codec.adapters.len() == 0 { return null }
    let lookup: Map<string, JsonRecordAdapter> = map_new()
    for adapter in codec.adapters {
        if lookup.contains(adapter.name) { error("json record duplicate adapter: {adapter.name}") }
        lookup[adapter.name] = adapter
    }
    return lookup
}

@nomangle fn __json_record_context(codec: JsonRecordCodec, reading: bool) -> __JsonRecordContext {
    return __JsonRecordContext {
        adapters: if __json_record_lua_backend() { __json_record_adapters(codec) } else { __json_record_adapter_map(codec) },
        field_names: if reading && codec.reject_unknown_fields { map_new() } else { null },
        encode_float: codec.encode_float,
        decode_float: codec.decode_float,
    }
}

// Encoding reuses one context per codec, so encoding many small records does
// not rebuild it. A context still busy (a nested call, or one left by an
// error) is replaced rather than shared.
@nomangle @lua_helper inline(lua) fn __json_record_encoder(codec: JsonRecordCodec, name: string) -> any = """
    local context = rawget(codec, '__json_encoder')
    if context == nil or context.busy or context.encode_float ~= codec.encode_float then
        context = __json_record_context(codec, false)
        context.seen, context.roots, context.scratch = {}, {}, {}
        rawset(codec, '__json_encoder', context)
    else
        context.adapters = __json_record_adapters(codec)
    end
    context.busy = true
    local root = context.roots[name]
    if not root then
        root = { k = 'nom', name = name }
        context.roots[name] = root
    end
    return context, root
"""

inline(lua) fn __json_record_encode<T>(name: string, codec: JsonRecordCodec, value: T) -> JsonValue = """
    local context, root = __json_record_encoder(codec, name)
    local ok, result = __json_record_visit(context, root, value, false, context.seen, 0)
    if not ok then error('invalid value for json record encoding', 0) end
    context.busy = false
    return result
"""

// Raw input is parsed with parse_raw, so a document holding json_raw text
// decodes like the same document parsed from its encoding.
inline(lua) fn __json_record_decode<T>(name: string, codec: JsonRecordCodec, value: JsonValue,
    parse_raw: fn(string) -> JsonValue?) -> T? = """
    local context = __json_record_context(codec, true)
    context.parse_raw = parse_raw
    local ok, result = __json_record_visit(context, { k = 'nom', name = name }, value, true, nil, 0)
    if ok then return result end
    if codec.on_error then codec.on_error(result) end
    return nil
"""

inline(lua) fn __json_record_read<T>(name: string, codec: JsonRecordCodec, src: string, at: int,
    source: __JsonRecordSource) -> T? = """
    local context = __json_record_context(codec, true)
    context.src, context.source = src, source
    local ok, result = __json_record_visit(context, { k = 'nom', name = name }, at, true, nil, 0)
    if ok then return result end
    if codec.on_error then codec.on_error(result) end
    return nil
"""

inline(lua) fn __json_record_lua_backend() -> bool = "return true"

inline(lua) fn __json_record_write<T>(name: string, codec: JsonRecordCodec, value: T, sink: __JsonRecordSink) -> string = """
    local context, root = __json_record_encoder(codec, name)
    context.out, context.n, context.chunks, context.sink = context.buffer or {}, 0, nil, sink
    local ok = __json_record_visit(context, root, value, false, context.seen, 0)
    if not ok then error('invalid value for json record encoding', 0) end
    local out, chunks = context.out, context.chunks
    context.out, context.busy = nil, false
    local text = table.concat(out, '', 1, context.n)
    if not chunks then
        context.buffer = out
        return text
    end
    chunks[#chunks + 1] = text
    return table.concat(chunks)
"""

fn json_record_encode<T>(codec: JsonRecordCodec, value: T) -> JsonValue {
    return __json_record_encode(__json_record_type(value), codec, materialize(value))
}

fn json_record_decode<T>(codec: JsonRecordCodec, value: JsonValue, prototype: T) -> T? {
    return __json_record_decode<T>(__json_record_type(prototype), codec, value, json_decode)
}

fn json_record_decode<T>(codec: JsonRecordCodec, value: JsonValue) -> T? {
    return __json_record_decode<T>(__json_record_type(phantom<T>()), codec, value, json_decode)
}

// Decodes straight from a reader's source text, without materializing a
// JsonValue tree; the result and diagnostics match json_record_decode.
fn json_record_read<T>(codec: JsonRecordCodec, reader: JsonReader) -> T? {
    if reader.value == null && reader.at >= 0 && __json_record_lua_backend() {
        let source = __JsonRecordSource {
            finite_float: json_record_finite_float,
            float_at: (src, at, end) => src.parse_float_at(at, end),
            string_at: json_record_source_string,
            value_at: (src, at) => json_reader_materialize(JsonReader { src, at }),
        }
        return __json_record_read<T>(__json_record_type(phantom<T>()), codec, reader.src.unwrap(), reader.at, source)
    }
    return json_record_decode<T>(codec, json_reader_materialize(reader))
}

// The JSON text json_encode(json_record_encode(codec, value)) would produce,
// written without building the JsonValue tree.
global __json_record_sink: __JsonRecordSink? = null

fn json_record_write<T>(codec: JsonRecordCodec, value: T) -> string {
    if !__json_record_lua_backend() { return json_encode(json_record_encode(codec, value)) }
    let sink = __json_record_sink ?? {
        let created = __JsonRecordSink {
            default_float: json_float,
            float_text: f => format_float(f),
            int_text: json_int_text,
            string_text: encode_string,
            value_text: json_encode,
        }
        __json_record_sink = created
        created
    }
    return __json_record_write(__json_record_type(value), codec, materialize(value), sink)
}
