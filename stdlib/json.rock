// Pure-Rock JSON library.
//
// JsonValue is the typed surface; json_encode / json_decode are the entry
// points. No inline(lua) — portable across Rock backends. Canonical example of
// a Layer-2 pure-Rock stdlib module.

enum JsonValue {
    Null,
    Bool(bool),
    Int(int),
    Float(float),
    Str(string),
    Array([JsonValue]),
    Object(Map<string, JsonValue>),
}

// ---------------------------------------------------------------------------
// Constructors

fn json_null() -> JsonValue { return JsonValue::Null }
fn json_bool(b: bool) -> JsonValue { return JsonValue::Bool(b) }
fn json_int(i: int) -> JsonValue { return JsonValue::Int(i) }
fn json_float(f: float) -> JsonValue { return JsonValue::Float(f) }
fn json_str(s: string) -> JsonValue { return JsonValue::Str(s) }
fn json_array(items: [JsonValue]) -> JsonValue { return JsonValue::Array(items) }
fn json_object(m: Map<string, JsonValue>) -> JsonValue { return JsonValue::Object(m) }

// ---------------------------------------------------------------------------
// Accessors. Return null on type mismatch so callers can chain `??` defaults.

fn json_is_null(v: JsonValue) -> bool {
    match v {
        Null => return true,
        _ => return false,
    }
}

fn json_as_bool(v: JsonValue) -> bool? {
    match v {
        Bool(b) => return b,
        _ => return null,
    }
}

fn json_as_int(v: JsonValue) -> int? {
    match v {
        Int(i) => return i,
        Float(f) => return f as int,
        _ => return null,
    }
}

fn json_as_float(v: JsonValue) -> float? {
    match v {
        Int(i) => return i as float,
        Float(f) => return f,
        _ => return null,
    }
}

fn json_as_str(v: JsonValue) -> string? {
    match v {
        Str(s) => return s,
        _ => return null,
    }
}

fn json_as_array(v: JsonValue) -> [JsonValue]? {
    match v {
        Array(items) => return items,
        _ => return null,
    }
}

fn json_as_object(v: JsonValue) -> Map<string, JsonValue>? {
    match v {
        Object(m) => return m,
        _ => return null,
    }
}

// Look up a field in an object. Returns null if v is not an object or key
// is absent.
fn json_field(v: JsonValue, key: string) -> JsonValue? {
    let m = json_as_object(v)
    if m == null { return null }
    let mm = m.unwrap()
    if !mm.contains(key) { return null }
    return mm[key]
}

// ---------------------------------------------------------------------------
// Encoder

fn json_encode(v: JsonValue) -> string {
    let parts: [string] = []
    encode_into(v, parts)
    return join(parts, "")
}

fn encode_into(v: JsonValue, parts: [string]) {
    match v {
        Null => parts.push("null"),
        Bool(b) => parts.push(if b { "true" } else { "false" }),
        Int(i) => parts.push("{i}"),
        Float(f) => parts.push(format_float(f)),
        Str(s) => parts.push(encode_string(s)),
        Array(items) => encode_array(items, parts),
        Object(m) => encode_object(m, parts),
    }
}

fn encode_array(items: [JsonValue], parts: [string]) {
    parts.push("[")
    let first = true
    for item in items {
        if !first { parts.push(",") }
        first = false
        encode_into(item, parts)
    }
    parts.push("]")
}

fn encode_object(m: Map<string, JsonValue>, parts: [string]) {
    // Sort keys for deterministic output.
    let keys = keys(m)
    sort(keys, k => k)
    parts.push("{{")
    let first = true
    for k in keys {
        if !first { parts.push(",") }
        first = false
        parts.push(encode_string(k))
        parts.push(":")
        encode_into(m[k], parts)
    }
    parts.push("}}")
}

// Pretty-print: containers expand one child per line, but a container whose
// children are all scalars stays compact on a single line (so a tile/spawner
// object renders as `{"type":"wall","x":0,"y":0}`, not four lines). Keeps
// diffs line-oriented and deterministic (object keys stay sorted).
// An array under an object key named in `compact_items_of` keeps each item on
// one compact line even when the item nests containers.
fn json_encode_pretty(v: JsonValue, compact_items_of: [string] = []) -> string {
    let parts: [string] = []
    encode_pretty_into(v, parts, 0, compact_items_of)
    return join(parts, "")
}

fn encode_pretty_into(v: JsonValue, parts: [string], level: int, compact_items_of: [string],
                      compact_items: bool = false) {
    match v {
        Array(items) => {
            if json_has_nested_container(v) {
                encode_pretty_array(items, parts, level, compact_items_of, compact_items)
            } else {
                encode_array(items, parts)
            }
        },
        Object(m) => {
            if json_has_nested_container(v) {
                encode_pretty_object(m, parts, level, compact_items_of)
            } else {
                encode_object(m, parts)
            }
        },
        _ => encode_into(v, parts),
    }
}

fn json_has_nested_container(v: JsonValue) -> bool {
    return match v {
        Array(items) => {
            for it in items {
                match it {
                    Array(_) => return true,
                    Object(_) => return true,
                    _ => {}
                }
            }
            false
        },
        Object(m) => {
            for k in keys(m) {
                match m[k] {
                    Array(_) => return true,
                    Object(_) => return true,
                    _ => {}
                }
            }
            false
        },
        _ => false,
    }
}

fn encode_pretty_array(items: [JsonValue], parts: [string], level: int,
                       compact_items_of: [string], compact_items: bool) {
    parts.push("[\n")
    let inner = json_indent(level + 1)
    let first = true
    for item in items {
        if !first { parts.push(",\n") }
        first = false
        parts.push(inner)
        if compact_items {
            encode_into(item, parts)
        } else {
            encode_pretty_into(item, parts, level + 1, compact_items_of)
        }
    }
    parts.push("\n")
    parts.push(json_indent(level))
    parts.push("]")
}

fn encode_pretty_object(m: Map<string, JsonValue>, parts: [string], level: int,
                        compact_items_of: [string]) {
    let ks = keys(m)
    sort(ks, k => k)
    parts.push("{{\n")
    let inner = json_indent(level + 1)
    let first = true
    for k in ks {
        if !first { parts.push(",\n") }
        first = false
        parts.push(inner)
        parts.push(encode_string(k))
        parts.push(": ")
        encode_pretty_into(m[k], parts, level + 1, compact_items_of, json_key_listed(compact_items_of, k))
    }
    parts.push("\n")
    parts.push(json_indent(level))
    parts.push("}}")
}

fn json_key_listed(keys: [string], key: string) -> bool {
    for k in keys {
        if k == key { return true }
    }
    return false
}

fn json_indent(level: int) -> string {
    let parts: [string] = []
    let i = 0
    while i < level {
        parts.push("  ")
        i = i + 1
    }
    return join(parts, "")
}

fn encode_string(s: string) -> string {
    let n = s.len()
    let i = 0
    while i < n {
        let b = s.unit_at(i)
        if b < 32 || b == 34 || b == 92 { break }
        i += 1
    }
    if i == n { return "\"" + s + "\"" }
    let parts: [string] = []
    parts.push("\"")
    if i > 0 { parts.push(s.substring(0, i)) }
    while i < n {
        let b = s.unit_at(i)
        if b == 34 {
            parts.push("\\\"")
        } else if b == 92 {
            parts.push("\\\\")
        } else if b == 8 {
            parts.push("\\b")
        } else if b == 9 {
            parts.push("\\t")
        } else if b == 10 {
            parts.push("\\n")
        } else if b == 12 {
            parts.push("\\f")
        } else if b == 13 {
            parts.push("\\r")
        } else if b < 32 {
            parts.push("\\u")
            parts.push(hex4(b))
        } else {
            parts.push(s.substring(i, i + 1))
        }
        i = i + 1
    }
    parts.push("\"")
    return join(parts, "")
}

fn hex4(n: int) -> string {
    let digits = "0123456789abcdef"
    let i0 = (n ./ 4096) % 16
    let i1 = (n ./ 256) % 16
    let i2 = (n ./ 16) % 16
    let i3 = n % 16
    let d0 = digits.substring(i0, i0 + 1)
    let d1 = digits.substring(i1, i1 + 1)
    let d2 = digits.substring(i2, i2 + 1)
    let d3 = digits.substring(i3, i3 + 1)
    return "{d0}{d1}{d2}{d3}"
}

// Format a float without a trailing `.0` for whole numbers, while keeping
// fractional parts intact. NaN / inf are emitted as null (JSON has no
// representation for them).
fn format_float(f: float) -> string {
    if f != f { return "null" }
    if f == 1.0 / 0.0 || f == -1.0 / 0.0 { return "null" }
    let i = f as int
    if (i as float) == f {
        return "{i}"
    }
    return "{f}"
}

// ---------------------------------------------------------------------------
// Decoder

struct JsonParser {
    src: string,
    pos: int,
    len: int,
    ok: bool,
    depth: int,
}

// Container nesting a document may reach before it is rejected as malformed.
// The decoder is recursive, so without this a deep document overflows the
// interpreter stack and takes the process down instead of returning null.
//
// Sized for the shallower backend, not the roomier one: measured, LuaJIT
// overflows near 4500 levels and the JS backend between 900 and 1000 -- and
// the JS figure is not a constant, it shrinks as the caller's own stack grows,
// so a limit set just under it would hold from main and fail from inside a
// game. 256 keeps ~3.7x margin against the shallowest observed ceiling while
// staying 50x above the deepest JSON in this repo, which is 5.
fn json_max_depth() -> int { return 256 }

fn json_decode(s: string) -> JsonValue? {
    let p = JsonParser { src: s, pos: 0, len: s.len(), ok: true, depth: 0 }
    parse_skip_ws(p)
    let v = parse_value(p)
    parse_skip_ws(p)
    if !p.ok { return null }
    if p.pos != p.len { return null }
    return v
}

// Typed readers expose this loop at their call sites to avoid whitespace
// function-entry blacklisting. The graph parser retains its call boundary:
// global inlining regresses mixed-document workloads (see the benchmark plan).
@inline fn parse_skip_ws_inline_at(src: string, at: int) -> int {
    let pos = at
    let len = src.len()
    while pos < len {
        let b = src.unit_at(pos)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            pos = pos + 1
        } else {
            break
        }
    }
    return pos
}

fn parse_skip_ws_at(src: string, at: int) -> int {
    return parse_skip_ws_inline_at(src, at)
}

@inline fn parse_skip_ws(p: JsonParser) {
    p.pos = parse_skip_ws_at(p.src, p.pos)
}

fn parse_value(p: JsonParser) -> JsonValue {
    parse_skip_ws(p)
    if p.pos >= p.len {
        p.ok = false
        return JsonValue::Null
    }
    let b = p.src.unit_at(p.pos)
    if b == 110 { return parse_keyword(p, "null", JsonValue::Null) }
    if b == 116 { return parse_keyword(p, "true", JsonValue::Bool(true)) }
    if b == 102 { return parse_keyword(p, "false", JsonValue::Bool(false)) }
    if b == 34 { return parse_string_value(p) }
    if b == 91 || b == 123 {
        // One place owns the depth counter, so the container parsers keep
        // their many return points. The over-limit path leaves it
        // un-decremented, which is harmless: p.ok is false and the parse is
        // already unwinding.
        p.depth = p.depth + 1
        if p.depth > json_max_depth() {
            p.ok = false
            return JsonValue::Null
        }
        let v = if b == 91 { parse_array_value(p) } else { parse_object_value(p) }
        p.depth = p.depth - 1
        return v
    }
    // number: starts with - or 0..9
    if b == 45 || (b >= 48 && b <= 57) {
        return parse_number(p)
    }
    p.ok = false
    return JsonValue::Null
}

fn parse_keyword(p: JsonParser, kw: string, value: JsonValue) -> JsonValue {
    let klen = kw.len()
    if p.pos + klen > p.len {
        p.ok = false
        return JsonValue::Null
    }
    let slice = p.src.substring(p.pos, p.pos + klen)
    if slice != kw {
        p.ok = false
        return JsonValue::Null
    }
    p.pos = p.pos + klen
    return value
}

fn parse_string_value(p: JsonParser) -> JsonValue {
    let s = parse_string_raw(p)
    if s == null { return JsonValue::Null }
    return JsonValue::Str(s.unwrap())
}

// Returns the decoded string and the offset reached, including on rejection.
fn parse_string_raw_at(src: string, at: int, materialize: bool = true) -> (string?, int) {
    let pos = at
    let len = src.len()
    if src.unit_at(pos) != 34 {
        return (null, pos)
    }
    pos = pos + 1

    // `parts` stays null until the literal turns out to carry an escape. Every
    // object key and most short values have none, and those return a single
    // substring having allocated neither the array nor the join -- worth 2.1x
    // on a structure-heavy document (level.json 2.94 -> 1.38ms).
    let body_start = pos
    let segment_start = pos
    let parts: [string]? = null
    while pos < len {
        let b = src.unit_at(pos)
        if b == 34 {
            if !materialize { return ("", pos + 1) }
            if parts == null {
                let plain = src.substring(body_start, pos)
                pos = pos + 1
                return (plain, pos)
            }
            if pos > segment_start { parts.unwrap().push(src.substring(segment_start, pos)) }
            pos = pos + 1
            return (join(parts.unwrap(), ""), pos)
        }
        if b == 92 {
            if materialize && parts == null {
                let fresh: [string] = []
                if pos > body_start { fresh.push(src.substring(body_start, pos)) }
                parts = fresh
            } else if parts != null && pos > segment_start {
                parts.unwrap().push(src.substring(segment_start, pos))
            }
            pos = pos + 1
            if pos >= len {
                return (null, pos)
            }
            let esc = src.unit_at(pos)
            pos = pos + 1
            if esc == 34 { if materialize { parts.unwrap().push("\"") } }
            else if esc == 92 { if materialize { parts.unwrap().push("\\") } }
            else if esc == 47 { if materialize { parts.unwrap().push("/") } }
            else if esc == 110 { if materialize { parts.unwrap().push("\n") } }
            else if esc == 114 { if materialize { parts.unwrap().push("\r") } }
            else if esc == 116 { if materialize { parts.unwrap().push("\t") } }
            else if esc == 98 { if materialize { parts.unwrap().push(string_char(8)) } }
            else if esc == 102 { if materialize { parts.unwrap().push(string_char(12)) } }
            else if esc == 117 {
                if pos + 4 > len {
                    return (null, pos)
                }
                let hi = parse_hex4_at(src, pos)
                pos = pos + 4
                if hi == null {
                    return (null, pos)
                }
                let cp = hi.unwrap()
                if cp >= 0xD800 && cp <= 0xDBFF {
                    if pos + 6 > len || src.unit_at(pos) != 92 || src.unit_at(pos + 1) != 117 {
                        return (null, pos)
                    }
                    let lo = parse_hex4_at(src, pos + 2)
                    if lo == null || lo.unwrap() < 0xDC00 || lo.unwrap() > 0xDFFF {
                        return (null, pos)
                    }
                    pos = pos + 6
                    cp = 0x10000 + (cp - 0xD800) * 0x400 + (lo.unwrap() - 0xDC00)
                } else if cp >= 0xDC00 && cp <= 0xDFFF {
                    // JSON permits lone surrogates; we reject them as a decode
                    // failure (malformed input is data, not a programmer error).
                    return (null, pos)
                }
                if materialize { parts.unwrap().push(from_codepoint(cp)) }
            } else {
                return (null, pos)
            }
            segment_start = pos
        } else if b < 32 {
            // JSON requires every byte below 0x20 to be escaped. 0x7F (DEL) is
            // above the range and stays legal raw.
            return (null, pos)
        } else {
            pos = pos + 1
        }
    }
    return (null, pos)
}

@inline fn parse_string_raw(p: JsonParser) -> string? {
    let (value, pos) = parse_string_raw_at(p.src, p.pos)
    p.pos = pos
    if value == null { p.ok = false }
    return value
}

fn parse_hex4(s: string) -> int? {
    if s.len() != 4 { return null }
    return parse_hex4_at(s, 0)
}

fn parse_hex4_at(s: string, at: int) -> int? {
    let result = 0
    let i = 0
    while i < 4 {
        let b = s.unit_at(at + i)
        let d = 0
        if b >= 48 && b <= 57 {
            d = b - 48
        } else if b >= 97 && b <= 102 {
            d = b - 97 + 10
        } else if b >= 65 && b <= 70 {
            d = b - 65 + 10
        } else {
            return null
        }
        result = result * 16 + d
        i = i + 1
    }
    return result
}

@inline fn parse_number_scan_at(src: string, at: int) -> (int, bool, bool) {
    let pos = at
    let len = src.len()
    // The grammar is `[-] int [frac] [exp]`, and it is enforced here rather
    // than left to parse_float: Lua's tonumber accepts `2.e3`, `.5` and `01`,
    // so a permissive scan makes the verdict the host runtime's rather than
    // JSON's.
    let is_float = false
    if pos < len && src.unit_at(pos) == 45 {
        pos = pos + 1
    }

    // int: a lone 0, or a nonzero digit followed by any digits. Never empty,
    // never a leading zero.
    if pos >= len {
        return (pos, is_float, false)
    }
    let lead = src.unit_at(pos)
    if lead == 48 {
        pos = pos + 1
    } else if lead >= 49 && lead <= 57 {
        while pos < len {
            let b = src.unit_at(pos)
            if b >= 48 && b <= 57 {
                pos = pos + 1
            } else {
                break
            }
        }
    } else {
        return (pos, is_float, false)
    }

    // frac: the point must be followed by at least one digit.
    if pos < len && src.unit_at(pos) == 46 {
        is_float = true
        pos = pos + 1
        let frac_start = pos
        while pos < len {
            let b = src.unit_at(pos)
            if b >= 48 && b <= 57 {
                pos = pos + 1
            } else {
                break
            }
        }
        if pos == frac_start {
            return (pos, is_float, false)
        }
    }

    // Exponents require a digit after the optional sign, before conversion.
    if pos < len {
        let b = src.unit_at(pos)
        if b == 101 || b == 69 {
            is_float = true
            pos = pos + 1
            if pos < len {
                let sign = src.unit_at(pos)
                if sign == 43 || sign == 45 {
                    pos = pos + 1
                }
            }
            let exp_start = pos
            while pos < len {
                let b2 = src.unit_at(pos)
                if b2 >= 48 && b2 <= 57 {
                    pos = pos + 1
                } else {
                    break
                }
            }
            if pos == exp_start {
                return (pos, is_float, false)
            }
        }
    }

    return (pos, is_float, true)
}

@inline fn parse_number_scan(p: JsonParser) -> bool? {
    let (pos, is_float, ok) = parse_number_scan_at(p.src, p.pos)
    p.pos = pos
    if !ok { p.ok = false; return null }
    return is_float
}

fn parse_number(p: JsonParser) -> JsonValue {
    let start = p.pos
    let is_float = parse_number_scan(p) ?? return JsonValue::Null
    if is_float { return JsonValue::Float(p.src.parse_float_at(start, p.pos)) }
    let i = p.src.substring(start, p.pos).parse_int()
    if i == null { p.ok = false; return JsonValue::Null }
    return JsonValue::Int(i.unwrap())
}

fn parse_array_value(p: JsonParser) -> JsonValue {
    p.pos = p.pos + 1   // consume [
    let items: [JsonValue] = []
    parse_skip_ws(p)
    if p.pos < p.len && p.src.unit_at(p.pos) == 93 {
        p.pos = p.pos + 1
        return JsonValue::Array(items)
    }
    while p.pos < p.len {
        parse_skip_ws(p)
        let item = parse_value(p)
        if !p.ok { return JsonValue::Null }
        items.push(item)
        parse_skip_ws(p)
        if p.pos >= p.len {
            p.ok = false
            return JsonValue::Null
        }
        let b = p.src.unit_at(p.pos)
        if b == 93 {
            p.pos = p.pos + 1
            return JsonValue::Array(items)
        }
        if b != 44 {
            p.ok = false
            return JsonValue::Null
        }
        p.pos = p.pos + 1
    }
    p.ok = false
    return JsonValue::Null
}

fn parse_object_value(p: JsonParser) -> JsonValue {
    p.pos = p.pos + 1   // consume {
    let m: Map<string, JsonValue> = map_new()
    parse_skip_ws(p)
    if p.pos < p.len && p.src.unit_at(p.pos) == 125 {
        p.pos = p.pos + 1
        return JsonValue::Object(m)
    }
    while p.pos < p.len {
        parse_skip_ws(p)
        let key = parse_string_raw(p)
        if key == null { return JsonValue::Null }
        parse_skip_ws(p)
        if p.pos >= p.len || p.src.unit_at(p.pos) != 58 {
            p.ok = false
            return JsonValue::Null
        }
        p.pos = p.pos + 1
        parse_skip_ws(p)
        let val = parse_value(p)
        if !p.ok { return JsonValue::Null }
        insert(m, key.unwrap(), val)
        parse_skip_ws(p)
        if p.pos >= p.len {
            p.ok = false
            return JsonValue::Null
        }
        let b = p.src.unit_at(p.pos)
        if b == 125 {
            p.pos = p.pos + 1
            return JsonValue::Object(m)
        }
        if b != 44 {
            p.ok = false
            return JsonValue::Null
        }
        p.pos = p.pos + 1
    }
    p.ok = false
    return JsonValue::Null
}

// ---- Field accessors with defaults -----------------------------------------
// Take the nullable result of json_field(...) (or any JsonValue?) and a
// fallback; return the extracted value or the default. Saves the verbose
// `json_as_int(json_field(root, key) ?? json_null()) ?? default` dance at
// every call site.

fn jv_str(v: JsonValue?, default_val: string) -> string {
    let vv = v ?? return default_val
    return json_as_str(vv) ?? default_val
}

fn jv_int(v: JsonValue?, default_val: int) -> int {
    let vv = v ?? return default_val
    let f = json_as_float(vv) ?? return default_val
    return int(f)
}

fn jv_float(v: JsonValue?, default_val: float) -> float {
    let vv = v ?? return default_val
    return json_as_float(vv) ?? default_val
}

fn jv_bool(v: JsonValue?, default_val: bool) -> bool {
    let vv = v ?? return default_val
    return json_as_bool(vv) ?? default_val
}

fn jv_float_arr(v: JsonValue?, default_val: [float]) -> [float] {
    let vv = v ?? return default_val
    let arr = json_as_array(vv) ?? return default_val
    let out: [float] = []
    for e in arr {
        if let f = json_as_float(e) { out.push(f) }
    }
    if out.len() == 0 { return default_val }
    return out
}

fn jv_str_arr(v: JsonValue?, default_val: [string]) -> [string] {
    let vv = v ?? return default_val
    let arr = json_as_array(vv) ?? return default_val
    let out: [string] = []
    for e in arr {
        if let s = json_as_str(e) { out.push(s) }
    }
    if out.len() == 0 { return default_val }
    return out
}

fn jv_int_pair(v: JsonValue?, def_w: int, def_h: int) -> (int, int) {
    if v == null { return (def_w, def_h) }
    let arr_opt = json_as_array(v.unwrap()) ?? return (def_w, def_h)
    let arr = arr_opt.unwrap()
    if arr.len() < 2 { return (def_w, def_h) }
    let i = 0
    let out_w = def_w
    let out_h = def_h
    for e in arr {
        if i == 0 {
            if let f = json_as_float(e) { out_w = int(f) }
        } else if i == 1 {
            if let f = json_as_float(e) { out_h = int(f) }
        }
        i = i + 1
    }
    return (out_w, out_h)
}

// A validated source position, or an adapter for an already materialized value.
// Object field indexes hold source offsets, never descendant values. Readers
// keep the source text, not a parser, so they store no identity struct.
nobox value JsonReader {
    src: string? = null,
    at: int = -1,
    value: JsonValue? = null,
    offsets: Map<int, JsonReaderOffsets>? = null,
}

nobox value JsonReaderOffsets {
    fields: Map<string, int>? = null,
    end: int = -1,
}

value JsonReaderArray {
    reader: JsonReader,
    values: [JsonValue]? = null,
    first: int = -1,
}

struct JsonReaderArrayIter {
    array: JsonReaderArray,
    pos: int,
    index: int = 0,
}

struct JsonReaderValidation {
    keys: [string] = [],
    indices: [int] = [],
    problem: string = "invalid JSON",
    root_fields: Map<string, int> = map_new(),
    track_path: bool = false,
    index_min_bytes: int = 0,
    offsets: Map<int, JsonReaderOffsets> = map_new(),
}

@inline fn json_reader_value(value: JsonValue) -> JsonReader { return JsonReader { value } }
@inline fn json_reader_null() -> JsonReader { return JsonReader {} }
@inline fn json_reader_int(value: int) -> JsonReader { return json_reader_value(json_int(value)) }
@inline fn json_reader_float(value: float) -> JsonReader { return json_reader_value(json_float(value)) }
@inline fn json_reader_str(value: string) -> JsonReader { return json_reader_value(json_str(value)) }
@inline fn json_reader_empty_array() -> JsonReaderArray { return JsonReaderArray { reader: json_reader_null() } }

fn json_reader_error_path(validation: JsonReaderValidation) -> string {
    let path = "$"
    for i in 0..validation.keys.len() {
        if validation.indices[i] >= 0 { path += "[{validation.indices[i]}]" }
        else { path += "[" + encode_string(validation.keys[i]) + "]" }
    }
    return path
}

fn json_reader_close_container(p: JsonParser, validation: JsonReaderValidation, start: int) {
    p.pos += 1
    p.depth -= 1
    if validation.index_min_bytes > 0 && p.pos - start >= validation.index_min_bytes {
        validation.offsets[start] = JsonReaderOffsets { end: p.pos }
    }
}

fn json_reader_validate_string(p: JsonParser) {
    let (value, end) = parse_string_raw_at(p.src, p.pos, false)
    p.pos = end
    if value == null { p.ok = false }
}

fn json_reader_validate(p: JsonParser, validation: JsonReaderValidation) {
    let starts: [int] = []
    let kinds: [int] = []
    let indices: [int] = []
    // 0: value or empty array, 1: separator, 2: key or empty object,
    // 3: key after comma, 4: value after comma.
    let state = 0
    let kind = 0
    while true {
        if state == 1 {
            if validation.track_path && validation.keys.len() == p.depth && p.depth > 0 {
                let _ = validation.keys.pop()
                let _ = validation.indices.pop()
            }
            if p.depth == 0 { return }
        }
        p.pos = parse_skip_ws_inline_at(p.src, p.pos)
        if p.pos >= p.len { p.ok = false; return }
        let b = p.src.unit_at(p.pos)
        if state == 1 {
            if b == 44 {
                p.pos += 1
                state = if kind == 91 { 4 } else { 3 }
                continue
            }
            if b != (if kind == 91 { 93 } else { 125 }) { p.ok = false; return }
            let start = starts.pop().unwrap()
            let _ = kinds.pop()
            let _ = indices.pop()
            json_reader_close_container(p, validation, start)
            kind = if p.depth > 0 { kinds[p.depth - 1] } else { 0 }
            continue
        }
        if state == 2 || state == 3 {
            if state == 2 && b == 125 {
                let start = starts.pop().unwrap()
                let _ = kinds.pop()
                let _ = indices.pop()
                json_reader_close_container(p, validation, start)
                kind = if p.depth > 0 { kinds[p.depth - 1] } else { 0 }
                state = 1
                continue
            }
            let key = ""
            if p.depth == 1 || validation.track_path { key = parse_string_raw(p) ?? return }
            else { json_reader_validate_string(p); if !p.ok { return } }
            p.pos = parse_skip_ws_inline_at(p.src, p.pos)
            if p.pos >= p.len || p.src.unit_at(p.pos) != 58 { p.ok = false; return }
            p.pos = parse_skip_ws_inline_at(p.src, p.pos + 1)
            if p.depth == 1 { validation.root_fields[key] = p.pos }
            if validation.track_path {
                validation.keys.push(key)
                validation.indices.push(-1)
            }
            state = 0
            continue
        }
        if kind == 91 {
            if state == 0 && b == 93 {
                let start = starts.pop().unwrap()
                let _ = kinds.pop()
                let _ = indices.pop()
                json_reader_close_container(p, validation, start)
                kind = if p.depth > 0 { kinds[p.depth - 1] } else { 0 }
                state = 1
                continue
            }
            if validation.track_path {
                validation.keys.push("")
                validation.indices.push(indices[p.depth - 1])
                indices[p.depth - 1] += 1
            }
        }
        state = 1
        if b == 34 { json_reader_validate_string(p); if !p.ok { return }; continue }
        if b == 110 || b == 116 || b == 102 {
            let keyword = if b == 110 { "null" } else if b == 116 { "true" } else { "false" }
            if p.pos + keyword.len() > p.len { p.ok = false; return }
            for i in 0..keyword.len() {
                if p.src.unit_at(p.pos + i) != keyword.unit_at(i) { p.ok = false; return }
            }
            p.pos += keyword.len()
            continue
        }
        if b == 45 || (b >= 48 && b <= 57) {
            let start = p.pos
            let is_float = parse_number_scan(p) ?? return
            if !is_float && p.pos - start >= 19 && p.src.substring(start, p.pos).parse_int() == null { p.ok = false; return }
            continue
        }
        if b != 91 && b != 123 { p.ok = false; return }
        starts.push(p.pos)
        kinds.push(b)
        kind = b
        indices.push(0)
        p.depth += 1
        if p.depth > json_max_depth() { p.ok = false; validation.problem = "maximum JSON depth exceeded"; return }
        p.pos += 1
        state = if b == 91 { 0 } else { 2 }
    }
}

fn json_reader_decode(src: string, rejected: fn(string, int, string)? = null, index_min_bytes: int = 0) -> JsonReader? {
    let p = JsonParser { src, pos: 0, len: src.len(), ok: true, depth: 0 }
    let validation = JsonReaderValidation { track_path: rejected != null, index_min_bytes }
    p.pos = parse_skip_ws_inline_at(p.src, p.pos)
    let at = p.pos
    json_reader_validate(p, validation)
    p.pos = parse_skip_ws_inline_at(p.src, p.pos)
    if !p.ok || p.pos != p.len {
        if let report = rejected { report(json_reader_error_path(validation), p.pos, validation.problem) }
        return null
    }
    if p.src.unit_at(at) == 123 {
        let root_offsets = validation.offsets.get(at) ?? JsonReaderOffsets {}
        validation.offsets[at] = JsonReaderOffsets { fields: validation.root_fields, end: root_offsets.end }
    }
    return JsonReader { src, at, offsets: validation.offsets }
}

// Source positions are created only after validation. This scan needs no
// scalar conversion, field map or container tree, including skipped fields.
fn json_reader_skip(src: string, at: int, offsets: Map<int, JsonReaderOffsets>? = null) -> int {
    let first = src.unit_at(at)
    if first == 91 || first == 123 {
        if let index = offsets {
            if let entry = index.get(at) { if entry.end >= 0 { return entry.end } }
        }
    }
    let pos = at
    let len = src.len()
    let depth = 0
    let quoted = false
    while pos < len {
        let b = src.unit_at(pos)
        if quoted {
            if b == 92 { pos += 2; continue }
            pos += 1
            if b == 34 { quoted = false; if depth == 0 { return pos } }
            continue
        }
        if b == 34 { quoted = true }
        else if b == 91 || b == 123 { depth += 1 }
        else if b == 93 || b == 125 {
            if depth == 0 { return pos }
            depth -= 1
            pos += 1
            if depth == 0 { return pos }
            continue
        } else if depth == 0 && (b == 44 || b == 32 || b == 9 || b == 10 || b == 13) { return pos }
        pos += 1
    }
    return pos
}

@inline fn json_reader_at(reader: JsonReader, at: int) -> JsonReader {
    return JsonReader { src: reader.src, at, offsets: reader.offsets }
}

@inline fn json_reader_fields(reader: JsonReader) -> Map<string, int>? {
    let offsets = reader.offsets ?? return null
    let entry = offsets.get(reader.at) ?? return null
    return entry.fields
}

fn json_reader_index(reader: JsonReader) -> JsonReader {
    if json_reader_fields(reader) != null { return reader }
    if reader.src == null || reader.at < 0 { return reader }
    let (indexed, _) = json_reader_index_at(reader)
    return indexed
}

// Returns the indexed object and its closing-brace offset.
fn json_reader_index_at(reader: JsonReader) -> (JsonReader, int) {
    let src = reader.src.unwrap()
    if src.unit_at(reader.at) != 123 { return (reader, reader.at) }
    let fields: Map<string, int> = map_new()
    let pos = parse_skip_ws_inline_at(src, reader.at + 1)
    while src.unit_at(pos) != 125 {
        let (key, end) = parse_string_raw_at(src, pos)
        pos = parse_skip_ws_inline_at(src, end)
        pos = parse_skip_ws_inline_at(src, pos + 1)
        fields[key.unwrap()] = pos
        pos = parse_skip_ws_inline_at(src, json_reader_skip(src, pos, reader.offsets))
        if src.unit_at(pos) == 44 { pos = parse_skip_ws_inline_at(src, pos + 1) }
    }
    let offsets = reader.offsets.unwrap()
    offsets[reader.at] = JsonReaderOffsets { fields, end: pos + 1 }
    return (reader, pos)
}

fn json_reader_field_offset(reader: JsonReader, key: string) -> int {
    if reader.at < 0 { return -1 }
    if let fields = json_reader_fields(reader) {
        let at = fields.get(key) ?? return -1
        return at
    }
    let src = reader.src.unwrap()
    if src.unit_at(reader.at) != 123 { return -1 }
    let (indexed, _) = json_reader_index_at(reader)
    return json_reader_fields(indexed).unwrap().get(key) ?? -1
}

fn json_reader_field(reader: JsonReader, key: string) -> JsonReader? {
    if let value = reader.value {
        let field = json_field(value, key) ?? return null
        return json_reader_value(field)
    }
    let at = json_reader_field_offset(reader, key)
    return if at < 0 { null } else { json_reader_at(reader, at) }
}

fn json_reader_as_str_at(src: string, at: int) -> string? {
    if at < 0 { return null }
    if src.unit_at(at) != 34 { return null }
    let (value, _) = parse_string_raw_at(src, at)
    return value
}

fn json_reader_as_str(reader: JsonReader) -> string? {
    if let value = reader.value { return json_as_str(value) }
    if reader.at < 0 { return null }
    return json_reader_as_str_at(reader.src.unwrap(), reader.at)
}

fn json_reader_as_bool_at(src: string, at: int) -> bool? {
    if at < 0 { return null }
    let b = src.unit_at(at)
    return if b == 116 { true } else if b == 102 { false } else { null }
}

fn json_reader_as_bool(reader: JsonReader) -> bool? {
    if let value = reader.value { return json_as_bool(value) }
    if reader.at < 0 { return null }
    return json_reader_as_bool_at(reader.src.unwrap(), reader.at)
}

fn json_reader_number_end_at(src: string, at: int, strict: bool = false) -> (float?, int) {
    if at < 0 { return (null, at) }
    let b = src.unit_at(at)
    if b != 45 && (b < 48 || b > 57) { return (null, at) }
    let (end, is_float, ok) = parse_number_scan_at(src, at)
    assert(ok, "validated JSON reader number must scan")
    if strict && is_float { return (null, end) }
    if is_float { return (src.parse_float_at(at, end), end) }
    return (src.substring(at, end).parse_int().unwrap() as float, end)
}

fn json_reader_number_at(src: string, at: int, strict: bool = false) -> float? {
    let (value, _) = json_reader_number_end_at(src, at, strict)
    return value
}

fn json_reader_number(reader: JsonReader, strict: bool = false) -> float? {
    if let value = reader.value {
        if strict { return match value { JsonValue::Int(i) => i as float, _ => null } }
        return json_as_float(value)
    }
    if reader.at < 0 { return null }
    return json_reader_number_at(reader.src.unwrap(), reader.at, strict)
}

fn json_reader_as_float(reader: JsonReader) -> float? { return json_reader_number(reader) }
fn json_reader_read_int_at(src: string, at: int, strict: bool) -> int? {
    if at < 0 { return null }
    let b = src.unit_at(at)
    if b != 45 && (b < 48 || b > 57) { return null }
    let (end, is_float, ok) = parse_number_scan_at(src, at)
    assert(ok, "validated JSON reader number must scan")
    if is_float {
        if strict { return null }
        return src.parse_float_at(at, end) as int
    }
    return src.substring(at, end).parse_int()
}

fn json_reader_read_int(reader: JsonReader, strict: bool) -> int? {
    if let value = reader.value {
        if strict { return match value { JsonValue::Int(i) => i, _ => null } }
        return json_as_int(value)
    }
    if reader.at < 0 { return null }
    return json_reader_read_int_at(reader.src.unwrap(), reader.at, strict)
}

fn json_reader_as_int(reader: JsonReader) -> int? { return json_reader_read_int(reader, false) }
fn json_reader_strict_int(reader: JsonReader) -> int? { return json_reader_read_int(reader, true) }

fn json_reader_as_array(reader: JsonReader) -> JsonReaderArray? {
    if let value = reader.value {
        return JsonReaderArray { reader, values: json_as_array(value) ?? return null }
    }
    if reader.at < 0 { return null }
    let src = reader.src.unwrap()
    if src.unit_at(reader.at) != 91 { return null }
    return JsonReaderArray { reader, first: parse_skip_ws_inline_at(src, reader.at + 1) }
}

@inline fn JsonReaderArray.iter(array) -> JsonReaderArrayIter {
    return JsonReaderArrayIter { array, pos: array.first }
}

@inline fn JsonReaderArrayIter.next(it) -> (bool, JsonReader) {
    return json_reader_array_next(it, true)
}

fn JsonReaderArrayIter.next_unindexed(it) -> (bool, JsonReader) {
    return json_reader_array_next(it, false)
}

fn json_reader_array_next(it: JsonReaderArrayIter, index_objects: bool) -> (bool, JsonReader) {
    let array = it.array
    if let values = array.values {
        if it.index >= values.len() { return (false, json_reader_null()) }
        let value = values[it.index]
        it.index += 1
        return (true, json_reader_value(value))
    }
    if it.pos < 0 { return (false, json_reader_null()) }
    let at = it.pos
    let src = array.reader.src.unwrap()
    if src.unit_at(at) == 93 { return (false, json_reader_null()) }
    let entry = json_reader_at(array.reader, at)
    let pos = at
    if index_objects && src.unit_at(at) == 123 {
        let (indexed, end) = json_reader_index_at(entry)
        entry = indexed
        pos = end + 1
    } else {
        pos = json_reader_skip(src, at, array.reader.offsets)
    }
    pos = parse_skip_ws_inline_at(src, pos)
    if src.unit_at(pos) == 44 { pos = parse_skip_ws_inline_at(src, pos + 1) }
    it.pos = pos
    it.index += 1
    return (true, entry)
}

fn JsonReaderArray.len(array) -> int {
    if let values = array.values { return values.len() }
    if array.first < 0 { return 0 }
    let src = array.reader.src.unwrap()
    let pos = array.first
    let size = 0
    while src.unit_at(pos) != 93 {
        pos = json_reader_skip(src, pos, array.reader.offsets)
        size += 1
        pos = parse_skip_ws_inline_at(src, pos)
        if src.unit_at(pos) == 44 { pos = parse_skip_ws_inline_at(src, pos + 1) }
    }
    return size
}

fn JsonReaderArray.get_at(array, index: int) -> JsonReader {
    if let values = array.values { return json_reader_value(values[index]) }
    for (i, entry) in enumerate(array) { if i == index { return entry } }
    error("JSON array index out of bounds: {index}")
    return json_reader_null()
}

struct JsonReaderFieldIter {
    reader: JsonReader,
    pos: int,
    keys: [string]? = null,
    index: int = 0,
}

// Source members stream in document order, including duplicates. Consumers
// overwrite earlier fields to retain JSON's last-member-wins behavior.
fn json_reader_each_field(reader: JsonReader) -> JsonReaderFieldIter? {
    if let value = reader.value {
        let object = json_as_object(value) ?? return null
        return JsonReaderFieldIter { reader, pos: -1, keys: object.keys() }
    }
    if reader.at < 0 || reader.src.unwrap().unit_at(reader.at) != 123 { return null }
    return JsonReaderFieldIter { reader, pos: parse_skip_ws_inline_at(reader.src.unwrap(), reader.at + 1) }
}

fn JsonReaderFieldIter.iter(it) -> JsonReaderFieldIter { return it }

fn JsonReaderFieldIter.next(it) -> (bool, (string, JsonReader)) {
    if let keys = it.keys {
        if it.index >= keys.len() { return (false, ("", json_reader_null())) }
        let key = keys[it.index]
        it.index += 1
        return (true, (key, json_reader_field(it.reader, key).unwrap()))
    }
    let src = it.reader.src.unwrap()
    if src.unit_at(it.pos) == 125 { return (false, ("", json_reader_null())) }
    let (key, end) = parse_string_raw_at(src, it.pos)
    let at = parse_skip_ws_inline_at(src, parse_skip_ws_inline_at(src, end) + 1)
    let pos = parse_skip_ws_inline_at(src, json_reader_skip(src, at, it.reader.offsets))
    if src.unit_at(pos) == 44 { pos = parse_skip_ws_inline_at(src, pos + 1) }
    it.pos = pos
    return (true, (key.unwrap(), json_reader_at(it.reader, at)))
}

fn json_reader_as_object(reader: JsonReader) -> Map<string, JsonReader>? {
    let fields: Map<string, JsonReader> = map_new()
    if let value = reader.value {
        let object = json_as_object(value) ?? return null
        for (key, entry) in object { fields[key] = json_reader_value(entry) }
        return fields
    }
    if reader.at < 0 { return null }
    let indexed = json_reader_index(reader)
    let offsets = json_reader_fields(indexed) ?? return null
    for (key, at) in offsets { fields[key] = json_reader_at(reader, at) }
    return fields
}

fn json_reader_field_as_str(reader: JsonReader, key: string) -> string? {
    if let value = reader.value { return json_as_str(json_field(value, key) ?? json_null()) }
    let at = json_reader_field_offset(reader, key)
    if at < 0 { return null }
    return json_reader_as_str_at(reader.src.unwrap(), at)
}

fn json_reader_field_as_bool(reader: JsonReader, key: string) -> bool? {
    if let value = reader.value { return json_as_bool(json_field(value, key) ?? json_null()) }
    let at = json_reader_field_offset(reader, key)
    if at < 0 { return null }
    return json_reader_as_bool_at(reader.src.unwrap(), at)
}

fn json_reader_field_as_float(reader: JsonReader, key: string) -> float? {
    if let value = reader.value { return json_as_float(json_field(value, key) ?? json_null()) }
    let at = json_reader_field_offset(reader, key)
    if at < 0 { return null }
    return json_reader_number_at(reader.src.unwrap(), at)
}

fn json_reader_field_as_int(reader: JsonReader, key: string) -> int? {
    if let value = reader.value { return json_as_int(json_field(value, key) ?? json_null()) }
    let at = json_reader_field_offset(reader, key)
    if at < 0 { return null }
    return json_reader_read_int_at(reader.src.unwrap(), at, false)
}

fn json_reader_field_as_strict_int(reader: JsonReader, key: string) -> int? {
    if let value = reader.value { return match json_field(value, key) ?? json_null() { JsonValue::Int(i) => i, _ => null } }
    let at = json_reader_field_offset(reader, key)
    if at < 0 { return null }
    return json_reader_read_int_at(reader.src.unwrap(), at, true)
}

fn json_reader_is_null(reader: JsonReader) -> bool {
    if let value = reader.value { return json_is_null(value) }
    return reader.at < 0 || reader.src.unwrap().unit_at(reader.at) == 110
}

// Use only at a consumer boundary that still requires a materialized subtree.
fn json_reader_materialize(reader: JsonReader) -> JsonValue {
    if let value = reader.value { return value }
    if reader.at < 0 { return json_null() }
    let src = reader.src.unwrap()
    let p = JsonParser { src, pos: reader.at, len: src.len(), ok: true, depth: 0 }
    return parse_value(p)
}

// Fixed coordinate tuples do not need array adapters or descendant readers.
// Shape and numeric validity stay separate for consumer diagnostics.
fn json_reader_float_components(reader: JsonReader, size: int) -> (bool, float?, float?, float?) {
    let (shape, x, y, z, _) = json_reader_float_components_end(reader, size)
    return (shape, x, y, z)
}

fn json_reader_float_components_end(reader: JsonReader, size: int) -> (bool, float?, float?, float?, int) {
    assert(size == 2 || size == 3, "JSON coordinate tuples contain two or three components")
    if let value = reader.value {
        let values = json_as_array(value)
        if values == null || values.unwrap().len() != size { return (false, null, null, null, reader.at) }
        let items = values.unwrap()
        return (true, json_as_float(items[0]), json_as_float(items[1]),
            if size == 3 { json_as_float(items[2]) } else { null }, reader.at)
    }
    if reader.at < 0 { return (false, null, null, null, reader.at) }
    let src = reader.src.unwrap()
    if src.unit_at(reader.at) != 91 { return (false, null, null, null, reader.at) }
    let pos = parse_skip_ws_inline_at(src, reader.at + 1)
    let x: float? = null
    let y: float? = null
    let z: float? = null
    for index in 0..size {
        if src.unit_at(pos) == 93 { return (false, null, null, null, reader.at) }
        let (number, end) = json_reader_number_end_at(src, pos)
        if index == 0 { x = number }
        else if index == 1 { y = number }
        else { z = number }
        pos = parse_skip_ws_inline_at(src, if end > pos { end } else { json_reader_skip(src, pos, reader.offsets) })
        if index + 1 < size {
            if src.unit_at(pos) != 44 { return (false, null, null, null, reader.at) }
            pos = parse_skip_ws_inline_at(src, pos + 1)
        }
    }
    return (src.unit_at(pos) == 93, x, y, z, pos + 1)
}

fn JsonReaderArrayIter.next_float_components(it, size: int) -> (bool, bool, float?, float?, float?) {
    let array = it.array
    if array.values != null {
        let (more, reader) = it.next()
        if !more { return (false, false, null, null, null) }
        let (shape, x, y, z) = json_reader_float_components(reader, size)
        return (true, shape, x, y, z)
    }
    if it.pos < 0 { return (false, false, null, null, null) }
    let src = array.reader.src.unwrap()
    if src.unit_at(it.pos) == 93 { return (false, false, null, null, null) }
    let (shape, x, y, z, end) = json_reader_float_components_end(json_reader_at(array.reader, it.pos), size)
    if shape {
        let pos = parse_skip_ws_inline_at(src, end)
        if src.unit_at(pos) == 44 { pos = parse_skip_ws_inline_at(src, pos + 1) }
        it.pos = pos
        it.index += 1
    } else {
        let _ = it.next()
    }
    return (true, shape, x, y, z)
}

fn json_reader_is_object(reader: JsonReader) -> bool {
    if let value = reader.value { return json_as_object(value) != null }
    return reader.at >= 0 && reader.src.unwrap().unit_at(reader.at) == 123
}
