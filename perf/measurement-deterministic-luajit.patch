@@ -310,2 +310,21 @@ static void *clib_getsym(CLibrary *cl, const char *name)

+#ifdef ROCK_PERF_DETERMINISTIC
+/* Binary fractions keep frame deltas exact. The wall clock still bounds the run. */
+static uint64_t rock_clock_ticks;
+static int rock_clock_enabled;
+
+LUA_API void luaJIT_rock_clock_frame(uint32_t frame)
+{
+  uint64_t start = (uint64_t)frame << 14;
+  rock_clock_enabled = 1;
+  if (rock_clock_ticks < start)
+    rock_clock_ticks = start;
+}
+
+static double rock_clock_next(void)
+{
+  return (double)++rock_clock_ticks * (1.0 / 1048576.0);
+}
+#endif
+
 /* -- C library indexing -------------------------------------------------- */
