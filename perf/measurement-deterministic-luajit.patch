+void lj_dispatch_init_proto(global_State *g, GCproto *pt)
+{
+  HotCount start = (HotCount)(G2J(g)->param[JIT_P_hotloop]*HOTCOUNT_LOOP - 1);
+  MSize i;
+  for (i = 0; i < pt->sizebc; i++)
+    proto_hot(pt)[i] = (PerfHotCount){ start, 0 };
