+#include "lj_rock_sites.h"
 #include "lj_buf.h"
@@ -116,2 +117,19 @@ static BCPos debug_framepc(lua_State *L, GCfunc *fn, cTValue *nextframe)

+#if LJ_ROCK_SITES
+uint32_t rock_sites_caller(lua_State *L)
+{
+  int level = 0, size;
+  cTValue *frame;
+  while ((frame = lj_debug_frame(L, level++, &size)) != NULL) {
+    GCfunc *fn = frame_func(frame);
+    if (isluafunc(fn)) {
+      GCproto *pt = funcproto(fn);
+      BCPos pc = debug_framepc(L, fn, size ? frame + size : NULL);
+      return pc < pt->sizebc ? rock_sites_pc(pt, proto_bc(pt) + pc) : 0;
+    }
+  }
+  return 0;
+}
+#endif
+
