// Microbenchmark for `xs[i] = v` stores and `xs[i]` reads whose index the
// compiler can prove in bounds, in the shapes Stone and the demos write them.
//
//     rock run benchmarks/vec_store.rock
//     ROCK_SKULL_BOUNDS_OFF=1 rock run benchmarks/vec_store.rock   # every check kept
//
// Each workload flushes the JIT, attaches a trace listener and runs its loop
// until hot, so every trace, abort and byte of mcode counted was recorded by
// that workload. `ns_per_elem` is then measured on the warm trace cache, and
// `interp_ns_per_elem` with the JIT off.
//
// Workloads whose name ends in `_kept` are controls the compiler must not
// touch: a call that could shrink the vector, a second vector of unknown
// length, or a bound the vector's length does not cover.

@nomangle inline(lua) fn bench_clock() -> float = "return os.clock()"

@nomangle inline(lua) fn bench_jit(on: bool) = """
    local jit = require("jit")
    if on then jit.on() else jit.off() end
    jit.flush()
"""

@nomangle inline(lua) fn bench_reset() = """
    local jit = require("jit")
    jit.flush()
    _G.__bench = { start = 0, stop = 0, abort = 0 }
    _G.__bench_cb = function(what, tr, fn, pc, otr, oex)
      local b = _G.__bench
      if what == "start" then
        b.start = b.start + 1
      elseif what == "stop" then
        b.stop = b.stop + 1
      elseif what == "abort" then
        b.abort = b.abort + 1
      end
    end
    jit.attach(_G.__bench_cb, "trace")
"""

@nomangle inline(lua) fn bench_counts() -> string = """
    local jit = require("jit")
    jit.attach(_G.__bench_cb)
    local util = require("jit.util")
    local b = _G.__bench
    local traces, mc = 0, 0
    for tr = 1, 32000 do
      local mcode = util.tracemc(tr)
      if mcode then
        traces = traces + 1
        mc = mc + #mcode
      end
    end
    collectgarbage("collect")
    return string.format("traces=%d stops=%d aborts=%d mcode_bytes=%d",
      traces, b.stop, b.abort, mc)
"""

struct Slots { items: [int], names: [string] }
struct Entry { count: int, next: int }

fn ints(n: int) -> [int] {
    let out: [int] = []
    for i in 0..n { out.push((i * 7 + 3) % 11) }
    return out
}

fn entries(n: int) -> [Entry] {
    let out: [Entry] = []
    for i in 0..n { out.push(Entry { count: 0, next: -1 }) }
    return out
}

// `for i in 0..xs.len() { xs[i] = .. }`.
fn fill(xs: [int]) -> float {
    for i in 0..xs.len() { xs[i] = i % 13 }
    return xs[xs.len() - 1] as float
}

// Read, compute, write back the same slot.
fn increment(xs: [int]) -> float {
    for i in 0..xs.len() { xs[i] = xs[i] + 1 }
    return xs[0] as float
}

// The vector lives in a struct field.
fn scale_field(s: Slots) -> float {
    for i in 0..s.items.len() { s.items[i] = s.items[i] * 2 % 1000 }
    return s.items[0] as float
}

// A per-slot setter with its own range guard, called once per slot.
fn set_slot(xs: [int], i: int, v: int) -> bool {
    if i < 0 { return false }
    if i >= xs.len() { return false }
    xs[i] = v
    return true
}

fn set_slots(xs: [int], n: int) -> float {
    let ok = 0
    for i in 0..n {
        if set_slot(xs, i, i) { ok += 1 }
    }
    return ok as float
}

// Read an entry, change a field, store it back into the same slot.
fn bump_entries(es: [Entry]) -> float {
    for i in 0..es.len() {
        let e = es[i]
        e.count = e.count + 1
        e.next = i
        es[i] = e
    }
    return es[0].count as float
}

// `while i < xs.len()` over two vectors: only the first is covered.
fn clear_pair(xs: [int], ys: [int]) -> float {
    let i = 0
    while i < xs.len() {
        xs[i] = 0
        ys[i] = 0
        i += 1
    }
    return (xs[0] + ys[0]) as float
}

@pure fn weight(i: int) -> int { return (i * 31 + 7) % 17 }

fn fill_pure_call(xs: [int]) -> float {
    for i in 0..xs.len() { xs[i] = weight(i) }
    return xs[0] as float
}

// A push onto another vector only grows it, so the store stays covered.
fn fill_and_collect(xs: [int], out: [int]) -> float {
    out.clear()
    for i in 0..xs.len() {
        xs[i] = i
        if i % 7 == 0 { out.push(i) }
    }
    return out.len() as float
}

// A row of a vector of vectors, indexed by the inner counter.
fn fill_rows(rows: [[int]]) -> float {
    for r in 0..rows.len() {
        let row = rows[r]
        for c in 0..row.len() { row[c] = r + c }
    }
    return rows[0][0] as float
}

// `xs[i]` is covered; `ys[i]` is not.
fn copy_into(src: [int], dst: [int]) -> float {
    for i in 0..src.len() { dst[i] = src[i] }
    return dst[0] as float
}

fn noise(xs: [int], i: int) -> int {
    if i < 0 { xs.pop() }
    return i % 13
}

// The call may shrink the vector, so every store keeps its check.
fn fill_call_kept(xs: [int]) -> float {
    for i in 0..xs.len() { xs[i] = noise(xs, i) }
    return xs[0] as float
}

// A bound the vector does not cover: `n` is a parameter.
fn fill_n_kept(xs: [int], n: int) -> float {
    for i in 0..n { xs[i] = i % 13 }
    return xs[0] as float
}

fn report(name: string, counts: string, elems: int, jit_s: float, interp_elems: int, interp_s: float, sink: float) {
    let ns = jit_s * 1000000000.0 / (elems as float)
    let interp_ns = interp_s * 1000000000.0 / (interp_elems as float)
    print("workload={name} {counts} ns_per_elem={ns} interp_ns_per_elem={interp_ns} sink={sink}")
}

// `reps` timed passes of `pass`, each over `n` elements; one twentieth of
// them again with the JIT off.
fn drive(name: string, n: int, reps: int, pass: fn() -> float) {
    bench_reset()
    let sink = 0.0
    for r in 0..200 { sink += pass() }
    let counts = bench_counts()
    let t0 = bench_clock()
    for r in 0..reps { sink += pass() }
    let jit_s = bench_clock() - t0
    bench_jit(false)
    let interp_reps = reps ./ 20 + 1
    let t1 = bench_clock()
    for r in 0..interp_reps { sink += pass() }
    let interp_s = bench_clock() - t1
    bench_jit(true)
    report(name, counts, n * reps, jit_s, n * interp_reps, interp_s, sink)
}

fn main() {
    let xs = ints(1000)
    let ys = ints(1000)
    let out: [int] = []
    let slots = Slots { items: ints(1000), names: [] }
    let es = entries(1000)
    let rows: [[int]] = []
    for r in 0..40 { rows.push(ints(25)) }

    drive("fill", 1000, 20000, () => fill(xs))
    drive("increment", 1000, 20000, () => increment(xs))
    drive("scale_field", 1000, 20000, () => scale_field(slots))
    drive("set_slots", 1000, 20000, () => set_slots(xs, 1000))
    drive("bump_entries", 1000, 20000, () => bump_entries(es))
    drive("clear_pair", 1000, 20000, () => clear_pair(xs, ys))
    drive("fill_pure_call", 1000, 20000, () => fill_pure_call(xs))
    drive("fill_and_collect", 1000, 20000, () => fill_and_collect(xs, out))
    drive("fill_rows", 1000, 20000, () => fill_rows(rows))
    drive("copy_into", 1000, 20000, () => copy_into(xs, ys))
    drive("fill_call_kept", 1000, 20000, () => fill_call_kept(xs))
    drive("fill_n_kept", 1000, 20000, () => fill_n_kept(xs, 1000))
}
