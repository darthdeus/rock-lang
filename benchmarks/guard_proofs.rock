// Guard audit probes. See docs/guard-elimination.md for proof limitations.
@nomangle fn guard_fresh_push(n: int) -> int {
    let xs: [int] = []
    let out: [int] = []
    for i in 0..n { xs.push(0) }
    for i in 0..xs.len() {
        xs[i] = i
        if i % 7 == 0 { out.push(i) }
    }
    return out.len()
}
@nomangle fn guard_accessor(xs: [int], i: int) -> int { return xs[i] }
@nomangle fn guard_accessor_loop(xs: [int]) -> int {
    let sum = 0
    for i in 0..xs.len() { sum += guard_accessor(xs, i) }
    return sum
}
@nomangle fn guard_random(xs: [int]) -> int {
    if xs.len() == 0 { return -1 }
    return xs[random_int(0, xs.len())]
}
@nomangle fn guard_previous(xs: [int], count: int) -> int {
    if count <= 0 || count > xs.len() || count > 2147483647 { return -1 }
    return xs[count - 1]
}
@nomangle fn guard_stride(buf: NativeBuffer<int>, rows: int) -> int {
    if rows < 0 || rows > 100000 || buf.len < rows * 4 { return -1 }
    let sum = 0
    for row in 0..rows {
        for lane in 0..4 { sum += buf[row * 4 + lane] }
    }
    return sum
}
@nomangle fn guard_fixed_buffer() -> int {
    let buf = native_buffer_int(4)
    buf[0] = 2
    buf[1] = 3
    return buf[0] + buf[1]
}
fn main() { print(guard_fresh_push(20)) }
