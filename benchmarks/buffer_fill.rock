// Fresh descriptor length proofs; run with benchmarks/buffer_fill.lua.
@nomangle fn fill_ints(count: int) -> NativeBuffer<int> {
    let buf = native_buffer_int(count)
    for i in 0..count { buf[i] = i }
    return buf
}
@nomangle fn fill_bytes(width: int, height: int) -> NativeBufferU8 {
    let count = width * height
    let buf = native_buffer_u8(count)
    for i in 0..count { buf[i] = i % 256 }
    return buf
}
fn main() { print(fill_ints(4).len) }
