// Constant-count guard probe; see docs/guard-elimination.md.
@nomangle fn shift_mix(value: uint, count: int) -> uint {
    let x = value
    for i in 0..count {
        x = x ^ (x << 13)
        x = x ^ (x >> 17)
        x = x ^ (x << 5)
    }
    return x
}
fn main() { print(shift_mix(1, 1000)) }
