// Coroutine lifecycle costs: long-lived resumes (mixed and all-quiet yield
// cadence) and short-lived creation, both sinkable (the handle stays inside
// the creating trace) and escaping (handles pooled and resumed later, the
// scheduler pattern).
//
//     rock compile-single benchmarks/coroutine_lifecycle.rock --output cl.lua
//     luajit -e 'dofile("cl.lua") main()'
//
// Compare compiler revisions with fresh interleaved processes on the same
// LuaJIT. Long-lived resumes are a few ns on warm traces; the numbers that
// move are the short-lived ones, dominated by frame construction and the
// first yield's writes.
enum Ev {
    Quiet,
    Hit(float, float),
    Text(string, int),
}

@nomangle inline(lua) fn bench_clock() -> float = "return os.clock()"

// Long-lived: one coroutine resumed `n` times; most frames are Quiet, some
// carry payloads (the common game-entity cadence).
co fn entity(n: int) -> Coroutine<Ev> {
    let hp = 100.0
    for i in 0..n {
        if i % 16 == 7 {
            hp -= 1.5
            yield Ev::Hit(hp, (i % 13) as float)
        } else if i % 64 == 9 {
            yield Ev::Text("ouch", i)
        } else {
            yield Ev::Quiet
        }
    }
}

fn drain(n: int) -> float {
    let c = entity(n)
    let t = 0.0
    while true {
        let ev = c.resume()
        if ev == null { break }
        match ev {
            Ev::Hit(hp, k) => { t += hp + k }
            Ev::Text(_, i) => { t += i as float }
            Ev::Quiet => { t += 0.25 }
        }
    }
    return t
}

// All-quiet long-lived: every yield clears the payload slots -- the worst
// case for unguarded nil stores and the best case for the guard.
co fn sleeper(n: int) -> Coroutine<Ev> {
    for i in 0..n {
        yield Ev::Quiet
    }
}

fn idle(n: int) -> float {
    let c = sleeper(n)
    let t = 0.0
    while true {
        let ev = c.resume()
        if ev == null { break }
        match ev {
            Ev::Quiet => { t += 0.25 }
            _ => { t += 1.0 }
        }
    }
    return t
}

// Short-lived: create, resume twice, drop (per-frame task pattern).
co fn task(seed: int) -> Coroutine<Ev> {
    yield Ev::Quiet
    yield Ev::Hit(seed as float, 1.0)
}

fn spawn_wave(n: int) -> float {
    let t = 0.0
    for i in 0..n {
        let c = task(i)
        let a = c.resume()
        if a != null { t += 0.5 }
        let b = c.resume()
        match b ?? Ev::Quiet {
            Ev::Hit(x, y) => { t += x + y }
            _ => { t += 0.125 }
        }
    }
    return t
}

// Escaping short-lived: handles stored in a Vec and resumed later, so the
// frame cannot be sunk into the creating trace (a scheduler pattern).
fn spawn_batch(n: int, pool: [Coroutine<Ev>]) -> float {
    pool.clear()
    for i in 0..n {
        pool.push(task(i))
    }
    let t = 0.0
    for i in 0..pool.len() {
        let c = pool[i]
        let a = c.resume()
        if a != null { t += 0.5 }
        let b = c.resume()
        match b ?? Ev::Quiet {
            Ev::Hit(x, y) => { t += x + y }
            _ => { t += 0.125 }
        }
    }
    return t
}

fn main() {
    // warm
    let sink = 0.0
    let pool: [Coroutine<Ev>] = []
    for r in 0..50 { sink += drain(1000) + spawn_wave(200) + spawn_batch(200, pool) }
    for r in 0..50 { sink += idle(1000) }
    let t0 = bench_clock()
    for r in 0..2000 { sink += drain(1000) }
    let long_s = bench_clock() - t0
    let ti = bench_clock()
    for r in 0..2000 { sink += idle(1000) }
    let idle_s = bench_clock() - ti
    let t1 = bench_clock()
    for r in 0..2000 { sink += spawn_wave(500) }
    let short_s = bench_clock() - t1
    let t2 = bench_clock()
    for r in 0..2000 { sink += spawn_batch(500, pool) }
    let esc_s = bench_clock() - t2
    print("mixed_ns_per_resume={long_s * 1000000000.0 / 2000000.0} quiet_ns_per_resume={idle_s * 1000000000.0 / 2000000.0} short_ns_per_coroutine={short_s * 1000000000.0 / 1000000.0} escaping_ns_per_coroutine={esc_s * 1000000000.0 / 1000000.0} sink={sink}")
}
