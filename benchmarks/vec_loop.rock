fn budget_read_52(b: BudgetFields) -> int { return b.key052 + b.key053 + b.key054 + b.key055 }
fn budget_read_56(b: BudgetFields) -> int { return b.key056 + b.key057 + b.key058 + b.key059 }
fn budget_read_60(b: BudgetFields) -> int { return b.key060 + b.key061 + b.key062 + b.key063 }
fn budget_read_64(b: BudgetFields) -> int { return b.key064 + b.key065 + b.key066 + b.key067 }
fn budget_read_68(b: BudgetFields) -> int { return b.key068 + b.key069 + b.key070 + b.key071 }
fn budget_read_72(b: BudgetFields) -> int { return b.key072 + b.key073 + b.key074 + b.key075 }
fn budget_read_76(b: BudgetFields) -> int { return b.key076 + b.key077 + b.key078 + b.key079 }
fn budget_read_80(b: BudgetFields) -> int { return b.key080 + b.key081 + b.key082 + b.key083 }
fn budget_read_84(b: BudgetFields) -> int { return b.key084 + b.key085 + b.key086 + b.key087 }
fn budget_read_88(b: BudgetFields) -> int { return b.key088 + b.key089 + b.key090 + b.key091 }
fn budget_read_92(b: BudgetFields) -> int { return b.key092 + b.key093 + b.key094 + b.key095 }
fn budget_read_96(b: BudgetFields) -> int { return b.key096 + b.key097 + b.key098 + b.key099 }
fn budget_read_100(b: BudgetFields) -> int { return b.key100 + b.key101 + b.key102 + b.key103 }
fn budget_read_104(b: BudgetFields) -> int { return b.key104 + b.key105 + b.key106 + b.key107 }
fn budget_read_108(b: BudgetFields) -> int { return b.key108 + b.key109 + b.key110 + b.key111 }
fn budget_read_112(b: BudgetFields) -> int { return b.key112 + b.key113 + b.key114 + b.key115 }
fn budget_read_116(b: BudgetFields) -> int { return b.key116 + b.key117 }

fn read_budget_fields(b: BudgetFields) -> int {
    let total = 0
    total += budget_read_0(b)
    total += budget_read_4(b)
    total += budget_read_8(b)
    total += budget_read_12(b)
    total += budget_read_16(b)
    total += budget_read_20(b)
    total += budget_read_24(b)
    total += budget_read_28(b)
    total += budget_read_32(b)
    total += budget_read_36(b)
    total += budget_read_40(b)
    total += budget_read_44(b)
    total += budget_read_48(b)
    total += budget_read_52(b)
    total += budget_read_56(b)
    total += budget_read_60(b)
    total += budget_read_64(b)
    total += budget_read_68(b)
    total += budget_read_72(b)
    total += budget_read_76(b)
    total += budget_read_80(b)
    total += budget_read_84(b)
    total += budget_read_88(b)
    total += budget_read_92(b)
    total += budget_read_96(b)
    total += budget_read_100(b)
    total += budget_read_104(b)
    total += budget_read_108(b)
    total += budget_read_112(b)
    total += budget_read_116(b)
    return total
}

nobox value PushRow12 { f0: int, f1: int, f2: int, f3: int, f4: int, f5: int, f6: int, f7: int, f8: int, f9: int, f10: int, f11: int }

nobox value PushRow50 { f0: int, f1: int, f2: int, f3: int, f4: int, f5: int, f6: int, f7: int, f8: int, f9: int, f10: int, f11: int, f12: int, f13: int, f14: int, f15: int, f16: int, f17: int, f18: int, f19: int, f20: int, f21: int, f22: int, f23: int, f24: int, f25: int, f26: int, f27: int, f28: int, f29: int, f30: int, f31: int, f32: int, f33: int, f34: int, f35: int, f36: int, f37: int, f38: int, f39: int, f40: int, f41: int, f42: int, f43: int, f44: int, f45: int, f46: int, f47: int, f48: int, f49: int }

fn budget_push_12(b: BudgetFields, xs: [PushRow12], n: int) -> float {
    xs.clear()
    for i in 0..n {
        b.key000 = i
        let total = read_budget_fields(b)
        xs.push(PushRow12 { f0: total, f1: total, f2: total, f3: total, f4: total, f5: total, f6: total, f7: total, f8: total, f9: total, f10: total, f11: total })
    }
    return xs[n - 1].f11 as float
}

fn budget_push_24(b: BudgetFields, xs: [PushRow24], n: int) -> float {
    xs.clear()
    for i in 0..n {
        b.key000 = i
        let total = read_budget_fields(b)
        xs.push(PushRow24 { f0: total, f1: total, f2: total, f3: total, f4: total, f5: total, f6: total, f7: total, f8: total, f9: total, f10: total, f11: total, f12: total, f13: total, f14: total, f15: total, f16: total, f17: total, f18: total, f19: total, f20: total, f21: total, f22: total, f23: total })
    }
    return xs[n - 1].f23 as float
}

fn budget_push_50(b: BudgetFields, xs: [PushRow50], n: int) -> float {
    xs.clear()
    for i in 0..n {
        b.key000 = i
        let total = read_budget_fields(b)
        xs.push(PushRow50 { f0: total, f1: total, f2: total, f3: total, f4: total, f5: total, f6: total, f7: total, f8: total, f9: total, f10: total, f11: total, f12: total, f13: total, f14: total, f15: total, f16: total, f17: total, f18: total, f19: total, f20: total, f21: total, f22: total, f23: total, f24: total, f25: total, f26: total, f27: total, f28: total, f29: total, f30: total, f31: total, f32: total, f33: total, f34: total, f35: total, f36: total, f37: total, f38: total, f39: total, f40: total, f41: total, f42: total, f43: total, f44: total, f45: total, f46: total, f47: total, f48: total, f49: total })
    }
    return xs[n - 1].f49 as float
}

fn report(name: string, counts: string, elems: int, jit_s: float, interp_elems: int, interp_s: float, sink: float) {
    let ns = jit_s * 1000000000.0 / (elems as float)
    let interp_ns = interp_s * 1000000000.0 / (interp_elems as float)
    print("workload={name} {counts} ns_per_elem={ns} interp_ns_per_elem={interp_ns} sink={sink}")
}

// `reps` timed passes of `pass`, each over `n` elements; one twentieth of
// them again with the JIT off.
fn drive(name: string, n: int, reps: int, pass: fn() -> float) {
    bench_reset()
    let sink = 0.0
    for r in 0..200 { sink += pass() }
    let counts = bench_counts()
    let t0 = bench_clock()
    for r in 0..reps { sink += pass() }
    let jit_s = bench_clock() - t0
    bench_jit(false)
    let interp_reps = reps ./ 20 + 1
    let t1 = bench_clock()
    for r in 0..interp_reps { sink += pass() }
    let interp_s = bench_clock() - t1
    bench_jit(true)
    report(name, counts, n * reps, jit_s, n * interp_reps, interp_s, sink)
}

fn main() {
    let xs = ints(1000)
    let short = ints(8)
    let ms = motes(1000)
    let swarm = Swarm { motes: motes(500), ids: ints(500) }
    let out: [int] = []
    let grid: [[int]] = []
    for r in 0..40 { grid.push(ints(25)) }

    drive("sum_ints", 1000, 20000, () => sum_ints(xs) as float)
    drive("sum_short", 8, 2000000, () => sum_ints(short) as float)
    drive("sum_indexed", 1000, 20000, () => sum_indexed(xs) as float)
    drive("sum_enumerated", 1000, 20000, () => sum_enumerated(xs) as float)
    drive("sum_pairs", 1000, 20000, () => sum_pairs(xs) as float)
    drive("sum_motes", 1000, 20000, () => sum_motes(ms))
    drive("sum_field", 1000, 20000, () => sum_field(swarm))
    drive("copy_big", 1000, 10000, () => copy_big(xs, out) as float)
    drive("sum_grid", 1000, 20000, () => sum_grid(grid) as float)
    let cs = columns(1000)
    let ss = strided(1000)
    let writes = ints(1000)
    drive("sum_columns", 1000, 20000, () => sum_columns(cs))
    drive("sum_strided", 1000, 20000, () => sum_strided(ss))
    drive("sum_columns_indexed", 1000, 20000, () => sum_columns_indexed(cs))
    drive("sum_strided_indexed", 1000, 20000, () => sum_strided_indexed(ss))
    drive("store_columns", 1000, 20000, () => store_columns(cs))
    drive("store_strided", 1000, 20000, () => store_strided(ss))
    drive("store_ints", 1000, 20000, () => store_ints(writes))
    let rows2: [PushRow2] = []
    drive("push_rows_2", 1000, 20000, () => push_rows_2(rows2, 1000))
    let rows8: [PushRow8] = []
    drive("push_rows_8", 1000, 20000, () => push_rows_8(rows8, 1000))
    let rows24: [PushRow24] = []
    drive("push_rows_24", 1000, 20000, () => push_rows_24(rows24, 1000))
    let budget = budget_fields()
    let rows50: [PushRow50] = []
    let rows12: [PushRow12] = []
    drive("budget_push_12", 1000, 2000, () => budget_push_12(budget, rows12, 1000))
    drive("budget_push_24", 1000, 2000, () => budget_push_24(budget, rows24, 1000))
    drive("budget_push_50", 1000, 2000, () => budget_push_50(budget, rows50, 1000))
    // One slot in ten is free.
    let arena = units(1000)
    drive("sum_arena", 900, 20000, () => sum_arena(arena) as float)
    drive("count_arena", 900, 20000, () => count_arena(arena) as float)
    drive("sum_arena_generation", 900, 20000, () => sum_arena_generation(arena))
    drive("sum_arena_split_unused", 900, 20000, () => sum_arena_split_unused(arena))
    drive("sum_arena_enum_index_unused", 900, 20000, () => sum_arena_enum_index_unused(arena))
    drive("count_arena_no_bindings", 900, 20000, () => count_arena_no_bindings(arena))
    let column_arena = column_units(1000)
    drive("sum_column_arena_generation", 900, 20000, () => sum_column_arena_generation(column_arena))
    drive("sum_column_arena_split_unused", 900, 20000, () => sum_column_arena_split_unused(column_arena))
    drive("sum_column_arena_enum_index_unused", 900, 20000, () => sum_column_arena_enum_index_unused(column_arena))
    drive("count_column_arena_no_bindings", 900, 20000, () => count_arena_no_bindings(column_arena))
}
