// Microbenchmark for vector and arena loops, indexed reads, and row pushes.
//
//     rock run benchmarks/vec_loop.rock
//
// Each workload flushes the JIT, attaches a trace listener and runs its loop
// until hot, so every trace, abort and byte of mcode counted was recorded by
// that workload. `ns_per_elem` is then measured on the warm trace cache, and
// `interp_ns_per_elem` with the JIT off: code that never traces, or whose
// trace aborted, runs there.

@nomangle inline(lua) fn bench_clock() -> float = "return os.clock()"

@nomangle inline(lua) fn bench_jit(on: bool) = """
    local jit = require("jit")
    if on then jit.on() else jit.off() end
    jit.flush()
"""

@nomangle inline(lua) fn bench_reset() = """
    local jit = require("jit")
    jit.flush()
    _G.__bench = { start = 0, stop = 0, abort = 0, reasons = {}, abort_nk = {} }
    _G.__bench_cb = function(what, tr, fn, pc, otr, oex)
      local b = _G.__bench
      if what == "start" then
        b.start = b.start + 1
      elseif what == "stop" then
        b.stop = b.stop + 1
      elseif what == "abort" then
        b.abort = b.abort + 1
        local reason = (require("jit.vmdef").traceerr[otr] or tostring(otr)):gsub("%W+", "_")
        b.reasons[reason] = (b.reasons[reason] or 0) + 1
        local info = require("jit.util").traceinfo(tr)
        b.abort_nk[#b.abort_nk + 1] = info and info.nk or 0
      end
    end
    jit.attach(_G.__bench_cb, "trace")
"""

@nomangle inline(lua) fn bench_counts() -> string = """
    local jit = require("jit")
    jit.attach(_G.__bench_cb)
    local util = require("jit.util")
    local b = _G.__bench
    local traces, mc, nk = 0, 0, {}
    for tr = 1, 32000 do
      local mcode = util.tracemc(tr)
      if mcode then
        traces = traces + 1
        mc = mc + #mcode
        local info = util.traceinfo(tr)
        nk[#nk + 1] = string.format("%d:%d:%s", tr, info.nk, info.linktype)
      end
    end
    collectgarbage("collect")
    local reasons = {}
    for reason, count in pairs(b.reasons) do
      reasons[#reasons + 1] = reason .. ":" .. count
    end
    table.sort(reasons)
    return string.format("traces=%d stops=%d aborts=%d mcode_bytes=%d trace_nk=%s abort_reasons=%s abort_nk=%s",
      traces, b.stop, b.abort, mc, table.concat(nk, ","),
      #reasons > 0 and table.concat(reasons, ",") or "none",
      #b.abort_nk > 0 and table.concat(b.abort_nk, ",") or "none")
"""

struct Mote { x: float, y: float, life: int }
struct Swarm { motes: [Mote], ids: [int] }

fn ints(n: int) -> [int] {
    let out: [int] = []
    for i in 0..n { out.push((i * 7 + 3) % 11) }
    return out
}

fn motes(n: int) -> [Mote] {
    let out: [Mote] = []
    for i in 0..n {
        out.push(Mote { x: (i % 13) as float, y: (i % 5) as float, life: i % 9 })
    }
    return out
}

fn sum_ints(xs: [int]) -> int {
    let t = 0
    for x in xs { t += x }
    return t
}

fn sum_indexed(xs: [int]) -> int {
    let t = 0
    for i in 0..xs.len() { t += xs[i] }
    return t
}

fn sum_enumerated(xs: [int]) -> int {
    let t = 0
    for (i, x) in enumerate(xs) { t += x * (i % 3) }
    return t
}

fn sum_motes(ms: [Mote]) -> float {
    let t = 0.0
    for m in ms {
        if m.life > 2 { t += m.x * m.y }
    }
    return t
}

fn sum_field(s: Swarm) -> float {
    let t = 0.0
    for m in s.motes { t += m.x }
    for id in s.ids { t += id as float }
    return t
}

fn copy_big(xs: [int], out: [int]) -> int {
    out.clear()
    for x in xs {
        if x > 4 { out.push(x) }
    }
    return out.len()
}

fn sum_grid(rows: [[int]]) -> int {
    let t = 0
    for row in rows {
        for x in row { t += x }
    }
    return t
}

fn sum_pairs(xs: [int]) -> int {
    let t = 0
    for i in 1..xs.len() { t += xs[i] - xs[i - 1] }
    return t
}

fn units(n: int) -> Arena<Mote> {
    let out: Arena<Mote> = arena_new()
    let drop: [Entity<Mote>] = []
    for i in 0..n {
        let e = out.insert(Mote { x: (i % 13) as float, y: (i % 5) as float, life: i % 9 })
        if i % 10 == 3 { drop.push(e) }
    }
    for e in drop { out.remove(e) }
    return out
}

fn sum_arena(us: Arena<Mote>) -> int {
    let t = 0
    for (e, u) in us { t += u.life + e._slot % 2 }
    return t
}

fn count_arena(us: Arena<Mote>) -> int {
    let t = 0
    for item in us {
        if item.1.life > 4 { t += 1 }
    }
    return t
}

fn sum_arena_generation(us: Arena<Mote>) -> float {
    let t = 0.0
    for (e, m) in us { t += (e._generation + m.life) as float }
    return t
}

fn sum_arena_split_unused(us: Arena<Mote>) -> float {
    let t = 0.0
    for (_, m) in us { t += m.life as float }
    return t
}

fn sum_arena_enum_index_unused(us: Arena<Mote>) -> float {
    let t = 0.0
    for (i, item) in enumerate(us) {
        t += (item.0._generation + item.1.life) as float
    }
    return t
}

fn count_arena_no_bindings<T>(us: Arena<T>) -> float {
    let t = 0.0
    for (_, _) in us { t += 1.0 }
    return t
}

// Four scalar leaves use columns; five use dense strided storage.
nobox value ColumnMote { x: float, y: float, life: int }
nobox value StridedMote { x: float, y: float, life: int, dx: float, dy: float }

fn column_units(n: int) -> Arena<ColumnMote> {
    let out: Arena<ColumnMote> = arena_new()
    let drop: [Entity<ColumnMote>] = []
    for i in 0..n {
        let e = out.insert(ColumnMote { x: (i % 13) as float, y: (i % 5) as float, life: i % 9 })
        if i % 10 == 3 { drop.push(e) }
    }
    for e in drop { out.remove(e) }
    return out
}

fn sum_column_arena_generation(us: Arena<ColumnMote>) -> float {
    let t = 0.0
    for (e, m) in us { t += (e._generation + m.life) as float }
    return t
}

fn sum_column_arena_split_unused(us: Arena<ColumnMote>) -> float {
    let t = 0.0
    for (_, m) in us { t += m.life as float }
    return t
}

fn sum_column_arena_enum_index_unused(us: Arena<ColumnMote>) -> float {
    let t = 0.0
    for (i, (e, m)) in enumerate(us) {
        t += (e._generation + m.life) as float
    }
    return t
}

fn columns(n: int) -> [ColumnMote] {
    let out: [ColumnMote] = []
    for i in 0..n { out.push(ColumnMote { x: (i % 13) as float, y: (i % 5) as float, life: i % 9 }) }
    return out
}

fn strided(n: int) -> [StridedMote] {
    let out: [StridedMote] = []
    for i in 0..n { out.push(StridedMote { x: (i % 13) as float, y: (i % 5) as float, life: i % 9, dx: 1.0, dy: 2.0 }) }
    return out
}

fn sum_columns(ms: [ColumnMote]) -> float {
    let t = 0.0
    for m in ms { if m.life > 2 { t += m.x * m.y } }
    return t
}

fn sum_strided(ms: [StridedMote]) -> float {
    let t = 0.0
    for m in ms { if m.life > 2 { t += m.x * m.y } }
    return t
}

fn sum_columns_indexed(ms: [ColumnMote]) -> float {
    let t = 0.0
    for i in 0..ms.len() { t += ms[i].x }
    return t
}

fn sum_strided_indexed(ms: [StridedMote]) -> float {
    let t = 0.0
    for i in 0..ms.len() { t += ms[i].x }
    return t
}

fn store_columns(ms: [ColumnMote]) -> float {
    for i in 0..ms.len() { ms[i] = ColumnMote { x: (i % 13) as float, y: (i % 5) as float, life: i % 9 } }
    return ms[ms.len() - 1].x
}

fn store_strided(ms: [StridedMote]) -> float {
    for i in 0..ms.len() { ms[i] = StridedMote { x: (i % 13) as float, y: (i % 5) as float, life: i % 9, dx: 1.0, dy: 2.0 } }
    return ms[ms.len() - 1].x
}

fn store_ints(xs: [int]) -> float {
    for i in 0..xs.len() { xs[i] = i % 13 }
    return xs[xs.len() - 1] as float
}

// Two leaves keep columns; eight and twenty-four exercise strided row pushes.
nobox value PushRow2 { f0: int, f1: int }

fn push_rows_2(xs: [PushRow2], n: int) -> float {
    xs.clear()
    for i in 0..n { xs.push(PushRow2 { f0: i + 0, f1: i + 1 }) }
    return (xs.len() + xs[n - 1].f1) as float
}

nobox value PushRow8 { f0: int, f1: int, f2: int, f3: int, f4: int, f5: int, f6: int, f7: int }

fn push_rows_8(xs: [PushRow8], n: int) -> float {
    xs.clear()
    for i in 0..n { xs.push(PushRow8 { f0: i + 0, f1: i + 1, f2: i + 2, f3: i + 3, f4: i + 4, f5: i + 5, f6: i + 6, f7: i + 7 }) }
    return (xs.len() + xs[n - 1].f7) as float
}

nobox value PushRow24 { f0: int, f1: int, f2: int, f3: int, f4: int, f5: int, f6: int, f7: int, f8: int, f9: int, f10: int, f11: int, f12: int, f13: int, f14: int, f15: int, f16: int, f17: int, f18: int, f19: int, f20: int, f21: int, f22: int, f23: int }

fn push_rows_24(xs: [PushRow24], n: int) -> float {
    xs.clear()
    for i in 0..n { xs.push(PushRow24 { f0: i + 0, f1: i + 1, f2: i + 2, f3: i + 3, f4: i + 4, f5: i + 5, f6: i + 6, f7: i + 7, f8: i + 8, f9: i + 9, f10: i + 10, f11: i + 11, f12: i + 12, f13: i + 13, f14: i + 14, f15: i + 15, f16: i + 16, f17: i + 17, f18: i + 18, f19: i + 19, f20: i + 20, f21: i + 21, f22: i + 22, f23: i + 23 }) }
    return (xs.len() + xs[n - 1].f23) as float
}

// Field keys and inlined calls spend about 450 of LuaJIT's 500 constant slots.
// Uniform row leaves ensure distinct offsets are not already source constants.
struct BudgetFields {
    key000: int, key001: int, key002: int, key003: int, key004: int, key005: int, key006: int,
    key007: int, key008: int, key009: int, key010: int, key011: int, key012: int, key013: int,
    key014: int, key015: int, key016: int, key017: int, key018: int, key019: int, key020: int,
    key021: int, key022: int, key023: int, key024: int, key025: int, key026: int, key027: int,
    key028: int, key029: int, key030: int, key031: int, key032: int, key033: int, key034: int,
    key035: int, key036: int, key037: int, key038: int, key039: int, key040: int, key041: int,
    key042: int, key043: int, key044: int, key045: int, key046: int, key047: int, key048: int,
    key049: int, key050: int, key051: int, key052: int, key053: int, key054: int, key055: int,
    key056: int, key057: int, key058: int, key059: int, key060: int, key061: int, key062: int,
    key063: int, key064: int, key065: int, key066: int, key067: int, key068: int, key069: int,
    key070: int, key071: int, key072: int, key073: int, key074: int, key075: int, key076: int,
    key077: int, key078: int, key079: int, key080: int, key081: int, key082: int, key083: int,
    key084: int, key085: int, key086: int, key087: int, key088: int, key089: int, key090: int,
    key091: int, key092: int, key093: int, key094: int, key095: int, key096: int, key097: int,
    key098: int, key099: int, key100: int, key101: int, key102: int, key103: int, key104: int,
    key105: int, key106: int, key107: int, key108: int, key109: int, key110: int, key111: int,
    key112: int, key113: int, key114: int, key115: int, key116: int, key117: int,
}

fn budget_fields() -> BudgetFields {
    return BudgetFields {
        key000: 1000, key001: 1001, key002: 1002, key003: 1003, key004: 1004, key005: 1005, key006: 1006,
        key007: 1007, key008: 1008, key009: 1009, key010: 1010, key011: 1011, key012: 1012, key013: 1013,
        key014: 1014, key015: 1015, key016: 1016, key017: 1017, key018: 1018, key019: 1019, key020: 1020,
        key021: 1021, key022: 1022, key023: 1023, key024: 1024, key025: 1025, key026: 1026, key027: 1027,
        key028: 1028, key029: 1029, key030: 1030, key031: 1031, key032: 1032, key033: 1033, key034: 1034,
        key035: 1035, key036: 1036, key037: 1037, key038: 1038, key039: 1039, key040: 1040, key041: 1041,
        key042: 1042, key043: 1043, key044: 1044, key045: 1045, key046: 1046, key047: 1047, key048: 1048,
        key049: 1049, key050: 1050, key051: 1051, key052: 1052, key053: 1053, key054: 1054, key055: 1055,
        key056: 1056, key057: 1057, key058: 1058, key059: 1059, key060: 1060, key061: 1061, key062: 1062,
        key063: 1063, key064: 1064, key065: 1065, key066: 1066, key067: 1067, key068: 1068, key069: 1069,
        key070: 1070, key071: 1071, key072: 1072, key073: 1073, key074: 1074, key075: 1075, key076: 1076,
        key077: 1077, key078: 1078, key079: 1079, key080: 1080, key081: 1081, key082: 1082, key083: 1083,
        key084: 1084, key085: 1085, key086: 1086, key087: 1087, key088: 1088, key089: 1089, key090: 1090,
        key091: 1091, key092: 1092, key093: 1093, key094: 1094, key095: 1095, key096: 1096, key097: 1097,
        key098: 1098, key099: 1099, key100: 1100, key101: 1101, key102: 1102, key103: 1103, key104: 1104,
        key105: 1105, key106: 1106, key107: 1107, key108: 1108, key109: 1109, key110: 1110, key111: 1111,
        key112: 1112, key113: 1113, key114: 1114, key115: 1115, key116: 1116, key117: 1117,
    }
}

fn budget_read_0(b: BudgetFields) -> int { return b.key000 + b.key001 + b.key002 + b.key003 }
fn budget_read_4(b: BudgetFields) -> int { return b.key004 + b.key005 + b.key006 + b.key007 }
fn budget_read_8(b: BudgetFields) -> int { return b.key008 + b.key009 + b.key010 + b.key011 }
fn budget_read_12(b: BudgetFields) -> int { return b.key012 + b.key013 + b.key014 + b.key015 }
fn budget_read_16(b: BudgetFields) -> int { return b.key016 + b.key017 + b.key018 + b.key019 }
fn budget_read_20(b: BudgetFields) -> int { return b.key020 + b.key021 + b.key022 + b.key023 }
fn budget_read_24(b: BudgetFields) -> int { return b.key024 + b.key025 + b.key026 + b.key027 }
fn budget_read_28(b: BudgetFields) -> int { return b.key028 + b.key029 + b.key030 + b.key031 }
fn budget_read_32(b: BudgetFields) -> int { return b.key032 + b.key033 + b.key034 + b.key035 }
fn budget_read_36(b: BudgetFields) -> int { return b.key036 + b.key037 + b.key038 + b.key039 }
