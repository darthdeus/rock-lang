@shader(fragment)
fn audit_half_frag(@textures t: MainTex, tc: Vec2) -> Vec4 {
    return texture(t.uTexture, tc) * 0.5
}

const AUDIT_PIPELINE: Pipeline = pipeline(rock_shader(audit_half_frag))

@nomangle inline(lua) fn audit_measure(name: string, frames: int, body: fn(int)) = """
    assert(jit.status(), 'JIT must be enabled')
    local metric = os.getenv('AUDIT_METRIC') or 'time'
    assert(metric == 'time' or metric == 'alloc' or metric == 'trace')
    local samples = ffi.new('double[?]', frames)
    local reasons, sites, starts = {}, {}, {}
    local phase, warm_aborts, measured_aborts = 'warmup', 0, 0
    local util, vm = require('jit.util'), require('jit.vmdef')
    local function trace(what, tr, fn, pc, err, extra)
        if what == 'start' then
            starts[tr] = string.format('parent=%s exit=%s start=%s',
                tostring(err), tostring(extra), util.funcinfo(fn, pc).loc or '?')
            return
        end
        if what ~= 'abort' then return end
        if phase == 'warmup' then warm_aborts = warm_aborts + 1
        else measured_aborts = measured_aborts + 1 end
        local reason = (vm.traceerr[err] or tostring(err)) .. ' detail=' .. tostring(extra)
        local location = util.funcinfo(fn, pc).loc or '?'
        local key = phase .. ':' .. reason
        reasons[key] = (reasons[key] or 0) + 1
        local site = phase .. ':' .. reason .. ' at=' .. location .. ' ' .. (starts[tr] or '?')
        sites[site] = (sites[site] or 0) + 1
    end
    if metric == 'trace' then jit.attach(trace, 'trace') end
    local warmup = tonumber(os.getenv('AUDIT_WARMUP')) or 600
    for i = 1, warmup do body(i) end
    collectgarbage('collect')
    phase = 'measure'
    if metric == 'alloc' then assert(stone.stone_lua_alloc_counter_begin() ~= 0) end
    local start_bytes = stone.stone_lua_alloc_gross_request_kb()
    for i = 1, frames do
        local start = stone.stone_get_time()
        body(i)
        samples[i - 1] = (stone.stone_get_time() - start) * 1e6
    end
    local bytes = (stone.stone_lua_alloc_gross_request_kb() - start_bytes) * 1024
    if metric == 'alloc' then assert(stone.stone_lua_alloc_counter_end() ~= 0) end
    if metric == 'trace' then jit.attach(trace) end
    io.write('VM ', jit.version, ' ', jit.arch, ' ', jit.os, '\n')
    local sorted = {}
    for i = 0, frames - 1 do sorted[#sorted + 1] = samples[i] end
    table.sort(sorted)
    local median = (sorted[math.floor((frames + 1) / 2)] + sorted[math.ceil((frames + 1) / 2)]) / 2
    local p95 = sorted[math.ceil(frames * .95)]
    io.write(string.format('AUDIT %s %s %d %.6f %.6f %.3f %d %d\n',
        name, metric, frames, median, p95, bytes / frames, warm_aborts, measured_aborts))
    for reason, count in pairs(reasons) do io.write('ABORT ', count, ' ', reason, '\n') end
    for site, count in pairs(sites) do io.write('SITE ', count, ' ', site, '\n') end
    -- Frame zero runs untimed validation after counters and observers stop.
    body(0)
"""

fn scene_audit() {
    assert(stone_gpu_host_ensure())
    let view = resolve_frame_view(v(320, 180), iv(320, 180),
        Camera2D { visible_world_width: 20.0 }, RenderConfig {}).unwrap()
    with_scene_render_scope(view, () => {
        let pass = Pass {
            pipeline: AUDIT_PIPELINE,
            slot_inputs: [(sampled_canvas(screen_canvas), TextureFilter::Nearest)],
            output: screen_canvas_2,
            blend: BlendMode::Replace,
        }
        audit_measure("scene", get_env_int("AUDIT_FRAMES", 1200), (i) => {
            clear_batches()
            draw_rect(v(0, 0), v(6, 6), Color { r: 0.75, g: 0.25, b: 0.1, a: 1.0 })
            render_batches()
            queue_scene_pass(pass)
            run_scene_passes()
            assert(SCENE_PASSES_RUN_LAST == 1)
            stone_gl_finish()
        })
        let red = read_canvas_pixel(screen_canvas, 160, 90)
        assert(red > 0.3 && red < 0.45)
        print("PIXEL_OK")
    })
}

fn main() {
    setup_stone()
    stone_lua_counter_install()
    if os_getenv("AUDIT_CASE") == "shader" { shader_bookkeeping_audit() }
    else if os_getenv("AUDIT_CASE") == "parametric" { parametric_audit() }
    else if os_getenv("AUDIT_CASE") == "bookkeeping" { bookkeeping_audit() }
    else if os_getenv("AUDIT_CASE") == "mesh" { mesh_audit() }
    else if os_getenv("AUDIT_CASE") == "segment" { segment_audit() }
    else { scene_audit() }
}
