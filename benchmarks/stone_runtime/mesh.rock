fn mesh_audit() {
    let arm = os_getenv("AUDIT_ARM") ?? "growth"
    assert(arm == "growth" || arm == "early" || arm == "reserved")
    let capacity = if arm == "reserved" { 128 } else { 8 }
    let early = arm == "early"
    let corners = os_getenv("AUDIT_CORNERS") == "1"
    let independent = os_getenv("AUDIT_INDEPENDENT_CORNERS") == "1"
    audit_measure("mesh", get_env_int("AUDIT_FRAMES", 120), (frame) => {
        let sink = 0.0
        for index in 0..100 {
            let mesh = SpriteMesh {
                vbo: native_buffer_vertex(capacity * 6), capacity, count: 0,
                texture: sampled_image(Image(0)), tex_w: 32.0, tex_h: 16.0,
                inset_x: 0.0, inset_y: 0.0, z_layer: 0,
                depth: DepthMode::Off, blend: BlendMode::Alpha,
            }
            for i in 0..93 {
                if early { reserve_quads(mesh, 1) }
                let x = float(index * 93 + i + frame % 7)
                let y = x * 0.25
                let red = float(i % 3) * 0.125 + 0.25
                let green = float(i % 5) * 0.125
                let blue = float(i % 7) * 0.125
                let alpha = float(i % 2) * 0.25 + 0.5
                sprite_mesh_add_quad(mesh, v(x, y), v(x + 2.0, y + 1.0),
                    v(x + 3.0, y - 2.0), v(x - 1.0, y - 4.0), ir(8, 4, 16, 8),
                    py: y + 7.0, tint: Color { r: red, g: green, b: blue, a: alpha },
                    colorize: red + green,
                    corner_alpha: if independent { audit_corner_alpha(index * 93 + i + frame % 7) } else if corners { Vec4 { x: red, y: green, z: blue, w: alpha } } else { null },
                    corner_colorize: if independent { audit_corner_colorize(index * 93 + i + frame % 7) } else if corners { Vec4 { x: green, y: blue, z: alpha, w: red } } else { null },
                    corner_u: if independent { audit_corner_u(index * 93 + i + frame % 7) } else if corners { Vec4 { x: x, y: y, z: red, w: green } } else { null },
                    corner_v: if independent { audit_corner_v(index * 93 + i + frame % 7) } else if corners { Vec4 { x: blue, y: alpha, z: x, w: y } } else { null })
            }
            assert(mesh.count == 558 && mesh.capacity == 128)
            let expected = float(index * 93 + 92 + frame % 7)
            let last = mesh.vbo[92 * 6].pos.x as float
            assert(last == expected)
            sink += last
            if frame == 0 && independent { audit_check_corner_mesh(mesh, index) }
        }
        assert(sink == 469550.0 + float(frame % 7) * 100.0)
    })
    print("MESH_OK")
}

fn audit_corner_alpha(q: int) -> Vec4 {
    return Vec4 { x: float(q % 13) / 16.0, y: float(q % 17) / 32.0,
        z: float(q % 19) / 32.0, w: float(q % 23) / 32.0 }
}

fn audit_corner_colorize(q: int) -> Vec4 {
    return Vec4 { x: float(q % 29) / 32.0, y: float(q % 31) / 32.0,
        z: float(q % 37) / 64.0, w: float(q % 41) / 64.0 }
}

fn audit_corner_u(q: int) -> Vec4 {
    return Vec4 { x: float(q % 43) / 64.0, y: float(q % 47) / 64.0,
        z: float(q % 53) / 64.0, w: float(q % 59) / 64.0 }
}

fn audit_corner_v(q: int) -> Vec4 {
    return Vec4 { x: float(q % 61) / 64.0, y: float(q % 67) / 128.0,
        z: float(q % 71) / 128.0, w: float(q % 73) / 128.0 }
}

fn audit_check_corner_mesh(mesh: SpriteMesh, index: int) {
    for i in 0..93 {
        let q = index * 93 + i
        let x = float(q)
        let y = x * 0.25
        let a = audit_corner_alpha(q)
        let c = audit_corner_colorize(q)
        let u = audit_corner_u(q)
        let v_ = audit_corner_v(q)
        let aa = [a.x, a.y, a.z, a.w]
        let cc = [c.x, c.y, c.z, c.w]
        let uu = [u.x, u.y, u.z, u.w]
        let vv = [v_.x, v_.y, v_.z, v_.w]
        let xx = [x, x + 2.0, x + 3.0, x - 1.0]
        let yy = [y, y + 1.0, y - 2.0, y - 4.0]
        for j in 0..6 {
            let corner = if j < 4 { j } else if j == 4 { 0 } else { 2 }
            let actual = mesh.vbo[i * 6 + j]
            assert(actual.pos.x as float == xx[corner] && actual.pos.y as float == yy[corner])
            assert(actual.uv.x as float == uu[corner] && actual.uv.y as float == vv[corner])
            assert(actual.color.x as float == float(i % 3) * 0.125 + 0.25)
            assert(actual.color.y as float == float(i % 5) * 0.125)
            assert(actual.color.z as float == float(i % 7) * 0.125)
            assert(actual.color.w as float == (float(i % 2) * 0.25 + 0.5) * aa[corner])
            assert(actual.colorize as float == cc[corner])
            assert(actual.pivot_y as float == y + 7.0)
            assert(actual.entity_id == 0.0 && actual.section.x == 0.0 && actual.section.y == 0.0)
        }
    }
}
