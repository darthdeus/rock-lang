// Screen manager - simple state machine with fade transitions.

global SCREEN_MENU: int = 0
global SCREEN_GAME: int = 1

global CURRENT_SCREEN: int = SCREEN_MENU
global FADE_ALPHA: float = 0.0
global TRANSITIONING: bool = false
global TRANSITION_TARGET: int = SCREEN_MENU

fn switch_screen(target: int) {
    if !TRANSITIONING {
        TRANSITIONING = true
        TRANSITION_TARGET = target
        start_tween("fade_out", 0.15, EASE_OUT_QUAD, 0.0, 1.0)
    }
}

@update(stage = 20)
fn update_transitions() {
    let fade_out = get_tween("fade_out")

    if fade_out != null {
        FADE_ALPHA = fade_out
        return
    }

    // fade_out just finished - flip screen, start fade_in
    if TRANSITIONING {
        CURRENT_SCREEN = TRANSITION_TARGET
        TRANSITIONING = false
        start_tween("fade_in", 0.15, EASE_IN_QUAD, 1.0, 0.0)
    }

    let fade_in = get_tween("fade_in")
    if fade_in != null {
        FADE_ALPHA = fade_in
    } else {
        FADE_ALPHA = 0.0
    }
}
