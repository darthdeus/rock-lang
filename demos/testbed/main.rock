// World-space drawing follows the camera; the screen-space header stays fixed.
const CAMERA_WIDTH: float = 32.0
const CAMERA_SPEED: float = 8.0
const GRID_COLOR: Color = color(1.0, 1.0, 1.0, 0.08)
const LABEL_COLOR: Color = color(0.75, 0.8, 0.9)

global show_grid: bool = true
global elapsed: float = 0.0

fn reset_camera() {
    camera.center = v(0, 0)
    camera.visible_world_width = CAMERA_WIDTH
}

@init
fn init_testbed() {
    reset_camera()
    ENGINE.use_bloom = false
}

@update
fn update_testbed() {
    elapsed += dt
    let x = 0.0
    let y = 0.0
    if is_key_held("left") || is_key_held("a") { x -= 1.0 }
    if is_key_held("right") || is_key_held("d") { x += 1.0 }
    if is_key_held("down") || is_key_held("s") { y -= 1.0 }
    if is_key_held("up") || is_key_held("w") { y += 1.0 }
    let direction = v(x, y)
    if direction.length() > 0.0 {
        camera.center += direction.normalize() * CAMERA_SPEED * dt
    }
    if is_key_pressed("r") { reset_camera() }
    if is_key_pressed("g") { show_grid = !show_grid }
    if mouse_wheel_delta != 0 {
        camera.visible_world_width = clamp(
            camera.visible_world_width * pow(1.2, mouse_wheel_delta), 16.0, 60.0)
        mouse_wheel_delta = 0
    }
}

@draw
fn draw_grid() {
    if !show_grid { return }
    for i in -20..21 {
        let n = float(i)
        draw_line(v(n, -20), v(n, 20), GRID_COLOR, 0.025, layer: LAYER_BACKGROUND)
        draw_line(v(-20, n), v(20, n), GRID_COLOR, 0.025, layer: LAYER_BACKGROUND)
    }
    draw_line(v(-20, 0), v(20, 0), RED.alpha(0.3), 0.04, layer: LAYER_BACKGROUND)
    draw_line(v(0, -20), v(0, 20), GREEN.alpha(0.3), 0.04, layer: LAYER_BACKGROUND)
}

@draw
fn draw_shapes() {
    draw_text("WORLD SHAPES", v(-13, 6.3), 0.65, WHITE)
    let y = 4.5
    draw_rect(v(-12, y), v(1.8, 1.8), RED)
    draw_rect_outline(v(-7, y), v(1.8, 1.8), GREEN)
    draw_circle(v(-2, y), 0.9, BLUE)
    draw_circle_outline(v(3, y), 0.9, CYAN)
    draw_line(v(7, y - 0.8), v(9, y + 0.8), MAGENTA, 0.12)
    draw_polygon([12.0, y - 0.9, 14.0, y - 0.9, 13.0, y + 0.9], ORANGE)
    let labels = ["rectangle", "outline", "circle", "circle outline", "line", "polygon"]
    for i in 0..labels.len() {
        draw_text(labels[i], v(-12.0 + float(i) * 5.0, 2.9), 0.45,
            LABEL_COLOR, TextAlign::Center)
    }
}

// The dot is the anchor; the pivot determines how the sprite extends from it.
fn draw_anchor(pos: Vec2, pivot: Vec2, label: string, tint: Color, rotation: float = 0.0) {
    draw_sprite(sampled_image(WHITE_PIXEL.unwrap()), pos,
        dest_size: v(2.0, 1.0), pivot: pivot, rotation: rotation, color: tint)
    draw_circle(pos, 0.1, WHITE, layer: LAYER_WORLD_FRONT)
    draw_text(label, pos + v(0, -2), 0.45, LABEL_COLOR, TextAlign::Center)
}

@draw
fn draw_sprite_anchors() {
    draw_text("SPRITE ANCHORS", v(-13, 0.7), 0.65, WHITE)
    draw_anchor(v(-12, -1), PIVOT_TOP_LEFT, "top left", RED)
    draw_anchor(v(-7, -1), PIVOT_TOP_CENTER, "top center", ORANGE)
    draw_anchor(v(-2, -1), PIVOT_CENTER, "center", WHITE)
    draw_anchor(v(3, -1), PIVOT_FEET, "feet", CYAN)
    draw_anchor(v(8, -1), PIVOT_BOTTOM_RIGHT, "bottom right", GREEN)
    draw_anchor(v(13, -1), PIVOT_CENTER, "rotating", MAGENTA, elapsed)
}

@draw
fn draw_animation() {
    let center = v(-10, -5.7)
    let orbit = center + v(cos(elapsed), sin(elapsed))
    draw_circle_outline(center, 1.0, CYAN.alpha(0.4))
    draw_circle(orbit, 0.2, CYAN)
    draw_text("World positions move and scale with the camera.", v(-6, -5.4), 0.55, WHITE)
    draw_text("The header stays in screen space.", v(-6, -6.4), 0.45, LABEL_COLOR)
}

@late_draw
fn draw_header() {
    screen.rect(v(0, 0), v(screen_size().x, 82), color(0.04, 0.05, 0.08))
    screen.text("Stone drawing testbed", v(20, 15), 28.0, WHITE)
    screen.text("WASD / arrows: move   Wheel: zoom   R: reset   G: grid   Esc: quit",
        v(20, 51), 18.0, LABEL_COLOR)
}

fn main() {
    stone_run_game(GameConfig {
        title: "Stone drawing testbed",
        width: 1280,
        height: 720,
        clear_color: color(0.06, 0.07, 0.1),
    })
}
