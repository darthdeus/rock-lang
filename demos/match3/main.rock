// Match-3 board with animated swaps and cascades.

const GRID_W: int = 8
const GRID_H: int = 8
const TILE_SIZE: float = 64.0
const TILE_GAP: float = 4.0
const NUM_TILE_TYPES: int = 6

// Reuse the spawn distribution across collapses.
fn tile_types() -> M3Types {
    static t: M3Types = m3_uniform(NUM_TILE_TYPES)
    return t
}

// Board origin (top-left corner of the grid in screen space)
const BOARD_X: float = 100.0
const BOARD_Y: float = 100.0

global TILE_COLORS: [Color] = [
    color(0.9, 0.2, 0.2),
    color(0.2, 0.4, 0.9),
    color(0.2, 0.8, 0.3),
    color(0.9, 0.8, 0.2),
    color(0.7, 0.3, 0.8),
    color(0.9, 0.5, 0.1),
]

global TILE_LABELS: [string] = ["R", "B", "G", "Y", "P", "O"]

// The grid is a flat array of ints, -1 means empty
// Access with: grid[y * GRID_W + x]
global grid: [int] = []

// Selected tile for swapping (null = nothing selected)
global selected: IVec2? = null

global score: int = 0
global moves: int = 0

// Logical grid updates instantly; these track visual-only offsets.

const SWAP_DURATION: float = 0.3         // seconds for swap slide
const FALL_GRAVITY: float = 2000.0       // pixels/second^2 fall acceleration
const FLASH_DURATION: float = 0.35       // seconds matched tiles flash before clearing (initial match)
const FLASH_DURATION_CASCADE: float = 0.12 // shorter flash for cascade matches (after fall)

// Swap animation: two tiles slide toward each other (0=start, 1=done)
global anim_swap_a: IVec2 = IVec2 { x: 0, y: 0 }
global anim_swap_b: IVec2 = IVec2 { x: 0, y: 0 }
global anim_swap_t: float = 1.0
// When true: swap had no match; tiles animate forward then back (Bejeweled reject)
global anim_swap_invalid: bool = false

// Per-cell fall offset: negative = tile is visually above its logical row
global fall_offsets: [float] = []
// Per-cell fall velocity (pixels/second, positive = moving downward toward destination)
global fall_velocities: [float] = []
// Landing bounce: fraction of landing velocity reflected upward (0=no bounce, 1=full)
const BOUNCE_FACTOR: float = 0.25
// Minimum landing velocity (px/s) required to trigger a bounce; below this, just stop
const BOUNCE_MIN_VELOCITY: float = 80.0

// Flash state: matched tiles blink for FLASH_DURATION before being cleared
global flash_t: float = 0.0          // countdown timer (0 = not flashing)
global flash_mask: [bool] = []       // true = this cell is about to be cleared

// Input queue: captures a full swap (two tiles) during animation.
// Bejeweled-style: queue sel->swap pair during cascade, execute when board settles.
// Only tiles not currently falling or swapping can be queued.
// Validated (match check) at execution time since the board changes during cascade.
global queued_sel: IVec2 = IVec2 { x: -1, y: -1 }    // first tile of queued move
global queued_swap_b: IVec2 = IVec2 { x: -1, y: -1 } // second tile (-1 = only partial)

// Auto-play
global auto_play: bool = false

fn grid_get(x: int, y: int) -> int {
    if x < 0 || x >= GRID_W || y < 0 || y >= GRID_H {
        return -1
    }
    return grid[y * GRID_W + x]
}

// A match3-core board view over the live grid. cells is shared by
// reference, so the core's algorithms read and mutate `grid` in place.
// Never cache it: fill_board reassigns `grid`, which would orphan a stale view.
fn grid_board() -> M3Board {
    return M3Board { w: GRID_W, h: GRID_H, cells: grid }
}

// Convert grid coordinates to screen position (top-left of tile)
fn grid_to_screen(gx: int, gy: int) -> Vec2 {
    let cell = TILE_SIZE + TILE_GAP
    return v(BOARD_X + gx * cell, BOARD_Y + gy * cell)
}

// Convert screen position to grid coordinates (-1,-1 if outside)
fn screen_to_grid(pos: Vec2) -> IVec2 {
    let cell = TILE_SIZE + TILE_GAP
    let gx = floor((pos.x - BOARD_X) / cell)
    let gy = floor((pos.y - BOARD_Y) / cell)
    if gx < 0 || gx >= GRID_W || gy < 0 || gy >= GRID_H {
        return IVec2 { x: -1, y: -1 }
    }
    // Check we're not in the gap
    let local_x = (pos.x - BOARD_X) - gx * cell
    let local_y = (pos.y - BOARD_Y) - gy * cell
    if local_x > TILE_SIZE || local_y > TILE_SIZE {
        return IVec2 { x: -1, y: -1 }
    }
    return IVec2 { x: int(gx), y: int(gy) }
}

@pure fn is_adjacent(a: IVec2, b: IVec2) -> bool {
    let dx = abs(a.x - b.x)
    let dy = abs(a.y - b.y)
    return (dx == 1 && dy == 0) || (dx == 0 && dy == 1)
}

fn fill_board() {
    grid = m3_gen_random(GRID_W, GRID_H, tile_types()).cells
}

fn has_matches() -> bool {
    return m3_has_matches(grid_board())
}

fn try_swap(a: IVec2, b: IVec2) -> bool {
    m3_swap(grid_board(), a.x, a.y, b.x, b.y)
    if has_matches() {
        return true // valid swap, leave it
    }
    m3_swap(grid_board(), a.x, a.y, b.x, b.y) // no match, swap back
    return false
}

// Replay the core collapse geometry as per-cell visual offsets so tiles
// slide into place. Surviving tiles fall from_row -> to_row; the new tiles
// in a column share one start offset (n_new rows above the board) so the
// refill column drops in as a rigid unit at a single arrival cadence.
fn apply_collapse_offsets(cx: M3Collapse) {
    let cell = TILE_SIZE + TILE_GAP
    for f in cx.falls {
        let dst = f.to_row * GRID_W + f.col
        fall_offsets[dst] = float(f.from_row - f.to_row) * cell
        fall_velocities[dst] = 0.0
    }
    let new_per_col: [int] = []
    for _c in 0..GRID_W { new_per_col.push(0) }
    for sp in cx.spawns { new_per_col[sp.col] = new_per_col[sp.col] + 1 }
    for sp in cx.spawns {
        let idx = sp.row * GRID_W + sp.col
        fall_offsets[idx] = -float(new_per_col[sp.col]) * cell
        fall_velocities[idx] = 0.0
    }
}

// Lerp between two colors
@pure fn lerp_color(a: Color, b: Color, t: float) -> Color {
    return color(
        a.r + (b.r - a.r) * t,
        a.g + (b.g - a.g) * t,
        a.b + (b.b - a.b) * t,
        1.0,
    )
}

// Find matches and start the flash timer. duration controls how long tiles highlight.
// Use FLASH_DURATION for initial player match, FLASH_DURATION_CASCADE for cascade matches.
fn find_and_flash(duration: float) {
    let matches = m3_find_matches(grid_board())
    if matches.len() == 0 { return }
    for (x, y) in matches {
        flash_mask[y * GRID_W + x] = true
    }
    flash_t = duration
}

// Collapse the flashed tiles through the core (clear -> gravity -> refill),
// then replay the recorded geometry as fall animations.
fn commit_flash() {
    let matched: [(int, int)] = []
    for i in 0..(GRID_W * GRID_H) {
        if flash_mask[i] {
            flash_mask[i] = false
            matched.push((i % GRID_W, i ./ GRID_W))
        }
    }
    if matched.len() > 0 {
        score = score + matched.len() * 10
        let cx = m3_collapse(grid_board(), matched, tile_types())
        apply_collapse_offsets(cx)
    }
}

fn has_fall_anim() -> bool {
    for i in 0..(GRID_W * GRID_H) {
        if fall_offsets[i] != 0.0 || fall_velocities[i] != 0.0 { return true }
    }
    return false
}

// True if this tile is currently in motion (falling or being swapped).
// Queued clicks on animating tiles are rejected -- their position is ambiguous.
fn is_tile_animating(x: int, y: int) -> bool {
    if fall_offsets[y * GRID_W + x] != 0.0 || fall_velocities[y * GRID_W + x] != 0.0 { return true }
    if anim_swap_t < 1.0 {
        if x == anim_swap_a.x && y == anim_swap_a.y { return true }
        if x == anim_swap_b.x && y == anim_swap_b.y { return true }
    }
    return false
}

fn advance_fall_offsets() {
    // Cap dt to 50ms to prevent physics explosion during pauses or frame drops
    let pdt = min(dt, 0.05)
    for i in 0..(GRID_W * GRID_H) {
        if fall_offsets[i] == 0.0 && fall_velocities[i] == 0.0 { continue }
        fall_velocities[i] = fall_velocities[i] + FALL_GRAVITY * pdt
        fall_offsets[i] = fall_offsets[i] + fall_velocities[i] * pdt
        // Landing: tile reached or passed its destination while moving downward
        if fall_offsets[i] >= 0.0 && fall_velocities[i] > 0.0 {
            if fall_velocities[i] > BOUNCE_MIN_VELOCITY {
                // Reflect velocity upward with damping: tile briefly rises above row
                fall_velocities[i] = -fall_velocities[i] * BOUNCE_FACTOR
                fall_offsets[i] = 0.0
            } else {
                fall_offsets[i] = 0.0
                fall_velocities[i] = 0.0
            }
        }
    }
}

// Start a swap animation. Always plays the animation; invalid swaps animate back.
fn start_swap(a: IVec2, b: IVec2) -> bool {
    let valid = try_swap(a, b)
    anim_swap_a = a
    anim_swap_b = b
    anim_swap_t = 0.0
    anim_swap_invalid = !valid
    if valid { moves = moves + 1 }
    return valid
}

fn main() {
    stone_run_game(GameConfig {
        title: "Match 3",
        width: 740,
        height: 700,
        vsync: 1,
    })
}

@init
fn init_game() {
    fill_board()

    // Initialize per-cell animation arrays
    fall_offsets = []
    fall_velocities = []
    flash_mask = []
    for _i in 0..(GRID_W * GRID_H) {
        fall_offsets.push(0.0)
        fall_velocities.push(0.0)
        flash_mask.push(false)
    }
}

@update
fn update_game() {
    // Capture clicks during animation into the swap queue (Bejeweled-style).
    // Only tiles not currently in motion can be queued.
    if is_mouse_pressed(1) && !auto_play {
        let mpos = mouse_screen()
        let gp = screen_to_grid(mpos)
        let is_animating = anim_swap_t < 1.0 || flash_t > 0.0 || has_fall_anim()
        if gp.x >= 0 && gp.y >= 0 && is_animating && !is_tile_animating(gp.x, gp.y) {
            if queued_sel.x < 0 {
                // No queued selection yet: start one
                queued_sel = gp
                queued_swap_b = IVec2 { x: -1, y: -1 }
            } else if is_adjacent(queued_sel, gp) {
                // Adjacent to queued selection: complete the swap pair
                queued_swap_b = gp
            } else {
                // Not adjacent: replace the first selection, clear swap
                queued_sel = gp
                queued_swap_b = IVec2 { x: -1, y: -1 }
            }
        }
    }

    // Swap animation -> flash (valid) or reject bounce-back (invalid)
    if anim_swap_t < 1.0 {
        anim_swap_t = anim_swap_t + dt / SWAP_DURATION
        if anim_swap_t >= 1.0 {
            anim_swap_t = 1.0
            if anim_swap_invalid {
                anim_swap_invalid = false  // animation done, return to idle
            } else {
                find_and_flash(FLASH_DURATION)
            }
        }
        return
    }

    // Flash phase: matched tiles highlighted, waiting to be cleared
    if flash_t > 0.0 {
        flash_t = flash_t - dt
        if flash_t <= 0.0 {
            flash_t = 0.0
            commit_flash()
        }
        return
    }

    // Fall animation -> cascade check via flash (short duration: cascade feels snappy)
    if has_fall_anim() {
        advance_fall_offsets()
        if !has_fall_anim() {
            find_and_flash(FLASH_DURATION_CASCADE)
        }
        return
    }

    // Execute queued swap if we have a complete pair, else surface partial selection.
    // Validated at execution time: board may have changed during the cascade.
    if queued_swap_b.x >= 0 {
        let a = queued_sel
        let b = queued_swap_b
        queued_sel = IVec2 { x: -1, y: -1 }
        queued_swap_b = IVec2 { x: -1, y: -1 }
        selected = null
        if start_swap(a, b) { return }
        // No match created (board changed during cascade): silently discard
    } else if queued_sel.x >= 0 {
        // Partial queue (first tile only): surface it as the active selection
        selected = queued_sel
        queued_sel = IVec2 { x: -1, y: -1 }
    }

    // Toggle auto-play with A
    if is_key_pressed("a") {
        auto_play = !auto_play
        selected = null
        queued_sel = IVec2 { x: -1, y: -1 }
        queued_swap_b = IVec2 { x: -1, y: -1 }
    }

    // R = reset to fresh random board
    if is_key_pressed("r") {
        fill_board()
        score = 0
        moves = 0
        selected = null
        anim_swap_t = 1.0
        auto_play = false
        flash_t = 0.0
        queued_sel = IVec2 { x: -1, y: -1 }
        queued_swap_b = IVec2 { x: -1, y: -1 }
        for i in 0..(GRID_W * GRID_H) {
            fall_offsets[i] = 0.0
            fall_velocities[i] = 0.0
            flash_mask[i] = false
        }
    }

    // Auto-play: immediately start next move when idle
    if auto_play {
        if let mv = m3_first_move(grid_board()) {
            let _ = start_swap(IVec2 { x: mv.ax, y: mv.ay }, IVec2 { x: mv.bx, y: mv.by })
        } else {
            auto_play = false
        }
        return
    }

    // Manual input (idle, no queue pending)
    if is_mouse_pressed(1) {
        let mpos = mouse_screen()
        let gpos = screen_to_grid(mpos)
        if gpos.x >= 0 && gpos.y >= 0 {
            if selected != null {
                let sel = selected
                if sel.x == gpos.x && sel.y == gpos.y {
                    selected = null  // click same tile to deselect
                } else if is_adjacent(sel, gpos) {
                    start_swap(sel, gpos)
                    selected = null
                } else {
                    selected = gpos
                }
            } else {
                selected = gpos
            }
        }
    }
}

// Helper: draw a filled rect from top-left position (screen space)
fn fill_rect(pos: Vec2, size: Vec2, c: Color) {
    stone_screen_rect(pos, size, c)
}

@late_draw
fn draw_game() {
    // Draw board background
    let cell = TILE_SIZE + TILE_GAP
    let board_w = GRID_W * cell - TILE_GAP
    let board_h = GRID_H * cell - TILE_GAP
    fill_rect(
        v(BOARD_X - 8, BOARD_Y - 8),
        v(board_w + 16, board_h + 16),
        color(0.15, 0.15, 0.2),
    )

    // Draw tiles
    let pa = grid_to_screen(anim_swap_a.x, anim_swap_a.y)
    let pb = grid_to_screen(anim_swap_b.x, anim_swap_b.y)
    let t = anim_swap_t
    for y in 0..GRID_H {
        for x in 0..GRID_W {
            let tile = grid_get(x, y)
            if tile >= 0 && tile < NUM_TILE_TYPES {
                let pos = grid_to_screen(x, y)

                // Swap animation: slide tiles toward their destinations
                if anim_swap_t < 1.0 {
                    if anim_swap_invalid {
                        // Probe: tiles slide toward each other then bounce back
                        // Triangle wave: peaks at t=0.5, returns to 0 at t=1
                        let probe = if anim_swap_t < 0.5 { anim_swap_t * 2.0 } else { (1.0 - anim_swap_t) * 2.0 }
                        if x == anim_swap_b.x && y == anim_swap_b.y {
                            pos = pb + (pa - pb) * probe
                        } else if x == anim_swap_a.x && y == anim_swap_a.y {
                            pos = pa + (pb - pa) * probe
                        }
                    } else {
                        if x == anim_swap_b.x && y == anim_swap_b.y {
                            pos = pa + (pb - pa) * t
                        } else if x == anim_swap_a.x && y == anim_swap_a.y {
                            pos = pb + (pa - pb) * t
                        }
                    }
                }

                // Fall animation: offset tiles above their logical row
                pos = v(pos.x, pos.y + fall_offsets[y * GRID_W + x])

                let c = TILE_COLORS[tile]
                let is_flashing = flash_mask[y * GRID_W + x]

                // Highlight selected tile (white = active selection)
                if selected != null {
                    let sel = selected
                    if sel.x == x && sel.y == y {
                        fill_rect(pos - v(3, 3), v(TILE_SIZE + 6, TILE_SIZE + 6), WHITE)
                    }
                }

                // Queued swap: amber border on first tile, brighter on second
                if queued_sel.x == x && queued_sel.y == y {
                    fill_rect(pos - v(3, 3), v(TILE_SIZE + 6, TILE_SIZE + 6), color(1.0, 0.65, 0.0))
                }
                if queued_swap_b.x == x && queued_swap_b.y == y {
                    fill_rect(pos - v(3, 3), v(TILE_SIZE + 6, TILE_SIZE + 6), color(1.0, 0.85, 0.2))
                }

                // Flash matched tiles: bright border + pulsing bright tile color
                if is_flashing {
                    let phase = flash_t / FLASH_DURATION
                    // pulse 3 times over the flash duration
                    let blink = (phase * 6.0) - floor(phase * 6.0)
                    let bright = if blink < 0.5 { 1.0 } else { 0.0 }
                    fill_rect(pos - v(4, 4), v(TILE_SIZE + 8, TILE_SIZE + 8), color(1.0, 0.95, 0.1))
                    c = lerp_color(c, WHITE, 0.3 + bright * 0.5)
                }

                let label = TILE_LABELS[tile]
                fill_rect(pos, v(TILE_SIZE, TILE_SIZE), c)
                screen.text(label, pos + v(20, 16), 32.0, WHITE)
            }
        }
    }

    // Draw title and stats
    screen.text("Match 3", v(BOARD_X, 30), 48.0, WHITE)
    let auto_label = if auto_play { "  [AUTO]" } else { "" }
    screen.text("Score: {score}   Moves: {moves}{auto_label}", v(BOARD_X + 220, 42), 28.0, WHITE)

    let board_bottom = BOARD_Y + float(GRID_H) * (TILE_SIZE + TILE_GAP) - TILE_GAP + 14.0
    screen.text("Click adjacent tiles to swap   A: autoplay   R: reset",
        v(BOARD_X, board_bottom), 18.0, color(0.6, 0.6, 0.7))
}
