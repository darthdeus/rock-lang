// The animated swap must advance score and settle the refilled board.
@sim
co fn animated_swap() -> Coroutine<Wait> {
    start_game "match3"

    grid = [
        3, 2, 1, 4, 3, 2, 1, 4,
        2, 1, 4, 3, 2, 1, 4, 3,
        0, 1, 0, 4, 3, 2, 1, 4,
        1, 4, 1, 3, 2, 1, 4, 3,
        1, 5, 1, 3, 2, 1, 4, 3,
        5, 0, 0, 4, 3, 2, 1, 4,
        5, 2, 3, 1, 2, 3, 2, 1,
        3, 1, 2, 4, 3, 1, 2, 4,
    ]
    await frame(2)
    sim_expect(score == 0, "board starts without score")

    // This swap starts an orange match followed by a red cascade.
    start_swap(IVec2 { x: 0, y: 4 }, IVec2 { x: 1, y: 4 })
    await frame(300)

    sim_expect(score > 0, "animated collapse advanced score")
    sim_expect(moves == 1, "one move counted")
    // Every cell refilled -- a -1 hole would mean the collapse left a gap.
    sim_expect(!has_matches(), "board settled with no pending matches")

    stop_sim()
}
