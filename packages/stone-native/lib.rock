pub struct NativeNavOwner { token: any? = null }

pub inline(lua) fn native_nav_owner(owner: NativeNavOwner, handle: int) = """
    local function own(id)
        if id <= 0 then error("native navigation fork failed", 0) end
        local guard = newproxy(true)
        local mt = getmetatable(guard)
        mt.handle = id
        mt.__gc = function() stone.stone_nav_free(id) end
        mt.__deepcopy = function() return own(tonumber(stone.stone_nav_fork(id))) end
        return guard
    end
    owner.token = own(handle)
"""

pub inline(lua) fn native_nav_handle(owner: NativeNavOwner) -> int = """
    return owner.token and getmetatable(owner.token).handle or 0
"""

pub extern(ffi, "stone") fn stone_nav_route_restore(handle: int, slot: int, generation: int, data: Ptr<NativeNavInt>, len: int, path_pos: int, cost: int, walked: int) -> int

