use stone_core::*;

pub @nomangle inline(lua) fn stone_native_library_path() -> string = """
    return os.getenv("ROCK_STONE_LIB") or (ffi.os == "OSX" and "libstone.dylib"
        or ffi.os == "Windows" and "libstone.dll" or "libstone.so")
"""

pub @nomangle fn stone_native_load() {
    ffi_cdef_once("__stone_native_ffi_defined", embed_string("stone_native.h"))
    stone_native_link()
}

inline(lua) fn stone_native_link() = """
    -- Keep the library alive across reloads and native handle finalizers.
    if not _G.stone then _G.stone = ffi.load(stone_native_library_path()) end
"""

@inline inline(lua) fn meadow_word_set(buffer: NativeBufferU8, index: int, value: float, bytes: int, pointer: string) = """
    assert(index >= 0 and index * bytes + bytes <= buffer.len)
    ffi.cast(pointer, buffer.ptr)[index] = value
"""

@inline inline(lua) fn meadow_word_get(buffer: NativeBufferU8, index: int, bytes: int, pointer: string) -> float = """
    assert(index >= 0 and index * bytes + bytes <= buffer.len)
    return tonumber(ffi.cast(pointer, buffer.ptr)[index])
"""

pub fn meadow_snapshot_set(buffer: NativeBufferU8, index: int, value: float) {
    meadow_word_set(buffer, index, value, MEADOW_WORD_BYTES, MEADOW_WORD_POINTER)
}

pub fn meadow_snapshot_get(buffer: NativeBufferU8, index: int) -> float {
    return meadow_word_get(buffer, index, MEADOW_WORD_BYTES, MEADOW_WORD_POINTER)
}

pub inline(lua) fn native_identity_new() -> int = """
    local id = (_G.__stone_identity or 0) + 1
    assert(id < 9007199254740992, "identity namespace exhausted")
    _G.__stone_identity = id
    return id
"""

inline(lua) fn __stone_register_error_collector() -> bool = """
    _G.__rock_collect_logged_errors = function()
        if _G.__rock_native_errors_collected then return end
        stone_native_load()
        if not _G.__rock_log_sink then
            _G.__rock_log_sink = function(level, category, message, wall_clock)
                stone.stone_log(level, category or "", message, wall_clock and 1 or 0)
            end
        end
        -- The level read installs the logger before any native test call.
        stone.stone_log_get_level()
        stone.stone_log_collect_errors()
        local len = ffi.new("size_t[1]")
        local function records(read)
            local text = ffi.string(read(len), len[0])
            local records, start = {}, 1
            while true do
                local stop = text:find("\0", start, true)
                if not stop then return records, tonumber(text:sub(start)) end
                records[#records + 1] = text:sub(start, stop - 1)
                start = stop + 1
            end
        end
        _G.__rock_logged_errors = {
            records = function() return records(stone.stone_log_collected_errors) end,
            scope_records = function() return records(stone.stone_log_scoped_errors) end,
            take = function(record) return stone.stone_log_take_collected_error(record, #record) ~= 0 end,
            scope_take = function(record) return stone.stone_log_take_scoped_error(record, #record) ~= 0 end,
            finish = function()
                local records, overflow = _G.__rock_logged_errors.records()
                if #records > 0 or overflow > 0 then
                    local detail = table.concat(records, "\n")
                    if overflow > 0 then detail = detail .. "\n" .. overflow .. " additional error record(s) dropped" end
                    error("logged error(s) after main: " .. detail, 0)
                end
            end,
        }
        _G.__rock_native_errors_collected = true
    end
    -- Start before user initializers and main; runner entry must not erase
    -- boot errors. Interactive processes keep lazy native loading.
    if _G.__rock_test_mode or (tonumber(os.getenv("FRAME_COUNT")) or 0) > 0
        or (tonumber(os.getenv("PERF_SECONDS")) or 0) > 0
        or (os.getenv("ROCK_RUN_SIM") or "") ~= "" then
        _G.__rock_collect_logged_errors()
    end
    return true
"""
const __stone_error_collector_registered: bool = __stone_register_error_collector()
