pub inline(lua) fn meadow_snapshot_set(buffer: NativeBufferU8, index: int, value: float) = "assert(index >= 0 and index * 8 + 8 <= buffer.len); ffi.cast('double*', buffer.ptr)[index] = value"
pub inline(lua) fn meadow_snapshot_get(buffer: NativeBufferU8, index: int) -> float = "assert(index >= 0 and index * 8 + 8 <= buffer.len); return tonumber(ffi.cast('double*', buffer.ptr)[index])"

pub extern(ffi, "stone") fn stone_terrain_noise(x: float, y: float) -> float
pub extern(ffi, "stone") fn stone_terrain_random(x: float, y: float, stream: float, seed: float) -> float
pub extern(ffi, "stone") fn stone_terrain_field(a: float, b: float, c: float, d: float, e: float, f: float, g: float, h: float, i: float, x: float, y: float, wx: float, wy: float, noisy: int) -> float

// Native validation returns JSON for conversion through the public JSON reader.
pub inline(lua) fn native_visual_bank_decode(raw: string) -> string = """
    return ffi.string(stone.stone_visual_bank_decode(raw, #raw))
"""

pub inline(lua) fn native_visual_geometry_decode(raw: string, width: int, height: int,
    cell_width: int, cell_height: int, frames: int, directions: int) -> string = """
    return ffi.string(stone.stone_visual_geometry_decode(raw, #raw, width, height, cell_width, cell_height, frames, directions))
"""

// A process-local wire namespace; copied state retains its existing value.
pub inline(lua) fn native_identity_new() -> int = """
    local id = (_G.__stone_identity or 0) + 1
    assert(id < 9007199254740992, "identity namespace exhausted")
    _G.__stone_identity = id
    return id
"""
