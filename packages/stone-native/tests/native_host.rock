@test
fn native_light_table_rejects_invalid_shapes() {
    stone_native_load()
    let floats = native_buffer_float(0)
    let ints = native_buffer_int(0)
    assert(!stone_light_table_pack(0, 8, 0.0001, 0,
        floats.ptr, floats.ptr, ints.ptr, ints.ptr, ints.ptr,
        ints.ptr, ints.ptr, floats.ptr, 0),
        "an invalid table shape returns false through the native binding")
}

@test
fn native_image_fill_rejects_invalid_handle_after_loading_twice() {
    stone_native_load()
    stone_native_load()
    assert(!stone_image_data_fill_rect_rgba8(0, 0, 0, 1, 1, 0, 0, 0, 255),
        "an unowned image handle returns false through the native binding")
}

@test
fn meadow_reads_and_writes_packed_words() {
    stone_native_load()
    let point = native_buffer_u8(MEADOW_BASE_HEADER_BYTES)
    meadow_snapshot_set(point, 4, 3.5)
    meadow_snapshot_set(point, 5, -2.25)
    meadow_snapshot_set(point, 6, 1.5)
    meadow_snapshot_set(point, 7, 1.0)
    assert_eq(stone_meadow_distance(point.ptr, point.len, 6.0, -2.25), 1.0,
        "Rust decodes the base fields written by Rock")

    let profile = native_buffer_u8(MEADOW_PROFILE_BYTES)
    assert_eq(stone_meadow_profile(3.5, -2.25, profile.ptr), 0)
    for i in 0..MEADOW_PROFILE_LANES {
        assert(meadow_snapshot_get(profile, i) > 0.0, "Rock reads the Rust output lanes")
    }
}
