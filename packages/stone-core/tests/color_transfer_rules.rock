const TRANSFER_TOL: float = 1e-9
const TRANSFER_TIGHT_TOL: float = 1e-12

@test
fn transfer_scalars_match_reference_values() {
    for (got, want, tol, rule) in [
        (srgb_channel_to_linear(0.5), 0.21404114048223, TRANSFER_TOL, "sRGB mid gray decodes to the card value"),
        // At exactly 0.04045 the <= arm divides by 12.92; the pow arm sits 2.33e-9
        // higher, so this tolerance pins the arm, not just the value.
        (srgb_channel_to_linear(0.04045), 0.00313080495356, TRANSFER_TOL, "the decode toe boundary takes the linear arm"),
        (srgb_channel_to_linear(0.04), 0.0030959752321981426, TRANSFER_TIGHT_TOL, "sRGB 0.04 decodes through the linear arm"),
        (srgb_channel_to_linear(0.041), 0.0031742787091666403, TRANSFER_TIGHT_TOL, "sRGB 0.041 decodes through the pow arm"),
        (linear_channel_to_srgb(0.5), 0.7353569830524494, TRANSFER_TIGHT_TOL, "linear 0.5 encodes to the reference"),
        (linear_channel_to_srgb(0.0031308), 0.040449936, TRANSFER_TIGHT_TOL, "the encode toe takes the linear arm"),
        (srgb_channel_to_linear(0.0), 0.0, 0.0, "sRGB black decodes to exactly zero"),
        (srgb_channel_to_linear(1.0), 1.0, TRANSFER_TIGHT_TOL, "sRGB white decodes to unit energy"),
        (linear_channel_to_srgb(0.0), 0.0, 0.0, "linear black encodes to exactly zero"),
        (linear_channel_to_srgb(1.0), 1.0, TRANSFER_TIGHT_TOL, "linear white encodes to unit sRGB"),
    ] {
        assert(abs(got - want) <= tol, "{rule}: got {got}, want {want}")
    }
}

@test
fn transfer_round_trip_recovers_off_junction_inputs() {
    for x in [0.0, 0.25, 0.5, 1.0] {
        let back = linear_channel_to_srgb(srgb_channel_to_linear(x))
        assert(abs(back - x) < TRANSFER_TIGHT_TOL,
            "the transfer round-trips its input")
    }
}

@test
fn transfer_vector_wrappers_apply_the_scalar_per_channel() {
    // Distinct channels catch a swap; exact equality holds because the wrappers
    // must call the same scalar on the same doubles.
    let decoded = srgb_to_linear(v(0.5, 0.04045, 0.0))
    assert(decoded.x == srgb_channel_to_linear(0.5)
        && decoded.y == srgb_channel_to_linear(0.04045)
        && decoded.z == srgb_channel_to_linear(0.0),
        "srgb_to_linear decodes each channel like the scalar")
    let encoded = linear_to_srgb(v(0.5, 0.0031308, 1.0))
    assert(encoded.x == linear_channel_to_srgb(0.5)
        && encoded.y == linear_channel_to_srgb(0.0031308)
        && encoded.z == linear_channel_to_srgb(1.0),
        "linear_to_srgb encodes each channel like the scalar")
    let colored = srgb_color(v(0.5, 0.04045, 0.0, 0.75))
    assert(colored.x == srgb_channel_to_linear(0.5)
        && colored.y == srgb_channel_to_linear(0.04045)
        && colored.z == srgb_channel_to_linear(0.0)
        && colored.w == 0.75,
        "srgb_color decodes rgb and preserves alpha")
}
