// Generated from eat presentation::blender_filmic_rock; parity is tested.
pub @pure fn blender_filmic_channel(value: float) -> float {
    let x = max(value, 0.0)
    if x <= 0.003000000 { return lerp(0.000000000, 0.003346536, (x - 0.000000000) / 0.003000000) }
    if x <= 0.010000000 { return lerp(0.003346536, 0.010329823, (x - 0.003000000) / 0.007000000) }
    if x <= 0.029999999 { return lerp(0.010329823, 0.034339808, (x - 0.010000000) / 0.020000000) }
    if x <= 0.050000001 { return lerp(0.034339808, 0.061246052, (x - 0.029999999) / 0.020000001) }
    if x <= 0.100000001 { return lerp(0.061246052, 0.124771819, (x - 0.050000001) / 0.050000001) }
    if x <= 0.180000007 { return lerp(0.124771819, 0.215860501, (x - 0.100000001) / 0.080000006) }
    if x <= 0.300000012 { return lerp(0.215860501, 0.318546772, (x - 0.180000007) / 0.120000005) }
    if x <= 0.500000000 { return lerp(0.318546772, 0.439657182, (x - 0.300000012) / 0.199999988) }
    if x <= 0.750000000 { return lerp(0.439657182, 0.545724452, (x - 0.500000000) / 0.250000000) }
    if x <= 1.000000000 { return lerp(0.545724452, 0.617206573, (x - 0.750000000) / 0.250000000) }
    if x <= 2.000000000 { return lerp(0.617206573, 0.775822222, (x - 1.000000000) / 1.000000000) }
    if x <= 4.000000000 { return lerp(0.775822222, 0.887923121, (x - 2.000000000) / 2.000000000) }
    if x <= 8.000000000 { return lerp(0.887923121, 0.964686275, (x - 4.000000000) / 4.000000000) }
    if x <= 16.000000000 { return lerp(0.964686275, 1.000000000, (x - 8.000000000) / 8.000000000) }
    if x <= 32.000000000 { return lerp(1.000000000, 1.000000000, (x - 16.000000000) / 16.000000000) }
    return 1.0
}

pub @pure fn blender_filmic_rgb(value: Vec3) -> Vec3 {
    return v(blender_filmic_channel(value.x), blender_filmic_channel(value.y), blender_filmic_channel(value.z))
}
