    gc_unknown_sections: int,
    gc_late_sections: int,
    gc_late_pool_capacity: int,
    gc_late_pool_exhausted: int,
    gc_negative_frame_index: int,
    gc_negative_section_id: int,
    gc_negative_delta_kb: float,
    gc_running_at_negative: bool,
    gc_open_sections: int,
    gc_section_events: int,
    gc_frame_mean_kb: float,
    gc_frame_p50_kb: float,
    gc_frame_p95_kb: float,
    gc_frame_p99_kb: float,
    gc_frame_max_kb: float,
    gc_worst_frame_index: int,
    gc_worst_frame_total_kb: float,
    gc_worst_frame_max_single_event_section_id: int,
    gc_worst_frame_max_single_event_kb: float,
    gc_frame_section_slots: int,
    gc_frame_section_overflow: int,
    gc_cache_requests: int,
    gc_cache_hits: int,
    gc_cache_misses: int,
    gc_cache_builds: int,
    gc_cache_evictions: int,
    gc_cache_high_water: int,
    gc_cache_entries_examined: int,
    gc_cache_max_entries_examined: int,
    gc_world_layout_builds: int,
    gc_cache_ui_requests: int,
    gc_cache_ui_hits: int,
    gc_cache_ui_misses: int,
    gc_cache_ui_builds: int,
    gc_cache_ui_evictions: int,
    gc_cache_world_requests: int,
    gc_cache_world_hits: int,
    gc_cache_world_misses: int,
    gc_cache_world_builds: int,
    gc_cache_world_evictions: int,
}

// PERF_OUT=<path> mirrors the summary into a file for runs whose stdout is not
// captured.
global PERF_DRAWABLE_W: int = 0
global PERF_DRAWABLE_H: int = 0
global PERF_OUT_PATH: string = ""
global PERF_OUT_BUF: string = ""

// Buffered rather than appended per call: the summary is ~25 writes, and one
// whole-file write can't leave a reader holding a half-summary.
fn perf_emit(s: string) {
    stone_write_stdout(s)
    if PERF_OUT_PATH != "" {
        PERF_OUT_BUF = "{PERF_OUT_BUF}{s}"
    }
}

// Blank a stale PERF_OUT at run start. Called from perf-mode init, before a
// single frame runs, so the file is only non-empty once this run's summary
// lands.
fn perf_out_reset() {
    let p = env_var("PERF_OUT") ?? ""
    if p == "" { return }
    if !stone_file_write(p, "") {
        log_error("PERF", "could not blank stale PERF_OUT at {p}; a reader may pick up an older run")
    }
}

const STONE_BUILD_SHA: string = build_var("GIT_SHA")

fn __perf_build_sha() -> string { return STONE_BUILD_SHA }

fn perf_out_flush() {
    if PERF_OUT_PATH == "" { return }
    if stone_file_write(PERF_OUT_PATH, PERF_OUT_BUF) {
        log_info("PERF", "summary written to {PERF_OUT_PATH}")
    } else {
        // A harness polling for this file would otherwise wait out its timeout
        // and report nothing, with the run itself looking healthy. Also on
        // stdout, not just the log: `rock perf` forwards none of the game
        // process's log output, so a log-only failure is invisible in exactly
        // the place someone is reading the summary.
        log_error("PERF", "PERF_OUT write failed for {PERF_OUT_PATH} (summary is on stdout only)")
        stone_write_stdout("PERF_OUT write FAILED for {PERF_OUT_PATH} -- summary is on stdout only\n")
    }
    PERF_OUT_BUF = ""
}

fn perf_memory_snapshot() -> MemStats {
    return MemStats {
        heap_kb_avg: PROFILE_HEAP_KB.mean,
        heap_kb_max: PROFILE_HEAP_KB.max,
        heap_drops: PROFILER.heap_drops,
        gross_lua_alloc_request_kb_per_frame: GC_WIN_RESULT,
        positive_lua_growth_kb_per_frame: GC_WIN_POSITIVE_GROWTH_RESULT,
        explicit_lua_free_kb_per_frame: GC_WIN_EXPLICIT_FREE_RESULT,
        lua_reallocation_shrink_kb_per_frame: GC_WIN_REALLOC_SHRINK_RESULT,
        lua_allocator_calls: GC_WIN_ALLOC_CALLS_RESULT,
        lua_allocation_calls: GC_WIN_ALLOCATION_CALLS_RESULT,
        lua_reallocation_calls: GC_WIN_REALLOCATION_CALLS_RESULT,
        lua_free_calls: GC_WIN_FREE_CALLS_RESULT,
        gc_allocator_stats_available: GC_WIN_ALLOC_STATS_AVAILABLE,
        gc_window_frames: GC_WIN_N,
        gc_window_available: GC_WIN_RESULT >= 0.0,
        gc_window_valid: GC_WIN_ACCOUNTING_VALID,
        gc_window_mode_running: GC_WIN_MODE_RUNNING,
        gc_collector_running_at_start: GC_WIN_COLLECTOR_RUNNING_AT_START,
        gc_section_exclusive_kb_per_frame: GC_WIN_SECTION_EXCLUSIVE_SUM_RESULT,
        gc_unsectioned_kb_per_frame: GC_WIN_UNSECTIONED_RESULT,
        gc_accounting_residual_kb_per_frame: GC_WIN_RESIDUAL_RESULT,
        gc_accounted_total_kb_per_frame: GC_WIN_ACCOUNTED_TOTAL_RESULT,
        gc_cursor_residual_kb_per_frame: GC_WIN_CURSOR_RESIDUAL_RESULT,
        gc_frame_samples: GC_WIN_FRAME_SAMPLES,
        gc_dropped_events: GC_WIN_DROPPED_EVENTS,
        gc_monotonic_failure: GC_WIN_MONOTONIC_FAILURE,
        gc_unknown_sections: GC_WIN_UNKNOWN_SECTIONS,
        gc_late_sections: GC_WIN_LATE_SECTIONS,
        gc_late_pool_capacity: GC_WIN_LATE_POOL_CAPACITY,
        gc_late_pool_exhausted: GC_WIN_LATE_POOL_EXHAUSTED,
        gc_negative_frame_index: GC_WIN_NEGATIVE_FRAME_INDEX_RESULT,
        gc_negative_section_id: GC_WIN_NEGATIVE_SECTION_ID_RESULT,
        gc_negative_delta_kb: GC_WIN_NEGATIVE_DELTA_KB_RESULT,
        gc_running_at_negative: GC_WIN_RUNNING_AT_NEGATIVE,
        gc_open_sections: PROF_OPEN_TOP,
        gc_section_events: if GC_WIN_RESULT >= 0.0 { gc_window_section_event_count() } else { -1 },
        gc_frame_mean_kb: GC_WIN_FRAME_MEAN_RESULT,
        gc_frame_p50_kb: GC_WIN_FRAME_P50_RESULT,
        gc_frame_p95_kb: GC_WIN_FRAME_P95_RESULT,
        gc_frame_p99_kb: GC_WIN_FRAME_P99_RESULT,
        gc_frame_max_kb: GC_WIN_FRAME_MAX_RESULT,
        gc_worst_frame_index: GC_WIN_WORST_FRAME_INDEX_RESULT,
        gc_worst_frame_total_kb: GC_WIN_WORST_FRAME_TOTAL_KB_RESULT,
        gc_worst_frame_max_single_event_section_id: GC_WIN_WORST_FRAME_SECTION_ID_RESULT,
        gc_worst_frame_max_single_event_kb: GC_WIN_WORST_FRAME_SECTION_KB_RESULT,
        gc_frame_section_slots: GC_WIN_FRAME_SECTION_SLOT_COUNT,
        gc_frame_section_overflow: GC_WIN_FRAME_SECTION_OVERFLOW,
        gc_cache_requests: TEXT_LAYOUT_CACHE_WINDOW_REQUESTS,
        gc_cache_hits: TEXT_LAYOUT_CACHE_WINDOW_HITS,
        gc_cache_misses: TEXT_LAYOUT_CACHE_WINDOW_MISSES,
        gc_cache_builds: TEXT_LAYOUT_CACHE_WINDOW_BUILDS,
        gc_cache_evictions: TEXT_LAYOUT_CACHE_WINDOW_EVICTIONS,
        gc_cache_high_water: TEXT_LAYOUT_CACHE_WINDOW_HIGH_WATER,
        gc_cache_entries_examined: TEXT_LAYOUT_CACHE_WINDOW_ENTRIES_EXAMINED,
        gc_cache_max_entries_examined: TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED,
        gc_world_layout_builds: TEXT_LAYOUT_CACHE_WINDOW_WORLD_BUILDS,
        gc_cache_ui_requests: TEXT_LAYOUT_CACHE_WINDOW_UI_REQUESTS,
        gc_cache_ui_hits: TEXT_LAYOUT_CACHE_WINDOW_UI_HITS,
        gc_cache_ui_misses: TEXT_LAYOUT_CACHE_WINDOW_UI_MISSES,
        gc_cache_ui_builds: TEXT_LAYOUT_CACHE_WINDOW_UI_BUILDS,
        gc_cache_ui_evictions: TEXT_LAYOUT_CACHE_WINDOW_UI_EVICTIONS,
        gc_cache_world_requests: TEXT_LAYOUT_CACHE_WINDOW_WORLD_REQUESTS,
        gc_cache_world_hits: TEXT_LAYOUT_CACHE_WINDOW_WORLD_HITS,
        gc_cache_world_misses: TEXT_LAYOUT_CACHE_WINDOW_WORLD_MISSES,
        gc_cache_world_builds: TEXT_LAYOUT_CACHE_WINDOW_WORLD_BUILDS,
        gc_cache_world_evictions: TEXT_LAYOUT_CACHE_WINDOW_WORLD_EVICTIONS,
    }
}

fn dump_perf_summary() {
    PERF_OUT_PATH = env_var("PERF_OUT") ?? ""
    PERF_OUT_BUF = ""
    let format = env_var("PERF_FORMAT") ?? "pretty"
    let n = PROFILER.frame_count

    // Only stdout needs the delimiter; PERF_OUT contains the payload alone.
    stone_write_stdout("--- PERF_SUMMARY ---\n")
    if format == "json" {
        perf_emit(profiler_perf_json())
        perf_emit("\n")
    } else if n == 0 {
        perf_emit("No frames recorded\n")
    } else {
        let rendered = perf_frame_metric(FRAME_RENDERED, PERF_FRAME_RENDERED)
        dump_perf_summary_pretty(n, PROFILER.warmup_seconds,
            rendered.mean, rendered.p50, rendered.p99,
            PROFILER.worst_frame_time * 1000.0, collect_hierarchical_stats(),
            stone_get_graphics_stats(), perf_memory_snapshot())
    }
    perf_out_flush()
}

fn fmt_metric_row(label: string, m: Metric) -> string {
    return "  {label:<14} avg {m.mean:7.3f}  p50 {m.p50:7.3f}  p90 {m.p90:7.3f}  p95 {metric_p95(m):7.3f}  p99 {m.p99:7.3f}  max {m.max:7.3f}  n {m.count}\n"
}

// The worst frame's contributor row, largest first. The pretty and JSON
// reports explain the same frame, so they share one sorted row set.
fn gc_window_worst_frame_rows() -> [(float, int)] {
    let rows: [(float, int)] = []
    if GC_WIN_WORST_FRAME_INDEX_RESULT < 0 { return rows }
    for slot in 0..GC_WIN_FRAME_SECTION_SLOT_COUNT {
        let kb = gc_window_worst_frame_section_kb(slot)
        if kb > 0.0 { rows.push((kb, nb_get(GC_WIN_FRAME_SECTION_IDS, slot))) }
    }
    sort(rows, r => -r.0)
    return rows
}

fn gc_window_worst_frame_pretty() -> string {
    if GC_WIN_WORST_FRAME_INDEX_RESULT < 0 { return "" }
    let rows = gc_window_worst_frame_rows()
    let out = "GC-window worst-frame contributors (exclusive KB):\n"
    let shown = 0
    for row in rows {
        if shown >= 8 { break }
        out = "{out}  {SECTION_NAMES[row.1]} {row.0:.2f}"
        if shown < rows.len() - 1 && shown < 7 { out = "{out}\n" }
        shown += 1
    }
    return out
}

pub fn gc_window_pretty_summary() -> string {
    if GC_WIN_RESULT < 0.0 {
        return "GC-window allocation unavailable (request --gc-window N)\n"
    }
    let validity = if GC_WIN_ACCOUNTING_VALID { "valid" } else { "INVALID" }
    let max_event_section = if GC_WIN_WORST_FRAME_SECTION_ID_RESULT < 0 {
        "unsectioned"
    } else {
        SECTION_NAMES[GC_WIN_WORST_FRAME_SECTION_ID_RESULT]
    }
    let cache_examined = if TEXT_LAYOUT_CACHE_WINDOW_REQUESTS > 0 {
        (TEXT_LAYOUT_CACHE_WINDOW_ENTRIES_EXAMINED as float)
            / (TEXT_LAYOUT_CACHE_WINDOW_REQUESTS as float)
    } else { 0.0 }
    let allocator_stats = if GC_WIN_ALLOC_STATS_AVAILABLE {
        "gross requests {GC_WIN_RESULT:.2f} KB/f, positive growth {GC_WIN_POSITIVE_GROWTH_RESULT:.2f} KB/f, explicit frees {GC_WIN_EXPLICIT_FREE_RESULT:.2f} KB/f, realloc shrinks {GC_WIN_REALLOC_SHRINK_RESULT:.2f} KB/f, calls alloc/realloc/free {GC_WIN_ALLOCATION_CALLS_RESULT}/{GC_WIN_REALLOCATION_CALLS_RESULT}/{GC_WIN_FREE_CALLS_RESULT}"
    } else { "allocator request detail unavailable" }
    let mode = if GC_WIN_MODE_RUNNING { "running" } else { "stopped" }
    return "GC-window ({validity}, mode={mode}, n={GC_WIN_N}) {allocator_stats}   exclusive sections {GC_WIN_SECTION_EXCLUSIVE_SUM_RESULT:.2f} KB/f   unsectioned {GC_WIN_UNSECTIONED_RESULT:.2f} KB/f   accounting residual {GC_WIN_RESIDUAL_RESULT:.4f} KB/f   section events {gc_window_section_event_count()}   frame-section slots {GC_WIN_FRAME_SECTION_SLOT_COUNT} overflow {GC_WIN_FRAME_SECTION_OVERFLOW}   late sections {GC_WIN_LATE_SECTIONS}/{GC_WIN_LATE_POOL_CAPACITY} pool exhausted {GC_WIN_LATE_POOL_EXHAUSTED}   unknown sections {GC_WIN_UNKNOWN_SECTIONS} {gc_window_unknown_sections_json()}\nGC-window frames mean {GC_WIN_FRAME_MEAN_RESULT:.2f} p50 {GC_WIN_FRAME_P50_RESULT:.2f} p95 {GC_WIN_FRAME_P95_RESULT:.2f} p99 {GC_WIN_FRAME_P99_RESULT:.2f} max {GC_WIN_FRAME_MAX_RESULT:.2f}   worst frame {GC_WIN_WORST_FRAME_INDEX_RESULT} total {GC_WIN_WORST_FRAME_TOTAL_KB_RESULT:.2f} KB; max single event {GC_WIN_WORST_FRAME_SECTION_KB_RESULT:.2f} KB in {max_event_section}\n{gc_window_worst_frame_pretty()}\nText-layout cache requests {TEXT_LAYOUT_CACHE_WINDOW_REQUESTS} hits {TEXT_LAYOUT_CACHE_WINDOW_HITS} misses {TEXT_LAYOUT_CACHE_WINDOW_MISSES} builds {TEXT_LAYOUT_CACHE_WINDOW_BUILDS} evictions {TEXT_LAYOUT_CACHE_WINDOW_EVICTIONS} high-water {TEXT_LAYOUT_CACHE_WINDOW_HIGH_WATER} examined avg {cache_examined:.2f} max {TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED} UI req/hit/miss/build/evict {TEXT_LAYOUT_CACHE_WINDOW_UI_REQUESTS}/{TEXT_LAYOUT_CACHE_WINDOW_UI_HITS}/{TEXT_LAYOUT_CACHE_WINDOW_UI_MISSES}/{TEXT_LAYOUT_CACHE_WINDOW_UI_BUILDS}/{TEXT_LAYOUT_CACHE_WINDOW_UI_EVICTIONS} world req/hit/miss/build/evict {TEXT_LAYOUT_CACHE_WINDOW_WORLD_REQUESTS}/{TEXT_LAYOUT_CACHE_WINDOW_WORLD_HITS}/{TEXT_LAYOUT_CACHE_WINDOW_WORLD_MISSES}/{TEXT_LAYOUT_CACHE_WINDOW_WORLD_BUILDS}/{TEXT_LAYOUT_CACHE_WINDOW_WORLD_EVICTIONS}\n"
}

fn dump_perf_summary_pretty(
    n: int,
    warmup_s: float,
    avg_ms: float,
    _median_ms: float,
    _p99_ms: float,
    worst_ms: float,
    stats: [ProfileStats],
    gfx: GraphicsStats,
    mem: MemStats,
) {
    let warmup_note = if warmup_s > 0.0 {
        ", warmup={warmup_s}s"
    } else {
        ""
    }
    let history_cap = if PERF_FRAME_CAPTURE { MAX_PERF_FRAME_HISTORY } else { MAX_FRAME_HISTORY }
    perf_emit("Frame timing (n={n}{warmup_note}, trailing up to {history_cap} measured frames, ms)\n")
    perf_emit(fmt_metric_row("rendered", perf_frame_metric(FRAME_RENDERED, PERF_FRAME_RENDERED)))
    perf_emit(fmt_metric_row("effective_cpu", perf_frame_metric(FRAME_EFFECTIVE_CPU, PERF_FRAME_EFFECTIVE_CPU)))
    perf_emit(fmt_metric_row("logic_cpu", perf_frame_metric(FRAME_LOGIC_CPU, PERF_FRAME_LOGIC_CPU)))
    perf_emit(fmt_metric_row("render_cpu", perf_frame_metric(FRAME_RENDER_CPU, PERF_FRAME_RENDER_CPU)))
    perf_emit(fmt_metric_row("present", perf_frame_metric(FRAME_PRESENT, PERF_FRAME_PRESENT)))
    perf_emit(fmt_metric_row("event_to_end", perf_frame_metric(FRAME_EVENT_TO_END, PERF_FRAME_EVENT_TO_END)))
    if PROFILER.gpu_supported {
        perf_emit(fmt_metric_row("gpu", perf_frame_metric(FRAME_GPU, PERF_FRAME_GPU)))
    } else {
        perf_emit("  gpu            n/a (GL timer unsupported on this platform)\n")
    }
    perf_emit("  worst-frame {worst_ms:.2f} (all-time)\n")
    perf_emit("\n")
    perf_emit(gpu_scopes_pretty())

    if stats.len() > 0 {
        // Auto-size the name column: max of header width and widest
        // (indent + name) across all rows, clamped to [16, 60]. Avoids
        // the previous hard-coded 30 truncating long paths like
        // a long section name and drifting the value columns.
        let name_col = "Sections".len()
        for s in stats {
            if s.count == 0 && s.work_count == 0 { continue }
            let w = s.name.len() + s.depth * 2
            if w > name_col { name_col = w }
        }
        if name_col < 16 { name_col = 16 }
        if name_col > 60 { name_col = 60 }

        let name_hdr = "Sections".pad_right(name_col)
        // `share = section mean / frame avg`. Parents include their own
        // non-child work, so children shares don't sum to parent share.
        perf_emit("{name_hdr}    mean     p95     max   share   request KB/f max request work avg  work p95  work n\n")
        for s in stats {
            if s.count == 0 && s.work_count == 0 { continue }
            let mean_ms = s.mean * 1000.0
            let p95_ms = s.p95 * 1000.0
            let max_ms = s.max_time * 1000.0
            let share = if avg_ms > 0.0 { mean_ms / avg_ms * 100.0 } else { 0.0 }
            let indent = "  ".repeat(s.depth)
            let label = "{indent}{s.name}"
            perf_emit("{label:<{name_col}}{mean_ms:7.3f} {p95_ms:7.2f} {max_ms:7.2f}  {share:5.1f}%  {s.request_mean:8.2f}  {s.request_max:8.2f}  {s.work_mean:8.0f}  {s.work_p95:8.0f}  {s.work_count:7}\n")
        }
    }

    perf_emit("\n")
    perf_emit("Graphics  draw_calls={gfx.draw_calls}  text_draws={gfx.text_draw_calls}  stream_uploads={gfx.stream_upload_calls}  stream_replacements={gfx.stream_storage_replacements}  stream_bytes={gfx.stream_upload_bytes}  streamed_vertices={gfx.streamed_vertices}  retained_uploads={gfx.retained_upload_calls}  retained_bytes={gfx.retained_upload_bytes}  retained_vertices={gfx.retained_uploaded_vertices}\n")
    perf_emit("Batches   world={RENDER_BATCH_MESH_LAST}/{RENDER_BATCH_ACTIVE_LAST}/{RENDER_BATCH_VERTS_LAST}v  ui={UI_RENDER_MESH_LAST}/{UI_RENDER_ACTIVE_LAST}/{UI_RENDER_VERTS_LAST}v  overlay={OVERLAY_RENDER_MESH_LAST}/{OVERLAY_RENDER_ACTIVE_LAST}/{OVERLAY_RENDER_VERTS_LAST}v  pool_world={RENDER_BATCHES.len()}  pool_ui={UI_RENDER_BATCHES.len()}  births_last={POOL_BIRTHS_LAST}\n")
    perf_emit("Memory    heap avg {mem.heap_kb_avg:8.1f}  max {mem.heap_kb_max:8.1f} KB   heap_drops={mem.heap_drops}\n")
    let images = stone_get_image_profile_stats()
    perf_emit("Images    loads={images.load_calls} failures={images.load_failures} decoded={images.decoded_bytes}B load={images.load_us}us uploads={images.upload_calls} uploaded={images.upload_bytes}B wait={images.wait_us}us upload={images.upload_us}us active_frames={images.active_frames} max_wait={images.max_wait_us}us\n")
    let residency = residency_profile_stats()
    perf_emit("Residency misses={residency.misses} miss_bytes={residency.miss_bytes}B cold_misses={residency.cold_misses} cold_miss_bytes={residency.cold_miss_bytes}B evictions={residency.evictions} evicted_bytes={residency.evicted_bytes}B\n")
    perf_emit(gc_window_pretty_summary())
    perf_emit("          (request traffic is Lua-only and excludes Rust/native, GPU, and driver allocations)\n")

    if GC_WIN_RESULT >= 0.0 {
        let rows: [(float, float, float, string, int, int, bool)] = []
        for id in 0..SECTION_COUNT {
            let calls = nb_get(GC_WIN_SECTION_CALLS, id)
            if calls == 0 { continue }
            let inclusive = nb_get(GC_WIN_SECTION_INCLUSIVE_KB, id) / (GC_WIN_N as float)
            let exclusive = nb_get(GC_WIN_SECTION_EXCLUSIVE_KB, id) / (GC_WIN_N as float)
            let max_exclusive = nb_get(GC_WIN_SECTION_MAX_EXCLUSIVE_KB, id)
            let depth = nb_get(GC_WIN_SECTION_DEPTH, id)
            rows.push((exclusive, inclusive, max_exclusive, SECTION_NAMES[id], calls, depth,
                section_is_late(id)))
        }
        sort(rows, r => -r.0)
        perf_emit("          GC-window sections (ranked by exclusive KB/frame; inclusive is shown for nesting;\n"
            + "          late = first reached after the registry froze, so its trailing rings are short):\n")
        perf_emit("            section                                  exclusive KB/f inclusive KB/f max self KB events depth late\n")
        let shown = 0
        for r in rows {
            if shown >= 30 { break }
            let indent = "  ".repeat(max(0, r.5))
            let nm = "{indent}{r.3}"
            let late = if r.6 { "late" } else { "" }
            perf_emit("            {nm:<40}{r.0:16.2f} {r.1:16.2f} {r.2:15.2f} {r.4:6} {r.5:5} {late}\n")
            shown = shown + 1
        }
    }
}

// The GPU scope tree as a text table. `mean` is a scope's time in the frames
// it ran in; `per frame` averages over every measured frame, and `share` is
// that against the frame root. The root minus its children is GPU time outside
// any scope, including idle while the CPU builds the next batch. Empty unless
// STONE_GPU_SCOPES is 1 or finish; under finish every row is glFinish-bracketed
// wall time, `wait/f` the part of it blocked in glFinish (the rest is CPU), and
// `before_frame` the wait for work queued before the frame.
fn gpu_scopes_pretty() -> string {
    let raw = stone_gpu_scopes_json()
    let parsed = json_decode(raw)
    if parsed == null {
        log_error("PROFILER", "gpu scope report is not JSON: {raw}")
        return ""
    }
    let doc = parsed
    let status = json_as_str(json_field(doc, "status") ?? json_null()) ?? "?"
    if status == "off" { return "" }
    if status != "on" && status != "finish" { return "GPU scopes {status}\n\n" }
    let rows = json_as_array(json_field(doc, "scopes") ?? json_null()) ?? []
    let dropped = json_as_int(json_field(doc, "dropped_frames") ?? json_null()) ?? 0
    let root_per_frame = 0.0
    let children_per_frame = 0.0
    let name_col = 16
    for r in rows {
        let depth = json_as_int(json_field(r, "depth") ?? json_null()) ?? 0
        let name = json_as_str(json_field(r, "name") ?? json_null()) ?? ""
        if name.len() + depth * 2 > name_col { name_col = name.len() + depth * 2 }
        let per_frame = json_as_float(json_field(r, "ms_per_frame") ?? json_null()) ?? 0.0
        if depth == 0 && name == "frame" { root_per_frame = per_frame }
        if depth == 1 { children_per_frame += per_frame }
    }
    if name_col > 72 { name_col = 72 }
    let title = if status == "finish" { "Finish scopes (wall)" } else { "GPU scopes" }
    let hdr = title.pad_right(name_col)
    let finish = status == "finish"
    let wait_hdr = if finish { "  wait/f" } else { "" }
    let out = "{hdr}    mean     p95     max per frame  share  calls/f     n{wait_hdr}\n"
    for r in rows {
        let depth = json_as_int(json_field(r, "depth") ?? json_null()) ?? 0
        let name = json_as_str(json_field(r, "name") ?? json_null()) ?? ""
        let ms = json_field(r, "ms") ?? json_null()
        let mean = json_as_float(json_field(ms, "mean") ?? json_null()) ?? 0.0
        let p95 = json_as_float(json_field(ms, "p95") ?? json_null()) ?? 0.0
        let mx = json_as_float(json_field(ms, "max") ?? json_null()) ?? 0.0
        let n = json_as_int(json_field(ms, "n") ?? json_null()) ?? 0
        let calls = json_as_float(json_field(r, "calls_per_frame") ?? json_null()) ?? 0.0
        let per_frame = json_as_float(json_field(r, "ms_per_frame") ?? json_null()) ?? 0.0
        let share = if root_per_frame > 0.0 { per_frame / root_per_frame * 100.0 } else { 0.0 }
        let indent = "  ".repeat(depth)
        let label = "{indent}{name}"
        let wait = if finish {
            let w = json_as_float(json_field(r, "wait_ms_per_frame") ?? json_null()) ?? 0.0
            " {w:7.3f}"
        } else { "" }
        out = out + "{label:<{name_col}}{mean:8.3f} {p95:7.3f} {mx:7.3f} {per_frame:9.3f} {share:5.1f}%  {calls:6.1f} {n:5}{wait}\n"
    }
    let outside = root_per_frame - children_per_frame
    return out + "outside top-level scopes (incl. GPU idle) {outside:.3f} ms/frame; dropped frames {dropped}\n\n"
}

pub fn perf_resources_json() -> string {
    let images = stone_get_image_profile_stats()
    let residency = residency_profile_stats()
    let census = residency_profile_census()
    return "{{\"images\":{{\"load_calls\":{images.load_calls},\"load_failures\":{images.load_failures},\"decoded_bytes\":{images.decoded_bytes},\"load_us\":{images.load_us},\"upload_calls\":{images.upload_calls},\"upload_bytes\":{images.upload_bytes},\"wait_us\":{images.wait_us},\"upload_us\":{images.upload_us},\"active_frames\":{images.active_frames},\"max_wait_us\":{images.max_wait_us}}},\"residency\":{{\"misses\":{residency.misses},\"miss_bytes\":{residency.miss_bytes},\"cold_misses\":{residency.cold_misses},\"cold_miss_bytes\":{residency.cold_miss_bytes},\"evictions\":{residency.evictions},\"evicted_bytes\":{residency.evicted_bytes},\"handles\":{census.handles},\"bytes\":{census.bytes},\"referenced_bytes\":{census.referenced_bytes},\"cached_bytes\":{census.cached_bytes},\"shared_paths\":{census.shared_paths},\"shared_bytes\":{census.shared_bytes},\"live_image_bytes\":{census.live_image_bytes},\"live_mip_bytes\":{census.live_mip_bytes},\"live_canvas_bytes\":{census.live_canvas_bytes},\"live_texture_bytes\":{residency_profile_live_texture_bytes()}}}}}"
}

// Perf exports its measured history through the same Metric summaries used
// by live capture; work populations, memory and GPU availability stay shared.
pub fn profiler_perf_json() -> string {
    let run_json = __perf_json_run()
    let mcode = if PERF_SECTION_HISTORY && PERF_FRAME_CAPTURE { perf_section_mcode_snapshot_json() } else { "null" }
    let stats = collect_hierarchical_stats()
    let gfx = stone_get_graphics_stats()
    let mem = perf_memory_snapshot()
    let frame_ms = __perf_json_frame_ms(false)
    let frame_ms_trailing = __perf_json_frame_ms(true)
    let sections_json = __perf_json_sections(stats)
    let window_json = __perf_json_section_windows()
    let section_frames = __perf_json_section_frames(mcode)
    let observations_json = __perf_json_observations()
    let mem_json = __perf_json_memory(mem)
    let graphics = "{{\"draw_calls\":{gfx.draw_calls},\"text_draws\":{gfx.text_draw_calls},\"shader_switches\":{gfx.shader_switches},\"canvas_switches\":{gfx.canvas_switches},\"stream_upload_calls\":{gfx.stream_upload_calls},\"stream_storage_replacements\":{gfx.stream_storage_replacements},\"stream_upload_bytes\":{gfx.stream_upload_bytes},\"streamed_vertices\":{gfx.streamed_vertices},\"retained_upload_calls\":{gfx.retained_upload_calls},\"retained_upload_bytes\":{gfx.retained_upload_bytes},\"retained_uploaded_vertices\":{gfx.retained_uploaded_vertices},\"world_active_batches\":{RENDER_BATCH_ACTIVE_LAST},\"world_mesh_batches\":{RENDER_BATCH_MESH_LAST},\"world_batch_vertices\":{RENDER_BATCH_VERTS_LAST},\"ui_active_batches\":{UI_RENDER_ACTIVE_LAST},\"ui_mesh_batches\":{UI_RENDER_MESH_LAST},\"ui_batch_vertices\":{UI_RENDER_VERTS_LAST},\"overlay_active_batches\":{OVERLAY_RENDER_ACTIVE_LAST},\"overlay_mesh_batches\":{OVERLAY_RENDER_MESH_LAST},\"overlay_batch_vertices\":{OVERLAY_RENDER_VERTS_LAST},\"pool_world\":{RENDER_BATCHES.len()},\"pool_ui\":{UI_RENDER_BATCHES.len()},\"births_last\":{POOL_BIRTHS_LAST}}}"
    let resources = perf_resources_json()
    let gpu_scopes = stone_gpu_scopes_json()
    let stalls = perf_stalls_json()
    let records = perf_records_json()
    let measurement = perf_measurement_json()
    let gc_steps = gc_step_json()
    let scenario = perf_scenario_json()
    let transitions = perf_transitions_json()
    let jit_health = perf_jit_health_json()
    return "{{\"measurement\":{measurement},\"timeline\":{perf_phase_json()},\"stalls\":{stalls},\"jit_health\":{jit_health},\"frame_records\":{records},\"gc_steps\":{gc_steps},\"scenario\":{scenario},\"transitions\":{transitions},\"run\":{run_json},\"frames\":{PROFILER.frame_count},\"warmup_s\":{PROFILER.warmup_seconds:.3f},\"frame_ms\":{frame_ms},\"frame_ms_trailing\":{frame_ms_trailing},\"gpu_scopes\":{gpu_scopes},\"sections\":{sections_json},\"section_window\":{window_json},\"sections_per_frame\":{section_frames},\"observations\":{observations_json},\"graphics\":{graphics},\"resources\":{resources},\"memory\":{mem_json}}}"
}

fn __perf_json_section_frames(mcode: string) -> string {
    if !PERF_SECTION_HISTORY || !PERF_FRAME_CAPTURE { return "null" }
    let rows: [string] = vec_new()
    let observations: [string] = vec_new()
    let complete = SECTION_HISTORY_DROPPED == 0 && PROFILER.frame_count <= MAX_PERF_FRAME_HISTORY
    for id in 0..SECTION_COUNT {
        let m = perf_frame_history_summary(SECTION_FRAME_TIME[id].get().unwrap())
        if m.count != PROFILER.frame_count { complete = false }
        let ms = __perf_json_stat_block(m.mean * 1000.0, m.stddev * 1000.0, m.min * 1000.0,
            m.max * 1000.0, m.p50 * 1000.0, m.p90 * 1000.0, metric_p95(m) * 1000.0, m.p99 * 1000.0, m.count)
        let name = __perf_json_escape_name(SECTION_NAMES[id])
        let calls = nb_get(SECTION_HISTORY_CALLS, id)
        let calls_per_frame = if m.count > 0 { (calls as float) / (m.count as float) } else { 0.0 }
        rows.push("{{\"name\":\"{name}\",\"calls\":{calls},\"calls_per_frame\":{calls_per_frame:.6f},\"ms\":{ms}}}")
        let observation = perf_frame_history_summary(SECTION_FRAME_OBSERVATION[id].get().unwrap())
        if observation.count != PROFILER.frame_count { complete = false }
        if SECTION_WINDOWS[id].observations > 0 {
            let values = __perf_json_metric(observation)
            observations.push("{{\"name\":\"{name}\",\"ms\":{values}}}")
        }
    }
    return "{{\"complete\":{complete},\"capacity\":{MAX_PERF_FRAME_HISTORY},\"dropped_events\":{SECTION_HISTORY_DROPPED},\"mcode_snapshot\":{mcode},\"observations_per_frame\":[{observations.join(\",\")}],\"rows\":[{rows.join(\",\")}]}}"
}

// Sample only at export, after the timed window. Retained trace bytes exclude
// freed epochs and arena overhead; they are not cumulative code generation.
inline(lua) fn perf_section_mcode_snapshot_json() -> string = """
    local ok, util = pcall(require, "jit.util")
    if not ok then return '{"available":false,"bytes":null,"traces":null}' end
    local bytes, traces = 0, 0
    for id = 1, 65535 do
        if util.traceinfo(id) then
            local code = util.tracemc(id)
            if type(code) ~= "string" then
                return '{"available":false,"bytes":null,"traces":null}'
            end
            bytes, traces = bytes + #code, traces + 1
        end
    end
    return string.format('{"available":true,"bytes":%d,"traces":%d}', bytes, traces)
"""

// Top abort sites reported per run. The total covers every site, so a
// truncated list still reconciles against the abort count.
const PERF_JIT_ABORT_SITES: int = 50

// The counter handler keeps sites as numeric ids; this is the only place they
// become locations and reason names, so a timing capture pays no lookup. Rows
// come from the snapshot the window close or the export took.
@nomangle inline(lua) fn __perf_jit_abort_site_fields_json(limit: int, total: int) -> string = """
    local report = _G.__stone_jit_abort_site_report
    local rows
    if report ~= nil then
        rows = report.rows
    else
        rows = __stone_jit_abort_site_rows_of(_G.__stone_jit_abort_sites)
    end
    local loc_of = __stone_jit_make_loc_of()
    local reason_name = __stone_jit_make_reason_name()
    local prototypes = _G.__stone_jit_program_identity()
    local function proto_json(func)
        local proto = prototypes.describe(func)
        if proto == nil then return 'null' end
        return string.format('{"function_id":%d,"source":"%s","definition_line":%d,"bytecodes":%d}',
            proto.function_id, __perf_json_escape_name(proto.source), proto.definition_line, proto.bytecodes)
    end
    local resolved = {}
    for i = 1, #rows do
        local row = rows[i]
        resolved[#resolved + 1] = { n = row.n,
            reason = reason_name(row.r, row.x),
            abort_loc = loc_of(row.af, row.apc),
            start_loc = loc_of(row.sf, row.spc),
            abort_proto = proto_json(row.af), start_proto = proto_json(row.sf) }
    end
    table.sort(resolved, function(a, b)
        if a.n ~= b.n then return a.n > b.n end
        if a.reason ~= b.reason then return a.reason < b.reason end
        if a.abort_loc ~= b.abort_loc then return a.abort_loc < b.abort_loc end
        return a.start_loc < b.start_loc
    end)
    local shown = #resolved
    if shown > limit then shown = limit end
    local out = {}
    for i = 1, shown do
        local row = resolved[i]
        out[#out + 1] = '{"reason":"' .. __perf_json_escape_name(row.reason) ..
            '","abort_loc":"' .. __perf_json_escape_name(row.abort_loc) ..
            '","start_loc":"' .. __perf_json_escape_name(row.start_loc) ..
            '","start_proto":' .. row.start_proto .. ',"abort_proto":' .. row.abort_proto ..
            ',"count":' .. string.format("%d", row.n) .. '}'
    end
    return '"abort_sites":[' .. table.concat(out, ',') ..
        '],"abort_sites_total":' .. string.format("%d", total) ..
        ',"program_prototypes":' .. string.format("%d", prototypes.count)
"""

// Sites exist whenever a trace handler is attached: both of them feed the
// counter event that records them, and the full census adds its buckets on
// top. A completed allocation window closed its own era, whose count is that
// window's abort count; otherwise the total is the process count this same
// document reports as `aborts`. Present and empty means the handler ran and
// no abort happened.
fn __perf_json_jit_abort_sites(process_aborts: int) -> string {
    if process_aborts < 0 {
        return "\"abort_sites\":null,\"abort_sites_total\":null"
    }
    let windowed = GC_WIN_TRACE_AVAILABLE && GC_WIN_TRACE_ABORTS_RESULT >= 0
    let total = if windowed { GC_WIN_TRACE_ABORTS_RESULT } else { process_aborts }
    return __perf_jit_abort_site_fields_json(PERF_JIT_ABORT_SITES, total)
}

// Provenance + EFFECTIVE config. Records what the run actually did, not what
// it was asked to do: an ablation whose knob silently failed to apply is
// otherwise indistinguishable from one that applied and changed nothing --
// a null result that reads as a finding. `run_id` echoes PERF_RUN_ID so a
// harness can reject a stale file outright rather than trusting a filename.
fn __perf_json_run() -> string {
    let run_id = env_var("PERF_RUN_ID") ?? ""
    let sha = __perf_build_sha()
    let jit = jit_status_string()
    // Process totals since the first attach, not per Session. The site rows are
    // taken before these reads so no later abort can outgrow their total.
    __stone_jit_abort_sites_export()
    let trace_known = jit_trace_counts_available()
    let trace_starts = if trace_known { jit_trace_count_of("starts") } else { -1 }
    let trace_aborts = if trace_known { jit_trace_count_of("aborts") } else { -1 }
    let trace_compiles = if trace_known { jit_trace_count_of("compiles") } else { -1 }
    let trace_flushes = if trace_known { jit_trace_count_of("flushes") } else { -1 }
    let jit_native = jit_native_health_json()
    let jit_trace = "{{\"available\":{trace_known},\"logging\":{JIT_TRACE_LOG_ENABLED},\"starts\":{__perf_json_gc_int(trace_starts, trace_known)},\"compiles\":{__perf_json_gc_int(trace_compiles, trace_known)},\"aborts\":{__perf_json_gc_int(trace_aborts, trace_known)},\"flushes\":{__perf_json_gc_int(trace_flushes, trace_known)},{__perf_json_jit_abort_sites(trace_aborts)}}}"
    let bloom_on = ENGINE.use_bloom && !fx_disabled("bloom")
    // The ablation set verbatim: a run that disabled features must say so, or
    // its numbers read as the baseline's.
    let fx_off = os_getenv("STONE_FX_OFF") ?? ""
    let sync = os_getenv("STONE_PRESENT_SYNC") ?? "auto"
    let seed = os_getenv("ROCK_TEST_SEED") ?? ""
    let sections = if PROFILER_SECTIONS_OFF != 0 { "off" } else { "on" }
    let gpu_scopes = if stone_gpu_scopes_finish() { "finish" } else if stone_gpu_scopes_requested() { "on" } else { "off" }
    return "{{\"run_id\":\"{run_id}\",\"build_sha\":\"{sha}\",\"drawable\":[{PERF_DRAWABLE_W},{PERF_DRAWABLE_H}],\"jit\":\"{jit}\",\"jit_trace\":{jit_trace},\"jit_native\":{jit_native},\"sections\":\"{sections}\",\"bloom\":{bloom_on},\"fx_off\":\"{fx_off}\",\"present_sync\":\"{sync}\",\"gpu_scopes\":\"{gpu_scopes}\",\"seed\":\"{seed}\",\"game_dir\":\"{GAME_SOURCE_DIR}\"}}"
}

@nomangle fn __perf_json_escape_name(s: string) -> string {
    return s.replace("\\", "\\\\").replace("\"", "\\\"")
}

fn __perf_json_worst_frame_sections(available: bool) -> string {
    if !available || GC_WIN_WORST_FRAME_INDEX_RESULT < 0 { return "[]" }
    let rows = gc_window_worst_frame_rows()
    let parts: [string] = []
    let shown = 0
    for row in rows {
        if shown >= 12 { break }
        let name = __perf_json_escape_name(SECTION_NAMES[row.1])
        parts.push("{{\"section_id\":{row.1},\"name\":\"{name}\",\"exclusive_kb\":{row.0:.4f}}}")
        shown += 1
    }
    return "[{join(parts, ",")}]"
}

// The one uniform stat block. Every series in the perf JSON -- frame timing,
// section duration, section alloc, memory -- serializes through this.
@pure
fn __perf_json_stat_block(mean: float, stddev: float, mn: float, mx: float, p50: float, p90: float, p95: float, p99: float, n: int) -> string {
    return "{{\"mean\":{mean:.4f},\"stddev\":{stddev:.4f},\"min\":{mn:.4f},\"max\":{mx:.4f},\"p50\":{p50:.4f},\"p90\":{p90:.4f},\"p95\":{p95:.4f},\"p99\":{p99:.4f},\"n\":{n}}}"
}

fn __perf_json_metric(m: Metric) -> string {
    return __perf_json_stat_block(m.mean, m.stddev, m.min, m.max, m.p50, m.p90, metric_p95(m), m.p99, m.count)
}

fn __perf_json_nullable_int(v: int) -> string {
    return if v < 0 { "null" } else { "{v}" }
}

fn __perf_json_gc_float(v: float, available: bool) -> string {
    return if available { "{v:.4f}" } else { "null" }
}

fn __perf_json_gc_int(v: int, available: bool) -> string {
    return if available { "{v}" } else { "null" }
}

// frame_ms: an object of the seven named timing series, each a uniform block.
// Metrics already store ms (metric_add scales by 1000), so no rescale here.
fn __perf_json_frame_ms(trailing: bool) -> string {
    let logic = __perf_json_metric(perf_frame_metric(FRAME_LOGIC_CPU, PERF_FRAME_LOGIC_CPU, trailing))
    let render = __perf_json_metric(perf_frame_metric(FRAME_RENDER_CPU, PERF_FRAME_RENDER_CPU, trailing))
    let eff = __perf_json_metric(perf_frame_metric(FRAME_EFFECTIVE_CPU, PERF_FRAME_EFFECTIVE_CPU, trailing))
    let present = __perf_json_metric(perf_frame_metric(FRAME_PRESENT, PERF_FRAME_PRESENT, trailing))
    let gpu = __perf_json_metric(perf_frame_metric(FRAME_GPU, PERF_FRAME_GPU, trailing))
    let rendered = __perf_json_metric(perf_frame_metric(FRAME_RENDERED, PERF_FRAME_RENDERED, trailing))
    let event = __perf_json_metric(perf_frame_metric(FRAME_EVENT_TO_END, PERF_FRAME_EVENT_TO_END, trailing))
    let lag = "{{\"count\":{PROFILER.lag_spike_count},\"threshold_ms\":{PROFILER.lag_threshold * 1000.0:.4f},\"worst_ms\":{PROFILER.worst_frame_time * 1000.0:.4f}}}"
    return "{{\"logic_cpu\":{logic},\"render_cpu\":{render},\"effective_cpu\":{eff},\"present\":{present},\"gpu\":{gpu},\"rendered\":{rendered},\"event_to_end_frame\":{event},\"lag_spikes\":{lag}}}"
}

fn __perf_json_section(s: ProfileStats) -> string {
    // Section timing Metrics store seconds; scale the whole block to ms.
    let to_ms = 1000.0
    let mean_ms = s.mean * to_ms
    let avg_ms = if PERF_FRAME_CAPTURE { PERF_FRAME_RENDERED.mean } else { FRAME_RENDERED.mean }
    let share = if avg_ms > 0.0 { mean_ms / avg_ms } else { 0.0 }
    let ms = __perf_json_stat_block(mean_ms, s.std_dev * to_ms, s.min_time * to_ms, s.max_time * to_ms, s.p50 * to_ms, s.p90 * to_ms, s.p95 * to_ms, s.p99 * to_ms, s.count)
    let request = __perf_json_stat_block(s.request_mean, s.request_std_dev, s.request_min, s.request_max, s.request_p50, s.request_p90, s.request_p95, s.request_p99, s.request_count)
    let name = __perf_json_escape_name(s.name)
    let work = "{{\"mean\":{s.work_mean:.4f},\"p95\":{s.work_p95:.4f},\"p99\":{s.work_p99:.4f},\"max\":{s.work_max:.4f},\"n\":{s.work_count}}}"
    let gc_available = s.gc_events > 0
    let section_id = if gc_available { "{s.section_id}" } else { "null" }
    let gc_alloc = "{{\"section_id\":{section_id},\"inclusive_kb_per_frame\":{__perf_json_gc_float(s.gc_inclusive_kb_per_frame, gc_available)},\"exclusive_kb_per_frame\":{__perf_json_gc_float(s.gc_exclusive_kb_per_frame, gc_available)},\"max_exclusive_kb_per_frame\":{__perf_json_gc_float(s.gc_max_exclusive_kb_per_frame, gc_available)},\"events\":{__perf_json_nullable_int(s.gc_events)},\"depth\":{__perf_json_nullable_int(s.gc_depth)},\"parent_id\":{__perf_json_nullable_int(s.gc_parent_id)},\"parent_mixed\":{__perf_json_nullable_int(s.gc_parent_mixed)}}}"
    return "{{\"name\":\"{name}\",\"depth\":{s.depth},\"share\":{share:.4f},\"late\":{s.late},\"ms\":{ms},\"request_kb\":{request},\"gc_window_alloc\":{gc_alloc},\"work\":{work}}}"
}

fn __perf_json_sections(stats: [ProfileStats]) -> string {
    let parts: [string] = vec_new()
    for s in stats {
        if s.count == 0 && s.work_count == 0 && s.gc_events <= 0 { continue }
        parts.push(__perf_json_section(s))
    }
    return "[{join(parts, \",\")}]"
}

fn gc_window_origin_json(bytes: float, calls: int, available: bool) -> string {
    let requested_bytes = if available { "{bytes:.0f}" } else { "null" }
    let kb = if available { "{bytes / 1024.0 / (GC_WIN_N as float):.4f}" } else { "null" }
    return "{{\"request_bytes\":{requested_bytes},\"request_kb_per_frame\":{kb},\"allocator_calls\":{__perf_json_gc_int(calls, available)}}}"
}

fn gc_window_split_json(available: bool) -> string {
    let valid = available && GC_WIN_SPLIT_AVAILABLE
    let mutator = gc_window_origin_json(GC_WIN_MUTATOR_BYTES_RESULT, GC_WIN_MUTATOR_CALLS_RESULT, valid)
    let jit = gc_window_origin_json(GC_WIN_JIT_BYTES_RESULT, GC_WIN_JIT_CALLS_RESULT, valid)
    let gc = gc_window_origin_json(GC_WIN_GC_BYTES_RESULT, GC_WIN_GC_CALLS_RESULT, valid)
    return "{{\"available\":{valid},\"basis\":\"luajit-vmstate\",\"mutator\":{mutator},\"jit_internal\":{jit},\"gc\":{gc}}}"
}

fn __perf_json_section_windows() -> string {
    let rows: [string] = []
    for id in 0..SECTION_COUNT {
        let w = SECTION_WINDOWS[id]
        if w.calls == 0 && w.work_observations == 0 && w.observations == 0 { continue }
        let name = __perf_json_escape_name(SECTION_NAMES[id])
        let ms = __perf_json_metric(perf_frame_history_summary(w.frame_ms))
        let calls = __perf_json_metric(perf_frame_history_summary(w.calls_per_frame))
        let work = __perf_json_metric(perf_frame_history_summary(w.work_per_frame))
        let observations = __perf_json_metric(perf_frame_history_summary(w.observations_per_frame))
        rows.push("{{\"name\":\"{name}\",\"calls\":{w.calls},\"total_ms\":{w.seconds * 1000.0:.4f},\"work_units\":{w.work_units},\"work_observations\":{w.work_observations},\"observations\":{w.observations},\"observation_total_ms\":{w.observation_ms:.4f},\"ms_per_frame\":{ms},\"calls_per_frame\":{calls},\"work_per_frame\":{work},\"observations_per_frame\":{observations}}}")
    }
    return "{{\"frames\":{PROFILER.frame_count},\"basis\":\"completed-frames-since-reset\",\"distribution_basis\":\"trailing-120-frames-since-name-admission\",\"sections\":[{rows.join(\",\")}]}}"
}

fn __perf_json_observations() -> string {
    let parts: [string] = vec_new()
    for id in 0..SECTION_COUNT {
        let m = section_observation_metric(id)
        if m.count == 0 { continue }
        let name = __perf_json_escape_name(SECTION_NAMES[id])
        let values = __perf_json_metric(m)
        let last = nb_get(SECTION_LAST_OBSERVATION_MS, id)
        parts.push("{{\"name\":\"{name}\",\"last_ms\":{last:.4f},\"ms\":{values}}}")
    }
    return "[{join(parts, \",\")}]"
}

fn __perf_json_memory(mem: MemStats) -> string {
    let heap = __perf_json_metric(PROFILE_HEAP_KB)
    let requested = if mem.gc_window_frames > 0 {
        "{mem.gc_window_frames}"
    } else { "null" }
    let measured = if mem.gc_window_available {
        "{mem.gc_window_frames}"
    } else { "null" }
    let mode = if !mem.gc_window_available {
        "null"
    } else if mem.gc_window_mode_running {
        "\"running\""
    } else { "\"stopped\"" }
    let collector_running_at_start = if mem.gc_window_available {
        "{mem.gc_collector_running_at_start}"
    } else { "null" }
    let section_events = __perf_json_nullable_int(mem.gc_section_events)
    let monotonic_failure = if mem.gc_window_available {
        "{mem.gc_monotonic_failure}"
    } else { "null" }
    let running_at_negative = if mem.gc_window_available {
        "{mem.gc_running_at_negative}"
    } else { "null" }
    let negative_sample = if !mem.gc_window_available {
        "null"
    } else if mem.gc_negative_frame_index >= 0 {
        "{{\"frame_index\":{mem.gc_negative_frame_index},\"section_id\":{__perf_json_nullable_int(mem.gc_negative_section_id)},\"delta_kb\":{mem.gc_negative_delta_kb:.4f}}}"
    } else {
        "{{\"frame_index\":null,\"section_id\":null,\"delta_kb\":null}}"
    }
    let distribution = "{{\"mean_kb_per_frame\":{__perf_json_gc_float(mem.gc_frame_mean_kb, mem.gc_window_available)},\"p50_kb_per_frame\":{__perf_json_gc_float(mem.gc_frame_p50_kb, mem.gc_window_available)},\"p95_kb_per_frame\":{__perf_json_gc_float(mem.gc_frame_p95_kb, mem.gc_window_available)},\"p99_kb_per_frame\":{__perf_json_gc_float(mem.gc_frame_p99_kb, mem.gc_window_available)},\"max_kb_per_frame\":{__perf_json_gc_float(mem.gc_frame_max_kb, mem.gc_window_available)}}}"
    let allocator_available = mem.gc_window_available && mem.gc_allocator_stats_available
    let worst_frame = "{{\"frame_index\":{__perf_json_gc_int(mem.gc_worst_frame_index, mem.gc_window_available)},\"total_kb\":{__perf_json_gc_float(mem.gc_worst_frame_total_kb, mem.gc_window_available)},\"max_single_event\":{{\"section_id\":{__perf_json_gc_int(mem.gc_worst_frame_max_single_event_section_id, mem.gc_window_available)},\"kb\":{__perf_json_gc_float(mem.gc_worst_frame_max_single_event_kb, mem.gc_window_available)}}},\"sections\":{__perf_json_worst_frame_sections(mem.gc_window_available)}}}"
    let cache = if mem.gc_cache_requests >= 0 {
        let examined_avg = if mem.gc_cache_requests > 0 {
            (mem.gc_cache_entries_examined as float) / (mem.gc_cache_requests as float)
        } else { 0.0 }
        "{{\"requests\":{mem.gc_cache_requests},\"hits\":{mem.gc_cache_hits},\"misses\":{mem.gc_cache_misses},\"builds\":{mem.gc_cache_builds},\"evictions\":{mem.gc_cache_evictions},\"high_water\":{mem.gc_cache_high_water},\"avg_entries_examined\":{examined_avg:.4f},\"max_entries_examined\":{mem.gc_cache_max_entries_examined},\"world_layout_builds\":{mem.gc_world_layout_builds},\"ui\":{{\"requests\":{mem.gc_cache_ui_requests},\"hits\":{mem.gc_cache_ui_hits},\"misses\":{mem.gc_cache_ui_misses},\"builds\":{mem.gc_cache_ui_builds},\"evictions\":{mem.gc_cache_ui_evictions}}},\"world\":{{\"requests\":{mem.gc_cache_world_requests},\"hits\":{mem.gc_cache_world_hits},\"misses\":{mem.gc_cache_world_misses},\"builds\":{mem.gc_cache_world_builds},\"evictions\":{mem.gc_cache_world_evictions}}}}}"
    } else { "null" }
    let unknown_sections = __perf_json_gc_int(mem.gc_unknown_sections, mem.gc_window_available)
    let late_sections = __perf_json_gc_int(mem.gc_late_sections, mem.gc_window_available)
    let late_capacity = __perf_json_gc_int(mem.gc_late_pool_capacity, mem.gc_window_available)
    let late_exhausted = __perf_json_gc_int(mem.gc_late_pool_exhausted, mem.gc_window_available)
    let unknown_diagnostics = gc_window_unknown_sections_json()
    let split = gc_window_split_json(mem.gc_window_available)
    let trace = gc_window_trace_json(mem.gc_window_available)
    let requested_start = get_env_int("PERF_GC_WINDOW_START", 100)
    let after_warmup = os_getenv("PERF_GC_WINDOW_AFTER_WARMUP") == "1"
    let gc_window = "{{\"requested_start_frame\":{requested_start},\"after_warmup\":{after_warmup},\"allocation_split\":{split},\"jit_trace\":{trace},\"start_frame\":{__perf_json_gc_int(GC_WIN_START, mem.gc_window_available)},\"requested_frames\":{requested},\"measured_frames\":{measured},\"available\":{mem.gc_window_available},\"valid\":{mem.gc_window_valid},\"mode\":{mode},\"collector_running_at_start\":{collector_running_at_start},\"gross_request_kb_per_frame\":{__perf_json_gc_float(mem.gross_lua_alloc_request_kb_per_frame, mem.gc_window_available)},\"positive_growth_kb_per_frame\":{__perf_json_gc_float(mem.positive_lua_growth_kb_per_frame, allocator_available)},\"explicit_free_kb_per_frame\":{__perf_json_gc_float(mem.explicit_lua_free_kb_per_frame, allocator_available)},\"reallocation_shrink_kb_per_frame\":{__perf_json_gc_float(mem.lua_reallocation_shrink_kb_per_frame, allocator_available)},\"allocator_calls\":{__perf_json_gc_int(mem.lua_allocator_calls, allocator_available)},\"allocation_calls\":{__perf_json_gc_int(mem.lua_allocation_calls, allocator_available)},\"reallocation_calls\":{__perf_json_gc_int(mem.lua_reallocation_calls, allocator_available)},\"free_calls\":{__perf_json_gc_int(mem.lua_free_calls, allocator_available)},\"accounted_total_kb_per_frame\":{__perf_json_gc_float(mem.gc_accounted_total_kb_per_frame, mem.gc_window_available)},\"sum_exclusive_section_kb_per_frame\":{__perf_json_gc_float(mem.gc_section_exclusive_kb_per_frame, mem.gc_window_available)},\"unsectioned_kb_per_frame\":{__perf_json_gc_float(mem.gc_unsectioned_kb_per_frame, mem.gc_window_available)},\"accounting_residual_kb_per_frame\":{__perf_json_gc_float(mem.gc_accounting_residual_kb_per_frame, mem.gc_window_available)},\"cursor_residual_kb_per_frame\":{__perf_json_gc_float(mem.gc_cursor_residual_kb_per_frame, mem.gc_window_available)},\"frame_samples\":{__perf_json_gc_int(mem.gc_frame_samples, mem.gc_window_available)},\"dropped_events\":{__perf_json_gc_int(mem.gc_dropped_events, mem.gc_window_available)},\"unknown_sections\":{unknown_sections},\"unknown_section_diagnostics\":{unknown_diagnostics},\"late_sections\":{late_sections},\"late_pool_capacity\":{late_capacity},\"late_pool_exhausted\":{late_exhausted},\"frame_section_slots\":{__perf_json_gc_int(mem.gc_frame_section_slots, mem.gc_window_available)},\"frame_section_overflow\":{__perf_json_gc_int(mem.gc_frame_section_overflow, mem.gc_window_available)},\"monotonic_failure\":{monotonic_failure},\"running_at_negative\":{running_at_negative},\"negative_sample\":{negative_sample},\"open_sections\":{__perf_json_gc_int(mem.gc_open_sections, mem.gc_window_available)},\"section_events\":{section_events},\"frame_distribution\":{distribution},\"worst_frame\":{worst_frame},\"text_layout_cache\":{cache}}}"
    return "{{\"heap_kb\":{heap},\"heap_drops\":{mem.heap_drops},\"gross_lua_alloc_request_kb_per_frame\":{__perf_json_gc_float(mem.gross_lua_alloc_request_kb_per_frame, mem.gc_window_available)},\"gc_window\":{gc_window}}}"
}


// Plot one Metric's insertion-order ring as a pooled polyline (newest on the
// right), scaled to a shared vmax, at UI z. Each segment is a px_line quad --
// no immediate draw_line calls.
fn draw_metric_line(m: Metric, n: int, vmax: float, gx: float, gy: float, gw: float, gh: float, color: Color, z: int) {
    if n < 2 || vmax <= 0.0 { return () }
    let step_x = gw / ((n - 1) as float)
    for i in 0..(n - 1) {
        let v1 = min(metric_recent(m, i), vmax)
        let v2 = min(metric_recent(m, i + 1), vmax)
        let x1 = gx + gw - (i as float) * step_x
        let y1 = gy + gh - (v1 / vmax) * gh
        let x2 = gx + gw - ((i + 1) as float) * step_x
        let y2 = gy + gh - (v2 / vmax) * gh
        px_line(v(x1, y1), v(x2, y2), color, 1.0, z)
    }
}

pub fn frame_timing_display_max_ms() -> float {
    return max(1000.0 / 60.0,
        max(FRAME_RENDERED.max, FRAME_EFFECTIVE_CPU.max))
}

fn draw_frame_timing_plot_px(gx: float, gy: float, gw: float, gh: float, z: int) {
    px_fill(v(gx, gy), v(gw, gh), color(0.02, 0.025, 0.04, 0.9), z)
    px_outline(v(gx, gy), v(gw, gh), color(1.0, 1.0, 1.0, 0.25), 1.0, z)

    let rendered = FRAME_RENDERED
    let effective = FRAME_EFFECTIVE_CPU
    let samples = min(rendered.count, float_to_int(gw / 2.0))
    if samples < 2 { return }

    let vmax = frame_timing_display_max_ms()
    draw_metric_line(effective, samples, vmax, gx, gy, gw, gh, color(0.3, 0.8, 1.0, 1.0), z)
    draw_metric_line(rendered, samples, vmax, gx, gy, gw, gh, color(1.0, 0.4, 0.4, 1.0), z)
}

pub fn draw_frame_timing_plot(r: UiRect) {
    let s = ui_to_screen(r)
    draw_frame_timing_plot_px(s.x, s.y, s.w, s.h, r.z)
}

// Bottom-left frame-time graph. Plots the rendered (red) and effective_cpu
// (cyan) Metric rings on a shared ms scale -- the gap between them is the
// present/vsync block, so headroom under vsync reads at a glance. Both series
// are the same Metrics the overlay + PERF_SUMMARY use (no parallel ring).
// Entirely pooled (px_fill/px_line + queue_ui_text) at PROFILER_UI_Z -- the
// ~400 immediate draw_line calls/frame collapse into one z-sorted batch.
pub fn draw_profiler_graph() {
    if !ENGINE.profiler_enabled || PROFILER.frame_count < 2 { return () }

    let screen_dims = v(get_screen_width(), get_screen_height())
    let graph_width = 400.0
    let graph_height = 100.0
    let graph_x = 10.0
    let graph_y = screen_dims.y - graph_height - 10.0
    let z = PROFILER_UI_Z

    draw_frame_timing_plot_px(graph_x, graph_y, graph_width, graph_height, z)

    let font = DEFAULT_FONT ?? return
    queue_ui_text_output_px(font, "Frame ms  red=rendered cyan=effective",
        v(graph_x + 5.0, graph_y + 5.0), PROFILER_GRAPH_FONT_SIZE, WHITE, v(), z + 1)
}
