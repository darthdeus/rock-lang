// Read one block's bytes back out, by block name. Desktop GL only
// (`glGetBufferSubData` does not exist in GLES) and the only thing on either
// side of the FFI that can see what a block buffer holds, which is why it is a
// probe rather than anything the render path uses. `size` must equal the
// block's own.
pub extern(ffi, "stone") fn stone_shader_read_uniform_block(handle: int, block_name: string, dst: PtrU8, size: int) -> bool

// GL's own uniform-block binding state as JSON (0 = every block-owning program
// plus each indexed binding point). Diagnostic only: it queries GL and reads
// buffers back, so only the on-demand dump (uniform_block_dump.rock) calls it.
