// FREE -> acquire -> PENDING -> render_batches -> IN_FLIGHT -> next frame's
// clear_batches, after the mesh's batch is truncated -> FREE.
pub global MESH_FREE: [SpriteMesh] = []
pub global MESH_PENDING: [SpriteMesh] = []
global MESH_IN_FLIGHT: [SpriteMesh] = []

pub fn acquire_mesh(
    dl: DrawList,
    img: SampledTexture,
    capacity: int = 16384,
    z: int = 0,
    depth: DepthMode = DepthMode::TestWrite,
    blend: BlendMode = BlendMode::Alpha,
    order: int = 0,
    unlit: bool = false,
    normal: SampledTexture? = null,
    surface: SampledTexture? = null,
    pipeline: Pipeline? = null,
    sampling: TextureFilter? = null,
    shared: bool = false
) -> SpriteMesh {
    let world_pool = dl.space == DrawSpace::World && dl.dest == DrawDest::Scene && !dl.owns_pool
    assert(world_pool,
        "acquire_mesh on the '{dl.name}' DrawList: acquired meshes require a World+Scene DrawList backed by the engine world pool")
    let zl = resolve_z(dl, z)
    if shared {
        for m in MESH_PENDING {
            if m.shared_capacity == capacity && sampled_texture_same(m.texture, img)
                && m.z_layer == zl && m.depth == depth && m.blend == blend
                && m.order == order && m.unlit == unlit && m.sampling == sampling
                && sampled_texture_optional_same(m.normal, normal)
                && sampled_texture_optional_same(m.surface, surface)
                && pipeline_optional_same(m.pipeline, pipeline)
                && m.auxiliary == null && m.material == null
                && m.block_frame != RENDER_FRAME
                && m.surface_outputs == WorldSurfaceOutputs::Automatic {
                return m
            }
        }
    }

    // Prefer the buffer this draw used last frame, else the smallest that fits, so
    // the pool settles instead of regrowing small buffers.
    let fit = -1
    for i in 0..MESH_FREE.len() {
        let m = MESH_FREE[i]
        if m.capacity < capacity { continue }
        if m.z_layer == zl && m.order == order && m.blend == blend && m.depth == depth
            && sampled_texture_same(m.texture, img)
            && pipeline_optional_same(m.pipeline, pipeline) {
            fit = i
            break
        }
        if fit < 0 || m.capacity < MESH_FREE[fit].capacity { fit = i }
    }
    if fit >= 0 {
        let m = MESH_FREE[fit]
        MESH_FREE.swap_remove(fit)
        let dims = sampled_texture_dims(img)
        m.texture = img
        m.tex_w = float(dims.x)
        m.tex_h = float(dims.y)
        m.inset_x = ENGINE.texel_bleed_prevention / m.tex_w
        m.inset_y = ENGINE.texel_bleed_prevention / m.tex_h
        m.count = 0
        m.shared_capacity = if shared { capacity } else { -1 }
        m.z_layer = zl
        m.depth = depth
        m.blend = blend
        m.order = order
        m.unlit = unlit
        // Reconfigure, never inherit: a pooled mesh carries the previous acquire's state.
        m.pipeline = pipeline
        m.normal = normal
        m.surface = surface
        m.auxiliary = null
        // A scene drain can recycle this mesh again in the same frame.
        m.block_frame = -1
        m.sampling = sampling
        MESH_PENDING.push(m)
        return m
    }

    let m = sprite_mesh_new(img, capacity: capacity, z_layer: zl, depth: depth, blend: blend, order: order, unlit: unlit, normal: normal, surface: surface, pipeline: pipeline, sampling: sampling)
    m.shared_capacity = if shared { capacity } else { -1 }
    MESH_PENDING.push(m)
    return m
}

// Counts snapshot here, so adds are legal any time between acquire and flush.
pub fn flush_acquired_meshes() {
    for m in MESH_PENDING {
        if m.count > 0 {
            submit_mesh_into(RENDER_BATCHES, m)
        }
        MESH_IN_FLIGHT.push(m)
    }
    MESH_PENDING.clear()
}

// Only after mesh batches are truncated: no queued draw reads the buffers.
pub fn recycle_acquired_meshes() {
    for m in MESH_IN_FLIGHT {
        MESH_FREE.push(m)
    }
    MESH_IN_FLIGHT.clear()
}

pub fn recycle_pending_meshes() {
    for m in MESH_PENDING {
        MESH_FREE.push(m)
    }
    MESH_PENDING.clear()
}

pub struct RetainedMesh {
    mesh: SpriteMesh,
    gpu_mesh: MeshId? = null,
    dirty: bool = true,
}

pub fn retain_mesh(
    img: SampledTexture,
    capacity: int = 16384,
    layer: int = DEFAULT_RENDER_LAYER,
    depth: DepthMode = DepthMode::TestWrite,
    blend: BlendMode = BlendMode::Alpha,
    order: int = 0,
    unlit: bool = false,
    normal: SampledTexture? = null,
    surface: SampledTexture? = null,
    pipeline: Pipeline? = null,
    sampling: TextureFilter? = null
) -> RetainedMesh {
    return RetainedMesh {
        mesh: sprite_mesh_new(img, capacity: capacity, z_layer: layer, depth: depth, blend: blend, order: order, unlit: unlit, normal: normal, surface: surface, pipeline: pipeline, sampling: sampling),
    }
}

pub fn invalidate(rm: RetainedMesh) {
    rm.dirty = true
}

pub fn retained_mesh_gpu_release(rm: RetainedMesh) {
    if let gpu = rm.gpu_mesh {
        stone_mesh_free(gpu.0)
        rm.gpu_mesh = null
    }
}

pub fn refill_begin(rm: RetainedMesh) {
    retained_mesh_gpu_release(rm)
    rm.mesh.count = 0
    rm.dirty = false
}

pub fn reserve_quads(rm: RetainedMesh, n: int) {
    reserve_quads(rm.mesh, n)
}

// Each wrapper obeys add(rm, args) == tail(prepare(rm), args).
fn __retained_mesh_prepare_append(rm: RetainedMesh) -> SpriteMesh {
    retained_mesh_gpu_release(rm)
    return __sprite_mesh_prepare_append(rm.mesh)
}

pub @preflight("__retained_mesh_prepare_append", "__retained_mesh_add_tail") fn add(rm: RetainedMesh, pos: Vec2, src: IRect, dest_size: Vec2, pivot: Vec2 = PIVOT_CENTER) {
    __retained_mesh_add_tail(__retained_mesh_prepare_append(rm), pos, src, dest_size, pivot)
}

fn __retained_mesh_add_tail(mesh: SpriteMesh, pos: Vec2, src: IRect, dest_size: Vec2, pivot: Vec2) {
    __sprite_mesh_add_tail(mesh, pos, src, dest_size, pivot, null, WHITE)
}

pub @preflight("__retained_mesh_prepare_append", "__retained_mesh_add_quad_tail") fn add_quad(
    rm: RetainedMesh,
    tl: Vec2,
    tr: Vec2,
    br: Vec2,
    bl: Vec2,
    src: IRect,
    py: float = 0.0,
    tint: Color = WHITE,
    colorize: float = 0.0,
    corner_alpha: Vec4? = null,
    corner_colorize: Vec4? = null,
    corner_u: Vec4? = null,
    corner_v: Vec4? = null
) {
    __retained_mesh_add_quad_tail(__retained_mesh_prepare_append(rm), tl, tr, br, bl, src,
        py, tint, colorize, corner_alpha, corner_colorize, corner_u, corner_v)
}

fn __retained_mesh_add_quad_tail(
    mesh: SpriteMesh, tl: Vec2, tr: Vec2, br: Vec2, bl: Vec2, src: IRect,
    py: float, tint: Color, colorize: float,
    corner_alpha: Vec4?, corner_colorize: Vec4?, corner_u: Vec4?, corner_v: Vec4?,
) {
    __sprite_mesh_add_quad_tail(mesh, tl, tr, br, bl, src, py, tint, colorize,
        corner_alpha, corner_colorize, corner_u, corner_v)
}

pub fn retained_mesh_prepare(rm: RetainedMesh) {
    if rm.mesh.count == 0 { return }
    if rm.gpu_mesh == null
        && match rm.mesh.texture { SampledTexture::Image(_) => true, _ => false } {
        rm.gpu_mesh = retained_sprite_mesh_upload(rm.mesh.vbo, rm.mesh.count)
    }
}

pub fn draw_mesh(rm: RetainedMesh) {
    if rm.mesh.count == 0 { return }
    retained_mesh_prepare(rm)
    submit_mesh_into(current_render_pool(), rm.mesh, rm.gpu_mesh)
}
