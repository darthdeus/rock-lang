fn scene_render_expect_restored0(saved: SceneRenderSaved0) {
    let actual = scene_render_save0()
    assert(actual.outline_target_canvas == saved.outline_target_canvas, "scene render restores outline target")
    assert(actual.render_view == saved.render_view, "scene render restores render_view")
    assert(actual.screen_canvas == saved.screen_canvas, "scene render restores screen_canvas")
    assert(actual.screen_canvas_2 == saved.screen_canvas_2, "scene render restores screen_canvas_2")
    assert(actual.visible_id_canvas == saved.visible_id_canvas, "scene render restores visible_id_canvas")
    assert(actual.world_material_canvas == saved.world_material_canvas, "scene render restores world_material_canvas")
    assert(actual.world_normal_canvas == saved.world_normal_canvas, "scene render restores world_normal_canvas")
    assert(actual.world_surface_owner_canvas == saved.world_surface_owner_canvas, "scene render restores world_surface_owner_canvas")
    assert(actual.mrt_id_attached == saved.mrt_id_attached, "scene render restores mrt_id_attached")
    assert(actual.render_batches == saved.render_batches, "scene render restores render_batches")
    assert(actual.render_batch_sort_keys == saved.render_batch_sort_keys, "scene render restores render_batch_sort_keys")
    assert(actual.outline_mask_batches == saved.outline_mask_batches, "scene render restores outline_mask_batches")
    assert(actual.mesh_pending == saved.mesh_pending, "scene render restores mesh_pending")
    assert(actual.mesh_free == saved.mesh_free, "scene render restores mesh_free")
    assert(actual.mesh_in_flight == saved.mesh_in_flight, "scene render restores mesh_in_flight")
    assert(actual.world_prepare_passes == saved.world_prepare_passes, "scene render restores world_prepare_passes")
    assert(actual.scene_passes == saved.scene_passes, "scene render restores scene_passes")
    assert(actual.scene_passes_run_last == saved.scene_passes_run_last, "scene render restores scene_passes_run_last")
    assert(actual.world_batch_fast == saved.world_batch_fast, "scene render restores world_batch_fast")
    assert(actual.batch_occ == saved.batch_occ, "scene render restores batch_occ")
    assert(actual.parametric_batch_cursor == saved.parametric_batch_cursor, "scene render restores parametric_batch_cursor")
    assert(actual.batch_key_builds == saved.batch_key_builds, "scene render restores batch_key_builds")
}

