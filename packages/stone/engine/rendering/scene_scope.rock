fn scene_render_expect_blocks_restored(saved: [SceneRenderBlockSaved]) {
    for block in saved {
        assert(block.entry.uploads == block.uploads, "scene scope preserves block upload count")
        assert(block.entry.engine_stamp == block.engine_stamp, "scene scope preserves block stamp")
        let gpu = native_buffer_u8(block.entry.size)
        assert(stone_shader_read_uniform_block(get_shader_handle(block.shader),block.entry.block,gpu.ptr,block.entry.size),
            "scene scope reads restored GPU bytes")
        for i in 0..block.entry.size {
            assert(block.entry.scratch[i] == block.bytes[i], "scene scope preserves scratch bytes")
            assert(gpu[i] == block.gpu_bytes[i], "scene scope preserves GPU bytes")
        }
    }
}

fn scene_render_scope_restore_case(fail: bool) {
    setup_stone()
    assert(stone_gpu_host_ensure(), "scene scope acquires the shared GPU host")
    assert(stone_text_init())
    load_pending_shader_sources()
    let font = load_font(project_asset_path("@engine/assets/fonts/DroidSans.ttf"), 24,
        raster: FontRasterPolicy::Fixed).unwrap()
    defer { unload_font(font) }
    let prior_camera = CAMERA_VIEW
    let prior_inspector = ENGINE.show_pipeline_inspector
    let prior_profiler = ENGINE.profiler_enabled
    let prior_shader = WATCHER.current_shader_name
    let prior_activations = TEXTURE_SLOT_ACTIVATION
    let failure = scene_render_try(() => {
        set_camera(v(13.0,17.0),3.0)
        ENGINE.show_pipeline_inspector = true
        ENGINE.profiler_enabled = true
        TEXTURE_SLOT_ACTIVATION = map_new()
        set_shader(BLIT_PIPELINE.shader_name)
        mark_texture_slot_activation(BLIT_PIPELINE.shader_name,0)
        let activation = TEXTURE_SLOT_ACTIVATION.get(BLIT_PIPELINE.shader_name) ?? 0
        let shader = WATCHER.current_shader_name
        let saved0 = scene_render_save0()
        let saved1 = scene_render_save1()
        let saved2 = scene_render_save2()
        let blocks = scene_render_blocks_save()
        let inspector = ENGINE.show_pipeline_inspector
        let profiler = ENGINE.profiler_enabled
        let pass_log = PIPELINE_PASS_LOG
        let pass_count = pass_log.len()
        let arenas = arena_live_count()
        let canvases = stone_get_graphics_stats().canvases
        let view = resolve_frame_view(v(64,64),iv(64,64),Camera2D {},RENDER_CONFIG).unwrap()
        let body_error = scene_render_try(() => {
            with_scene_render_scope(view, () => {
                let _ = ensure_world_surface_owner_canvas()
                set_canvas(screen_canvas)
                set_camera(v(7.0,9.0),2.0)
                set_engine_uniforms(sprite_batch_shader,v(0.0,1.0))
                let text_uploads = shader_block_uploads(text_shader, 2)
                stone_draw_text_for(DrawSpace::Target, font.data().unwrap().backend_id,
                    "scope", 0.0, 0.0, 1.0, 1.0, 1.0, 0.0, 0.0, 1.0)
                stone_draw_text_ex_for(DrawSpace::Target, font.data().unwrap().backend_id,
                    "scope", 0.0, 24.0, 1.0, 1.0, 0.0, 1.0, 0.0, 1.0, 18.0)
                assert(shader_block_uploads(text_shader, 2) > text_uploads,
                    "immediate native text goes through tracked block uploads")
                queue_scene_pass(Pass { pipeline: BLIT_PIPELINE,
                    slot_inputs: [(sampled_canvas(screen_canvas_2),TextureFilter::Nearest)],
                    output: screen_canvas, blend: BlendMode::Replace })
                run_scene_passes()
                if fail { assert(false, "intentional scene scope failure") }
            })
        })
        if fail {
            assert(body_error != null && body_error.contains("intentional scene scope failure"),
                "the scope rethrows the intentional failure after restoration")
        } else { assert(body_error == null, body_error ?? "") }
        scene_render_expect_restored0(saved0)
        scene_render_expect_restored1(saved1)
        scene_render_expect_restored2(saved2)
        scene_render_expect_blocks_restored(blocks)
        assert_eq(TEXTURE_SLOT_ACTIVATION.get(BLIT_PIPELINE.shader_name) ?? 0,activation,
            "scene scope preserves the caller's texture activation marks")
        assert(WATCHER.current_shader_name == shader, "scene scope preserves the caller's active shader")
        assert(ENGINE.show_pipeline_inspector == inspector, "scene scope preserves inspector enablement")
        assert(ENGINE.profiler_enabled == profiler, "scene scope preserves profiler enablement")
        assert(PIPELINE_PASS_LOG == pass_log && PIPELINE_PASS_LOG.len() == pass_count,
            "scene scope does not mutate the live inspector capture")
        assert(arena_live_count() == arenas, "scene render retires its owned pools")
        assert(stone_get_graphics_stats().canvases == canvases, "scene render retires its owned targets")
    })
    CAMERA_VIEW = prior_camera
    ENGINE.show_pipeline_inspector = prior_inspector
    ENGINE.profiler_enabled = prior_profiler
    if let shader = prior_shader { set_shader(shader) } else { end_shader() }
    TEXTURE_SLOT_ACTIVATION = prior_activations
    assert(failure == null,failure ?? "")
}

@test
fn scene_render_scope_restores_after_completed_body() { scene_render_scope_restore_case(false) }
@test
fn scene_render_scope_restores_after_failed_body() { scene_render_scope_restore_case(true) }
