// Explicit scene rendering owns its targets and commands; the live runner
// keeps its pools and pending work even if the caller raises during a draw.
struct SceneRenderSaved0 {
    render_view: FrameView?,
    outline_target_canvas: Canvas,
    screen_canvas: Canvas,
    screen_canvas_2: Canvas,
    visible_id_canvas: Canvas,
    world_material_canvas: Canvas?,
    world_normal_canvas: Canvas?,
    world_surface_owner_canvas: Canvas?,
    mrt_id_attached: bool,
    render_batches: RenderBatchPool,
    render_batch_sort_keys: [string],
    outline_mask_batches: RenderBatchPool,
    mesh_pending: [SpriteMesh],
    mesh_free: [SpriteMesh],
    mesh_in_flight: [SpriteMesh],
    world_prepare_passes: [Pass],
    scene_passes: [Pass],
    scene_passes_run_last: int,
    world_batch_fast: Map<int, [string]>,
    batch_occ: Map<string, Occ>,
    parametric_batch_cursor: Map<string, ParametricCursor>,
    batch_key_builds: int,
}

struct SceneRenderSaved1 {
    world_batch_key_builds: int,
    pool_births: int,
    custom_draw_counter: int,
    render_batch_flushes: int,
    post_scene_batches_pending: bool,
    outline_ids_written: bool,
    outline_mask_written: bool,
    outline_mask_bounds_valid: bool,
    outline_mask_bounds_min_x: float,
    outline_mask_bounds_min_y: float,
    outline_mask_bounds_max_x: float,
    outline_mask_bounds_max_y: float,
    frame_uniform_blocks: [OwnedUniformBlock],
    frame_uniform_block_frame: int,
    frame_uniform_block_cursor: int,
    current_render_pool: RenderBatchScope,
    current_canvas_handle: int,
    current_blend: BlendMode,
    white_pixel: Image?,
}

struct SceneRenderSaved2 {
    camera_view: Mat4,
    engine_block_packs: int,
    engine_block_stamp: int,
    engine_block_key_valid: bool,
    engine_block_key_w: float,
    engine_block_key_h: float,
    engine_block_key_present_source: bool,
    engine_block_key_yb_x: float,
    engine_block_key_yb_y: float,
    engine_block_key_sb_x: float,
    engine_block_key_sb_y: float,
    engine_block_key_time: float,
    canvas_active: Map<int, IVec2>,
    texture_slot_filled: Map<string, int>,
    texture_slot_activation: Map<string, int>,
    unfilled_texture_slot_count: int,
    image_map: Map<string, Image>,
}

inline(lua) fn scene_render_try(body: fn() -> ()) -> string? = """
    local ok, err = xpcall(body, debug.traceback)
    if ok then return nil end
    return tostring(err)
"""

pub fn with_scene_render_scope(view: FrameView, body: fn() -> ()) {
    let saved0 = scene_render_save0()
    let saved1 = scene_render_save1()
    let saved2 = scene_render_save2()
    let saved_world_pool = world.batches
    let saved_gizmo_pool = gizmo.batches
    let saved_shader = WATCHER.current_shader_name
    // A nested render must keep its caller's snapshots alive until restoration.
    // Reuse storage by nesting depth rather than allocating every shader block
    // again for each first-use chunk rendered by the prefetcher.
    static block_snapshots: [[SceneRenderBlockSaved]] = []
    static block_depth = 0
    if block_snapshots.len() == block_depth { block_snapshots.push([]) }
    let blocks = scene_render_blocks_save(block_snapshots[block_depth])
    block_depth += 1
    defer { block_depth -= 1 }
    let debug_stats = ENGINE.debug_graphics_stats
    let inspector = ENGINE.show_pipeline_inspector
    let profiler_enabled = ENGINE.profiler_enabled
    let white_data: ImageData? = null
    let white_image: Image? = null
    let targets: [Canvas] = []
    let pools: [RenderBatchPool] = []
    let cleanup_error: string? = null
    let failure = scene_render_try(() => {
        RENDER_VIEW = view
        outline_target_canvas = new_canvas(view.scene_size.x,view.scene_size.y,"r32i")
        targets.push(outline_target_canvas)
        screen_canvas = new_canvas_with_depth(view.scene_size.x, view.scene_size.y, "rgba16f")
        targets.push(screen_canvas)
        screen_canvas_2 = new_canvas(view.scene_size.x, view.scene_size.y, "rgba16f")
        targets.push(screen_canvas_2)
        visible_id_canvas = new_canvas(view.scene_size.x, view.scene_size.y, "r32i")
        targets.push(visible_id_canvas)
        mrt_id_attached = stone_canvas_attach_id_target(screen_canvas.handle.0, visible_id_canvas.handle.0)
        assert(mrt_id_attached, "scene render scope attaches the picking target")
        world_material_canvas = null
        world_normal_canvas = null
        world_surface_owner_canvas = null
        RENDER_BATCHES = render_batch_pool_new()
        pools.push(RENDER_BATCHES)
        OUTLINE_MASK_BATCHES = render_batch_pool_new()
        pools.push(OUTLINE_MASK_BATCHES)
        world.batches = RENDER_BATCHES
        gizmo.batches = RENDER_BATCHES
        CURRENT_RENDER_POOL = RenderBatchScope {}
        RENDER_BATCH_SORT_KEYS = []
        MESH_PENDING = []
        MESH_FREE = []
        MESH_IN_FLIGHT = []
        CANVAS_ACTIVE = map_new()
        TEXTURE_SLOT_FILLED = map_new()
        TEXTURE_SLOT_ACTIVATION = map_new()
        IMAGE_MAP = map_new()
        WORLD_BATCH_FAST = map_new()
        BATCH_OCC = map_new()
        PARAMETRIC_BATCH_CURSOR = map_new()
        WORLD_PREPARE_PASSES = []
        SCENE_PASSES = []
        FRAME_UNIFORM_BLOCKS = []
        FRAME_UNIFORM_BLOCK_FRAME = -1
        FRAME_UNIFORM_BLOCK_CURSOR = 0
        white_data = new_owned_image_data(1,1)
        image_data_set_pixel(white_data.unwrap(),0,0,1.0,1.0,1.0,1.0)
        white_image = new_owned_image_from_data(white_data.unwrap(),TextureFilter::Nearest)
        WHITE_PIXEL = white_image
        ENGINE.debug_graphics_stats = false
        ENGINE.show_pipeline_inspector = false
        ENGINE.profiler_enabled = false
        body()
    })
    {
        defer {
            scene_render_restore1(saved1)
            scene_render_restore0(saved0)
            world.batches = saved_world_pool
            gizmo.batches = saved_gizmo_pool
            // Rebind while marks are private: set_shader clears its activation map.
            if let shader = saved_shader { set_shader(shader) } else { end_shader() }
            scene_render_restore2(saved2)
            ENGINE.debug_graphics_stats = debug_stats
            ENGINE.show_pipeline_inspector = inspector
            ENGINE.profiler_enabled = profiler_enabled
            set_canvas_handle(saved1.current_canvas_handle)
            set_blend_mode(saved1.current_blend)
        }
        cleanup_error = scene_render_try(() => {
            scene_render_blocks_restore(blocks)
            for c in [world_surface_owner_canvas, world_normal_canvas, world_material_canvas] {
                if let target = c { destroy_canvas(target) }
            }
            for pool in pools { render_batch_pool_destroy(pool) }
            for target in targets { destroy_canvas(target) }
            if let image = white_image { release_owned_image(image) }
            if let pixels = white_data { release_owned_image_data(pixels) }
        })
    }
    assert(failure == null && cleanup_error == null, "scene render: {failure ?? ""} {cleanup_error ?? ""}")
}

struct SceneRenderBlockSaved {
    shader: string,
    entry: ShaderUniformBlock,
    bytes: NativeBufferU8,
    gpu_bytes: NativeBufferU8,
    uploads: int,
    engine_stamp: int,
}

fn scene_render_blocks_save(saved: [SceneRenderBlockSaved] = []) -> [SceneRenderBlockSaved] {
    let count = 0
    for (shader, group) in SHADER_UNIFORM_BLOCKS {
        for entry in group.blocks {
            if count == saved.len() {
                saved.push(SceneRenderBlockSaved { shader, entry,
                    bytes: native_buffer_u8(entry.size),
                    gpu_bytes: native_buffer_u8(entry.size),
                    uploads: entry.uploads, engine_stamp: entry.engine_stamp })
            }
            let block = saved[count]
            // Registration can replace or resize blocks between scope entries.
            block.shader = shader
            block.entry = entry
            if block.bytes.len != entry.size {
                block.bytes = native_buffer_u8(entry.size)
                block.gpu_bytes = native_buffer_u8(entry.size)
            }
            for i in 0..entry.size { block.bytes[i] = entry.scratch[i] }
            let snapshot_phase = perf_phase_begin("uniform.snapshot")
            let read = stone_shader_snapshot_uniform_block(get_shader_handle(shader), entry.block, block.gpu_bytes.ptr, entry.size)
            perf_phase_end(snapshot_phase)
            assert(read,
                "scene render scope captures the program uniform bytes")
            block.uploads = entry.uploads
            block.engine_stamp = entry.engine_stamp
            count += 1
        }
    }
    while saved.len() > count { let _ = saved.pop() }
    return saved
}

fn scene_render_blocks_restore(saved: [SceneRenderBlockSaved]) {
    for block in saved {
        if block.entry.uploads == block.uploads && block.entry.engine_stamp == block.engine_stamp { continue }
        for i in 0..block.entry.size { block.entry.scratch[i] = block.bytes[i] }
        assert(stone_shader_upload_uniform_block(get_shader_handle(block.shader),
            block.gpu_bytes.ptr, block.entry.size, block.entry.fingerprint),
            "scene render scope restores the program's uniform bytes")
        block.entry.uploads = block.uploads
        block.entry.engine_stamp = block.engine_stamp
    }
}

fn scene_render_save0() -> SceneRenderSaved0 {
    return SceneRenderSaved0 {
        render_view: RENDER_VIEW,
        outline_target_canvas: outline_target_canvas,
        screen_canvas: screen_canvas,
        screen_canvas_2: screen_canvas_2,
        visible_id_canvas: visible_id_canvas,
        world_material_canvas: world_material_canvas,
        world_normal_canvas: world_normal_canvas,
        world_surface_owner_canvas: world_surface_owner_canvas,
        mrt_id_attached: mrt_id_attached,
        render_batches: RENDER_BATCHES,
        render_batch_sort_keys: RENDER_BATCH_SORT_KEYS,
        outline_mask_batches: OUTLINE_MASK_BATCHES,
        mesh_pending: MESH_PENDING,
        mesh_free: MESH_FREE,
        mesh_in_flight: MESH_IN_FLIGHT,
        world_prepare_passes: WORLD_PREPARE_PASSES,
        scene_passes: SCENE_PASSES,
        scene_passes_run_last: SCENE_PASSES_RUN_LAST,
        world_batch_fast: WORLD_BATCH_FAST,
        batch_occ: BATCH_OCC,
        parametric_batch_cursor: PARAMETRIC_BATCH_CURSOR,
        batch_key_builds: BATCH_KEY_BUILDS,
    }
}

fn scene_render_restore0(saved0: SceneRenderSaved0) {
    RENDER_VIEW = saved0.render_view
    outline_target_canvas = saved0.outline_target_canvas
    screen_canvas = saved0.screen_canvas
    screen_canvas_2 = saved0.screen_canvas_2
    visible_id_canvas = saved0.visible_id_canvas
    world_material_canvas = saved0.world_material_canvas
    world_normal_canvas = saved0.world_normal_canvas
    world_surface_owner_canvas = saved0.world_surface_owner_canvas
    mrt_id_attached = saved0.mrt_id_attached
    RENDER_BATCHES = saved0.render_batches
    RENDER_BATCH_SORT_KEYS = saved0.render_batch_sort_keys
    OUTLINE_MASK_BATCHES = saved0.outline_mask_batches
    MESH_PENDING = saved0.mesh_pending
    MESH_FREE = saved0.mesh_free
    MESH_IN_FLIGHT = saved0.mesh_in_flight
    WORLD_PREPARE_PASSES = saved0.world_prepare_passes
    SCENE_PASSES = saved0.scene_passes
    SCENE_PASSES_RUN_LAST = saved0.scene_passes_run_last
    WORLD_BATCH_FAST = saved0.world_batch_fast
    BATCH_OCC = saved0.batch_occ
    PARAMETRIC_BATCH_CURSOR = saved0.parametric_batch_cursor
    BATCH_KEY_BUILDS = saved0.batch_key_builds
}

