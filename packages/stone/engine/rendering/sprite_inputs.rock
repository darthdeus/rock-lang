// Optional per-batch inputs bind a stand-in when the shader declares the slot.
pub fn bind_sprite_normal_texture(shader_id: string, normal: SampledTexture?,
    sampling: TextureFilter = TextureFilter::Nearest) {
    let source = normal ?? sampled_image(WHITE_PIXEL.unwrap())
    shader_bind_texture_if_present(shader_id, "uNormalTex", source, sampling)
}

pub fn bind_sprite_surface_texture(shader_id: string, surface: SampledTexture?,
    sampling: TextureFilter = TextureFilter::Nearest) {
    let source = surface ?? sampled_image(WHITE_PIXEL.unwrap())
    shader_bind_texture_if_present(shader_id, "uSurfaceTex", source, sampling)
}

// The source's declared sampling: a colour map declares Linear or MipStable,
// a per-texel geometry map (a wall set's geometry normal) Nearest, since
// filtering it into a transparent neighbour invents a normal.
fn bind_sprite_auxiliary_texture(shader_id: string, auxiliary: SampledTexture?) {
    let source = auxiliary ?? sampled_image(WHITE_PIXEL.unwrap())
    shader_bind_texture_if_present(shader_id, "uAuxiliaryTex", source,
        sampled_texture_default_sampling(source))
}

fn bind_sprite_material_texture(shader_id: string, material: SampledTexture?) {
    if shader_texture_slot_if_present(shader_id,"uMaterialTex") < 0 { return }
    assert(material != null,"material sampler requires an explicit texture")
    let source = material.unwrap()
    let sampling = if sampled_texture_default_sampling(source) == TextureFilter::MipStable {
        TextureFilter::MipStable
    } else { TextureFilter::Nearest }
    shader_bind_texture_if_present(shader_id,"uMaterialTex",source,sampling)
}

// A pooled batch's per-draw samplers, bound on the active program right before
// its draw. Every pool flush (world, UI, DrawList) brackets its draw with this
// pair.
fn bind_batch_samplers(shader_id: string, batch: RenderBatch) {
    if let bindings = batch.geometry_bindings {
        for binding in bindings {
            if bind_sampled_to_slot(binding.resource, binding.slot, binding.filter) {
                mark_texture_slot_filled(shader_id, binding.slot)
            }
        }
        return
    }
    bind_sprite_normal_texture(shader_id, batch.normal, batch.normal_sampling)
    bind_sprite_surface_texture(shader_id, batch.surface, batch.surface_sampling)
    bind_sprite_auxiliary_texture(shader_id, batch.auxiliary)
    bind_sprite_material_texture(shader_id, batch.material)
}

// Unconditional because the binds are: a batch with no normal map still binds
// the white 1x1, so its unit still holds a sampler.
fn release_batch_samplers(shader_id: string, batch: RenderBatch) {
    if let bindings = batch.geometry_bindings {
        for binding in bindings { sampler_release_unit(binding.slot) }
        return
    }
    release_activation_sampler(shader_id, "uNormalTex")
    release_activation_sampler(shader_id, "uSurfaceTex")
    release_activation_sampler(shader_id, "uAuxiliaryTex")
    release_activation_sampler(shader_id, "uMaterialTex")
}

pub fn sprite_frag_uniforms(has_surface: bool = false, texture_srgb: bool = true, filtered: bool = false) -> SpriteFragU {
    return SpriteFragU { uLinearWorld: ENGINE.linear_world, uTextureSrgb: texture_srgb,
        uColorFiltered: filtered, uHasSurfaceMask: has_surface }
}
pub fn ui_frag_uniforms() -> SpriteFragU {
    return SpriteFragU { uHasSurfaceMask: false }
}
