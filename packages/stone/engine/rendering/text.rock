pub struct TextLayoutEmissionProbe {
    frame: int,
    retained_text: string,
    admitted_count: int,
    layout_glyph_count: int,
    emitted_count: int,
    instance_id: int,
    consumer_key: string,
    origin: Vec2,
    logical_bounds: Rect,
    layout_ink_bounds: Rect,
    emitted_bounds: Rect,
    target_pixel_cap_height: float,
    required_pixel_em: float,
    selected_pixel_em: int,
    source_cap_height: float,
}

pub const TEXT_LAYOUT_SIM_PROBES: bool = get_env_int("STONE_TEXT_LAYOUT_SIM_PROBES", 1) != 0

fn text_layout_probe_text(layout: TextLayout) -> string {
    return if sim_mode_active() && TEXT_LAYOUT_SIM_PROBES { layout.text } else { "" }
}

pub fn text_layout_emission_probe_empty() -> TextLayoutEmissionProbe {
    return TextLayoutEmissionProbe {
        frame: -1,
        retained_text: "",
        admitted_count: 0,
        layout_glyph_count: 0,
        emitted_count: 0,
        instance_id: 0,
        consumer_key: "",
        origin: v(),
        logical_bounds: rect(0.0, 0.0, 0.0, 0.0),
        layout_ink_bounds: rect(0.0, 0.0, 0.0, 0.0),
        emitted_bounds: rect(0.0, 0.0, 0.0, 0.0),
        target_pixel_cap_height: 0.0,
        required_pixel_em: 0.0,
        selected_pixel_em: 0,
        source_cap_height: 0.0,
    }
}

pub value GlyphPose {
    glyph_index: int,
    source_index: int,
    glyph: int,
    translation: Vec2,
    scale: Vec2,
    rotation: float,
}

pub global TEXT_LAYOUT_BUILD_CALLS: int = 0
pub global TEXT_LAYOUT_EMIT_CALLS: int = 0
global TEXT_ART_COVERAGE_EMIT_CALLS: int = 0
// The emission probe grows with the distinct texts recorded since the last
// reset; the index keeps admission O(1) on long sim runs without one.
pub global TEXT_LAYOUT_EMISSION_PROBES: [TextLayoutEmissionProbe] = []
global TEXT_LAYOUT_EMISSION_PROBE_INDEX: Map<string, int> = map_new()

pub fn text_layout_emission_probe(text: string) -> TextLayoutEmissionProbe? {
    for probe in TEXT_LAYOUT_EMISSION_PROBES {
        if probe.retained_text == text { return probe }
    }
    return null
}

pub fn text_layout_emission_probe_record(value: TextLayoutEmissionProbe) {
    if let slot = TEXT_LAYOUT_EMISSION_PROBE_INDEX.get(value.retained_text) {
        TEXT_LAYOUT_EMISSION_PROBES[slot] = value
    } else {
        TEXT_LAYOUT_EMISSION_PROBE_INDEX[value.retained_text] = TEXT_LAYOUT_EMISSION_PROBES.len
        TEXT_LAYOUT_EMISSION_PROBES.push(value)
    }
}

pub fn text_layout_emission_probe_reset() {
    TEXT_LAYOUT_EMISSION_PROBES.clear()
    TEXT_LAYOUT_EMISSION_PROBE_INDEX.clear()
}

fn text_layout_emission_probe_case_text(i: int) -> string {
    return "tn-keyboard-probe-{i}"
}

@test
fn text_layout_emission_probe_keeps_texts_past_the_old_bound() {
    text_layout_emission_probe_reset()
    defer { text_layout_emission_probe_reset() }
    // More distinct texts than the 16 slots the keyboard pause sim outgrew
    // (1e585292c8 RED 7/13): every recorded text stays retrievable.
    let count = 24
    for i in 0..count {
        let value = text_layout_emission_probe_empty()
        value.retained_text = text_layout_emission_probe_case_text(i)
        value.emitted_count = i + 1
        text_layout_emission_probe_record(value)
    }
    assert_eq(TEXT_LAYOUT_EMISSION_PROBES.len, count,
        "recording keeps one slot per distinct text")
    for i in 0..count {
        let text = text_layout_emission_probe_case_text(i)
        let found = text_layout_emission_probe(text)
        assert(found != null, "recorded probe text {text} stays retrievable")
        assert_eq(found.unwrap().emitted_count, i + 1,
            "probe {text} keeps its recorded emission")
    }
    // Re-recording a text overwrites its slot instead of growing a duplicate.
    let again = text_layout_emission_probe_empty()
    again.retained_text = text_layout_emission_probe_case_text(5)
    again.emitted_count = 50
    text_layout_emission_probe_record(again)
    assert_eq(TEXT_LAYOUT_EMISSION_PROBES.len, count,
        "re-recording a text keeps the slot count")
    assert_eq(text_layout_emission_probe(
        text_layout_emission_probe_case_text(5)).unwrap().emitted_count, 50,
        "re-recording a text updates its slot")
}

fn text_layout_emission_bounds_union(a: Rect, b: Rect) -> Rect {
    if a.w <= 0.0 || a.h <= 0.0 { return b }
    let lo = v(min(a.x, b.x), min(a.y, b.y))
    let hi = v(max(a.x + a.w, b.x + b.w), max(a.y + a.h, b.y + b.h))
    return rect(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y)
}

fn text_layout_source_step(text: string, i: int) -> int {
    let end = text_codepoint_end(text, i)
    return max(1, end - i)
}

fn text_layout_coverage_oversampling(font: Font?) -> float {
    let value = FONT_COVERAGE_OVERSAMPLING
    if font != null {
        let data = font.unwrap().data()
        if data != null && data.unwrap().raster == FontRasterPolicy::Fixed {
            value = FONT_COVERAGE_OVERSAMPLING_DEFAULT
        }
    }
    return font_coverage_oversampling_require(value)
}

fn text_layout_empty(font: Font?, text: string, face: int, align: TextAlign) -> TextLayout {
    return TextLayout {
        font: font,
        text: text,
        face: face,
        glyphs: flat_vec_new(max(1, text.len())),
        logical_bounds: rect(0.0, 0.0, 0.0, 0.0),
        ink_bounds: rect(0.0, 0.0, 0.0, 0.0),
        ascent: 0.0,
        descent: 0.0,
        line_height: 0.0,
        line_count: 0,
        admitted_count: 0,
        alignment: align,
        alignment_offset: v(),
        raster_authored_cap_height: 0.0,
        raster_layout_to_target_scale: 1.0,
        raster_physical_target_scale: 1.0,
        raster_target_cap_height: 0.0,
        coverage_oversampling: text_layout_coverage_oversampling(font),
        raster_metric_scale_x: 0.0,
        raster_metric_scale_y: 0.0,
        instance_glyph_id: 0,
        instance_glyph_data: null,
        instance_cached_id: 0,
        instance_cached_pixel_size: 0,
        instance_cached_image: 0,
    }
}

// Vertical centering rule for UI-target text: the middle row (Left/Center/Right)
// centers the CAP BOX -- first line's cap top to last baseline -- so
// descenders never move a centered label. Top/Bottom rows pin the logical
// box edge exactly as text_align_fracs. World text keeps logical-box
// centering on every row.

// Distance from a TopLeft origin down to the cap-box center. `trailing`
// carries the multiline tail ((lines - 1) * line height); one line passes 0.
pub fn text_cap_center_from_top(ascent: float, cap_height: float, trailing: float) -> float {
    return ascent - cap_height * 0.5 + trailing * 0.5
}

// Origin y for UI-target text hung from an anchor: the middle row centers
// the cap box, every other row pins the logical box. `frac_y` is the
// text_align_fracs y; callers pass 0.0 trailing for one line.
pub fn text_anchored_y(anchor_y: float, frac_y: float, text_h: float, ascent: float, cap_height: float, trailing: float) -> float {
    if frac_y == 0.5 && cap_height > 0.0 && text_h > 0.0 {
        return anchor_y - text_cap_center_from_top(ascent, cap_height, trailing)
    }
    return anchor_y - frac_y * text_h
}

// Scaled cap height of one font at an authored UI size: the same divisor
// and context factor text_layout_build emits with. 0.0 = the font has no
// usable metrics yet; callers keep logical-box centering then.
pub fn text_font_cap_height(font: Font, size: float, render_scale: float) -> float {
    let d = font.data() ?? return 0.0
    let idx = d.backend_id - 1
    if idx < 0 || idx >= FONT_UNIT_CAP_HEIGHTS.len { return 0.0 }
    let divisor = font_size_divisor(idx)
    if divisor <= 0.0 || FONT_UNIT_CAP_HEIGHTS[idx] <= 0.0 { return 0.0 }
    return FONT_UNIT_CAP_HEIGHTS[idx] * size * render_scale / divisor
}

// Cap height over resolved runs in each run's own target scale, taking the
// maximum like measure_resolved_runs takes the maximum ascent.
pub fn resolved_runs_cap_height(runs: [ResolvedTextRun]) -> float {
    let cap = 0.0
    for run in runs {
        let d = run.font.data() ?? continue
        let idx = d.backend_id - 1
        if idx < 0 || idx >= FONT_UNIT_CAP_HEIGHTS.len { continue }
        let c = FONT_UNIT_CAP_HEIGHTS[idx] * resolved_run_scale(run) * run.draw_scale
        if c > cap { cap = c }
    }
    return cap
}

pub fn resolved_plain_cap_height(layout: ResolvedPlainText) -> float {
    let cap = 0.0
    for line in layout.lines {
        let c = resolved_runs_cap_height(line.runs)
        if c > cap { cap = c }
    }
    return cap
}

pub fn text_layout_build_scaled(
    font: Font,
    text: string,
    scale_x: float,
    scale_y: float,
    face: int,
    align: TextAlign,
    reject_invalid: bool,
    split_lines: bool = true,
    reject_site: string = "",
    raster_physical_target_scale: float = 1.0
) -> TextLayout {
    TEXT_LAYOUT_BUILD_CALLS += 1
    let data = font.data()
    if data == null { return text_layout_empty(font, text, face, align) }
    let idx = data.unwrap().backend_id - 1
    if TEXT_MISSING_GLYPH_POLICY == TextMissingGlyphPolicy::Substitute
        && idx >= 0 && idx < FONT_CP_SLOTS.len && idx < GLYPH_CACHES.len
        && GLYPH_CACHES[idx].len > FACE_REGULAR
        && GLYPH_CACHES[idx][FACE_REGULAR].len > 0 {
        let prepare_site = if reject_site == "" { "text layout" } else { reject_site }
        text = text_prepare_missing_glyphs(font, null, idx, text, prepare_site)
    }
    let layout = text_layout_empty(font, text, face, align)
    layout.font = font
    layout.text = text
    layout.face = face
    layout.logical_bounds = rect(0.0, 0.0, 0.0, 0.0)
    layout.ink_bounds = rect(0.0, 0.0, 0.0, 0.0)
    layout.ascent = 0.0
    layout.descent = 0.0
    let abs_sy = abs(scale_y)
    let metrics = text_line_metrics(idx, scale_y)
    layout.line_height = metrics.line_height
    layout.line_count = 1
    layout.admitted_count = 0
    layout.alignment = align
    layout.alignment_offset = v()
    layout.raster_metric_scale_x = scale_x
    layout.raster_metric_scale_y = scale_y
    layout.raster_authored_cap_height = 0.0
    layout.raster_layout_to_target_scale = 1.0
    layout.raster_physical_target_scale = raster_physical_target_scale
    layout.raster_target_cap_height = 0.0

    if idx >= 0 && idx < FONT_UNIT_SIZES.len
        && idx < FONT_UNIT_CAP_HEIGHTS.len {
        layout.raster_authored_cap_height = text_layout_raster_cap_for_scale(font, scale_y)
        layout.raster_target_cap_height = layout.raster_authored_cap_height
            * layout.raster_layout_to_target_scale
            * layout.raster_physical_target_scale
    }
    if idx < 0 || idx >= GLYPH_CACHES.len || idx >= GLYPH_UNIT_CACHES.len
        || face < 0 || face >= GLYPH_CACHES[idx].len
        || face >= GLYPH_UNIT_CACHES[idx].len {
        return layout
    }
    let glyphs = GLYPH_CACHES[idx][face]
    let unit_glyphs = GLYPH_UNIT_CACHES[idx][face]
    if glyphs.len == 0 || unit_glyphs.len == 0 { return layout }

    let cursor_x = 0.0
    let line_index = 0
    let max_width = 0.0
    let i = 0
    while i < text.len() {
        let byte = text.unit_at(i)
        if byte == 13 || byte == 9 {
            if reject_invalid && reject_site != "" {
                error("{reject_site}: rich text is one line -- byte {byte} at offset {i} of {text.len()} is a line control")
            }
            if reject_invalid {
                error("text layout rejected line control byte {byte} at offset {i}")
            }
            i += 1
            continue
        }
        if byte == 10 && reject_invalid && reject_site != "" {
            error("{reject_site}: rich text is one line -- byte {byte} at offset {i} of {text.len()} is a line control")
        }
        if byte == 10 && split_lines {
            if cursor_x > max_width { max_width = cursor_x }
            line_index += 1
            layout.line_count = line_index + 1
            cursor_x = 0.0
            i += 1
            continue
        }
        if byte == 10 {
            i += 1
            continue
        }
        let slot = text_glyph_slot(FONT_CP_SLOTS[idx], text, i)
        let step = text_layout_source_step(text, i)
        if slot < 0 {
            if reject_invalid {
                if reject_site != "" {
                    error("{reject_site}: byte {byte} at offset {i} is outside the supported text atlas")
                }
                error("text layout rejected byte {byte} at offset {i}")
            }
            i += step
            continue
        }
        if slot >= glyphs.len {
            if reject_invalid {
                if reject_site != "" {
                    error("{reject_site}: glyph slot {slot} at offset {i} is outside the supported text atlas")
                }
                error("text layout rejected glyph slot {slot} at offset {i}")
            }
            i += step
            continue
        }
        let raster_g = glyphs[slot]
        let g = unit_glyphs[slot]
        if !raster_g.valid || !g.valid {
            if reject_invalid {
                if reject_site != "" {
                    error("{reject_site}: glyph slot {slot} at offset {i} is unavailable")
                }
                error("text layout rejected unavailable glyph slot {slot} at offset {i}")
            }
            i += step
            continue
        }
        layout.admitted_count += 1
        let advance = g.advance * scale_x
        let glyph_h = g.height * abs_sy
        if g.width > 0.0 && g.height > 0.0 {
            let origin = v(cursor_x, line_index as float * metrics.line_height)
            layout.glyphs.push(TextGlyph {
                glyph_index: layout.glyphs.len,
                source_index: i,
                glyph: slot,
                face: face,
                origin: origin,
                ink: rect(cursor_x + g.left * scale_x,
                    origin.y - g.top * abs_sy,
                    g.width * abs(scale_x), glyph_h),
                advance: advance,
                pivot: v(cursor_x + advance * 0.5,
                    (line_index as float + 0.5) * metrics.line_height),
            })
        }
        cursor_x += advance
        i += step
    }
    if cursor_x > max_width { max_width = cursor_x }

    if layout.admitted_count > 0 {
        layout.ascent = metrics.ascent
        layout.descent = metrics.descent
    }

    for i in 0..layout.glyphs.len {
        let glyph = layout.glyphs[i]
        layout.glyphs[i] = TextGlyph {
            glyph_index: glyph.glyph_index,
            source_index: glyph.source_index,
            glyph: glyph.glyph,
            face: glyph.face,
            origin: glyph.origin + v(0.0, layout.ascent),
            ink: rect(glyph.ink.x, glyph.ink.y + layout.ascent,
                glyph.ink.w, glyph.ink.h),
            advance: glyph.advance,
            pivot: glyph.pivot,
        }
    }
    let logical_height = if layout.admitted_count > 0 {
        layout.line_count as float * metrics.line_height
    } else { 0.0 }
    layout.logical_bounds = rect(0.0, 0.0, max_width, logical_height)
    let found_ink = false
    let ink_lo = v()
    let ink_hi = v()
    for glyph in layout.glyphs {
        let lo = v(glyph.ink.x, glyph.ink.y)
        let hi = v(glyph.ink.x + glyph.ink.w, glyph.ink.y + glyph.ink.h)
        if !found_ink {
            ink_lo = lo
            ink_hi = hi
            found_ink = true
        } else {
            ink_lo = v(min(ink_lo.x, lo.x), min(ink_lo.y, lo.y))
            ink_hi = v(max(ink_hi.x, hi.x), max(ink_hi.y, hi.y))
        }
    }
    if found_ink {
        layout.ink_bounds = rect(ink_lo.x, ink_lo.y,
            ink_hi.x - ink_lo.x, ink_hi.y - ink_lo.y)
    }
    let frac = text_align_fracs(align)
    layout.alignment_offset = frac * -1.0
        * v(layout.logical_bounds.w, layout.logical_bounds.h)
    if frac.y == 0.5 && layout.logical_bounds.h > 0.0
        && idx >= 0 && idx < FONT_UNIT_CAP_HEIGHTS.len
        && FONT_UNIT_CAP_HEIGHTS[idx] > 0.0 {
        let trailing = (layout.line_count - 1) as float * metrics.line_height
        layout.alignment_offset.y = -text_cap_center_from_top(
            layout.ascent, FONT_UNIT_CAP_HEIGHTS[idx] * abs_sy, trailing)
    }
    return layout
}

fn text_layout_shift_y(layout: TextLayout, delta: float) {
    for i in 0..layout.glyphs.len {
        let glyph = layout.glyphs[i]
        layout.glyphs[i] = TextGlyph {
            glyph_index: glyph.glyph_index,
            source_index: glyph.source_index,
            glyph: glyph.glyph,
            face: glyph.face,
            origin: glyph.origin + v(0.0, delta),
            ink: rect(glyph.ink.x, glyph.ink.y + delta,
                glyph.ink.w, glyph.ink.h),
            advance: glyph.advance,
            pivot: glyph.pivot + v(0.0, delta),
        }
    }
    layout.ink_bounds.y += delta
}

pub fn text_layout_build(
    font: Font,
    text: string,
    size: float,
    render_scale: float,
    face: int = FACE_REGULAR,
    align: TextAlign = TextAlign::TopLeft,
    reject_invalid: bool = false,
    raster_physical_target_scale: float = 1.0
) -> TextLayout {
    let data = font.data()
    if data == null { return text_layout_empty(font, text, face, align) }
    let idx = data.unwrap().backend_id - 1
    let divisor = font_size_divisor(idx)
    if divisor <= 0.0 {
        return text_layout_empty(font, text, face, align)
    }
    let scale = size * render_scale / divisor
    let layout = text_layout_build_scaled(font, text, scale, scale,
        face, align, reject_invalid)
    layout.raster_authored_cap_height = size
    layout.raster_layout_to_target_scale = render_scale
    layout.raster_physical_target_scale = raster_physical_target_scale
    layout.raster_target_cap_height = text_layout_raster_cap_for_scale(font, scale)
        * raster_physical_target_scale
    return layout
}

fn text_layout_cache_window_begin() {
    TEXT_LAYOUT_CACHE_WINDOW_START_REQUESTS = TEXT_LAYOUT_CACHE_REQUESTS
    TEXT_LAYOUT_CACHE_WINDOW_START_HITS = TEXT_LAYOUT_CACHE_HITS
    TEXT_LAYOUT_CACHE_WINDOW_START_MISSES = TEXT_LAYOUT_CACHE_MISSES
    TEXT_LAYOUT_CACHE_WINDOW_START_BUILDS = TEXT_LAYOUT_CACHE_BUILDS
    TEXT_LAYOUT_CACHE_WINDOW_START_EVICTIONS = TEXT_LAYOUT_CACHE_EVICTIONS
    TEXT_LAYOUT_CACHE_WINDOW_START_ENTRIES_EXAMINED = TEXT_LAYOUT_CACHE_ENTRIES_EXAMINED
    TEXT_LAYOUT_CACHE_WINDOW_START_WORLD_BUILDS = TEXT_WORLD_LAYOUT_BUILD_CALLS
    TEXT_LAYOUT_CACHE_WINDOW_REQUESTS = 0
    TEXT_LAYOUT_CACHE_WINDOW_HITS = 0
    TEXT_LAYOUT_CACHE_WINDOW_MISSES = 0
    TEXT_LAYOUT_CACHE_WINDOW_BUILDS = 0
    TEXT_LAYOUT_CACHE_WINDOW_EVICTIONS = 0
    TEXT_LAYOUT_CACHE_WINDOW_ENTRIES_EXAMINED = 0
    TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED = 0
    TEXT_LAYOUT_CACHE_WINDOW_HIGH_WATER = TEXT_LAYOUT_CACHE.len
    TEXT_LAYOUT_CACHE_WINDOW_UI_REQUESTS = 0
    TEXT_LAYOUT_CACHE_WINDOW_UI_HITS = 0
    TEXT_LAYOUT_CACHE_WINDOW_UI_MISSES = 0
    TEXT_LAYOUT_CACHE_WINDOW_UI_BUILDS = 0
    TEXT_LAYOUT_CACHE_WINDOW_UI_EVICTIONS = 0
    TEXT_LAYOUT_CACHE_WINDOW_WORLD_REQUESTS = 0
    TEXT_LAYOUT_CACHE_WINDOW_WORLD_HITS = 0
    TEXT_LAYOUT_CACHE_WINDOW_WORLD_MISSES = 0
    TEXT_LAYOUT_CACHE_WINDOW_WORLD_BUILDS = 0
    TEXT_LAYOUT_CACHE_WINDOW_WORLD_EVICTIONS = 0
    TEXT_LAYOUT_CACHE_WINDOW_ACTIVE = true
}

fn text_layout_cache_window_end() {
    if !TEXT_LAYOUT_CACHE_WINDOW_ACTIVE { return () }
    TEXT_LAYOUT_CACHE_WINDOW_REQUESTS = TEXT_LAYOUT_CACHE_REQUESTS - TEXT_LAYOUT_CACHE_WINDOW_START_REQUESTS
    TEXT_LAYOUT_CACHE_WINDOW_HITS = TEXT_LAYOUT_CACHE_HITS - TEXT_LAYOUT_CACHE_WINDOW_START_HITS
    TEXT_LAYOUT_CACHE_WINDOW_MISSES = TEXT_LAYOUT_CACHE_MISSES - TEXT_LAYOUT_CACHE_WINDOW_START_MISSES
    TEXT_LAYOUT_CACHE_WINDOW_BUILDS = TEXT_LAYOUT_CACHE_BUILDS - TEXT_LAYOUT_CACHE_WINDOW_START_BUILDS
    TEXT_LAYOUT_CACHE_WINDOW_EVICTIONS = TEXT_LAYOUT_CACHE_EVICTIONS - TEXT_LAYOUT_CACHE_WINDOW_START_EVICTIONS
    TEXT_LAYOUT_CACHE_WINDOW_ENTRIES_EXAMINED = TEXT_LAYOUT_CACHE_ENTRIES_EXAMINED - TEXT_LAYOUT_CACHE_WINDOW_START_ENTRIES_EXAMINED
    TEXT_LAYOUT_CACHE_WINDOW_WORLD_BUILDS = TEXT_WORLD_LAYOUT_BUILD_CALLS - TEXT_LAYOUT_CACHE_WINDOW_START_WORLD_BUILDS
    TEXT_LAYOUT_CACHE_WINDOW_ACTIVE = false
}

pub fn text_layout_cache_clear() {
    TEXT_LAYOUT_CACHE.clear()
    TEXT_LAYOUT_CACHE_INDEX.clear()
    TEXT_LAYOUT_CACHE_CLOCK = 0
}

fn text_align_ordinal(align: TextAlign) -> int {
    match align {
        TextAlign::TopLeft => 0, TextAlign::TopCenter => 1, TextAlign::TopRight => 2,
        TextAlign::Left => 3, TextAlign::Center => 4, TextAlign::Right => 5,
        TextAlign::BottomLeft => 6, TextAlign::BottomCenter => 7,
        TextAlign::BottomRight => 8,
    }
}

@inline
fn text_layout_quantize(value: float, scale: float, modulus: int) -> int {
    let q = floor(value * scale) as int
    return ((q % modulus) + modulus) % modulus
}

// A hash of one cache variant, packed into 50 bits so it stays an exact
// integer in a Lua number. It is a hash, not an identity: the float fields are
// quantized, so lookups confirm the exact fields among entries sharing a key.
fn text_layout_variant_key(world_raster: bool, font_id: int, face: int,
                           align: TextAlign, cap_height: bool,
                           a: float, b: float, c: float) -> int {
    let key = if world_raster { 1 } else { 0 }
    key = key * 256 + ((font_id % 256) + 256) % 256
    key = key * 4 + ((face % 4) + 4) % 4
    key = key * 16 + text_align_ordinal(align)
    key = key * 2 + if cap_height { 1 } else { 0 }
    key = key * 16384 + text_layout_quantize(a, 16.0, 16384)
    key = key * 1024 + text_layout_quantize(b, 32.0, 1024)
    key = key * 1024 + text_layout_quantize(c, 32.0, 1024)
    return key
}

fn text_layout_cache_index_add(text: string, variant: int, index: int) {
    let variants = TEXT_LAYOUT_CACHE_INDEX.get(text)
    if variants != null {
        let by_variant = variants.unwrap()
        let entry = TEXT_LAYOUT_CACHE[index]
        entry.next_variant_slot = by_variant.get(variant).unwrap_or(-1)
        TEXT_LAYOUT_CACHE[index] = entry
        by_variant.insert(variant, index)
    } else {
        let entry = TEXT_LAYOUT_CACHE[index]
        entry.next_variant_slot = -1
        TEXT_LAYOUT_CACHE[index] = entry
        let created: Map<int, int> = map_new()
        created.insert(variant, index)
        TEXT_LAYOUT_CACHE_INDEX.insert(text, created)
    }
}

// A quantized variant may represent several distinct exact keys. Each resident
// entry belongs to one slot in the same-variant chain; unlink it before that
// slot is reused, preserving the remaining entries as lookup candidates.
fn text_layout_cache_index_remove(text: string, variant: int, index: int) {
    let variants = TEXT_LAYOUT_CACHE_INDEX.get(text) ?? return
    let head = variants.get(variant) ?? return
    if head == index {
        let next = TEXT_LAYOUT_CACHE[index].next_variant_slot
        if next >= 0 {
            variants.insert(variant, next)
        } else {
            let _ = variants.remove(variant)
            if variants.is_empty() { let _ = TEXT_LAYOUT_CACHE_INDEX.remove(text) }
        }
        let entry = TEXT_LAYOUT_CACHE[index]
        entry.next_variant_slot = -1
        TEXT_LAYOUT_CACHE[index] = entry
        return ()
    }

    let previous = head
    let current = TEXT_LAYOUT_CACHE[head].next_variant_slot
    while current >= 0 {
        let entry = TEXT_LAYOUT_CACHE[current]
        if current == index {
            let previous_entry = TEXT_LAYOUT_CACHE[previous]
            previous_entry.next_variant_slot = entry.next_variant_slot
            TEXT_LAYOUT_CACHE[previous] = previous_entry
            entry.next_variant_slot = -1
            TEXT_LAYOUT_CACHE[index] = entry
            return ()
        }
        previous = current
        current = entry.next_variant_slot
    }
}

fn text_layout_cache_slot(text: string, variant: int) -> int {
    let variants = TEXT_LAYOUT_CACHE_INDEX.get(text) ?? return -1
    let slot = variants.get(variant) ?? return -1
    if slot < 0 || slot >= TEXT_LAYOUT_CACHE.len { return -1 }
    return slot
}

// The slot a new entry takes: the next free index, or the least recently used
// entry, evicted here. The caller stores the entry it built straight into this
// slot so the layout is constructed in the cache's own storage; a stored copy
// would deep-copy every glyph row on each miss (Lua has no owner to move into).
fn text_layout_cache_claim_slot(world_raster: bool) -> int {
    if TEXT_LAYOUT_CACHE.len < TEXT_LAYOUT_CACHE_CAPACITY {
        return TEXT_LAYOUT_CACHE.len
    }
    let oldest_idx = 0
    let oldest_used = TEXT_LAYOUT_CACHE[0].last_used
    for i in 1..TEXT_LAYOUT_CACHE.len {
        if TEXT_LAYOUT_CACHE[i].last_used < oldest_used {
            oldest_idx = i
            oldest_used = TEXT_LAYOUT_CACHE[i].last_used
        }
    }
    TEXT_LAYOUT_CACHE_EVICTIONS += 1
    if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE {
        TEXT_LAYOUT_CACHE_WINDOW_EVICTIONS += 1
        if world_raster {
            TEXT_LAYOUT_CACHE_WINDOW_WORLD_EVICTIONS += 1
        } else {
            TEXT_LAYOUT_CACHE_WINDOW_UI_EVICTIONS += 1
        }
    }
    let old = TEXT_LAYOUT_CACHE[oldest_idx]
    text_layout_cache_index_remove(old.text, old.variant, oldest_idx)
    return oldest_idx
}

fn text_layout_cache_commit(slot: int) -> TextLayout {
    let entry = TEXT_LAYOUT_CACHE[slot]
    text_layout_cache_index_add(entry.text, entry.variant, slot)
    if TEXT_LAYOUT_CACHE.len > TEXT_LAYOUT_CACHE_HIGH_WATER {
        TEXT_LAYOUT_CACHE_HIGH_WATER = TEXT_LAYOUT_CACHE.len
    }
    if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE
        && TEXT_LAYOUT_CACHE.len > TEXT_LAYOUT_CACHE_WINDOW_HIGH_WATER {
        TEXT_LAYOUT_CACHE_WINDOW_HIGH_WATER = TEXT_LAYOUT_CACHE.len
    }
    return entry.layout
}

pub fn text_layout_cached(
    font: Font,
    text: string,
    size: float,
    render_scale: float,
    align: TextAlign,
    raster_physical_target_scale: float,
    face: int = FACE_REGULAR
) -> TextLayout {
    TEXT_LAYOUT_CACHE_CLOCK += 1
    TEXT_LAYOUT_CACHE_REQUESTS += 1
    if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE {
        TEXT_LAYOUT_CACHE_WINDOW_REQUESTS += 1
        TEXT_LAYOUT_CACHE_WINDOW_UI_REQUESTS += 1
    }
    let data = font.data()
    if data == null {
        let owned_text = text.clone_into(TEXT_LAYOUT_CACHE.storage)
        return text_layout_empty(font, owned_text, face, align)
    }
    let font_id = data.backend_id
    let variant = text_layout_variant_key(false, font_id, face, align,
        CAP_HEIGHT_FONTS, size, render_scale, raster_physical_target_scale)
    let examined = 0
    let head_slot = text_layout_cache_slot(text, variant)
    let slot = head_slot
    while slot >= 0 {
        examined += 1
        let entry = TEXT_LAYOUT_CACHE[slot]
        if !entry.world_raster && entry.font_id == font_id
            && entry.text == text
            && entry.size == size
            && entry.render_scale == render_scale
            && entry.cap_height_fonts == CAP_HEIGHT_FONTS
            && entry.align == align
            && entry.layout.face == face
            && entry.raster_physical_target_scale == raster_physical_target_scale {
            entry.last_used = TEXT_LAYOUT_CACHE_CLOCK
            TEXT_LAYOUT_CACHE_HITS += 1
            TEXT_LAYOUT_CACHE_INDEX_HITS += 1
            TEXT_LAYOUT_CACHE_ENTRIES_EXAMINED += examined
            if examined > TEXT_LAYOUT_CACHE_MAX_ENTRIES_EXAMINED {
                TEXT_LAYOUT_CACHE_MAX_ENTRIES_EXAMINED = examined
            }
            if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE {
                TEXT_LAYOUT_CACHE_WINDOW_HITS += 1
                TEXT_LAYOUT_CACHE_WINDOW_UI_HITS += 1
                TEXT_LAYOUT_CACHE_WINDOW_ENTRIES_EXAMINED += examined
                if examined > TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED {
                    TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED = examined
                }
            }
            return entry.layout
        }
        slot = entry.next_variant_slot
    }
    TEXT_LAYOUT_CACHE_ENTRIES_EXAMINED += examined
    if examined > TEXT_LAYOUT_CACHE_MAX_ENTRIES_EXAMINED {
        TEXT_LAYOUT_CACHE_MAX_ENTRIES_EXAMINED = examined
    }
    if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE {
        TEXT_LAYOUT_CACHE_WINDOW_ENTRIES_EXAMINED += examined
        if examined > TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED {
            TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED = examined
        }
        TEXT_LAYOUT_CACHE_WINDOW_MISSES += 1
        TEXT_LAYOUT_CACHE_WINDOW_UI_MISSES += 1
    }
    TEXT_LAYOUT_CACHE_MISSES += 1
    let owned_text = text.clone_into(TEXT_LAYOUT_CACHE.storage)
    let layout = text_layout_build(font, owned_text, size, render_scale,
        face: face, align: align,
        raster_physical_target_scale: raster_physical_target_scale)
    TEXT_LAYOUT_CACHE_BUILDS += 1
    if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE {
        TEXT_LAYOUT_CACHE_WINDOW_BUILDS += 1
        TEXT_LAYOUT_CACHE_WINDOW_UI_BUILDS += 1
    }
    let entry = TextLayoutCacheEntry {
        font_id: font_id,
        text: owned_text,
        size: size,
        render_scale: render_scale,
        scale_x: 0.0,
        scale_y: 0.0,
        world_raster: false,
        cap_height_fonts: CAP_HEIGHT_FONTS,
        align: align,
        raster_physical_target_scale: raster_physical_target_scale,
        variant: variant,
        next_variant_slot: -1,
        last_used: TEXT_LAYOUT_CACHE_CLOCK,
        layout: layout,
    }
    let slot = text_layout_cache_claim_slot(false)
    if slot == TEXT_LAYOUT_CACHE.len {
        TEXT_LAYOUT_CACHE.push(entry)
    } else {
        TEXT_LAYOUT_CACHE[slot] = entry
    }
    return text_layout_cache_commit(slot)
}

fn text_layout_cached_world(
    font: Font,
    text: string,
    scale_x: float,
    scale_y: float,
    raster_physical_target_scale: float = -1.0,
    face: int = FACE_REGULAR
) -> TextLayout {
    TEXT_LAYOUT_CACHE_CLOCK += 1
    TEXT_LAYOUT_CACHE_REQUESTS += 1
    if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE {
        TEXT_LAYOUT_CACHE_WINDOW_REQUESTS += 1
        TEXT_LAYOUT_CACHE_WINDOW_WORLD_REQUESTS += 1
    }
    let data = font.data()
    if data == null {
        let owned_text = text.clone_into(TEXT_LAYOUT_CACHE.storage)
        return text_layout_empty(font, owned_text, face, TextAlign::TopLeft)
    }
    let font_id = data.backend_id
    let density = if raster_physical_target_scale > 0.0 {
        raster_physical_target_scale
    } else { world_text_scene_density() }
    let variant = text_layout_variant_key(true, font_id, face, TextAlign::TopLeft,
        false, scale_x, scale_y, density)
    let examined = 0
    let head_slot = text_layout_cache_slot(text, variant)
    let slot = head_slot
    while slot >= 0 {
        examined += 1
        let entry = TEXT_LAYOUT_CACHE[slot]
        if entry.world_raster && entry.font_id == font_id
            && entry.text == text
            && entry.scale_x == scale_x
            && entry.scale_y == scale_y
            && entry.raster_physical_target_scale == density
            && entry.layout.face == face {
            entry.last_used = TEXT_LAYOUT_CACHE_CLOCK
            TEXT_LAYOUT_CACHE_HITS += 1
            TEXT_LAYOUT_CACHE_INDEX_HITS += 1
            if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE {
                TEXT_LAYOUT_CACHE_WINDOW_HITS += 1
                TEXT_LAYOUT_CACHE_WINDOW_WORLD_HITS += 1
            }
            TEXT_LAYOUT_CACHE_ENTRIES_EXAMINED += examined
            if examined > TEXT_LAYOUT_CACHE_MAX_ENTRIES_EXAMINED {
                TEXT_LAYOUT_CACHE_MAX_ENTRIES_EXAMINED = examined
            }
            if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE {
                TEXT_LAYOUT_CACHE_WINDOW_ENTRIES_EXAMINED += examined
                if examined > TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED {
                    TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED = examined
                }
            }
            return entry.layout
        }
        slot = entry.next_variant_slot
    }
    TEXT_LAYOUT_CACHE_ENTRIES_EXAMINED += examined
    if examined > TEXT_LAYOUT_CACHE_MAX_ENTRIES_EXAMINED {
        TEXT_LAYOUT_CACHE_MAX_ENTRIES_EXAMINED = examined
    }
    if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE {
        TEXT_LAYOUT_CACHE_WINDOW_ENTRIES_EXAMINED += examined
        if examined > TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED {
            TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED = examined
        }
        TEXT_LAYOUT_CACHE_WINDOW_MISSES += 1
        TEXT_LAYOUT_CACHE_WINDOW_WORLD_MISSES += 1
    }
    TEXT_LAYOUT_CACHE_MISSES += 1
    TEXT_WORLD_LAYOUT_BUILD_CALLS += 1
    let owned_text = text.clone_into(TEXT_LAYOUT_CACHE.storage)
    let layout = text_layout_build_scaled(font, owned_text, scale_x, scale_y,
        face, TextAlign::TopLeft, false, true, "", density)
    TEXT_LAYOUT_CACHE_BUILDS += 1
    if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE {
        TEXT_LAYOUT_CACHE_WINDOW_BUILDS += 1
        TEXT_LAYOUT_CACHE_WINDOW_WORLD_BUILDS += 1
    }
    let entry = TextLayoutCacheEntry {
        font_id: font_id,
        text: owned_text,
        size: 0.0,
        render_scale: 0.0,
        scale_x: scale_x,
        scale_y: scale_y,
        world_raster: true,
        cap_height_fonts: false,
        align: TextAlign::TopLeft,
        raster_physical_target_scale: density,
        variant: variant,
        next_variant_slot: -1,
        last_used: TEXT_LAYOUT_CACHE_CLOCK,
        layout: layout,
    }
    let slot = text_layout_cache_claim_slot(true)
    if slot == TEXT_LAYOUT_CACHE.len {
        TEXT_LAYOUT_CACHE.push(entry)
    } else {
        TEXT_LAYOUT_CACHE[slot] = entry
    }
    return text_layout_cache_commit(slot)
}

pub fn text_layout_aligned_origin(layout: TextLayout, anchor: Vec2) -> Vec2 {
    return anchor + layout.alignment_offset
}

pub fn text_layout_identity_poses(layout: TextLayout) -> [GlyphPose] {
    let poses: [GlyphPose] = []
    for glyph in layout.glyphs {
        poses.push(GlyphPose {
            glyph_index: glyph.glyph_index,
            source_index: glyph.source_index,
            glyph: glyph.glyph,
            translation: v(),
            scale: v(1.0, 1.0),
            rotation: 0.0,
        })
    }
    return poses
}

pub fn glyph_pose_translate(pose: GlyphPose, translation: Vec2) -> GlyphPose {
    return GlyphPose {
        glyph_index: pose.glyph_index,
        source_index: pose.source_index,
        glyph: pose.glyph,
        translation: pose.translation + translation,
        scale: pose.scale,
        rotation: pose.rotation,
    }
}

pub fn glyph_pose_transform(
    pose: GlyphPose,
    translation: Vec2,
    scale: Vec2,
    rotation: float
) -> GlyphPose {
    return GlyphPose {
        glyph_index: pose.glyph_index,
        source_index: pose.source_index,
        glyph: pose.glyph,
        translation: pose.translation + translation,
        scale: pose.scale * scale,
        rotation: pose.rotation + rotation,
    }
}

fn text_layout_pose_at(layout: TextLayout, index: int, poses: [GlyphPose]?) -> GlyphPose? {
    if poses == null { return null }
    let all = poses.unwrap()
    if all.len != layout.glyphs.len {
        error("text layout pose count {all.len} does not match glyph count {layout.glyphs.len}")
    }
    let pose = all[index]
    let glyph = layout.glyphs[index]
    if pose.glyph_index != glyph.glyph_index
        || pose.source_index != glyph.source_index
        || pose.glyph != glyph.glyph {
        error("text layout pose {index} does not match glyph identity")
    }
    return pose
}

fn text_layout_validate_poses(layout: TextLayout, poses: [GlyphPose]) {
    if poses.len != layout.glyphs.len {
        error("text layout pose count {poses.len} does not match glyph count {layout.glyphs.len}")
    }
    for i in 0..poses.len {
        let pose = poses[i]
        let glyph = layout.glyphs[i]
        if pose.glyph_index != glyph.glyph_index
            || pose.source_index != glyph.source_index
            || pose.glyph != glyph.glyph {
            error("text layout pose {i} does not match glyph identity")
        }
    }
}

fn text_layout_pose_point(glyph_pivot: Vec2, point: Vec2, pose: GlyphPose?) -> Vec2 {
    if pose == null { return point }
    let p = pose.unwrap()
    if p.translation == v() && p.scale == v(1.0, 1.0) && p.rotation == 0.0 {
        return point
    }
    return glyph_pivot + ((point - glyph_pivot) * p.scale).rotate(p.rotation)
        + p.translation
}

pub fn text_layout_glyph_bounds(layout: TextLayout, index: int, poses: [GlyphPose]?) -> Rect {
    let glyph = layout.glyphs[index]
    let pose = text_layout_pose_at(layout, index, poses)
    let a = text_layout_pose_point(glyph.pivot, v(glyph.ink.x, glyph.ink.y), pose)
    let b = text_layout_pose_point(glyph.pivot, v(glyph.ink.x + glyph.ink.w, glyph.ink.y), pose)
    let c = text_layout_pose_point(
        glyph.pivot,
        v(glyph.ink.x + glyph.ink.w,
            glyph.ink.y + glyph.ink.h),
        pose
    )
    let d = text_layout_pose_point(
        glyph.pivot, v(glyph.ink.x, glyph.ink.y + glyph.ink.h), pose)
    let lo = v(min(min(a.x, b.x), min(c.x, d.x)), min(min(a.y, b.y), min(c.y, d.y)))
    let hi = v(max(max(a.x, b.x), max(c.x, d.x)), max(max(a.y, b.y), max(c.y, d.y)))
    return rect(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y)
}

fn text_layout_cache_key(layout: TextLayout) -> string {
    let font_id = if layout.font == null { 0 } else {
        layout.font.unwrap().data()?.backend_id
    }
    return "{font_id}:{layout.text}:{layout.face}:{layout.line_height:.5}:{layout.logical_bounds.x:.5}:{layout.logical_bounds.y:.5}:{layout.logical_bounds.w:.5}:{layout.logical_bounds.h:.5}:{layout.alignment_offset.x:.5}:{layout.alignment_offset.y:.5}"
}

fn text_world_layout_scaled(
    font: Font,
    text: string,
    scale_x: float,
    scale_y: float
) -> TextLayout {
    return text_layout_cached_world(font, text, scale_x, scale_y)
}

// The plain entry point. `render_scale` is EXPLICIT: FONT_RENDER_SCALE
// is the output context's window/DPI factor and has no meaning on a surface
// authored in its own units (scene texels), where letting it through would
// rasterize glyphs at the wrong size for the grid.
//
// Multiline: one implicit run per line, all sharing the block's max ascent and
// max glyph height, exactly as before. No TextSpan is built for it.
pub fn queue_ui_text_scaled(
    font: Font,
    text: string,
    pos: Vec2,
    size: float,
    color: Color,
    offset: Vec2,
    z_layer: int,
    render_scale: float,
    align: TextAlign = TextAlign::TopLeft,
    raster_physical_target_scale: float = 1.0
) {
    if text.len() == 0 { return }
    let d = font.data() ?? return
    let idx = d.backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len || idx >= GLYPH_CACHES.len
        || GLYPH_CACHES[idx].len <= FACE_REGULAR
        || GLYPH_CACHES[idx][FACE_REGULAR].len == 0
        || font_size_divisor(idx) <= 0.0 { return }
    let layout = text_layout_cached(font, text, size, render_scale,
        align, raster_physical_target_scale)
    emit_ui_text_layout(layout, pos, color, offset, z_layer)
}

fn emit_ui_text_layout(
    layout: TextLayout,
    pos: Vec2,
    color: Color,
    offset: Vec2,
    z_layer: int
) {
    if layout.glyphs.len == 0 { return }
    let anchor = pos + offset * v(layout.logical_bounds.w, layout.logical_bounds.h)
    let origin = text_layout_aligned_origin(layout, anchor)
    let _ = text_layout_emit(layout, origin, color, z_layer)
}

// --- Rich text: several runs, one line ---
//
// The walker's input. Face resolution and byte admission both happen before
// one of these exists, so nothing downstream re-decides them. Every run reads
// one face of one font at one size; the mixed-size arc varies `size` here
// without touching the walk or the public span collection.
pub struct ResolvedTextRun {
    text: string,
    font: Font,
    // Which baked face this run reads. Resolution happened before the run
    // existed; the walk never re-decides it.
    face: int,
    // Target-context size: the authored size through the selected font's
    // target or world scaling policy.
    size: float,
    // Font-unit divisor. Target runs use the selected font's UI divisor;
    // world runs use the selected font's native em.
    scale_divisor: float,
    color: Color,
    raster_physical_target_scale: float = 1.0,
    layout: TextLayout? = null,
    // Whole-run scale applied at measure and emit time, so a size that
    // animates every frame reuses one layout built at the base size.
    draw_scale: float = 1.0,
}

pub struct ResolvedTextLine {
    runs: [ResolvedTextRun],
    width: float,
    ascent: float,
    height: float,
}

pub value ResolvedPlainText {
    lines: [ResolvedTextLine],
    width: float,
    ascent: float,
    height: float,
    line_height: float,
}

pub fn run_glyphs(run: ResolvedTextRun) -> [GlyphData] {
    return GLYPH_CACHES[run.font.data().unwrap().backend_id - 1][run.face]
}

pub fn run_cp_slots(run: ResolvedTextRun) -> Map<int, int> {
    return FONT_CP_SLOTS[run.font.data().unwrap().backend_id - 1]
}

// An explicit family resolves every handle and atlas up front; legacy
// single-Font calls retain their documented stale-handle no-op.
//
// `require_atlas` separates the two questions this used to answer as one. Batch
// state, a glyph cache and usable metrics are what LAYOUT needs; an atlas page
// is a GL texture, which only EMISSION needs. A metrics-only font
// (`load_font_metrics`, the code-test process) has every metric and no page, so
// a measurement that demanded a page refused a font it never had to touch.
// The default is the draw requirement, so an emitting caller that says nothing
// keeps it; the measurement entry points opt out by name.
pub fn text_family_font_idx(font: Font, site: string, require_atlas: bool = true) -> int {
    let fd = font.data()
    if fd == null { error("{site}: stale font handle -- the font was unloaded") }
    let d = fd.unwrap()
    let idx = d.backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len
        || idx >= FONT_CP_SLOTS.len || idx >= GLYPH_CACHES.len {
        error("{site}: font {d.backend_id} has no batch state")
    }
    if require_atlas && FONT_ATLASES[idx] == Image(0) {
        error("{site}: font {d.backend_id} has no usable atlas")
    }
    if FACE_REGULAR < 0 || FACE_REGULAR >= GLYPH_CACHES[idx].len
        || GLYPH_CACHES[idx][FACE_REGULAR].len == 0 {
        error("{site}: font {d.backend_id} has no glyph cache")
    }
    // The int overload: `idx` is what the Font overload would resolve to, and
    // it is already in hand.
    if font_size_divisor(idx) <= 0.0 {
        error("{site}: font {d.backend_id} has no usable metrics")
    }
    return idx
}

fn text_family_fonts(family: TextFamily) -> [Font] {
    let fonts: [Font] = []
    fonts.push(family.regular)
    for fallback in family.fallbacks { fonts.push(fallback) }
    return fonts
}

// Validate the whole flat family before looking at spans. This also makes an
// empty span list name every handle and atlas in the family.
pub fn text_family_indices(family: TextFamily, site: string,
    require_atlas: bool = true) -> ([Font], [int]) {
    let fonts = text_family_fonts(family)
    let indices: [int] = []
    for font in fonts { indices.push(text_family_font_idx(font, site, require_atlas)) }
    return (fonts, indices)
}

fn text_supported_slot(idx: int, text: string, at: int, face: int) -> int {
    if idx < 0 || idx >= FONT_CP_SLOTS.len || idx >= GLYPH_CACHES.len {
        return -1
    }
    if face < 0 || face >= GLYPH_CACHES[idx].len { return -1 }
    let slot = text_glyph_slot(FONT_CP_SLOTS[idx], text, at)
    let glyphs = GLYPH_CACHES[idx][face]
    if slot < 0 || slot >= glyphs.len { return -1 }
    if !glyphs[slot].valid { return -1 }
    return slot
}

fn text_codepoint_end(text: string, at: int) -> int {
    let end = at + 1
    while end < text.len() && text_codepoint_at(text, end) == -1 {
        end = end + 1
    }
    return end
}

fn text_select_font(indices: [int], text: string, at: int) -> int {
    for i in 0..indices.len {
        if text_supported_slot(indices[i], text, at, FACE_REGULAR) >= 0 {
            return i
        }
    }
    return -1
}

pub enum TextMissingGlyphPolicy {
    Reject,
    Substitute,
}

pub global TEXT_MISSING_GLYPH_POLICY: TextMissingGlyphPolicy = TextMissingGlyphPolicy::Substitute

// Memo for text_prepare_missing_glyphs. Preparation is a pure function of the
// text, the font set, TEXT_MISSING_GLYPH_POLICY and the loaded fonts' glyph
// coverage, and every drawn string re-ran its per-codepoint loop every frame.
// Two levels rather than one composite key so the lookup is two table reads:
// building a "{set}:{text}" key would allocate on the hot path it exists to
// clear.
//
// The bound is a capacity with a FULL clear, not the layout cache's LRU: drawn
// text is largely per-frame dynamic (damage numbers, timers, coordinates), so
// the working set turns over wholesale rather than aging, and an eviction scan
// would cost more than re-preparing the live strings after a clear.
const TEXT_PREPARE_CACHE_CAPACITY: int = 512

// A family folds its index list, length first, so a two-font set can never
// share a key with a one-font set. Backend ids are monotonic from zero and
// never reused, and families are two or three fonts, so the fold stays exact
// well past any set Stone builds; a set that would not fold exactly declines
// the memo instead of sharing a key with a different one. A single_idx caller
// lands on the one-element family's key on purpose: the two describe the same
// font set and must share their answers.
const TEXT_PREPARE_KEY_RADIX: int = 4096
const TEXT_PREPARE_KEY_MAX_FONTS: int = 4

global TEXT_PREPARE_CACHE: Map<int, Map<string, string>> = map_new()
global TEXT_PREPARE_CACHE_ENTRIES: int = 0
global TEXT_PREPARE_CACHE_POLICY: TextMissingGlyphPolicy = TextMissingGlyphPolicy::Substitute

// Called from every seam that rebuilds or drops glyph coverage:
// init_text_batch_for(), drop_text_batch_for() and the font projection reset.
// Those are the only writers of GLYPH_CACHES and FONT_CP_SLOTS, which are the
// only coverage a prepared string depends on.
fn text_prepare_cache_clear() {
    TEXT_PREPARE_CACHE = map_new()
    TEXT_PREPARE_CACHE_ENTRIES = 0
    TEXT_PREPARE_CACHE_POLICY = TEXT_MISSING_GLYPH_POLICY
    text_validate_cache_clear()
}

fn text_prepare_font_set_key(indices: [int]?, single_idx: int) -> int {
    if let family_indices = indices {
        if family_indices.len > TEXT_PREPARE_KEY_MAX_FONTS { return -1 }
        let key = family_indices.len
        for i in 0..family_indices.len {
            let idx = family_indices[i]
            if idx < 0 || idx >= TEXT_PREPARE_KEY_RADIX { return -1 }
            key = key * TEXT_PREPARE_KEY_RADIX + idx + 1
        }
        return key
    }
    if single_idx < 0 || single_idx >= TEXT_PREPARE_KEY_RADIX { return -1 }
    return TEXT_PREPARE_KEY_RADIX + single_idx + 1
}

fn text_prepare_cache_store(set_key: int, text: string, prepared: string) {
    if TEXT_PREPARE_CACHE_ENTRIES >= TEXT_PREPARE_CACHE_CAPACITY {
        text_prepare_cache_clear()
    }
    if let by_text = TEXT_PREPARE_CACHE.get(set_key) {
        by_text.insert(text, prepared)
    } else {
        let created: Map<string, string> = map_new()
        created.insert(text, prepared)
        TEXT_PREPARE_CACHE.insert(set_key, created)
    }
    TEXT_PREPARE_CACHE_ENTRIES += 1
}

pub @pure fn text_missing_glyph_policy_for_run(sim: bool, max_frames: int,
                                            perf_seconds: float) -> TextMissingGlyphPolicy {
    if sim || max_frames > 0 || perf_seconds > 0.0 {
        return TextMissingGlyphPolicy::Reject
    }
    return TextMissingGlyphPolicy::Substitute
}

fn text_missing_glyph_reject(site: string, text: string, at: int, cp: int) {
    if cp < 256 {
        error("{site}: byte {text.unit_at(at)} at offset {at} of {text.len()} starts codepoint {cp}, but no family font renders it")
    }
    error("{site}: codepoint {cp} at offset {at} of {text.len()} is not renderable by any family font")
}

fn text_missing_glyph_log(font: Font, site: string, cp: int) {
    let data = font.data().unwrap()
    log_once("TEXT",
        "{site}: codepoint {cp} is not renderable by the family rooted at {data.path}; substituting '?'",
        "text-missing-glyph:{data.backend_id}:{cp}")
}

fn text_missing_glyph_owner(indices: [int]?, single_idx: int,
                            text: string, at: int) -> int {
    if let family_indices = indices {
        return text_select_font(family_indices, text, at)
    }
    return if text_supported_slot(single_idx, text, at, FACE_REGULAR) >= 0 {
        0
    } else { -1 }
}

// The memo front of text_prepare_missing_glyphs_uncached. A string already
// accepted for this font set is returned as prepared without re-validating it.
//
// Rejection is not memoized: under Reject an unrenderable codepoint errors
// out of the uncached body and never reaches the store, so a bad string keeps
// erroring on every sight. `site` is deliberately absent from the key -- it
// only reaches the log_once() for a substitution, which is already
// deduplicated by (font, codepoint) rather than by site, so a second site
// seeing the same substituted string logged nothing before the memo either.
pub fn text_prepare_missing_glyphs(primary: Font, indices: [int]?, single_idx: int,
                               text: string, site: string) -> string {
    let set_key = text_prepare_font_set_key(indices, single_idx)
    if set_key < 0 {
        return text_prepare_missing_glyphs_uncached(primary, indices, single_idx,
            text, site)
    }
    if TEXT_PREPARE_CACHE_POLICY != TEXT_MISSING_GLYPH_POLICY {
        text_prepare_cache_clear()
    }
    if let by_text = TEXT_PREPARE_CACHE.get(set_key) {
        if let hit = by_text.get(text) { return hit }
    }
    let prepared = text_prepare_missing_glyphs_uncached(primary, indices,
        single_idx, text, site)
    text_prepare_cache_store(set_key, text, prepared)
    return prepared
}

fn text_prepare_missing_glyphs_uncached(primary: Font, indices: [int]?,
                                        single_idx: int,
                                        text: string, site: string) -> string {
    let prepared = ""
    let copy_from = 0
    let changed = false
    let i = 0
    while i < text.len() {
        let cp = text_codepoint_at(text, i)
        if cp == -2 || cp < 0 {
            i += 1
            continue
        }
        let end = text_codepoint_end(text, i)
        if cp == 10 || cp == 13 || cp == 9
            || text_missing_glyph_owner(indices, single_idx, text, i) >= 0 {
            i = end
            continue
        }
        if TEXT_MISSING_GLYPH_POLICY == TextMissingGlyphPolicy::Reject {
            text_missing_glyph_reject(site, text, i, cp)
        }
        if text_missing_glyph_owner(indices, single_idx, "?", 0) < 0 {
            error("{site}: codepoint {cp} is not renderable and no family font renders the replacement '?'")
        }
        text_missing_glyph_log(primary, site, cp)
        prepared = prepared + text.substring(copy_from, i) + "?"
        copy_from = end
        changed = true
        i = end
    }
    if !changed { return text }
    return prepared + text.substring(copy_from, text.len())
}

// The requested face must be declared by the font that owns the regular
// glyph. Synthesis is a declaration, not a fallback: serving regular for an
// undeclared bold would render a line that measures right and reads wrong.
fn text_face(font: Font, idx: int, style: TextStyle, cp: int, at: int, site: string) -> int {
    let d = font.data().unwrap()
    let face = style_face_index(style)
    if !faces_declare(d.faces, face) {
        error("{site}: codepoint {cp} at offset {at} selected {d.path}, which declares no {face_name(face)} face -- pass faces: TextFaces {{ bold: true, italic: true }} to load_font")
    }
    if face < 0 || face >= GLYPH_CACHES[idx].len
        || GLYPH_CACHES[idx][face].len == 0 {
        error("{site}: codepoint {cp} at offset {at} selected font {d.backend_id}, which declares a {face_name(face)} face but baked no glyphs for it")
    }
    return face
}

fn text_face_divisor(font: Font, world_raster: bool, site: string) -> float {
    let data = font.data()
    if data == null { error("{site}: selected font is stale") }
    let d = data.unwrap()
    let idx = d.backend_id - 1
    let divisor = if world_raster {
        if idx < 0 || idx >= FONT_UNIT_SIZES.len { 0.0 }
        else { FONT_UNIT_SIZES[idx] }
    } else {
        font_size_divisor(idx)
    }
    if divisor <= 0.0 { error("{site}: selected font {d.backend_id} has no usable text divisor") }
    return divisor
}

fn text_make_run(
    text: string,
    from: int,
    to: int,
    font: Font,
    face: int,
    size: float,
    divisor: float,
    color: Color
) -> ResolvedTextRun {
    return ResolvedTextRun {
        text: text.substring(from, to),
        font: font,
        face: face,
        size: size,
        scale_divisor: divisor,
        color: color,
    }
}

fn text_run_size(font: Font, size: float, render_scale: float, world_raster: bool) -> float {
    return if world_raster {
        world_text_em_for(font, size)
    } else {
        size * render_scale
    }
}

// Memo for text_validate_single_font_span, cleared on the same seams as the
// prepare memo (text_prepare_cache_clear). The answer is a pure function of the
// text, the font, the face the style selects and the line-control rule. Once
// preparation stopped looping, this validation was the next per-codepoint walk
// the recorder reached on every drawn string, and the census moved to it
// wholesale.
global TEXT_VALIDATE_CACHE: Map<int, Map<string, int>> = map_new()
pub global TEXT_VALIDATE_CACHE_ENTRIES: int = 0

fn text_validate_cache_clear() {
    TEXT_VALIDATE_CACHE = map_new()
    TEXT_VALIDATE_CACHE_ENTRIES = 0
}

pub fn text_validate_single_font_span(
    font: Font,
    idx: int,
    text: string,
    style: TextStyle,
    reject_line_controls: bool,
    site: string
) -> int {
    if idx < 0 {
        return text_validate_single_font_span_uncached(font, idx, text, style,
            reject_line_controls, site)
    }
    let key = (idx * 4 + style_face_index(style)) * 2
        + if reject_line_controls { 1 } else { 0 }
    if let by_text = TEXT_VALIDATE_CACHE.get(key) {
        if let hit = by_text.get(text) { return hit }
    }
    // Rejection errors out above and never reaches the store.
    let face = text_validate_single_font_span_uncached(font, idx, text, style,
        reject_line_controls, site)
    if TEXT_VALIDATE_CACHE_ENTRIES >= TEXT_PREPARE_CACHE_CAPACITY {
        text_validate_cache_clear()
    }
    if let by_text = TEXT_VALIDATE_CACHE.get(key) {
        by_text.insert(text, face)
    } else {
        let created: Map<string, int> = map_new()
        created.insert(text, face)
        TEXT_VALIDATE_CACHE.insert(key, created)
    }
    TEXT_VALIDATE_CACHE_ENTRIES += 1
    return face
}

fn text_validate_single_font_span_uncached(
    font: Font,
    idx: int,
    text: string,
    style: TextStyle,
    reject_line_controls: bool,
    site: string
) -> int {
    let face = -1
    let i = 0
    while i < text.len() {
        let unit = text.unit_at(i)
        if reject_line_controls && (unit == 10 || unit == 13 || unit == 9) {
            error("{site}: rich text is one line -- byte {unit} at offset {i} of {text.len()} is a line control")
        }
        let cp = text_codepoint_at(text, i)
        if cp == -2 {
            error("{site}: byte {unit} at offset {i} of {text.len()} starts a malformed sequence")
        }
        if cp < 0 {
            i += 1
            continue
        }
        if text_supported_slot(idx, text, i, FACE_REGULAR) < 0 {
            text_missing_glyph_reject(site, text, i, cp)
        }
        let resolved = text_face(font, idx, style, cp, i, site)
        if text_supported_slot(idx, text, i, resolved) < 0 {
            let d = font.data().unwrap()
            error("{site}: codepoint {cp} at offset {i} selected font {d.backend_id}, but its {face_name(resolved)} face has no valid glyph")
        }
        face = resolved
        i = text_codepoint_end(text, i)
    }
    return face
}

// Resolve one string segment into contiguous owner runs. The scan keeps byte
// offsets until an owner changes, so a family-aware plain string allocates one
// substring per run rather than one substring per codepoint.
// Append into the consumer-owned sequence; span boundaries need no temporary list.
pub fn text_resolve_segment(
    runs: [ResolvedTextRun],
    fonts: [Font],
    indices: [int],
    text: string,
    size: float,
    render_scale: float,
    world_raster: bool,
    style: TextStyle,
    reject_line_controls: bool,
    site: string
) {
    if fonts.len == 1 && indices.len == 1 {
        let font = fonts[0]
        let prepared = text_prepare_missing_glyphs(
            font, null, indices[0], text, site)
        let face = text_validate_single_font_span(
            font, indices[0], prepared, style, reject_line_controls, site)
        if face >= 0 {
            runs.push(text_make_run(prepared, 0, prepared.len(), font, face,
                text_run_size(font, size, render_scale, world_raster),
                text_face_divisor(font, world_raster, site), style.color))
        }
        return
    }
    let prepared = text_prepare_missing_glyphs(fonts[0], indices, -1, text, site)
    let selected = -1
    let selected_face = -1
    let run_start = 0
    let i = 0
    while i < prepared.len() {
        let unit = prepared.unit_at(i)
        if reject_line_controls && (unit == 10 || unit == 13 || unit == 9) {
            error("{site}: rich text is one line -- byte {unit} at offset {i} of {prepared.len()} is a line control")
        }
        let cp = text_codepoint_at(prepared, i)
        if cp == -2 {
            error("{site}: byte {unit} at offset {i} of {prepared.len()} starts a malformed sequence")
        }
        if cp < 0 {
            i = i + 1
            continue
        }
        let owner = text_select_font(indices, prepared, i)
        if owner < 0 {
            text_missing_glyph_reject(site, prepared, i, cp)
        }
        let font = fonts[owner]
        let idx = indices[owner]
        let face = text_face(font, idx, style, cp, i, site)
        if text_supported_slot(idx, prepared, i, face) < 0 {
            let d = font.data().unwrap()
            error("{site}: codepoint {cp} at offset {i} selected font {d.backend_id}, but its {face_name(face)} face has no valid glyph")
        }
        let end = text_codepoint_end(prepared, i)
        if selected != owner || selected_face != face {
            if selected >= 0 {
                let previous = fonts[selected]
                runs.push(
                    text_make_run(prepared, run_start, i, previous,
                        selected_face,
                        text_run_size(previous, size, render_scale, world_raster),
                        text_face_divisor(previous, world_raster, site),
                        style.color)
                )
            }
            selected = owner
            selected_face = face
            run_start = i
        }
        i = end
    }
    if selected >= 0 {
        let font = fonts[selected]
        runs.push(
            text_make_run(prepared, run_start, prepared.len(), font,
                selected_face,
                text_run_size(font, size, render_scale, world_raster),
                text_face_divisor(font, world_raster, site), style.color)
        )
    }
    return
}

// Validate and resolve the WHOLE sequence before anything is measured or
// emitted, so an invalid later span cannot leave earlier spans half-drawn.
//
// The FAMILY is validated for the call, before the loop: an empty sequence
// names a family exactly as a full one does. Each selected face is then
// validated before its run is appended, so an undeclared face in the last
// span cannot leave the first spans drawn.
fn resolve_text_spans_at(
    runs: [ResolvedTextRun],
    family: TextFamily,
    spans: [TextSpan],
    size: float,
    render_scale: float,
    world_raster: bool,
    site: string,
    raster_physical_target_scale: float = 1.0,
    require_atlas: bool = true,
    build_layouts: bool = true
) {
    let (fonts, indices) = text_family_indices(family, site, require_atlas)
    runs.clear()
    for span in spans {
        let start = runs.len()
        text_resolve_segment(runs, fonts, indices, span.text,
            size, render_scale, world_raster, span.style, true, site)
        for i in start..runs.len() {
            let run = runs[i]
            let scale = resolved_run_scale(run)
            let layout: TextLayout? = if !build_layouts {
                null
            } else if world_raster {
                text_layout_cached_world(run.font, run.text, scale, scale,
                    raster_physical_target_scale: 1.0, face: run.face)
            } else {
                text_layout_cached(run.font, run.text, size, render_scale,
                    TextAlign::TopLeft, raster_physical_target_scale,
                    face: run.face)
            }
            if let built = layout { run.text = built.text }
            run.raster_physical_target_scale = raster_physical_target_scale
            run.layout = layout
        }
    }
}

pub fn resolve_text_spans(
    family: TextFamily,
    spans: [TextSpan],
    size: float,
    render_scale: float,
    site: string,
    raster_physical_target_scale: float = 1.0,
    require_atlas: bool = true
) -> [ResolvedTextRun] {
    let runs: [ResolvedTextRun] = []
    resolve_text_spans_at(runs, family, spans, size, render_scale,
        false, site, raster_physical_target_scale, require_atlas)
    return runs
}

pub fn resolve_world_text_spans(
    family: TextFamily,
    spans: [TextSpan],
    size: float,
    site: string,
    require_atlas: bool = true
) -> [ResolvedTextRun] {
    let runs: [ResolvedTextRun] = []
    resolve_text_spans_at(runs, family, spans, size, 1.0, true, site, 1.0, require_atlas)
    return runs
}

pub fn plain_text_layout_from_lines(
    lines: [ResolvedTextLine]
) -> ResolvedPlainText {
    let width = 0.0
    let ascent = 0.0
    let below_baseline = 0.0
    for line in lines {
        if line.width > width { width = line.width }
        if line.ascent > ascent { ascent = line.ascent }
        let line_below = line.height - line.ascent
        if line_below > below_baseline { below_baseline = line_below }
    }
    let line_height = ascent + below_baseline
    let height = lines.len as float * line_height
    return ResolvedPlainText {
        lines: lines,
        width: width,
        ascent: ascent,
        height: height,
        line_height: line_height,
    }
}

fn resolve_plain_text_layout_at(
    family: TextFamily,
    text: string,
    size: float,
    render_scale: float,
    world_raster: bool,
    site: string,
    require_atlas: bool = true
) -> ResolvedPlainText {
    let (fonts, indices) = text_family_indices(family, site, require_atlas)
    let lines: [ResolvedTextLine] = []
    let line_start = 0
    let i = 0
    while i <= text.len() {
        if i == text.len() || text.unit_at(i) == 10 {
            let line_text = text.substring(line_start, i)
            let runs: [ResolvedTextRun] = []
            text_resolve_segment(runs, fonts, indices, line_text,
                size, render_scale, world_raster, TextStyle {}, false, site)
            let (width, ascent, height) = measure_resolved_runs(runs)
            for run in runs {
                run.text = run.layout.unwrap().text
            }
            lines.push(ResolvedTextLine {
                runs: runs,
                width: width,
                ascent: ascent,
                height: height,
            })
            line_start = i + 1
        }
        i = i + 1
    }
    return plain_text_layout_from_lines(lines)
}

pub fn resolve_plain_text_layout(
    family: TextFamily,
    text: string,
    size: float,
    render_scale: float,
    site: string,
    require_atlas: bool = true
) -> ResolvedPlainText {
    return resolve_plain_text_layout_at(family, text, size, render_scale,
        false, site, require_atlas)
}

pub fn resolve_plain_world_text_layout(
    family: TextFamily,
    text: string,
    size: float,
    site: string
) -> ResolvedPlainText {
    return resolve_plain_text_layout_at(family, text, size, 1.0,
        true, site)
}

pub fn resolved_run_scale(run: ResolvedTextRun) -> float {
    return run.size / run.scale_divisor
}

// The run's layout, built once on first use. Measurement and emission read
// through here, so they always walk the same layout.
fn resolved_run_layout(run: ResolvedTextRun) -> TextLayout {
    if let layout = run.layout { return layout }
    let scale = resolved_run_scale(run)
    let built = text_layout_cached_world(run.font, run.text, scale, scale,
        run.raster_physical_target_scale, run.face)
    run.layout = built
    return built
}

// Total advance, max ascent and max glyph height over the COMPLETE sequence.
// Alignment anchors on this, never on a single run: an empty run contributes
// nothing and an all-empty list measures zero.
pub fn measure_resolved_runs(runs: [ResolvedTextRun]) -> (float, float, float) {
    let total = 0.0
    let max_ascent = 0.0
    let max_below_baseline = 0.0
    for run in runs {
        let layout = resolved_run_layout(run)
        let k = run.draw_scale
        total = total + layout.logical_bounds.w * k
        if layout.ascent * k > max_ascent { max_ascent = layout.ascent * k }
        let below_baseline = (layout.logical_bounds.h - layout.ascent) * k
        if below_baseline > max_below_baseline {
            max_below_baseline = below_baseline
        }
    }
    return (total, max_ascent, max_ascent + max_below_baseline)
}

// Where a resolved-run walk puts each run. Output and Target are Y-down:
// `start` is the line's top-left and every run hangs from the line's max
// ascent. World is Y-up: `start` is the baseline every run sits on. Output
// goes to the UI pool, Target to the render-pool canvas bake, World to the
// world sprite batch at the caller's depth.
pub enum TextPlacement {
    Output,
    Target,
    World,
}

// Emit the sequence with ONE continuous pen from `start`. A run boundary
// changes the colour and the face and nothing else -- one atlas, one baseline,
// one pen. `tint` replaces every authored colour, so the shadow pass is the
// same resolved sequence in black. A run with no drawable glyph (whitespace)
// still advances the pen, as measure_resolved_runs counts it. `max_ascent`
// is unused by World; `depth` only by World; `consumer_key` only by Output.
pub fn emit_resolved_runs(
    runs: [ResolvedTextRun],
    placement: TextPlacement,
    start: Vec2,
    max_ascent: float,
    z_layer: int,
    tint: Color? = null,
    depth: DepthMode = DepthMode::Off,
    consumer_key: string = ""
) {
    let pen = start.x
    for run in runs {
        let layout = resolved_run_layout(run)
        let k = run.draw_scale
        let color = tint ?? run.color
        let _ = match placement {
            TextPlacement::Output => text_layout_emit(layout,
                v(pen, start.y + max_ascent - layout.ascent * k), color, z_layer,
                consumer_key: consumer_key, layout_scale: k),
            TextPlacement::Target => emit_target_layout_in_render_pool(layout,
                v(pen, start.y + max_ascent - layout.ascent * k), z_layer, color),
            TextPlacement::World => text_layout_emit_world(layout,
                v(pen, start.y), z_layer, depth, color),
        }
        pen += layout.logical_bounds.w * k
    }
}

pub fn emit_plain_text_layout(
    layout: ResolvedPlainText,
    placement: TextPlacement,
    start: Vec2,
    z_layer: int,
    tint: Color? = null,
    depth: DepthMode = DepthMode::Off
) {
    let line_y = start.y
    for line in layout.lines {
        emit_resolved_runs(line.runs, placement, v(start.x, line_y),
            layout.ascent, z_layer, tint, depth)
        line_y += layout.line_height
    }
}

// The canvas-bake destination shares its layout oracle and its Y-down glyph
// geometry with every other target list; only the pool it drains into differs,
// so it selects the same coverage instance rather than deriving quads from the
// raw atlas pages, whose metrics are in raster pixels and not font units.
fn emit_target_layout_in_render_pool(
    layout: TextLayout,
    origin: Vec2,
    z_layer: int,
    color: Color
) -> bool {
    let font = layout.font ?? return false
    let fd = font.data() ?? return false
    let idx = fd.backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len || layout.glyphs.len == 0 {
        return false
    }
    let demand = text_layout_raster_demand(layout, null)
    let instance = text_art_atlas_instance_for(font, demand)
    let image = stone_get_font_instance_image_ffi(instance.instance_id)
    if image == 0 {
        error("target canvas text atlas instance {instance.instance_id} has no GL image")
    }
    let batch = ensure_world_sprite_batch(
        sampled_image(Image(image)), z_layer, BlendMode::Alpha, false,
        DepthMode::Off, unlit: true, sampling: fd.sampling)
    reserve_vertices(batch, layout.glyphs.len * 6)
    return text_layout_emit_instance(batch, layout, origin, color,
        instance.instance_id, null)
}

// Target-space extent of a span sequence, measured with the SAME walk the
// emitter uses, so a caller that positions by measurement cannot disagree with
// the glyphs. `render_scale` is the calling context's factor, as for
// measure_text_of.
pub fn measure_rich_text_of(
    family: TextFamily,
    spans: [TextSpan],
    size: float,
    render_scale: float
) -> Vec2 {
    let runs = resolve_text_spans(family, spans, size, render_scale, "measure_rich_text_of",
        require_atlas: false)
    let (w, _a, h) = measure_resolved_runs(runs)
    return v(w, h)
}

fn measure_rich_text_single_font(
    font: Font,
    spans: [TextSpan],
    size: float,
    render_scale: float
) -> Vec2 {
    let idx = text_family_font_idx(font, "measure_rich_text_of", require_atlas: false)
    let width = 0.0
    let max_ascent = 0.0
    let max_below_baseline = 0.0
    for span in spans {
        if span.text.len() == 0 { continue }
        let prepared = text_prepare_missing_glyphs(font, null, idx, span.text,
            "measure_rich_text_of")
        let face = text_validate_single_font_span(
            font, idx, prepared, span.style, true, "measure_rich_text_of")
        if face < 0 { continue }
        let layout = text_layout_cached(font, prepared, size, render_scale,
            TextAlign::TopLeft, 1.0, face: face)
        width += layout.logical_bounds.w
        if layout.ascent > max_ascent { max_ascent = layout.ascent }
        let below_baseline = layout.logical_bounds.h - layout.ascent
        if below_baseline > max_below_baseline {
            max_below_baseline = below_baseline
        }
    }
    return v(width, max_ascent + max_below_baseline)
}

fn measure_rich_text_single_font_text(
    font: Font,
    text: string,
    color: Color,
    bold: bool,
    italic: bool,
    size: float,
    render_scale: float
) -> Vec2 {
    let idx = text_family_font_idx(font, "measure_rich_text_of", require_atlas: false)
    let style = TextStyle { color: color, bold: bold, italic: italic }
    let prepared = text_prepare_missing_glyphs(font, null, idx, text,
        "measure_rich_text_of")
    let face = text_validate_single_font_span(
        font, idx, prepared, style, true, "measure_rich_text_of")
    if face < 0 { return v() }
    let layout = text_layout_cached(font, prepared, size, render_scale,
        TextAlign::TopLeft, 1.0, face: face)
    return v(layout.logical_bounds.w, layout.logical_bounds.h)
}

pub fn measure_world_rich_text(spans: [TextSpan], size: float) -> Vec2 {
    let runs = resolve_world_text_spans(text_family_or_default(), spans, size,
        "measure_world_rich_text", require_atlas: false)
    let (w, _a, h) = measure_resolved_runs(runs)
    return v(w, h)
}

pub fn measure_world_rich_text_metrics(spans: [TextSpan], size: float) -> (float, float, float) {
    let runs = resolve_world_text_spans(text_family_or_default(), spans, size,
        "measure_world_rich_text_metrics", require_atlas: false)
    return measure_resolved_runs(runs)
}

// Plain family measurement is named separately from the legacy Font-only
// measure_text_of so overload resolution cannot hide which admission policy a
// caller selected.
pub fn measure_plain_text_of(
    family: TextFamily,
    text: string,
    size: float,
    render_scale: float
) -> Vec2 {
    let layout = resolve_plain_text_layout(family, text, size, render_scale,
        "measure_plain_text_of", require_atlas: false)
    return v(layout.width, layout.height)
}

@pure fn make_world_text_vertex(
    x: float,
    y: float,
    u: float,
    v_: float,
    color: Color,
    py: float
) -> Vertex {
    return Vertex {
        pos: Vec2f { x: x, y: y },
        uv: Vec2f { x: u, y: v_ },
        color: Vec4f { x: color.r, y: color.g, z: color.b, w: color.a },
        pivot_y: py,
        entity_id: 0.0,
        colorize: 0.0,
    }
}

// World-space text as a normal vertex batch: glyph quads on the font
// atlas into the current render pool, same pen math as the immediate
// FFI path (stone-rs `draw_text_line_internal`, negative-sy branch):
// baseline-anchored, Y-up, quads descend from baseline + bearing_y.
// `sy` is negative. entity_id stays zero so the aux passes
// drop text the standard way (outline_target discards, no id claimed).
pub fn queue_world_text(
    font: Font,
    text: string,
    x: float,
    y: float,
    sx: float,
    sy: float,
    color: Color,
    z_layer: int,
    depth: DepthMode
) {
    let d = font.data() ?? return
    let idx = d.backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len { return }
    if text.len() == 0 { return }
    let unit_em = if idx < FONT_UNIT_SIZES.len { FONT_UNIT_SIZES[idx] } else { d.pixel_size as float }
    let unit_scale_x = sx * (d.pixel_size as float) / unit_em
    let unit_scale_y = abs(sy) * (d.pixel_size as float) / unit_em
    let layout = text_world_layout_scaled(font, text, unit_scale_x, unit_scale_y)
    queue_world_text_layout(layout, x, y, color, z_layer, depth)
}

fn queue_world_text_layout(
    layout: TextLayout,
    x: float,
    y: float,
    color: Color,
    z_layer: int,
    depth: DepthMode
) {
    let _ = text_layout_emit_world(layout, v(x, y), z_layer, depth, color)
}

// Moved from the math module when stone-core was split out: it needs a Font
// and the default font, which are the renderer's, not a value type's.

// Default-font UI text measurement in OUTPUT units -- the same divisor and
// window factor `queue_ui_text` emits with (measure_text_of, text.rock), so
// a caller that positions by measurement lands on the glyphs. The world path
// measures through `measure_world_text` (draw.rock), which divides
// FONT_RENDER_SCALE back out to reach world units.
pub fn measure_text(text: string, font_size: float, family: TextFamily? = null,
    font: Font? = null) -> Vec2 {
    if font != null && family != null { error("measure_text: pass either font or family, not both") }
    if family != null {
        return measure_plain_text_of(family.unwrap(), text, font_size,
            FONT_RENDER_SCALE)
    }
    let f = font ?? DEFAULT_FONT ?? return Vec2 { x: 0.0, y: 0.0 }
    return measure_text_of(f, text, font_size, FONT_RENDER_SCALE, text_output_raster_density())
}
