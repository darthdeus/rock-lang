// Text owner: font projection lifecycle, text layout/cache, and text
// emission/measurement. Split out of `batch.rock`, which keeps the generic
// batch pools, geometry, ordering and flushing; this file calls into those
// (ensure_ui_batch, append_vertex, batch_key_of) and batch calls back only
// through `invalidate_text_batch_caches` and the `text_batch` batch key.
//
// Stays out on purpose: font loading and default-family resolution live in
// `stone/engine/font_resolve.rock`; text-art effects live in
// `stone/engine/ui/text_art.rock`.

// --- Unified text batching (per-font) ---
// One slot per loaded font, indexed by `font_id - 1` (matches the
// stone-rs 1-based font_id). init_text_batch_for() grows the vecs
// when a new font loads; queue_ui_text() reads from the slot keyed
// by the call's Font argument (or DEFAULT_FONT if omitted).
pub global FONT_ATLASES: [Image] = []
global FONT_PIXEL_SIZES: [int] = []
global FONT_CAP_HEIGHTS: [float] = []     // legacy per-font 'X' coverage height in atlas px
pub global FONT_UNIT_SIZES: [float] = []      // units_per_em; layout authority, never raster-rounded
pub global FONT_UNIT_CAP_HEIGHTS: [float] = []
pub global FONT_UNIT_ASCENTS: [float] = []
pub global FONT_UNIT_DESCENTS: [float] = []
pub global FONT_UNIT_LINE_GAPS: [float] = []
// Per font, then per FACE (Face::ALL order), then by text slot 0..127. An
// undeclared face's slice is empty: nothing substitutes regular for it.
pub global GLYPH_CACHES: [[[GlyphData]]] = []
pub global GLYPH_UNIT_CACHES: [[[GlyphUnitData]]] = []
// Per font: declared codepoint -> text slot, for codepoints outside the
// identity block. Published by stone-rs from the charset that baked the atlas
// rather than re-derived here, so one side owns what a slot means.
pub global FONT_CP_SLOTS: [Map<int, int>] = []
pub const UI_TEXT_Z_LAYER: int = 1            // default z_layer for batched text
global TEXT_LAYOUT_INSTANCE_GLYPH_SCRATCH: NativeBuffer<float> = native_buffer_float(9)
pub const TEXT_LAYOUT_INSTANCE_GLYPH_SCRATCH_ALLOCS: int = 0
pub global TEXT_LAYOUT_INSTANCE_GLYPH_FETCHES: int = 0
// How many times the raster geometry walked `Font` -> `FontData` (`Font.data`
// -> `Entity.get` -> the Session arena registry -> `arena_slot_live`). That
// walk is inlined into every trace that reaches a glyph loop, so the emitter
// owes one resolution per emitted string, not one per glyph corner.
pub global TEXT_LAYOUT_RASTER_FONT_RESOLVES: int = 0
pub global TEXT_LAYOUT_INSTANCE_CACHE_HITS: int = 0

pub value GlyphUnitData {
    left: float,
    top: float,
    width: float,
    height: float,
    advance: float,
    valid: bool,
}

value TextLineMetrics {
    ascent: float,
    descent: float,
    line_gap: float,
    line_height: float,
}

fn text_line_metrics(font_idx: int, scale_y: float) -> TextLineMetrics {
    if font_idx < 0 || font_idx >= FONT_UNIT_ASCENTS.len
        || font_idx >= FONT_UNIT_DESCENTS.len
        || font_idx >= FONT_UNIT_LINE_GAPS.len {
        return TextLineMetrics {
            ascent: 0.0,
            descent: 0.0,
            line_gap: 0.0,
            line_height: 0.0,
        }
    }
    let scale = abs(scale_y)
    let ascent = FONT_UNIT_ASCENTS[font_idx] * scale
    let descent = -FONT_UNIT_DESCENTS[font_idx] * scale
    let line_gap = FONT_UNIT_LINE_GAPS[font_idx] * scale
    return TextLineMetrics {
        ascent: ascent,
        descent: descent,
        line_gap: line_gap,
        line_height: ascent + descent + line_gap,
    }
}

// Per-font default-z text-batch cache; invalidate every entry (the pooled
// batch stays valid, but get_text_batch re-resolves through ensure_ui_batch's
// map hit -- no allocation either way).
pub fn invalidate_text_batch_caches() {
    let i = 0
    while i < TEXT_BATCH_CACHES.len {
        TEXT_BATCH_CACHES[i] = null
        TEXT_BATCH_POOLS[i] = null
        i = i + 1
    }
}

// --- Unified text batching functions ---

// Initialize per-font batch state. Called by load_font() in lib.rock
// after the FFI succeeds, so each loaded font automatically gets its
// atlas image, pixel size, and glyph cache populated. Grows the
// per-font vecs to font.backend_id and writes into the [backend_id - 1] slot.
//
// `atlas: false` is the metrics-only load (`load_font_metrics`): everything
// below still runs -- pixel size, font-unit metrics, codepoint slots, both
// glyph caches -- except the atlas page, because a metrics font owns no GL
// texture. That is ONE step skipped, not a second init: measurement and layout
// read the unit cache, so they are the same code on both paths.
fn init_text_batch_for(font: Font, atlas: bool = true) {
    let d = font.data() ?? return
    let idx = d.backend_id - 1

    // Grow each per-font vec to length backend_id, filling holes with
    // sentinel/empty values for fonts that haven't been loaded.
    // Multiple loads in order always append.
    while FONT_ATLASES.len <= idx {
        FONT_ATLASES.push(Image(0))
        FONT_PIXEL_SIZES.push(0)
        FONT_CAP_HEIGHTS.push(0.0)
        FONT_UNIT_SIZES.push(0.0)
        FONT_UNIT_CAP_HEIGHTS.push(0.0)
        FONT_UNIT_ASCENTS.push(0.0)
        FONT_UNIT_DESCENTS.push(0.0)
        FONT_UNIT_LINE_GAPS.push(0.0)
        GLYPH_CACHES.push([])
        GLYPH_UNIT_CACHES.push([])
        FONT_CP_SLOTS.push(map_new())
        TEXT_BATCH_CACHES.push(null)
        TEXT_BATCH_POOLS.push(null)
    }

    // The atlas is an Image like any other, so it registers -- but its filter
    // stays the font's own declaration (Font.sampling), not an image default.
    if atlas {
        FONT_ATLASES[idx] = register_image(stone_get_font_atlas_image_for(d.backend_id), d.sampling)
    }
    // Otherwise the slot keeps the Image(0) the growth loop above put there. A
    // metrics font that reached a draw would be refused by stone-rs by
    // name, so nothing here has to invent a texture for it.
    d.pixel_size = stone_get_font_pixel_size_for(d.backend_id)
    FONT_PIXEL_SIZES[idx] = d.pixel_size

    let font_units = native_buffer_float(5)
    if stone_get_font_unit_metrics(d.backend_id, font_units.ptr) {
        FONT_UNIT_SIZES[idx] = font_units[0]
        FONT_UNIT_ASCENTS[idx] = font_units[1]
        FONT_UNIT_DESCENTS[idx] = font_units[2]
        FONT_UNIT_LINE_GAPS[idx] = font_units[3]
        FONT_UNIT_CAP_HEIGHTS[idx] = font_units[4]
    } else {
        FONT_UNIT_SIZES[idx] = FONT_PIXEL_SIZES[idx] as float
        FONT_UNIT_CAP_HEIGHTS[idx] = FONT_PIXEL_SIZES[idx] as float
        FONT_UNIT_ASCENTS[idx] = FONT_PIXEL_SIZES[idx] as float
        FONT_UNIT_DESCENTS[idx] = 0.0
        FONT_UNIT_LINE_GAPS[idx] = 0.0
    }

    // Bulk-fetch every declared face's glyph infos (one FFI call each, done
    // once). An undeclared face gets an EMPTY slice rather than a run of invalid
    // entries, so asking for it is a distinguishable condition rather than a
    // string that measures zero.
    // The slot count and the codepoint mapping both come from stone-rs, which
    // owns the charset that baked the atlas: re-deriving either here would be a
    // second place that has to agree about what slot 128 means.
    let slot_count = stone_get_font_slot_count(d.backend_id)
    let cp_slots = map_new()
    // From 127, not 128: the identity block's own non-ASCII entry is published
    // like any other, so the only codepoint rule spelled out on this side is
    // the printable-ASCII range in text_glyph_slot.
    let slot = 127
    while slot < slot_count {
        let cp = stone_get_font_slot_codepoint(d.backend_id, slot)
        if cp >= 0 { cp_slots[cp] = slot }
        slot = slot + 1
    }
    FONT_CP_SLOTS[idx] = cp_slots

    let faces: [[GlyphData]] = []
    let face = 0
    while face < 4 {
        let glyphs: [GlyphData] = []
        if faces_declare(d.faces, face) {
            let i = 0
            while i < slot_count {
                let out = native_buffer_float(9)
                let g = if stone_get_glyph_info_for(d.backend_id, face, i, out.ptr) {
                    GlyphData {
                        u0: out[0], v0: out[1], u1: out[2], v1: out[3],
                        width: out[4], height: out[5],
                        bearing_x: out[6], bearing_y: out[7],
                        advance: out[8], valid: true,
                    }
                } else {
                    GlyphData {
                        u0: 0.0, v0: 0.0, u1: 0.0, v1: 0.0,
                        width: 0.0, height: 0.0, bearing_x: 0.0, bearing_y: 0.0,
                        advance: 0.0, valid: false
                    }
                }
                glyphs.push(g)
                i = i + 1
            }
        }
        faces.push(glyphs)
        face = face + 1
    }
    GLYPH_CACHES[idx] = faces
    let unit_faces: [[GlyphUnitData]] = []
    let unit_face = 0
    while unit_face < 4 {
        let units: [GlyphUnitData] = []
        if faces_declare(d.faces, unit_face) {
            let i = 0
            while i < slot_count {
                let out = native_buffer_float(5)
                let valid = stone_get_glyph_unit_metrics(d.backend_id, unit_face, i, out.ptr)
                units.push(
                    if valid {
                        GlyphUnitData {
                            left: out[0], top: out[1], width: out[2], height: out[3],
                            advance: out[4], valid: true,
                        }
                    } else {
                        GlyphUnitData {
                            left: 0.0, top: 0.0, width: 0.0, height: 0.0,
                            advance: 0.0, valid: false,
                        }
                    }
                )
                i = i + 1
            }
        }
        unit_faces.push(units)
        unit_face = unit_face + 1
    }
    GLYPH_UNIT_CACHES[idx] = unit_faces
    TEXT_BATCH_CACHES[idx] = null
    TEXT_BATCH_POOLS[idx] = null
    text_layout_cache_clear()
    text_prepare_cache_clear()
    let glyphs = faces[FACE_REGULAR]

    // Keep the coverage alias for diagnostics and old raster consumers. Layout
    // and FontData use the native face metric loaded above.
    let cap = glyphs[88].height
    if !glyphs[88].valid || cap <= 0.0 {
        cap = d.pixel_size as float
    }
    FONT_CAP_HEIGHTS[idx] = cap
    d.cap_height = FONT_UNIT_CAP_HEIGHTS[idx]
}

// Drop the per-font batch state for a backend_id. Called by
// unload_font() in lib.rock after the FFI unload, so the GLYPH_CACHES
// / FONT_ATLASES slot doesn't hold a stale Image handle. Doesn't
// shrink the vecs (slot reuse never happens; ids are monotonic).
fn drop_text_batch_for(backend_id: int) {
    let idx = backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len { return }
    FONT_ATLASES[idx] = Image(0)
    FONT_PIXEL_SIZES[idx] = 0
    FONT_CAP_HEIGHTS[idx] = 0.0
    FONT_UNIT_SIZES[idx] = 0.0
    FONT_UNIT_CAP_HEIGHTS[idx] = 0.0
    FONT_UNIT_ASCENTS[idx] = 0.0
    FONT_UNIT_DESCENTS[idx] = 0.0
    FONT_UNIT_LINE_GAPS[idx] = 0.0
    GLYPH_CACHES[idx] = []
    GLYPH_UNIT_CACHES[idx] = []
    FONT_CP_SLOTS[idx] = map_new()
    TEXT_BATCH_CACHES[idx] = null
    TEXT_BATCH_POOLS[idx] = null
    text_layout_cache_clear()
    text_prepare_cache_clear()
}

fn drop_all_text_batches() {
    let count = FONT_ATLASES.len
    for i in 0..count {
        drop_text_batch_for(i + 1)
    }
}

// Per-font default-z text-batch cache. Indexed by font_id - 1, invalidated
// each frame by clear_ui_batches().
//
// The cached batch belongs to ONE pool. A frame that mixes `pixel_screen.text`
// and `screen.text` at default z alternates the ambient UI pool, and a
// font-only cache would route whichever call came second into the batch the
// first one minted -- composite glyphs onto the window, or window glyphs into
// the composite. The last-(pool, batch) pair keeps the single-surface hot path
// exactly as cheap and makes a surface switch a miss rather than a wrong hit.
pub global TEXT_BATCH_CACHES: [Entity<RenderBatch>?] = []
global TEXT_BATCH_POOLS: [RenderBatchPool?] = []

pub fn get_text_batch(font: Font) -> RenderBatch {
    let d = font.data().unwrap()
    let idx = d.backend_id - 1
    if FONT_ATLASES[idx] == Image(0) {
        error("font {d.backend_id} text requested a font with no atlas")
    }
    let pool = current_ui_pool()
    if let cached = TEXT_BATCH_CACHES[idx] {
        let owner = TEXT_BATCH_POOLS[idx]
        if owner != null && render_batch_pool_same(owner.unwrap(), pool) {
            if let batch = cached.get() { return batch }
        }
    }

    let batch = ensure_ui_batch(sampled_image(FONT_ATLASES[idx]), RenderProps {
        z_layer: UI_TEXT_Z_LAYER,
        depth: DepthMode::Off,
        sampling: d.sampling,
        text_batch: true,
    })
    TEXT_BATCH_CACHES[idx] = batch.handle.entity().unwrap()
    TEXT_BATCH_POOLS[idx] = pool
    batch
}

fn __queue_text_quad(
    buf: NativeBuffer<Vertex>,
    vi: int,
    a: Vec2,
    b: Vec2,
    c: Vec2,
    d: Vec2,
    u1: float,
    v1: float,
    u2: float,
    v2: float,
    r: float,
    g: float,
    b_: float,
    alpha: float
) {
    buf[vi]     = vert(a.x, a.y, u1, v1, r, g, b_, alpha)
    buf[vi + 1] = vert(b.x, b.y, u2, v1, r, g, b_, alpha)
    buf[vi + 2] = vert(c.x, c.y, u2, v2, r, g, b_, alpha)
    buf[vi + 3] = vert(a.x, a.y, u1, v1, r, g, b_, alpha)
    buf[vi + 4] = vert(c.x, c.y, u2, v2, r, g, b_, alpha)
    buf[vi + 5] = vert(d.x, d.y, u1, v2, r, g, b_, alpha)
}

// The metric em the raster geometry scales by, plus the check that the layout
// can produce geometry at all. Separate from the geometry below because it is
// the only part that walks `Font` -> `FontData`, and that walk is loop
// invariant: one emitted string names one font. A glyph loop resolves it once
// and passes it to `text_layout_raster_rect_at`; resolving per glyph corner
// was four walks per glyph and 77% of every Font -> FontData resolution in a
// combat frame.
fn text_layout_metric_unit_size(layout: TextLayout, source_pixel_size: float) -> float {
    TEXT_LAYOUT_RASTER_FONT_RESOLVES += 1
    let font = layout.font
    if font == null { error("text raster geometry requires a live font") }
    let data = font.unwrap().data()
    if data == null { error("text raster geometry requires live font data") }
    let idx = data.unwrap().backend_id - 1
    if idx < 0 || idx >= FONT_UNIT_SIZES.len || source_pixel_size <= 0.0 {
        error("text raster geometry has invalid source metrics")
    }
    return FONT_UNIT_SIZES[idx]
}

// The ink rect, given the metric em the layout's font already resolved to.
fn text_layout_raster_rect_at(
    unit_size: float,
    layout: TextLayout,
    glyph_origin: Vec2,
    raw: GlyphData,
    source_pixel_size: float
) -> Rect {
    let metric_to_layout_x = unit_size
        * layout.raster_metric_scale_x / source_pixel_size
    let metric_to_layout_y = unit_size
        * abs(layout.raster_metric_scale_y) / source_pixel_size
    return rect(
        glyph_origin.x + raw.bearing_x * metric_to_layout_x,
        glyph_origin.y - raw.bearing_y * metric_to_layout_y,
        raw.width * abs(metric_to_layout_x),
        raw.height * metric_to_layout_y)
}

// Resolving entry point for callers outside a glyph loop.
pub fn text_layout_raster_rect(
    layout: TextLayout,
    glyph_origin: Vec2,
    raw: GlyphData,
    source_pixel_size: float
) -> Rect {
    return text_layout_raster_rect_at(
        text_layout_metric_unit_size(layout, source_pixel_size),
        layout, glyph_origin, raw, source_pixel_size)
}

// One corner of a glyph quad from its ink rect. The four corners of a glyph
// share the rect, so a loop builds the rect once and asks for each corner.
fn text_layout_pose_corner(
    ink: Rect,
    glyph_pivot: Vec2,
    pose: GlyphPose?,
    origin: Vec2,
    corner: int,
    layout_scale: float = 1.0
) -> Vec2 {
    let point = if corner == 0 {
        v(ink.x, ink.y)
    } else if corner == 1 {
        v(ink.x + ink.w, ink.y)
    } else if corner == 2 {
        v(ink.x + ink.w, ink.y + ink.h)
    } else {
        v(ink.x, ink.y + ink.h)
    }
    return text_layout_pose_point(glyph_pivot, point, pose) * layout_scale + origin
}

pub fn text_layout_raster_quad_point(
    layout: TextLayout,
    glyph_origin: Vec2,
    glyph_pivot: Vec2,
    raw: GlyphData,
    source_pixel_size: float,
    pose: GlyphPose?,
    origin: Vec2,
    corner: int
) -> Vec2 {
    let ink = text_layout_raster_rect(layout, glyph_origin, raw, source_pixel_size)
    return text_layout_pose_corner(ink, glyph_pivot, pose, origin, corner)
}

pub fn text_layout_instance_glyph(
    instance_id: int,
    face: int,
    glyph: int
) -> bool {
    TEXT_LAYOUT_INSTANCE_GLYPH_FETCHES += 1
    let out = TEXT_LAYOUT_INSTANCE_GLYPH_SCRATCH
    let found = stone_get_font_instance_glyph_info(instance_id, face, glyph, out.ptr)
    return found
}

pub fn text_layout_instance_glyph_data() -> GlyphData {
    let out = TEXT_LAYOUT_INSTANCE_GLYPH_SCRATCH
    return GlyphData {
        u0: out[0], v0: out[1], u1: out[2], v1: out[3],
        width: out[4], height: out[5], bearing_x: out[6], bearing_y: out[7],
        advance: out[8], valid: true,
    }
}

const TEXT_LAYOUT_INSTANCE_GLYPH_STRIDE: int = 10

fn text_layout_instance_glyph_cache_prepare(layout: TextLayout, instance_id: int) {
    let expected = layout.glyphs.len * TEXT_LAYOUT_INSTANCE_GLYPH_STRIDE
    if layout.instance_glyph_id == instance_id
        && layout.instance_glyph_data != null
        && layout.instance_glyph_data.unwrap().len == expected { return () }
    // A layout drawn at an animated scale can move between atlas instances;
    // the per-glyph rows keep their shape, so refill the owned buffer.
    let cached = if layout.instance_glyph_data != null
        && layout.instance_glyph_data.unwrap().len == expected {
        layout.instance_glyph_data.unwrap()
    } else { native_buffer_float(expected) }
    for i in 0..layout.glyphs.len {
        let base = i * TEXT_LAYOUT_INSTANCE_GLYPH_STRIDE
        let glyph = layout.glyphs[i]
        let found = text_layout_instance_glyph(instance_id, glyph.face, glyph.glyph)
        cached[base] = if found { 1.0 } else { 0.0 }
        if found {
            let raw = TEXT_LAYOUT_INSTANCE_GLYPH_SCRATCH
            for j in 0..9 { cached[base + 1 + j] = raw[j] }
        }
    }
    layout.instance_glyph_id = instance_id
    layout.instance_glyph_data = cached
}

fn text_layout_instance_glyph_cached(data: NativeBuffer<float>, index: int) -> GlyphData {
    let base = index * TEXT_LAYOUT_INSTANCE_GLYPH_STRIDE + 1
    return GlyphData {
        u0: data[base], v0: data[base + 1], u1: data[base + 2], v1: data[base + 3],
        width: data[base + 4], height: data[base + 5],
        bearing_x: data[base + 6], bearing_y: data[base + 7],
        advance: data[base + 8], valid: true,
    }
}


fn text_layout_emit_instance(
    batch: RenderBatch,
    layout: TextLayout,
    origin: Vec2,
    color: Color,
    instance_id: int,
    poses: [GlyphPose]?,
    probe_text: string = "",
    probe_consumer_key: string = "",
    probe_admitted_count: int = -1,
    probe_layout_glyph_count: int = -1,
    probe_layout_ink_bounds: Rect = rect(0.0, 0.0, 0.0, 0.0),
    layout_scale: float = 1.0
) -> bool {
    profile_begin("text.emit.glyphs")
    let before = batch.count
    let emitted_count = 0
    let emitted_bounds = rect(0.0, 0.0, 0.0, 0.0)
    let source_pixel_size = if layout.instance_cached_id == instance_id
        && layout.instance_cached_pixel_size > 0 {
        layout.instance_cached_pixel_size
    } else { stone_get_font_instance_pixel_size_ffi(instance_id) }
    text_layout_instance_glyph_cache_prepare(layout, instance_id)
    let cached_glyphs = layout.instance_glyph_data
    let unit_size = 0.0
    let unit_size_ready = false
    for i in 0..layout.glyphs.len {
        let glyph_origin = layout.glyphs[i].origin
        let glyph_pivot = layout.glyphs[i].pivot
        let data = cached_glyphs.unwrap()
        if data[i * TEXT_LAYOUT_INSTANCE_GLYPH_STRIDE] == 0.0 { continue }
        let raw = text_layout_instance_glyph_cached(data, i)
        let pose = text_layout_pose_at(layout, i, poses)
        if !unit_size_ready {
            unit_size = text_layout_metric_unit_size(layout, source_pixel_size)
            unit_size_ready = true
        }
        let ink = text_layout_raster_rect_at(unit_size, layout, glyph_origin,
            raw, source_pixel_size)
        let a = text_layout_pose_corner(ink, glyph_pivot, pose, origin, 0, layout_scale)
        let b = text_layout_pose_corner(ink, glyph_pivot, pose, origin, 1, layout_scale)
        let c = text_layout_pose_corner(ink, glyph_pivot, pose, origin, 2, layout_scale)
        let d = text_layout_pose_corner(ink, glyph_pivot, pose, origin, 3, layout_scale)
        __queue_text_quad(batch.verts, batch.count, a, b, c, d,
            raw.u0, raw.v0, raw.u1, raw.v1,
            color.r, color.g, color.b, color.a)
        if probe_text != "" || UI_SUBMISSION_PROBE_ON {
            let observed = batch.verts[batch.count].pos.to_f64()
            let lo = observed
            let hi = observed
            for j in 1..6 {
                let p = batch.verts[batch.count + j].pos
                lo = v(min(lo.x, p.x), min(lo.y, p.y))
                hi = v(max(hi.x, p.x), max(hi.y, p.y))
            }
            emitted_bounds = text_layout_emission_bounds_union(
                emitted_bounds, rect(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y))
            emitted_count += 1
        }
        if UI_SUBMISSION_PROBE_ON {
            UI_SUBMISSION_PROBE_GLYPH_HOOK.unwrap()(batch, layout, layout.glyphs[i], pose,
                origin, instance_id, raw, layout_scale)
        }
        batch.count += 6
    }
    if probe_text != "" || UI_SUBMISSION_PROBE_ON {
        let probe_demand = text_layout_raster_demand(layout, null, layout_scale)
        let source_cap_height = 0.0
        if layout.font != null {
            let font = layout.font.unwrap()
            let data = font.data()
            if data != null {
                source_cap_height = source_pixel_size as float
                    * text_art_font_cap_height_ratio(font)
            }
        }
        let value = TextLayoutEmissionProbe {
            frame: RENDER_FRAME,
            retained_text: probe_text,
            admitted_count: if probe_admitted_count < 0 {
                layout.admitted_count
            } else { probe_admitted_count },
            layout_glyph_count: if probe_layout_glyph_count < 0 {
                layout.glyphs.len
            } else { probe_layout_glyph_count },
            emitted_count: emitted_count,
            instance_id: instance_id,
            consumer_key: probe_consumer_key,
            origin: origin,
            logical_bounds: text_rect_scaled(layout.logical_bounds, layout_scale),
            layout_ink_bounds: text_rect_scaled(if probe_admitted_count < 0 {
                layout.ink_bounds
            } else { probe_layout_ink_bounds }, layout_scale),
            emitted_bounds: emitted_bounds,
            target_pixel_cap_height: probe_demand.target_pixel_cap_height,
            required_pixel_em: probe_demand.required_pixel_em,
            selected_pixel_em: source_pixel_size,
            source_cap_height: source_cap_height,
        }
        if probe_text != "" {
            text_layout_emission_probe_record(value)
        }
        if UI_SUBMISSION_PROBE_ON { UI_SUBMISSION_PROBE_TEXT_HOOK.unwrap()(value, layout.text) }
    }
    let emitted = batch.count > before
    profile_end("text.emit.glyphs")
    return emitted
}

fn text_layout_pose_max_scale(poses: [GlyphPose]?) -> float {
    if poses == null { return 1.0 }
    let largest = 1.0
    for pose in poses.unwrap() {
        largest = max(largest, max(abs(pose.scale.x), abs(pose.scale.y)))
    }
    return largest
}

fn text_rect_scaled(r: Rect, k: float) -> Rect {
    if k == 1.0 { return r }
    return rect(r.x * k, r.y * k, r.w * k, r.h * k)
}

// `layout_scale` is a whole-layout scale applied at emission (see
// ResolvedTextRun.draw_scale); the demand follows the drawn size so the same
// atlas instance is chosen as for a layout built at that size.
pub fn text_layout_raster_demand(layout: TextLayout, poses: [GlyphPose]?,
    layout_scale: float = 1.0) -> TextArtRasterDemand {
    let pose_scale = text_layout_pose_max_scale(poses)
    let coverage_oversampling = font_coverage_oversampling_require(
        layout.coverage_oversampling)
    let target = layout.raster_target_cap_height * layout_scale * pose_scale
        * coverage_oversampling
    let footprint = v(layout.logical_bounds.w, layout.logical_bounds.h) * layout_scale
    let font = layout.font ?? return TextArtRasterDemand {
        glyph_population: layout.admitted_count,
        target_footprint: footprint,
        source_footprint: v(),
        authored_cap_height: layout.raster_authored_cap_height,
        layout_to_target_scale: layout.raster_layout_to_target_scale,
        physical_target_scale: layout.raster_physical_target_scale,
        max_pose_scale: pose_scale,
        coverage_oversampling: coverage_oversampling,
        target_pixel_cap_height: target,
        required_pixel_em: 0.0,
        coverage_bucket: 0,
    }
    let required_pixel_em = if target > 0.0 {
        text_art_required_pixel_em_for(font, target)
    } else { 0.0 }
    return TextArtRasterDemand {
        glyph_population: layout.admitted_count,
        target_footprint: footprint,
        source_footprint: v(),
        authored_cap_height: layout.raster_authored_cap_height,
        layout_to_target_scale: layout.raster_layout_to_target_scale,
        physical_target_scale: layout.raster_physical_target_scale,
        max_pose_scale: pose_scale,
        coverage_oversampling: coverage_oversampling,
        target_pixel_cap_height: target,
        required_pixel_em: required_pixel_em,
        coverage_bucket: if required_pixel_em > 0.0 {
            text_art_coverage_bucket_for_ppem(required_pixel_em)
        } else { 0 },
    }
}

pub fn text_layout_emit(
    layout: TextLayout,
    origin: Vec2,
    color: Color,
    z_layer: int,
    poses: [GlyphPose]? = null,
    consumer_key: string = "",
    layout_scale: float = 1.0
) -> bool {
    TEXT_LAYOUT_EMIT_CALLS += 1
    let font = layout.font ?? return false
    let fd = font.data() ?? return false
    if layout.glyphs.len == 0 { return false }
    if poses != null { text_layout_validate_poses(layout, poses.unwrap()) }
    let probe_text = text_layout_probe_text(layout)
    let probe_admitted_count = layout.admitted_count
    let probe_layout_glyph_count = layout.glyphs.len
    let probe_layout_ink_bounds = layout.ink_bounds
    let cache_instance = poses == null && consumer_key == "" && layout_scale == 1.0
    let instance_id = 0
    let image = 0
    if cache_instance && layout.instance_cached_id > 0 {
        TEXT_LAYOUT_INSTANCE_CACHE_HITS += 1
        profile_begin("text.layout.raster_demand")
        profile_end("text.layout.raster_demand")
        profile_begin("text.art.atlas_lookup")
        profile_end("text.art.atlas_lookup")
        instance_id = layout.instance_cached_id
        image = layout.instance_cached_image
    } else {
        profile_begin("text.layout.raster_demand")
        let demand = text_layout_raster_demand(layout, poses, layout_scale)
        profile_end("text.layout.raster_demand")
        profile_begin("text.art.atlas_lookup")
        let instance = text_art_atlas_instance_for(font, demand, consumer_key)
        profile_end("text.art.atlas_lookup")
        instance_id = instance.instance_id
        image = stone_get_font_instance_image_ffi(instance_id)
        if cache_instance {
            layout.instance_cached_id = instance_id
            layout.instance_cached_pixel_size = instance.pixel_size
            layout.instance_cached_image = image
        }
    }
    TEXT_ART_COVERAGE_EMIT_CALLS = TEXT_ART_COVERAGE_EMIT_CALLS + 1
    if image == 0 { error("TextLayout atlas instance {instance_id} has no GL image") }
    profile_begin("text.batch.lookup")
    let batch = ensure_ui_batch(sampled_image(Image(image)), RenderProps {
        z_layer: z_layer,
        depth: DepthMode::Off,
        sampling: fd.sampling,
        pipeline: null,
        text_batch: true,
    })
    profile_end("text.batch.lookup")
    reserve_vertices(batch, layout.glyphs.len * 6)
    return text_layout_emit_instance(
        batch, layout, origin, color, instance_id, poses,
        probe_text: probe_text, probe_consumer_key: consumer_key,
        probe_admitted_count: probe_admitted_count,
        probe_layout_glyph_count: probe_layout_glyph_count,
        probe_layout_ink_bounds: probe_layout_ink_bounds,
        layout_scale: layout_scale)
}


fn text_layout_emit_world_instance(
    batch: RenderBatch,
    layout: TextLayout,
    baseline: Vec2,
    color: Color,
    instance_id: int,
    poses: [GlyphPose]?
) -> bool {
    let before = batch.count
    // `source_pixel_size` below is a function of `instance_id` alone, so the
    // metric em it validates is loop invariant too.
    let unit_size = 0.0
    let unit_size_ready = false
    for i in 0..layout.glyphs.len {
        let glyph_face = layout.glyphs[i].face
        let glyph_id = layout.glyphs[i].glyph
        let glyph_origin = layout.glyphs[i].origin
        let glyph_pivot = layout.glyphs[i].pivot
        if !text_layout_instance_glyph(instance_id, glyph_face, glyph_id) { continue }
        let raw = text_layout_instance_glyph_data()
        if raw.height <= 0.0 { continue }
        let pose = text_layout_pose_at(layout, i, poses)
        let line_y = glyph_origin.y - layout.ascent
        let source_pixel_size = stone_get_font_instance_pixel_size_ffi(instance_id)
        if !unit_size_ready {
            unit_size = text_layout_metric_unit_size(layout, source_pixel_size)
            unit_size_ready = true
        }
        let ink = text_layout_raster_rect_at(unit_size, layout, glyph_origin,
            raw, source_pixel_size)
        let a0 = text_layout_pose_corner(ink, glyph_pivot, pose, v(), 0)
        let b0 = text_layout_pose_corner(ink, glyph_pivot, pose, v(), 1)
        let c0 = text_layout_pose_corner(ink, glyph_pivot, pose, v(), 2)
        let d0 = text_layout_pose_corner(ink, glyph_pivot, pose, v(), 3)
        let a = v(baseline.x + a0.x,
            baseline.y + 2.0 * line_y + layout.ascent - a0.y)
        let b = v(baseline.x + b0.x,
            baseline.y + 2.0 * line_y + layout.ascent - b0.y)
        let c = v(baseline.x + c0.x,
            baseline.y + 2.0 * line_y + layout.ascent - c0.y)
        let d = v(baseline.x + d0.x,
            baseline.y + 2.0 * line_y + layout.ascent - d0.y)
        batch.verts[batch.count + 0] = make_world_text_vertex(
            a.x, a.y, raw.u0, raw.v0, color, baseline.y)
        batch.verts[batch.count + 1] = make_world_text_vertex(
            d.x, d.y, raw.u0, raw.v1, color, baseline.y)
        batch.verts[batch.count + 2] = make_world_text_vertex(
            c.x, c.y, raw.u1, raw.v1, color, baseline.y)
        batch.verts[batch.count + 3] = make_world_text_vertex(
            a.x, a.y, raw.u0, raw.v0, color, baseline.y)
        batch.verts[batch.count + 4] = make_world_text_vertex(
            c.x, c.y, raw.u1, raw.v1, color, baseline.y)
        batch.verts[batch.count + 5] = make_world_text_vertex(
            b.x, b.y, raw.u1, raw.v0, color, baseline.y)
        batch.count += 6
    }
    return batch.count > before
}

fn text_layout_emit_world(
    layout: TextLayout,
    baseline: Vec2,
    z_layer: int,
    depth: DepthMode,
    color: Color,
    poses: [GlyphPose]? = null
) -> bool {
    let data = layout.font ?? return false
    let fd = data.data() ?? return false
    let idx = fd.backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len || layout.glyphs.len == 0 { return false }
    if poses != null { text_layout_validate_poses(layout, poses.unwrap()) }
    profile_begin("text.layout.raster_demand")
    let demand = text_layout_raster_demand(layout, poses)
    profile_end("text.layout.raster_demand")
    profile_begin("text.art.atlas_lookup")
    let instance = text_art_atlas_instance_for(data, demand)
    profile_end("text.art.atlas_lookup")
    let image = stone_get_font_instance_image_ffi(instance.instance_id)
    if image == 0 { error("world text atlas instance {instance.instance_id} has no GL image") }
    profile_begin("text.batch.lookup")
    let batch = ensure_world_sprite_batch(
        sampled_image(Image(image)), z_layer, BlendMode::Alpha, false,
        depth, unlit: true, sampling: fd.sampling, text_batch: true)
    profile_end("text.batch.lookup")
    reserve_vertices(batch, layout.glyphs.len * 6)
    profile_begin("text.emit.glyphs")
    let emitted = text_layout_emit_world_instance(
        batch, layout, baseline, color, instance.instance_id, poses)
    profile_end("text.emit.glyphs")
    return emitted
}

// Push screen-space text into UI_RENDER_BATCHES.
//
// `z_layer` defaults to the engine's UI_TEXT_Z_LAYER (1) and uses the
// cached text-batch fast path. Pass an explicit z to land text in a
// different z-bucket (e.g. an overlay above other UI). Non-default z
// goes through a fresh `ensure_ui_batch` per call site so the cache
// stays valid for the common path. Caller-driven z lets callers stack
// arbitrary screen-space content above text without an imgui escape hatch.
pub fn queue_ui_text(
    text: string,
    pos: Vec2,
    size: float,
    color: Color,
    offset: Vec2,
    z_layer: int = UI_TEXT_Z_LAYER
) {
    let f = DEFAULT_FONT ?? return
    queue_ui_text_with_font(f, text, pos, size, color, offset, z_layer)
}

// Per-font variant. Use directly when rendering with a font other
// than DEFAULT_FONT (e.g. a custom font loaded via load_font()).
pub fn queue_ui_text_with_font(
    font: Font,
    text: string,
    pos: Vec2,
    size: float,
    color: Color,
    offset: Vec2,
    z_layer: int = UI_TEXT_Z_LAYER
) {
    queue_ui_text_scaled(font, text, pos, size, color, offset, z_layer,
        FONT_RENDER_SCALE, TextAlign::TopLeft, text_output_raster_density())
}

// Screen coordinates supplied directly in output pixels do not belong to the
// design-space text path. Keep the atlas demand physical-density aware, but
// leave the emitted glyph geometry in the caller's pixel space.
fn queue_ui_text_output_px(
    font: Font,
    text: string,
    pos: Vec2,
    size: float,
    color: Color,
    offset: Vec2,
    z_layer: int = UI_TEXT_Z_LAYER
) {
    queue_ui_text_scaled(font, text, pos, size, color, offset, z_layer,
        1.0, TextAlign::TopLeft, text_output_raster_density())
}

pub fn text_output_raster_density() -> float {
    let view = RENDER_VIEW ?? return 1.0
    return max(
        0.0001,
        view.ui_raster_size.y as float
        / max(view.logical_size.y, 1.0)
    )
}

fn world_text_scene_density() -> float {
    let view = RENDER_VIEW ?? return 1.0
    return max(0.0001, view.world_to_scene_scale)
}

// The size divisor for a font: cap height when CAP_HEIGHT_FONTS is on (so the
// same number is the same visible height across fonts), else the em. 0 = the
// font has no usable metrics yet.
pub fn font_size_divisor(idx: int) -> float {
    if idx < 0 || idx >= FONT_UNIT_SIZES.len { return 0.0 }
    return if CAP_HEIGHT_FONTS { FONT_UNIT_CAP_HEIGHTS[idx] } else { FONT_UNIT_SIZES[idx] }
}

// Family-aware callers delegate to the same native unit metric authority.
pub fn font_size_divisor(font: Font) -> float {
    let d = font.data() ?? return 0.0
    return font_size_divisor(d.backend_id - 1)
}

fn text_layout_raster_cap_for_scale(font: Font, scale_y: float) -> float {
    let d = font.data() ?? return abs(scale_y)
    let idx = d.backend_id - 1
    if idx >= 0 && idx < FONT_UNIT_CAP_HEIGHTS.len {
        let cap = FONT_UNIT_CAP_HEIGHTS[idx]
        if cap > 0.0 { return abs(scale_y) * cap }
    }
    return abs(scale_y)
}

// Target-space extent of `text`, measured with the SAME divisor and design->
// target factor the emitter below uses -- so a caller that positions by
// measurement cannot disagree with the glyphs. `render_scale` is the calling
// context's factor: FONT_RENDER_SCALE for output-authored text, the context
// scale for a scene-target UiRect, 1.0 for raw Target coordinates. Density
// defaults to 1 for source footprints; output measurement passes its density.
pub fn measure_text_of(font: Font, text: string, size: float, render_scale: float,
    raster_density: float = 1.0) -> Vec2 {
    let d = font.data() ?? return v()
    let idx = d.backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len || idx >= GLYPH_CACHES.len
        || GLYPH_CACHES[idx].len <= FACE_REGULAR
        || GLYPH_CACHES[idx][FACE_REGULAR].len == 0
        || font_size_divisor(idx) <= 0.0 { return v() }
    let layout = text_layout_cached(font, text, size, render_scale,
        TextAlign::TopLeft, raster_density)
    return v(layout.logical_bounds.w, layout.logical_bounds.h)
}

// --- The shared target-space glyph core ---
//
// Byte admission, glyph lookup, advance, bearing, scale and baseline placement
// live here once. Plain and rich callers retain the same layout facts while
// choosing their own color, face and surface conventions.

// The codepoint whose encoding STARTS at unit `i`. Two distinct refusals, so
// a rejection surface can tell them apart: -1 means `i` is not a lead unit (a
// UTF-8 continuation byte, a UTF-16 trail surrogate) and is skipped by every
// walker, while -2 means the unit STARTS a sequence that is malformed or
// truncated, which is a real defect in the text. Walking units one at a time
// and skipping -1 is what lets the byte-range loops below stand unchanged over
// multi-unit text: a non-lead unit is simply not the start of anything.
pub inline(lua) fn text_codepoint_at(text: string, i: int) -> int = """
    local b = string.byte(text, i + 1)
    if b == nil then return -1 end
    if b < 0x80 then return b end
    if b < 0xC0 then return -1 end
    local n, cp
    if b < 0xE0 then n, cp = 1, b - 0xC0
    elseif b < 0xF0 then n, cp = 2, b - 0xE0
    elseif b < 0xF8 then n, cp = 3, b - 0xF0
    else return -2 end
    for k = 1, n do
        local c = string.byte(text, i + 1 + k)
        if c == nil or c < 0x80 or c > 0xBF then return -2 end
        cp = cp * 64 + (c - 0x80)
    end
    return cp
"""

pub fn text_glyph_slot(cp_slots: Map<int, int>, text: string, i: int) -> int {
    let cp = text_codepoint_at(text, i)
    if cp < 0 { return -1 }
    if cp >= 32 && cp <= 126 { return cp }
    return cp_slots.get(cp) ?? -1
}

pub value TextGlyph {
    glyph_index: int,
    source_index: int,
    glyph: int,
    face: int,
    origin: Vec2,
    ink: Rect,
    advance: float,
    pivot: Vec2,
}

// Advance, max ascent and max glyph height of `text[from..to)` at `scale`.
pub fn measure_text_range(
    glyphs: [GlyphData],
    cp_slots: Map<int, int>,
    text: string,
    from: int,
    to: int,
    scale: float
) -> (float, float, float) {
    let advance = 0.0
    let max_ascent = 0.0
    let max_glyph_h = 0.0
    for i in from..to {
        let slot = text_glyph_slot(cp_slots, text, i)
        if slot < 0 { continue }
        let g = glyphs[slot]
        if !g.valid { continue }
        advance = advance + g.advance * scale
        let a = g.bearing_y * scale
        if a > max_ascent { max_ascent = a }
        let gh = g.height * scale
        if gh > max_glyph_h { max_glyph_h = gh }
    }
    return (advance, max_ascent, max_glyph_h)
}

pub nobox value TextFlowMetrics {
    font: Font,
    index: int,
    face: int,
    scale: float,
    ascent: float,
    below: float,
    plain: bool,
}

fn text_flow_paragraph_text(text: string) -> string {
    if text.find("\n") < 0 { return text }
    // Removing a newline first could join two malformed UTF-8 halves into a
    // valid glyph. Admit the original bytes before normalizing controls.
    for i in 0..text.len() {
        if text_codepoint_at(text, i) == -2 {
            error("ui_rich_flow: byte at offset {i} begins a malformed glyph")
        }
    }
    return text.replace("\n", "")
}

pub fn text_flow_metrics(font: Font, text: string, style: TextStyle,
                         size: float, render_scale: float, plain: bool = false) -> TextFlowMetrics {
    let site = "ui_rich_flow"
    let idx = text_family_font_idx(font, site, require_atlas: false)
    let face = FACE_REGULAR
    if !plain {
        let admitted = text_flow_paragraph_text(text)
        let prepared = text_prepare_missing_glyphs(font, null, idx, admitted, site)
        face = text_validate_single_font_span(font, idx, prepared, style, true, site)
    } else if TEXT_MISSING_GLYPH_POLICY == TextMissingGlyphPolicy::Substitute {
        // Plain rendering tolerates malformed bytes; preparation logs missing
        // codepoints, while the advance walk keeps the authored byte ranges.
        let _ = text_prepare_missing_glyphs(font, null, idx, text, site)
    }
    if !plain && (text.find("\r") >= 0 || text.find("\t") >= 0) {
        error("ui_rich_flow: carriage return and tab are not paragraph controls")
    }
    let scale = size * render_scale / font_size_divisor(idx)
    let metrics = text_line_metrics(idx, scale)
    return TextFlowMetrics { font, index: idx, face: max(face, 0), scale,
        ascent: metrics.ascent, below: metrics.line_height - metrics.ascent, plain }
}

// Keep the renderer's glyph-addition order, including spaces. Adding a measured
// word to a measured prefix can round to the other side of a wrap boundary.
pub fn text_flow_advance(metrics: TextFlowMetrics, text: string,
                         start: int, end: int, pen: float) -> float {
    let result = pen
    let glyphs = GLYPH_UNIT_CACHES[metrics.index][metrics.face]
    for i in start..end {
        let cp = text_codepoint_at(text, i)
        if cp < 0 || cp == 10 || (metrics.plain && (cp == 13 || cp == 9)) { continue }
        let slot = if cp >= 32 && cp <= 126 { cp }
            else { FONT_CP_SLOTS[metrics.index].get(cp) ?? -1 }
        if slot < 0 || slot >= glyphs.len || !glyphs[slot].valid {
            if metrics.plain && TEXT_MISSING_GLYPH_POLICY == TextMissingGlyphPolicy::Reject { continue }
            slot = text_glyph_slot(FONT_CP_SLOTS[metrics.index], "?", 0)
        }
        result += glyphs[slot].advance * metrics.scale
    }
    return result
}

pub fn text_flow_validate_family(fonts: [Font], indices: [int], text: string,
                                  style: TextStyle, size: float, render_scale: float) {
    let runs: [ResolvedTextRun] = []
    text_resolve_segment(runs, fonts, indices, text_flow_paragraph_text(text), size,
        render_scale, false, style, true, "ui_rich_flow")
}

// The family resolver remains the glyph owner. Layout needs only advances and
// line metrics, so it never allocates per-glyph runs or prefix layouts.
pub fn text_flow_family_advance(indices: [int], style: TextStyle,
                                text: string, start: int, end: int,
                                size: float, render_scale: float, pen: float)
                                -> (float, float, float) {
    let result = pen
    let ascent = 0.0
    let below = 0.0
    let selected = -1
    let run = 0.0
    for i in start..end {
        let cp = text_codepoint_at(text, i)
        if cp < 0 { continue }
        let owner = text_select_font(indices, text, i)
        let glyph_text = text
        let at = i
        if owner < 0 {
            glyph_text = "?"
            at = 0
            owner = text_select_font(indices, glyph_text, at)
        }
        if owner != selected { result += run; run = 0.0; selected = owner }
        let idx = indices[owner]
        let face = style_face_index(style)
        let scale = size * render_scale / font_size_divisor(idx)
        let slot = text_glyph_slot(FONT_CP_SLOTS[idx], glyph_text, at)
        run += GLYPH_UNIT_CACHES[idx][face][slot].advance * scale
        let metrics = text_line_metrics(idx, scale)
        ascent = max(ascent, metrics.ascent)
        below = max(below, metrics.line_height - metrics.ascent)
    }
    return (result + run, ascent, below)
}

pub struct TextLayout {
    font: Font?,
    text: string,
    face: int,
    glyphs: FlatVec<TextGlyph>,
    logical_bounds: Rect,
    ink_bounds: Rect,
    ascent: float,
    descent: float,
    line_height: float,
    line_count: int,
    admitted_count: int,
    alignment: TextAlign,
    alignment_offset: Vec2,
    raster_authored_cap_height: float,
    raster_layout_to_target_scale: float,
    raster_physical_target_scale: float,
    raster_target_cap_height: float,
    coverage_oversampling: float,
    raster_metric_scale_x: float,
    raster_metric_scale_y: float,
    instance_glyph_id: int,
    instance_glyph_data: NativeBuffer<float>?,
    instance_cached_id: int,
    instance_cached_pixel_size: int,
    instance_cached_image: int,
}

pub const TEXT_LAYOUT_CACHE_CAPACITY: int = 256

struct TextLayoutCacheEntry {
    font_id: int,
    text: string,
    size: float,
    render_scale: float,
    scale_x: float,
    scale_y: float,
    world_raster: bool,
    cap_height_fonts: bool,
    align: TextAlign,
    raster_physical_target_scale: float,
    // text_layout_variant_key of the fields above; the index slot this entry
    // occupies under its text.
    variant: int,
    // Next resident slot sharing this text/variant key, or -1 at chain end.
    next_variant_slot: int,
    last_used: int,
    layout: TextLayout,
}

global TEXT_LAYOUT_CACHE: [TextLayoutCacheEntry] = []
global TEXT_LAYOUT_CACHE_CLOCK: int = 0
// text -> variant key -> TEXT_LAYOUT_CACHE slot. Two map reads replace a probe
// over every cached variant of the text: that loop kept all seven request
// parameters plus the probe state live across its exits and was a standing
// "register coalescing too complex" abort in every text-heavy frame.
global TEXT_LAYOUT_CACHE_INDEX: Map<string, Map<int, int>> = map_new()
pub global TEXT_LAYOUT_CACHE_HITS: int = 0
pub global TEXT_LAYOUT_CACHE_INDEX_HITS: int = 0
global TEXT_LAYOUT_CACHE_REQUESTS: int = 0
global TEXT_LAYOUT_CACHE_MISSES: int = 0
pub global TEXT_LAYOUT_CACHE_BUILDS: int = 0
global TEXT_LAYOUT_CACHE_EVICTIONS: int = 0
global TEXT_LAYOUT_CACHE_ENTRIES_EXAMINED: int = 0
