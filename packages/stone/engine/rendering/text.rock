// Text owner: font projection lifecycle, text layout/cache, and text
// emission/measurement. Split out of `batch.rock`, which keeps the generic
// batch pools, geometry, ordering and flushing; this file calls into those
// (ensure_ui_batch, append_vertex, batch_key_of) and batch calls back only
// through the `text_batch` batch key.
//
// Stays out on purpose: font loading and default-family resolution live in
// `stone/engine/font_resolve.rock`; text-art effects live in
// `stone/engine/ui/text_art.rock`.

// Per-font slots are indexed by `font_id - 1` (stone-rs font ids are 1-based).
pub global FONT_ATLASES: [Image] = []
global FONT_PIXEL_SIZES: [int] = []
global FONT_CAP_HEIGHTS: [float] = []     // legacy per-font 'X' coverage height in atlas px
pub global FONT_UNIT_SIZES: [float] = []      // units_per_em; layout authority, never raster-rounded
pub global FONT_UNIT_CAP_HEIGHTS: [float] = []
pub global FONT_UNIT_ASCENTS: [float] = []
pub global FONT_UNIT_DESCENTS: [float] = []
pub global FONT_UNIT_LINE_GAPS: [float] = []
pub global GLYPH_CACHES: [[[GlyphData]]] = []
pub global GLYPH_UNIT_CACHES: [[[GlyphUnitData]]] = []
pub global FONT_CP_SLOTS: [Map<int, int>] = []
pub const UI_TEXT_Z_LAYER: int = 1            // default z_layer for batched text
global TEXT_LAYOUT_INSTANCE_GLYPH_SCRATCH: NativeBuffer<float> = native_buffer_float(9)
pub global TEXT_LAYOUT_INSTANCE_GLYPH_FETCHES: int = 0
// How many times the raster geometry walked `Font` -> `FontData` (`Font.data`
// -> `Entity.get` -> the Session arena registry -> `arena_slot_live`). That
// walk is inlined into every trace that reaches a glyph loop, so the emitter
// owes one resolution per emitted string, not one per glyph corner.
pub global TEXT_LAYOUT_RASTER_FONT_RESOLVES: int = 0
pub global TEXT_LAYOUT_INSTANCE_CACHE_HITS: int = 0

pub value GlyphUnitData {
    left: float,
    top: float,
    width: float,
    height: float,
    advance: float,
    valid: bool,
}

value TextLineMetrics {
    ascent: float,
    descent: float,
    line_gap: float,
    line_height: float,
}

fn text_line_metrics(font_idx: int, scale_y: float) -> TextLineMetrics {
    if font_idx < 0 || font_idx >= FONT_UNIT_ASCENTS.len
        || font_idx >= FONT_UNIT_DESCENTS.len
        || font_idx >= FONT_UNIT_LINE_GAPS.len {
        return TextLineMetrics {
            ascent: 0.0,
            descent: 0.0,
            line_gap: 0.0,
            line_height: 0.0,
        }
    }
    let scale = abs(scale_y)
    let ascent = FONT_UNIT_ASCENTS[font_idx] * scale
    let descent = -FONT_UNIT_DESCENTS[font_idx] * scale
    let line_gap = FONT_UNIT_LINE_GAPS[font_idx] * scale
    return TextLineMetrics {
        ascent: ascent,
        descent: descent,
        line_gap: line_gap,
        line_height: ascent + descent + line_gap,
    }
}

// Initialize per-font batch state. Called by load_font() in lib.rock
// after the FFI succeeds, so each loaded font automatically gets its
// atlas image, pixel size, and glyph cache populated. Grows the
// per-font vecs to font.backend_id and writes into the [backend_id - 1] slot.
//
// `atlas: false` is the metrics-only load (`load_font_metrics`): everything
// below still runs -- pixel size, font-unit metrics, codepoint slots, both
// glyph caches -- except the atlas page, because a metrics font owns no GL
// texture. That is ONE step skipped, not a second init: measurement and layout
// read the unit cache, so they are the same code on both paths.
fn init_text_batch_for(font: Font, atlas: bool = true) {
    let d = font.data() ?? return
    let idx = d.backend_id - 1

    while FONT_ATLASES.len <= idx {
        FONT_ATLASES.push(Image(0))
        FONT_PIXEL_SIZES.push(0)
        FONT_CAP_HEIGHTS.push(0.0)
        FONT_UNIT_SIZES.push(0.0)
        FONT_UNIT_CAP_HEIGHTS.push(0.0)
        FONT_UNIT_ASCENTS.push(0.0)
        FONT_UNIT_DESCENTS.push(0.0)
        FONT_UNIT_LINE_GAPS.push(0.0)
        GLYPH_CACHES.push([])
        GLYPH_UNIT_CACHES.push([])
        FONT_CP_SLOTS.push(map_new())
    }

    if atlas {
        FONT_ATLASES[idx] = register_image(stone_get_font_atlas_image_for(d.backend_id), d.sampling)
    }
    d.pixel_size = stone_get_font_pixel_size_for(d.backend_id)
    FONT_PIXEL_SIZES[idx] = d.pixel_size

    let font_units = native_buffer_float(5)
    if stone_get_font_unit_metrics(d.backend_id, font_units.ptr) {
        FONT_UNIT_SIZES[idx] = font_units[0]
        FONT_UNIT_ASCENTS[idx] = font_units[1]
        FONT_UNIT_DESCENTS[idx] = font_units[2]
        FONT_UNIT_LINE_GAPS[idx] = font_units[3]
        FONT_UNIT_CAP_HEIGHTS[idx] = font_units[4]
    } else {
        FONT_UNIT_SIZES[idx] = FONT_PIXEL_SIZES[idx] as float
        FONT_UNIT_CAP_HEIGHTS[idx] = FONT_PIXEL_SIZES[idx] as float
        FONT_UNIT_ASCENTS[idx] = FONT_PIXEL_SIZES[idx] as float
        FONT_UNIT_DESCENTS[idx] = 0.0
        FONT_UNIT_LINE_GAPS[idx] = 0.0
    }

    let slot_count = stone_get_font_slot_count(d.backend_id)
    let cp_slots = map_new()
    // From 127, not 128: the identity block's non-ASCII entry is published like any other.
    let slot = 127
    while slot < slot_count {
        let cp = stone_get_font_slot_codepoint(d.backend_id, slot)
        if cp >= 0 { cp_slots[cp] = slot }
        slot = slot + 1
    }
    FONT_CP_SLOTS[idx] = cp_slots

    let faces: [[GlyphData]] = []
    let face = 0
    while face < 4 {
        let glyphs: [GlyphData] = []
        if faces_declare(d.faces, face) {
            let i = 0
            while i < slot_count {
                let out = native_buffer_float(9)
                let g = if stone_get_glyph_info_for(d.backend_id, face, i, out.ptr) {
                    GlyphData {
                        u0: out[0], v0: out[1], u1: out[2], v1: out[3],
                        width: out[4], height: out[5],
                        bearing_x: out[6], bearing_y: out[7],
                        advance: out[8], valid: true,
                    }
                } else {
                    GlyphData {
                        u0: 0.0, v0: 0.0, u1: 0.0, v1: 0.0,
                        width: 0.0, height: 0.0, bearing_x: 0.0, bearing_y: 0.0,
                        advance: 0.0, valid: false
                    }
                }
                glyphs.push(g)
                i = i + 1
            }
        }
        faces.push(glyphs)
        face = face + 1
    }
    GLYPH_CACHES[idx] = faces
    let unit_faces: [[GlyphUnitData]] = []
    let unit_face = 0
    while unit_face < 4 {
        let units: [GlyphUnitData] = []
        if faces_declare(d.faces, unit_face) {
            let i = 0
            while i < slot_count {
                let out = native_buffer_float(5)
                let valid = stone_get_glyph_unit_metrics(d.backend_id, unit_face, i, out.ptr)
                units.push(
                    if valid {
                        GlyphUnitData {
                            left: out[0], top: out[1], width: out[2], height: out[3],
                            advance: out[4], valid: true,
                        }
                    } else {
                        GlyphUnitData {
                            left: 0.0, top: 0.0, width: 0.0, height: 0.0,
                            advance: 0.0, valid: false,
                        }
                    }
                )
                i = i + 1
            }
        }
        unit_faces.push(units)
        unit_face = unit_face + 1
    }
    GLYPH_UNIT_CACHES[idx] = unit_faces
    text_layout_cache_clear()
    text_prepare_cache_clear()
    let glyphs = faces[FACE_REGULAR]

    let cap = glyphs[88].height
    if !glyphs[88].valid || cap <= 0.0 {
        cap = d.pixel_size as float
    }
    FONT_CAP_HEIGHTS[idx] = cap
    d.cap_height = FONT_UNIT_CAP_HEIGHTS[idx]
}

fn drop_text_batch_for(backend_id: int) {
    let idx = backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len { return }
    FONT_ATLASES[idx] = Image(0)
    FONT_PIXEL_SIZES[idx] = 0
    FONT_CAP_HEIGHTS[idx] = 0.0
    FONT_UNIT_SIZES[idx] = 0.0
    FONT_UNIT_CAP_HEIGHTS[idx] = 0.0
    FONT_UNIT_ASCENTS[idx] = 0.0
    FONT_UNIT_DESCENTS[idx] = 0.0
    FONT_UNIT_LINE_GAPS[idx] = 0.0
    GLYPH_CACHES[idx] = []
    GLYPH_UNIT_CACHES[idx] = []
    FONT_CP_SLOTS[idx] = map_new()
    text_layout_cache_clear()
    text_prepare_cache_clear()
}

fn drop_all_text_batches() {
    let count = FONT_ATLASES.len
    for i in 0..count {
        drop_text_batch_for(i + 1)
    }
}

// The metric em the raster geometry scales by, plus the check that the layout
// can produce geometry at all. Separate from the geometry below because it is
// the only part that walks `Font` -> `FontData`, and that walk is loop
// invariant: one emitted string names one font. A glyph loop resolves it once
// and passes it to `text_layout_raster_rect_at`; resolving per glyph corner
// was four walks per glyph and 77% of every Font -> FontData resolution in a
// combat frame.
fn text_layout_metric_unit_size(layout: TextLayout, source_pixel_size: float) -> float {
    TEXT_LAYOUT_RASTER_FONT_RESOLVES += 1
    let font = layout.font
    if font == null { error("text raster geometry requires a live font") }
    let data = font.unwrap().data()
    if data == null { error("text raster geometry requires live font data") }
    let idx = data.unwrap().backend_id - 1
    if idx < 0 || idx >= FONT_UNIT_SIZES.len || source_pixel_size <= 0.0 {
        error("text raster geometry has invalid source metrics")
    }
    return FONT_UNIT_SIZES[idx]
}

// The ink rect, given the metric em the layout's font already resolved to.
fn text_layout_raster_rect_at(
    unit_size: float,
    layout: TextLayout,
    glyph_origin: Vec2,
    raw: GlyphData,
    source_pixel_size: float
) -> Rect {
    let metric_to_layout_x = unit_size
        * layout.raster_metric_scale_x / source_pixel_size
    let metric_to_layout_y = unit_size
        * abs(layout.raster_metric_scale_y) / source_pixel_size
    return rect(
        glyph_origin.x + raw.bearing_x * metric_to_layout_x,
        glyph_origin.y - raw.bearing_y * metric_to_layout_y,
        raw.width * abs(metric_to_layout_x),
        raw.height * metric_to_layout_y)
}

pub fn text_layout_raster_rect(
    layout: TextLayout,
    glyph_origin: Vec2,
    raw: GlyphData,
    source_pixel_size: float
) -> Rect {
    return text_layout_raster_rect_at(
        text_layout_metric_unit_size(layout, source_pixel_size),
        layout, glyph_origin, raw, source_pixel_size)
}

fn text_layout_pose_corner(
    ink: Rect,
    glyph_pivot: Vec2,
    pose: GlyphPose?,
    origin: Vec2,
    corner: int,
    layout_scale: float = 1.0
) -> Vec2 {
    let point = if corner == 0 {
        v(ink.x, ink.y)
    } else if corner == 1 {
        v(ink.x + ink.w, ink.y)
    } else if corner == 2 {
        v(ink.x + ink.w, ink.y + ink.h)
    } else {
        v(ink.x, ink.y + ink.h)
    }
    return text_layout_pose_point(glyph_pivot, point, pose) * layout_scale + origin
}

pub fn text_layout_raster_quad_point(
    layout: TextLayout,
    glyph_origin: Vec2,
    glyph_pivot: Vec2,
    raw: GlyphData,
    source_pixel_size: float,
    pose: GlyphPose?,
    origin: Vec2,
    corner: int
) -> Vec2 {
    let ink = text_layout_raster_rect(layout, glyph_origin, raw, source_pixel_size)
    return text_layout_pose_corner(ink, glyph_pivot, pose, origin, corner)
}

pub fn text_layout_instance_glyph(
    instance_id: int,
    face: int,
    glyph: int
) -> bool {
    TEXT_LAYOUT_INSTANCE_GLYPH_FETCHES += 1
    let out = TEXT_LAYOUT_INSTANCE_GLYPH_SCRATCH
    let found = stone_get_font_instance_glyph_info(instance_id, face, glyph, out.ptr)
    return found
}

pub fn text_layout_instance_glyph_data() -> GlyphData {
    let out = TEXT_LAYOUT_INSTANCE_GLYPH_SCRATCH
    return GlyphData {
        u0: out[0], v0: out[1], u1: out[2], v1: out[3],
        width: out[4], height: out[5], bearing_x: out[6], bearing_y: out[7],
        advance: out[8], valid: true,
    }
}

const TEXT_LAYOUT_INSTANCE_GLYPH_STRIDE: int = 14

fn text_layout_instance_glyph_cache_prepare(layout: TextLayout, instance_id: int) {
    let expected = layout.glyphs.len * TEXT_LAYOUT_INSTANCE_GLYPH_STRIDE
    if layout.instance_glyph_id == instance_id
        && layout.instance_glyph_data != null
        && layout.instance_glyph_data.len == expected { return () }
    // A layout drawn at an animated scale can move between atlas instances;
    // the per-glyph rows keep their shape, so refill the owned buffer.
    let cached = if layout.instance_glyph_data != null
        && layout.instance_glyph_data.len == expected {
        layout.instance_glyph_data
    } else { native_buffer_float(expected) }
    let pixels = stone_get_font_instance_pixel_size_ffi(instance_id)
    let unit_size = text_layout_metric_unit_size(layout, pixels)
    for i in 0..layout.glyphs.len {
        let base = i * TEXT_LAYOUT_INSTANCE_GLYPH_STRIDE
        let glyph = layout.glyphs[i]
        let found = text_layout_instance_glyph(instance_id, glyph.face, glyph.glyph)
        cached[base] = if found { 1.0 } else { 0.0 }
        if found {
            let raw = TEXT_LAYOUT_INSTANCE_GLYPH_SCRATCH
            for j in 0..9 { cached[base + 1 + j] = raw[j] }
            let ink = text_layout_raster_rect_at(unit_size, layout, glyph.origin,
                text_layout_instance_glyph_cached(cached, i), pixels)
            cached[base + 10] = ink.x
            cached[base + 11] = ink.y
            cached[base + 12] = ink.x + ink.w
            cached[base + 13] = ink.y + ink.h
        }
    }
    layout.instance_glyph_id = instance_id
    layout.instance_glyph_data = cached
}

fn text_layout_instance_glyph_cached(data: NativeBuffer<float>, index: int) -> GlyphData {
    let base = index * TEXT_LAYOUT_INSTANCE_GLYPH_STRIDE + 1
    return GlyphData {
        u0: data[base], v0: data[base + 1], u1: data[base + 2], v1: data[base + 3],
        width: data[base + 4], height: data[base + 5],
        bearing_x: data[base + 6], bearing_y: data[base + 7],
        advance: data[base + 8], valid: true,
    }
}


fn text_layout_emit_instance(
    batch: RenderBatch,
    layout: TextLayout,
    origin: Vec2,
    color: Color,
    instance_id: int,
    poses: [GlyphPose]?,
    probe_text: string = "",
    probe_consumer_key: string = "",
    probe_admitted_count: int = -1,
    probe_layout_glyph_count: int = -1,
    probe_layout_ink_bounds: Rect = rect(0.0, 0.0, 0.0, 0.0),
    layout_scale: float = 1.0,
    world: bool = false
) -> bool {
    profile_begin("text.emit.glyphs")
    let probing = !world && (probe_text != "" || UI_SUBMISSION_PROBE_ON)
    let before = batch.count
    let emitted_count = 0
    let emitted_bounds = rect(0.0, 0.0, 0.0, 0.0)
    text_layout_instance_glyph_cache_prepare(layout, instance_id)
    let cached_glyphs = layout.instance_glyph_data.unwrap()
    if poses == null && !probing && !world {
        for i in 0..layout.glyphs.len {
            let base = i * TEXT_LAYOUT_INSTANCE_GLYPH_STRIDE
            if cached_glyphs[base] == 0.0 { continue }
            let x0 = origin.x + cached_glyphs[base + 10] * layout_scale
            let y0 = origin.y + cached_glyphs[base + 11] * layout_scale
            let x1 = origin.x + cached_glyphs[base + 12] * layout_scale
            let y1 = origin.y + cached_glyphs[base + 13] * layout_scale
            __write_quad(batch.verts, batch.count,
                v(x0,y0), v(x1,y0), v(x1,y1), v(x0,y1),
                cached_glyphs[base + 1], cached_glyphs[base + 2],
                cached_glyphs[base + 3], cached_glyphs[base + 4],
                color.r, color.g, color.b, color.a)
            batch.count += 6
        }
        profile_end("text.emit.glyphs")
        return batch.count > before
    }
    let source_pixel_size = if layout.instance_cached_id == instance_id
        && layout.instance_cached_pixel_size > 0 {
        layout.instance_cached_pixel_size
    } else { stone_get_font_instance_pixel_size_ffi(instance_id) }
    let unit_size = 0.0
    let unit_size_ready = false
    for i in 0..layout.glyphs.len {
        let glyph_origin = layout.glyphs[i].origin
        let glyph_pivot = layout.glyphs[i].pivot
        let data = cached_glyphs
        if data[i * TEXT_LAYOUT_INSTANCE_GLYPH_STRIDE] == 0.0 { continue }
        let raw = text_layout_instance_glyph_cached(data, i)
        if world && raw.height <= 0.0 { continue }
        let pose = text_layout_pose_at(layout, i, poses)
        if !unit_size_ready {
            unit_size = text_layout_metric_unit_size(layout, source_pixel_size)
            unit_size_ready = true
        }
        let ink = text_layout_raster_rect_at(unit_size, layout, glyph_origin,
            raw, source_pixel_size)
        if world {
            text_world_glyph_quad(batch, ink, glyph_origin.y - layout.ascent, layout.ascent,
                glyph_pivot, pose, origin, raw, color)
            batch.count += 6
            continue
        }
        let a = text_layout_pose_corner(ink, glyph_pivot, pose, origin, 0, layout_scale)
        let b = text_layout_pose_corner(ink, glyph_pivot, pose, origin, 1, layout_scale)
        let c = text_layout_pose_corner(ink, glyph_pivot, pose, origin, 2, layout_scale)
        let d = text_layout_pose_corner(ink, glyph_pivot, pose, origin, 3, layout_scale)
        __write_quad(batch.verts, batch.count, a, b, c, d,
            raw.u0, raw.v0, raw.u1, raw.v1,
            color.r, color.g, color.b, color.a)
        if probing {
            let observed = batch.verts[batch.count].pos.to_f64()
            let lo = observed
            let hi = observed
            for j in 1..6 {
                let p = batch.verts[batch.count + j].pos
                lo = v(min(lo.x, p.x), min(lo.y, p.y))
                hi = v(max(hi.x, p.x), max(hi.y, p.y))
            }
            emitted_bounds = text_layout_emission_bounds_union(
                emitted_bounds, rect(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y))
            emitted_count += 1
        }
        if UI_SUBMISSION_PROBE_ON {
            UI_SUBMISSION_PROBE_GLYPH_HOOK.unwrap()(batch, layout, layout.glyphs[i], pose,
                origin, instance_id, raw, layout_scale)
        }
        batch.count += 6
    }
    if probing {
        let probe_demand = text_layout_raster_demand(layout, null, layout_scale)
        let source_cap_height = 0.0
        if layout.font != null {
            let font = layout.font
            let data = font.data()
            if data != null {
                source_cap_height = source_pixel_size as float
                    * text_art_font_cap_height_ratio(font)
            }
        }
        let value = TextLayoutEmissionProbe {
            frame: RENDER_FRAME,
            retained_text: probe_text,
            admitted_count: if probe_admitted_count < 0 {
                layout.admitted_count
            } else { probe_admitted_count },
            layout_glyph_count: if probe_layout_glyph_count < 0 {
                layout.glyphs.len
            } else { probe_layout_glyph_count },
            emitted_count: emitted_count,
            instance_id: instance_id,
            consumer_key: probe_consumer_key,
            origin: origin,
            logical_bounds: text_rect_scaled(layout.logical_bounds, layout_scale),
            layout_ink_bounds: text_rect_scaled(if probe_admitted_count < 0 {
                layout.ink_bounds
            } else { probe_layout_ink_bounds }, layout_scale),
            emitted_bounds: emitted_bounds,
            target_pixel_cap_height: probe_demand.target_pixel_cap_height,
            required_pixel_em: probe_demand.required_pixel_em,
            selected_pixel_em: source_pixel_size,
            source_cap_height: source_cap_height,
        }
        if probe_text != "" {
            text_layout_emission_probe_record(value)
        }
        if UI_SUBMISSION_PROBE_ON { UI_SUBMISSION_PROBE_TEXT_HOOK.unwrap()(value, layout.text) }
    }
    let emitted = batch.count > before
    profile_end("text.emit.glyphs")
    return emitted
}

fn text_layout_pose_max_scale(poses: [GlyphPose]?) -> float {
    if poses == null { return 1.0 }
    let largest = 1.0
    for pose in poses {
        largest = max(largest, max(abs(pose.scale.x), abs(pose.scale.y)))
    }
    return largest
}

fn text_rect_scaled(r: Rect, k: float) -> Rect {
    if k == 1.0 { return r }
    return rect(r.x * k, r.y * k, r.w * k, r.h * k)
}

// `layout_scale` is a whole-layout scale applied at emission (see
// ResolvedTextRun.draw_scale); the demand follows the drawn size so the same
// atlas instance is chosen as for a layout built at that size.
pub fn text_layout_raster_demand(layout: TextLayout, poses: [GlyphPose]?,
    layout_scale: float = 1.0) -> TextArtRasterDemand {
    let pose_scale = text_layout_pose_max_scale(poses)
    let coverage_oversampling = font_coverage_oversampling_require(
        layout.coverage_oversampling)
    let target = layout.raster_target_cap_height * layout_scale * pose_scale
        * coverage_oversampling
    let footprint = v(layout.logical_bounds.w, layout.logical_bounds.h) * layout_scale
    let font = layout.font ?? return TextArtRasterDemand {
        glyph_population: layout.admitted_count,
        target_footprint: footprint,
        authored_cap_height: layout.raster_authored_cap_height,
        layout_to_target_scale: layout.raster_layout_to_target_scale,
        physical_target_scale: layout.raster_physical_target_scale,
        max_pose_scale: pose_scale,
        coverage_oversampling: coverage_oversampling,
        target_pixel_cap_height: target,
    }
    let required_pixel_em = if target > 0.0 {
        text_art_required_pixel_em_for(font, target)
    } else { 0.0 }
    return TextArtRasterDemand {
        glyph_population: layout.admitted_count,
        target_footprint: footprint,
        source_footprint: v(),
        authored_cap_height: layout.raster_authored_cap_height,
        layout_to_target_scale: layout.raster_layout_to_target_scale,
        physical_target_scale: layout.raster_physical_target_scale,
        max_pose_scale: pose_scale,
        coverage_oversampling: coverage_oversampling,
        target_pixel_cap_height: target,
        required_pixel_em: required_pixel_em,
        coverage_bucket: if required_pixel_em > 0.0 {
            text_art_coverage_bucket_for_ppem(required_pixel_em)
        } else { 0 },
    }
}

pub fn text_layout_emit(
    layout: TextLayout,
    origin: Vec2,
    color: Color,
    z_layer: int,
    poses: [GlyphPose]? = null,
    consumer_key: string = "",
    layout_scale: float = 1.0,
    shadow: bool = false,
    placement: TextPlacement = TextPlacement::Output,
    depth: DepthMode = DepthMode::Off
) -> bool {
    let output = placement == TextPlacement::Output
    if output { TEXT_LAYOUT_EMIT_CALLS += 1 }
    let font = layout.font ?? return false
    let fd = font.data() ?? return false
    if !output && (fd.backend_id < 1 || fd.backend_id > FONT_ATLASES.len) { return false }
    if layout.glyphs.len == 0 { return false }
    if poses != null { text_layout_validate_poses(layout, poses) }
    let probe_text = if output { text_layout_probe_text(layout) } else { "" }
    let probe_admitted_count = layout.admitted_count
    let probe_layout_glyph_count = layout.glyphs.len
    let probe_layout_ink_bounds = layout.ink_bounds
    let cache_instance = output && poses == null && consumer_key == "" && layout_scale == 1.0
    let instance_id = 0
    let image = 0
    if cache_instance && layout.instance_cached_id > 0 {
        TEXT_LAYOUT_INSTANCE_CACHE_HITS += 1
        profile_begin("text.layout.raster_demand")
        profile_end("text.layout.raster_demand")
        profile_begin("text.art.atlas_lookup")
        profile_end("text.art.atlas_lookup")
        instance_id = layout.instance_cached_id
        image = layout.instance_cached_image
    } else {
        profile_begin("text.layout.raster_demand")
        let demand = text_layout_raster_demand(layout, poses, layout_scale)
        profile_end("text.layout.raster_demand")
        profile_begin("text.art.atlas_lookup")
        let instance = text_art_atlas_instance_for(font, demand, consumer_key)
        profile_end("text.art.atlas_lookup")
        instance_id = (instance.instance_id as int)
        image = stone_get_font_instance_image_ffi(instance_id)
        if cache_instance {
            layout.instance_cached_id = instance_id
            layout.instance_cached_pixel_size = instance.pixel_size
            layout.instance_cached_image = image
        }
    }
    if output { TEXT_ART_COVERAGE_EMIT_CALLS = TEXT_ART_COVERAGE_EMIT_CALLS + 1 }
    if image == 0 { error("TextLayout atlas instance {instance_id} has no GL image") }
    profile_begin("text.batch.lookup")
    // Target text (canvas bakes) shares the layout and Y-down quads of output
    // text and only drains into the render pool.
    let batch = if output {
        ensure_ui_batch(sampled_image(Image(image)), RenderProps {
            z_layer: z_layer,
            depth: DepthMode::Off,
            sampling: fd.sampling,
            pipeline: null,
            text_batch: true,
        })
    } else {
        ensure_world_sprite_batch(sampled_image(Image(image)), z_layer, BlendMode::Alpha, false,
            depth, unlit: true, sampling: fd.sampling,
            text_batch: placement == TextPlacement::World)
    }
    profile_end("text.batch.lookup")
    reserve_vertices(batch, layout.glyphs.len * if shadow { 12 } else { 6 })
    if shadow {
        let _ = text_layout_emit_instance(batch, layout, origin + v(1,1), BLACK,
            instance_id, poses, probe_text: probe_text, probe_consumer_key: consumer_key,
            probe_admitted_count: probe_admitted_count,
            probe_layout_glyph_count: probe_layout_glyph_count,
            probe_layout_ink_bounds: probe_layout_ink_bounds,
            layout_scale: layout_scale)
    }
    return text_layout_emit_instance(
        batch, layout, origin, color, instance_id, poses,
        probe_text: probe_text, probe_consumer_key: consumer_key,
        probe_admitted_count: probe_admitted_count,
        probe_layout_glyph_count: probe_layout_glyph_count,
        probe_layout_ink_bounds: probe_layout_ink_bounds,
        layout_scale: layout_scale, world: placement == TextPlacement::World)
}


// World text is Y-up: each glyph is mirrored about its line, and the vertices
// carry the baseline as their pivot.
fn text_world_glyph_quad(
    batch: RenderBatch,
    ink: Rect,
    line_y: float,
    ascent: float,
    glyph_pivot: Vec2,
    pose: GlyphPose?,
    baseline: Vec2,
    raw: GlyphData,
    color: Color
) {
    let a0 = text_layout_pose_corner(ink, glyph_pivot, pose, v(), 0)
    let b0 = text_layout_pose_corner(ink, glyph_pivot, pose, v(), 1)
    let c0 = text_layout_pose_corner(ink, glyph_pivot, pose, v(), 2)
    let d0 = text_layout_pose_corner(ink, glyph_pivot, pose, v(), 3)
    let a = v(baseline.x + a0.x,
        baseline.y + 2.0 * line_y + ascent - a0.y)
    let b = v(baseline.x + b0.x,
        baseline.y + 2.0 * line_y + ascent - b0.y)
    let c = v(baseline.x + c0.x,
        baseline.y + 2.0 * line_y + ascent - c0.y)
    let d = v(baseline.x + d0.x,
        baseline.y + 2.0 * line_y + ascent - d0.y)
    batch.verts[batch.count + 0] = make_world_text_vertex(
        a.x, a.y, raw.u0, raw.v0, color, baseline.y)
    batch.verts[batch.count + 1] = make_world_text_vertex(
        d.x, d.y, raw.u0, raw.v1, color, baseline.y)
    batch.verts[batch.count + 2] = make_world_text_vertex(
        c.x, c.y, raw.u1, raw.v1, color, baseline.y)
    batch.verts[batch.count + 3] = make_world_text_vertex(
        a.x, a.y, raw.u0, raw.v0, color, baseline.y)
    batch.verts[batch.count + 4] = make_world_text_vertex(
        c.x, c.y, raw.u1, raw.v1, color, baseline.y)
    batch.verts[batch.count + 5] = make_world_text_vertex(
        b.x, b.y, raw.u1, raw.v0, color, baseline.y)
}

pub fn queue_ui_text(
    text: string,
    pos: Vec2,
    size: float,
    color: Color,
    offset: Vec2,
    z_layer: int = UI_TEXT_Z_LAYER
) {
    let f = DEFAULT_FONT ?? return
    queue_ui_text_with_font(f, text, pos, size, color, offset, z_layer)
}

pub fn queue_ui_text_with_font(
    font: Font,
    text: string,
    pos: Vec2,
    size: float,
    color: Color,
    offset: Vec2,
    z_layer: int = UI_TEXT_Z_LAYER
) {
    queue_ui_text_scaled(font, text, pos, size, color, offset, z_layer,
        FONT_RENDER_SCALE, TextAlign::TopLeft, text_output_raster_density())
}

fn queue_ui_text_output_px(
    font: Font,
    text: string,
    pos: Vec2,
    size: float,
    color: Color,
    offset: Vec2,
    z_layer: int = UI_TEXT_Z_LAYER
) {
    queue_ui_text_scaled(font, text, pos, size, color, offset, z_layer,
        1.0, TextAlign::TopLeft, text_output_raster_density())
}

pub fn text_output_raster_density() -> float {
    let view = RENDER_VIEW ?? return 1.0
    return max(
        0.0001,
        view.ui_raster_size.y as float
        / max(view.logical_size.y, 1.0)
    )
}

fn world_text_scene_density() -> float {
    let view = RENDER_VIEW ?? return 1.0
    return max(0.0001, view.world_to_scene_scale)
}

pub fn font_size_divisor(idx: int) -> float {
    if idx < 0 || idx >= FONT_UNIT_SIZES.len { return 0.0 }
    return if CAP_HEIGHT_FONTS { FONT_UNIT_CAP_HEIGHTS[idx] } else { FONT_UNIT_SIZES[idx] }
}

pub fn font_size_divisor(font: Font) -> float {
    let d = font.data() ?? return 0.0
    return font_size_divisor(d.backend_id - 1)
}

fn text_layout_raster_cap_for_scale(font: Font, scale_y: float) -> float {
    let d = font.data() ?? return abs(scale_y)
    let idx = d.backend_id - 1
    if idx >= 0 && idx < FONT_UNIT_CAP_HEIGHTS.len {
        let cap = FONT_UNIT_CAP_HEIGHTS[idx]
        if cap > 0.0 { return abs(scale_y) * cap }
    }
    return abs(scale_y)
}

pub fn measure_text_of(font: Font, text: string, size: float, render_scale: float,
    raster_density: float = 1.0) -> Vec2 {
    let d = font.data() ?? return v()
    let idx = d.backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len || idx >= GLYPH_CACHES.len
        || GLYPH_CACHES[idx].len <= FACE_REGULAR
        || GLYPH_CACHES[idx][FACE_REGULAR].len == 0
        || font_size_divisor(idx) <= 0.0 { return v() }
    let layout = text_layout_cached(font, text, size, render_scale,
        TextAlign::TopLeft, raster_density)
    return v(layout.logical_bounds.w, layout.logical_bounds.h)
}

// --- The shared target-space glyph core ---
//
// Byte admission, glyph lookup, advance, bearing, scale and baseline placement
// live here once. Plain and rich callers retain the same layout facts while
// choosing their own color, face and surface conventions.

// The codepoint starting at unit `i`. -1: `i` is not a lead unit, skipped by
// every walker. -2: a malformed or truncated sequence starts here.
pub inline(lua) fn text_codepoint_at(text: string, i: int) -> int = """
    local b = string.byte(text, i + 1)
    if b == nil then return -1 end
    if b < 0x80 then return b end
    if b < 0xC0 then return -1 end
    local n, cp
    if b < 0xE0 then n, cp = 1, b - 0xC0
    elseif b < 0xF0 then n, cp = 2, b - 0xE0
    elseif b < 0xF8 then n, cp = 3, b - 0xF0
    else return -2 end
    for k = 1, n do
        local c = string.byte(text, i + 1 + k)
        if c == nil or c < 0x80 or c > 0xBF then return -2 end
        cp = cp * 64 + (c - 0x80)
    end
    return cp
"""

pub fn text_glyph_slot(cp_slots: Map<int, int>, text: string, i: int) -> int {
    let cp = text_codepoint_at(text, i)
    if cp < 0 { return -1 }
    if cp >= 32 && cp <= 126 { return cp }
    return cp_slots.get(cp) ?? -1
}

pub value TextGlyph {
    glyph_index: int,
    source_index: int,
    glyph: int,
    face: int,
    origin: Vec2,
    ink: Rect,
    advance: float,
    pivot: Vec2,
}

pub nobox value TextFlowMetrics {
    font: Font,
    index: int,
    face: int,
    scale: float,
    ascent: float,
    below: float,
    plain: bool,
}

fn text_flow_paragraph_text(text: string) -> string {
    if text.find("\n") < 0 { return text }
    // Admit the original bytes first: removing a newline could join two malformed
    // UTF-8 halves into a valid glyph.
    for i in 0..text.len() {
        if text_codepoint_at(text, i) == -2 {
            error("ui_rich_flow: byte at offset {i} begins a malformed glyph")
        }
    }
    return text.replace("\n", "")
}

pub fn text_flow_metrics(font: Font, text: string, style: TextStyle,
                         size: float, render_scale: float, plain: bool = false) -> TextFlowMetrics {
    let site = "ui_rich_flow"
    let idx = text_family_font_idx(font, site, require_atlas: false)
    let face = FACE_REGULAR
    if !plain {
        let admitted = text_flow_paragraph_text(text)
        let prepared = text_prepare_missing_glyphs(font, null, idx, admitted, site)
        face = text_validate_single_font_span(font, idx, prepared, style, true, site)
    } else if TEXT_MISSING_GLYPH_POLICY == TextMissingGlyphPolicy::Substitute {
        let _ = text_prepare_missing_glyphs(font, null, idx, text, site)
    }
    if !plain && (text.find("\r") >= 0 || text.find("\t") >= 0) {
        error("ui_rich_flow: carriage return and tab are not paragraph controls")
    }
    let scale = size * render_scale / font_size_divisor(idx)
    let metrics = text_line_metrics(idx, scale)
    return TextFlowMetrics { font, index: idx, face: max(face, 0), scale,
        ascent: metrics.ascent, below: metrics.line_height - metrics.ascent, plain }
}

// Keep the renderer's glyph-addition order: adding a measured word to a
// measured prefix can round to the other side of a wrap boundary.
pub fn text_flow_advance(metrics: TextFlowMetrics, text: string,
                         start: int, end: int, pen: float) -> float {
    let result = pen
    let glyphs = GLYPH_UNIT_CACHES[metrics.index][metrics.face]
    for i in start..end {
        let cp = text_codepoint_at(text, i)
        if cp < 0 || cp == 10 || (metrics.plain && (cp == 13 || cp == 9)) { continue }
        let slot = if cp >= 32 && cp <= 126 { cp }
            else { FONT_CP_SLOTS[metrics.index].get(cp) ?? -1 }
        if slot < 0 || slot >= glyphs.len || !glyphs[slot].valid {
            if metrics.plain && TEXT_MISSING_GLYPH_POLICY == TextMissingGlyphPolicy::Reject { continue }
            slot = text_glyph_slot(FONT_CP_SLOTS[metrics.index], "?", 0)
        }
        result += glyphs[slot].advance * metrics.scale
    }
    return result
}

pub fn text_flow_validate_family(fonts: [Font], indices: [int], text: string,
                                  style: TextStyle, size: float, render_scale: float) {
    let runs: [ResolvedTextRun] = []
    text_resolve_segment(runs, fonts, indices, text_flow_paragraph_text(text), size,
        render_scale, false, style, true, "ui_rich_flow")
}

// The family resolver remains the glyph owner. Layout needs only advances and
// line metrics, so it never allocates per-glyph runs or prefix layouts.
pub fn text_flow_family_advance(indices: [int], style: TextStyle,
                                text: string, start: int, end: int,
                                size: float, render_scale: float, pen: float)
                                -> (float, float, float) {
    let result = pen
    let ascent = 0.0
    let below = 0.0
    let selected = -1
    let run = 0.0
    for i in start..end {
        let cp = text_codepoint_at(text, i)
        if cp < 0 { continue }
        let owner = text_select_font(indices, text, i)
        let glyph_text = text
        let at = i
        if owner < 0 {
            glyph_text = "?"
            at = 0
            owner = text_select_font(indices, glyph_text, at)
        }
        if owner != selected { result += run; run = 0.0; selected = owner }
        let idx = indices[owner]
        let face = style_face_index(style)
        let scale = size * render_scale / font_size_divisor(idx)
        let slot = text_glyph_slot(FONT_CP_SLOTS[idx], glyph_text, at)
        run += GLYPH_UNIT_CACHES[idx][face][slot].advance * scale
        let metrics = text_line_metrics(idx, scale)
        ascent = max(ascent, metrics.ascent)
        below = max(below, metrics.line_height - metrics.ascent)
    }
    return (result + run, ascent, below)
}

pub struct TextLayout {
    font: Font?,
    text: string,
    face: int,
    glyphs: FlatVec<TextGlyph>,
    logical_bounds: Rect = rect(0.0, 0.0, 0.0, 0.0),
    ink_bounds: Rect = rect(0.0, 0.0, 0.0, 0.0),
    ascent: float = 0.0,
    descent: float = 0.0,
    line_height: float = 0.0,
    line_count: int = 0,
    admitted_count: int = 0,
    alignment: TextAlign,
    alignment_offset: Vec2 = v(),
    raster_authored_cap_height: float = 0.0,
    raster_layout_to_target_scale: float = 1.0,
    raster_physical_target_scale: float = 1.0,
    raster_target_cap_height: float = 0.0,
    coverage_oversampling: float,
    raster_metric_scale_x: float = 0.0,
    raster_metric_scale_y: float = 0.0,
    instance_glyph_id: int = 0,
    instance_glyph_data: NativeBuffer<float>? = null,
    instance_cached_id: int = 0,
    instance_cached_pixel_size: int = 0,
    instance_cached_image: int = 0,
}

pub const TEXT_LAYOUT_CACHE_CAPACITY: int = 256

struct TextLayoutCacheEntry {
    font_id: int,
    text: string,
    // World entries store their x/y scale here.
    size: float,
    render_scale: float,
    world_raster: bool,
    cap_height_fonts: bool,
    align: TextAlign,
    raster_physical_target_scale: float,
    // text_layout_variant_key of the fields above; the index slot this entry
    // occupies under its text.
    variant: int,
    next_variant_slot: int,
    last_used: int,
    layout: TextLayout,
}

global TEXT_LAYOUT_CACHE: [TextLayoutCacheEntry] = []
global TEXT_LAYOUT_CACHE_CLOCK: int = 0
// Two map reads instead of a probe over cached variants, which was a standing
// trace abort (register coalescing too complex).
global TEXT_LAYOUT_CACHE_INDEX: Map<string, Map<int, int>> = map_new()
pub struct TextLayoutCacheCounts {
    requests: int = 0,
    hits: int = 0,
    misses: int = 0,
    builds: int = 0,
    evictions: int = 0,
    entries_examined: int = 0,
}

fn text_layout_cache_counts_add(a: TextLayoutCacheCounts, b: TextLayoutCacheCounts, sign: int) -> TextLayoutCacheCounts {
    let sum = TextLayoutCacheCounts {}
    text_layout_cache_counts_set(sum, a, b, sign)
    return sum
}

fn text_layout_cache_counts_set(dst: TextLayoutCacheCounts, a: TextLayoutCacheCounts,
    b: TextLayoutCacheCounts, sign: int) {
    dst.requests = a.requests + sign * b.requests
    dst.hits = a.hits + sign * b.hits
    dst.misses = a.misses + sign * b.misses
    dst.builds = a.builds + sign * b.builds
    dst.evictions = a.evictions + sign * b.evictions
    dst.entries_examined = a.entries_examined + sign * b.entries_examined
}

global TEXT_LAYOUT_CACHE_UI_COUNTS: TextLayoutCacheCounts = TextLayoutCacheCounts {}
global TEXT_LAYOUT_CACHE_WORLD_COUNTS: TextLayoutCacheCounts = TextLayoutCacheCounts {}
// The counts at the window's start while it is open, its deltas once it ends.
pub global TEXT_LAYOUT_CACHE_WINDOW_UI: TextLayoutCacheCounts = TextLayoutCacheCounts {}
pub global TEXT_LAYOUT_CACHE_WINDOW_WORLD: TextLayoutCacheCounts = TextLayoutCacheCounts {}
pub global TEXT_LAYOUT_CACHE_WINDOW_OPENED: bool = false
pub global TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED: int = -1
pub global TEXT_LAYOUT_CACHE_WINDOW_HIGH_WATER: int = -1
global TEXT_LAYOUT_CACHE_WINDOW_ACTIVE: bool = false

pub fn text_layout_cache_totals() -> TextLayoutCacheCounts {
    return text_layout_cache_counts_add(TEXT_LAYOUT_CACHE_UI_COUNTS, TEXT_LAYOUT_CACHE_WORLD_COUNTS, 1)
}

pub struct TextLayoutEmissionProbe {
    frame: int = -1,
    retained_text: string = "",
    admitted_count: int = 0,
    layout_glyph_count: int = 0,
    emitted_count: int = 0,
    instance_id: int = 0,
    consumer_key: string = "",
    origin: Vec2 = v(),
    logical_bounds: Rect = rect(0.0, 0.0, 0.0, 0.0),
    layout_ink_bounds: Rect = rect(0.0, 0.0, 0.0, 0.0),
    emitted_bounds: Rect = rect(0.0, 0.0, 0.0, 0.0),
    target_pixel_cap_height: float = 0.0,
    required_pixel_em: float = 0.0,
    selected_pixel_em: int = 0,
    source_cap_height: float = 0.0,
}

pub const TEXT_LAYOUT_SIM_PROBES: bool = get_env_int("STONE_TEXT_LAYOUT_SIM_PROBES", 1) != 0

fn text_layout_probe_text(layout: TextLayout) -> string {
    return if sim_mode_active() && TEXT_LAYOUT_SIM_PROBES { layout.text } else { "" }
}

pub fn text_layout_emission_probe_empty() -> TextLayoutEmissionProbe {
    return TextLayoutEmissionProbe {}
}

pub value GlyphPose {
    glyph_index: int,
    source_index: int,
    glyph: int,
    translation: Vec2,
    scale: Vec2,
    rotation: float,
}

pub global TEXT_LAYOUT_BUILD_CALLS: int = 0
pub global TEXT_LAYOUT_EMIT_CALLS: int = 0
global TEXT_ART_COVERAGE_EMIT_CALLS: int = 0
pub global TEXT_LAYOUT_EMISSION_PROBES: [TextLayoutEmissionProbe] = []
global TEXT_LAYOUT_EMISSION_PROBE_INDEX: Map<string, int> = map_new()

pub fn text_layout_emission_probe(text: string) -> TextLayoutEmissionProbe? {
    for probe in TEXT_LAYOUT_EMISSION_PROBES {
        if probe.retained_text == text { return probe }
    }
    return null
}

pub fn text_layout_emission_probe_record(value: TextLayoutEmissionProbe) {
    if let slot = TEXT_LAYOUT_EMISSION_PROBE_INDEX.get(value.retained_text) {
        TEXT_LAYOUT_EMISSION_PROBES[slot] = value
    } else {
        TEXT_LAYOUT_EMISSION_PROBE_INDEX[value.retained_text] = TEXT_LAYOUT_EMISSION_PROBES.len
        TEXT_LAYOUT_EMISSION_PROBES.push(value)
    }
}

pub fn text_layout_emission_probe_reset() {
    TEXT_LAYOUT_EMISSION_PROBES.clear()
    TEXT_LAYOUT_EMISSION_PROBE_INDEX.clear()
}

fn text_layout_emission_probe_case_text(i: int) -> string {
    return "tn-keyboard-probe-{i}"
}

@test
fn text_layout_emission_probe_keeps_texts_past_the_old_bound() {
    text_layout_emission_probe_reset()
    defer { text_layout_emission_probe_reset() }
    let count = 24
    for i in 0..count {
        let value = text_layout_emission_probe_empty()
        value.retained_text = text_layout_emission_probe_case_text(i)
        value.emitted_count = i + 1
        text_layout_emission_probe_record(value)
    }
    assert_eq(TEXT_LAYOUT_EMISSION_PROBES.len, count,
        "recording keeps one slot per distinct text")
    for i in 0..count {
        let text = text_layout_emission_probe_case_text(i)
        let found = text_layout_emission_probe(text)
        assert(found != null, "recorded probe text {text} stays retrievable")
        assert_eq(found.unwrap().emitted_count, i + 1,
            "probe {text} keeps its recorded emission")
    }
    let again = text_layout_emission_probe_empty()
    again.retained_text = text_layout_emission_probe_case_text(5)
    again.emitted_count = 50
    text_layout_emission_probe_record(again)
    assert_eq(TEXT_LAYOUT_EMISSION_PROBES.len, count,
        "re-recording a text keeps the slot count")
    assert_eq(text_layout_emission_probe(
        text_layout_emission_probe_case_text(5)).unwrap().emitted_count, 50,
        "re-recording a text updates its slot")
}

fn text_layout_emission_bounds_union(a: Rect, b: Rect) -> Rect {
    if a.w <= 0.0 || a.h <= 0.0 { return b }
    let lo = v(min(a.x, b.x), min(a.y, b.y))
    let hi = v(max(a.x + a.w, b.x + b.w), max(a.y + a.h, b.y + b.h))
    return rect(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y)
}

fn text_layout_source_step(text: string, i: int) -> int {
    let end = text_codepoint_end(text, i)
    return max(1, end - i)
}

fn text_layout_coverage_oversampling(font: Font?) -> float {
    let value = FONT_COVERAGE_OVERSAMPLING
    if font != null {
        let data = font.data()
        if data != null && data.raster == FontRasterPolicy::Fixed {
            value = FONT_COVERAGE_OVERSAMPLING_DEFAULT
        }
    }
    return font_coverage_oversampling_require(value)
}

fn text_layout_empty(font: Font?, text: string, face: int, align: TextAlign) -> TextLayout {
    return TextLayout {
        font: font,
        text: text,
        face: face,
        glyphs: flat_vec_new(max(1, text.len())),
        alignment: align,
        coverage_oversampling: text_layout_coverage_oversampling(font),
    }
}

pub fn text_cap_center_from_top(ascent: float, cap_height: float, trailing: float) -> float {
    return ascent - cap_height * 0.5 + trailing * 0.5
}

pub fn text_anchored_y(anchor_y: float, frac_y: float, text_h: float, ascent: float, cap_height: float, trailing: float) -> float {
    if frac_y == 0.5 && cap_height > 0.0 && text_h > 0.0 {
        return anchor_y - text_cap_center_from_top(ascent, cap_height, trailing)
    }
    return anchor_y - frac_y * text_h
}

// Scaled cap height of one font at an authored UI size: the same divisor
// and context factor text_layout_build emits with. 0.0 = the font has no
// usable metrics yet; callers keep logical-box centering then.
pub fn text_font_cap_height(font: Font, size: float, render_scale: float) -> float {
    let d = font.data() ?? return 0.0
    let idx = d.backend_id - 1
    if idx < 0 || idx >= FONT_UNIT_CAP_HEIGHTS.len { return 0.0 }
    let divisor = font_size_divisor(idx)
    if divisor <= 0.0 || FONT_UNIT_CAP_HEIGHTS[idx] <= 0.0 { return 0.0 }
    return FONT_UNIT_CAP_HEIGHTS[idx] * size * render_scale / divisor
}

pub fn resolved_runs_cap_height(runs: [ResolvedTextRun]) -> float {
    let cap = 0.0
    for run in runs {
        let d = run.font.data() ?? continue
        let idx = d.backend_id - 1
        if idx < 0 || idx >= FONT_UNIT_CAP_HEIGHTS.len { continue }
        let c = FONT_UNIT_CAP_HEIGHTS[idx] * resolved_run_scale(run) * run.draw_scale
        if c > cap { cap = c }
    }
    return cap
}

pub fn resolved_plain_cap_height(layout: ResolvedPlainText) -> float {
    let cap = 0.0
    for line in layout.lines {
        let c = resolved_runs_cap_height(line.runs)
        if c > cap { cap = c }
    }
    return cap
}

pub fn text_layout_build_scaled(
    font: Font,
    text: string,
    scale_x: float,
    scale_y: float,
    face: int,
    align: TextAlign,
    reject_invalid: bool,
    split_lines: bool = true,
    reject_site: string = "",
    raster_physical_target_scale: float = 1.0
) -> TextLayout {
    TEXT_LAYOUT_BUILD_CALLS += 1
    let data = font.data()
    if data == null { return text_layout_empty(font, text, face, align) }
    let idx = data.backend_id - 1
    if TEXT_MISSING_GLYPH_POLICY == TextMissingGlyphPolicy::Substitute
        && idx >= 0 && idx < FONT_CP_SLOTS.len && idx < GLYPH_CACHES.len
        && GLYPH_CACHES[idx].len > FACE_REGULAR
        && GLYPH_CACHES[idx][FACE_REGULAR].len > 0 {
        let prepare_site = if reject_site == "" { "text layout" } else { reject_site }
        text = text_prepare_missing_glyphs(font, null, idx, text, prepare_site)
    }
    let layout = text_layout_empty(font, text, face, align)
    layout.font = font
    layout.text = text
    layout.face = face
    layout.logical_bounds = rect(0.0, 0.0, 0.0, 0.0)
    layout.ink_bounds = rect(0.0, 0.0, 0.0, 0.0)
    layout.ascent = 0.0
    layout.descent = 0.0
    let abs_sy = abs(scale_y)
    let metrics = text_line_metrics(idx, scale_y)
    layout.line_height = metrics.line_height
    layout.line_count = 1
    layout.admitted_count = 0
    layout.alignment = align
    layout.alignment_offset = v()
    layout.raster_metric_scale_x = scale_x
    layout.raster_metric_scale_y = scale_y
    layout.raster_authored_cap_height = 0.0
    layout.raster_layout_to_target_scale = 1.0
    layout.raster_physical_target_scale = raster_physical_target_scale
    layout.raster_target_cap_height = 0.0

    if idx >= 0 && idx < FONT_UNIT_SIZES.len
        && idx < FONT_UNIT_CAP_HEIGHTS.len {
        layout.raster_authored_cap_height = text_layout_raster_cap_for_scale(font, scale_y)
        layout.raster_target_cap_height = layout.raster_authored_cap_height
            * layout.raster_layout_to_target_scale
            * layout.raster_physical_target_scale
    }
    if idx < 0 || idx >= GLYPH_CACHES.len || idx >= GLYPH_UNIT_CACHES.len
        || face < 0 || face >= GLYPH_CACHES[idx].len
        || face >= GLYPH_UNIT_CACHES[idx].len {
        return layout
    }
    let glyphs = GLYPH_CACHES[idx][face]
    let unit_glyphs = GLYPH_UNIT_CACHES[idx][face]
    if glyphs.len == 0 || unit_glyphs.len == 0 { return layout }

    let cursor_x = 0.0
    let line_index = 0
    let max_width = 0.0
    let i = 0
    while i < text.len() {
        let byte = text.unit_at(i)
        if byte == 13 || byte == 9 {
            if reject_invalid && reject_site != "" {
                error("{reject_site}: rich text is one line -- byte {byte} at offset {i} of {text.len()} is a line control")
            }
            if reject_invalid {
                error("text layout rejected line control byte {byte} at offset {i}")
            }
            i += 1
            continue
        }
        if byte == 10 && reject_invalid && reject_site != "" {
            error("{reject_site}: rich text is one line -- byte {byte} at offset {i} of {text.len()} is a line control")
        }
        if byte == 10 && split_lines {
            if cursor_x > max_width { max_width = cursor_x }
            line_index += 1
            layout.line_count = line_index + 1
            cursor_x = 0.0
            i += 1
            continue
        }
        if byte == 10 {
            i += 1
            continue
        }
        let slot = text_glyph_slot(FONT_CP_SLOTS[idx], text, i)
        let step = text_layout_source_step(text, i)
        if slot < 0 {
            if reject_invalid {
                if reject_site != "" {
                    error("{reject_site}: byte {byte} at offset {i} is outside the supported text atlas")
                }
                error("text layout rejected byte {byte} at offset {i}")
            }
            i += step
            continue
        }
        if slot >= glyphs.len {
            if reject_invalid {
                if reject_site != "" {
                    error("{reject_site}: glyph slot {slot} at offset {i} is outside the supported text atlas")
                }
                error("text layout rejected glyph slot {slot} at offset {i}")
            }
            i += step
            continue
        }
        let raster_g = glyphs[slot]
        let g = unit_glyphs[slot]
        if !raster_g.valid || !g.valid {
            if reject_invalid {
                if reject_site != "" {
                    error("{reject_site}: glyph slot {slot} at offset {i} is unavailable")
                }
                error("text layout rejected unavailable glyph slot {slot} at offset {i}")
            }
            i += step
            continue
        }
        layout.admitted_count += 1
        let advance = g.advance * scale_x
        let glyph_h = g.height * abs_sy
        if g.width > 0.0 && g.height > 0.0 {
            let origin = v(cursor_x, line_index as float * metrics.line_height)
            layout.glyphs.push(TextGlyph {
                glyph_index: layout.glyphs.len,
                source_index: i,
                glyph: slot,
                face: face,
                origin: origin,
                ink: rect(cursor_x + g.left * scale_x,
                    origin.y - g.top * abs_sy,
                    g.width * abs(scale_x), glyph_h),
                advance: advance,
                pivot: v(cursor_x + advance * 0.5,
                    (line_index as float + 0.5) * metrics.line_height),
            })
        }
        cursor_x += advance
        i += step
    }
    if cursor_x > max_width { max_width = cursor_x }

    if layout.admitted_count > 0 {
        layout.ascent = metrics.ascent
        layout.descent = metrics.descent
    }

    for i in 0..layout.glyphs.len {
        let glyph = layout.glyphs[i]
        layout.glyphs[i] = TextGlyph {
            glyph_index: glyph.glyph_index,
            source_index: glyph.source_index,
            glyph: glyph.glyph,
            face: glyph.face,
            origin: glyph.origin + v(0.0, layout.ascent),
            ink: rect(glyph.ink.x, glyph.ink.y + layout.ascent,
                glyph.ink.w, glyph.ink.h),
            advance: glyph.advance,
            pivot: glyph.pivot,
        }
    }
    let logical_height = if layout.admitted_count > 0 {
        layout.line_count as float * metrics.line_height
    } else { 0.0 }
    layout.logical_bounds = rect(0.0, 0.0, max_width, logical_height)
    let found_ink = false
    let ink_lo = v()
    let ink_hi = v()
    for glyph in layout.glyphs {
        let lo = v(glyph.ink.x, glyph.ink.y)
        let hi = v(glyph.ink.x + glyph.ink.w, glyph.ink.y + glyph.ink.h)
        if !found_ink {
            ink_lo = lo
            ink_hi = hi
            found_ink = true
        } else {
            ink_lo = v(min(ink_lo.x, lo.x), min(ink_lo.y, lo.y))
            ink_hi = v(max(ink_hi.x, hi.x), max(ink_hi.y, hi.y))
        }
    }
    if found_ink {
        layout.ink_bounds = rect(ink_lo.x, ink_lo.y,
            ink_hi.x - ink_lo.x, ink_hi.y - ink_lo.y)
    }
    let frac = text_align_fracs(align)
    layout.alignment_offset = frac * -1.0
        * v(layout.logical_bounds.w, layout.logical_bounds.h)
    if frac.y == 0.5 && layout.logical_bounds.h > 0.0
        && idx >= 0 && idx < FONT_UNIT_CAP_HEIGHTS.len
        && FONT_UNIT_CAP_HEIGHTS[idx] > 0.0 {
        let trailing = (layout.line_count - 1) as float * metrics.line_height
        layout.alignment_offset.y = -text_cap_center_from_top(
            layout.ascent, FONT_UNIT_CAP_HEIGHTS[idx] * abs_sy, trailing)
    }
    return layout
}

pub fn text_layout_build(
    font: Font,
    text: string,
    size: float,
    render_scale: float,
    face: int = FACE_REGULAR,
    align: TextAlign = TextAlign::TopLeft,
    reject_invalid: bool = false,
    raster_physical_target_scale: float = 1.0
) -> TextLayout {
    let data = font.data()
    if data == null { return text_layout_empty(font, text, face, align) }
    let idx = data.backend_id - 1
    let divisor = font_size_divisor(idx)
    if divisor <= 0.0 {
        return text_layout_empty(font, text, face, align)
    }
    let scale = size * render_scale / divisor
    let layout = text_layout_build_scaled(font, text, scale, scale,
        face, align, reject_invalid)
    layout.raster_authored_cap_height = size
    layout.raster_layout_to_target_scale = render_scale
    layout.raster_physical_target_scale = raster_physical_target_scale
    layout.raster_target_cap_height = text_layout_raster_cap_for_scale(font, scale)
        * raster_physical_target_scale
    return layout
}

fn text_layout_cache_window_begin() {
    text_layout_cache_counts_set(TEXT_LAYOUT_CACHE_WINDOW_UI, TEXT_LAYOUT_CACHE_UI_COUNTS, TEXT_LAYOUT_CACHE_WINDOW_UI, 0)
    text_layout_cache_counts_set(TEXT_LAYOUT_CACHE_WINDOW_WORLD, TEXT_LAYOUT_CACHE_WORLD_COUNTS, TEXT_LAYOUT_CACHE_WINDOW_WORLD, 0)
    TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED = 0
    TEXT_LAYOUT_CACHE_WINDOW_HIGH_WATER = TEXT_LAYOUT_CACHE.len
    TEXT_LAYOUT_CACHE_WINDOW_OPENED = true
    TEXT_LAYOUT_CACHE_WINDOW_ACTIVE = true
}

fn text_layout_cache_window_end() {
    if !TEXT_LAYOUT_CACHE_WINDOW_ACTIVE { return () }
    text_layout_cache_counts_set(TEXT_LAYOUT_CACHE_WINDOW_UI, TEXT_LAYOUT_CACHE_UI_COUNTS, TEXT_LAYOUT_CACHE_WINDOW_UI, -1)
    text_layout_cache_counts_set(TEXT_LAYOUT_CACHE_WINDOW_WORLD, TEXT_LAYOUT_CACHE_WORLD_COUNTS, TEXT_LAYOUT_CACHE_WINDOW_WORLD, -1)
    TEXT_LAYOUT_CACHE_WINDOW_ACTIVE = false
}

pub fn text_layout_cache_clear() {
    TEXT_LAYOUT_CACHE.clear()
    TEXT_LAYOUT_CACHE_INDEX.clear()
    TEXT_LAYOUT_CACHE_CLOCK = 0
}

fn text_align_ordinal(align: TextAlign) -> int {
    match align {
        TextAlign::TopLeft => 0, TextAlign::TopCenter => 1, TextAlign::TopRight => 2,
        TextAlign::Left => 3, TextAlign::Center => 4, TextAlign::Right => 5,
        TextAlign::BottomLeft => 6, TextAlign::BottomCenter => 7,
        TextAlign::BottomRight => 8,
    }
}

@inline
fn text_layout_quantize(value: float, scale: float, modulus: int) -> int {
    let q = floor(value * scale) as int
    return ((q % modulus) + modulus) % modulus
}

// Packed into 50 bits so it stays an exact integer in a Lua number. A hash, not
// an identity: lookups confirm the exact fields.
fn text_layout_variant_key(world_raster: bool, font_id: int, face: int,
                           align: TextAlign, cap_height: bool,
                           a: float, b: float, c: float) -> int {
    let key = if world_raster { 1 } else { 0 }
    key = key * 256 + ((font_id % 256) + 256) % 256
    key = key * 4 + ((face % 4) + 4) % 4
    key = key * 16 + text_align_ordinal(align)
    key = key * 2 + if cap_height { 1 } else { 0 }
    key = key * 16384 + text_layout_quantize(a, 16.0, 16384)
    key = key * 1024 + text_layout_quantize(b, 32.0, 1024)
    key = key * 1024 + text_layout_quantize(c, 32.0, 1024)
    return key
}

fn text_layout_cache_index_add(text: string, variant: int, index: int) {
    let variants = TEXT_LAYOUT_CACHE_INDEX.get(text)
    if variants != null {
        let by_variant = variants
        let entry = TEXT_LAYOUT_CACHE[index]
        entry.next_variant_slot = by_variant.get(variant).unwrap_or(-1)
        TEXT_LAYOUT_CACHE[index] = entry
        by_variant.insert(variant, index)
    } else {
        let entry = TEXT_LAYOUT_CACHE[index]
        entry.next_variant_slot = -1
        TEXT_LAYOUT_CACHE[index] = entry
        let created: Map<int, int> = map_new()
        created.insert(variant, index)
        TEXT_LAYOUT_CACHE_INDEX.insert(text, created)
    }
}

fn text_layout_cache_index_remove(text: string, variant: int, index: int) {
    let variants = TEXT_LAYOUT_CACHE_INDEX.get(text) ?? return
    let head = variants.get(variant) ?? return
    if head == index {
        let next = TEXT_LAYOUT_CACHE[index].next_variant_slot
        if next >= 0 {
            variants.insert(variant, next)
        } else {
            let _ = variants.remove(variant)
            if variants.is_empty() { let _ = TEXT_LAYOUT_CACHE_INDEX.remove(text) }
        }
        let entry = TEXT_LAYOUT_CACHE[index]
        entry.next_variant_slot = -1
        TEXT_LAYOUT_CACHE[index] = entry
        return ()
    }

    let previous = head
    let current = TEXT_LAYOUT_CACHE[head].next_variant_slot
    while current >= 0 {
        let entry = TEXT_LAYOUT_CACHE[current]
        if current == index {
            let previous_entry = TEXT_LAYOUT_CACHE[previous]
            previous_entry.next_variant_slot = entry.next_variant_slot
            TEXT_LAYOUT_CACHE[previous] = previous_entry
            entry.next_variant_slot = -1
            TEXT_LAYOUT_CACHE[index] = entry
            return ()
        }
        previous = current
        current = entry.next_variant_slot
    }
}

fn text_layout_cache_slot(text: string, variant: int) -> int {
    let variants = TEXT_LAYOUT_CACHE_INDEX.get(text) ?? return -1
    let slot = variants.get(variant) ?? return -1
    if slot < 0 || slot >= TEXT_LAYOUT_CACHE.len { return -1 }
    return slot
}

// The slot a new entry takes: the next free index, or the least recently used
// entry, evicted here. The caller stores the entry it built straight into this
// slot so the layout is constructed in the cache's own storage; a stored copy
// would deep-copy every glyph row on each miss (Lua has no owner to move into).
fn text_layout_cache_claim_slot(counts: TextLayoutCacheCounts) -> int {
    if TEXT_LAYOUT_CACHE.len < TEXT_LAYOUT_CACHE_CAPACITY {
        return TEXT_LAYOUT_CACHE.len
    }
    let oldest_idx = 0
    let oldest_used = TEXT_LAYOUT_CACHE[0].last_used
    for i in 1..TEXT_LAYOUT_CACHE.len {
        if TEXT_LAYOUT_CACHE[i].last_used < oldest_used {
            oldest_idx = i
            oldest_used = TEXT_LAYOUT_CACHE[i].last_used
        }
    }
    counts.evictions += 1
    let old = TEXT_LAYOUT_CACHE[oldest_idx]
    text_layout_cache_index_remove(old.text, old.variant, oldest_idx)
    return oldest_idx
}

fn text_layout_cache_commit(slot: int) -> TextLayout {
    let entry = TEXT_LAYOUT_CACHE[slot]
    text_layout_cache_index_add(entry.text, entry.variant, slot)
    if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE
        && TEXT_LAYOUT_CACHE.len > TEXT_LAYOUT_CACHE_WINDOW_HIGH_WATER {
        TEXT_LAYOUT_CACHE_WINDOW_HIGH_WATER = TEXT_LAYOUT_CACHE.len
    }
    return entry.layout
}

pub fn text_layout_cached(
    font: Font,
    text: string,
    size: float,
    render_scale: float,
    align: TextAlign,
    raster_physical_target_scale: float,
    face: int = FACE_REGULAR
) -> TextLayout {
    return text_layout_cache_get(false, font, text, size, render_scale, align,
        CAP_HEIGHT_FONTS, raster_physical_target_scale, face)
}

fn text_layout_cached_world(
    font: Font,
    text: string,
    scale_x: float,
    scale_y: float,
    raster_physical_target_scale: float = -1.0,
    face: int = FACE_REGULAR
) -> TextLayout {
    let density = if raster_physical_target_scale > 0.0 {
        raster_physical_target_scale
    } else { world_text_scene_density() }
    return text_layout_cache_get(true, font, text, scale_x, scale_y, TextAlign::TopLeft,
        false, density, face)
}

fn text_layout_cache_get(world_raster: bool, font: Font, text: string, size: float,
    render_scale: float, align: TextAlign, cap_height_fonts: bool,
    raster_physical_target_scale: float, face: int) -> TextLayout {
    TEXT_LAYOUT_CACHE_CLOCK += 1
    let counts = if world_raster { TEXT_LAYOUT_CACHE_WORLD_COUNTS } else { TEXT_LAYOUT_CACHE_UI_COUNTS }
    counts.requests += 1
    let data = font.data()
    if data == null {
        let owned_text = text.clone_into(TEXT_LAYOUT_CACHE.storage)
        return text_layout_empty(font, owned_text, face, align)
    }
    let font_id = data.backend_id
    let variant = text_layout_variant_key(world_raster, font_id, face, align,
        cap_height_fonts, size, render_scale, raster_physical_target_scale)
    let examined = 0
    let hit = -1
    let slot = text_layout_cache_slot(text, variant)
    while slot >= 0 {
        examined += 1
        let entry = TEXT_LAYOUT_CACHE[slot]
        if entry.world_raster == world_raster && entry.font_id == font_id
            && entry.text == text
            && entry.size == size
            && entry.render_scale == render_scale
            && entry.cap_height_fonts == cap_height_fonts
            && entry.align == align
            && entry.layout.face == face
            && entry.raster_physical_target_scale == raster_physical_target_scale {
            hit = slot
            break
        }
        slot = entry.next_variant_slot
    }
    counts.entries_examined += examined
    if TEXT_LAYOUT_CACHE_WINDOW_ACTIVE && examined > TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED {
        TEXT_LAYOUT_CACHE_WINDOW_MAX_ENTRIES_EXAMINED = examined
    }
    if hit >= 0 {
        let entry = TEXT_LAYOUT_CACHE[hit]
        entry.last_used = TEXT_LAYOUT_CACHE_CLOCK
        counts.hits += 1
        return entry.layout
    }
    counts.misses += 1
    let owned_text = text.clone_into(TEXT_LAYOUT_CACHE.storage)
    let layout = if world_raster {
        text_layout_build_scaled(font, owned_text, size, render_scale,
            face, align, false, true, "", raster_physical_target_scale)
    } else {
        text_layout_build(font, owned_text, size, render_scale,
            face: face, align: align,
            raster_physical_target_scale: raster_physical_target_scale)
    }
    counts.builds += 1
    let entry = TextLayoutCacheEntry {
        font_id: font_id,
        text: owned_text,
        size: size,
        render_scale: render_scale,
        world_raster: world_raster,
        cap_height_fonts: cap_height_fonts,
        align: align,
        raster_physical_target_scale: raster_physical_target_scale,
        variant: variant,
        next_variant_slot: -1,
        last_used: TEXT_LAYOUT_CACHE_CLOCK,
        layout: layout,
    }
    let slot = text_layout_cache_claim_slot(counts)
    if slot == TEXT_LAYOUT_CACHE.len {
        TEXT_LAYOUT_CACHE.push(entry)
    } else {
        TEXT_LAYOUT_CACHE[slot] = entry
    }
    return text_layout_cache_commit(slot)
}

pub fn text_layout_aligned_origin(layout: TextLayout, anchor: Vec2) -> Vec2 {
    return anchor + layout.alignment_offset
}

pub fn text_layout_identity_poses(layout: TextLayout) -> [GlyphPose] {
    let poses: [GlyphPose] = []
    for glyph in layout.glyphs {
        poses.push(GlyphPose {
            glyph_index: glyph.glyph_index,
            source_index: glyph.source_index,
            glyph: glyph.glyph,
            translation: v(),
            scale: v(1.0, 1.0),
            rotation: 0.0,
        })
    }
    return poses
}

fn text_layout_pose_at(layout: TextLayout, index: int, poses: [GlyphPose]?) -> GlyphPose? {
    if poses == null { return null }
    let all = poses
    if all.len != layout.glyphs.len {
        error("text layout pose count {all.len} does not match glyph count {layout.glyphs.len}")
    }
    let pose = all[index]
    let glyph = layout.glyphs[index]
    if pose.glyph_index != glyph.glyph_index
        || pose.source_index != glyph.source_index
        || pose.glyph != glyph.glyph {
        error("text layout pose {index} does not match glyph identity")
    }
    return pose
}

fn text_layout_validate_poses(layout: TextLayout, poses: [GlyphPose]) {
    if poses.len != layout.glyphs.len {
        error("text layout pose count {poses.len} does not match glyph count {layout.glyphs.len}")
    }
    for i in 0..poses.len {
        let pose = poses[i]
        let glyph = layout.glyphs[i]
        if pose.glyph_index != glyph.glyph_index
            || pose.source_index != glyph.source_index
            || pose.glyph != glyph.glyph {
            error("text layout pose {i} does not match glyph identity")
        }
    }
}

fn text_layout_pose_point(glyph_pivot: Vec2, point: Vec2, pose: GlyphPose?) -> Vec2 {
    if pose == null { return point }
    let p = pose
    if p.translation == v() && p.scale == v(1.0, 1.0) && p.rotation == 0.0 {
        return point
    }
    return glyph_pivot + ((point - glyph_pivot) * p.scale).rotate(p.rotation)
        + p.translation
}

pub fn text_layout_glyph_bounds(layout: TextLayout, index: int, poses: [GlyphPose]?) -> Rect {
    let glyph = layout.glyphs[index]
    let pose = text_layout_pose_at(layout, index, poses)
    let a = text_layout_pose_point(glyph.pivot, v(glyph.ink.x, glyph.ink.y), pose)
    let b = text_layout_pose_point(glyph.pivot, v(glyph.ink.x + glyph.ink.w, glyph.ink.y), pose)
    let c = text_layout_pose_point(
        glyph.pivot,
        v(glyph.ink.x + glyph.ink.w,
            glyph.ink.y + glyph.ink.h),
        pose
    )
    let d = text_layout_pose_point(
        glyph.pivot, v(glyph.ink.x, glyph.ink.y + glyph.ink.h), pose)
    let lo = v(min(min(a.x, b.x), min(c.x, d.x)), min(min(a.y, b.y), min(c.y, d.y)))
    let hi = v(max(max(a.x, b.x), max(c.x, d.x)), max(max(a.y, b.y), max(c.y, d.y)))
    return rect(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y)
}

fn text_layout_cache_key(layout: TextLayout) -> string {
    let font_id = if layout.font == null { 0 } else {
        layout.font.data()?.backend_id
    }
    return "{font_id}:{layout.text}:{layout.face}:{layout.line_height:.5}:{layout.logical_bounds.x:.5}:{layout.logical_bounds.y:.5}:{layout.logical_bounds.w:.5}:{layout.logical_bounds.h:.5}:{layout.alignment_offset.x:.5}:{layout.alignment_offset.y:.5}"
}

fn text_world_layout_scaled(
    font: Font,
    text: string,
    scale_x: float,
    scale_y: float
) -> TextLayout {
    return text_layout_cached_world(font, text, scale_x, scale_y)
}

// `render_scale` is explicit: FONT_RENDER_SCALE is the output's window/DPI factor
// and is wrong on a surface authored in scene texels.
pub fn queue_ui_text_scaled(
    font: Font,
    text: string,
    pos: Vec2,
    size: float,
    color: Color,
    offset: Vec2,
    z_layer: int,
    render_scale: float,
    align: TextAlign = TextAlign::TopLeft,
    raster_physical_target_scale: float = 1.0
) {
    if text.len() == 0 { return }
    let d = font.data() ?? return
    let idx = d.backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len || idx >= GLYPH_CACHES.len
        || GLYPH_CACHES[idx].len <= FACE_REGULAR
        || GLYPH_CACHES[idx][FACE_REGULAR].len == 0
        || font_size_divisor(idx) <= 0.0 { return }
    let layout = text_layout_cached(font, text, size, render_scale,
        align, raster_physical_target_scale)
    emit_ui_text_layout(layout, pos, color, offset, z_layer)
}

fn emit_ui_text_layout(
    layout: TextLayout,
    pos: Vec2,
    color: Color,
    offset: Vec2,
    z_layer: int
) {
    if layout.glyphs.len == 0 { return }
    let anchor = pos + offset * v(layout.logical_bounds.w, layout.logical_bounds.h)
    let origin = text_layout_aligned_origin(layout, anchor)
    let _ = text_layout_emit(layout, origin, color, z_layer)
}

pub struct ResolvedTextRun {
    text: string,
    font: Font,
    face: int,
    size: float,
    scale_divisor: float,
    color: Color,
    raster_physical_target_scale: float = 1.0,
    layout: TextLayout? = null,
    // Whole-run scale applied at measure and emit time, so a size that
    // animates every frame reuses one layout built at the base size.
    draw_scale: float = 1.0,
}

pub struct ResolvedTextLine {
    runs: [ResolvedTextRun],
    width: float,
    ascent: float,
    height: float,
}

pub value ResolvedPlainText {
    lines: [ResolvedTextLine],
    width: float,
    ascent: float,
    height: float,
    line_height: float,
}

// An explicit family resolves every handle and atlas up front; legacy
// single-Font calls retain their documented stale-handle no-op.
//
// `require_atlas` separates the two questions this used to answer as one. Batch
// state, a glyph cache and usable metrics are what LAYOUT needs; an atlas page
// is a GL texture, which only EMISSION needs. A metrics-only font
// (`load_font_metrics`, the code-test process) has every metric and no page, so
// a measurement that demanded a page refused a font it never had to touch.
// The default is the draw requirement, so an emitting caller that says nothing
// keeps it; the measurement entry points opt out by name.
pub fn text_family_font_idx(font: Font, site: string, require_atlas: bool = true) -> int {
    let fd = font.data()
    if fd == null { error("{site}: stale font handle -- the font was unloaded") }
    let d = fd.unwrap()
    let idx = d.backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len
        || idx >= FONT_CP_SLOTS.len || idx >= GLYPH_CACHES.len {
        error("{site}: font {d.backend_id} has no batch state")
    }
    if require_atlas && FONT_ATLASES[idx] == Image(0) {
        error("{site}: font {d.backend_id} has no usable atlas")
    }
    if FACE_REGULAR < 0 || FACE_REGULAR >= GLYPH_CACHES[idx].len
        || GLYPH_CACHES[idx][FACE_REGULAR].len == 0 {
        error("{site}: font {d.backend_id} has no glyph cache")
    }
    if font_size_divisor(idx) <= 0.0 {
        error("{site}: font {d.backend_id} has no usable metrics")
    }
    return idx
}

fn text_family_indices_into(family: TextFamily, site: string, require_atlas: bool,
    fonts: [Font], indices: [int]) {
    fonts.clear()
    indices.clear()
    fonts.push(family.regular)
    for fallback in family.fallbacks { fonts.push(fallback) }
    for font in fonts { indices.push(text_family_font_idx(font, site, require_atlas)) }
}

pub fn text_family_indices(family: TextFamily, site: string,
    require_atlas: bool = true) -> ([Font], [int]) {
    let fonts: [Font] = []
    let indices: [int] = []
    text_family_indices_into(family, site, require_atlas, fonts, indices)
    return (fonts, indices)
}

fn text_supported_slot(idx: int, text: string, at: int, face: int) -> int {
    if idx < 0 || idx >= FONT_CP_SLOTS.len || idx >= GLYPH_CACHES.len {
        return -1
    }
    if face < 0 || face >= GLYPH_CACHES[idx].len { return -1 }
    let slot = text_glyph_slot(FONT_CP_SLOTS[idx], text, at)
    let glyphs = GLYPH_CACHES[idx][face]
    if slot < 0 || slot >= glyphs.len { return -1 }
    if !glyphs[slot].valid { return -1 }
    return slot
}

fn text_codepoint_end(text: string, at: int) -> int {
    let end = at + 1
    while end < text.len() && text_codepoint_at(text, end) == -1 {
        end = end + 1
    }
    return end
}

fn text_select_font(indices: [int], text: string, at: int) -> int {
    for i in 0..indices.len {
        if text_supported_slot(indices[i], text, at, FACE_REGULAR) >= 0 {
            return i
        }
    }
    return -1
}

pub enum TextMissingGlyphPolicy {
    Reject,
    Substitute,
}

pub global TEXT_MISSING_GLYPH_POLICY: TextMissingGlyphPolicy = TextMissingGlyphPolicy::Substitute

// Memo for text_prepare_missing_glyphs. Preparation is a pure function of the
// text, the font set, TEXT_MISSING_GLYPH_POLICY and the loaded fonts' glyph
// coverage, and every drawn string re-ran its per-codepoint loop every frame.
// Two levels rather than one composite key so the lookup is two table reads:
// building a "{set}:{text}" key would allocate on the hot path it exists to
// clear.
//
// The bound is a capacity with a FULL clear, not the layout cache's LRU: drawn
// text is largely per-frame dynamic (damage numbers, timers, coordinates), so
// the working set turns over wholesale rather than aging, and an eviction scan
// would cost more than re-preparing the live strings after a clear.
const TEXT_PREPARE_CACHE_CAPACITY: int = 512

const TEXT_PREPARE_KEY_RADIX: int = 4096
const TEXT_PREPARE_KEY_MAX_FONTS: int = 4

global TEXT_PREPARE_CACHE: Map<int, Map<string, string>> = map_new()
global TEXT_PREPARE_CACHE_ENTRIES: int = 0
global TEXT_PREPARE_CACHE_POLICY: TextMissingGlyphPolicy = TextMissingGlyphPolicy::Substitute

// Must be called from every writer of GLYPH_CACHES and FONT_CP_SLOTS.
fn text_prepare_cache_clear() {
    TEXT_PREPARE_CACHE = map_new()
    TEXT_PREPARE_CACHE_ENTRIES = 0
    TEXT_PREPARE_CACHE_POLICY = TEXT_MISSING_GLYPH_POLICY
    text_validate_cache_clear()
}

fn text_prepare_font_set_key(indices: [int]?, single_idx: int) -> int {
    if let family_indices = indices {
        if family_indices.len > TEXT_PREPARE_KEY_MAX_FONTS { return -1 }
        let key = family_indices.len
        for i in 0..family_indices.len {
            let idx = family_indices[i]
            if idx < 0 || idx >= TEXT_PREPARE_KEY_RADIX { return -1 }
            key = key * TEXT_PREPARE_KEY_RADIX + idx + 1
        }
        return key
    }
    if single_idx < 0 || single_idx >= TEXT_PREPARE_KEY_RADIX { return -1 }
    return TEXT_PREPARE_KEY_RADIX + single_idx + 1
}

fn text_prepare_cache_store(set_key: int, text: string, prepared: string) {
    if TEXT_PREPARE_CACHE_ENTRIES >= TEXT_PREPARE_CACHE_CAPACITY {
        text_prepare_cache_clear()
    }
    if let by_text = TEXT_PREPARE_CACHE.get(set_key) {
        by_text.insert(text, prepared)
    } else {
        let created: Map<string, string> = map_new()
        created.insert(text, prepared)
        TEXT_PREPARE_CACHE.insert(set_key, created)
    }
    TEXT_PREPARE_CACHE_ENTRIES += 1
}

pub @pure fn text_missing_glyph_policy_for_run(sim: bool, max_frames: int,
                                            perf_seconds: float) -> TextMissingGlyphPolicy {
    if sim || max_frames > 0 || perf_seconds > 0.0 {
        return TextMissingGlyphPolicy::Reject
    }
    return TextMissingGlyphPolicy::Substitute
}

fn text_missing_glyph_reject(site: string, text: string, at: int, cp: int) {
    if cp < 256 {
        error("{site}: byte {text.unit_at(at)} at offset {at} of {text.len()} starts codepoint {cp}, but no family font renders it")
    }
    error("{site}: codepoint {cp} at offset {at} of {text.len()} is not renderable by any family font")
}

fn text_missing_glyph_log(font: Font, site: string, cp: int) {
    let data = font.data().unwrap()
    log_once("TEXT",
        "{site}: codepoint {cp} is not renderable by the family rooted at {data.path}; substituting '?'",
        "text-missing-glyph:{data.backend_id}:{cp}")
}

fn text_missing_glyph_owner(indices: [int]?, single_idx: int,
                            text: string, at: int) -> int {
    if let family_indices = indices {
        return text_select_font(family_indices, text, at)
    }
    return if text_supported_slot(single_idx, text, at, FACE_REGULAR) >= 0 {
        0
    } else { -1 }
}

pub fn text_prepare_missing_glyphs(primary: Font, indices: [int]?, single_idx: int,
                               text: string, site: string) -> string {
    let set_key = text_prepare_font_set_key(indices, single_idx)
    if set_key < 0 {
        return text_prepare_missing_glyphs_uncached(primary, indices, single_idx,
            text, site)
    }
    if TEXT_PREPARE_CACHE_POLICY != TEXT_MISSING_GLYPH_POLICY {
        text_prepare_cache_clear()
    }
    if let by_text = TEXT_PREPARE_CACHE.get(set_key) {
        if let hit = by_text.get(text) { return hit }
    }
    let prepared = text_prepare_missing_glyphs_uncached(primary, indices,
        single_idx, text, site)
    text_prepare_cache_store(set_key, text, prepared)
    return prepared
}

fn text_prepare_missing_glyphs_uncached(primary: Font, indices: [int]?,
                                        single_idx: int,
                                        text: string, site: string) -> string {
    let prepared = ""
    let copy_from = 0
    let changed = false
    let i = 0
    while i < text.len() {
        let cp = text_codepoint_at(text, i)
        if cp == -2 || cp < 0 {
            i += 1
            continue
        }
        let end = text_codepoint_end(text, i)
        if cp == 10 || cp == 13 || cp == 9
            || text_missing_glyph_owner(indices, single_idx, text, i) >= 0 {
            i = end
            continue
        }
        if TEXT_MISSING_GLYPH_POLICY == TextMissingGlyphPolicy::Reject {
            text_missing_glyph_reject(site, text, i, cp)
        }
        if text_missing_glyph_owner(indices, single_idx, "?", 0) < 0 {
            error("{site}: codepoint {cp} is not renderable and no family font renders the replacement '?'")
        }
        text_missing_glyph_log(primary, site, cp)
        prepared = prepared + text.substring(copy_from, i) + "?"
        copy_from = end
        changed = true
        i = end
    }
    if !changed { return text }
    return prepared + text.substring(copy_from, text.len())
}

fn text_face(font: Font, idx: int, style: TextStyle, cp: int, at: int, site: string) -> int {
    let d = font.data().unwrap()
    let face = style_face_index(style)
    if !faces_declare(d.faces, face) {
        error("{site}: codepoint {cp} at offset {at} selected {d.path}, which declares no {face_name(face)} face -- pass faces: TextFaces {{ bold: true, italic: true }} to load_font")
    }
    if face < 0 || face >= GLYPH_CACHES[idx].len
        || GLYPH_CACHES[idx][face].len == 0 {
        error("{site}: codepoint {cp} at offset {at} selected font {d.backend_id}, which declares a {face_name(face)} face but baked no glyphs for it")
    }
    return face
}

fn text_face_divisor(font: Font, world_raster: bool, site: string) -> float {
    let data = font.data()
    if data == null { error("{site}: selected font is stale") }
    let d = data.unwrap()
    let idx = d.backend_id - 1
    let divisor = if world_raster {
        if idx < 0 || idx >= FONT_UNIT_SIZES.len { 0.0 }
        else { FONT_UNIT_SIZES[idx] }
    } else {
        font_size_divisor(idx)
    }
    if divisor <= 0.0 { error("{site}: selected font {d.backend_id} has no usable text divisor") }
    return divisor
}

fn text_make_run(
    text: string,
    from: int,
    to: int,
    font: Font,
    face: int,
    size: float,
    divisor: float,
    color: Color
) -> ResolvedTextRun {
    let part = if from == 0 && to == text.len() { text } else { text.substring(from, to) }
    if let run = TEXT_RUN_SPARE.pop() {
        run.text = part
        run.font = font
        run.face = face
        run.size = size
        run.scale_divisor = divisor
        run.color = color
        run.raster_physical_target_scale = 1.0
        run.layout = null
        run.draw_scale = 1.0
        return run
    }
    return ResolvedTextRun {
        text: part,
        font: font,
        face: face,
        size: size,
        scale_divisor: divisor,
        color: color,
    }
}

global TEXT_RUN_SPARE: [ResolvedTextRun] = []
const TEXT_RUN_SPARE_MAX: int = 512

pub fn text_runs_release(runs: [ResolvedTextRun]) {
    for run in runs {
        if TEXT_RUN_SPARE.len() >= TEXT_RUN_SPARE_MAX { break }
        run.layout = null
        TEXT_RUN_SPARE.push(run)
    }
    runs.clear()
}

fn text_run_size(font: Font, size: float, render_scale: float, world_raster: bool) -> float {
    return if world_raster {
        world_text_em_for(font, size)
    } else {
        size * render_scale
    }
}

global TEXT_VALIDATE_CACHE: Map<int, Map<string, int>> = map_new()
pub global TEXT_VALIDATE_CACHE_ENTRIES: int = 0

fn text_validate_cache_clear() {
    TEXT_VALIDATE_CACHE = map_new()
    TEXT_VALIDATE_CACHE_ENTRIES = 0
}

pub fn text_validate_single_font_span(
    font: Font,
    idx: int,
    text: string,
    style: TextStyle,
    reject_line_controls: bool,
    site: string
) -> int {
    if idx < 0 {
        return text_validate_single_font_span_uncached(font, idx, text, style,
            reject_line_controls, site)
    }
    let key = (idx * 4 + style_face_index(style)) * 2
        + if reject_line_controls { 1 } else { 0 }
    if let by_text = TEXT_VALIDATE_CACHE.get(key) {
        if let hit = by_text.get(text) { return hit }
    }
    let face = text_validate_single_font_span_uncached(font, idx, text, style,
        reject_line_controls, site)
    if TEXT_VALIDATE_CACHE_ENTRIES >= TEXT_PREPARE_CACHE_CAPACITY {
        text_validate_cache_clear()
    }
    if let by_text = TEXT_VALIDATE_CACHE.get(key) {
        by_text.insert(text, face)
    } else {
        let created: Map<string, int> = map_new()
        created.insert(text, face)
        TEXT_VALIDATE_CACHE.insert(key, created)
    }
    TEXT_VALIDATE_CACHE_ENTRIES += 1
    return face
}

fn text_validate_single_font_span_uncached(
    font: Font,
    idx: int,
    text: string,
    style: TextStyle,
    reject_line_controls: bool,
    site: string
) -> int {
    let face = -1
    let i = 0
    while i < text.len() {
        let unit = text.unit_at(i)
        if reject_line_controls && (unit == 10 || unit == 13 || unit == 9) {
            error("{site}: rich text is one line -- byte {unit} at offset {i} of {text.len()} is a line control")
        }
        let cp = text_codepoint_at(text, i)
        if cp == -2 {
            error("{site}: byte {unit} at offset {i} of {text.len()} starts a malformed sequence")
        }
        if cp < 0 {
            i += 1
            continue
        }
        if text_supported_slot(idx, text, i, FACE_REGULAR) < 0 {
            text_missing_glyph_reject(site, text, i, cp)
        }
        let resolved = text_face(font, idx, style, cp, i, site)
        if text_supported_slot(idx, text, i, resolved) < 0 {
            let d = font.data().unwrap()
            error("{site}: codepoint {cp} at offset {i} selected font {d.backend_id}, but its {face_name(resolved)} face has no valid glyph")
        }
        face = resolved
        i = text_codepoint_end(text, i)
    }
    return face
}

pub fn text_resolve_segment(
    runs: [ResolvedTextRun],
    fonts: [Font],
    indices: [int],
    text: string,
    size: float,
    render_scale: float,
    world_raster: bool,
    style: TextStyle,
    reject_line_controls: bool,
    site: string
) {
    if fonts.len == 1 && indices.len == 1 {
        let font = fonts[0]
        let prepared = text_prepare_missing_glyphs(
            font, null, indices[0], text, site)
        let face = text_validate_single_font_span(
            font, indices[0], prepared, style, reject_line_controls, site)
        if face >= 0 {
            runs.push(text_make_run(prepared, 0, prepared.len(), font, face,
                text_run_size(font, size, render_scale, world_raster),
                text_face_divisor(font, world_raster, site), style.color))
        }
        return
    }
    let prepared = text_prepare_missing_glyphs(fonts[0], indices, -1, text, site)
    let selected = -1
    let selected_face = -1
    let run_start = 0
    let i = 0
    while i < prepared.len() {
        let unit = prepared.unit_at(i)
        if reject_line_controls && (unit == 10 || unit == 13 || unit == 9) {
            error("{site}: rich text is one line -- byte {unit} at offset {i} of {prepared.len()} is a line control")
        }
        let cp = text_codepoint_at(prepared, i)
        if cp == -2 {
            error("{site}: byte {unit} at offset {i} of {prepared.len()} starts a malformed sequence")
        }
        if cp < 0 {
            i = i + 1
            continue
        }
        let owner = text_select_font(indices, prepared, i)
        if owner < 0 {
            text_missing_glyph_reject(site, prepared, i, cp)
        }
        let font = fonts[owner]
        let idx = indices[owner]
        let face = text_face(font, idx, style, cp, i, site)
        if text_supported_slot(idx, prepared, i, face) < 0 {
            let d = font.data().unwrap()
            error("{site}: codepoint {cp} at offset {i} selected font {d.backend_id}, but its {face_name(face)} face has no valid glyph")
        }
        let end = text_codepoint_end(prepared, i)
        if selected != owner || selected_face != face {
            if selected >= 0 {
                let previous = fonts[selected]
                runs.push(
                    text_make_run(prepared, run_start, i, previous,
                        selected_face,
                        text_run_size(previous, size, render_scale, world_raster),
                        text_face_divisor(previous, world_raster, site),
                        style.color)
                )
            }
            selected = owner
            selected_face = face
            run_start = i
        }
        i = end
    }
    if selected >= 0 {
        let font = fonts[selected]
        runs.push(
            text_make_run(prepared, run_start, prepared.len(), font,
                selected_face,
                text_run_size(font, size, render_scale, world_raster),
                text_face_divisor(font, world_raster, site), style.color)
        )
    }
    return
}

fn resolve_text_spans_at(
    runs: [ResolvedTextRun],
    family: TextFamily,
    spans: [TextSpan],
    size: float,
    render_scale: float,
    world_raster: bool,
    site: string,
    raster_physical_target_scale: float = 1.0,
    require_atlas: bool = true,
    build_layouts: bool = true
) {
    static fonts: [Font] = []
    static indices: [int] = []
    text_family_indices_into(family, site, require_atlas, fonts, indices)
    runs.clear()
    for span in spans {
        let start = runs.len()
        text_resolve_segment(runs, fonts, indices, span.text,
            size, render_scale, world_raster, span.style, true, site)
        for i in start..runs.len() {
            let run = runs[i]
            let scale = resolved_run_scale(run)
            let layout: TextLayout? = if !build_layouts {
                null
            } else if world_raster {
                text_layout_cached_world(run.font, run.text, scale, scale,
                    raster_physical_target_scale: 1.0, face: run.face)
            } else {
                text_layout_cached(run.font, run.text, size, render_scale,
                    TextAlign::TopLeft, raster_physical_target_scale,
                    face: run.face)
            }
            if let built = layout { run.text = built.text }
            run.raster_physical_target_scale = raster_physical_target_scale
            run.layout = layout
        }
    }
}

pub fn resolve_text_spans(
    family: TextFamily,
    spans: [TextSpan],
    size: float,
    render_scale: float,
    site: string,
    raster_physical_target_scale: float = 1.0,
    require_atlas: bool = true
) -> [ResolvedTextRun] {
    let runs: [ResolvedTextRun] = []
    resolve_text_spans_at(runs, family, spans, size, render_scale,
        false, site, raster_physical_target_scale, require_atlas)
    return runs
}

pub fn resolve_world_text_spans(
    family: TextFamily,
    spans: [TextSpan],
    size: float,
    site: string,
    require_atlas: bool = true
) -> [ResolvedTextRun] {
    let runs: [ResolvedTextRun] = []
    resolve_text_spans_at(runs, family, spans, size, 1.0, true, site, 1.0, require_atlas)
    return runs
}

pub fn plain_text_layout_from_lines(
    lines: [ResolvedTextLine]
) -> ResolvedPlainText {
    let width = 0.0
    let ascent = 0.0
    let below_baseline = 0.0
    for line in lines {
        if line.width > width { width = line.width }
        if line.ascent > ascent { ascent = line.ascent }
        let line_below = line.height - line.ascent
        if line_below > below_baseline { below_baseline = line_below }
    }
    let line_height = ascent + below_baseline
    let height = lines.len as float * line_height
    return ResolvedPlainText {
        lines: lines,
        width: width,
        ascent: ascent,
        height: height,
        line_height: line_height,
    }
}

fn resolve_plain_text_layout_at(
    family: TextFamily,
    text: string,
    size: float,
    render_scale: float,
    world_raster: bool,
    site: string,
    require_atlas: bool = true
) -> ResolvedPlainText {
    let (fonts, indices) = text_family_indices(family, site, require_atlas)
    let lines: [ResolvedTextLine] = []
    let line_start = 0
    let i = 0
    while i <= text.len() {
        if i == text.len() || text.unit_at(i) == 10 {
            let line_text = text.substring(line_start, i)
            let runs: [ResolvedTextRun] = []
            text_resolve_segment(runs, fonts, indices, line_text,
                size, render_scale, world_raster, TextStyle {}, false, site)
            let (width, ascent, height) = measure_resolved_runs(runs)
            for run in runs {
                run.text = run.layout.unwrap().text
            }
            lines.push(ResolvedTextLine {
                runs: runs,
                width: width,
                ascent: ascent,
                height: height,
            })
            line_start = i + 1
        }
        i = i + 1
    }
    return plain_text_layout_from_lines(lines)
}

pub fn resolve_plain_text_layout(
    family: TextFamily,
    text: string,
    size: float,
    render_scale: float,
    site: string,
    require_atlas: bool = true
) -> ResolvedPlainText {
    return resolve_plain_text_layout_at(family, text, size, render_scale,
        false, site, require_atlas)
}

pub fn resolve_plain_world_text_layout(
    family: TextFamily,
    text: string,
    size: float,
    site: string
) -> ResolvedPlainText {
    return resolve_plain_text_layout_at(family, text, size, 1.0,
        true, site)
}

pub fn resolved_run_scale(run: ResolvedTextRun) -> float {
    return run.size / run.scale_divisor
}

// The run's layout, built once on first use. Measurement and emission read
// through here, so they always walk the same layout.
fn resolved_run_layout(run: ResolvedTextRun) -> TextLayout {
    if let layout = run.layout { return layout }
    let scale = resolved_run_scale(run)
    let built = text_layout_cached_world(run.font, run.text, scale, scale,
        run.raster_physical_target_scale, run.face)
    run.layout = built
    return built
}

pub fn measure_resolved_runs(runs: [ResolvedTextRun]) -> (float, float, float) {
    let total = 0.0
    let max_ascent = 0.0
    let max_below_baseline = 0.0
    for run in runs {
        let layout = resolved_run_layout(run)
        let k = run.draw_scale
        total = total + layout.logical_bounds.w * k
        if layout.ascent * k > max_ascent { max_ascent = layout.ascent * k }
        let below_baseline = (layout.logical_bounds.h - layout.ascent) * k
        if below_baseline > max_below_baseline {
            max_below_baseline = below_baseline
        }
    }
    return (total, max_ascent, max_ascent + max_below_baseline)
}

pub enum TextPlacement {
    Output,
    Target,
    World,
}

pub fn emit_resolved_runs(
    runs: [ResolvedTextRun],
    placement: TextPlacement,
    start: Vec2,
    max_ascent: float,
    z_layer: int,
    tint: Color? = null,
    depth: DepthMode = DepthMode::Off,
    consumer_key: string = ""
) {
    let pen = start.x
    for run in runs {
        let layout = resolved_run_layout(run)
        let k = run.draw_scale
        let color = tint ?? run.color
        let _ = match placement {
            TextPlacement::Output => text_layout_emit(layout,
                v(pen, start.y + max_ascent - layout.ascent * k), color, z_layer,
                consumer_key: consumer_key, layout_scale: k),
            TextPlacement::Target => text_layout_emit(layout,
                v(pen, start.y + max_ascent - layout.ascent * k), color, z_layer,
                placement: placement),
            TextPlacement::World => text_layout_emit(layout, v(pen, start.y), color, z_layer,
                placement: placement, depth: depth),
        }
        pen += layout.logical_bounds.w * k
    }
}

pub fn emit_plain_text_layout(
    layout: ResolvedPlainText,
    placement: TextPlacement,
    start: Vec2,
    z_layer: int,
    tint: Color? = null,
    depth: DepthMode = DepthMode::Off
) {
    let line_y = start.y
    for line in layout.lines {
        emit_resolved_runs(line.runs, placement, v(start.x, line_y),
            layout.ascent, z_layer, tint, depth)
        line_y += layout.line_height
    }
}

pub fn measure_rich_text_of(
    family: TextFamily,
    spans: [TextSpan],
    size: float,
    render_scale: float
) -> Vec2 {
    let runs = resolve_text_spans(family, spans, size, render_scale, "measure_rich_text_of",
        require_atlas: false)
    let (w, _a, h) = measure_resolved_runs(runs)
    return v(w, h)
}

fn measure_rich_text_single_font(
    font: Font,
    spans: [TextSpan],
    size: float,
    render_scale: float
) -> Vec2 {
    let idx = text_family_font_idx(font, "measure_rich_text_of", require_atlas: false)
    let width = 0.0
    let max_ascent = 0.0
    let max_below_baseline = 0.0
    for span in spans {
        if span.text.len() == 0 { continue }
        let prepared = text_prepare_missing_glyphs(font, null, idx, span.text,
            "measure_rich_text_of")
        let face = text_validate_single_font_span(
            font, idx, prepared, span.style, true, "measure_rich_text_of")
        if face < 0 { continue }
        let layout = text_layout_cached(font, prepared, size, render_scale,
            TextAlign::TopLeft, 1.0, face: face)
        width += layout.logical_bounds.w
        if layout.ascent > max_ascent { max_ascent = layout.ascent }
        let below_baseline = layout.logical_bounds.h - layout.ascent
        if below_baseline > max_below_baseline {
            max_below_baseline = below_baseline
        }
    }
    return v(width, max_ascent + max_below_baseline)
}

fn measure_rich_text_single_font_text(
    font: Font,
    text: string,
    color: Color,
    bold: bool,
    italic: bool,
    size: float,
    render_scale: float
) -> Vec2 {
    let idx = text_family_font_idx(font, "measure_rich_text_of", require_atlas: false)
    let style = TextStyle { color: color, bold: bold, italic: italic }
    let prepared = text_prepare_missing_glyphs(font, null, idx, text,
        "measure_rich_text_of")
    let face = text_validate_single_font_span(
        font, idx, prepared, style, true, "measure_rich_text_of")
    if face < 0 { return v() }
    let layout = text_layout_cached(font, prepared, size, render_scale,
        TextAlign::TopLeft, 1.0, face: face)
    return v(layout.logical_bounds.w, layout.logical_bounds.h)
}

pub fn measure_world_rich_text(spans: [TextSpan], size: float) -> Vec2 {
    let (w, _a, h) = measure_world_rich_text_at(spans, size, "measure_world_rich_text")
    return v(w, h)
}

pub fn measure_world_rich_text_metrics(spans: [TextSpan], size: float) -> (float, float, float) {
    return measure_world_rich_text_at(spans, size, "measure_world_rich_text_metrics")
}

fn measure_world_rich_text_at(spans: [TextSpan], size: float, site: string) -> (float, float, float) {
    static runs: [ResolvedTextRun] = []
    resolve_text_spans_at(runs, text_family_or_default(), spans, size, 1.0, true, site, 1.0, false)
    let (w, ascent, h) = measure_resolved_runs(runs)
    text_runs_release(runs)
    return (w, ascent, h)
}

pub fn measure_plain_text_of(
    family: TextFamily,
    text: string,
    size: float,
    render_scale: float
) -> Vec2 {
    let layout = resolve_plain_text_layout(family, text, size, render_scale,
        "measure_plain_text_of", require_atlas: false)
    return v(layout.width, layout.height)
}

@pure fn make_world_text_vertex(
    x: float,
    y: float,
    u: float,
    v_: float,
    color: Color,
    py: float
) -> Vertex {
    return Vertex {
        pos: Vec2f { x: x, y: y },
        uv: Vec2f { x: u, y: v_ },
        color: Vec4f { x: color.r, y: color.g, z: color.b, w: color.a },
        pivot_y: py,
        entity_id: 0.0,
        colorize: 0.0,
    }
}

fn queue_world_text_layout(
    layout: TextLayout,
    x: float,
    y: float,
    color: Color,
    z_layer: int,
    depth: DepthMode
) {
    let _ = text_layout_emit(layout, v(x, y), color, z_layer, placement: TextPlacement::World,
        depth: depth)
}

pub fn measure_text(text: string, font_size: float, family: TextFamily? = null,
    font: Font? = null) -> Vec2 {
    if font != null && family != null { error("measure_text: pass either font or family, not both") }
    if family != null {
        return measure_plain_text_of(family, text, font_size,
            FONT_RENDER_SCALE)
    }
    let f = font ?? DEFAULT_FONT ?? return Vec2 { x: 0.0, y: 0.0 }
    return measure_text_of(f, text, font_size, FONT_RENDER_SCALE, text_output_raster_density())
}
