// Grayscale depth preview (`draw_depth_buffer_preview`, debug.rock). Gamma-curves the
// sampled depth so near-flat depth ranges stay visually separable.
//
// Compiled in-game via `rock_shader(depth_visualize_frag)` (single-arg
// fullscreen form).

// The world pass's own depth attachment, bound by
// `shader_bind_canvas_depth(depth_visualize_shader, "depth_tex", screen_canvas)`.
// A `@textures` slot rather than a loose sampler, so an unbound preview fails
// the per-draw audit instead of silently showing whatever is on unit 0 -- the
// call immediately before this one is a text draw, so that is the font atlas.
struct DepthTex {
    depth_tex: Sampler2D,
}

@shader(fragment)
fn depth_visualize_frag(@textures t: DepthTex, tc: Vec2) -> Vec4 {
    // A DEPTH_COMPONENT texture reads its stored value in .x; the other
    // components are (0, 0, 1) and mean nothing.
    let depth = texture(t.depth_tex, tc).x

    let visualized = pow(depth, 2.2)

    return v(visualized, visualized, visualized, 1.0)
}
