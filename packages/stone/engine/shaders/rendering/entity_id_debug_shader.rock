// An integer sampler: the id canvas is r32i, and a float sampler read is undefined.
struct EntityIdTex {
    id_buffer: ISampler2D,
}

@shader(fragment)
fn entity_id_debug_frag(@textures t: EntityIdTex, tc: Vec2) -> Vec4 {
    let id = texture_id(t.id_buffer, tc)
    if id <= 0 {
        discard()
    }

    let idf = int_to_float(id)
    let c = v(
        fract(idf * 0.613 + 0.1),
        fract(idf * 0.337 + 0.5),
        fract(idf * 0.879 + 0.3),
    )
    let shade = v(0.3, 0.3, 0.3) + c * 0.7

    return v(shade, 0.85)
}
