pub value TextArtStyle {
    shadow: Color = BLACK,
    shadow_offset: Vec2 = v(),
    shadow_strength: float = 1.0,
    shadow_levels: int = 3,
    shadow_scatter: float = 0.62,
    emission: Color = WHITE,
    emission_strength: float = 0.0,
    bloom_levels: int = 3,
    bloom_threshold: float = 1.0,
    bloom_knee: float = 0.5,
    bloom_scatter: float = 0.68,
    face: Color = WHITE,
}

pub value TextArtRadianceMaterial {
    pipeline: Pipeline,
    block: OwnedUniformBlock?,
}

pub value TextArtSourceMaterial {
    pipeline: Pipeline,
    block: OwnedUniformBlock?,
    key: string,
}

pub struct TextArtMaterial {
    pipeline: Pipeline,
    block: OwnedUniformBlock?,
    key: string,
    // Slot 0 is the TextArt source, transformed when source_data is requested.
    // These borrowed inputs
    // occupy compiler-owned slots 1..N in declaration order.
    additional_inputs: [(SampledTexture, TextureFilter)] = [],
    radiance: TextArtRadianceMaterial? = null,
    // Static data replaces slot 0 for the custom face and radiance passes.
    source_data: TextArtSourceMaterial? = null,
}

pub enum TextArtFollow {
    StaticRun,
    GlyphPoses,
}


pub struct TextArtGlyphInput {
    layout: TextLayout,
    consumer_key: string,
    origin: Vec2,
    follow: TextArtFollow,
    poses: [GlyphPose],
    tint: Color,
    z_layer: int,
}

pub fn text_art_glyph_input(
    layout: TextLayout,
    follow: TextArtFollow,
    poses: [GlyphPose],
    tint: Color = WHITE,
    z_layer: int = UI_TEXT_Z_LAYER,
    consumer_key: string = "",
    origin: Vec2 = v()
) -> TextArtGlyphInput {
    text_layout_validate_poses(layout, poses)
    return TextArtGlyphInput {
        layout: layout,
        consumer_key: consumer_key,
        origin: origin,
        follow: follow,
        poses: if follow == TextArtFollow::StaticRun { [] } else { poses },
        tint: tint,
        z_layer: z_layer,
    }
}

pub fn text_art_glyph_paint(dl: DrawList, input: TextArtGlyphInput) {
    let poses: [GlyphPose]? = if input.follow == TextArtFollow::StaticRun {
        null
    } else { input.poses }
    with_ui_pool(
        dl.batches,
        () => {
            let _ = text_layout_emit(
                input.layout, input.origin, input.tint, input.z_layer, poses,
                input.consumer_key)
        }
    )
}

// Diagnostic only; paint identity compares the input structurally, so this
// description is formatted at the error site and never on the retained path.
fn text_art_glyph_description(input: TextArtGlyphInput) -> string {
    let follow = if input.follow == TextArtFollow::StaticRun { "static" } else { "posed" }
    return "{follow}:{text_layout_cache_key(input.layout)}"
}

pub fn text_art_glyph_paint_equal(a: TextArtGlyphInput, b: TextArtGlyphInput) -> bool {
    return text_art_glyph_paint_equal_at(a, b, a.origin)
}

fn text_art_glyph_paint_equal_at(
    a: TextArtGlyphInput, b: TextArtGlyphInput, origin: Vec2
) -> bool {
    // TextLayout holds mutable raster/batch caches that do not change paint.
    return a.consumer_key == b.consumer_key
        && origin == b.origin && a.tint == b.tint && a.z_layer == b.z_layer
        && a.follow == b.follow
        && (a.follow == TextArtFollow::StaticRun || a.poses == b.poses)
        && text_art_glyph_layout_equal(a.layout, b.layout)
}

fn text_art_glyph_layout_equal(a: TextLayout, b: TextLayout) -> bool {
    return a.font == b.font && a.text == b.text && a.face == b.face
        && a.glyphs == b.glyphs && a.logical_bounds == b.logical_bounds
        && a.ink_bounds == b.ink_bounds && a.ascent == b.ascent && a.descent == b.descent
        && a.line_height == b.line_height && a.line_count == b.line_count
        && a.admitted_count == b.admitted_count && a.alignment == b.alignment
        && a.alignment_offset == b.alignment_offset
        && a.raster_authored_cap_height == b.raster_authored_cap_height
        && a.raster_layout_to_target_scale == b.raster_layout_to_target_scale
        && a.raster_physical_target_scale == b.raster_physical_target_scale
        && a.raster_target_cap_height == b.raster_target_cap_height
        && a.coverage_oversampling == b.coverage_oversampling
        && a.raster_metric_scale_x == b.raster_metric_scale_x
        && a.raster_metric_scale_y == b.raster_metric_scale_y
}

pub struct TextArtWorkspace {
    extent: IVec2,
    shadow_requested_levels: int,
    bloom_requested_levels: int,
    composite: Canvas,
    emission: Canvas,
    shadow: [Canvas],
    bloom: [Canvas],
    shadow_source_handle: int = 0,
    shadow_source_generation: int = -1,
    shadow_scatter: float = -1.0,
}

pub struct TextArtStats {
    extent: IVec2,
    shadow_requested_levels: int,
    bloom_requested_levels: int,
    shadow_allocated_levels: int,
    bloom_allocated_levels: int,
    bake_count: int,
    pass_count: int,
    cache_hit: bool,
    surface_source_bake_count: int,
    shadow_source_bake_count: int,
    surface_source_cache_hit: bool,
    shadow_source_cache_hit: bool,
    source_data_bake_count: int,
    source_data_cache_hit: bool,
    shadow_pyramid_bake_count: int,
    shadow_pyramid_cache_hit: bool,
}

pub struct TextArt<T> {
    name: string,
    source: UiBake<T>,
    shadow_source: UiBake<T>? = null,
    output: Canvas? = null,
    workspace: TextArtWorkspace? = null,
    inputs: T? = null,
    shadow_inputs: T? = null,
    semantic_inputs: bool = false,
    style: TextArtStyle? = null,
    surface_key: string = "",
    extent: IVec2 = iv(0, 0),
    epoch: int = -1,
    bake_count: int = 0,
    pass_count: int = 0,
    cache_hit: bool = false,
    surface_source_cache_hit: bool = false,
    shadow_source_cache_hit: bool = false,
    source_data: Canvas? = null,
    source_data_key: string = "",
    source_data_source_bake_count: int = -1,
    source_data_bake_count: int = 0,
    source_data_cache_hit: bool = false,
    shadow_pyramid_bake_count: int = 0,
    shadow_pyramid_cache_hit: bool = false,
}

pub value TextArtRasterDemand {
    glyph_population: int,
    target_footprint: Vec2,
    source_footprint: Vec2,
    authored_cap_height: float,
    layout_to_target_scale: float,
    physical_target_scale: float,
    max_pose_scale: float,
    coverage_oversampling: float,
    target_pixel_cap_height: float,
    required_pixel_em: float,
    coverage_bucket: int,
}

pub value TextArtAtlasInstance {
    instance_id: int,
    bucket: int,
    pixel_size: int,
    atlas_width: int,
    atlas_height: int,
    byte_cost: int,
    glyph_population: int,
    generation_count: int,
    source_cap_height: float,
}

pub value TextArtEffectBounds {
    layout_ink: Rect,
    raster_ink: Rect,
    source: Rect,
    shadow: Rect,
    bloom: Rect,
    output: Rect,
