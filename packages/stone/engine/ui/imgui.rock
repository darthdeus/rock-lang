// End the current widget interaction when its owning tool handles Escape.
pub @inline inline(lua) fn imgui_clear_active_item() = "imgui.ClearActiveID()"

pub @inline inline(lua) fn imgui_set_keyboard_focus_here(offset: int) = "imgui.SetKeyboardFocusHere(offset)"

pub @inline inline(lua) fn imgui_set_scroll_here_y(center_y_ratio: float) = "imgui.SetScrollHereY(center_y_ratio)"

// Tooltip for the most-recently-submitted item; guard with imgui_is_item_hovered.
pub @inline inline(lua) fn imgui_set_tooltip(text: string) = "imgui.SetTooltip(text)"

// True when ImGui is capturing the mouse this frame (cursor over a window /
// dragging a widget). Gate world-space click handling on `!imgui_wants_mouse()`
// so clicks on a floating panel don't also reach the game behind it.
pub inline(lua) fn imgui_wants_mouse() -> bool = """
    return imgui.C.igGetIO_Nil().WantCaptureMouse
"""

// True only while an imgui text field is being edited (io.WantTextInput)
// -- NOT WantCaptureKeyboard, which is also true whenever a window merely
// holds nav focus and would eat hotkeys after any window click. Gate
// game hotkeys on this so typing in a filter box stays typing.
pub inline(lua) fn imgui_wants_text_input() -> bool = """
    return imgui.C.igGetIO_Nil().WantTextInput
"""

// Docking (libcimgui_complete is the Dear ImGui docking branch). Enable once
// before the first NewFrame; ImGuiConfigFlags_DockingEnable = 128.
inline(lua) fn imgui_enable_docking() = """
    local io = imgui.C.igGetIO_Nil()
    io.ConfigFlags = bit.bor(io.ConfigFlags, 128)
"""

// Full-viewport host node, submitted each frame after NewFrame and before any
// window Begin, so every imgui_begin window is dockable. PassthruCentralNode
// (=8) leaves the empty center transparent and click-through, so gameplay
// under the editor windows still gets the mouse (WantCaptureMouse stays false
// over the central node). Returns the dockspace id for the builder.
inline(lua) fn imgui_dockspace_over_viewport() -> int = """
    return imgui.DockSpaceOverViewport(0, imgui.GetMainViewport(), 8, nil)
"""

// The dockspace's central node -- the game view the docked columns leave --
// as (min, max) screen corners; null before the dockspace exists.
@scalar_abi inline(lua) fn __imgui_dock_central_pos(id: int) -> Vec2 = """
    local node = imgui.C.igDockBuilderGetCentralNode(id)
    if node == nil then return 0, 0 end
    return node.Pos.x, node.Pos.y
"""

@scalar_abi inline(lua) fn __imgui_dock_central_size(id: int) -> Vec2 = """
    local node = imgui.C.igDockBuilderGetCentralNode(id)
    if node == nil then return 0, 0 end
    return node.Size.x, node.Size.y
"""

pub fn imgui_dock_central_rect() -> (Vec2, Vec2)? {
    if IMGUI_DOCKSPACE_ID < 0 { return null }
    let size = __imgui_dock_central_size(IMGUI_DOCKSPACE_ID)
    if size.x <= 0.0 || size.y <= 0.0 { return null }
    let pos = __imgui_dock_central_pos(IMGUI_DOCKSPACE_ID)
    return (pos, pos + size)
}

// Sidecar next to imgui.ini (same cwd) -- imgui owns its ini format, so the
// stamp lives outside it. ImGui autosaves the ini ~5s after a layout change,
// so the two stay in sync in practice. The stamp carries the layout's id as
// well as its version because every game shares this cwd, and therefore one
// imgui.ini: without the id, running game B leaves a non-empty dockspace full
// of B's nodes, and game A then skips its rebuild and floats every window.
const DOCK_LAYOUT_VERSION_FILE: string = "imgui.layout-version"

const IMGUI_DIR_LEFT: int = 0
const IMGUI_DIR_RIGHT: int = 1
const IMGUI_DIR_UP: int = 2
const IMGUI_DIR_DOWN: int = 3

// Right column panes, top to bottom: RightTop, RightMiddle, RightBottom,
// RightFooter. A window that exists only while something is selected needs a
// pane of its own: it joins its dock node the frame it first appears and takes
// that node's tab, and it loses that tab for good the moment the author picks
// one of its node-mates.
pub enum DockRegion { Left, LeftBottom, RightTop, RightMiddle, RightBottom, RightFooter }

pub value DockPlacement {
    window: string,
    region: DockRegion,
}

// A game's coded default window arrangement. The engine owns the shape -- a
// left column and a right column, each splittable, over a passthrough central
// node left to the game view -- and the game owns which of its windows land
// where. Only regions a placement names are split, so a layout that uses two
// regions gets two panes rather than six, one of them empty.
//
// Bump `version` when the coded default changes: a restored imgui.ini
// otherwise wins (the node is non-empty), leaving windows the old layout never
// knew about floating. The mismatch forces ONE rebuild, then imgui.ini
// persistence takes over again.
pub struct DockLayout {
    id: string,
    version: int,
    left_ratio: float,
    right_ratio: float,
    left_split: float,
    right_upper_split: float,
    right_lower_split: float,
    // RightFooter's share of the lower right area; the rest of it is
    // RightBottom. Defaulted, so a layout naming no footer is unaffected.
    right_footer_split: float = 0.30,
    placements: [DockPlacement],
}

// Registered by the game before its first frame; null means "no coded default",
// and every window floats until the user docks it.
pub global IMGUI_DOCK_LAYOUT: DockLayout? = null

// What a null IMGUI_DOCK_LAYOUT applies: one empty dockspace. It carries its own
// stamp so a game without a coded default still clears the columns another
// layout (its own earlier one, or another game's) left in the shared imgui.ini.
fn imgui_no_dock_layout() -> DockLayout {
    return DockLayout {
        id: "none",
        version: 0,
        left_ratio: 0.0,
        right_ratio: 0.0,
        left_split: 0.0,
        right_upper_split: 0.0,
        right_lower_split: 0.0,
        placements: [],
    }
}

pub fn imgui_set_dock_layout(layout: DockLayout) {
    IMGUI_DOCK_LAYOUT = layout
}

fn imgui_dock_layout_stamp(layout: DockLayout) -> string {
    return "{layout.id}:{layout.version}"
}

fn imgui_dock_layout_stale(layout: DockLayout) -> bool {
    // An absent stamp is the normal first-boot state, not a read failure.
    // Probing first keeps stone_file_read's own diagnostic meaningful instead of
    // logging an error on every fresh checkout.
    if !file_exists(DOCK_LAYOUT_VERSION_FILE) { return true }
    let cur = file_read(DOCK_LAYOUT_VERSION_FILE) ?? return true
    return cur != imgui_dock_layout_stamp(layout)
}

fn imgui_dock_layout_uses(layout: DockLayout, region: DockRegion) -> bool {
    for placement in layout.placements {
        if placement.region == region { return true }
    }
    return false
}

inline(lua) fn imgui_dock_node_empty(id: int) -> bool = """
    local node = imgui.DockBuilderGetNode(id)
    return node == nil or imgui.C.ImGuiDockNode_IsEmpty(node)
"""

inline(lua) fn imgui_dock_reset(id: int) = """
    imgui.DockBuilderRemoveNode(id)
    imgui.DockBuilderAddNode(id, imgui.ImGuiDockNodeFlags_DockSpace)
    imgui.DockBuilderSetNodeSize(id, imgui.GetMainViewport().Size)
"""

// Returns (node in `dir`, remainder).
inline(lua) fn imgui_dock_split(id: int, dir: int, ratio: float) -> (int, int) = """
    local carved, rest = imgui.DockBuilderSplitNode(id, dir, ratio)
    return carved, rest
"""

inline(lua) fn imgui_dock_window(window: string, node: int) = """
    imgui.DockBuilderDockWindow(window, node)
"""

inline(lua) fn imgui_dock_finish(id: int) = """
    imgui.DockBuilderFinish(id)
"""

// Rebuilds when the coded default changed (stamp mismatch) or nothing is docked
// (fresh boot, deleted imgui.ini); otherwise a user arrangement in imgui.ini
// wins.
// A sim owns its layout; persisted editor settings must not change the
// coordinates used by synthetic input.
inline(lua) fn imgui_sim_clear_settings() = """
    local io = imgui.C.igGetIO_Nil()
    io.IniFilename = nil
    imgui.ClearActiveID()
    -- Capture describes the preceding frame until NewFrame runs again.
    io.WantTextInput = false
    io.WantCaptureKeyboard = false
    io.WantCaptureMouse = false
    imgui.ClearIniSettings()
"""

fn imgui_sim_reset_layout() {
    if !IMGUI_READY { return }
    imgui_sim_clear_settings()
    DOCK_LAYOUT_APPLIED = false
}

fn imgui_apply_dock_layout(id: int) {
    let layout = IMGUI_DOCK_LAYOUT ?? imgui_no_dock_layout()
    if sim_mode_active() {
        imgui_build_dock_layout(id, layout)
        return
    }
    if !imgui_dock_layout_stale(layout) && !imgui_dock_node_empty(id) { return }
    imgui_build_dock_layout(id, layout)
    if !file_write(DOCK_LAYOUT_VERSION_FILE, imgui_dock_layout_stamp(layout)) {
        log_error("IMGUI", "cannot write {DOCK_LAYOUT_VERSION_FILE}")
    }
}

fn imgui_build_dock_layout(id: int, layout: DockLayout) {
    imgui_dock_reset(id)

    let rest = id
    let left = -1
    let left_bottom = -1
    if imgui_dock_layout_uses(layout, DockRegion::Left) ||
        imgui_dock_layout_uses(layout, DockRegion::LeftBottom) {
        let (carved, remainder) = imgui_dock_split(rest, IMGUI_DIR_LEFT, layout.left_ratio)
        left = carved
        rest = remainder
        if imgui_dock_layout_uses(layout, DockRegion::LeftBottom) {
            let (bottom, top) = imgui_dock_split(left, IMGUI_DIR_DOWN, layout.left_split)
            left_bottom = bottom
            left = top
        }
    }

    let right_top = -1
    let right_middle = -1
    let right_bottom = -1
    let right_footer = -1
    if imgui_dock_layout_uses(layout, DockRegion::RightTop) ||
        imgui_dock_layout_uses(layout, DockRegion::RightMiddle) ||
        imgui_dock_layout_uses(layout, DockRegion::RightBottom) ||
        imgui_dock_layout_uses(layout, DockRegion::RightFooter) {
        let (carved, _) = imgui_dock_split(rest, IMGUI_DIR_RIGHT, layout.right_ratio)
        right_top = carved
        // Carve from the bottom up so each ratio is taken against the column
        // still remaining above it.
        if imgui_dock_layout_uses(layout, DockRegion::RightBottom) ||
            imgui_dock_layout_uses(layout, DockRegion::RightFooter) {
            let (bottom, above) = imgui_dock_split(right_top, IMGUI_DIR_DOWN, layout.right_lower_split)
            right_bottom = bottom
            right_top = above
            if imgui_dock_layout_uses(layout, DockRegion::RightFooter) {
                if imgui_dock_layout_uses(layout, DockRegion::RightBottom) {
                    let (foot, above_foot) = imgui_dock_split(right_bottom, IMGUI_DIR_DOWN,
                        layout.right_footer_split)
                    right_footer = foot
                    right_bottom = above_foot
                } else {
                    right_footer = right_bottom
                    right_bottom = -1
                }
            }
        }
        if imgui_dock_layout_uses(layout, DockRegion::RightMiddle) {
            let (middle, above) = imgui_dock_split(right_top, IMGUI_DIR_DOWN, layout.right_upper_split)
            right_middle = middle
            right_top = above
        }
    }

    for placement in layout.placements {
        let node = match placement.region {
            DockRegion::Left => left,
            DockRegion::LeftBottom => left_bottom,
            DockRegion::RightTop => right_top,
            DockRegion::RightMiddle => right_middle,
            DockRegion::RightBottom => right_bottom,
            DockRegion::RightFooter => right_footer,
        }
        if node < 0 {
            log_error("IMGUI", "dock layout {layout.id}: no node for {placement.window}")
        } else {
            imgui_dock_window(placement.window, node)
        }
    }
    imgui_dock_finish(id)
}

// --- Style + interaction extras --------------------------------------
//
// ImGuiCol indices match cimgui's enum (see ../tmp/main.lua line 3737).
// Common ones for buttons:
//   21 = Button, 22 = ButtonHovered, 23 = ButtonActive
//   1  = Text, 7  = FrameBg
// `col_abgr` follows ImGui's ABGR packing — 0xAABBGGRR — so 0xff_00_80_ff
// is opaque red.
pub @inline inline(lua) fn imgui_push_style_color(idx: int, col_abgr: int) = """
    imgui.PushStyleColor_U32(idx, col_abgr)
"""

pub @inline inline(lua) fn imgui_pop_style_color(count: int) = """
    imgui.PopStyleColor(count)
"""

// Greys the next widgets and blocks input. Pair with imgui_end_disabled.
pub inline(lua) fn imgui_begin_disabled(disabled: bool) = """
    imgui.BeginDisabled(disabled)
"""

pub inline(lua) fn imgui_end_disabled() = """
    imgui.EndDisabled()
"""

// Inject a button-up event into ImGui's input queue so its IsItemActive
// / IsItemActivated edge detectors see a release the OS did not deliver.
pub inline(lua) fn imgui_inject_left_mouse_up() = """
    local io = imgui.C.igGetIO_Nil()
    imgui.C.ImGuiIO_AddMouseButtonEvent(io, 0, false)
"""

// Symmetric companion to `imgui_inject_left_mouse_up`. Used by
// layer-2 click-path sims to drive `InvisibleButton + IsItemActive`
// without an OS mouse. Pair with `imgui_set_mouse_pos` to set the
// cursor location before pressing.
pub inline(lua) fn imgui_inject_left_mouse_down() = """
    local io = imgui.C.igGetIO_Nil()
    imgui.C.ImGuiIO_AddMouseButtonEvent(io, 0, true)
"""

// Override ImGui's mouse position in screen coordinates. The position
// is queued as an input event; ImGui consumes it at the next
// NewFrame(). Sim helper -- production code shouldn't drive ImGui
// input out of band.
pub inline(lua) fn imgui_set_mouse_pos(x: float, y: float) = """
    local io = imgui.C.igGetIO_Nil()
    imgui.C.ImGuiIO_AddMousePosEvent(io, x, y)
"""

pub inline(lua) fn imgui_inject_text(text: string) = """
    local io = imgui.C.igGetIO_Nil()
    imgui.C.ImGuiIO_AddInputCharactersUTF8(io, text)
"""

@scalar_abi inline(lua) fn imgui_get_item_rect_min() -> Vec2 = """
    local p = imgui.GetItemRectMin()
    return p.x, p.y
"""

@scalar_abi inline(lua) fn imgui_get_item_rect_max() -> Vec2 = """
    local p = imgui.GetItemRectMax()
    return p.x, p.y
"""

@inline inline(lua) fn imgui_is_item_visible() -> bool = "return imgui.IsItemVisible()"

// Both corners of the last item inside the window's clip rect, where
// IsItemVisible accepts any overlap.
inline(lua) fn imgui_is_item_fully_visible() -> bool = """
    local cache = __imgui_shared_image_packet()
    local min = imgui.GetItemRectMin()
    local max = imgui.GetItemRectMax()
    cache.u1.x, cache.u1.y = min.x + 1, min.y + 1
    cache.u2.x, cache.u2.y = max.x - 1, max.y - 1
    return imgui.IsRectVisible_Vec2(min, cache.u1) and imgui.IsRectVisible_Vec2(cache.u2, max)
"""

// Edge detector: true on the single frame the most-recently-submitted
// item *became* active (e.g. user just pressed the mouse on it). False
// on subsequent frames even while the press is held. Use this to gate
// drag-detect against ImGui's `IsItemActive` getting stuck true when
// the OS eats the mouse-up event during a native drag session.
pub inline(lua) fn imgui_is_item_activated() -> bool = """
    return imgui.IsItemActivated()
"""

// Symmetric falling-edge detector: true on the single frame the
// most-recently-submitted item *became* inactive (e.g. user just
// released a press). Use to commit shape-tool strokes on release.
pub inline(lua) fn imgui_is_item_deactivated() -> bool = """
    return imgui.IsItemDeactivated()
"""

// Is the mouse over the current window? Must be called between begin/end.
//
// AllowWhenBlockedByActiveItem (128): with flags 0 ImGui reports a window as
// NOT hovered for as long as any item is active, so this goes false on the
// frame you press a button inside it and stays false while you hold. Anything
// keying state off "is the pointer in this window" then flickers off on every
// click -- which is never what the caller means.
inline(lua) fn imgui_is_window_hovered() -> bool = """
    return imgui.IsWindowHovered(128)
"""

// Is any imgui item being interacted with (a held button, a slider mid-drag)?
// GLOBAL, not per-window -- an item activated in any window returns true here,
// including one activated by keyboard rather than by the mouse. Pair it with
// imgui_is_window_focused and a mouse-button check if what you actually mean is
// "this window is being dragged".
pub inline(lua) fn imgui_is_any_item_active() -> bool = """
    return imgui.IsAnyItemActive()
"""

// Does the current window have focus? Must be called between begin/end.
inline(lua) fn imgui_is_window_focused() -> bool = """
    return imgui.IsWindowFocused(0)
"""

// Focuses a window by name; for a docked window that selects its tab.
pub @inline inline(lua) fn imgui_set_window_focus(name: string) = "imgui.SetWindowFocus_Str(name)"

pub @scalar_abi inline(lua) fn imgui_get_window_dock_placement() -> (int, int) = """
    local w = imgui.GetCurrentWindow()
    return tonumber(w.DockId), tonumber(w.DockOrder)
"""

// Reinsert a temporarily floating window at its previous tab position.
// The new tab may not exist until the dock node has submitted another frame.
pub inline(lua) fn imgui_restore_window_tab_order(order: int) -> bool = """
    local w = imgui.GetCurrentWindow()
    if w.DockNode == nil or w.DockNode.TabBar == nil then return false end
    local bar = w.DockNode.TabBar
    local tab = imgui.TabBarFindTabByID(bar, w.TabId)
    if tab == nil then return false end
    local current = imgui.TabBarGetTabOrder(bar, tab)
    local target = math.min(order, bar.Tabs.Size - 1)
    if current ~= target then imgui.TabBarQueueReorder(bar, tab, target - current) end
    return true
"""

// Zero detaches the next window; retain its previous ID to restore its tab group.
pub @inline inline(lua) fn imgui_set_next_window_dock_id(id: int) = "imgui.SetNextWindowDockID(id, 1)"

pub @inline inline(lua) fn imgui_is_window_docked() -> bool = """
    return imgui.IsWindowDocked()
"""

// Is a mouse button held, as ImGui sees it? 0 left, 1 right, 2 middle.
// _Nil is cimgui's overload suffix for the plain (button) form -- there is no
// bare `IsMouseDown` in the table, and no __index fallback to catch the miss.
inline(lua) fn imgui_is_mouse_down(button: int) -> bool = """
    return imgui.IsMouseDown_Nil(button)
"""

// Close a frame that a Rock error unwound out of mid-draw, so the loop can
// continue. Without it the next NewFrame trips ImGui's
// ErrorCheckNewFrameSanityChecks ("Forgot to call Render() or EndFrame()")
// and abort()s the process -- a caught, logged, recoverable script error
// killing the game one frame later.
//
// EndFrame closes it without drawing, so the error frame shows no imgui at
// all, which is what it should show. The unwind also left every Begin without
// its End; ImGui repairs that itself inside EndFrame, but asserts while doing
// so unless the assert is off. Suppressed for THIS call only -- an imbalance
// in ordinary code stays as loud as it was.
inline(lua) fn imgui_end_frame_after_error() = """
    local io = imgui.C.igGetIO_Nil()
    local prev = io.ConfigErrorRecoveryEnableAssert
    io.ConfigErrorRecoveryEnableAssert = false
    imgui.EndFrame()
    io.ConfigErrorRecoveryEnableAssert = prev
"""

// Close a valid hidden frame without producing or submitting draw data.
inline(lua) fn imgui_discard_frame() = """
    imgui.EndFrame()
"""

// Like the above but only fires when the value actually CHANGED before the
// release -- the "commit on release" edge. A slider you grab and let go
// without moving does not fire.
pub inline(lua) fn imgui_is_item_deactivated_after_edit() -> bool = """
    return imgui.IsItemDeactivatedAfterEdit()
"""

// Like imgui_button but with an explicit size. Pass 0 in either dim to
// auto-size that axis. Useful for grid layouts where every cell must
// be the same width regardless of label length.
pub @scalar_abi inline(lua) fn imgui_button_sized(label: string, size: Vec2) -> bool = """
    local cache = __imgui_shared_image_packet()
    cache.s.x, cache.s.y = size__x, size__y
    return imgui.Button(label, cache.s)
"""

// Cumulative drag delta of the given mouse button since drag started.
// button=0 = left. Returns (dx, dy) in pixels.
pub @scalar_abi inline(lua) fn imgui_get_mouse_drag_delta(button: int) -> Vec2 = """
    local p = imgui.GetMouseDragDelta(button, 0)
    return p.x, p.y
"""

// Convenience: did the user drag the most-recently-submitted item by
// at least `threshold` pixels with the left mouse button held?
pub fn imgui_item_drag_started(threshold: float) -> bool {
    if !imgui_is_item_active() { return false }
    let d = imgui_get_mouse_drag_delta(0)
    let dx = d.x
    let dy = d.y
    return dx * dx + dy * dy > threshold * threshold
}

// These probes distinguish live bindings from the platform-init failure stub.
// Consumer: demos/imgui/tests/sims/imgui_api_surface.rock.

// The real cimgui's version string, or "" under the stub (whose `__index`
// hands back a no-op returning nil).
//
// Goes through `imgui.C` rather than the wrapped `imgui.GetVersion`: the wrapper
// returns the raw `const char*` cdata uninterpreted (and calls `jit.off(true)`),
// so it needs `ffi.string` either way.
pub inline(lua) fn imgui_get_version() -> string = """
    local ffi = require("ffi")
    local ok, v = pcall(function() return ffi.string(imgui.C.igGetVersion()) end)
    if not ok then
        io.stderr:write("[imgui] GetVersion failed (cimgui stubbed or dead): " .. tostring(v) .. "\n")
        return ""
    end
    return v
"""

// Vertices in the LAST rendered imgui frame; -1 before the first render (or on
// a build whose imgui is the inert stub).
//
// It is NOT readable from Lua. `igGetDrawData()` returns NULL outside
// Render()..NewFrame(), and every Rock-visible phase -- @update, @draw,
// @late_draw, a sim coroutine resume -- sits between NewFrame and Render, so a
// Lua read is NULL always (measured, not assumed). `stone_imgui_render` already
// holds the pointer at the one valid moment, so it records the count there.
pub fn imgui_total_vtx_count() -> int {
    return stone_imgui_last_vtx_count()
}

// Which imgui BODIES executed, by id, cumulatively since process start.
//
// `imgui_total_vtx_count` answers "did imgui put geometry on the driver this
// frame" and nothing finer. Every editor frame draws a dockspace and several
// windows, so it stays comfortably above zero with any one window's body
// skipped -- which makes it a liveness control, not evidence that the body a
// sim names ran. A test whose subject is "the prop grid renders" needs to ask
// about the prop grid.
//
// Recorded where a body is ENTERED: a window/child begin that returned true
// (imgui's own contract -- `if (Begin(..)) { body }`), and image buttons, whose
// ids are what a grid emits per cell. CUMULATIVE rather than per-frame, because
// a sim resumes inside a frame and a counter reset at NewFrame would race the
// read; the sims here ask "did this body ever run", which is the question.
global IMGUI_BODIES_RAN: Map<string, int> = map_new()

// OFF unless a sim asked for it. Every window, child and image button in every
// frame would otherwise pay a hash lookup and write for a table nothing reads --
// a prop grid alone is one per cell per frame -- and ids built from data
// (`prop_btn_{i}`, a row key, an entity id) would grow the map without bound in
// a long editor session. Latched once from the environment rather than read per
// call, so the hot path is a boolean test.
global IMGUI_RECORD_BODIES: bool = false

@init
fn imgui_bodies_recording_init() {
    IMGUI_RECORD_BODIES = sim_mode_active()
        && get_env_int("STONE_IMGUI_SIM_PROBES", 1) != 0
}

pub fn imgui_note_body(id: string) {
    if !IMGUI_RECORD_BODIES { return }
    IMGUI_BODIES_RAN[id] = (IMGUI_BODIES_RAN.get(id) ?? 0) + 1
}

pub fn imgui_body_count(id: string) -> int {
    return IMGUI_BODIES_RAN.get(id) ?? 0
}

pub fn imgui_body_ran(id: string) -> bool {
    return imgui_body_count(id) > 0
}

// How many DISTINCT ids beginning with `prefix` executed. A grid emits one id
// per cell, so this is how a test says "the grid drew cells" without pinning
// how many -- a count that moves with the asset list would be a test of the
// asset list.
pub fn imgui_bodies_with_prefix(prefix: string) -> int {
    let n = 0
    for (id, _) in IMGUI_BODIES_RAN {
        if id.starts_with(prefix) { n = n + 1 }
    }
    return n
}

pub value ImguiTestItem {
    min: Vec2,
    max: Vec2,
    clip_min: Vec2,
    clip_max: Vec2,
    frame: int,
    visible: bool,
    // Entirely inside the clip rect; `visible` is any overlap.
    whole: bool,
}

value ImguiTestCombo {
    frame: int,
    current: int,
    items: [string],
}

pub global IMGUI_TEST_ITEMS: Map<string, ImguiTestItem> = map_new()
global IMGUI_TEST_COMBOS: Map<string, ImguiTestCombo> = map_new()
global IMGUI_TEST_REVEAL_TARGET: string = ""

pub fn imgui_test_recording() -> bool { return IMGUI_RECORD_BODIES }

@scalar_abi inline(lua) fn imgui_test_clip_rect() -> (Vec2, Vec2) = """
    local clip = imgui.C.igGetCurrentWindowRead().ClipRect
    return clip.Min.x, clip.Min.y, clip.Max.x, clip.Max.y
"""

pub fn imgui_test_note_item(id: string) {
    if !IMGUI_RECORD_BODIES { return }
    let (clip_min, clip_max) = imgui_test_clip_rect()
    IMGUI_TEST_ITEMS[id] = ImguiTestItem {
        min: imgui_get_item_rect_min(),
        max: imgui_get_item_rect_max(),
        clip_min,
        clip_max,
        frame: frame_seq,
        visible: imgui_is_item_visible(),
        whole: imgui_is_item_fully_visible(),
    }
    if IMGUI_TEST_REVEAL_TARGET == id {
        imgui_set_scroll_here_y(0.5)
        IMGUI_TEST_REVEAL_TARGET = ""
    }
}

pub fn imgui_test_item_submitted(id: string) -> bool {
    let item = IMGUI_TEST_ITEMS.get(id) ?? return false
    // Sims resume before draw, so the latest submitted item is one frame_seq old.
    let age = frame_seq - item.frame
    return age >= 0 && age <= 1
        && item.max.x > item.min.x && item.max.y > item.min.y
}

pub fn imgui_test_item_current(id: string) -> bool {
    let item = IMGUI_TEST_ITEMS.get(id) ?? return false
    return imgui_test_item_submitted(id) && item.visible
}

pub fn imgui_test_item_center(id: string) -> Vec2? {
    if !imgui_test_item_current(id) { return null }
    let item = IMGUI_TEST_ITEMS[id]
    return (item.min + item.max) * 0.5
}

pub fn imgui_test_item_revealed(id: string, whole: bool, relative: Vec2?) -> bool {
    if !imgui_test_item_current(id) { return false }
    let item = IMGUI_TEST_ITEMS[id]
    if whole && !item.whole { return false }
    if relative != null {
        let point = imgui_test_item_point(id, relative) ?? return false
        return point.x >= item.clip_min.x && point.x < item.clip_max.x
            && point.y >= item.clip_min.y && point.y < item.clip_max.y
    }
    return true
}

// Paused draw-driven sims use the same reveal request as coroutine helpers.
pub fn imgui_test_request_reveal(id: string) { IMGUI_TEST_REVEAL_TARGET = id }

// Pixel reads need `whole`; clicks need their requested point inside the clip,
// even when an oversized item cannot fit entirely in its scroll child.
pub co fn imgui_test_reveal(id: string, whole: bool = false, relative: Vec2? = null) -> Coroutine<Wait> {
    if !imgui_test_item_submitted(id) {
        error("imgui semantic target '{id}' is absent, stale, or empty")
        return
    }
    if imgui_test_item_revealed(id, whole, relative) { return }
    imgui_test_request_reveal(id)
    await frame(2)
    if !imgui_test_item_revealed(id, whole, relative) {
        error("imgui semantic target '{id}' could not be scrolled into view")
    }
}

fn imgui_test_note_combo(id: string, current: int, items: [string]) {
    imgui_test_note_item(id)
    if !IMGUI_RECORD_BODIES { return }
    let labels: [string] = []
    for item in items { labels.push(item) }
    IMGUI_TEST_COMBOS[id] = ImguiTestCombo {
        frame: frame_seq,
        current,
        items: labels,
    }
}

pub fn imgui_testable_combo(id: string, label: string, current: int,
                        items: [string]) -> (bool, int) {
    let open = imgui_begin_combo(label, items[current])
    imgui_test_note_combo(id, current, items)
    let changed = false
    let selected_index = current
    if open {
        for i in 0..items.len() {
            let selected = i == current
            let selected_now = imgui_selectable("{items[i]}##{id}_{i}", selected)
            imgui_test_note_item("{id}/option/{i}")
            if selected_now {
                changed = true
                selected_index = i
            }
            if selected { imgui_set_item_default_focus() }
        }
        imgui_end_combo()
    }
    return (changed, selected_index)
}

fn imgui_test_item_point(id: string, relative: Vec2) -> Vec2? {
    if !imgui_test_item_current(id) { return null }
    if relative.x < 0.0 || relative.x > 1.0
            || relative.y < 0.0 || relative.y > 1.0 {
        error("imgui semantic target '{id}' relative point is outside [0, 1]")
        return null
    }
    let item = IMGUI_TEST_ITEMS[id]
    // Treat both normalized endpoints as points inside the item, not its edge.
    let size = item.max - item.min
    let inset = v(min(size.x * 0.5, 0.5), min(size.y * 0.5, 0.5))
    let interior = size - inset * 2.0
    return item.min + inset + interior * relative
}

pub co fn imgui_test_click_at(id: string, relative_x: float, relative_y: float) -> Coroutine<Wait> {
    await imgui_test_reveal(id, relative: v(relative_x, relative_y))
    let point = imgui_test_item_point(id, v(relative_x, relative_y))
    if point == null {
        error("imgui semantic target '{id}' is absent, stale, clipped, or empty")
        return
    }
    let at = point
    imgui_set_mouse_pos(at.x, at.y)
    await frame(1)
    imgui_inject_left_mouse_down()
    await frame(1)
    imgui_inject_left_mouse_up()
    await frame(2)
}

pub co fn imgui_test_click(id: string) -> Coroutine<Wait> {
    await imgui_test_click_at(id, 0.5, 0.5)
}

pub co fn imgui_test_drag(id: string, from_fraction: Vec2, to_fraction: Vec2) -> Coroutine<Wait> {
    await imgui_test_reveal(id)
    let from = imgui_test_item_point(id, from_fraction)
    let to = imgui_test_item_point(id, to_fraction)
    if from == null || to == null {
        error("imgui semantic target '{id}' is absent, stale, clipped, or empty")
        return
    }
    let start = from
    let finish = to
    imgui_set_mouse_pos(start.x, start.y)
    await frame(1)
    imgui_inject_left_mouse_down()
    await frame(1)
    imgui_set_mouse_pos(finish.x, finish.y)
    await frame(1)
    imgui_inject_left_mouse_up()
    await frame(2)
}

pub co fn imgui_test_replace_text_at(id: string, text: string, relative_x: float, relative_y: float) -> Coroutine<Wait> {
    await imgui_test_click_at(id, relative_x, relative_y)
    tool_inject_key("lctrl")
    await frame(1)
    tool_inject_key("a")
    await frame(1)
    tool_release_key("a")
    tool_release_key("lctrl")
    await frame(1)
    imgui_inject_text(text)
    await frame(2)
}

pub co fn imgui_test_replace_text(id: string, text: string) -> Coroutine<Wait> {
    await imgui_test_replace_text_at(id, text, 0.5, 0.5)
}

pub co fn imgui_test_choose(id: string, label: string) -> Coroutine<Wait> {
    if !imgui_test_item_submitted(id) {
        error("imgui semantic combo '{id}' is absent, stale, clipped, or empty")
        return
    }
    let combo = IMGUI_TEST_COMBOS.get(id)
    if combo == null || frame_seq - combo.frame > 1 {
        error("imgui semantic target '{id}' has no current combo metadata")
        return
    }
    let state = combo
    let target = -1
    for i in 0..state.items.len() {
        if state.items[i] == label { target = i; break }
    }
    if target < 0 {
        error("imgui semantic combo '{id}' has no visible option '{label}'")
        return
    }
    await imgui_test_click(id)
    await imgui_test_click("{id}/option/{target}")
}
