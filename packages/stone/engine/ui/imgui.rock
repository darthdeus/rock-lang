

fn image_source_to_uv12(image: Image, source: IRect? = null) -> (Vec2, Vec2) {
    let dims = image_dims(image)
    let real_source = irect(0, 0, dims.x, dims.y)
    if source != null {
        real_source = source
    }

    let uv1 = v(real_source.x as float / dims.x, real_source.y as float / dims.y)
    let uv2 = v((real_source.x + real_source.w) as float / dims.x, (real_source.y + real_source.h) as float / dims.y)

    return (uv1, uv2)
}

pub fn imgui_image(
    image: Image,
    size: Vec2,
    source: IRect? = null,
    color: Color = WHITE,
    border_color: Color = TRANSPARENT
) {
    let (uv1, uv2) = image_source_to_uv12(image, source)
    imgui_image_raw(imgui_texture_name(image), size, uv1, uv2, color, border_color)
}

pub fn imgui_image(
    image: Image,
    size: Vec2,
    uv1: Vec2 = v(0, 0),
    uv2: Vec2 = v(1, 1),
    color: Color = WHITE,
    border_color: Color = TRANSPARENT
) {
    imgui_image_raw(imgui_texture_name(image), size, uv1, uv2, color, border_color)
}

pub fn imgui_image_button(
    id: string,
    image: Image,
    size: Vec2,
    source: IRect? = null,
    bg_color: Color = TRANSPARENT,
    tint_color: Color = WHITE
) -> bool {
    let (uv1, uv2) = image_source_to_uv12(image, source)
    return imgui_image_button_recorded(id, image, size, uv1, uv2, bg_color, tint_color)
}

pub fn imgui_image_button(
    id: string,
    image: Image,
    size: Vec2,
    uv1: Vec2 = v(0, 0),
    uv2: Vec2 = v(1, 1),
    tint_color: Color = WHITE,
    bg_color: Color = TRANSPARENT
) -> bool {
    return imgui_image_button_recorded(id, image, size, uv1, uv2, bg_color, tint_color)
}

// The ONE place an image button is recorded, so the two overloads above cannot
// drift apart on it. Recorded on the CALL, not on the return: the cell drew
// whether or not it was clicked, and "was this grid populated" is the question.
fn imgui_image_button_recorded(
    id: string,
    image: Image,
    size: Vec2,
    uv1: Vec2,
    uv2: Vec2,
    bg_color: Color,
    tint_color: Color
) -> bool {
    imgui_note_body(id)
    return imgui_image_button_raw(id, imgui_texture_name(image), size, uv1, uv2, bg_color, tint_color)
}

pub fn imgui_default_scale() -> float {
    // A display that reports an honest density needs nothing here. Where SDL/X11
    // reports 1x on a high-density panel, the machine names the scale:
    // `imgui_scale` in the machine config (`~/.config/stone/window.toml`), or
    // `STONE_IMGUI_SCALE`, which outranks it for one launch. Neither set keeps
    // the window-height rule below.
    if let raw = os_getenv("STONE_IMGUI_SCALE") {
        // Empty is how a sim entry declares "no override" for the runner-owned
        // vars, so it means unset here too, and silently.
        if raw != "" {
            if let override = raw.parse_float() {
                if override > 0.0 { return override }
            }
            log_once("IMGUI", "STONE_IMGUI_SCALE='{raw}' is not a positive number; using the window's scale")
        }
    }
    let configured = stone_get_config_imgui_scale()
    if configured > 0.0 { return configured }
    let scale = round(screen_size().y / 1080.0)
    let dpi_scale = round(stone_get_dpi_scale())
    if dpi_scale > scale { scale = dpi_scale }
    if scale < 1.0 { scale = 1.0 }
    return scale
}

// Debug-UI (imgui) scale knob. 1.0 = native window pixels (tiny on hi-dpi).
// The runner seeds the shared default before game init; games may override it.
pub global IMGUI_SCALE: float = 1.0
global _imgui_scale_applied: float = 0.0
// Set by the runner from stone_imgui_init's result; guards every style
// access so a failed imgui init can't crash the scale path.
pub global IMGUI_READY: bool = false

// Applied once per process (survives hot reload) so the default dock layout
// never stomps a layout the user arranged and imgui.ini restored.
global DOCK_LAYOUT_APPLIED: bool = false
// This frame's viewport dockspace; -1 before the first NewFrame.
global IMGUI_DOCKSPACE_ID: int = -1

// True between the runner's NewFrame and Render. Read only by the frame
// error path, which has to close a frame the unwind left open.
global IMGUI_FRAME_OPEN: bool = false

// Scale the whole imgui surface (fonts + style geometry) crisply -- imgui
// 1.92 dynamic fonts rasterize at the scaled size, no atlas rebuild.
// Rescales from a baseline style captured on first call, so repeated calls
// (slider drags) don't accumulate ScaleAllSizes' floor() truncation.
pub inline(lua) fn imgui_apply_scale(s: float) = """
    local style = imgui.GetStyle()
    if _G.__imgui_base_style == nil then
        local base = ffi.new("ImGuiStyle")
        ffi.copy(base, style, ffi.sizeof("ImGuiStyle"))
        _G.__imgui_base_style = base
    end
    ffi.copy(style, _G.__imgui_base_style, ffi.sizeof("ImGuiStyle"))
    style:ScaleAllSizes(s)
    style.FontScaleMain = s
"""

// Live style probe (tests/diagnostics).
pub inline(lua) fn imgui_get_font_scale() -> float = """
    return imgui.GetStyle().FontScaleMain
"""

pub fn imgui_update_scale() {
    if !IMGUI_READY { return }
    if IMGUI_SCALE != _imgui_scale_applied {
        imgui_apply_scale(IMGUI_SCALE)
        _imgui_scale_applied = IMGUI_SCALE
    }
}

// The unconditional form: its callers run the body whatever Begin returned, so
// the call IS the body entry.
pub fn imgui_begin(title: string) {
    let _ = __imgui_begin_window_raw(title, 0)
    imgui_note_body(title)
}
pub @inline inline(lua) fn imgui_end() = "imgui.End()"
pub @inline inline(lua) fn imgui_text(text: string) = "imgui.TextUnformatted(text, nil)"
pub inline(lua) fn imgui_text_wrapped(text: string) = """
    imgui.PushTextWrapPos(0)
    imgui.TextUnformatted(text, nil)
    imgui.PopTextWrapPos()
"""
pub @inline inline(lua) fn imgui_button(label: string) -> bool = "imgui.Button(label)"

pub @inline inline(lua) fn imgui_same_line() = "imgui.SameLine()"

// SameLine only when a button labelled `label` still fits on the current row,
// so a row of buttons wraps instead of running past a narrow window's edge.
pub inline(lua) fn imgui_same_line_if_fits(label: string) = """
    local style = imgui.C.igGetStyle()
    local cache = __imgui_shared_image_packet()
    imgui.C.igCalcTextSize(cache.s, label, nil, true, -1.0)
    local width = cache.s.x + style.FramePadding.x * 2
    imgui.C.igGetItemRectMax(cache.p1)
    imgui.C.igGetCursorScreenPos(cache.pos)
    imgui.C.igGetContentRegionAvail(cache.p2)
    local right = cache.pos.x + cache.p2.x
    if cache.p1.x + style.ItemSpacing.x + width <= right then
        imgui.SameLine()
    end
"""

pub @scalar_abi inline(lua) fn imgui_get_mouse_pos() -> Vec2 = """
    local pos = imgui.GetMousePos()
    return pos.x, pos.y
"""

pub inline(lua) fn imgui_slider_float(label: string, value: float, min: float, max: float) -> (bool, float) = """
    local v = ffi.new("float[1]", {value})
    local changed = imgui.SliderFloat(label, v, min, max)
    return changed, v[0]
"""

pub inline(lua) fn imgui_input_float(label: string, value: float, step: float,
                                 step_fast: float, format: string) -> (bool, float) = """
    local v = ffi.new("float[1]", {value})
    local changed = imgui.InputFloat(label, v, step, step_fast, format, 0)
    return changed, v[0]
"""

pub inline(lua) fn imgui_slider_int(label: string, value: int, min: int, max: int) -> (bool, int) = """
    local v = ffi.new("int[1]", {value})
    local changed = imgui.SliderInt(label, v, min, max)
    return changed, v[0]
"""

// Vertical slider -- a mixer fader. `size` is the whole track, so the caller
// sets its height; unlike the horizontal form there is no sensible default.
//
// `format` is not optional here the way it is on the horizontal slider: the
// value is printed INSIDE a track the caller has made narrow, so the default
// "%.3f" clips to "1.(" at any sane fader width.
@scalar_abi inline(lua) fn imgui_v_slider_float(label: string, size: Vec2, value: float, min: float, max: float, format: string) -> (bool, float) = """
    local v = ffi.new("float[1]", {value})
    local cache = __imgui_shared_image_packet()
    cache.s.x, cache.s.y = size__x, size__y
    local changed = imgui.VSliderFloat(label, cache.s, v, min, max, format)
    return changed, v[0]
"""

// Combo dropdown. Pass items as a regular Rock array; the helper joins
// them with NUL bytes (which Rock strings can't carry as literals).
// Returns (changed, new_index).
pub fn imgui_combo(label: string, current_idx: int, items: [string]) -> (bool, int) {
    // ImGui wants the items NUL-separated with a trailing NUL. A Rock string
    // literal cannot carry a NUL byte, so the separator comes from Lua; the
    // join itself is Rock, which keeps `__rock_vec_to_lua_array` (and the boxed
    // `_data` it hands back) out of an opaque body.
    let nul = __nul_byte()
    return __imgui_combo_str(label, current_idx, "{items.join(nul)}{nul}")
}

fn __nul_byte() -> string { return string_char(0) }

inline(lua) fn __imgui_combo_str(label: string, current_idx: int, items_nul: string) -> (bool, int) = """
    local v = ffi.new("int[1]", {current_idx})
    local changed = imgui.Combo_Str(label, v, items_nul)
    return changed, v[0]
"""

@inline inline(lua) fn imgui_begin_combo(label: string, preview: string) -> bool = "return imgui.BeginCombo(label, preview, 0)"
@inline inline(lua) fn imgui_end_combo() = "imgui.EndCombo()"
@inline inline(lua) fn imgui_set_item_default_focus() = "imgui.SetItemDefaultFocus()"

