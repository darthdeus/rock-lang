"""

pub fn imgui_combo(label: string, current_idx: int, items: [string]) -> (bool, int) {
    // ImGui expects NUL separators and a trailing NUL.
    let nul = __nul_byte()
    return __imgui_combo_str(label, current_idx, "{items.join(nul)}{nul}")
}

fn __nul_byte() -> string { return string_char(0) }

extern(lua, "imgui.Combo_Str") fn __imgui_combo_out(label: string, out: Ptr<int>, items_nul: string) -> bool

fn __imgui_combo_str(label: string, current_idx: int, items_nul: string) -> (bool, int) {
    let out = __imgui_new_out("int[1]", current_idx)
    let changed = __imgui_combo_out(label, out, items_nul)
    return (changed, __imgui_read_out(out))
}

