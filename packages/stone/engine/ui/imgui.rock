"""

// Reports whether the most recently submitted item is being interacted with
// (held down). Pair with `imgui_invisible_button` for the canonical
// click-drag-paint pattern: the button defines the input region; IsItemActive
// returns true for the duration of the drag, even if the cursor moves
// outside the region while held.
pub inline(lua) fn imgui_is_item_active() -> bool = """
    return imgui.IsItemActive()
"""

// Allocates a non-rendered widget at the cursor that captures input
// (clicks, drags, hover) for its bounding rect. The label must be unique
// within the window — prefix with `##` to keep it from showing in tooltips.
pub @scalar_abi inline(lua) fn imgui_invisible_button(label: string, size: Vec2) -> bool = """
    local cache = __imgui_shared_image_packet()
    cache.s.x, cache.s.y = size__x, size__y
    return imgui.InvisibleButton(label, cache.s)
"""

// Rewinds the cursor to a specific screen-space position. Used to overlay
// an InvisibleButton on top of an Image (or other widget) without it being
// pushed below in normal layout flow.
pub @scalar_abi inline(lua) fn imgui_set_cursor_screen_pos(pos: Vec2) = """
    local cache = __imgui_shared_image_packet()
    cache.pos.x, cache.pos.y = pos__x, pos__y
    imgui.SetCursorScreenPos(cache.pos)
"""

// Reserves a `size`-sized empty item at the cursor and advances the
// cursor by it. Use this to grow window/parent content bounds (so
// ImGui's auto-resize accounts for area you drew via SetCursorScreenPos
// / a custom batch but where no real widget covers the full extent).
// Without a Dummy, ImGui asserts on SetCursorScreenPos calls that move
// the cursor past the last item's bounds.
pub @scalar_abi inline(lua) fn imgui_dummy(size: Vec2) = """
    local cache = __imgui_shared_image_packet()
    cache.pos.x, cache.pos.y = size__x, size__y
    imgui.Dummy(cache.pos)
"""

// Draws a filled rect into the current window's foreground draw list at
// absolute screen coords. Used by the pixel editor's checkerboard
// background. Color packed as 0xAABBGGRR (ImGui's ImU32 layout).
pub @scalar_abi inline(lua) fn imgui_window_add_rect_filled(p_min: Vec2, p_max: Vec2, col_abgr: int) = """
    local dl = imgui.GetWindowDrawList()
    if dl == nil then return end
    local cache = __imgui_shared_image_packet()
    cache.u1.x, cache.u1.y = p_min__x, p_min__y
    cache.u2.x, cache.u2.y = p_max__x, p_max__y
    dl:AddRectFilled(cache.u1, cache.u2, col_abgr)
"""

// Draws a filled rect into ImGui's *foreground* draw list — i.e., the
// layer that renders ON TOP of every ImGui window. Same screen-space
// + ImU32 (0xAABBGGRR) conventions as imgui_window_add_rect_filled.
//
// Use this for HUD/overlay content (mouse cursor, debug crosshairs)
// that must stay on top of ImGui windows. It rides along inside
// stone_imgui_render(), so it is drawn after every ImGui window.
//
// It is NOT the only way above ImGui any more: the runner's post-ImGui
// pass (frame_core_render_overlay, OVERLAY_RENDER_BATCHES) flushes
// Stone's own UI pool after stone_imgui_render() too, with Stone's
// text and shapes rather than ImGui's. What lands UNDER ImGui is the
// MAIN UI pool, which flushes before it.
pub @scalar_abi inline(lua) fn imgui_foreground_add_rect_filled(
    p_min: Vec2, p_max: Vec2, col_abgr: int,
) = """
    local dl = imgui.GetForegroundDrawList_ViewportPtr(nil)
    if dl == nil then return end
    local cache = __imgui_shared_image_packet()
    cache.u1.x, cache.u1.y = p_min__x, p_min__y
    cache.u2.x, cache.u2.y = p_max__x, p_max__y
    dl:AddRectFilled(cache.u1, cache.u2, col_abgr)
"""

// Color overload — packs RGBA floats into ImU32 (0xAABBGGRR) once,
// avoiding manual bit-twiddling at call sites.
pub fn imgui_foreground_add_rect_filled(p_min: Vec2, p_max: Vec2, color: Color) {
    imgui_foreground_add_rect_filled(p_min, p_max, color_to_abgr(color))
}

// Pack a Color into ImGui's ImU32 (0xAABBGGRR) format.
// Plain Rock, not inline(lua): it is ordinary arithmetic, so every backend
// gets it from one body and it needs no per-backend twin.
pub @pure fn color_to_abgr(c: Color) -> int {
    let r = color_byte(c.r)
    let g = color_byte(c.g)
    let b = color_byte(c.b)
    let a = color_byte(c.a)
    return a * 0x1000000 + b * 0x10000 + g * 0x100 + r
}

@pure fn color_byte(x: float) -> int {
    return int(max(0.0, min(255.0, floor(x * 255.0 + 0.5))))
}

// Filled circle on the foreground draw list — handy for cursor dots,
// reticles, hover indicators. `num_segments=0` lets ImGui auto-pick
// based on radius.
pub @scalar_abi inline(lua) fn imgui_foreground_add_circle_filled(
    center: Vec2, radius: float, col_abgr: int, num_segments: int = 0,
) = """
    local dl = imgui.GetForegroundDrawList_ViewportPtr(nil)
    if dl == nil then return end
    local cache = __imgui_shared_image_packet()
    cache.pos.x, cache.pos.y = center__x, center__y
    dl:AddCircleFilled(cache.pos, radius, col_abgr, num_segments)
"""

// Line on the foreground draw list. Width in pixels.
pub @scalar_abi inline(lua) fn imgui_foreground_add_line(
    p1: Vec2, p2: Vec2, col_abgr: int, thickness: float = 1.0,
) = """
    local dl = imgui.GetForegroundDrawList_ViewportPtr(nil)
    if dl == nil then return end
    local cache = __imgui_shared_image_packet()
    cache.u1.x, cache.u1.y = p1__x, p1__y
    cache.u2.x, cache.u2.y = p2__x, p2__y
    dl:AddLine(cache.u1, cache.u2, col_abgr, thickness)
"""

// Window draw-list variants of line/circle: clipped + scrolled with the
// current window (the foreground list ignores both). Absolute screen
// coords, ImU32 0xAABBGGRR color -- same conventions as
// imgui_window_add_rect_filled above.
pub @scalar_abi inline(lua) fn imgui_window_add_line(
    p1: Vec2, p2: Vec2, col_abgr: int, thickness: float = 1.0,
) = """
    local dl = imgui.GetWindowDrawList()
    if dl == nil then return end
    local cache = __imgui_shared_image_packet()
    cache.u1.x, cache.u1.y = p1__x, p1__y
    cache.u2.x, cache.u2.y = p2__x, p2__y
    dl:AddLine(cache.u1, cache.u2, col_abgr, thickness)
"""

// Fills a convex quad in the current window's draw list at absolute screen
// coords. Color packed as 0xAABBGGRR.
pub @scalar_abi inline(lua) fn imgui_window_add_quad_filled(
    p1: Vec2, p2: Vec2, p3: Vec2, p4: Vec2, col_abgr: int,
) = """
    local dl = imgui.GetWindowDrawList()
    if dl == nil then return end
    local cache = __imgui_shared_image_packet()
    cache.p1.x, cache.p1.y = p1__x, p1__y
    cache.p2.x, cache.p2.y = p2__x, p2__y
    cache.p3.x, cache.p3.y = p3__x, p3__y
    cache.p4.x, cache.p4.y = p4__x, p4__y
    dl:AddQuadFilled(cache.p1, cache.p2, cache.p3, cache.p4, col_abgr)
"""

pub @scalar_abi inline(lua) fn imgui_window_add_circle_filled(
    center: Vec2, radius: float, col_abgr: int, num_segments: int = 0,
) = """
    local dl = imgui.GetWindowDrawList()
    if dl == nil then return end
    local cache = __imgui_shared_image_packet()
    cache.pos.x, cache.pos.y = center__x, center__y
    dl:AddCircleFilled(cache.pos, radius, col_abgr, num_segments)
"""

// Draws a tiled checkerboard via the window's draw list in a single Lua
// loop, getting the draw list once and reusing two ImVec2 cdata across
// all cells. ~30-100x faster than calling AddRectFilled per cell from
// Rock for large canvases (eg 3840x2160 atlas at zoom=1: ~130k cells —
// per-cell Rock->Lua trampolining was the pixel editor's headline lag).
//
// Caller picks `cell`; this function does no clipping (right/bottom
// cells extend past origin+size by up to cell-1 pixels). Useful for the
// pixel editor where the checkerboard sits behind an image that masks
// any overshoot.
// rock: allow(long_inline_lua, "perf-critical bulk loop replaces per-cell FFI")
pub @scalar_abi inline(lua) fn imgui_draw_checkerboard(
    origin: Vec2, size: Vec2, cell: float,
    light_abgr: int, dark_abgr: int,
) -> int = """
    local dl = imgui.GetWindowDrawList()
    if dl == nil then return 0 end
    local cache = __imgui_shared_image_packet()
    local p_min, p_max = cache.u1, cache.u2
    local x0 = origin__x
    local y0 = origin__y
    local cells_x = math.ceil(size__x / cell)
    local cells_y = math.ceil(size__y / cell)
    local total = 0
    for cy = 0, cells_y - 1 do
        local py0 = y0 + cy * cell
        local py1 = py0 + cell
        for cx = 0, cells_x - 1 do
            local px0 = x0 + cx * cell
            p_min.x = px0
            p_min.y = py0
            p_max.x = px0 + cell
            p_max.y = py1
            local col = ((cx + cy) % 2 == 0) and light_abgr or dark_abgr
            dl:AddRectFilled(p_min, p_max, col)
            total = total + 1
        end
    end
    return total
"""

// Constrain the next window's resize range. A negative max preserves the
// current axis; use a huge positive value when there is no authored maximum.
pub @scalar_abi inline(lua) fn imgui_set_next_window_size_constraints(min_size: Vec2, max_size: Vec2) = """
    local cache = __imgui_shared_image_packet()
    cache.u1.x, cache.u1.y = min_size__x, min_size__y
    cache.u2.x, cache.u2.y = max_size__x, max_size__y
    imgui.SetNextWindowSizeConstraints(cache.u1, cache.u2)
"""

// Begin a scrollable child region. Call imgui_end_child() to close.
// Border off; size = (0, 0) means "fill remaining space".
@scalar_abi inline(lua) fn __imgui_begin_child_scroll_raw(id: string, size: Vec2) -> bool = """
    local cache = __imgui_shared_image_packet()
    cache.s.x, cache.s.y = size__x, size__y
    return imgui.BeginChild_Str(id, cache.s, 0, 0)
"""

pub fn imgui_begin_child_scroll(id: string, size: Vec2) -> bool {
    let open = __imgui_begin_child_scroll_raw(id, size)
    if open { imgui_note_body(id) }
    return open
}

// A full-width scrolling child as tall as its content up to `max_height`
// (ImGuiChildFlags_AutoResizeY = 32), for auto-sized windows. The height is
// measured from the previous frame.
@scalar_abi inline(lua) fn __imgui_begin_child_fit_height_raw(id: string, max_height: float) -> bool = """
    local cache = __imgui_shared_image_packet()
    cache.u1.x, cache.u1.y = 0, 0
    cache.u2.x, cache.u2.y = 1e30, max_height
    imgui.SetNextWindowSizeConstraints(cache.u1, cache.u2)
    cache.s.x, cache.s.y = 0, 0
    return imgui.BeginChild_Str(id, cache.s, 32, 0)
"""

pub fn imgui_begin_child_fit_height(id: string, max_height: float) -> bool {
    let open = __imgui_begin_child_fit_height_raw(id, max_height)
    if open { imgui_note_body(id) }
    return open
}

// High-resolution monotonic-ish timer for in-editor profiling. Returns
// CPU seconds since process start; subtract two readings for an elapsed
// duration. Sub-microsecond resolution on LuaJIT/macOS+Linux.
pub inline(lua) fn imgui_perf_now() -> float = """
    return os.clock()
"""

pub @scalar_abi inline(lua) fn imgui_slider_float2(label: string, value: Vec2, min: float, max: float) -> (bool, Vec2) = """
    local v = ffi.new("float[2]", {value__x, value__y})
    local changed = imgui.SliderFloat2(label, v, min, max)
    return changed, v[0], v[1]
"""

pub @scalar_abi inline(lua) fn imgui_slider_float4(label: string, value: Color, min: float, max: float) -> (bool, Color) = """
    local v = ffi.new("float[4]", {value__r, value__g, value__b, value__a})
    local changed = imgui.SliderFloat4(label, v, min, max)
    return changed, v[0], v[1], v[2], v[3]
"""

pub @scalar_abi inline(lua) fn imgui_color_edit4(label: string, value: Color) -> (bool, Color) = """
    local v = ffi.new("float[4]", {value__r, value__g, value__b, value__a})
    local changed = imgui.ColorEdit4(label, v)
    return changed, v[0], v[1], v[2], v[3]
"""

pub @scalar_abi inline(lua) fn imgui_color_picker4(label: string, value: Color) -> (bool, Color) = """
    local v = ffi.new("float[4]", {value__r, value__g, value__b, value__a})
    local changed = imgui.ColorPicker4(label, v)
    return changed, v[0], v[1], v[2], v[3]
"""

