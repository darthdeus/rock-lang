    label: string,
    buffer: string,
    max_len: int,
    flags: int
) -> (bool, string) = """
    local buf = ffi.new("char[?]", max_len + 1)
    ffi.copy(buf, buffer)
    local changed = imgui.InputText(label, buf, max_len, flags)
    return changed, ffi.string(buf)
"""

