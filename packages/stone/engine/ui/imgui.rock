pub @scalar_abi inline(lua) fn imgui_set_next_window_pos(pos: Vec2) = """
    local cache = __imgui_shared_image_packet()
    cache.pos.x, cache.pos.y = pos__x, pos__y
    cache.u1.x, cache.u1.y = 0, 0
    imgui.SetNextWindowPos(cache.pos, 0, cache.u1)
"""

// Places the next window's `pivot` point (0..1 of its own size) at `pos`
// every frame, so a window anchored by a corner stays there while resized.
pub @scalar_abi inline(lua) fn imgui_set_next_window_pos_pivot(pos: Vec2, pivot: Vec2) = """
    local cache = __imgui_shared_image_packet()
    cache.pos.x, cache.pos.y = pos__x, pos__y
    cache.u1.x, cache.u1.y = pivot__x, pivot__y
    imgui.SetNextWindowPos(cache.pos, 0, cache.u1)
"""

pub @scalar_abi inline(lua) fn imgui_set_window_pos_named(title: string, pos: Vec2) = """
    local cache = __imgui_shared_image_packet()
    cache.pos.x, cache.pos.y = pos__x, pos__y
    imgui.C.igSetWindowPos_Str(title, cache.pos, 0)
"""
pub @scalar_abi inline(lua) fn imgui_set_next_window_size(size: Vec2) = """
    local cache = __imgui_shared_image_packet()
    cache.s.x, cache.s.y = size__x, size__y
    imgui.SetNextWindowSize(cache.s)
"""

// Size the window on its FIRST appearance only (ImGuiCond_FirstUseEver = 4),
// leaving the user's own resize alone afterwards. The unconditional form above
// re-forces the size every frame, so a window drawn with it cannot be resized
// at all -- if a debug window won't take a drag, this is why.
pub @scalar_abi inline(lua) fn imgui_set_next_window_size_once(size: Vec2) = """
    local cache = __imgui_shared_image_packet()
    cache.s.x, cache.s.y = size__x, size__y
    imgui.SetNextWindowSize(cache.s, 4)
"""

@nomangle inline(lua) fn __imgui_shared_image_packet() -> any = """
    local cache = _G.__rock_imgui_shared_image_packet
    if cache == nil then
        local ffi = require("ffi")
        cache = {
            s = ffi.new("ImVec2"),
            pos = ffi.new("ImVec2"),
            u1 = ffi.new("ImVec2"),
            u2 = ffi.new("ImVec2"),
            u3 = ffi.new("ImVec2"),
            u4 = ffi.new("ImVec2"),
            p1 = ffi.new("ImVec2"),
            p2 = ffi.new("ImVec2"),
            p3 = ffi.new("ImVec2"),
            p4 = ffi.new("ImVec2"),
            bg = ffi.new("ImVec4"),
            tint = ffi.new("ImVec4"),
            tex = ffi.new("ImTextureRef"),
        }
        _G.__rock_imgui_shared_image_packet = cache
    end
    return cache
"""

// The GL texture name an image widget binds. Under SIM_DRAW=commands
// nothing samples, so it is 0 rather than a headers-only image's name (which
// the loader reports as an error, correctly, when something asks for it).
pub fn imgui_texture_name(image: Image) -> int {
    if SIM_SKIP_SUBMIT { return 0 }
    return stone_get_image_texture(image.0)
}

pub @scalar_abi inline(lua) fn imgui_image_raw(
    texture: int,
    size: Vec2,
    uv1: Vec2,
    uv2: Vec2,
    tint_color: Color,
    border_color: Color
) = """
    local cache = __imgui_shared_image_packet()
    cache.s.x, cache.s.y = size__x, size__y
    cache.u1.x, cache.u1.y = uv1__x, uv1__y
    cache.u2.x, cache.u2.y = uv2__x, uv2__y
    cache.tint.x, cache.tint.y = tint_color__r, tint_color__g
    cache.tint.z, cache.tint.w = tint_color__b, tint_color__a
    cache.bg.x, cache.bg.y = border_color__r, border_color__g
    cache.bg.z, cache.bg.w = border_color__b, border_color__a

    cache.tex._TexData = nil
    cache.tex._TexID = texture
    imgui.Image(cache.tex, cache.s, cache.u1, cache.u2, cache.tint, cache.bg)
"""

// Draws an image as an arbitrary quad into the current window's draw list at
// absolute screen coords: p1..p4 carry uv1..uv4 in order, so an affine
// mapping (a rotated or sheared image) stays exact across the two triangles.
// Color packed as 0xAABBGGRR.
pub @scalar_abi inline(lua) fn imgui_window_add_image_quad(
    texture: int,
    p1: Vec2, p2: Vec2, p3: Vec2, p4: Vec2,
    uv1: Vec2, uv2: Vec2, uv3: Vec2, uv4: Vec2,
    col_abgr: int,
) = """
    local dl = imgui.GetWindowDrawList()
    if dl == nil then return end
    local cache = __imgui_shared_image_packet()
    cache.tex._TexData = nil
    cache.tex._TexID = texture
    cache.p1.x, cache.p1.y = p1__x, p1__y
    cache.p2.x, cache.p2.y = p2__x, p2__y
    cache.p3.x, cache.p3.y = p3__x, p3__y
    cache.p4.x, cache.p4.y = p4__x, p4__y
    cache.u1.x, cache.u1.y = uv1__x, uv1__y
    cache.u2.x, cache.u2.y = uv2__x, uv2__y
    cache.u3.x, cache.u3.y = uv3__x, uv3__y
    cache.u4.x, cache.u4.y = uv4__x, uv4__y
    dl:AddImageQuad(cache.tex, cache.p1, cache.p2, cache.p3, cache.p4,
        cache.u1, cache.u2, cache.u3, cache.u4, col_abgr)
"""

// ImTextureID is the canvas texture's native GL name.
@scalar_abi inline(lua) fn imgui_canvas_image_raw(
    texture: int,
    size: Vec2,
    uv1: Vec2,
    uv2: Vec2,
    tint_color: Color,
    border_color: Color
) = """
    local cache = __imgui_shared_image_packet()
    cache.s.x, cache.s.y = size__x, size__y
    cache.u1.x, cache.u1.y = uv1__x, uv1__y
    cache.u2.x, cache.u2.y = uv2__x, uv2__y
    cache.tint.x, cache.tint.y = tint_color__r, tint_color__g
    cache.tint.z, cache.tint.w = tint_color__b, tint_color__a
    cache.bg.x, cache.bg.y = border_color__r, border_color__g
    cache.bg.z, cache.bg.w = border_color__b, border_color__a

    cache.tex._TexData = nil
    cache.tex._TexID = texture
    imgui.Image(cache.tex, cache.s, cache.u1, cache.u2, cache.tint, cache.bg)
"""

// Canvas textures are Y-flipped relative to imgui's UV convention, hence the
// (0,1)-(1,0) default.
pub fn imgui_canvas_image(
    canvas: Canvas,
    size: Vec2,
    uv1: Vec2 = v(0, 1),
    uv2: Vec2 = v(1, 0),
    color: Color = WHITE,
    border_color: Color = TRANSPARENT
) {
    let texture = stone_get_canvas_texture(canvas.handle.0)
    imgui_canvas_image_raw(texture, size, uv1, uv2, color, border_color)
}

// `imgui.ImageButton(str_id, tex, size, uv0, uv1, BG, TINT)` -- background
// before tint. The parameters are named for what they ARE and the call below
// passes them in imgui's order, so a caller can trust the signature. Only
// pixels can catch a swap here, which is
// `imgui_image_button_colors` (demos/imgui).
pub @scalar_abi inline(lua) fn imgui_image_button_raw(
    id: string,
    texture: int,
    size: Vec2,
    uv1: Vec2,
    uv2: Vec2,
    bg_color: Color,
    tint_color: Color
) -> bool = """
    local cache = __imgui_shared_image_packet()

    cache.s.x, cache.s.y = size__x, size__y
    cache.u1.x, cache.u1.y = uv1__x, uv1__y
    cache.u2.x, cache.u2.y = uv2__x, uv2__y
    cache.bg.x, cache.bg.y = bg_color__r, bg_color__g
    cache.bg.z, cache.bg.w = bg_color__b, bg_color__a
    cache.tint.x, cache.tint.y = tint_color__r, tint_color__g
    cache.tint.z, cache.tint.w = tint_color__b, tint_color__a

    cache.tex._TexData = nil
    cache.tex._TexID = texture
    return imgui.C.igImageButton(id, cache.tex, cache.s, cache.u1, cache.u2, cache.bg, cache.tint)
"""

inline(lua) fn __imgui_begin_window_raw(title: string, flags: int) -> bool = """
    return imgui.Begin(title, nil, flags)
"""

// Records the body entry (`imgui_note_body`) so a test can ask whether THIS
// window's body ran, rather than whether imgui drew anything at all.
pub fn imgui_begin_window(title: string, flags: int) -> bool {
    let open = __imgui_begin_window_raw(title, flags)
    if open { imgui_note_body(title) }
    return open
}

// Begin a window that must not disturb the game when it appears.
//
// A window takes focus the frame it first appears, which is right for something
// the user opened to type into and wrong for a debug overlay bound to a
// function key: hitting F6 should show you something, not change what the
// keyboard is pointed at. NoFocusOnAppearing (4096) stops that, and NoNav
// (196608) keeps the window out of keyboard navigation for good, so a later
// click on it does not start routing keys either.
//
// Returns false when the window is collapsed -- skip the contents then, and
// call imgui_end() regardless (Begin/End must pair whatever it returns).
fn imgui_begin_debug_window(title: string) -> bool {
    return imgui_begin_window(title, 4096 + 196608)
}

pub @scalar_abi inline(lua) fn imgui_begin_child(id: string, size: Vec2, border: bool) -> bool = """
    local cache = __imgui_shared_image_packet()
    cache.s.x, cache.s.y = size__x, size__y
    return imgui.BeginChild_Str(id, cache.s, border and 1 or 0, 0)
"""

