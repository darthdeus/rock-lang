// Allocate a single StoneEvent buffer for polling. Runtime value is
// `ffi.new("StoneEvent")` cdata; the empty StoneEvent struct is pure
// compile-time phantom typing.
pub @nomangle inline(lua) fn stone_event_new() -> StoneEvent = 'return ffi.new("StoneEvent")'

inline(lua) fn get_stone_event_type(event: StoneEvent) -> int = "return tonumber(event.type)"
inline(lua) fn get_stone_event_key(event: StoneEvent) -> int = "return tonumber(event.key)"
inline(lua) fn get_stone_event_scancode(event: StoneEvent) -> int = "return tonumber(event.scancode)"
inline(lua) fn get_stone_event_modifiers(event: StoneEvent) -> int = "return tonumber(event.modifiers)"
pub inline(lua) fn get_stone_event_repeat(event: StoneEvent) -> bool = "return event['repeat']"
inline(lua) fn get_stone_event_mouse_button(event: StoneEvent) -> int = "return tonumber(event.mouse_button)"
inline(lua) fn get_stone_event_mouse_x(event: StoneEvent) -> int = "return tonumber(event.mouse_x)"
inline(lua) fn get_stone_event_mouse_y(event: StoneEvent) -> int = "return tonumber(event.mouse_y)"
inline(lua) fn get_stone_event_pad_instance(event: StoneEvent) -> int = "return tonumber(event.pad_instance_id)"
@inline inline(lua) fn get_stone_event_pad_button_ptr(event: StoneEvent) -> any = "return event.pad_button"

fn get_stone_event_pad_button(event: StoneEvent) -> string {
    let p = get_stone_event_pad_button_ptr(event)
    if __stone_ptr_is_null(p) { return "" }
    return ffi_string(p, null)
}

@inline inline(lua) fn get_stone_event_pad_axis_ptr(event: StoneEvent) -> any = "return event.pad_axis"

fn get_stone_event_pad_axis(event: StoneEvent) -> string {
    let p = get_stone_event_pad_axis_ptr(event)
    if __stone_ptr_is_null(p) { return "" }
    return ffi_string(p, null)
}

inline(lua) fn get_stone_event_pad_value(event: StoneEvent) -> int = "return tonumber(event.pad_value)"
pub inline(lua) fn get_stone_event_pad_sync(event: StoneEvent) -> bool = "return event.pad_sync"
@inline inline(lua) fn get_stone_event_text_ptr(event: StoneEvent) -> any = "return event.text"

fn get_stone_event_text(event: StoneEvent) -> string {
    return ffi_string(get_stone_event_text_ptr(event), null)
}

