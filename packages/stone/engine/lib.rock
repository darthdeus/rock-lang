pub extern(ffi, "stone") fn stone_is_directory_status(path: string) -> int

pub fn stone_file_exists(path: string) -> bool {
    let status = stone_file_exists_status(path)
    if status < 0 { error("failed to inspect filesystem path '{path}'") }
    return status == 1
}

pub fn stone_is_directory(path: string) -> bool {
    let status = stone_is_directory_status(path)
    if status < 0 { error("failed to inspect directory path '{path}'") }
    return status == 1
}
