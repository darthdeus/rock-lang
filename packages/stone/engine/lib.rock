
// 0.0 until the runner writes the frame delta, so code run by an eager
// `start()` prime before the first frame reads 0, not nil.
pub global dt: float = 0.0
pub global time: float = 0

// Replay is exempt: the log carries the already-scaled dt.
pub global TIME_SCALE: float = get_env_float("STONE_TIME_SCALE", 1.0)

// Advances once per host frame, including paused frames; game ticks use the host clock.
pub global frame_seq: int = 0

