pub @nomangle inline(lua) fn stone_list_directory(path: string) -> [string]? = """
    local files_ptr = ffi.new("char**[1]")
    local count_ptr = ffi.new("int[1]")

    if not stone.stone_list_directory(path, files_ptr, count_ptr) then
        _log_once_impl(0, "FILE", "stone_list_directory failed for " .. tostring(path),
            "stone_list_directory:failed:" .. tostring(path))
        return null
    end

    local count = count_ptr[0]
    local files = files_ptr[0]

    local result = { _data = {}, len = count, __ty = "Vec" }
    for i = 0, count - 1 do
        result._data[i + 1] = ffi.string(files[i])
    end

    if count > 0 then stone.stone_free_string_array(files, count) end
    return result
"""

