// ============================================================================
// High-level initialization/shutdown functions
// ============================================================================

pub global stone_window: StoneWindow? = null

// Initialize stone with a window at the given position on the given display.
// Returns the window handle or null on failure. (Pass x=0, y=0, display=0
// for the legacy "centered on the primary display" behavior — SDL handles
// the centering inside stone_create_window_ex.)
fn stone_init_window(
    title: string,
    x: int,
    y: int,
    width: int,
    height: int,
    display: int,
    resizable: bool,
    fullscreen: int
) -> StoneWindow? {
    if !stone_init() {
        log_once("STONE/INIT", "stone_init() failed (SDL initialization)")
        return null
    }

    if !stone_audio_init() {
        // Don't abort — a missing/broken audio device shouldn't prevent the
        // game from running. Sound playback functions will be no-ops.
        log_once("STONE/INIT", "stone_audio_init() failed; continuing without sound")
    }

    let window = stone_create_window_ex(title, x, y, width, height, display, resizable, fullscreen)
    if is_null(window) {
        log_once("STONE/INIT", "stone_create_window_ex(title={title}, {width}x{height}, display={display}) returned null")
        stone_audio_quit()
        stone_teardown()
        return null
    }

    if !stone_sprite_init() {
        log_once("STONE/INIT", "stone_sprite_init() failed (GL sprite system)")
        stone_audio_quit()
        stone_teardown()
        return null
    }

    if !stone_text_init() {
        log_once("STONE/INIT", "stone_text_init() failed (FreeType text system)")
        stone_audio_quit()
        stone_teardown()
        return null
    }

    stone_window = window
    mark_stone_initialized()
    return window
}

// GPU host for code that runs outside the frame runner: package tests and
// headless tools that create images, canvases or passes. One hidden window
// owns the GL context for the rest of the process; a window per caller
// destroyed its context and left every image, canvas and program created
// under it dangling for the next caller. Reuses the runner's window when one
// is up. Every call drains programs queued since the last one.
pub fn stone_gpu_host_ensure() -> bool {
    return stone_gpu_host_window() != null
}

// Borrow the process GPU window for native subsystems; the host owns its lifetime.
pub fn stone_gpu_host_window() -> StoneWindow? {
    let window = stone_gpu_host_acquire()
    if is_null(window) { return null }
    gpu_programs_drain()
    return window
}

// Runs ONCE after the main loop exits; stone_teardown() ends the window, the
// GL context and everything allocated in it.
fn stone_shutdown_window() -> bool {
    screenshot_fail_pending("no presented frame before shutdown")
    frame_stream_close_at_shutdown()
    drop_all_text_batches()
    stone_audio_quit()
    if !stone_teardown() {
        log_error("STONE", "Stone teardown refused; retaining window")
        return false
    }
    stone_window = null
    return true
}

pub extern(ffi, "stone") fn stone_save_screenshot(filepath: string, width: int, height: int, max_size: int) -> bool

extern(ffi, "stone") fn stone_save_screenshot_sized(filepath: string, width: int, height: int, max_size: int, out_w: Ptr<int>, out_h: Ptr<int>) -> bool

// Wraps the raw out-pointer FFI call: (succeeded, actual_width, actual_height).
// The actual dimensions can differ from the requested width/height when
// max_size triggers a resize -- this is the only place that knows the real
// output size without re-deriving stone-capture's resize arithmetic. A
// separate name from stone_save_screenshot: that one is called directly,
// for its plain bool, by many existing sims -- this is for the one caller
// (the agent capture pipeline) that needs honest output dimensions.
fn stone_save_screenshot_sized(filepath: string, width: int, height: int, max_size: int) -> (bool, int, int) {
    let ok = stone_save_screenshot_sized(filepath, width, height, max_size, FFI_INT_OUT_1.ptr, FFI_INT_OUT_2.ptr)
    return (ok, FFI_INT_OUT_1.ptr.read(), FFI_INT_OUT_2.ptr.read())
}

// Frame stream recording (util/frame_stream.rock).
extern(ffi, "stone") fn stone_frame_stream_begin(path: string) -> bool
extern(ffi, "stone") fn stone_frame_stream_record(width: int, height: int) -> bool
extern(ffi, "stone") fn stone_frame_stream_finish(out_frames: Ptr<int>, out_w: Ptr<int>, out_h: Ptr<int>) -> bool
inline(lua) fn stone_frame_stream_last_error() -> string = "return ffi.string(stone.stone_frame_stream_last_error())"

// (ok, frames, width, height) of the finished stream.
fn stone_frame_stream_finish() -> (bool, int, int, int) {
    let ok = stone_frame_stream_finish(FFI_INT_OUT_1.ptr, FFI_INT_OUT_2.ptr, FFI_INT_OUT_3.ptr)
    return (ok, FFI_INT_OUT_1.ptr.read(), FFI_INT_OUT_2.ptr.read(), FFI_INT_OUT_3.ptr.read())
}

