pub fn stone_get_font_atlas_size(font_id: int) -> IVec2? {
    if !stone_get_font_atlas_size(font_id, FFI_INT_OUT_1.ptr, FFI_INT_OUT_2.ptr) {
        return null
    }
    return IVec2 { x: FFI_INT_OUT_1.ptr.read(), y: FFI_INT_OUT_2.ptr.read() }
}

// Bytes of TTF/OTF the font retains, or -1 for an id that names no live font.
pub extern(ffi, "stone") fn stone_font_data_len(font_id: int) -> int

// Drop one font's coverage products (compat atlas, bucket textures, IMAGES
// aliases); the face stays live. False names an unknown font id.
pub extern(ffi, "stone") fn stone_font_release_coverage(font_id: int) -> bool

// Load a font and return a Font handle (or null on failure). Use this
// from games to load a non-default font; runner.rock uses it internally
// to populate DEFAULT_FONT.
//
// `path` must be already asset_path-resolved (runner.rock does this): it's passed
// straight to the loader and stored for hot reload; a relative path won't match.
//
// Side effect: populates the per-font batch state (atlas / pixel size /
// glyph cache) in rendering/text.rock so the queue_ui_text path is ready to draw
// with this font immediately. Callers don't need a separate init step.
// `extra` declares codepoints to bake BESIDE printable ASCII, written as the
// text itself: `extra: "\u{1F600}\u{1F44D}"`. A declared codepoint the font
// does not cover bakes invalid and is skipped by the draw, exactly as an
// uncovered ASCII slot already is.
fn load_font_at_raster_size(path: string, base_pixel_size: int, raster_size: int,
    sampling: TextureFilter, raster: FontRasterPolicy, faces: TextFaces,
    initialize_batch: bool = true, native_em: int = 0,
    extra: string = "") -> Font? {
    let id = stone_load_font_ffi(path, raster_size, face_mask(faces), extra)
    if id == 0 { return null }
    return register_loaded_font(id, path, base_pixel_size, raster_size, sampling,
        raster, faces, initialize_batch, native_em, extra)
}

// `metrics_only` is the one fact that separates a font that can be DRAWN from a
// font that can only be MEASURED. It gates the two steps that are about pixels
// rather than metrics: the atlas page (a GL texture, which a metrics font does
// not own) and the hot-reload watch (a re-raster, which stone-rs refuses on a
// metrics font because there is no texture to re-upload into).
fn register_loaded_font(id: int, path: string, base_pixel_size: int, raster_size: int,
    sampling: TextureFilter, raster: FontRasterPolicy, faces: TextFaces,
    initialize_batch: bool, native_em: int, extra: string,
    metrics_only: bool = false) -> Font {
    STONE_FONT_LOADED = true
    let entity = FONT_REGISTRY.insert(FontData {
        backend_id: id, base_pixel_size: base_pixel_size, pixel_size: raster_size,
        cap_height: 0.0, native_em: native_em,
        raster: raster, path: path, sampling: sampling, faces: faces, extra: extra })
    let font = Font { handle: entity }
    if initialize_batch { init_text_batch_for(font, atlas: !metrics_only) }
    if ASSET_DEV_MODE && !metrics_only { stone_watch_asset(path) }
    return font
}

// Load a font for MEASUREMENT AND LAYOUT ONLY. The same file, charset and
// font-unit metrics as `load_font`, with no atlas texture -- which is the only
// way a font loads in a process that never created a window, and so the only
// way the `rock test <game>` luajit process can measure text.
//
// The raster policy is Fixed, not a parameter: `OutputDensity` asks the window
// for its drawable/logical ratio and there is no window. Nothing is lost,
// because layout divides every advance by the font's own units-per-em, so the
// raster size does not appear in a measurement (pinned in stone-rs by
// `unit_metrics_do_not_depend_on_the_raster_size`).
//
// `sampling` is recorded for the FontData the registry keeps, and is never
// observed: the only reader is the atlas page this font does not have.
pub fn load_font_metrics(path: string, pixel_size: int,
    faces: TextFaces = TextFaces {},
    native_em: int = 0,
    extra: string = "") -> Font? {
    let id = stone_load_font_metrics_ffi(path, pixel_size, face_mask(faces), extra)
    if id == 0 { return null }
    return register_loaded_font(id, path, pixel_size, pixel_size,
        TextureFilter::Nearest, FontRasterPolicy::Fixed, faces,
        true, native_em, extra, metrics_only: true)
}

pub fn load_font(path: string, pixel_size: int,
    sampling: TextureFilter = TextureFilter::Linear,
    raster: FontRasterPolicy = FontRasterPolicy::OutputDensity,
    faces: TextFaces = TextFaces {},
    native_em: int = 0,
    extra: string = "") -> Font? {
    let raster_size = resolve_font_raster_size(pixel_size, raster)
    return load_font_at_raster_size(path, pixel_size, raster_size, sampling, raster,
        faces, true, native_em, extra)
}

// Re-rasterize a font in place (atlas texture + backend_id preserved), then
// re-pull the Rock-side glyph caches. Old atlas kept on failure.
pub fn reload_font(font: Font, changed: string) {
    let fd = font.data() ?? return
    if stone_reload_font_ffi(fd.backend_id, changed, fd.pixel_size) {
        // A released font refreshes its metrics without pages: native keeps
        // its coverage down, so there is no atlas to page.
        init_text_batch_for(font, atlas: stone_get_font_atlas_size(fd.backend_id) != null)
        log_info("ASSETS", "Hot-reloaded font {fd.path} @ {fd.pixel_size}px")
    } else {
        log_once("ASSETS", "Hot-reload failed for font {changed} @ {fd.pixel_size}px")
    }
}

pub fn refresh_font_density() {
    for (entity, fd) in FONT_REGISTRY {
        if fd.raster != FontRasterPolicy::OutputDensity { continue }
        let desired = resolve_font_raster_size(fd.base_pixel_size, fd.raster)
        if desired == fd.pixel_size { continue }
        if stone_resize_font_ffi(fd.backend_id, desired) {
            fd.pixel_size = desired
            init_text_batch_for(Font { handle: entity })
            log_info("FONT", "Raster density changed: {fd.path} -> {desired}px")
        } else {
            log_error("FONT", "Failed to rasterize {fd.path} at {desired}px; keeping {fd.pixel_size}px")
        }
    }
}

// Unload a font. Frees the GL atlas in stone-rs, drops the batch state,
// and removes the Entity from FONT_REGISTRY — any other Font handle
// that referenced this entity is now stale (font.data() returns null,
// every draw/measure silently no-ops).
//
// Manual lifecycle for now; a future `arena_with_drop<T>` would let
// the destructor run automatically on remove. Don't double-free:
// calling unload_font on a stale handle returns immediately.
pub fn unload_font(font: Font) {
    let d = font.data() ?? return
    let backend_id = d.backend_id
    let released = stone_unload_font_ffi(backend_id)
    drop_text_batch_for(backend_id)
    font.handle.remove()
    let cur = DEFAULT_FONT
    // Slot-only on purpose: `font.data() ?? return` above proves `font` is live,
    // so a same-slot match means DEFAULT_FONT is either this entity or already
    // stale -- and nulling a stale DEFAULT_FONT is the wanted outcome. Full
    // `equals` would leave the stale handle installed.
    if cur != null && cur.unwrap().handle._slot == font.handle._slot {
        DEFAULT_FONT = null
    }
    if !released {
        error("unload_font could not release live font HostProjection {backend_id}")
    }
}

// Release a font's coverage products (the compat atlas and its IMAGES alias,
// plus every demand-bucket texture) while face bytes and metrics stay live.
// Later raster demand rebuilds coverage.

pub fn font_release_coverage(font: Font) {
    let d = font.data() ?? return
    let idx = d.backend_id - 1
    if idx < 0 || idx >= FONT_ATLASES.len { return }
    if !stone_font_release_coverage(d.backend_id) { return }
    FONT_ATLASES[idx] = Image(0)
}

// Per-font FFI wrappers. Existing top-level wrappers below default to
// DEFAULT_FONT.id; these take an explicit font_id so the Font methods
// (font.draw, font.measure) can target a specific font.
// text.rs draws through the Rock-authored text_shader (text_shader.rock),
// resolved to its live registry program by handle -- fresh every draw, so a
// hot-reload that re-registers the shader under a new handle is picked up with
// no cached-handle staleness (same pattern as get_shader_handle in the batch
// flush). A missing handle (0) is text.rs's loud fail-closed skip.
pub fn stone_draw_text_for(
    space: DrawSpace,
    font_id: int,
    text: string,
    x: float,
    y: float,
    scale_x: float,
    scale_y: float,
    r: float,
    g: float,
    b: float,
    a: float
) {
    // text.rs no longer writes the matrices by name -- they are block members
    // now, so this path owes the engine block in the caller's declared space.
    if space == DrawSpace::Target { begin_cleared_camera() }
    set_engine_uniforms(text_shader, camera_y_bounds())
    if space == DrawSpace::Target { end_cleared_camera() }
    set_uniform_block(text_shader, TextFragU { textColor: v(r, g, b, a) })
    __stone_draw_text_ffi(get_shader_handle(text_shader), font_id, text, x, y, scale_x, scale_y)
    audit_text_texture_slot()
}

pub fn stone_draw_text_ex_for(
    space: DrawSpace,
    font_id: int,
    text: string,
    x: float,
    y: float,
    scale_x: float,
    scale_y: float,
    r: float,
    g: float,
    b: float,
    a: float,
    baseline: float
) {
    if space == DrawSpace::Target { begin_cleared_camera() }
    set_engine_uniforms(text_shader, camera_y_bounds())
    if space == DrawSpace::Target { end_cleared_camera() }
    set_uniform_block(text_shader, TextFragU { textColor: v(r, g, b, a) })
    __stone_draw_text_ex_ffi(get_shader_handle(text_shader), font_id, text, x, y, scale_x, scale_y, baseline)
    audit_text_texture_slot()
}

// text.rs binds the font atlas to unit 0 itself and draws there, so slot 0 of
// `TextTex` IS that bind. Nothing on this path goes through the sprite-mesh
// submit, so these two entries are the only places Rock knows a text draw
// happened.
fn audit_text_texture_slot() {
    mark_texture_slot_filled(text_shader, 0)
    audit_texture_slots_for_draw(text_shader)
}

@inline inline(lua) fn __stone_draw_text_ffi(shader: int, font_id: int, text: string, x: float, y: float, scale_x: float, scale_y: float) = "stone.stone_draw_text(shader, font_id, text, x, y, scale_x, scale_y)"

@inline inline(lua) fn __stone_draw_text_ex_ffi(shader: int, font_id: int, text: string, x: float, y: float, scale_x: float, scale_y: float, baseline: float) = "stone.stone_draw_text_ex(shader, font_id, text, x, y, scale_x, scale_y, baseline)"

pub @inline inline(lua) fn stone_get_text_baseline_for(font_id: int, text: string, scale: float) -> float = "stone.stone_get_text_baseline(font_id, text, scale)"

pub @inline
fn stone_measure_text_vec2_for(font_id: int, text: string, scale: float) -> Vec2 {
    return stone_measure_text_into(font_id, text, scale, FFI_FLOAT_OUT_1.ptr, FFI_FLOAT_OUT_2.ptr)
}

@scalar_abi
inline(lua) fn stone_measure_text_into(font_id: int, text: string, scale: float, w: Ptr<float>, h: Ptr<float>) -> Vec2 = """
    stone.stone_measure_text(font_id, text, scale, w, h)
    return w[0], h[0]
"""

// `tonumber` because the C return is `uint64_t`, which LuaJIT boxes as cdata,
// and an `inline(lua)` body is OPAQUE to the compiler -- it gets none of the
// coercion a declared `extern(ffi) -> int` return gets. Left
// raw, `FONT_ATLASES` held cdata behind an `Image` newtype: keyed by IDENTITY in
// any table, and unequal to the same handle arriving by another route. The
// sibling readers here return `uint32_t`/`int`, which are plain numbers.
pub @inline inline(lua) fn stone_get_font_atlas_image_for(font_id: int) -> int = "tonumber(stone.stone_get_font_atlas_image(font_id))"
@inline inline(lua) fn stone_get_font_atlas_image_cached_ffi(font_id: int) -> int = "tonumber(stone.stone_get_font_atlas_image_cached(font_id))"

pub @inline inline(lua) fn stone_get_font_pixel_size_for(font_id: int) -> int = "stone.stone_get_font_pixel_size(font_id)"

pub @inline inline(lua) fn stone_get_glyph_info_for(font_id: int, face: int, char_code: int, out: Ptr<float>) -> bool = "stone.stone_get_glyph_info(font_id, face, char_code, out)"

// ----------------------------------------------------------------------
// DEFAULT_FONT-backed convenience wrappers
// ----------------------------------------------------------------------
// These preserve the pre-multi-font API: callers pass the same args as
// before and the wrapper routes to DEFAULT_FONT. Silent no-op if no
// default font is loaded — matches old singleton behavior.

pub fn stone_draw_text(
    space: DrawSpace,
    text: string,
    x: float,
    y: float,
    scale_x: float,
    scale_y: float,
    r: float,
    g: float,
    b: float,
    a: float
) {
    let f = DEFAULT_FONT ?? return
    let d = f.data() ?? return
    stone_draw_text_for(space, d.backend_id, text, x, y, scale_x, scale_y, r, g, b, a)
}

pub fn stone_draw_text_ex(
    space: DrawSpace,
    text: string,
    x: float,
    y: float,
    scale_x: float,
    scale_y: float,
    r: float,
    g: float,
    b: float,
    a: float,
    baseline: float
) {
    let f = DEFAULT_FONT ?? return
    let d = f.data() ?? return
    stone_draw_text_ex_for(space, d.backend_id, text, x, y, scale_x, scale_y, r, g, b, a, baseline)
}

pub fn stone_get_text_baseline(text: string, scale: float) -> float {
    let f = DEFAULT_FONT ?? return -1.0
    let d = f.data() ?? return -1.0
    return stone_get_text_baseline_for(d.backend_id, text, scale)
}

pub fn stone_measure_text_vec2(text: string, scale: float) -> Vec2 {
    let f = DEFAULT_FONT ?? return Vec2 { x: 0.0, y: 0.0 }
    let d = f.data() ?? return Vec2 { x: 0.0, y: 0.0 }
    return stone_measure_text_vec2_for(d.backend_id, text, scale)
}

fn stone_get_font_atlas_image_raw() -> int {
    let f = DEFAULT_FONT ?? return 0
    let d = f.data() ?? return 0
    return stone_get_font_atlas_image_for(d.backend_id)
}

fn stone_get_font_pixel_size() -> int {
    let f = DEFAULT_FONT ?? return 0
    let d = f.data() ?? return 0
    return stone_get_font_pixel_size_for(d.backend_id)
}

pub value GlyphData {
    u0: float,
    v0: float,
    u1: float,
    v1: float,
    width: float,
    height: float,
    bearing_x: float,
    bearing_y: float,
    advance: float,
    valid: bool,
}

// Convert SDL keycode to key string
fn sdl_keycode_to_string(keycode: int) -> string {
    if keycode >= 48 && keycode <= 57 { return ascii_char(keycode) }
    if keycode >= 97 && keycode <= 122 { return ascii_char(keycode) }

    // Special keys (SDL uses SDLK_ constants)
    if keycode == 32 { return "space" }
    if keycode == 27 { return "escape" }
    if keycode == 13 { return "return" }
    if keycode == 9 { return "tab" }
    if keycode == 8 { return "backspace" }
    if keycode == 127 { return "delete" }

    // SDL modifier keys (from SDL_keycode.h)
    if keycode == 1073742049 { return "lshift" }  // SDLK_LSHIFT
    if keycode == 1073742053 { return "rshift" }  // SDLK_RSHIFT
    if keycode == 1073742048 { return "lctrl" }   // SDLK_LCTRL
    if keycode == 1073742052 { return "rctrl" }   // SDLK_RCTRL
    if keycode == 1073742050 { return "lalt" }    // SDLK_LALT
    if keycode == 1073742054 { return "ralt" }    // SDLK_RALT

    // Arrow keys
    if keycode == 1073741906 { return "up" }      // SDLK_UP
    if keycode == 1073741905 { return "down" }    // SDLK_DOWN
    if keycode == 1073741904 { return "left" }    // SDLK_LEFT
    if keycode == 1073741903 { return "right" }   // SDLK_RIGHT

    // Function keys F1..F12
    if keycode >= SDLK_F1 && keycode <= SDLK_F12 {
        let f_num = keycode - SDLK_F1 + 1
        return "f{f_num}"
    }

    // Printable ASCII punctuation/symbols (!"#$%&'()*+,-./:;<=>?@[\]^_`{|}~).
    // Map each SDL keycode (which matches ASCII for these) to its single-char
    // string so search / text input can accept punctuation without us
    // enumerating every symbol explicitly.
    if keycode >= 33 && keycode <= 126 {
        return ascii_char(keycode)
    }

    // Fallback: return string representation of keycode
    return "{keycode}"
}

pub fn ascii_char(code: int) -> string { return string_char(code) }

// Sim mouse position override - when set, mouse_screen() returns this
// instead of the actual SDL mouse position
pub global sim_mouse_override: Vec2? = null

pub @intrinsic fn mouse_screen() -> Vec2 {
    if sim_mouse_override != null {
        return sim_mouse_override.unwrap()
    }
    return Vec2 {
        x: get_mouse_x(),
        y: get_mouse_y()
    }
}

pub fn mouse_world() -> Vec2 {
    return screen_to_world(mouse_screen())
}

// Window size in pixels, cached once per frame. screen_size() is a
// getter over this; refresh_window_size() repopulates it from the
// window each frame (run_one_frame, after event poll) and once at
// startup (stone_run_game). Avoids the per-call stone_get_window_size
// FFI that every UI draw op would otherwise trigger via
// ui_to_screen -> screen_size (~100-200 FFI crossings/frame).
pub global WINDOW_SIZE: Vec2 = v(0, 0)
// The same window in physical pixels. Scene rasters allocate against this;
// logical units stay the authoring space for output and UI.
pub global DRAWABLE_SIZE: IVec2 = iv(0, 0)

fn refresh_window_size() {
    WINDOW_SIZE = v(get_screen_width(), get_screen_height())
    let (dw, dh) = stone_get_drawable_size()
    DRAWABLE_SIZE = iv(dw, dh)
    // Text rides the same auto-fit factor as the UI boxes, or a design-space
    // game gets boxes that scale and text that doesn't -- which reads as
    // "the text is too big" on whichever screen is furthest from the design
    // canvas. Engine state, not a per-game one-liner: it is derived from
    // ui_effective_scale, which the engine owns. Games without a design
    // resolution get UI_SCALE, i.e. 1.0, exactly as before.
    FONT_RENDER_SCALE = ui_effective_scale()
}

pub fn screen_size() -> Vec2 {
    return WINDOW_SIZE
}

pub fn drawable_size() -> IVec2 {
    return DRAWABLE_SIZE
}

pub inline(lua) fn pcall_dofile(path: string) -> (bool, string?) = """
    local ok, err = xpcall(dofile, debug.traceback, path)
    if not ok then
        if _G.__rock_code_slot_abort then __rock_code_slot_abort() end
        __rock_log(0, "STONE", "Error loading file: " .. path .. " ... error: " .. tostring(err))
        return false, err
    end
    return true, null
"""

// Parse a chunk WITHOUT running it, stashing the compiled function for
// run_loaded_chunk. `dofile` fuses parse and execute, which forces a caller
// to take destructive action (clearing the system registries) before it can
// learn the file is unreadable; splitting them lets the caller validate
// first. A pushed chunk arrives without passing the compiler's success gate
// -- a truncated transfer is a parse error.
inline(lua) fn load_chunk(path: string) -> (bool, string?) = """
    local f, err = loadfile(path)
    if not f then
        _G.__ROCK_PENDING_CHUNK = nil
        if _G.__rock_code_slot_abort then __rock_code_slot_abort() end
        __rock_log(0, "STONE", "Failed to parse " .. path .. " ... error: " .. tostring(err))
        return false, tostring(err)
    end
    _G.__ROCK_PENDING_CHUNK = f
    return true, null
"""

// Run the chunk stashed by load_chunk, clearing the stash first so a failure
// can't leave a stale chunk for a later call to run by accident.
inline(lua) fn run_loaded_chunk(path: string) -> (bool, string?) = """
    local f = _G.__ROCK_PENDING_CHUNK
    _G.__ROCK_PENDING_CHUNK = nil
    if not f then
        if _G.__rock_code_slot_abort then __rock_code_slot_abort() end
        local err = "run_loaded_chunk(" .. path .. ") with no chunk loaded"
        __rock_log(0, "STONE", err)
        return false, err
    end
    local ok, err = xpcall(f, debug.traceback)
    if not ok then
        if _G.__rock_code_slot_abort then __rock_code_slot_abort() end
        __rock_log(0, "STONE", "Error executing " .. path .. " ... error: " .. tostring(err))
        return false, err
    end
    return true, null
"""

// Global variable helpers for hot reload
inline(lua) fn set_global_bool(name: string, value: bool) = """
    _G[name] = value
"""

inline(lua) fn get_global_bool(name: string) -> bool = """
    return _G[name] or false
"""

inline(lua) fn set_global_float(name: string, value: float) = """
    _G[name] = value
"""

inline(lua) fn get_global_float(name: string) -> float = """
    return _G[name] or 0.0
"""

inline(lua) fn set_global_any(name: string, value: any) = """
    _G[name] = value
"""

inline(lua) fn get_global_any(name: string) -> any = """
    return _G[name]
"""

inline(lua) fn get_stone_handle() -> any = """
    return _G.stone
"""

inline(lua) fn restore_stone_handle(handle: any) = """
    _G.stone = handle
"""

inline(lua) fn gl_push_debug_group(msg: string) = ""
inline(lua) fn gl_pop_debug_group() = ""

// TODO: not available on MacOS, do we have this implemented elsewhere?
pub fn with_debug_group(msg: string, f: fn() -> ()) {
    gl_push_debug_group(msg)
    f()
    gl_pop_debug_group()
}

// The live hover query, called ONCE per frame from `input_imgui_new_frame`
// right after ImGui's NewFrame. `is_imgui_using_mouse` below reads what this
// stored.
//
// It reads `imgui.C`, the raw cimgui namespace, rather than the `imgui.*`
// wrappers: every wrapper in `stone/prebuilt/cimgui/wrap.lua` opens with
// `jit.off(true)`, so a LuaJIT trace that reaches one is blacklisted and
// thrown away -- and `input_mouse_captured` sits on the per-frame mouse path
// that `is_mouse_down` and the action layer poll. Same C functions the
// wrappers call, same answers, no `jit.off`.
//
// `IsWindowHovered(AnyWindow)` is fixed for the frame at NewFrame.
// `IsAnyItemHovered` reads HoveredId || HoveredIdPreviousFrame, so a sample
// taken here reflects the PREVIOUS frame's item hover -- which is exactly what
// a live call made anywhere between two NewFrames already returned, so no
// consumer's answer moves.
//
@nomangle inline(lua) fn __imgui_sample_mouse_hover() = """
    local hovered = false
    if _G.imgui and imgui.C then
        hovered = (imgui.C.igIsWindowHovered(imgui.ImGuiHoveredFlags_AnyWindow)
            or imgui.C.igIsAnyItemHovered()) and true or false
    end
    _G.__stone_imgui_mouse_hover = hovered
"""

// Is the mouse currently owned by an overlay rather than the game? Reads the
// once-per-frame sample above.
inline(lua) fn is_imgui_using_mouse() -> bool = """
    return _G.__stone_imgui_mouse_hover or false
"""

// Get the path of the currently running script
inline(lua) fn get_script_path() -> string = """
    local info = debug.getinfo(1, "S")
    local src = info.source
    -- Lua chunk markers: "@file" => file load, "=text" => verbatim. A bare
    -- name (mlua's #[track_caller] chunk name in fire/embedded builds) has
    -- no marker; stripping a char unconditionally would eat a real one.
    local marker = src:sub(1, 1)
    if marker == "@" or marker == "=" then return src:sub(2) end
    return src
"""

// ============================================================================
// Event Polling and Input State Management
// ============================================================================

// Poll all pending Stone events and update input state
// Returns whether the application should continue running
fn stone_poll_all_events() -> bool {
    // A programmatic stone_quit() (e.g. the pause-menu "Quit", or a batch/bake
    // run signalling it is done from a draw system) sets a deferred flag rather
    // than emitting an SDL Quit event -- report not-running off it so the loop
    // ends after the current frame, then the loop-exit path tears down once.
    if stone_quit_requested() { return false }
    if !stone_is_initialized() { return false }
    let running = true
    let event = stone_event_new()

    while stone_poll_event(event) {
        let event_type = get_stone_event_type(event)
        if event_type == STONE_EVENT_QUIT {
            running = false
        } else if !SIM_INPUT_SYNTHETIC_ONLY {
            // Quit is still honoured above; only INPUT injection is dropped, so
            // a sim's key and mouse state is exactly what the sim injected.
            if event_type == STONE_EVENT_PAD_DEVICE_REMOVED {
                input_physical_pad_device_removed(get_stone_event_pad_instance(event))
            } else if event_type == STONE_EVENT_PAD_ACTIVE_CHANGED {
                input_physical_pad_active_changed(get_stone_event_pad_instance(event))
            } else if event_type == STONE_EVENT_PAD_BUTTONDOWN {
                input_physical_pad_pressed(
                    get_stone_event_pad_instance(event),
                    get_stone_event_pad_button(event),
                    get_stone_event_pad_sync(event),
                )
            } else if event_type == STONE_EVENT_PAD_BUTTONUP {
                input_physical_pad_released(
                    get_stone_event_pad_instance(event),
                    get_stone_event_pad_button(event),
                )
            } else if event_type == STONE_EVENT_PAD_AXISMOTION {
                input_physical_pad_axis(
                    get_stone_event_pad_instance(event),
                    get_stone_event_pad_axis(event),
                    get_stone_event_pad_value(event),
                    get_stone_event_pad_sync(event),
                )
            } else if event_type == STONE_EVENT_KEYDOWN {
                let keycode = get_stone_event_key(event)
                let key_string = sdl_keycode_to_string(keycode)
                let scancode = stone_scancode_token_for(get_stone_event_scancode(event))
                input_physical_key_pressed(
                    key_string,
                    scancode,
                    get_stone_event_modifiers(event),
                    get_stone_event_repeat(event),
                )
            } else if event_type == STONE_EVENT_TEXTINPUT {
                input_physical_text(get_stone_event_text(event))
            } else {
                if event_type == STONE_EVENT_KEYUP {
                    let keycode = get_stone_event_key(event)
                    let key_string = sdl_keycode_to_string(keycode)
                    let scancode = stone_scancode_token_for(get_stone_event_scancode(event))
                    input_physical_key_released(key_string, scancode)
                } else {
                    if event_type == STONE_EVENT_MOUSEBUTTONDOWN {
                        let button = get_stone_event_mouse_button(event)
                        let x = get_stone_event_mouse_x(event)
                        let y = get_stone_event_mouse_y(event)
                        input_physical_mouse_pressed(float(x), float(y), button)
                    } else {
                        if event_type == STONE_EVENT_MOUSEBUTTONUP {
                            let button = get_stone_event_mouse_button(event)
                            let x = get_stone_event_mouse_x(event)
                            let y = get_stone_event_mouse_y(event)
                            input_physical_mouse_released(float(x), float(y), button)
                        } else {
                            if event_type == STONE_EVENT_MOUSEWHEEL {
                                mouse_wheel_delta += get_stone_event_mouse_y(event)
                            }
                        }
                    }
                }
            }
        }
    }

    running
}
