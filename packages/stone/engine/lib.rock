extern(ffi, "stone") fn stone_get_mouse_position(x: Ptr<int>, y: Ptr<int>)
extern(ffi, "stone") fn stone_get_global_mouse_position(x: Ptr<int>, y: Ptr<int>)

// ============================================================================
// Persistent FFI scratch buffers
// ============================================================================
// Reused NativeBuffers so FFI boundary calls don't `ffi.new` per call:
// FFI_*_OUT are 4 fixed size-1 slots per type, for scalar OUT-params (C
// writes, Rock reads). Multiple distinct slots because one call can need
// several at once (window borders = 4).
//
// Safety property: a slot is handed to ONE synchronous C call (pure Rust,
// never re-enters Lua / yields), then read -- never held across another call
// or coroutine yield. Pointer arguments stay JIT-able; struct-by-value returns
// do not, so compound results use out-pointers.

// Scalar out-param slots. Max simultaneous: 4 (window borders / image pixel).
global FFI_INT_OUT_1: NativeBuffer<int> = native_buffer_int(1)
global FFI_INT_OUT_2: NativeBuffer<int> = native_buffer_int(1)
global FFI_INT_OUT_3: NativeBuffer<int> = native_buffer_int(1)
global FFI_INT_OUT_4: NativeBuffer<int> = native_buffer_int(1)
global FFI_FLOAT_OUT_1: NativeBuffer<float> = native_buffer_float(1)
global FFI_FLOAT_OUT_2: NativeBuffer<float> = native_buffer_float(1)
global FFI_FLOAT_OUT_3: NativeBuffer<float> = native_buffer_float(1)
global FFI_FLOAT_OUT_4: NativeBuffer<float> = native_buffer_float(1)

// Rock wrappers returning a proper IVec2 struct (0-arg overloads).
// Previously returned bare `{ x=, y= }` tables — missing __ty / metatable.
pub fn stone_get_mouse_position() -> IVec2 {
    stone_get_mouse_position(FFI_INT_OUT_1.ptr, FFI_INT_OUT_2.ptr)
    return IVec2 { x: FFI_INT_OUT_1.ptr.read(), y: FFI_INT_OUT_2.ptr.read() }
}

pub fn stone_get_global_mouse_position() -> IVec2 {
    stone_get_global_mouse_position(FFI_INT_OUT_1.ptr, FFI_INT_OUT_2.ptr)
    return IVec2 { x: FFI_INT_OUT_1.ptr.read(), y: FFI_INT_OUT_2.ptr.read() }
}

