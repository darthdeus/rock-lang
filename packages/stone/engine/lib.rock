// Stone library - OpenGL + ImGui wrapper

// 0.0 until the runner writes the frame delta -- so a body reached during an
// eager `start()` prime (which runs before the first frame) reads dt as 0, not
// nil. Matches "the prime is poll(t, 0)": the prime never advances time.
pub global dt: float = 0.0
pub global time: float = 0

// Game-time multiplier on the frame delta (0.25 = quarter speed). Every
// dt-driven system slows uniformly, and `time` accumulates the scaled dt, so
// `sin(time * k)` animation slows with it. Replay is exempt -- the log carries
// the already-scaled dt, so a recording plays back at the speed it was made.
// Controls + hotkeys: time_scale_step / set_time_scale (timeline.rock).
pub global TIME_SCALE: float = get_env_float("STONE_TIME_SCALE", 1.0)

// Monotonic host-frame counter, bumped once per frame in the runner before any
// @update system runs, including frozen (paused) frames. Advances in every mode
// (game, sim, `rock frame`) since all route through the runner. Game-tick
// consumers use the host task clock.
pub global frame_seq: int = 0

// Debug Keys (Only work when editor is disabled)
const KEY_DEBUG_ENTITY_ID: string = "m"
const KEY_DEBUG_PROFILER: ToolKey = ToolKey::F8
// Game-speed ladder (TIME_SCALE): slower / faster / back to real time.
const KEY_DEBUG_TIME_SLOWER: ToolKey = ToolKey::LeftBracket
const KEY_DEBUG_TIME_FASTER: ToolKey = ToolKey::RightBracket
const KEY_DEBUG_TIME_RESET: ToolKey = ToolKey::Backslash
const KEY_DEBUG_SCREENSHOT: ToolKey = ToolKey::F12
// Toggle per-FPS-window JIT trace/abort delta logging. LuaJIT-only; no-op
// elsewhere. Lazy-installs a `jit.attach` callback on first enable.
pub global KEY_DEBUG_JIT_TRACE: string = "f2"
// Runtime `jit.off()` / `jit.on()` toggle (flushes traces on disable). Use
// to A/B-test whether the JIT itself is responsible for an FPS regression —
// if perf jumps when this is pressed, the cause is JIT trace thrash.
pub global KEY_DEBUG_JIT_TOGGLE: string = "f3"

// Modifier Keys
pub const KEY_CTRL_LEFT: string = "lctrl"
pub const KEY_CTRL_RIGHT: string = "rctrl"
pub const KEY_SHIFT_LEFT: string = "lshift"
pub const KEY_SHIFT_RIGHT: string = "rshift"


// Per-frame engine settings - can be changed at any time during gameplay
pub struct EngineState {
    // World material/lighting and scene post-processing use linear RGB. UI is a separate display-space composite.
    linear_world: bool = false,
    // An id in visible_id_canvas that never hides an outlined target (ground
    // cover drawn over feet); 0 = none.
    outline_see_through_id: int = 0,
    use_bloom: bool,
    screenshot_capture_imgui: bool,
    screenshot_max_size: int,
    debug_text_size: bool,
    debug_draw_entity_id: bool,
    debug_outline_classify: bool,
    debug_graphics_stats: bool,
    profiler_enabled: bool,
    // Frame-rate readout. Off by default: a game opts in, because it is dev
    // furniture and lands in screenshots.
    show_fps: bool,
    fps_overlay_origin: Vec2,
    systems_profiling_enabled: bool,
    show_pipeline_inspector: bool,
    show_sfx_browser: bool,
    exposure: float,
    // Per-pixel exposure for this frame: where this canvas's red reads 1 the
    // tonemap applies `exposure_weighted` instead of `exposure`, mixing in
    // stops between. The game sets it every frame it wants the split; null
    // tonemaps with `exposure` alone.
    exposure_weight: Canvas? = null,
    exposure_weighted: float = 1.0,
    // Min max-channel brightness for the bloom extract. 1.0 = only
    // HDR-overbright pixels bloom (additive VFX, strong lights);
    // scene albedo stays clean.
    bloom_threshold: float,
    // Soft-knee halfwidth for the bloom extract. Bloom ramps in across
    // [threshold - knee, threshold + knee] instead of switching on at
    // threshold; 0 restores the hard cut.
    bloom_knee: float,
    // Scales the whole bloom contribution at composite.
    bloom_intensity: float,
    // Per-rung weight on the pyramid's upsample, so level k lands at
    // scatter^k: 1.0 weights every octave equally (widest halo), lower
    // values attenuate the coarse levels and pull it tight.
    bloom_scatter: float,
    texel_bleed_prevention: float,
}

pub global ENGINE: EngineState = EngineState {
    use_bloom: false,
    screenshot_capture_imgui: true,
    screenshot_max_size: 1920,
    debug_text_size: false,
    debug_draw_entity_id: false,
    debug_outline_classify: false,
    debug_graphics_stats: false,
    profiler_enabled: false,
    show_fps: false,
    fps_overlay_origin: FPS_TEXT_ORIGIN,
    systems_profiling_enabled: true,
    show_pipeline_inspector: false,
    show_sfx_browser: false,
    exposure: 1.0,
    bloom_threshold: 1.0,
    bloom_knee: 0.5,
    bloom_intensity: 1.0,
    bloom_scatter: 1.0,
    texel_bleed_prevention: 0.5,
}

pub struct WorldModeState {
    editor_mode_enabled: bool,
    game_paused: bool,
    // Menu screens freeze the world without being pause, so a pause
    // overlay keyed on game_paused stays closed.
    menu_active: bool,
}

pub global WORLD_MODE: WorldModeState = WorldModeState {
    editor_mode_enabled: false,
    game_paused: false,
    menu_active: false,
}

// Initialization state tracking
global STONE_INITIALIZED: bool = false
global STONE_FONT_LOADED: bool = false
pub global STONE_INIT_VERIFIED: bool = false

pub fn debug_keys_enabled() -> bool {
    return !WORLD_MODE.editor_mode_enabled
}

pub fn world_frozen() -> bool {
    return WORLD_MODE.editor_mode_enabled || WORLD_MODE.game_paused || WORLD_MODE.menu_active
}

fn stone_init_done() {
    if !STONE_INITIALIZED {
        log_error("STONE", "stone_init_done(): Stone not initialized")
        stone_quit()
    }

    if !STONE_FONT_LOADED {
        log_error("STONE", "stone_init_done(): Font not loaded")
        stone_quit()
    }

    STONE_INIT_VERIFIED = true
}

fn mark_stone_initialized() { STONE_INITIALIZED = true }

pub @inline inline(lua) fn stone_sdl_video_driver_name() -> string = "return ffi.string(stone.stone_sdl_video_driver())"
pub @inline inline(lua) fn stone_gl_swap_count() -> int = "return tonumber(stone.stone_gl_swap_count())"

// ============================================================================
// Frame Management
// ============================================================================

fn stone_begin_frame() {
    if !STONE_INIT_VERIFIED {
        log_error("STONE", "stone_begin_frame(): stone_init_done() not called")
        stone_quit()
    }
    stone_begin_image_upload_frame()
    // Preserve timeline uploads before the sole graphics-counter reset.
    // Upload quota admission above has its own, distinct frame boundary.
    perf_phase_frame_reset()
    stone_reset_frame_stats()
}

fn stone_end_frame() {
    // Preserve the completed frame's counters for update-stage readers.
    record_frame_stats()
}

// ============================================================================
// Stone FFI Bindings
// ============================================================================

const STONE_EVENT_NONE: int = 0
const STONE_EVENT_QUIT: int = 1
const STONE_EVENT_KEYDOWN: int = 2
const STONE_EVENT_KEYUP: int = 3
const STONE_EVENT_MOUSEBUTTONDOWN: int = 4
const STONE_EVENT_MOUSEBUTTONUP: int = 5
const STONE_EVENT_MOUSEWHEEL: int = 6
const STONE_EVENT_PAD_DEVICE_ADDED: int = 7
const STONE_EVENT_PAD_DEVICE_REMOVED: int = 8
const STONE_EVENT_PAD_ACTIVE_CHANGED: int = 9
const STONE_EVENT_PAD_BUTTONDOWN: int = 10
const STONE_EVENT_PAD_BUTTONUP: int = 11
const STONE_EVENT_PAD_AXISMOTION: int = 12
const STONE_EVENT_TEXTINPUT: int = 13

pub const STONE_MOD_CTRL: int = 1
pub const STONE_MOD_SHIFT: int = 2
pub const STONE_MOD_ALT: int = 4
pub const STONE_MOD_GUI: int = 8

global STONE_KEY_ESCAPE: int = 27
global STONE_KEY_SPACE: int = 32

// SDL window position constants
global SDL_WINDOWPOS_UNDEFINED: int = 0x1FFF0000
const SDL_WINDOWPOS_CENTERED: int = 0x2FFF0000

// SDL keycodes for non-ASCII keys are SDL_SCANCODE_FOO | SDLK_SCANCODE_MASK
// where SDLK_SCANCODE_MASK = (1 << 30) = 0x40000000.
// F1..F12 are contiguous: SDL_SCANCODE_F1=0x3A ... SDL_SCANCODE_F12=0x45.
const SDLK_F1: int = 0x4000003A
const SDLK_F12: int = 0x40000045

// The unit-test host calls this stable name without booting the frame runner.
pub @nomangle @allow(long_inline_lua, "ffi.cdef SDL/Stone C type block") inline(lua) fn setup_stone() = """
    -- Only define FFI types once to support hot reload
    if not _G._stone_ffi_defined then
        _G._stone_ffi_defined = true
        ffi.cdef[[
        // Opt-in UI trace ABI. Payload pointers are copied before returning.
        void stone_ui_probe_begin(uint8_t windowless);
        void stone_ui_probe_stop(void);
        void stone_ui_probe_context(const char *phase, const char *pass, const char *surface, const char *space);
        int stone_ui_probe_accept(const char *kind, const char *key, const char *detail);
        uint8_t stone_ui_probe_expect_vertices(int id, const void *vertices, int count, int stride);
        void stone_ui_probe_end_operation(void);
        void stone_ui_probe_custom_consumed(void);
        uint8_t stone_ui_probe_observe(const char *kind, const char *detail);
        uint8_t stone_ui_probe_resource(const char *kind, uint64_t handle, const char *source, int generation);
        uint8_t stone_ui_probe_check(int expected);
        int stone_ui_probe_accepted(void);
        uint8_t stone_ui_probe_refuse(const char *kind, const char *detail);
        uint8_t stone_ui_probe_check_population(int accepted, int refused, int observed);
        uint8_t stone_ui_probe_retire(const char *kind, uint64_t handle);
        int stone_ui_probe_consumed(void);
        int stone_ui_probe_z(int index);
        double stone_ui_probe_vertex(int index, int lane);
        uint8_t stone_ui_probe_write(const char *path);

        typedef struct StoneWindow StoneWindow;
        typedef struct StoneGLContext StoneGLContext;
        typedef enum {
            STONE_EVENT_NONE = 0,
            STONE_EVENT_QUIT,
            STONE_EVENT_KEYDOWN,
            STONE_EVENT_KEYUP,
            STONE_EVENT_MOUSEBUTTONDOWN,
            STONE_EVENT_MOUSEBUTTONUP,
            STONE_EVENT_MOUSEWHEEL,
            STONE_EVENT_PAD_DEVICE_ADDED,
            STONE_EVENT_PAD_DEVICE_REMOVED,
            STONE_EVENT_PAD_ACTIVE_CHANGED,
            STONE_EVENT_PAD_BUTTONDOWN,
            STONE_EVENT_PAD_BUTTONUP,
            STONE_EVENT_PAD_AXISMOTION,
            STONE_EVENT_TEXTINPUT,
        } StoneEventType;

        typedef enum {
            STONE_KEY_ESCAPE = 27,
            STONE_KEY_SPACE = 32,
        } StoneKeyCode;

        typedef struct {
            StoneEventType type;
            StoneKeyCode key;
            int scancode;
            int modifiers;
            bool repeat;
            int mouse_button;
            int mouse_x;
            int mouse_y;
            int pad_instance_id;
            const char* pad_button;
            const char* pad_axis;
            int pad_value;
            bool pad_sync;
            char text[32];
        } StoneEvent;

        uint8_t stone_init(void);
        void stone_quit(void);
        void stone_hide_window(void);
        void stone_show_window(void);
        void stone_show_window_mode(int mode);
        uint8_t stone_is_window_hidden(void);
        uint8_t stone_quit_requested(void);
        uint8_t stone_teardown(void);
        uint8_t stone_is_initialized(void);
        int stone_test_virtual_pad_attach(void);
        uint8_t stone_test_virtual_pad_button(int index, const char* token, bool down);
        uint8_t stone_test_virtual_pad_axis(int index, const char* token, int value);
        uint8_t stone_test_virtual_pad_detach(int index);
        void stone_test_virtual_pad_cleanup(void);
        uint8_t stone_test_push_key_event(const char* token, bool down);
        uint8_t stone_pad_connected(void);
        const char* stone_pad_type_name(void);
        StoneWindow* stone_create_window_ex(const char* title, int x, int y, int width, int height, int display, bool resizable, int fullscreen);
        StoneWindow* stone_gpu_host_acquire(void);
        const char* stone_sdl_video_driver(void);
        unsigned long long stone_gl_swap_count(void);
        uint8_t stone_poll_event(StoneEvent* event);
        void stone_start_text_input(void);
        void stone_stop_text_input(void);

        int stone_scancode_count(void);
