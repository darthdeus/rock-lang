// ============================================================================
// Mesh Rendering - High Level API
// ============================================================================

// One fullscreen rectangle at the corner UV mapping the submission resolved.
// The mapping is the semantics; each backend picks its own vertex order,
// diagonal and winding, and culling is off by contract.
extern(ffi, "stone") fn stone_draw_fullscreen_rect(u0: float, v0: float, u1: float, v1: float)

// Direct Rock-level extern for the flat-array mesh path. Takes a typed
// Ptr<float> (no longer `any`) so callers can't accidentally hand it the
// wrong cdata variant. Pair with NativeBuffer<float>.ptr; see
// stone/engine/rendering/rect_batch.rock for a working caller.
extern(ffi, "stone") fn stone_draw_mesh(
    vertex_data: Ptr<float>,
    vertex_count: int,
    vertex_stride: int,
    attr_sizes: Ptr<int>,
    attr_count: int,
    texture_kind: int,
    texture: int,
) -> int

// Retained mesh objects (instancing optional) -- see the cdef block for
// the location/divisor contract. attr_sizes pairs with NativeBuffer<int>.ptr.
extern(ffi, "stone") fn stone_mesh_create(
    mode: int,
    verts: Ptr<float>,
    vert_count: int,
    stride_floats: int,
    attr_sizes: Ptr<int>,
    attr_count: int,
) -> int
extern(ffi, "stone") fn stone_mesh_set_instances(
    handle: int,
    data: Ptr<float>,
    count: int,
    stride_floats: int,
    attr_sizes: Ptr<int>,
    attr_count: int,
)
extern(ffi, "stone") fn stone_mesh_draw(handle: int, texture: int, count: int) -> int
extern(ffi, "stone") fn stone_mesh_free(handle: int)
// -2 unknown handle, -1 no instance buffer, otherwise the instance count.
pub extern(ffi, "stone") fn stone_mesh_instance_count(handle: int) -> int
// Asset-report census over retained meshes: population, one handle per index
// in id order, and the uploaded bytes a handle holds (0 when unknown).
pub extern(ffi, "stone") fn stone_get_live_mesh_count() -> int
pub extern(ffi, "stone") fn stone_get_live_mesh_handle(index: int) -> int
pub extern(ffi, "stone") fn stone_mesh_bytes(handle: int) -> int


// ============================================================================
// Asset Loading - Images
// ============================================================================

// Texture filter modes for stone_load_image / stone_new_image_from_data.
// NEAREST is the default — every Stone game so far is pixel art and wants
// crisp pixel boundaries. LINEAR exists for prerendered HD atlases (eg
// Blender renders) where source detail is meant to be filtered down
// smoothly; opt in per load site. Mirrors the matches in
// stone-rs/src/lib.rs and stone-rs/src/image_data.rs.
const IMAGE_FILTER_NEAREST: int = 0
const IMAGE_FILTER_LINEAR: int = 1
// Conservative trilinear sampling of generated mip levels for minified art.
const IMAGE_FILTER_MIP_STABLE: int = 2

// `stone_load_image` flags. EXACT_TEXELS: the file's texels are read
// individually rather than sampled as colour -- a lookup table, an index
// structure, a packed mesh. It withholds `STONE_IMAGE_MAX_SIDE` from this
// image, because averaging such a texel does not blur a value, it invents a
// different one. DEFERRED: the flush does not wait for this decode; a budgeted
// pump publishes it, or `stone_image_require` makes the next flush wait.
// DEPTH_RG8: store the source R/G depth bytes in sized GL_RG8 storage.
const IMAGE_LOAD_EXACT_TEXELS: int = 1
const IMAGE_LOAD_DEFERRED: int = 2
const IMAGE_LOAD_DEPTH_RG8: int = 4
const IMAGE_LOAD_MATERIAL_RG8: int = 8

// Positive manifest dimensions let Deferred loads read entirely on the worker.
// Zero/zero retains header admission. Worker decode must match the manifest.
pub extern(ffi, "stone") fn stone_load_image(path: string, filter_mode: int, flags: int, width: int, height: int) -> int

pub extern(ffi, "stone") fn stone_get_white_image() -> int

// Raw C boundary: takes two `int*` out-params, filled in-place.
extern(ffi, "stone") fn stone_get_image_size(handle: int, width: Ptr<int>, height: Ptr<int>)

// What GL actually holds, which `STONE_IMAGE_MAX_SIDE` may have reduced below
// the logical size above. A DIAGNOSTIC for fixtures; no draw may branch on it.
extern(ffi, "stone") fn stone_image_storage_size(handle: int, width: Ptr<int>, height: Ptr<int>)

extern(ffi, "stone") fn stone_image_is_stub(handle: int) -> bool

pub extern(ffi, "stone") fn stone_get_live_image_handle(index: int) -> int

// Honest GL bytes for one live image, including its mip chain when present.
// The image census reads this per classified handle; multiplying
// stone_get_image_size by 4 overcounts R8 font aliases. The broad live total
// also includes canvas attachments.
pub extern(ffi, "stone") fn stone_get_image_byte_len(handle: int) -> int
pub extern(ffi, "stone") fn stone_get_image_format(handle: int) -> int

// Rock-level helper returning a tuple. Dispatched by arg count: this
// overload (1 arg) coexists with the extern above (3 args).

pub fn stone_get_image_size(handle: int) -> (int, int) {
    stone_get_image_size(handle, FFI_INT_OUT_1.ptr, FFI_INT_OUT_2.ptr)
    return (FFI_INT_OUT_1.ptr.read(), FFI_INT_OUT_2.ptr.read())
}

fn stone_image_storage_size(handle: int) -> (int, int) {
    stone_image_storage_size(handle, FFI_INT_OUT_1.ptr, FFI_INT_OUT_2.ptr)
    return (FFI_INT_OUT_1.ptr.read(), FFI_INT_OUT_2.ptr.read())
}

// The header size an asset would load at, without decoding or allocating;
// null when the asset is missing or its header is unreadable.
extern(ffi, "stone") fn stone_probe_image_size(path: string, width: Ptr<int>, height: Ptr<int>) -> bool

pub fn stone_probe_image_size(path: string) -> IVec2? {
    if !stone_probe_image_size(path, FFI_INT_OUT_1.ptr, FFI_INT_OUT_2.ptr) { return null }
    return IVec2 { x: FFI_INT_OUT_1.ptr.read(), y: FFI_INT_OUT_2.ptr.read() }
}

pub extern(ffi, "stone") fn stone_get_image_texture(handle: int) -> int

pub extern(ffi, "stone") fn stone_image_set_wrap(handle: int, repeat: bool) -> bool


// Distinct suppression records the RUST logger holds (log_once! sites plus
// their subject-keyed half). The oracle for the boundary's `log_dedup` row.
// The asset watcher's three stores as `registered,changed,dirs`. The
// `asset_watcher` ambient row's own denominator.
@inline inline(lua) fn stone_asset_watcher_state_ptr() -> any = "stone.stone_asset_watcher_state()"

pub fn stone_asset_watcher_state() -> string? {
    let p = stone_asset_watcher_state_ptr()
    if __stone_ptr_is_null(p) { return null }
    return ffi_string(p, null)
}

// Queue a change for a REGISTERED asset exactly as the debouncer's background
// thread would, without touching the filesystem. A probe: false when the path
// is not registered, so a fixture cannot queue something `poll` would drop.
pub extern(ffi, "stone") fn stone_asset_watcher_inject_change(path: string) -> bool

pub extern(ffi, "stone") fn stone_log_dedup_count() -> int

// Every record at `level` (0 error, 1 warn) this process emitted, Rust and
// Rock alike. Other levels keep no records and read as zero.
pub extern(ffi, "stone") fn stone_log_record_total(level: int) -> int

// The most recently seen distinct records at `level` as
// `count<TAB>target<TAB>message` lines, then `evicted<TAB>N` when the bounded
// table dropped rows.
@inline inline(lua) fn stone_log_records_text_ptr(level: int, max_rows: int) -> any = "stone.stone_log_records_text(level, max_rows)"

pub fn stone_log_records_text(level: int, max_rows: int) -> string {
    return ffi_string(stone_log_records_text_ptr(level, max_rows), null)
}

// One texel of an image's texture as 0xRRGGBBAA, or -1 for an unknown handle
// or an out-of-range coordinate. A PROBE: it reads through glGetTexImage,
// which GLES does not have, and nothing in the engine calls it.
pub extern(ffi, "stone") fn stone_image_read_texel(handle: int, x: int, y: int) -> int

// The CPU mirror's wrap mode: 1 repeat, 0 clamp, -1 no such handle.
pub extern(ffi, "stone") fn stone_image_wrap_state(handle: int) -> int

// The wrap mode GL itself holds, as the second independent view: 1 repeat, 0
// clamp, -1 unknown handle or the two axes disagree.
pub extern(ffi, "stone") fn stone_image_gl_wrap_state(handle: int) -> int

// Bind the immutable sampler for `mode` on texture `unit`; mode < 0 releases
// that unit. `image` picks the matching wrap -- a sampler overrides the
// texture's own -- and is 0 for a canvas, which is always clamped.
pub extern(ffi, "stone") fn stone_bind_sampler(unit: int, mode: int, image: int)

pub extern(ffi, "stone") fn stone_sampler_bound(unit: int) -> bool

// Every unit that can carry sampler state, which is the denominator for a leak
// scan: a compiler slot count covers only the units a `@textures` group owns.
pub extern(ffi, "stone") fn stone_max_texture_units() -> int

pub extern(ffi, "stone") fn stone_unload_image(handle: int)

// Re-decode `path` into the texture already bound to `handle`, keeping the
// same handle. Returns false on unknown handle / decode failure.
pub extern(ffi, "stone") fn stone_reload_image(handle: int, path: string) -> bool

// Publishes Required images, waiting for their background decodes if needed.
// Deferred results stay pending for a pump unless promoted to Required.
// A loaded handle and size do not imply sampleable pixels: publication must
// precede any draw or pixel readback.
pub extern(ffi, "stone") fn stone_flush_image_uploads()
pub extern(ffi, "stone") fn stone_set_frame_image_upload_budget(bytes: int)
// One host frame owns one allowance across all its upload pumps.
pub extern(ffi, "stone") fn stone_begin_image_upload_frame()
pub extern(ffi, "stone") fn stone_image_uploads_pending() -> int
// Promotes a pending Deferred load to Required; false when there is none.
extern(ffi, "stone") fn stone_image_require(handle: int) -> bool
// True when no load for the handle waits to be published (not a liveness test).
extern(ffi, "stone") fn stone_image_ready(handle: int) -> bool
// Decoded RGBA bytes of every load not yet published.
extern(ffi, "stone") fn stone_image_pending_bytes() -> int
// Whether the handle's deferred decode failed to produce pixels.
extern(ffi, "stone") fn stone_image_decode_failed(handle: int) -> bool
// Cumulative failed deferred decodes; residency snapshots the deltas.
pub extern(ffi, "stone") fn stone_image_decode_failed_count() -> int
// The budgeted per-frame pump frame_core_resolve_view runs; returns the
// uploads still pending. Package tests drive it as the frame loop does.
pub extern(ffi, "stone") fn stone_service_image_uploads() -> int

// Asset hot-reload watcher (see stone/engine/debug/watcher.rock for the
// per-frame poll). The watcher lives in stone-rs; reload policy is Rock-side.
pub extern(ffi, "stone") fn stone_watch_asset(path: string)
pub extern(ffi, "stone") fn stone_poll_changed_assets() -> int

@inline inline(lua) fn stone_changed_asset_path_ptr(index: int) -> any = "stone.stone_changed_asset_path(index)"

fn stone_changed_asset_path(index: int) -> string {
    return ffi_string(stone_changed_asset_path_ptr(index), null)
}

