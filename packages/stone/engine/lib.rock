// line (`report_unfilled_blocks` in stone-rs/src/uniform_block.rs).
pub extern(ffi, "stone") fn stone_unfilled_uniform_block_count() -> int
// Live block buffers across every program. The leak oracle: a registration that
// is rejected after already binding a block must leave this where it found it.
