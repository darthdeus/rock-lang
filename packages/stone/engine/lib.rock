extern(ffi, "stone") fn stone_pad_connected() -> bool
@inline inline(lua) fn stone_pad_type_name_ptr() -> any = "stone.stone_pad_type_name()"

fn stone_pad_type_name_raw() -> string {
    let p = stone_pad_type_name_ptr()
    if __stone_ptr_is_null(p) { return "" }
    return ffi_string(p, null)
}

// Opaque handle phantoms. Runtime value is raw LuaJIT cdata for
// StoneWindow* / StoneEvent*; the struct is
// compile-time-only nominal typing so externs can't accidentally
// accept a different handle type.
pub struct StoneWindow { }
pub struct StoneEvent  { }

extern(ffi, "stone") fn stone_create_window(title: string, width: int, height: int) -> StoneWindow
pub extern(ffi, "stone") fn stone_create_window_ex(title: string, x: int, y: int, width: int, height: int, display: int, resizable: bool, fullscreen: int) -> StoneWindow
