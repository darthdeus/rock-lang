pub extern(ffi, "stone") fn stone_create_image_data(width: int, height: int) -> int

extern(ffi, "stone") fn stone_image_data_size(handle: int, width: Ptr<int>, height: Ptr<int>) -> bool

pub fn image_data_size(handle: int) -> (int, int) {
    if !stone_image_data_size(handle, FFI_INT_OUT_1.ptr, FFI_INT_OUT_2.ptr) {
        return (0, 0)
    }
    return (FFI_INT_OUT_1.ptr.read(), FFI_INT_OUT_2.ptr.read())
}

pub extern(ffi, "stone") fn stone_get_image_data_count() -> int

extern(ffi, "stone") fn stone_image_data_clone(src: int) -> int

extern(ffi, "stone") fn stone_image_data_copy_into(dst: int, src: int) -> bool

// Copies a rectangle of `src` into `dst`, each channel scaled by its factor
// (1.0 copies the bytes exactly). False for a bad handle or rectangle.
pub extern(ffi, "stone") fn stone_image_data_blit(dst: int, src: int, sx: int, sy: int, w: int, h: int,
                                                  dx: int, dy: int, r: float, g: float, b: float, a: float) -> bool

pub extern(ffi, "stone") fn stone_destroy_image_data(handle: int)

pub extern(ffi, "stone") fn stone_image_data_set_pixel(handle: int, x: int, y: int, r: float, g: float, b: float, a: float)

// Raw C boundary: four `float*` out-params.
extern(ffi, "stone") fn stone_image_data_get_pixel(handle: int, x: int, y: int, r: Ptr<float>, g: Ptr<float>, b: Ptr<float>, a: Ptr<float>)

// Rock-level tuple-returning helper. 3-arg overload of the extern above.

pub fn stone_image_data_get_pixel(handle: int, x: int, y: int) -> (float, float, float, float) {
    stone_image_data_get_pixel(handle, x, y, FFI_FLOAT_OUT_1.ptr, FFI_FLOAT_OUT_2.ptr, FFI_FLOAT_OUT_3.ptr, FFI_FLOAT_OUT_4.ptr)
    return (FFI_FLOAT_OUT_1.ptr.read(), FFI_FLOAT_OUT_2.ptr.read(), FFI_FLOAT_OUT_3.ptr.read(), FFI_FLOAT_OUT_4.ptr.read())
}

// Bulk pixel upload. Typed PtrU8 — passing a PtrI16 / PtrFloat / etc.
// is a compile error, not a silent mis-marshal. Pair with a
// NativeBufferU8 sized for `width * height * 4`.
pub extern(ffi, "stone") fn stone_image_data_fill_rgba(handle: int, rgba: PtrU8, pixel_count: int)
// Bulk pixel read, the inverse of fill_rgba; false for a dead handle or a
// count beyond the image.
extern(ffi, "stone") fn stone_image_data_read_rgba(handle: int, rgba: PtrU8, pixel_count: int) -> bool

// PNG codec (image crate, Rust-side). 0 = error on load; false = error on save.
pub extern(ffi, "stone") fn stone_image_data_load_png(path: string) -> int
extern(ffi, "stone") fn stone_image_data_load_png_bytes(bytes: PtrU8, len: int) -> int
extern(ffi, "stone") fn stone_clipboard_image_data() -> int
extern(ffi, "stone") fn stone_image_data_save_png(handle: int, path: string) -> bool

// Puts text on the system clipboard; false (logged natively) on failure.
pub extern(ffi, "stone") fn stone_set_clipboard_text(text: string) -> bool

// The engine's host facts, one `key: value` per line: OS and version, CPU,
// GL renderer/vendor/version, video driver, displays and the window's.
pub inline(lua) fn stone_system_report_text() -> string = "return ffi.string(stone.stone_system_report())"

pub fn clipboard_image_data() -> ImageData? {
    let handle = stone_clipboard_image_data()
    if handle == 0 { return null }
    return ImageData(handle)
}

// In-place glTexSubImage2D upload from an ImageData buffer into an
// existing texture. Sizes must match. Used for live brush feedback.
pub extern(ffi, "stone") fn stone_image_update_from_data(image_handle: int, data_handle: int) -> bool

pub extern(ffi, "stone") fn stone_new_image_from_data(data_handle: int, filter_mode: int) -> int

// Default-arg overload — see stone_load_image's overload above.
pub fn stone_new_image_from_data(data_handle: int) -> int {
    return stone_new_image_from_data(data_handle, IMAGE_FILTER_NEAREST)
}

