}

pub fn stone_get_window_borders() -> (int, int, int, int) {
    stone_get_window_borders(FFI_INT_OUT_1.ptr, FFI_INT_OUT_2.ptr, FFI_INT_OUT_3.ptr, FFI_INT_OUT_4.ptr)
    return (FFI_INT_OUT_1.ptr.read(), FFI_INT_OUT_2.ptr.read(), FFI_INT_OUT_3.ptr.read(), FFI_INT_OUT_4.ptr.read())
}

