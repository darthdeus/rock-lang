// ============================================================================
// Graphics Statistics History
// ============================================================================

// History buffer size (number of frames to track)
global STATS_HISTORY_SIZE: int = 300  // 5 seconds at 60fps

// History storage (ring buffers)
global stats_history_draw_calls: [int] = []
global stats_history_text_draws: [int] = []
global stats_history_canvas_switches: [int] = []
global stats_history_shader_switches: [int] = []
global stats_history_index: int = 0
global stats_history_count: int = 0

// End-of-frame snapshot: the live FRAME_STATS counter resets at frame
// start, so update-stage readers (sims) see a mid-frame value; this holds
// the last COMPLETE frame.
pub global LAST_FRAME_GFX: GraphicsStats = GraphicsStats {
    draw_calls: 0, text_draw_calls: 0, canvas_switches: 0,
    shader_switches: 0, stream_upload_calls: 0, stream_storage_replacements: 0,
    stream_upload_bytes: 0,
    streamed_vertices: 0, retained_upload_calls: 0, retained_upload_bytes: 0,
    retained_uploaded_vertices: 0, images: 0, canvases: 0, texture_memory_mib: 0,
    instanced_draws: 0,
}

// Preserve the completed frame for update-stage readers. Detailed history and
// aggregation belong to the profiler; Stone no longer keeps a second rolling
// buffer for the removed Graphics Stats window.
fn record_frame_stats() {
    LAST_FRAME_GFX = stone_get_graphics_stats()
}

// ============================================================================
// Text Rendering API
// ============================================================================

extern(ffi, "stone") fn stone_text_init() -> bool


// ----------------------------------------------------------------------
// Font handle + per-font wrappers
// ----------------------------------------------------------------------
pub enum FontRasterPolicy { Fixed, OutputDensity }

// `FontData` is the Rock-side metadata for a loaded font:
//   - `backend_id`: the 1-based stone-rs font_id that owns the GL atlas
//   - `base_pixel_size`: the logical em requested by the caller
//   - `pixel_size`: the resolved physical atlas em, used for scale math
//   - `cap_height`: the selected face's canonical native cap-height metric
//   - `native_em`: the selected font's authored world-text em, or zero for the
//     per-font atlas em
//
// `Font` wraps an `Entity<FontData>` so the user-facing handle is
// generation-counted via the Arena. A stale Font (one whose font was
// unloaded) returns null from `font.data()` and silently no-ops in
// every draw/measure path. Slots are never reused in stone-rs (backend
// ids are monotonic 1-based), and Arena gives the Rock-side guarantee
// that a removed Entity stays removed.
//
// `DEFAULT_FONT` is set by runner.rock after loading the engine font.
// All existing top-level text wrappers (stone_draw_text,
// stone_measure_text_vec2, etc.) consult DEFAULT_FONT under the hood —
// games keep calling `measure_text(text, font_size)` without thinking
// about font handles. Code that wants a specific font uses the Font
// UFCS methods (font.measure, font.draw, etc.).
pub struct FontData {
    backend_id: int,
    base_pixel_size: int,
    pixel_size: int,
    cap_height: float,
    native_em: int,
    raster: FontRasterPolicy,
    // Resolved asset path, used to match a changed file on hot reload.
    path: string,
    // How this font's atlas is sampled, declared at load and carried into every
    // text batch's key. Nearest keeps a pixel font's texels hard; Linear is for
    // a TTF drawn at sizes other than its atlas rasterization size.
    sampling: TextureFilter,
    // Which synthesized faces were baked. A span asking for anything else
    // rejects; nothing silently substitutes regular.
    faces: TextFaces,
    extra: string,
}

pub struct Font {
    handle: Entity<FontData>,
}

pub global FONT_REGISTRY: Arena<FontData> = arena_new()
pub global DEFAULT_FONT: Font? = null

// Styled text. A span carries its own style; a family resolves that style to a
// concrete face. Every field here affects measurement or emission.
pub nobox value TextStyle {
    color: Color = WHITE,
    bold: bool = false,
    italic: bool = false,
}

pub struct TextSpan {
    text: string,
    style: TextStyle = TextStyle {},
}

// Which synthesized faces a font DECLARES, mirroring stone-rs `FaceSet`. The
// bits are the load-time face mask; bold-italic needs both axes, because half
// a synthesized face is not one.
pub value TextFaces {
    bold: bool = false,
    italic: bool = false,
}

pub const FACE_REGULAR: int = 0
pub const FACE_BOLD: int = 1
const FACE_ITALIC: int = 2
const FACE_BOLD_ITALIC: int = 3

@pure fn face_mask(f: TextFaces) -> int {
    return (if f.bold { 1 } else { 0 }) + (if f.italic { 2 } else { 0 })
}

// Face index for a style, in the order stone-rs `Face::ALL` bakes them.
@pure fn style_face_index(s: TextStyle) -> int {
    if s.bold && s.italic { return FACE_BOLD_ITALIC }
    if s.bold { return FACE_BOLD }
    if s.italic { return FACE_ITALIC }
    return FACE_REGULAR
}

@pure fn face_name(face: int) -> string {
    if face == FACE_BOLD { return "bold" }
    if face == FACE_ITALIC { return "italic" }
    if face == FACE_BOLD_ITALIC { return "bold-italic" }
    return "regular"
}

pub @pure fn faces_declare(f: TextFaces, face: int) -> bool {
    if face == FACE_BOLD { return f.bold }
    if face == FACE_ITALIC { return f.italic }
    if face == FACE_BOLD_ITALIC { return f.bold && f.italic }
    return true
}

// A family is a flat ordered list: primary first, then fallbacks. Each font
// still owns its declared synthesized faces and its own atlas.
pub struct TextFamily {
    regular: Font,
    fallbacks: [Font] = [],
}

// Terse constructor for dynamic call sites. Same representation as the literal
// form, so there is one span type rather than two.
pub fn text_span(
    text: string,
    color: Color = WHITE,
    bold: bool = false,
    italic: bool = false
) -> TextSpan {
    return TextSpan { text: text, style: TextStyle { color: color, bold: bold, italic: italic } }
}

// Without codepoint input, only promise a face all live family fonts declare:
// resolution may select any one of them, and never skips a glyph owner just
// to find a later face.
pub fn declares_face(self: TextFamily, bold: bool = false, italic: bool = false) -> bool {
    let face = style_face_index(TextStyle { bold: bold, italic: italic })
    let primary = self.regular.data() ?? return false
    if !faces_declare(primary.faces, face) { return false }
    for fallback in self.fallbacks {
        let d = fallback.data() ?? return false
        if !faces_declare(d.faces, face) { return false }
    }
    return true
}

// A null family at a public surface is the default font's family. Absence is a
// rejection, not a silent no-op: a rich call has a family to name.
pub fn text_family_or_default(family: TextFamily? = null) -> TextFamily {
    if let f = family { return f }
    let d = DEFAULT_FONT
    if d == null { error("rich text: no family given and no DEFAULT_FONT is loaded") }
    return TextFamily { regular: d.unwrap() }
}

pub fn output_font_density() -> float {
    let logical = screen_size()
    let drawable = drawable_size()
    if logical.x <= 0.0 || logical.y <= 0.0 || drawable.x <= 0 || drawable.y <= 0 {
        return 1.0
    }
    return max((drawable.x as float) / logical.x,
        (drawable.y as float) / logical.y)
}

pub fn output_font_raster_size(base_pixel_size: int) -> int {
    return max(1, int(round((base_pixel_size as float) * output_font_density())))
}

pub fn resolve_font_raster_size(base_pixel_size: int, raster: FontRasterPolicy) -> int {
    match raster {
        FontRasterPolicy::Fixed => return base_pixel_size,
        FontRasterPolicy::OutputDensity => return output_font_raster_size(base_pixel_size),
    }
}

// Resolve a Font to its FontData. Returns null for a stale handle
// (font was unloaded). Callers should `?? return ...` on null.
pub fn data(self: Font) -> FontData? {
    return self.handle.get()
}

@inline inline(lua) fn stone_load_font_ffi(path: string, pixel_size: int, face_mask: int, extra_chars: string) -> int = "stone.stone_load_font(path, pixel_size, face_mask, extra_chars)"
