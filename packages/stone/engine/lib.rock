pub inline(lua) fn stone_file_read(path: string) -> string? = """
    local len = ffi.new("size_t[1]")
    local data = stone.stone_file_read(path, len)
    if data == nil then
        -- FFI boundary: we can't tell missing-vs-permission-denied from C, but
        -- we can at least record the path the caller asked for once per site.
        _log_once_impl(0, "FILE", "stone_file_read failed for " .. tostring(path), "stone_file_read:null")
        return null
    end
    local result = ffi.string(data, len[0])
    stone.stone_free(data)
    return result
"""

