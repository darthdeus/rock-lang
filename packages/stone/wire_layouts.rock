// @nomangle: setup_stone's cdef declares the stats getters over these names.
pub @nomangle value GraphicsStats {
    draw_calls: int,
    text_draw_calls: int,
    canvas_switches: int,
    shader_switches: int,
    stream_upload_calls: int,
    stream_storage_replacements: int,
    stream_upload_bytes: int,
    streamed_vertices: int,
    retained_upload_calls: int,
    retained_upload_bytes: int,
    retained_uploaded_vertices: int,
    images: int,
    canvases: int,
    texture_memory_mib: int,
    instanced_draws: int,
}

pub @nomangle value ImageLoadStats {
    load_calls: int,
    load_failures: int,
    decoded_bytes: int,
    load_us: int,
    upload_calls: int,
    upload_bytes: int,
    wait_us: int,
    upload_us: int,
    active_frames: int,
    max_wait_us: int,
}
