fn ui_text_fit_width(text: string) -> float { return measure_ui(text, 12.0).x }

@test
fn ui_fit_text_keeps_the_longest_complete_prefix() {
    ui_with_test_font(() => {
        let room = ui_text_fit_width("Fireball")
        let glyph = "\u{00e9}"
        let multibyte = glyph + glyph + glyph + glyph + glyph
        let extra = 0.5 * ui_text_fit_width(glyph)
        for (text, width, ellipsis, expected, rule) in [
            ("Fireball", room, false, "Fireball", "exact fit is kept"),
            ("Fireball", room, true, "Fireball", "fitting text takes no ellipsis"),
            ("", 0.0, true, "", "empty text stays empty"),
            ("Fireball", ui_text_fit_width("Fire"), false, "Fire", "plain cut keeps the longest prefix"),
            ("Fireball", ui_text_fit_width("Fir..."), true, "Fir...", "the ellipsis is measured with the prefix"),
            ("Fireball", 0.0, false, "", "no room keeps nothing"),
            ("Fireball", 0.0, true, "...", "no room still marks the cut"),
            (multibyte, ui_text_fit_width(glyph + glyph) + extra, false, glyph + glyph, "plain cut keeps whole glyphs"),
            (multibyte, ui_text_fit_width(glyph + "...") + extra, true, glyph + "...", "ellipsis cut keeps whole glyphs"),
        ] {
            let actual = if ellipsis { ui_fit_text(text, width, 12.0, ellipsis: true) }
                else { ui_fit_text(text, width, 12.0) }
            assert_eq(actual, expected, rule)
        }
    })
}
