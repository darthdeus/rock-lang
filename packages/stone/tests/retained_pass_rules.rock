use stone::*

fn retained_pass_canvas(handle: int, width: float = 16.0, height: float = 8.0) -> Canvas {
    return Canvas { handle: CanvasId(handle), width, height }
}

@test
fn retained_pass_input_updates_preserve_queued_records() {
    let saved_scene = SCENE_PASSES
    let saved_final = FINAL_PASSES
    let saved_log = PIPELINE_PASS_LOG
    defer { SCENE_PASSES = saved_scene; FINAL_PASSES = saved_final; PIPELINE_PASS_LOG = saved_log }
    SCENE_PASSES = []
    FINAL_PASSES = []
    PIPELINE_PASS_LOG = []
    let canvas = retained_pass_canvas(1)
    let original = Pass {
        pipeline: Pipeline { shader_name: "retained_pass_test" },
        slot_inputs: [(SampledTexture::Canvas(canvas), TextureFilter::Nearest),
                      (SampledTexture::Image(Image(2)), TextureFilter::Linear)],
        output: retained_pass_canvas(3), timed: 9, draw_buffers: 3,
    }
    queue_scene_pass(original)
    queue_final_pass(original)
    pipeline_inspector_record_pass(original)
    assert(same_ref(original,
        original.with_canvas_input(0, canvas, TextureFilter::Nearest)))
    assert(same_ref(original,
        original.with_image_input(1, Image(2), TextureFilter::Linear)))

    let changed = original.with_canvas_input(0, retained_pass_canvas(4), TextureFilter::Linear)
    assert(!same_ref(original, changed))
    queue_scene_pass(changed)
    for i in 0..2 {
        match SCENE_PASSES[i] {
            ScenePassEntry::Script(seen) => {
                assert(same_ref(seen, if i == 0 { original } else { changed }))
                assert(sampled_texture_matches_canvas(seen.slot_inputs[0].0,
                    if i == 0 { canvas } else { retained_pass_canvas(4) }))
                assert_eq(seen.slot_inputs[0].1, if i == 0 { TextureFilter::Nearest } else { TextureFilter::Linear })
            }
            ScenePassEntry::Native(_, _, _) => { error("unexpected native callback") }
        }
    }
    assert(same_ref(FINAL_PASSES[0], original))
    match PIPELINE_PASS_LOG[0] {
        PipelinePassInfo::Legacy(seen) => {
            assert(same_ref(seen, original))
            assert(sampled_texture_matches_canvas(seen.slot_inputs[0].0, canvas))
        }
        PipelinePassInfo::Semantic(_) => { error("unexpected GPU command") }
    }
    assert(changed.timed == 9 && changed.draw_buffers == 3 && changed.output.unwrap().handle.0 == 3)

    let resized = original.with_canvas_input(0, retained_pass_canvas(1, 32.0, 8.0), TextureFilter::Nearest)
    assert(!same_ref(original, resized))
    assert(sampled_texture_matches_canvas(resized.slot_inputs[0].0, retained_pass_canvas(1, 32.0, 8.0)))
    let taller = resized.with_canvas_input(0, retained_pass_canvas(1, 32.0, 24.0), TextureFilter::Nearest)
    assert(!same_ref(resized, taller))
    let filtered = original.with_canvas_input(0, canvas, TextureFilter::Linear)
    assert(!same_ref(original, filtered))
    let image = original.with_image_input(0, Image(1), TextureFilter::Nearest)
    assert(!same_ref(original, image), "equal handles of different kinds are not equal inputs")
    assert(!same_ref(image, image.with_canvas_input(0, canvas, TextureFilter::Nearest)))
    assert(!same_ref(image, image.with_image_input(0, Image(5), TextureFilter::Nearest)))
    assert(!same_ref(image, image.with_image_input(0, Image(1), TextureFilter::Linear)))
    assert(world_fixture_raised(() => { let _ = original.with_canvas_input(-1, canvas, TextureFilter::Nearest) }) != null)
    assert(world_fixture_raised(() => { let _ = original.with_image_input(2, Image(1), TextureFilter::Nearest) }) != null)
    assert(original.slot_inputs.len() == 2)
}

@test
fn retained_pass_output_updates_preserve_previous_output() {
    let canvas = retained_pass_canvas(3)
    let original = Pass { pipeline: Pipeline { shader_name: "retained_pass_test" }, output: canvas }
    assert(same_ref(original, original.with_output(canvas)))
    let resized = original.with_output(retained_pass_canvas(3, 32.0, 8.0))
    assert(!same_ref(original, resized))
    assert(original.output.unwrap().width == 16.0 && resized.output.unwrap().width == 32.0)
    let taller = resized.with_output(retained_pass_canvas(3, 32.0, 24.0))
    assert(!same_ref(resized, taller))
    let changed = original.with_output(retained_pass_canvas(4))
    assert(!same_ref(original, changed))
    let cleared = original.with_output(null)
    assert(cleared.output == null && original.output != null)
    assert(same_ref(cleared, cleared.with_output(null)))
    assert(!same_ref(cleared, cleared.with_output(canvas)))
}

@test
fn retained_pass_scene_return_reuses_only_matching_snapshots() {
    let saved = SCENE_RETURN_PASS
    defer { SCENE_RETURN_PASS = saved }
    let source = retained_pass_canvas(10)
    let output = retained_pass_canvas(11)
    let first = scene_return_pass(source, output)
    assert(same_ref(first, scene_return_pass(source, output)))
    reset_scene_return_pass()
    assert(SCENE_RETURN_PASS == null)
    assert(!same_ref(first, scene_return_pass(source, output)))
    assert(sampled_texture_matches_canvas(first.slot_inputs[0].0, source))
    let resized = scene_return_pass(retained_pass_canvas(10, 32.0, 8.0), output)
    assert(!same_ref(first, resized))
    assert(sampled_texture_matches_canvas(first.slot_inputs[0].0, source))
    let retargeted = scene_return_pass(source, retained_pass_canvas(12))
    assert(retargeted.output.unwrap().handle.0 == 12 && first.output.unwrap().handle.0 == 11)
}

@test
fn retained_pass_renders_changed_inputs_and_preserves_inspection() {
    pass_rules_fixture(() => {
        let saved = SCENE_RETURN_PASS
        defer { SCENE_RETURN_PASS = saved }
        let bright = pass_rules_flat_canvas(8, 0.75)
        let dark = pass_rules_flat_canvas(8, 0.0)
        let first_output = new_canvas(8, 8, "rgba16f")
        let second_output = new_canvas(8, 8, "rgba16f")
        let saved_inspector = ENGINE.show_pipeline_inspector
        let saved_log = PIPELINE_PASS_LOG
        defer {
            ENGINE.show_pipeline_inspector = saved_inspector
            PIPELINE_PASS_LOG = saved_log
            destroy_canvas(bright)
            destroy_canvas(dark)
            destroy_canvas(first_output)
            destroy_canvas(second_output)
        }
        ENGINE.show_pipeline_inspector = true
        PIPELINE_PASS_LOG = []
        load_pending_shader_sources()
        let first = scene_return_pass(bright, first_output)
        assert(run_pass(first))
        let second = scene_return_pass(dark, second_output)
        assert(run_pass(second))
        assert(read_canvas_pixel(first_output, 4, 4) > 0.5)
        assert(read_canvas_pixel(second_output, 4, 4) < 0.05)
        assert(PIPELINE_PASS_LOG.len() == 2)
        match PIPELINE_PASS_LOG[0] {
            PipelinePassInfo::Legacy(seen) => {
                assert(sampled_texture_matches_canvas(seen.slot_inputs[0].0, bright))
                assert(seen.output.unwrap().handle.0 == first_output.handle.0)
            }
            PipelinePassInfo::Semantic(_) => { error("unexpected GPU command") }
        }
    })
}
