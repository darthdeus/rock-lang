@test
fn replay_input_authority_device_policy() {
    let saved_device = LAST_INPUT_DEVICE
    defer { LAST_INPUT_DEVICE = saved_device }
    let kbm: InputDevice? = InputDevice::KeyboardMouse
    let pad: InputDevice? = InputDevice::Pad
    let none: InputDevice? = null
    for (event, device, rule) in [
        (InputDeviceEvent::KeyPress, kbm, "keyboard press claims keyboard/mouse"),
        (InputDeviceEvent::MouseButtonPress, kbm, "mouse button press claims keyboard/mouse"),
        (InputDeviceEvent::PadButtonPress, pad, "pad button press claims pad"),
        (InputDeviceEvent::PadAxisMotion((1.0 + PAD_DEVICE_CLAIM_THRESHOLD) * 0.5), pad,
            "above-threshold pad axis claims pad"),
        (InputDeviceEvent::PadAxisMotion(PAD_DEVICE_CLAIM_THRESHOLD), none,
            "axis exactly at the device threshold does not claim a pad"),
        (InputDeviceEvent::PadAxisMotion(PAD_DEVICE_CLAIM_THRESHOLD * 0.02), none,
            "sub-threshold pad axis does not claim a device"),
        (InputDeviceEvent::MouseMotion, none, "mouse motion does not change the device modality"),
    ] {
        assert(input_classify_last_device(event) == device, rule)
    }

    for (event, device, rule) in [
        (InputDeviceEvent::KeyPress, InputDevice::KeyboardMouse, "keyboard press selects keyboard/mouse modality"),
        (InputDeviceEvent::PadAxisMotion(PAD_DEVICE_CLAIM_THRESHOLD * 0.02), InputDevice::KeyboardMouse,
            "axis noise leaves glyph modality unchanged"),
        (InputDeviceEvent::MouseMotion, InputDevice::KeyboardMouse, "mouse motion leaves glyph modality unchanged"),
        (InputDeviceEvent::PadButtonPress, InputDevice::Pad, "pad press selects pad modality"),
    ] {
        input_note_last_device(event)
        assert(input_last_device() == device, rule)
    }
}
