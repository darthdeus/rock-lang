use stone::*

inline(lua) fn frame_hook_test_callback(body: fn() -> int) -> PtrU8 = """
    return ffi.cast("int32_t (*)(void *, const void *)", function(_, _)
        return body()
    end)
"""

inline(lua) fn frame_hook_test_free(callback: PtrU8) = "callback:free()"
inline(lua) fn frame_hook_test_null() -> PtrU8 = 'return ffi.cast("void *", nil)'

fn frame_hook_test_register(point: int, body: PtrU8) -> int {
    let hook = stone_native_frame_hook_register(point, 0, body, frame_hook_test_null(),
        frame_hook_test_null(), "frame_hook_test")
    assert(hook != 0)
    return hook
}

fn frame_hook_test_red(canvas: int) -> float {
    return stone_read_canvas_pixel_channel(canvas, 2, 2, 0)
}

@test
fn frame_hooks_run_around_the_scene_clear_and_supply_the_world_image() {
    gpu_test_host()
    let view = resolve_frame_view(v(16,16), iv(16,16), Camera2D {}, RENDER_CONFIG).unwrap()
    with_scene_render_scope(view, () => {
        let image = new_canvas(16.0, 16.0, "rgba8")
        defer { unset_canvas(); destroy_canvas(image) }
        set_canvas(image)
        stone_clear_canvas(0.75, 0.0, 0.0, 1.0)
        unset_canvas()
        let scene = screen_canvas.handle.0

        let set_image = false
        let world_image_target = 0
        let world_image_flags = STONE_WORLD_IMAGE_KEEP_POST
        let order: [string] = []
        let begin = frame_hook_test_callback(() => {
            order.push("begin")
            if set_image {
                let _ = stone_native_frame_set_world_image(world_image_target, world_image_flags)
            }
            return 0
        })
        defer { frame_hook_test_free(begin) }
        let scene_at_batches = -1.0
        let batches = frame_hook_test_callback(() => {
            order.push("batches")
            scene_at_batches = frame_hook_test_red(scene)
            stone_clear_canvas(0.5, 0.0, 0.0, 1.0)
            return 1
        })
        defer { frame_hook_test_free(batches) }
        let begin_hook = frame_hook_test_register(STONE_FRAME_HOOK_WORLD_BEGIN, begin)
        let batches_hook = frame_hook_test_register(STONE_FRAME_HOOK_WORLD_BATCHES, batches)
        defer {
            assert(stone_native_frame_hook_unregister(begin_hook))
            assert(stone_native_frame_hook_unregister(batches_hook))
        }

        // The batches hook runs after the engine cleared the scene and writes it.
        set_canvas(screen_canvas)
        stone_clear_canvas(0.25, 0.0, 0.0, 1.0)
        unset_canvas()
        render_batches()
        assert_eq(order, ["begin", "batches"])
        assert_eq(scene_at_batches, 0.0)
        assert(!WORLD_IMAGE_FRAME)
        assert(abs(frame_hook_test_red(scene) - 0.5) < 0.01)

        // A world image replaces the engine's world rendering for the frame.
        order = []
        set_image = true
        world_image_target = image.handle.0
        stone_reset_frame_stats()
        render_batches()
        assert_eq(order, ["begin"])
        assert(WORLD_IMAGE_FRAME)
        assert(abs(frame_hook_test_red(scene) - 0.75) < 0.01)

        // An invalid image or the reserved flag logs and renders normally.
        for (target, flags, message) in [
            (0, STONE_WORLD_IMAGE_KEEP_POST, "[STONE] stone_native_frame_set_world_image: target 0 is not live"),
            (image.handle.0, 2, "[STONE] stone_native_frame_set_world_image: unsupported flags 0x2 (only KEEP_POST)"),
        ] {
            order = []
            world_image_target = target
            world_image_flags = flags
            stone_reset_frame_stats()
            assert_error_logs([message], () => { render_batches() })
            assert_eq(order, ["begin", "batches"])
            assert(!WORLD_IMAGE_FRAME)
            assert(abs(frame_hook_test_red(scene) - 0.5) < 0.01)
        }
    })
}

@test
fn frame_hooks_do_not_run_without_a_scene() {
    gpu_test_host()
    let calls = 0
    let body = frame_hook_test_callback(() => { calls += 1; return 0 })
    defer { frame_hook_test_free(body) }
    let hook = frame_hook_test_register(STONE_FRAME_HOOK_SCENE_END, body)
    defer { assert(stone_native_frame_hook_unregister(hook)) }
    assert_error_logs(["[STONE] stone_native_frame_hooks_run: scene target 0 is not live"], () => {
        assert_eq(run_frame_hooks(STONE_FRAME_HOOK_SCENE_END, v(0.0, 0.0), 1.0), 0)
    })
    assert_eq(calls, 0)
}

inline(lua) fn frame_hook_test_scene_pass(body: fn() -> int) -> PtrU8 = """
    return ffi.cast("int32_t (*)(void *, uint64_t, uint64_t)", function(_, _, _)
        return body()
    end)
"""

@nomangle
fn frame_hook_world_image_runner_case(_which: int) {
    let _ = native_runner_test_boot("frame hook world image")
    defer { let _ = stone_teardown() }
    frame_core_resolve_view()
    let image = new_canvas(16.0, 16.0, "rgba8")
    set_canvas(image)
    stone_clear_canvas(0.75, 0.0, 0.0, 1.0)
    unset_canvas()
    assert(mrt_id_attached)
    with_canvas(visible_id_canvas, () => { stone_clear_canvas_int(0, 7) })

    let image_set = false
    let begin = frame_hook_test_callback(() => {
        image_set = stone_native_frame_set_world_image(image.handle.0, STONE_WORLD_IMAGE_KEEP_POST)
        return 0
    })
    defer { frame_hook_test_free(begin) }
    let scene_end_calls = 0
    let scene_end = frame_hook_test_callback(() => { scene_end_calls += 1; return 0 })
    defer { frame_hook_test_free(scene_end) }
    let scene_pass_calls = 0
    let scene_pass = frame_hook_test_scene_pass(() => { scene_pass_calls += 1; return 0 })
    defer { frame_hook_test_free(scene_pass) }
    let begin_hook = frame_hook_test_register(STONE_FRAME_HOOK_WORLD_BEGIN, begin)
    let end_hook = frame_hook_test_register(STONE_FRAME_HOOK_SCENE_END, scene_end)
    defer {
        assert(stone_native_frame_hook_unregister(begin_hook))
        assert(stone_native_frame_hook_unregister(end_hook))
    }

    assert(queue_native_scene_pass(scene_pass, frame_hook_test_null()))
    rect(pixel_screen, v(0.0, 0.0), v(8.0, 16.0), Color { r: 0.0, g: 1.0, b: 0.0, a: 1.0 })
    frame_core_render_world()

    assert(image_set && WORLD_IMAGE_FRAME)
    assert_eq(scene_end_calls, 1)
    assert_eq(scene_pass_calls, 0)
    assert_eq(SCENE_PASSES.len(), 0)
    assert_eq(stone_read_canvas_pixel_channel(visible_id_canvas.handle.0, 8, 8, 0), 0.0,
        "picking must not see ids from before the world image")
    // Post processing composited the world image and the pixel-screen draw,
    // and present consumed the composite.
    assert(COMPOSITE_CANVAS == null)
    let composite = PRESENTED_SCENE_SAMPLE.unwrap().canvas.handle.0
    assert(stone_read_canvas_pixel_channel(composite, 12, 8, 0) > 0.2)
    assert(stone_read_canvas_pixel_channel(composite, 12, 8, 1) < 0.1)
    assert(stone_read_canvas_pixel_channel(composite, 2, 8, 1) > 0.9)
}

@test
fn frame_hooks_world_image_frame_keeps_post_processing_and_present() {
    profiler_test_process("frame_hook_world_image_runner_case", 0)
}

fn frame_hook_test_window_pixel(x: int, y: int, channel: int) -> int {
    let pixel = native_buffer_u8(4)
    stone_read_window_rect(x, y, 1, 1, pixel.ptr)
    return pixel[channel]
}

inline(lua) fn frame_hook_test_viewport() -> string = """
    pcall(ffi.cdef, "void* SDL_GL_GetProcAddress(const char* proc);")
    local get = ffi.cast("void (*)(uint32_t, int*)", stone.SDL_GL_GetProcAddress("glGetIntegerv"))
    local viewport = ffi.new("int[4]")
    get(0x0BA2, viewport)
    return viewport[0] .. "," .. viewport[1] .. "," .. viewport[2] .. "," .. viewport[3]
"""

inline(lua) fn frame_hook_test_draw_framebuffer() -> int = """
    local get = ffi.cast("void (*)(uint32_t, int*)", stone.SDL_GL_GetProcAddress("glGetIntegerv"))
    local binding = ffi.new("int[1]")
    get(0x8CA6, binding)
    return binding[0]
"""

// Like frame_hook_test_callback; keeps the target fields of the hook's
// StoneFrameInfo for frame_hook_test_info.
inline(lua) fn frame_hook_test_info_callback(body: fn() -> int) -> PtrU8 = """
    return ffi.cast("StoneFrameHookFn", function(_, info)
        _G.__frame_hook_test_info = string.format("%d,%d,%d,%d,%d", tonumber(info.framebuffer),
            info.target_width, info.target_height, info.active_width, info.active_height)
        return body()
    end)
"""

inline(lua) fn frame_hook_test_info() -> string = "return _G.__frame_hook_test_info"

// Clears one pixel of the bound target white.
inline(lua) fn frame_hook_test_mark(x: int, y: int) = """
    local function gl(name, signature)
        return ffi.cast(signature, stone.SDL_GL_GetProcAddress(name))
    end
    gl("glEnable", "void (*)(uint32_t)")(0x0C11)
    gl("glScissor", "void (*)(int, int, int, int)")(x, y, 1, 1)
    gl("glClearColor", "void (*)(float, float, float, float)")(1, 1, 1, 1)
    gl("glClear", "void (*)(uint32_t)")(0x4000)
    gl("glDisable", "void (*)(uint32_t)")(0x0C11)
"""

// Runs two frames with a UI_BEGIN hook that clears its target blue and marks
// one white pixel, and checks the layer order on the window: the hook's blue
// above the post-processed world (red) and below the script UI batch
// (green), and the marked pixel covering scale x scale window pixels.
fn frame_hook_ui_begin_case(title: string, raster_scale: float) {
    let _ = native_runner_test_boot(title)
    defer { let _ = stone_teardown() }
    let saved = RENDER_CONFIG
    let config = RENDER_CONFIG
    config.ui.raster_scale = raster_scale
    RENDER_CONFIG = config
    defer { RENDER_CONFIG = saved }
    frame_core_resolve_view()
    let scale = int(round(1.0 / raster_scale))
    let target = 16 ./ scale
    assert_eq(UI_RASTER_CANVAS != null, scale != 1, "the case selects the UI raster canvas path")
    let calls = 0
    let viewport = ""
    let bound = -1
    let ui_begin = frame_hook_test_info_callback(() => {
        calls += 1
        viewport = frame_hook_test_viewport()
        bound = frame_hook_test_draw_framebuffer()
        stone_clear_canvas(0.0, 0.0, 1.0, 1.0)
        frame_hook_test_mark(target * 3 ./ 4, target ./ 4)
        return 1
    })
    defer { frame_hook_test_free(ui_begin) }
    // The world is the scene target cleared red, post processed.
    let scene_end = frame_hook_test_callback(() => {
        stone_clear_canvas(1.0, 0.0, 0.0, 1.0)
        return 1
    })
    defer { frame_hook_test_free(scene_end) }
    let hook = frame_hook_test_register(STONE_FRAME_HOOK_UI_BEGIN, ui_begin)
    let world_hook = frame_hook_test_register(STONE_FRAME_HOOK_SCENE_END, scene_end)
    defer {
        assert(stone_native_frame_hook_unregister(hook))
        assert(stone_native_frame_hook_unregister(world_hook))
    }

    for frame in 0..2 {
        rect(screen, v(0.0, 0.0), v(8.0, 16.0), Color { r: 0.0, g: 1.0, b: 0.0, a: 1.0 })
        frame_core_render_world()
        assert_eq(calls, frame, "the hook runs outside the world draw")
        frame_core_render_ui_flush()
        assert_eq(calls, frame + 1, "the hook runs once per frame")
        assert_eq(viewport, "0,0,{target},{target}", "frame {frame}: the viewport is the target's full extent")
        assert_eq(frame_hook_test_info(), "{bound},{target},{target},{target},{target}",
            "frame {frame}: the frame info describes the hook's target")
        let world = stone_read_canvas_pixel_channel(PRESENTED_SCENE_SAMPLE.unwrap().canvas.handle.0, 12, 8, 0)
        assert(world > 0.5, "frame {frame}: the post-processed world is red, got {world}")
        let ui = [frame_hook_test_window_pixel(2, 8, 1), frame_hook_test_window_pixel(2, 8, 2)]
        assert(ui[0] == 255 && ui[1] == 0, "frame {frame}: the script UI batch covers the hook, got green,blue {ui}")
        let marked: [string] = []
        let blue = 0
        for y in 0..16 {
            for x in 8..16 {
                let (r, b) = (frame_hook_test_window_pixel(x, y, 0), frame_hook_test_window_pixel(x, y, 2))
                if r == 255 && b == 255 {
                    marked.push("{x},{y}")
                } else if r == 0 && b == 255 {
                    blue += 1
                }
            }
        }
        assert_eq(marked.len(), scale * scale, "frame {frame}: the marked pixel covers scale x scale window pixels, got {marked}")
        assert_eq(blue + marked.len(), 128, "frame {frame}: the hook's blue covers the post-processed world")
    }
}

@nomangle
fn frame_hook_ui_begin_runner_case(_which: int) {
    frame_hook_ui_begin_case("frame hook ui begin", 1.0)
}

@test
fn a_ui_begin_hook_draws_between_the_post_processed_world_and_script_ui() {
    profiler_test_process("frame_hook_ui_begin_runner_case", 0)
}

@nomangle
fn frame_hook_ui_begin_raster_runner_case(_which: int) {
    frame_hook_ui_begin_case("frame hook ui begin raster", 0.5)
}

@test
fn a_ui_begin_hook_layers_the_same_way_through_the_ui_raster_canvas() {
    profiler_test_process("frame_hook_ui_begin_raster_runner_case", 0)
}
