fn native_present_target_with_spare_capacity_maps_active_region_once() {
    profiler_test_process("native_present_spare_capacity_runner_case", 0)
}

@nomangle
fn native_outline_reset_on_frame_begin_runner_case(_which: int) {
    let config = GameConfig { title: "outline frame begin", width: 16, height: 16, vsync: 0 }
    assert(stone_game_boot(config))
    defer { let _ = stone_game_shutdown() }

    // Frame 1: draw an outlined sprite so outline state is populated.
    let plan1 = stone_game_frame_begin(stone_get_time(), 1).unwrap()
    assert(plan1.running)
    let _ = stone_game_frame_update()
    let white = sampled_image(WHITE_PIXEL.unwrap())
    draw_sprite(white, v(1.0, 1.0), dest_size: v(4.0, 4.0),
        outline: Outline { entity_id: 1, color: WHITE, width: 1.0 }, entity_id: 1)
    let _ = stone_game_frame_draw()

    let (ok_after_draw, ids_after_draw, mask_after_draw) = native_api_outline_written()
    let (valid_after_draw, _, _, _, _) = native_api_outline_mask_bounds()
    assert(ok_after_draw && ids_after_draw && mask_after_draw && valid_after_draw,
        "outline state is populated after frame 1 draw")

    // Frame 2: right after stone_game_frame_begin (before update), readers see cleared state.
    let plan2 = stone_game_frame_begin(stone_get_time(), 2).unwrap()
    assert(plan2.running)
    let (ok_begin, ids_begin, mask_begin) = native_api_outline_written()
    let (valid_begin, x0, y0, x1, y1) = native_api_outline_mask_bounds()
    assert(ok_begin && !ids_begin && !mask_begin && !valid_begin,
        "outline state is cleared right after stone_game_frame_begin")
    assert_eq(x0, 0.0)
    assert_eq(y0, 0.0)
    assert_eq(x1, 0.0)
    assert_eq(y1, 0.0)
    let _ = stone_game_frame_update()
    let _ = stone_game_frame_draw()
}

@test
fn native_outline_readers_see_cleared_state_right_after_frame_begin() {
    profiler_test_process("native_outline_reset_on_frame_begin_runner_case", 0)
}

@test
fn native_outline_readers_expose_mask_bounds_and_written_flags() {
    gpu_test_host()
    let view = resolve_frame_view(v(16, 16), iv(16, 16), Camera2D {}, RENDER_CONFIG).unwrap()
    with_scene_render_scope(view, () => {
        let white = sampled_image(WHITE_PIXEL.unwrap())
        // Empty frame: nothing written, bounds invalid.
        render_batches()
        let (ok0, ids0, mask0) = native_api_outline_written()
        let (valid0, _, _, _, _) = native_api_outline_mask_bounds()
        assert(ok0 && !ids0 && !mask0 && !valid0)

        // World sprite without outline: ids written, mask not written, bounds invalid.
        draw_sprite(white, v(0.0, 0.0), dest_size: v(2.0, 2.0), entity_id: 2)
        render_batches()
        clear_batches()
        let (ok1, ids1, mask1) = native_api_outline_written()
        let (valid1, _, _, _, _) = native_api_outline_mask_bounds()
        assert(ok1 && ids1 && !mask1 && !valid1)

        // Outlined world sprite: ids and mask written, bounds match sprite extent.
        draw_sprite(white, v(3.0, -2.0), dest_size: v(4.0, 2.0),
            outline: Outline { entity_id: 3, color: WHITE, width: 1.0 }, entity_id: 3)
        render_batches()
        clear_batches()
        let (ok2, ids2, mask2) = native_api_outline_written()
        let (valid2, x0, y0, x1, y1) = native_api_outline_mask_bounds()
        assert(ok2 && ids2 && mask2 && valid2)
        assert(abs(x0 - 1.0) < 0.01 && abs(x1 - 5.0) < 0.01, "expected x in [1, 5], got [{x0}, {x1}]")
        assert(abs(y0 - (-3.0)) < 0.01 && abs(y1 - (-1.0)) < 0.01, "expected y in [-3, -1], got [{y0}, {y1}]")

        // Frame begin resets outline state before the next frame's prepare/batch flush.
        render_commands_begin_frame()
        let (ok3, ids3, mask3) = native_api_outline_written()
        let (valid3, _, _, _, _) = native_api_outline_mask_bounds()
        assert(ok3 && !ids3 && !mask3 && !valid3)
    })
}
