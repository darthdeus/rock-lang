fn native_present_target_skips_stone_world_composition() {
    profiler_test_process("native_present_target_runner_case", 0)
}

@nomangle
fn native_present_spare_capacity_runner_case(_which: int) {
    let _ = native_runner_test_boot("native present spare capacity")
    defer { let _ = stone_teardown() }
    frame_core_resolve_view()

    // Native target with 64x64 backing capacity and 32x32 active region.
    let fmt = native_buffer_int(1)
    fmt[0] = STONE_CANVAS_RGBA8
    let native_handle = stone_target_create(64, 64, fmt.ptr, 1, false)
    assert(native_handle != 0)
    defer {
        unset_canvas()
        stone_target_destroy(native_handle)
    }

    // Fill the entire 64x64 backing with red (spare padding must never appear).
    stone_set_canvas(native_handle)
    stone_clear_canvas(1.0, 0.0, 0.0, 1.0)

    // Shrink active region to 32x32 and paint its left half green, right half blue.
    stone_set_canvas_active(native_handle, 32, 32)
    stone_set_canvas(native_handle)
    stone_set_scissor(true, 0, 0, 16, 32)
    stone_clear_canvas(0.0, 1.0, 0.0, 1.0)
    stone_set_scissor(true, 16, 0, 16, 32)
    stone_clear_canvas(0.0, 0.0, 1.0, 1.0)
    stone_set_scissor(false, 0, 0, 0, 0)
    unset_canvas()

    // Borrowed native canvas keeps its active dimensions (32x32, not 64x64)
    // and does not insert per-handle entries into CANVAS_ACTIVE.
    let active_entries_before = CANVAS_ACTIVE.len()
    let borrowed = native_target_canvas(native_handle, 0).unwrap()
    assert_eq(int(borrowed.width), 32, "borrowed native target keeps active width")
    assert_eq(int(borrowed.height), 32, "borrowed native target keeps active height")
    assert_eq(CANVAS_ACTIVE.len(), active_entries_before, "borrowing a native target does not grow CANVAS_ACTIVE")

    // Also verify setting the target before render_commands_begin_frame survives.
    assert(native_api_set_present_target(native_handle))
    render_commands_begin_frame()
    frame_core_render_world()
    assert_eq(CANVAS_ACTIVE.len(), active_entries_before, "presenting a native target does not grow CANVAS_ACTIVE")

    // Window is 16x16: left half must be green, right half must be blue, zero red.
    let left_r = frame_hook_test_window_pixel(3, 8, 0)
    let left_g = frame_hook_test_window_pixel(3, 8, 1)
    let left_b = frame_hook_test_window_pixel(3, 8, 2)
    let right_r = frame_hook_test_window_pixel(12, 8, 0)
    let right_g = frame_hook_test_window_pixel(12, 8, 1)
    let right_b = frame_hook_test_window_pixel(12, 8, 2)
    assert(left_r == 0 && left_g == 255 && left_b == 0,
        "left half of active region must be green, got ({left_r}, {left_g}, {left_b})")
    assert(right_r == 0 && right_g == 0 && right_b == 255,
        "right half of active region must be blue, got ({right_r}, {right_g}, {right_b})")

    // Minimized window (RENDER_VIEW == null) must not leave COMPOSITE_CANVAS or
    // PRESENTED_SCENE_SAMPLE pointing at the unpresented native target.
    let saved_view = RENDER_VIEW
    RENDER_VIEW = null
    defer { RENDER_VIEW = saved_view }
    assert(native_api_set_present_target(native_handle))
    frame_core_render_world()
    assert(COMPOSITE_CANVAS == null, "minimized frame does not retain COMPOSITE_CANVAS")
    assert(PRESENTED_SCENE_SAMPLE == null, "minimized frame does not capture PRESENTED_SCENE_SAMPLE")
}

