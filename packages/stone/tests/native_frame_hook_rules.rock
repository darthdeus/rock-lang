inline(lua) fn native_api_set_present_target(target: int) -> bool = """
    local api = ffi.cast("const StoneNativeRendererApiV1 *", stone.stone_native_renderer_api(1))
    assert(api ~= nil and api.abi_version == 1 and api.struct_size >= ffi.sizeof("StoneNativeRendererApiV1"))
    return api.frame_set_present_target(target) ~= 0
"""

inline(lua) fn native_api_outline_written() -> (bool, bool, bool) = """
    local api = ffi.cast("const StoneNativeRendererApiV1 *", stone.stone_native_renderer_api(1))
    local ids = ffi.new("bool[1]")
    local mask = ffi.new("bool[1]")
    local ok = api.frame_outline_written(ids, mask) ~= 0
    return ok, ids[0], mask[0]
"""

inline(lua) fn native_api_outline_mask_bounds() -> (bool, float, float, float, float) = """
    local api = ffi.cast("const StoneNativeRendererApiV1 *", stone.stone_native_renderer_api(1))
    local x0 = ffi.new("float[1]")
    local y0 = ffi.new("float[1]")
    local x1 = ffi.new("float[1]")
    local y1 = ffi.new("float[1]")
    local valid = api.frame_outline_mask_bounds(x0, y0, x1, y1) ~= 0
    return valid, x0[0], y0[0], x1[0], y1[0]
"""

@nomangle
fn native_present_target_runner_case(_which: int) {
    let _ = native_runner_test_boot("native present target")
    defer { let _ = stone_teardown() }
    frame_core_resolve_view()

    let saved_bloom = ENGINE.use_bloom
    ENGINE.use_bloom = true
    defer { ENGINE.use_bloom = saved_bloom }

    let native_target = new_canvas(16.0, 16.0, "rgba8")
    let final_src = new_canvas(16.0, 16.0, "rgba8")
    let final_out = new_canvas(16.0, 16.0, "rgba8")
    defer {
        unset_canvas()
        destroy_canvas(native_target)
        destroy_canvas(final_src)
        destroy_canvas(final_out)
    }

    with_canvas(native_target, () => { stone_clear_canvas(0.25, 0.75, 0.5, 1.0) })
    with_canvas(final_src, () => { stone_clear_canvas(1.0, 0.0, 0.0, 1.0) })
    with_canvas(final_out, () => { stone_clear_canvas(0.0, 0.0, 0.0, 1.0) })

    let skip_compose = true
    let hook_ids = false
    let hook_mask = false
    let hook_bounds_ok = false
    let hook_x0 = 0.0
    let hook_y0 = 0.0
    let hook_x1 = 0.0
    let hook_y1 = 0.0
    let scene_end = frame_hook_test_callback(() => {
        let (ok, ids, mask) = native_api_outline_written()
        assert(ok)
        hook_ids = ids
        hook_mask = mask
        let (valid, x0, y0, x1, y1) = native_api_outline_mask_bounds()
        hook_bounds_ok = valid
        hook_x0 = x0
        hook_y0 = y0
        hook_x1 = x1
        hook_y1 = y1
        if skip_compose {
            assert(native_api_set_present_target(native_target.handle.0))
        }
        return 0
    })
    defer { frame_hook_test_free(scene_end) }
    let end_hook = frame_hook_test_register(STONE_FRAME_HOOK_SCENE_END, scene_end)
    defer { assert(stone_native_frame_hook_unregister(end_hook)) }

    let white = sampled_image(WHITE_PIXEL.unwrap())
    // Frame 1: switch ON -- skip Stone world composition and present native_target.
    let bloom_before = POST_BLOOM_RUNS
    let tonemap_before = POST_TONEMAP_RUNS
    let outline_before = OUTLINE_OVERLAY_RUNS
    draw_sprite(white, v(1.0, 2.0), dest_size: v(4.0, 6.0),
        outline: Outline { entity_id: 1, color: WHITE, width: 2.0 }, entity_id: 1)
    queue_final_pass(Pass {
        pipeline: BLIT_PIPELINE,
        slot_inputs: [(sampled_canvas(final_src), TextureFilter::Nearest)],
        output: final_out,
        clear: color(0.0, 0.0, 0.0, 1.0),
    })
    frame_core_render_world()

    assert(hook_ids && hook_mask, "SCENE_END hook observes outline written flags")
    assert(hook_bounds_ok, "SCENE_END hook observes valid outline mask bounds")
    assert(abs(hook_x0 - (-1.0)) < 0.01 && abs(hook_x1 - 3.0) < 0.01,
        "outline bounds x span sprite [-1, 3], got [{hook_x0}, {hook_x1}]")
    assert(abs(hook_y0 - (-1.0)) < 0.01 && abs(hook_y1 - 5.0) < 0.01,
        "outline bounds y span sprite [-1, 5], got [{hook_y0}, {hook_y1}]")

    assert_eq(POST_BLOOM_RUNS, bloom_before, "bloom did not run")
    assert_eq(POST_TONEMAP_RUNS, tonemap_before, "tonemap did not run")
    assert_eq(OUTLINE_OVERLAY_RUNS, outline_before, "outline overlay did not run")
    assert_eq(FINAL_PASSES.len(), 0, "queued final passes were discarded")
    assert(stone_read_canvas_pixel_channel(final_out.handle.0, 8, 8, 0) < 0.01,
        "queued final pass did not execute")
    assert(COMPOSITE_CANVAS == null, "present consumed the native target")
    assert_eq(PRESENTED_SCENE_SAMPLE.unwrap().canvas.handle.0, native_target.handle.0,
        "PRESENTED_SCENE_SAMPLE points at the native target")
    let win_r = frame_hook_test_window_pixel(8, 8, 0)
    let win_g = frame_hook_test_window_pixel(8, 8, 1)
    let win_b = frame_hook_test_window_pixel(8, 8, 2)
    assert(abs(win_r - 64) <= 2 && abs(win_g - 191) <= 2 && abs(win_b - 128) <= 2,
        "window received the native target colour, got ({win_r}, {win_g}, {win_b})")

    // Frame 2: switch OFF -- Stone world composition runs normally again.
    skip_compose = false
    draw_sprite(white, v(1.0, 2.0), dest_size: v(4.0, 6.0),
        outline: Outline { entity_id: 1, color: WHITE, width: 2.0 }, entity_id: 1)
    frame_core_render_world()

    assert_eq(POST_BLOOM_RUNS, bloom_before + 1, "bloom ran on the next frame")
    assert_eq(POST_TONEMAP_RUNS, tonemap_before + 1, "tonemap ran on the next frame")
    assert_eq(OUTLINE_OVERLAY_RUNS, outline_before + 1, "outline overlay ran on the next frame")
    assert_eq(PRESENTED_SCENE_SAMPLE.unwrap().canvas.handle.0, final_canvas.handle.0,
        "normal frame presents Stone's composite canvas")
}

