fn bookkeeping_test_interface(fingerprint: int) -> SemanticShaderInterface {
    return SemanticShaderInterface {
        fingerprint, fullscreen: true, vertex_inputs: [], texture_slots: ["input"],
        texture_kinds: [0], blocks: [], array_blocks: [], outputs: [],
    }
}

@test
fn selected_shader_interface_checks_live_public_semantics() {
    let shader = "bookkeeping-public-semantics"
    let saved_watcher = WATCHER
    let saved_generation = NEXT_SEMANTIC_SHADER_GENERATION
    WATCHER = FileWatcher { enabled: true, shaders: map_new(), current_shader_name: null }
    defer {
        WATCHER = saved_watcher
        NEXT_SEMANTIC_SHADER_GENERATION = saved_generation
        GL_SHADER_SEMANTICS.remove(shader)
        GL_SHADER_ARTIFACTS.remove(shader)
    }
    WATCHER.shaders.insert(shader, WatcherShader { shader: ShaderId(1) })
    publish_gl_shader_semantic(shader, bookkeeping_test_interface(41))
    let published = GL_SHADER_SEMANTICS.get(shader).unwrap()
    assert_eq(selected_shader_interface(shader).unwrap().fingerprint, 41)

    GL_SHADER_SEMANTICS.insert(shader, SemanticShaderGeneration {
        interface: published.interface, generation: published.generation + 1,
    })
    assert(selected_shader_interface(shader) == null, "a replaced public generation cannot select stale metadata")
    GL_SHADER_SEMANTICS.insert(shader, SemanticShaderGeneration {
        interface: bookkeeping_test_interface(42), generation: published.generation,
    })
    assert(selected_shader_interface(shader) == null, "a public fingerprint mutation cannot select stale metadata")
    GL_SHADER_SEMANTICS.remove(shader)
    assert(selected_shader_interface(shader) == null, "removed public metadata is not cached")
    GL_SHADER_SEMANTICS.insert(shader, published)
    assert_eq(selected_shader_interface(shader).unwrap().fingerprint, 41)
}

@test
fn selected_shader_interface_checks_watcher_replacement_and_republication() {
    let shader = "bookkeeping-watcher-republication"
    let saved_watcher = WATCHER
    let saved_generation = NEXT_SEMANTIC_SHADER_GENERATION
    WATCHER = FileWatcher { enabled: true, shaders: map_new(), current_shader_name: null }
    defer {
        WATCHER = saved_watcher
        NEXT_SEMANTIC_SHADER_GENERATION = saved_generation
        GL_SHADER_SEMANTICS.remove(shader)
        GL_SHADER_ARTIFACTS.remove(shader)
    }
    publish_gl_shader_semantic(shader, bookkeeping_test_interface(51))
    let old_generation = GL_SHADER_SEMANTICS.get(shader).unwrap()
    assert(selected_shader_interface(shader) == null, "metadata alone does not make a program live")
    WATCHER.shaders.insert(shader, WatcherShader { shader: ShaderId(1) })
    assert_eq(selected_shader_interface(shader).unwrap().fingerprint, 51)
    WATCHER = FileWatcher { enabled: true, shaders: map_new(), current_shader_name: null }
    assert(selected_shader_interface(shader) == null, "replacing WATCHER invalidates membership immediately")
    WATCHER.shaders.insert(shader, WatcherShader { shader: ShaderId(2) })
    publish_gl_shader_semantic(shader, bookkeeping_test_interface(52))
    assert_eq(selected_shader_interface(shader).unwrap().fingerprint, 52, "republication selects the current artifact")
    GL_SHADER_SEMANTICS.insert(shader, old_generation)
    assert(selected_shader_interface(shader) == null, "republication invalidates the prior semantic generation")
}

@test
fn texture_slot_marks_preserve_draw_and_activation_lifetimes() {
    let shader = "bookkeeping-slot-lifetimes"
    let other = "bookkeeping-other-slot-lifetimes"
    let saved_filled = TEXTURE_SLOT_FILLED
    let saved_activation = TEXTURE_SLOT_ACTIVATION
    TEXTURE_SLOT_FILLED = map_new()
    TEXTURE_SLOT_ACTIVATION = map_new()
    defer {
        TEXTURE_SLOT_FILLED = saved_filled
        TEXTURE_SLOT_ACTIVATION = saved_activation
        SHADER_TEXTURE_SLOTS.remove(shader)
    }
    let by_name: Map<string, int> = map_new()
    SHADER_TEXTURE_SLOTS.insert(shader, ShaderTextureSlots { names: ["shared", "draw"], by_name })
    mark_texture_slot_activation(shader, 0)
    mark_texture_slot_activation(shader, 0)
    mark_texture_slot_filled(shader, 1)
    mark_texture_slot_filled(shader, 1)
    if os_getenv("STONE_TEXTURE_SLOT_FORCE_UNFILLED") == "1" {
        assert(TEXTURE_SLOT_FILLED.get(shader) == null, "suppression prevents per-draw writes")
        assert(TEXTURE_SLOT_ACTIVATION.get(shader) == null, "suppression prevents activation writes")
        return
    }
    assert_eq(TEXTURE_SLOT_FILLED.get(shader).unwrap(), 2, "repeated marks preserve the same slot")
    assert_eq(TEXTURE_SLOT_ACTIVATION.get(shader).unwrap(), 1)
    assert_eq(audit_texture_slots_for_draw(shader), 0, "the draw combines both mark lifetimes")
    assert(TEXTURE_SLOT_FILLED.get(shader) == null, "audit forgets per-draw marks")
    assert_eq(TEXTURE_SLOT_ACTIVATION.get(shader).unwrap(), 1, "audit keeps activation marks")
    mark_texture_slot_filled(shader, 1)
    assert_eq(audit_texture_slots_for_draw(shader), 0, "the next draw must fill its per-draw slot again")
    clear_texture_slot_activation(shader)
    assert(TEXTURE_SLOT_ACTIVATION.get(shader) == null, "a new activation forgets shared marks")
    mark_texture_slot_filled(shader, 0)
    mark_texture_slot_filled(shader, 1)
    mark_texture_slot_filled(other, 0)
    assert_eq(TEXTURE_SLOT_FILLED.get(shader).unwrap(), 3, "distinct slots accumulate")
    assert_eq(audit_texture_slots_for_draw(shader), 0)
    assert_eq(TEXTURE_SLOT_FILLED.get(other).unwrap(), 1, "auditing one shader preserves another shader's marks")
    assert_eq(audit_texture_slots_for_draw(other), 0, "an undeclared shader clears its per-draw marks")
    assert(TEXTURE_SLOT_FILLED.get(other) == null)
}


fn bookkeeping_registration_upgrade(native: bool) {
    let shader = if native { "bookkeeping-native-upgrade" } else { "bookkeeping-registration-upgrade" }
    let src = "bookkeeping-registration-source"
    let wire = "SHADER_INTERFACE_V1\nfingerprint 61\nfullscreen 1\nstages 1\nstage fragment\nvertex_inputs 0\nvaryings 0\ngroups 0\narrays 0\ntextures none 0\ntexture_stages 0\nbare_samplers 0\noutput none\nend"
    let saved_watcher = WATCHER
    let saved_generation = NEXT_SEMANTIC_SHADER_GENERATION
    WATCHER = FileWatcher { enabled: true, shaders: map_new(), current_shader_name: null }
    defer {
        WATCHER = saved_watcher
        NEXT_SEMANTIC_SHADER_GENERATION = saved_generation
        GL_SHADER_SEMANTICS.remove(shader)
        GL_SHADER_ARTIFACTS.remove(shader)
        REGISTERED_SHADER_HASHES.remove(shader)
    }
    WATCHER.shaders.insert(shader, WatcherShader { shader: ShaderId(1) })
    REGISTERED_SHADER_HASHES.insert(shader, ShaderRegistrationKey {
        src_hash: __shader_src_hash(src), block_fingerprint: 0,
        fullscreen_vertex: true, semantic_fingerprint: 61,
    })
    publish_gl_shader_semantic(shader, bookkeeping_test_interface(60))
    // A reload preserves registration hashes while the newly introduced registry starts empty.
    GL_SHADER_ARTIFACTS.remove(shader)
    if native {
        assert(__rock_native_shader_publish(shader, src, ShaderId(1), [], [], [], [], [], [], [], [], [], [], [], true, wire))
    } else {
        __rock_shader_register(shader, src, [], [], [], [], [], [], [], [], [], [], [], true, wire)
    }
    let selected = selected_shader_interface(shader)
    assert(selected != null, "unchanged registration restores newly introduced artifact metadata")
    assert_eq(selected.unwrap().fingerprint, 61, "restoration uses the validated incoming wire rather than public metadata")
    assert_eq(WATCHER.shaders.get(shader).unwrap().shader.0, 1, "restoration preserves the compiled program")
    WATCHER.shaders.remove(shader)
    GL_SHADER_ARTIFACTS.remove(shader)
    __rock_shader_register(shader, src, [], [], [], [], [], [], [], [], [], [], [], true, wire)
    assert(selected_shader_interface(shader) == null, "unchanged registration does not revive an absent program")
    assert(!GL_SHADER_ARTIFACTS.contains(shader), "metadata recovery requires a live program")
}

@test
fn shader_registration_restores_artifact_metadata_after_registry_upgrade() {
    bookkeeping_registration_upgrade(false)
}

@test
fn native_shader_publication_restores_artifact_metadata_after_registry_upgrade() {
    bookkeeping_registration_upgrade(true)
}

@test
fn shader_metadata_preserves_53_bit_fingerprints() {
    let fingerprint = 9007199254740991
    let semantic = bookkeeping_test_interface(fingerprint)
    assert_eq(semantic.fingerprint as int, fingerprint)
    let keys = [ShaderRegistrationKey {
        src_hash: 1, block_fingerprint: 2, fullscreen_vertex: true,
        semantic_fingerprint: fingerprint,
    }]
    assert_eq(keys[0].semantic_fingerprint as int, fingerprint)
}
