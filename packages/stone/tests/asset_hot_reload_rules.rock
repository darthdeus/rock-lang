use stone::*

@test
fn image_hot_reload_redecodes_into_the_same_handle() {
    gpu_test_host()
    let path = test_tmp_dir("rock-hot-reload") + "/image.png"
    residency_owner_test_isolated(() => {
        image_data_encode(new_image_data(2, 2), "png", path).expect("encode the initial 2x2 png")
        let img = load_image_asset(path)
        let handle = img.0
        assert(handle != 0, "the initial image loads")
        assert(stone_get_image_size(handle) == (2, 2), "the initial size is 2x2")

        image_data_encode(new_image_data(4, 4), "png", path).expect("encode the replacement 4x4 png")
        reload_changed_asset(path)
        assert_eq(img.0, handle, "the handle survives the reload")
        let (w, h) = stone_get_image_size(handle)
        assert(w == 4 && h == 4, "the reload re-decodes the new file into the handle, got {w}x{h}")

        assert(!stone_reload_image(999999, path), "reloading an unknown handle fails cleanly")
    }, () => { let _ = remove_file(path) })
}

fn hot_reload_repo_file(relative: string) -> string {
    return stone_file_read(relative) ?? ""
}

@test
fn font_hot_reload_rerasterizes_into_the_same_backend() {
    text_test_host()
    load_pending_shader_sources()
    let tmp = test_tmp_dir("rock-hot-reload") + "/font.ttf"
    let font_a = hot_reload_repo_file(project_asset_path("@engine/assets/fonts/DroidSans.ttf"))
    let font_b = hot_reload_repo_file("{STONE_SOURCE_DIR}/tests/fixtures/pixel.ttf")
    assert(font_a != "" && font_b != "" && font_a != font_b, "two distinct fixture fonts read")
    let font: Font? = null
    world_fixture_with_cleanup(() => {
        assert(stone_file_write(tmp, font_a), "write the temp font (A)")
        let loaded = load_font(tmp, 16).unwrap()
        font = loaded
        let backend = loaded.data().unwrap().backend_id
        let raster = loaded.data().unwrap().pixel_size
        assert(backend != 0, "font A loads")
        let text = "Hello World 123"
        let width_a = loaded.measure(text, 16.0).x
        assert(width_a > 0.0, "font A measures")

        reload_changed_asset(tmp)
        assert_eq(loaded.data().unwrap().backend_id, backend, "the backend survives an in-place reload")
        assert_eq(loaded.measure(text, 16.0).x, width_a, "reloading the same font keeps the metrics")

        assert(stone_file_write(tmp, font_b), "write the temp font (B)")
        reload_changed_asset(tmp)
        assert_eq(loaded.data().unwrap().backend_id, backend, "the backend survives a content change")
        let width_b = loaded.measure(text, 16.0).x
        assert(width_b != width_a, "reloading a different font changes the metrics ({width_a} -> {width_b})")

        assert(stone_file_write(tmp, "not a font"), "corrupt the temp font")
        assert_error_logs(["[TEXT] rasterize_glyphs: failed to parse font '{tmp}': UnknownMagic"], () => {
            assert(!stone_reload_font_ffi(backend, tmp, raster), "reloading a corrupt font fails")
        })
        assert_eq(loaded.data().unwrap().backend_id, backend, "a failed reload keeps the font handle")
        assert_eq(loaded.measure(text, 16.0).x, width_b, "a failed reload keeps the old atlas metrics")
    }, () => {
        if font != null { unload_font(font) }
        let _ = remove_file(tmp)
    })
}

inline(lua) fn with_reload_hold_path(path: string, body: fn()) = """
    local getenv = os.getenv
    os.getenv = function(name)
        if name == "STONE_RELOAD_CONTROL" then return path end
        return getenv(name)
    end
    local ok, err = pcall(body)
    os.getenv = getenv
    if not ok then error(err, 0) end
"""

inline(lua) fn with_reload_marker_failure(marker: string, phase: string, body: fn()) = """
    local open = io.open
    io.open = function(path, mode)
        if path ~= marker then return open(path, mode) end
        if phase == "open" then return nil, "permission denied", 13 end
        return {
            read = function() return "request" end,
            close = function() return nil, "close failed" end,
        }
    end
    local ok, err = pcall(body)
    io.open = open
    if not ok then error(err, 0) end
"""

inline(lua) fn reload_hold_io_error(path: string) -> string = """
    local file, open_error = io.open(path, "r")
    if not file then return open_error end
    local _, read_error = file:read("*a")
    assert(file:close())
    return assert(read_error)
"""

fn expect_reload_hold_error(path: string, cause: string) {
    assert_error_logs(["[HOTRELOAD] cannot read reload marker {path}: {cause}"], () => {
        assert_eq(stone_reload_hold_status(), "holding")
    })
}

@test
fn reload_hold_request_open_failure_pauses_publication() {
    let root = test_tmp_dir("reload-open-request")
    let request = "{root}/reload.hold"
    with_reload_hold_path(request, () => {
        with_reload_marker_failure(request, "open", () => {
            expect_reload_hold_error(request, "permission denied")
        })
        assert_eq(stone_reload_hold_status(), "watching")
    })
}

@test
fn reload_hold_ack_open_failure_reports_the_cause() {
    let root = test_tmp_dir("reload-open-ack")
    let request = "{root}/reload.hold"
    let ack = "{root}/reload.held"
    with_reload_hold_path(request, () => {
        assert_eq(stone_reload_hold_status(), "watching")
        assert(stone_reload_hold(true))
        assert_eq(stone_reload_hold_status(), "holding")
        with_reload_marker_failure(ack, "open", () => {
            expect_reload_hold_error(ack, "permission denied")
        })
        assert(stone_file_write(ack, "stale"))
        assert_eq(stone_reload_hold_status(), "holding")
        assert(stone_file_write(ack, stone_file_read(request).unwrap()))
        assert_eq(stone_reload_hold_status(), "held")
        assert(stone_reload_hold(false))
        assert_eq(stone_reload_hold_status(), "watching")
    })
}

@test
fn reload_hold_two_unreadable_markers_never_match() {
    let root = test_tmp_dir("reload-read-request")
    let request = "{root}/reload.hold"
    let ack = "{root}/reload.held"
    assert(stone_create_directory(request) && stone_create_directory(ack))
    with_reload_hold_path(request, () => {
        expect_reload_hold_error(request, reload_hold_io_error(request))
    })
}

@test
fn reload_hold_unreadable_ack_reports_the_cause() {
    let root = test_tmp_dir("reload-read-ack")
    let request = "{root}/reload.hold"
    let ack = "{root}/reload.held"
    assert(stone_file_write(request, "request") && stone_create_directory(ack))
    with_reload_hold_path(request, () => {
        expect_reload_hold_error(ack, reload_hold_io_error(ack))
    })
}

@test
fn reload_hold_marker_close_failures_never_acknowledge() {
    let root = test_tmp_dir("reload-close-marker")
    let request = "{root}/reload.hold"
    let ack = "{root}/reload.held"
    assert(stone_file_write(request, "request") && stone_file_write(ack, "request"))
    with_reload_hold_path(request, () => {
        for marker in [request, ack] {
            with_reload_marker_failure(marker, "close", () => {
                expect_reload_hold_error(marker, "close failed")
            })
        }
        assert_eq(stone_reload_hold_status(), "held")
    })
}

inline(lua) fn with_reload_remove_failure(marker: string, body: fn()) = """
    local remove = os.remove
    os.remove = function(path)
        if path == marker then return nil, "permission denied", 13 end
        return remove(path)
    end
    local ok, err = pcall(body)
    os.remove = remove
    if not ok then error(err, 0) end
"""

@test
fn reload_hold_release_failure_leaves_the_game_running() {
    let root = test_tmp_dir("reload-remove-request")
    let request = "{root}/reload.hold"
    with_reload_hold_path(request, () => {
        assert(stone_reload_hold(false))
        assert(stone_reload_hold(true))
        with_reload_remove_failure(request, () => {
            assert_error_logs(["[HOTRELOAD] cannot remove reload marker {request}: permission denied"], () => {
                assert(!stone_reload_hold(false))
            })
        })
        assert_eq(stone_reload_hold_status(), "holding")
        assert(stone_reload_hold(false))
        assert_eq(stone_reload_hold_status(), "watching")
    })
}
