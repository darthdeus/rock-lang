// The toggle must read the live runtime flag: a shadow global starts at true
// even when STONE_NO_JIT turned the runtime off, so the first toggle would go
// the wrong way. The oracle is `jit.status()`, independent of engine globals.
@test(backends = "lua")
fn jit_toggle_follows_runtime_state() {
    assert(luajit_available(), "stone tests run under LuaJIT")
    let was_on = luajit_enabled()
    defer { jit_set_enabled(was_on) }
    assert_eq(jit_set_enabled(false), "OFF", "disabling the runtime reports OFF")
    assert(!luajit_enabled(), "the runtime is really off before the toggle")
    toggle_jit_enabled()
    assert(luajit_enabled(), "toggle from runtime-off turns the runtime ON")
    toggle_jit_enabled()
    assert(!luajit_enabled(), "toggle from runtime-on turns the runtime off")
    jit_set_enabled(was_on)
    assert(luajit_enabled() == was_on, "the test restores the runtime it found")
}
