pub use stone_native::test_support::{world_fixture_call, world_fixture_raised,
    world_fixture_with_cleanup, world_fixture_traceback};

// Profiler globals and native counters belong to the process, not a test shard.
inline(lua) fn profiler_test_process(entry: string, which: int) = """
    local function quote(s) return "'" .. s:gsub("'", "'\\''") .. "'" end
    local library_key = ffi.os == "OSX" and "DYLD_LIBRARY_PATH" or "LD_LIBRARY_PATH"
    local library_env = library_key .. "=" .. quote(assert(os.getenv(library_key)))
    local path = assert(os.getenv("ROCK_TEST_TMP")) .. "/" .. entry .. "-" .. which .. ".log"
    local script = "assert(loadfile(" .. string.format("%q", arg[0]) .. "))(); "
        .. "jit.off(); jit.flush(); " .. entry .. "(" .. which .. "); io.write('PROFILER_PROCESS_PASS')"
    local executable_index = -1
    while arg[executable_index - 1] do executable_index = executable_index - 1 end
    local status = os.execute("env " .. library_env .. " ROCK_TEST_SHARD_TESTS='' "
        .. quote(arg[executable_index]) .. " -e " .. quote(script) .. " > " .. quote(path) .. " 2>&1")
    local file = assert(io.open(path, "rb"))
    local log = file:read("*a")
    file:close()
    assert(os.remove(path))
    assert(status == 0 and log:find("PROFILER_PROCESS_PASS", 1, true), log)
"""

// Run it in a fresh process (profiler_test_process): the runner's clocks,
// renderer and profiler are process state no fixture restores.
fn native_runner_test_boot(title: string) -> (StoneWindow, GameConfig) {
    setup_stone()
    let config = GameConfig { title: title, width: 16, height: 16,
        font_path: project_asset_path("@engine/assets/fonts/DroidSans.ttf"), vsync: 0 }
    native_engine_configure(config)
    let window = stone_init_window(config.title, 0, 0, 16, 16, 0, false, 0).unwrap()
    native_engine_imgui_boot(window)
    assert(IMGUI_READY)
    native_engine_window_boot()
    load_pending_shader_sources()
    native_engine_font_boot(config)
    native_engine_render_boot()
    run_boot_phase("early_init")
    run_boot_phase("init")
    run_boot_phase("late_init")
    run_wire_systems()
    stone_init_done()
    init_profiler()
    input_resolve_authority()
    timeline_init()
    return (window, config)
}

fn gpu_test_host() {
    setup_stone()
    assert(stone_gpu_host_ensure())
}

fn text_test_host() {
    gpu_test_host()
    assert(stone_text_init())
}

fn test_tmp_dir(name: string) -> string {
    let dir = env_var("ROCK_TEST_TMP").unwrap() + "/" + name
    let _ = create_directory(dir)
    return dir
}

// One orange texel at (1, 1) on transparent black.
fn test_png(path: string, w: int = 4, h: int = 2) -> string {
    let data = new_image_data(w, h)
    image_data_set_pixel(data, 1, 1, 1.0, 0.5, 0.0, 1.0)
    assert(image_data_encode(data, "png", path), "fixture {path} written")
    stone_destroy_image_data(data.0)
    return path
}

// Files under one `.eat/<digest>` directory resolve to one image identity.
fn test_eat_png(root: string, digest_char: string, name: string, w: int = 4, h: int = 2) -> string {
    let dir = "{root}/.eat/{digest_char.repeat(64)}"
    let _ = create_directory(root)
    let _ = create_directory(root + "/.eat")
    let _ = create_directory(dir)
    return test_png("{dir}/{name}.png", w, h)
}

fn test_white_image() -> Image {
    let data = new_owned_image_data(1, 1)
    image_data_set_pixel(data, 0, 0, 1.0, 1.0, 1.0, 1.0)
    let image = new_owned_image_from_data(data, TextureFilter::Nearest)
    release_owned_image_data(data)
    return image
}

// Returns a closure that puts back the bound render state as it was now.
fn render_state_saved() -> fn() -> () {
    let saved_canvas = CURRENT_CANVAS_HANDLE
    let saved_shader = WATCHER.current_shader_name
    let saved_blend = CURRENT_BLEND
    let saved_render_pool = CURRENT_RENDER_POOL
    let saved_ui_pool = CURRENT_UI_POOL
    return () => {
        set_canvas_handle(saved_canvas)
        if saved_shader != null { set_shader(saved_shader) } else { unset_shader() }
        WATCHER.current_shader_name = saved_shader
        set_blend_mode(saved_blend)
        unset_depth_mode()
        reset_camera()
        CURRENT_RENDER_POOL = saved_render_pool
        CURRENT_UI_POOL = saved_ui_pool
    }
}
