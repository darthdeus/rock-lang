pub use stone_native::test_support::{world_fixture_call, world_fixture_raised,
    world_fixture_with_cleanup, world_fixture_traceback};

// Run it in a fresh process (profiler_test_process): the runner's clocks,
// renderer and profiler are process state no fixture restores.
fn native_runner_test_boot(title: string) -> (StoneWindow, GameConfig) {
    setup_stone()
    let config = GameConfig { title: title, width: 16, height: 16,
        font_path: project_asset_path("@engine/assets/fonts/DroidSans.ttf"), vsync: 0 }
    native_engine_configure(config)
    let window = stone_init_window(config.title, 0, 0, 16, 16, 0, false, 0).unwrap()
    native_engine_imgui_boot(window)
    assert(IMGUI_READY)
    native_engine_window_boot()
    load_pending_shader_sources()
    native_engine_font_boot(config)
    native_engine_render_boot()
    run_early_init_systems()
    run_init_systems()
    run_late_init_systems()
    run_wire_systems()
    stone_init_done()
    init_profiler()
    input_resolve_authority()
    timeline_init()
    return (window, config)
}

fn gpu_test_host() {
    setup_stone()
    assert(stone_gpu_host_ensure())
}

fn text_test_host() {
    gpu_test_host()
    assert(stone_text_init())
}

fn test_tmp_dir(name: string) -> string {
    let dir = env_var("ROCK_TEST_TMP").unwrap() + "/" + name
    let _ = create_directory(dir)
    return dir
}

// One orange texel at (1, 1) on transparent black.
fn test_png(path: string, w: int = 4, h: int = 2) -> string {
    let data = new_image_data(w, h)
    image_data_set_pixel(data, 1, 1, 1.0, 0.5, 0.0, 1.0)
    assert(image_data_encode(data, "png", path), "fixture {path} written")
    stone_destroy_image_data(data.0)
    return path
}

// Files under one `.eat/<digest>` directory resolve to one image identity.
fn test_eat_png(root: string, digest_char: string, name: string, w: int = 4, h: int = 2) -> string {
    let dir = "{root}/.eat/{digest_char.repeat(64)}"
    let _ = create_directory(root)
    let _ = create_directory(root + "/.eat")
    let _ = create_directory(dir)
    return test_png("{dir}/{name}.png", w, h)
}

fn test_white_image() -> Image {
    let data = new_owned_image_data(1, 1)
    image_data_set_pixel(data, 0, 0, 1.0, 1.0, 1.0, 1.0)
    let image = new_owned_image_from_data(data, TextureFilter::Nearest)
    release_owned_image_data(data)
    return image
}
