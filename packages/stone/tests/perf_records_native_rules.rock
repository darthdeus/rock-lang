// Live native values are proven by perf captures, not unit fixtures.
fn perf_record_native_row(frame: int, read_native: bool) -> int {
    let saved_count = PERF_RECORDS.count
    let saved_seconds = PERF_RECORDS.seconds
    let saved_read = JIT_NATIVE_READ_ENABLED
    defer {
        JIT_NATIVE_READ_ENABLED = saved_read
        PERF_RECORDS.count = saved_count
        PERF_RECORDS.seconds = saved_seconds
    }
    JIT_NATIVE_READ_ENABLED = read_native
    let at = saved_count * PERF_RECORD_COLUMNS
    perf_record_frame(frame, 1000.0, 16.6, 1024.0, 1.0, 1, 1, 1, 0, 5, 7, 11)
    assert_eq(nb_get(PERF_RECORDS.data, at + 12), 7.0)
    assert_eq(nb_get(PERF_RECORDS.data, at + 15 + GC_STEP_FIELDS), 5.0)
    assert_eq(nb_get(PERF_RECORDS.data, at + 16 + GC_STEP_FIELDS), 11.0)
    return at + 17 + GC_STEP_FIELDS
}

@test
fn perf_record_row_carries_native_jit_columns() {
    assert_eq(PERF_RECORD_COLUMNS, 17 + GC_STEP_FIELDS + JIT_NATIVE_COLUMNS + 3,
        "native JIT columns widen the frame row")
    assert_eq(JIT_NATIVE_COLUMNS, 18, "native layout matches the ABI column count")
    let native = perf_record_native_row(7, false)
    assert(nb_get(PERF_RECORDS.data, native - 17 - GC_STEP_FIELDS) == 7.0, "row lands at the saved count")
    for c in 0..JIT_NATIVE_COLUMNS {
        assert(nb_get(PERF_RECORDS.data, native + c) == 0.0, "disabled native read zero-fills the row")
    }
    assert_eq("{(-1.0) as int}", "-1", "reason padding serializes as -1")
    assert_eq("{(-150.0) as int}", "-150", "negative diffs serialize exactly")
    let json = perf_records_json()
    assert(json.contains("jitn_aborts"), "native columns serialize by name")
    assert(json.contains("jitn_coalescing_overflow"), "the full native layout serializes")
}

@test
fn perf_record_row_reads_live_native_deltas() {
    let native = perf_record_native_row(9, true)
    for c in 0..JIT_NATIVE_COLUMNS {
        let v = nb_get(PERF_RECORDS.data, native + c)
        assert(v == v, "live native delta columns stay finite")
    }
    for k in 0..3 {
        let r = nb_get(PERF_RECORDS.data, native + 5 + k * 2)
        assert(r == -1.0 || (r >= 0.0 && r < 64.0), "mover reasons stay -1 or a traceerr index")
    }
}

@test
fn perf_residency_wait_row_names_distinct_files() {
    let saved = PERF_RESIDENCY_WAITS
    PERF_RESIDENCY_WAITS = vec_new()
    let paths = ["a/albedo.png", "a/normal.png", "a/albedo.png"]
    for i in 0..PERF_RESIDENCY_WAIT_PATHS { paths.push("extra/{i}.png") }
    perf_record_residency_wait(42, 3100, paths)
    let row = PERF_RESIDENCY_WAITS[0]
    PERF_RESIDENCY_WAITS = saved
    assert(row.starts_with("{{\"frame\":42,\"wait_us\":3100,\"path_count\":{PERF_RESIDENCY_WAIT_PATHS + 2},\"paths\":[\"a/albedo.png\",\"a/normal.png\","),
        "frame, wait and distinct files in order: {row}")
    assert(!row.contains("extra/{PERF_RESIDENCY_WAIT_PATHS - 2}.png"), "files past the row limit are counted, not listed")
}
