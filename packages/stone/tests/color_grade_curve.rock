@test
fn color_grade_curve_preserves_black_identity_and_chroma() {
    let black = v(0.0, 0.0, 0.0)
    assert_eq(color_grade_luminance_curve(black, 0.8, 0.9), black,
        "lifting midtones does not fog empty black space")
    let colored = v(0.1, 0.2, 0.4)
    assert_eq(color_grade_luminance_curve(colored, 1.0, 1.0), colored,
        "existing callers get an exact identity curve")
    let lifted = color_grade_luminance_curve(colored, 0.8, 1.0)
    assert(lifted.x > colored.x, "a lower power lifts midtones")
    assert(abs(lifted.y / lifted.x - 2.0) < 0.00001
        && abs(lifted.z / lifted.x - 4.0) < 0.00001,
        "the luminance curve preserves channel ratios")
    let white = color_grade_luminance_curve(v(1.0, 1.0, 1.0), 0.8, 0.9)
    assert(white.x < 1.0 && white.x == white.y && white.y == white.z,
        "highlight gain lowers white without introducing a color cast")
}
