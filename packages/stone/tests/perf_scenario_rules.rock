@nomangle
fn perf_scenario_interval_entry(_which: int) {
    init_profiler()
    ENGINE.profiler_enabled = true
    HITCH = HitchLedger {}
    PERF_FRAME_CAPTURE = true
    PERF_RECORDS = perf_records_new()
    perf_scenario_wait("synthetic")
    perf_scenario_window("fighting", 2, 3)
    PERF_RECORDS.requested_frames = 3
    PERF_RECORDS.requested_seconds = 0.001
    profile_frame_begin()
    profile_frame_end()
    perf_scenario_ready("synthetic")
    perf_outer_frame_boundary(10, 0.0)
    perf_outer_frame_boundary(11, 0.1)
    profiler_finish_warmup(false)
    perf_outer_frame_boundary(12, 0.2)
    for i in 0..3 {
        assert(!perf_measurement_complete(), "elapsed time cannot end a fixed-frame interval")
        profile_frame_begin()
        profile_frame_end()
        perf_outer_frame_boundary(13 + i, 0.3 + i as float * 0.1)
    }
    assert(perf_measurement_complete(), "exactly three completed frames end the interval")
    assert_eq(PERF_RECORDS.count, 3, "the next frame is excluded")
    assert_eq(PERF_RECORDS.start_relative_frame, 2, "start is relative to readiness")
    perf_outer_frame_boundary(16, 0.6)
    assert_eq(PERF_RECORDS.count, 3, "post-window work cannot add a timing sample")
}

@test
fn perf_scenario_interval_captures_only_the_selected_frames() {
    profiler_test_process("perf_scenario_interval_entry", 0)
}

fn perf_scenario_fixture(body: fn()) {
    let saved = PERF_RECORDS
    let capture = PERF_FRAME_CAPTURE
    let profiler = deepcopy(PROFILER)
    let engine_profiler = ENGINE.profiler_enabled
    let gc_n = GC_WIN_N
    let gc_frame = GC_WIN_FRAME
    let gc_start = GC_WIN_START
    defer {
        PERF_RECORDS = saved
        PERF_FRAME_CAPTURE = capture
        PROFILER = profiler
        ENGINE.profiler_enabled = engine_profiler
        GC_WIN_N = gc_n
        GC_WIN_FRAME = gc_frame
        GC_WIN_START = gc_start
    }
    PERF_FRAME_CAPTURE = true
    PERF_RECORDS = perf_records_new()
    body()
}

@test
fn perf_scenario_rejects_readiness_without_a_declared_window() {
    perf_scenario_fixture(() => {
        perf_scenario_wait("missing_window")
        let failure = (world_fixture_raised(() => { perf_scenario_ready("missing_window") }) ?? "")
        assert(failure.contains("declared window"), "readiness must reject an undeclared interval: {failure}")
    })
}

@test
fn perf_scenario_caps_fail_an_unfinished_window_even_with_gc_pending() {
    perf_scenario_fixture(() => {
        perf_scenario_wait("capped")
        perf_scenario_window("steady", 2, 8)
        PERF_RECORDS.requested_frames = 8
        perf_scenario_ready("capped")
        GC_WIN_N = 4
        GC_WIN_FRAME = 0
        GC_WIN_START = 100
        let termination = perf_run_termination(1, 20, 0.25, 0.05)
        assert_eq(termination, "seconds_cap", "readiness and warmup consume the launch bound")
        PERF_RECORDS.termination = termination
        assert(!perf_measurement_complete(), "a cap never completes an unfinished frame interval")
        assert(!json_bool_at(json_decode(perf_scenario_json()).unwrap(), ["complete"]),
            "the diagnostic artifact records the incomplete scenario")
        assert_eq(json_str_at(json_decode(perf_measurement_json()).unwrap(), ["termination"]), "seconds_cap")
        assert_eq(perf_run_termination(1, 1, 0.0, 10.0), "process_frame_cap",
            "an allocation window cannot exempt the process cap")
        PERF_RECORDS.count = PERF_RECORDS.requested_frames
        assert_eq(perf_run_termination(8, -1, 0.0, -1.0), "gc_window_incomplete",
            "the profiler must not extend the declared timing population to finish GC")
        GC_WIN_N = 0
        assert_eq(perf_run_termination(8, -1, 0.0, -1.0), "window_complete")
    })
}

@test
fn perf_scenario_fixed_start_keeps_adjacent_readiness_aligned() {
    perf_scenario_fixture(() => {
        ENGINE.profiler_enabled = true
        for ready in 10..12 {
            PERF_RECORDS = perf_records_new()
            perf_scenario_wait("aligned")
            perf_scenario_window("steady", 2, 3)
            PERF_RECORDS.absolute_start_frame = 20
            perf_scenario_ready("aligned")
            for frame in ready..24 {
                perf_outer_frame_boundary(frame, stone_get_time())
                profile_frame_begin()
                profile_frame_end()
            }
            assert_eq(PERF_RECORDS.start_frame, 20, "adjacent readiness must share the absolute start")
            assert_eq(PERF_RECORDS.count, 3, "the requested frame count remains exact")
        }
    })
}

@test
fn perf_scenario_fixed_start_rejects_late_readiness() {
    perf_scenario_fixture(() => {
        perf_scenario_wait("late")
        perf_scenario_window("steady", 2, 3)
        PERF_RECORDS.absolute_start_frame = 20
        perf_scenario_ready("late")
        let failure = (world_fixture_raised(() => { perf_outer_frame_boundary(19, stone_get_time()) }) ?? "")
        assert(failure.contains("warmup"), "late readiness must reject the requested warmup: {failure}")
    })
}

@nomangle
fn perf_scenario_recorder_allocation_entry(which: int) {
    lua_alloc_split_init()
    os_setenv("PERF_GC_WINDOW", "3")
    os_setenv("PERF_GC_WINDOW_START", "1")
    os_setenv("PERF_GC_WINDOW_MODE", "running")
    PERF_FRAME_CAPTURE = true
    PERF_SECTION_HISTORY = which == 1
    init_profiler()
    ENGINE.profiler_enabled = true
    HITCH = HitchLedger {}
    PERF_RECORDS = perf_records_new()
    perf_scenario_wait("recorder")
    let warmup = if which >= 2 { which - 2 } else { 2 }
    let start = max(warmup, 1)
    perf_scenario_window("steady", warmup, 4)
    perf_scenario_ready("recorder")
    // A collection cannot hide setup allocation from the heap-delta check.
    __gc_collect_stop()
    let first_kb = 0.0
    let ordinary_kb = 0.0
    for frame in 0..(start + 4) {
        perf_outer_frame_boundary(frame, stone_get_time())
        let before_kb = lua_gc_kb()
        profile_frame_begin()
        profile_frame_end()
        let delta_kb = lua_gc_kb() - before_kb
        if frame == start { first_kb = delta_kb }
        if frame == start + 1 { ordinary_kb = delta_kb }
    }
    assert(first_kb < ordinary_kb + 1.0,
        "the first measured frame allocates like an ordinary frame: first {first_kb}KB, ordinary {ordinary_kb}KB")
    assert_eq(PERF_RECORDS.start_frame, start, "preparation preserves the timing interval")
    assert_eq(GC_WIN_FRAME_SAMPLES, 3, "preparation preserves the allocation interval")
    assert(GC_WIN_ACCOUNTING_VALID, "preparation preserves allocation accounting")
    profiler_allocator_shutdown()
    __gc_restart()
}

// which: 0 default warmup, 1 with section history, 2 no warmup, 3 one warmup frame.
@test
fn perf_scenario_first_frame_has_no_recorder_setup_allocation() {
    for which in 0..4 { profiler_test_process("perf_scenario_recorder_allocation_entry", which) }
}

@nomangle inline(lua) fn perf_scenario_abort_without_code(counts: any, site: any) = """
    __stone_jit_count_event(counts, "abort", 6, site, 0, nil, nil)
"""

@test
fn perf_scenario_trace_reasons_cover_the_allocation_window() {
    jit_abort_sites_fixture(() => {
        let counts = __stone_jit_trace_counts_table()
        let site = jit_abort_sites_probe()
        __stone_jit_count_event(counts, "abort", 1, site, 0, 2, 0)
        jit_abort_sites_window(2, () => {
            __stone_jit_count_event(counts, "start", 2, site, 0, 0, 0)
            __stone_jit_count_event(counts, "stop", 2, site, 0, 0, 0)
            __stone_jit_count_event(counts, "flush", 0, site, 0, 0, 0)
            for _ in 0..3 {
                __stone_jit_count_event(counts, "abort", 3, site, 0, 2, 0)
            }
            __stone_jit_count_event(counts, "abort", 4, site, 0, 10, 0)
            __stone_jit_count_event(counts, "abort", 4, site, 0, 7, 2)
            __stone_jit_count_event(counts, "abort", 4, site, 0, 7, 3)
        })
        __stone_jit_count_event(counts, "abort", 5, site, 0, 2, 0)
        let doc = json_decode(profiler_perf_json()).unwrap()
        let trace = json_at(doc, ["memory", "gc_window", "jit_trace"])
        let reasons = json_array_at(trace, ["abort_reasons"])
        assert_eq(reasons.len(), 3, "only nonzero reason codes are exported")
        for (row, code, count) in [(reasons[0], 2, 3), (reasons[1], 7, 2), (reasons[2], 10, 1)] {
            assert_eq(json_int_at(row, ["code"]), code)
            assert_eq(json_int_at(row, ["count"]), count, "code {code}: NYI arguments share their error-code bucket")
        }
        assert_eq(json_str_at(reasons[0], ["reason"]), "trace too long")
        assert_eq(json_str_at(reasons[1], ["reason"]), "NYI: bytecode %s")
        assert_eq(json_int_at(trace, ["aborts"]), 6)
        assert_eq(json_int_at(trace, ["compiles"]), 1)
        assert_eq(json_int_at(trace, ["flushes"]), 1)
        assert_eq(json_encode(json_at(doc, ["run", "jit_trace", "abort_reasons"])),
            json_encode(json_at(trace, ["abort_reasons"])),
            "run attribution and allocation-window counters share one histogram")
        jit_abort_sites_window(1, () => {})
        let empty = json_decode(gc_window_trace_json(true)).unwrap()
        assert_eq(json_array_at(empty, ["abort_reasons"]).len(), 0,
            "a second empty window drops the preceding reasons")
        jit_abort_sites_window(1, () => {
            perf_scenario_abort_without_code(counts, site)
        })
        let unknown = json_array_at(json_decode(gc_window_trace_json(true)).unwrap(), ["abort_reasons"])
        assert_eq(unknown.len(), 1, "recycled storage excludes earlier windows")
        assert_eq(json_int_at(unknown[0], ["code"]), -1)
        assert_eq(json_int_at(unknown[0], ["count"]), 1)
        let unavailable = json_decode(gc_window_trace_json(false)).unwrap()
        assert_eq(json_encode(json_field(unavailable, "abort_reasons").unwrap()), "null")
    })
}

@test
fn perf_scenario_trace_reasons_without_a_window_cover_the_process() {
    jit_abort_sites_fixture(() => {
        let counts = __stone_jit_trace_counts_table()
        let site = jit_abort_sites_probe()
        __stone_jit_count_event(counts, "abort", 1, site, 0, 5, 0)
        __stone_jit_count_event(counts, "abort", 2, site, 0, 9, 0)
        let reasons = json_array_at(jit_abort_sites_report(), ["abort_reasons"])
        assert_eq(reasons.len(), 2)
        assert_eq(json_str_at(reasons[0], ["reason"]), "blacklisted")
        assert_eq(json_str_at(reasons[1], ["reason"]), "inner loop in root trace")
        for row in reasons { assert_eq(json_int_at(row, ["count"]), 1) }
    })
}

@nomangle inline(lua) fn perf_scenario_freeze_with_abort(counts: any, site: any) -> (bool, int, int) = """
    local st = _G.__stone_jit_abort_sites
    local injected = false
    debug.sethook(function()
        if not injected and _G.__stone_jit_abort_sites == st and
            _G.__stone_jit_abort_reason_counts ~= st.reasons then
            injected = true
            __stone_jit_count_event(counts, "abort", 1, site, 0, 2, 0)
        end
    end, "l")
    local sum, total = __stone_jit_abort_sites_freeze()
    debug.sethook()
    return injected, sum, total
"""

@test
fn perf_scenario_trace_reasons_and_total_freeze_at_the_same_boundary() {
    jit_abort_sites_fixture(() => {
        let counts = __stone_jit_trace_counts_table()
        let site = jit_abort_sites_probe()
        for pending in [false, true] {
            __stone_jit_abort_sites_open()
            if !pending { __stone_jit_count_event(counts, "start", 1, site, 0, 0, 0) }
            let (injected, sum, total) = perf_scenario_freeze_with_abort(counts, site)
            assert(injected, "the test must inject an abort at the snapshot boundary, pending={pending}")
            assert_eq(sum, 1)
            assert_eq(total, sum, "the total includes every abort in the frozen histogram")
            let reasons = json_as_array(json_decode(__perf_jit_abort_reasons_json(true)).unwrap()).unwrap()
            assert_eq(json_int_at(reasons[0], ["count"]), total)
        }
    })
}
