use stone::*

global GAME_HOST_TEST_DRAWS: bool = false
global GAME_HOST_TEST_RAISES: bool = false

// A script batch the guest draws above the world image.
@draw
fn game_host_test_draw() {
    if GAME_HOST_TEST_DRAWS {
        rect(pixel_screen, v(0.0, 0.0), v(8.0, 16.0), Color { r: 0.0, g: 1.0, b: 0.0, a: 1.0 })
    }
    if GAME_HOST_TEST_RAISES {
        set_blend_mode(BlendMode::Additive)
        error("game host test draw error")
    }
}

// The host's GL functions and its own texture, registered as an image of
// `size` (a size the texture does not have tests the mismatch).
inline(lua) fn game_host_test_gl_image(size: int) -> int = """
    pcall(ffi.cdef, "void* SDL_GL_GetProcAddress(const char* proc);")
    local function gl(name, signature)
        return ffi.cast(signature, stone.SDL_GL_GetProcAddress(name))
    end
    local host = {
        gen_textures = gl("glGenTextures", "void (*)(int, uint32_t*)"),
        bind_texture = gl("glBindTexture", "void (*)(uint32_t, uint32_t)"),
        tex_image = gl("glTexImage2D", "void (*)(uint32_t, int, int, int, int, int, uint32_t, uint32_t, const void*)"),
        tex_parameter = gl("glTexParameteri", "void (*)(uint32_t, uint32_t, int)"),
        gen_framebuffers = gl("glGenFramebuffers", "void (*)(int, uint32_t*)"),
        bind_framebuffer = gl("glBindFramebuffer", "void (*)(uint32_t, uint32_t)"),
        framebuffer_texture = gl("glFramebufferTexture2D", "void (*)(uint32_t, uint32_t, uint32_t, uint32_t, int)"),
        get_integer = gl("glGetIntegerv", "void (*)(uint32_t, int*)"),
        is_enabled = gl("glIsEnabled", "uint8_t (*)(uint32_t)"),
        enable = gl("glEnable", "void (*)(uint32_t)"),
        viewport = gl("glViewport", "void (*)(int, int, int, int)"),
        clear_color = gl("glClearColor", "void (*)(float, float, float, float)"),
        clear = gl("glClear", "void (*)(uint32_t)"),
    }
    host.integer = function(param)
        local value = ffi.new("int[1]")
        host.get_integer(param, value)
        return value[0]
    end
    -- What the host checks of the baseline: framebuffers, program, VAO, blend.
    host.state = function()
        return table.concat({ host.integer(0x8CA6), host.integer(0x8CAA), host.integer(0x8B8D),
            host.integer(0x85B5), host.is_enabled(0x0BE2) }, ",")
    end
    local name = ffi.new("uint32_t[1]")
    host.gen_textures(1, name)
    host.texture = name[0]
    host.bind_texture(0x0DE1, host.texture)
    host.tex_image(0x0DE1, 0, 0x8058, 16, 16, 0, 0x1908, 0x1401, nil)
    host.tex_parameter(0x0DE1, 0x2801, 0x2600)
    host.tex_parameter(0x0DE1, 0x2800, 0x2600)
    host.bind_texture(0x0DE1, 0)
    local window_fbo = host.integer(0x8CA6)
    host.gen_framebuffers(1, name)
    host.fbo = name[0]
    host.bind_framebuffer(0x8D40, host.fbo)
    host.framebuffer_texture(0x8D40, 0x8CE0, 0x0DE1, host.texture, 0)
    host.bind_framebuffer(0x8D40, window_fbo)
    -- The host relies on the baseline between entries: it binds back the
    -- baseline framebuffer and viewport instead of saving what was bound.
    host.paint = function()
        host.bind_framebuffer(0x8D40, host.fbo)
        host.viewport(0, 0, 16, 16)
        host.clear_color(0.75, 0, 0, 1)
        host.clear(0x4000)
        host.bind_framebuffer(0x8D40, window_fbo)
    end
    _G.__game_host_test_gl = host
    return tonumber(stone.stone_image_import_gl_texture(host.texture, size, size, 0))
"""

inline(lua) fn game_host_test_state() -> string = "return _G.__game_host_test_gl.state()"

// Between frame_update and frame_draw of each drawn frame, the host paints its
// image and sets it as the world image.
inline(lua) fn game_host_test_set_image(image: int, valid: bool) = """
    _G.__game_host_test_between = function()
        _G.__game_host_test_gl.paint()
        assert((stone.stone_frame_set_host_world_image(image, 1) ~= 0) == valid)
    end
"""

// The host leaves blending on for the guest's draw entry.
inline(lua) fn game_host_test_leave_blend() = """
    _G.__game_host_test_between = function() _G.__game_host_test_gl.enable(0x0BE2) end
"""

// Drives the game the way an embedding host does, through the C entries, the
// event pump and the swap only. profiler_test_process runs it with the JIT off,
// which LuaJIT requires when Lua code enters a callback through C. A quit
// event pushed before frame `quit_at` (0 for none) reaches both sides.
inline(lua) fn game_host_test_drive(max_frames: int, quit_at: int) -> (int, int, int, int, int) = """
    pcall(ffi.cdef, "int SDL_PushEvent(void* event);")
    local entries = stone.stone_game_entries()
    assert(entries.frame_begin ~= nil, "the frame entries were not published")
    local info = ffi.new("StoneFrameBeginInfo")
    info.struct_size = ffi.sizeof(info)
    local plan = ffi.new("StoneFramePlan")
    local result = ffi.new("StoneFrameResult")
    local event = ffi.new("StoneEvent")
    local frames, draws, presents, quits, termination = 0, 0, 0, 0, -1
    _G.__game_host_test_frame = _G.__game_host_test_frame or 0
    while frames < max_frames do
        if frames + 1 == quit_at then
            local quit = ffi.new("uint32_t[16]")
            quit[0] = 0x100
            assert(stone.SDL_PushEvent(quit) == 1)
        end
        local pumped = stone.stone_pump_events()
        for i = 0, pumped - 1 do
            assert(stone.stone_frame_event(i, event) ~= 0)
            if event.type == 1 then quits = quits + 1 end
        end
        info.frame = _G.__game_host_test_frame + 1
        info.time = stone.stone_get_time()
        assert(entries.frame_begin(info, plan) == 1)
        if plan.running == 0 then termination = plan.termination break end
        assert(entries.frame_update(plan) == 1)
        assert(plan.frame == info.frame, "the plan names the frame begin opened")
        _G.__game_host_test_frame = tonumber(plan.frame)
        if plan.draws ~= 0 then
            assert(plan.active_width == 16 and plan.active_height == 16)
            draws = draws + 1
            if _G.__game_host_test_between then _G.__game_host_test_between() end
        end
        assert(entries.frame_draw(result) == 1)
        frames = frames + 1
        if result.present ~= 0 then
            stone.stone_swap_window(nil)
            presents = presents + 1
        end
        if result.running == 0 then termination = result.termination break end
    end
    -- After the run ended, begin reports it again instead of opening a frame.
    if termination >= 0 then
        assert(entries.frame_begin(info, plan) == 1 and plan.running == 0)
    end
    return frames, draws, presents, quits, termination
"""

// One frame whose draw entry fails, then the begin after it.
inline(lua) fn game_host_test_failed_draw() -> (int, int, int, int) = """
    local entries = stone.stone_game_entries()
    local info = ffi.new("StoneFrameBeginInfo")
    info.struct_size = ffi.sizeof(info)
    local plan = ffi.new("StoneFramePlan")
    local result = ffi.new("StoneFrameResult")
    stone.stone_pump_events()
    info.frame = _G.__game_host_test_frame + 1
    info.time = stone.stone_get_time()
    assert(entries.frame_begin(info, plan) == 1 and plan.running ~= 0)
    assert(entries.frame_update(plan) == 1)
    local drawn = entries.frame_draw(result)
    local begun = entries.frame_begin(info, plan)
    return drawn, begun, plan.running, plan.termination
"""

inline(lua) fn game_host_test_shutdown() = """
    assert(stone.stone_game_entries().shutdown() == 1)
    assert(stone.stone_game_entries().frame_begin == nil, "shutdown withdraws the entries")
"""

// Take the error records starting with `prefix`, whose tracebacks vary.
inline(lua) fn game_host_test_take_errors(prefix: string) -> int = """
    local log = _G.__rock_logged_errors
    local taken = 0
    for _, record in ipairs(log.scope_records()) do
        if record:find(prefix, 1, true) == 1 then
            assert(log.scope_take(record))
            taken = taken + 1
        end
    end
    return taken
"""

inline(lua) fn game_host_test_invalid_enable() = "_G.__game_host_test_gl.enable(0xFFFF)"

// Engine calls from the test between entries run like an entry does.
inline(lua) fn game_host_test_engine_call(enter: bool) = """
    if enter then stone.stone_frame_baseline_enter() else stone.stone_frame_baseline_leave() end
"""

// The right half shows the host's red world image or the engine's world, and
// the left half the guest's green script batch.
fn game_host_test_expect_composite(host_image: bool) {
    game_host_test_engine_call(true)
    defer { game_host_test_engine_call(false) }
    let composite = PRESENTED_SCENE_SAMPLE.unwrap().canvas.handle.0
    let world_red = stone_read_canvas_pixel_channel(composite, 12, 8, 0)
    let world_green = stone_read_canvas_pixel_channel(composite, 12, 8, 1)
    let batch_green = stone_read_canvas_pixel_channel(composite, 2, 8, 1)
    let pixels = "world {world_red},{world_green} batch green {batch_green}"
    assert((world_red > 0.2) == host_image && world_green < 0.1 && batch_green > 0.9, pixels)
}

// The script batch can miss the first frames while its image uploads are
// still within the per-frame budget.
fn game_host_test_warm_up() -> int {
    GAME_HOST_TEST_DRAWS = true
    let (_, _, swapped, _, _) = game_host_test_drive(3, 0)
    return swapped
}

@nomangle
fn game_host_drives_frame_case(which: int) {
    if which == 0 { os_setenv("FRAME_COUNT", "3") }
    stone_host_drives_frame_set(true)
    let swaps_before = stone_gl_swap_count()
    stone_run_game(GameConfig { title: "game host", width: 16, height: 16,
        font_path: project_asset_path("@engine/assets/fonts/DroidSans.ttf"), vsync: 0 })
    assert(HOST_DRIVES_FRAME)
    let baseline = game_host_test_state_before_image()
    let image = game_host_test_gl_image(if which == 4 { 8 } else { 16 })
    assert(image != 0)
    assert_eq(game_host_test_state(), baseline)
    let presents = 0
    if which == 0 {
        // A bounded run ends on its frame cap, as through stone_run_game.
        let (frames, draws, swapped, _, termination) = game_host_test_drive(10, 0)
        assert_eq((frames, draws, swapped, termination), (3, 3, 3, STONE_GAME_FRAME_CAP))
        presents = swapped
    } else if which == 1 {
        // The guest saw the quit the host pumped and ended that frame without
        // drawing it.
        let (frames, draws, swapped, quits, termination) = game_host_test_drive(10, 2)
        assert_eq((frames, draws, swapped, quits, termination), (2, 1, 1, 1, STONE_GAME_QUIT))
        presents = swapped
    } else if which == 2 {
        presents = game_host_test_warm_up()
        game_host_test_set_image(image, true)
        let (frames, draws, swapped, _, _) = game_host_test_drive(2, 0)
        assert_eq((frames, draws, swapped), (2, 2, 2))
        presents += swapped
        // Post processing composited the host's world image and the script
        // batch above it.
        game_host_test_expect_composite(true)
    } else if which == 3 || which == 4 {
        presents = game_host_test_warm_up()
        let message = if which == 3 {
            game_host_test_set_image(image + 1, false)
            "[STONE] stone_frame_set_host_world_image: image {image + 1} is not an imported GL texture"
        } else {
            game_host_test_set_image(image, true)
            "[STONE] host world image {image} is 8x8, not the 16x16 scene"
        }
        // An invalid image logs, and the frame renders the engine's world.
        assert_error_logs([message], () => {
            let (_, _, swapped, _, _) = game_host_test_drive(1, 0)
            presents += swapped
        })
        game_host_test_expect_composite(false)
    } else if which == 10 {
        // A frame that fails to close ends the run: the draw entry fails, the
        // host still gets the baseline, and the next begin reports the error.
        let (_, _, swapped, _, _) = game_host_test_drive(1, 0)
        presents = swapped
        // A perf scenario that is not ready by its start frame raises at the
        // next frame boundary.
        let saved = PERF_RECORDS
        PERF_RECORDS = perf_records_new()
        PERF_RECORDS.ready = false
        PERF_RECORDS.absolute_start_frame = GAME_RUN.unwrap().frame
        PERF_RECORDS.warmup_frames = 0
        let (drawn, begun, running, termination) = game_host_test_failed_draw()
        PERF_RECORDS = saved
        assert_eq((drawn, begun, running, termination), (0, 1, 0, STONE_GAME_FRAME_ERROR))
        assert_eq(game_host_test_take_errors("[STONE] draw: "), 1)
        assert_eq(game_host_test_state(), baseline)
    } else if which == 5 {
        // A guest draw that fails mid-frame still hands the host the baseline,
        // and the next frame runs.
        GAME_HOST_TEST_RAISES = true
        let (frames, _, swapped, _, _) = game_host_test_drive(1, 0)
        assert_eq(frames, 1)
        presents = swapped
        assert_eq(game_host_test_take_errors("[GAME] Error in frame"), 1)
        assert_eq(game_host_test_state(), baseline)
        GAME_HOST_TEST_RAISES = false
        let (_, draws, swapped, _, _) = game_host_test_drive(1, 0)
        assert_eq(draws, 1)
        presents += swapped
    } else {
        // The engine reports state the host left outside the baseline, and
        // the host gets the baseline back.
        game_host_test_leave_blend()
        assert_error_logs(["[STONE] the host left GL state outside the frame baseline: BLEND"], () => {
            let (_, _, swapped, _, _) = game_host_test_drive(1, 0)
            presents = swapped
        })
        assert_eq(game_host_test_state(), baseline)
        // A GL error engine code leaves pending is drained and logged when it
        // hands the baseline back.
        game_host_test_engine_call(true)
        game_host_test_invalid_enable()
        assert_error_logs(["[GL] gl error pending when a frame entry returned: 0x500"], () => {
            game_host_test_engine_call(false)
        })
    }
    game_host_test_shutdown()
    // The guest never swaps when the host drives the frame.
    assert_eq(stone_gl_swap_count() - swaps_before, presents)
    assert(presents > 0)
}

// The host's view of the baseline right after boot, before it touches GL.
inline(lua) fn game_host_test_state_before_image() -> string = """
    pcall(ffi.cdef, "void* SDL_GL_GetProcAddress(const char* proc);")
    local get = ffi.cast("void (*)(uint32_t, int*)", stone.SDL_GL_GetProcAddress("glGetIntegerv"))
    local enabled = ffi.cast("uint8_t (*)(uint32_t)", stone.SDL_GL_GetProcAddress("glIsEnabled"))
    local function integer(param)
        local value = ffi.new("int[1]")
        get(param, value)
        return value[0]
    end
    return table.concat({ integer(0x8CA6), integer(0x8CAA), integer(0x8B8D),
        integer(0x85B5), enabled(0x0BE2) }, ",")
"""

@test
fn a_host_drives_frames_through_the_entries_until_the_frame_cap() {
    profiler_test_process("game_host_drives_frame_case", 0)
}

@test
fn a_quit_event_the_host_pumps_ends_the_guest_run() {
    profiler_test_process("game_host_drives_frame_case", 1)
}

@test
fn a_host_world_image_is_post_processed_under_the_script_batches() {
    profiler_test_process("game_host_drives_frame_case", 2)
}

@test
fn an_invalid_host_world_image_falls_back_to_the_engine_world() {
    profiler_test_process("game_host_drives_frame_case", 3)
    profiler_test_process("game_host_drives_frame_case", 4)
}

@test
fn a_failed_guest_entry_returns_the_gl_baseline_to_the_host() {
    profiler_test_process("game_host_drives_frame_case", 5)
}

@test
fn a_frame_that_fails_to_close_ends_the_host_run() {
    profiler_test_process("game_host_drives_frame_case", 10)
}

@test
fn state_the_host_leaves_outside_the_baseline_is_reported() {
    profiler_test_process("game_host_drives_frame_case", 6)
}
